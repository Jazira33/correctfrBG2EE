@13457 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13458 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13459 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13460 = ~Vous n'avez rien à faire ici ! Vous le paierez de votre vie !~
@13461 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13462 = ~Pardon, mais j'ai vraiment trop à faire pour être interrompu à tout bout de champ.~
@13463 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13464 = ~Éloignez-vous de moi ! Je ne vous ferai pas confiance pour un sou !~
@13465 = ~Je vous demande de ne plus me déranger, car j'ai de nombreuses questions financières à régler.~
@13466 = ~Je vous conseille de ne pas trop vous éterniser.~
@13467 = ~Vous ne valez guère mieux que mes ravisseurs ! Laissez-moi !~
@13468 = ~Sortez de ma boutique ! On ne veut pas de vous ici.~
@13469 = ~Éloignez-vous de moi ! Je ne vous ferai pas confiance pour un sou !~
@13470 = ~Sans vouloir vous offenser, je ne désire pas que vous restiez. Laissez-moi à mes affaires.~
@13471 = ~Rebonjour. J'espère que vous vous plaisez ici ? Je fais de mon mieux pour que cette taverne réponde aux besoins de tout le monde.~
@13472 = ~Vous me dégoûtez. Laissez-moi !~
@13473 = ~Laissez-moi donc en paix.~
@13474 = ~Je suppose que tout va comme vous voulez ? N'hésitez pas à quitter les lieux si ce n'est pas le cas.~
@13475 = ~Re-bonjour. C'est vraiment un plaisir de vous avoir parmi nous.~
@13476 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13477 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13478 = ~Plutôt crever que de vous faire confiance !~
@13479 = ~Hé, débarrassez le plancher. Je n'ai pas besoin de vous voir traîner dans ma cuisine ! *soupire* J'aspire à travailler dans un endroit où la bière et le sang ne servent pas d'assaisonnement.~
@13480 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13481 = ~Dehors ! Et que je ne vous revoie plus jamais chez moi !~
@13482 = ~Encore vous ! Par les griffes d'Umberlie, je ne supporterai pas ces interruptions très longtemps. Sortez de ma cuisine, et n'y revenez plus.~
@13483 = ~Dehors ! Et que je ne vous revoie plus jamais chez moi !~
@13484 = ~Ma porte n'est plus ouverte aux individus de votre espèce !~
@13485 = ~Ma porte n'est plus ouverte aux individus de votre espèce !~
@13486 = ~J'espère que vous passez une super soirée ; en tout cas, moi, oui.~
@13487 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13488 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13489 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13490 = ~Faites taire ce maudit barde avant que je lui botte les fesses !~
@13491 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13492 = ~Ne vous avisez pas d'aller déranger les personnes assises à cette table. Vous risqueriez d'attraper un mauvais coup.~
@13493 = ~Laissez-moi ! Vous avez abusé de notre hospitalité !~
@13494 = ~Laissez-moi ! Vous avez abusé de notre hospitalité !~
@13495 = ~Laissez-moi ! Vous avez abusé de notre hospitalité !~
@13496 = ~Laissez-moi ! Vous avez abusé de notre hospitalité !~
@13497 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13498 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13499 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13500 = ~Éloignez-vous de moi ! Je ne vous ferai pas confiance pour un sou !~
@13501 = ~Encore vous ? Laissez-moi tranquille.~
@13502 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13503 = ~Vous aurez la tête tranchée pour ce que vous avez fait !~
@13504 = ~Plutôt crever que de vous faire confiance !~
@13505 = ~Plutôt crever que de vous faire confiance !~
@13506 = ~Plutôt crever que de vous faire confiance !~
@13507 = ~Rien à voir ici, monsieur !~
@13508 = ~Vous n'avez rien à faire ici !~
@13509 = ~Cessez de me déranger, j'ai beaucoup à faire.~
@13510 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13511 = ~Nous vous remercions d'avoir arrêté cette vilaine sorcière avant qu'elle nous tue. Tenez, prenez ça en gage de reconnaissance.~
@13512 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13513 = ~Laissez-moi ! Je ne me sens pas plus en sécurité avec vous qu'avec mes ravisseurs !~
@13514 = ~Laissez-moi ! Je ne me sens pas plus en sécurité avec vous qu'avec mes ravisseurs !~
@13515 = ~Laissez-moi ! Je ne me sens pas plus en sécurité avec vous qu'avec mes ravisseurs !~
@13516 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13517 = ~Laissez-moi !~
@13518 = ~Laissez-moi !~
@13519 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13520 = ~Je vous scalperai pour avoir osé venir ici ! Vous allez tout faire rater !~
@13521 = ~Vous avez abusé de notre hospitalité ! Débarrassez le plancher !~
@13522 = ~Ne me parlez plus, vous m'ennuyez.~
@13523 = ~Vous êtes encore là ? J'aime bien la plaisanterie, mais vous feriez mieux maintenant de déguerpir, et en vitesse !~
@13524 = ~La petite fête n'est pas ENCORE terminée ? C'est incroyable qu'ils ne se soient pas tous endormis sur place.~
@13525 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13526 = ~Vous ne valez guère plus que les animaux que je chasse ! Débarrassez-moi le plancher !~
@13527 = ~Encore vous ? C'est une bonne surprise, même si Carl et Jurgen n'en donnent pas l'impression. Cependant, n'abusez pas de mon hospitalité, car je n'ai pas l'habitude des visites prolongées.~
@13528 = ~Vous êtes décidément parmi les casse-pieds les plus tenaces qui ont hanté ma demeure. Encore une fois, partez si vous ne souhaitez pas sortir avec une « escorte ».~
@13529 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13530 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13531 = ~Vous auriez tout de même pu vous arranger un peu avant de venir ici. Il s'agit de l'événement de l'année et à vous voir on croirait que vous avez dû vous battre contre un garde pour entrer. C'est une honte.~
@13532 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13533 = ~L'occasion est lugubre. Je vous demanderai d'éviter de mal vous comporter.~
@13534 = ~Débarrassez le plancher !~
@13535 = ~Ooo, mais on dirait un vrai bal masqué. Il faudra que je revienne lorsque je pourrai me payer vos services.~
@13536 = ~Ne vous approchez pas de moi ou je vous tanne le cuir !~
@13537 = ~Ne vous approchez pas de moi ou je vous tanne le cuir !~
@13538 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13539 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13540 = ~Je pense que vous devriez partir avant d'effrayer la m'dame.~
@13541 = ~Encore vous ? Pourquoi n'attaquez-vous pas directement la garde si vous tenez tant que ça à créer des problèmes ? Partez immédiatement ou je donne l'alerte.~
@13542 = ~Hum, je trouve étrange que vous ayez confondu votre chambre avec la mienne une fois de plus. Je vous prie de partir.~
@13543 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13544 = ~Encore vous ? Je vous serais reconnaissant de me laisser tant que je ne désire pas votre compagnie. Je vous souhaite bien le bonjour.~
@13545 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13546 = ~Je crois vous avoir déjà demandé de me laisser. Faites ce que je vous dis, ou nous en regretterons tous deux les conséquences.~
@13547 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13548 = ~Encore vous ? Vous avez vraiment décidé de chercher les ennuis, n'est-ce pas ? Heureusement pour vous, j'ai décidé de vous ignorer.~
@13549 = ~Ne vous approchez pas de moi ou je vous tanne le cuir !~
@13550 = ~Je ne vous laisserai pas approcher !~
@13551 = ~Je ne vous laisserai pas approcher !~
@13552 = ~Je vous serais infiniment reconnaissante de bien vouloir me laisser !~
@13553 = ~Je croyais qu'il fallait une invitation pour pouvoir entrer. Qui a laissé passer un agitateur tel que vous ?~
@13554 = ~Je ne vous laisserai pas approcher !~
@13555 = ~Quelque chose... quelque chose ne va pas chez cet homme. Peut-être ai-je de la fièvre, mais je sens quelque chose...~
@13556 = ~Je ne vous laisserai pas approcher !~
@13557 = ~Je ne vous laisserai pas approcher !~
@13558 = ~Je ne vous laisserai pas approcher ! J'ai autre chose à faire que de traîner avec des individus de votre espèce !~
@13559 = ~Re-bonjour.~
@13560 = ~Je ne vous laisserai pas approcher !~
@13561 = ~Je ne vous laisserai pas approcher !~
@13562 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13563 = ~Vous avez mal agi ! Vous paierez pour vos actes !~
@13564 = ~Je me demande ce que vous faites ici ! Hors de ma vue !~
@13565 = ~Vous avez mal agi ! Vous paierez pour vos actes !~
@13566 = ~Vous avez mal agi ! Vous paierez pour vos actes !~
@13567 = ~Je m'excuse, mais j'ai du pain sur la planche.~
@13568 = ~Ma porte n'est plus ouverte aux individus de votre espèce !~
@13569 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13570 = ~Sans vouloir vous offenser, je préférerais que vous me laissiez. J'ai quelques modifications à apporter à mon poème épique.~
@13571 = ~Je perds mon temps avec vous. Laissez-moi.~
@13572 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13573 = ~Je vous conseille de déguerpir. Tout de suite.~
@13574 = ~Je vous conseille de déguerpir. Tout de suite.~
@13575 = ~J'ai de nombreux patients à voir, et je dois vous demander de me laisser.~
@13576 = ~Je vous conseille de déguerpir. Tout de suite.~
@13577 = ~Je vous conseille de déguerpir. Tout de suite.~
@13578 = ~Je vous conseille de déguerpir. Tout de suite.~
@13579 = ~Vous avez abusé de notre hospitalité !~
@13580 = ~Vous n'obtiendrez rien de moi !~
@13581 = ~Vous n'obtiendrez rien de moi !~
@13582 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13583 = ~Je vous ai dit que j'avais du travail ! Maintenant, laissez-moi !~
@13584 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13585 = ~Fichez-moi le camp, je ne veux pas de crâneur tel que vous par ici.~
@13586 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13587 = ~Or~
@13588 = ~N'allez pas trafiquer avec ces apprenties. Faites-moi plutôt confiance à moi, je connais le métier mieux que personne.~
@13589 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13590 = ~Pourquoi ai-je l'impression que, de là où vous venez, « faire la cour » équivaut à chasser du laideron ? Hors de mon chemin, j'ai un exploitant grippe-sous à rembourser.~
@13591 = ~Si vous osez encore m'approcher, je ferai servir vos entrailles sur un plateau !~
@13592 = ~Hors de mon chemin, bande d'empotés !~
@13593 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13594 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13595 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13596 = ~Vous paierez pour vos actes !~
@13597 = ~Eh, quoi ? Je m'excuse, mais je n'ai pas le temps de bavarder pour le moment. Je m'en vais sous des cieux plus cléments.~
@13598 = ~Je pense que vous devriez m'éviter. Je vous déteste de plus en plus, et on m'appelle pas petits bras.~
@13599 = ~Vous avez laissé passé votre chance avec moi, il est trop tard ! Du vent ! Je vous ferai découper en petits morceaux si vous ne partez pas sur-le-champ !~
@13600 = ~Laissez-moi ou vous ne serez plus de ce monde à l'aube !~
@13601 = ~Laissez-moi ou vous ne serez plus de ce monde à l'aube !~
@13602 = ~Bonjour. Je m'appelle Séniyad. Je vous signale que ces terres sont sous ma protection. Si vous en perturbez la quiétude, vous en paieriez las conséquences. Tenez-vous le pour dit.~
@13603 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13604 = ~Excusez-moi mais j'ai beaucoup du travail devant moi.~
@13605 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13606 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13607 = ~Laissez encore une fois traîner votre main baladeuse et je vous la coupe. Juré ! Allez-vous faire servir au bar.~
@13608 = ~Bonjour. Je m'appelle Séniyad. Je vous signale que ces terres sont sous ma protection. Si vous en perturbez la quiétude, vous en paieriez las conséquences. Tenez-vous le pour dit.~
@13609 = ~Je ne dirai plus rien après ce que vous avez fait !~
@13610 = ~Excusez-moi mais j'ai beaucoup du travail devant moi.~
@13611 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13612 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13613 = ~Laissez encore une fois traîner votre main baladeuse et je vous la coupe. Juré ! Allez-vous faire servir au bar.~
@13614 = ~Hors de ma vue, espèce de stupide imbécile !~
@13615 = ~Sortez ou on vous jettera dehors !~
@13616 = ~J'souhaite que les bonstres d'ici vous attrabent !~
@13617 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13618 = ~Je vous prie de m'excuser, mais j'ai beaucoup à faire pour le moment.~
@13619 = ~Vous n'avez rien à faire ici ! Sortez, ou je vous fais jeter dehors !~
@13620 = ~Laissez-moi !~
@13621 = ~Laissez-moi !~
@13622 = ~Laissez-moi !~
@13623 = ~Laissez-moi !~
@13624 = ~Laissez-moi !~
@13625 = ~Laissez-moi !~
@13626 = ~J'espère que vous avez appris les bonnes manières depuis notre dernière rencontre ? Sinon, prenez la porte.~
@13627 = ~Bienvenue de nouveau parmi nous. J'espère que nous pourrons vous aider.~
@13628 = ~Plutôt crever que de vous faire confiance !~
@13629 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13630 = ~Laissez-moi ou vous le regretterez !~
@13631 = ~Je vous apprendrai le respect ! Vous ne sortirez pas d'ici debout !~
@13632 = ~Misérables avortons ! Hors de mon chemin, où j'vous crève les yeux !~
@13633 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13634 = ~Votre mort me fera le plus grand plaisir !~
@13635 = ~Impie ! J'aurai votre peau !~
@13636 = ~Attendez un peu ! Vous allez recevoir une correction bien méritée !~
@13637 = ~Je vous ai déjà dit que je ne voulais pas de vous ici ! Partez maintenant !~
@13638 = ~Vous avez abusé de notre hospitalité !~
@13639 = ~Je n'ai pas plus de patience que lors de votre première visite. Partez, où vous le regretterez pour le reste de votre très courte vie !~
@13640 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13641 = ~Laissez-moi !~
@13642 = ~Laissez-moi !~
@13643 = ~À votre place, je ne traînerais pas trop dans les parages. Maman peut devenir très méchante quand on l'énerve.~
@13644 = ~Laissez-moi !~
@13645 = ~Vous n'avez rien à faire ici !~
@13646 = ~Si vous ne sortez pas sur-le-champ, j'appelle quelqu'un pour vous « aider ».~
@13647 = ~Vous n'avez rien à faire ici !~
@13648 = ~Vous n'avez rien à faire ici !~
@13649 = ~Vous n'obtiendrez rien de moi !~
@13650 = ~Laissez-moi !~
@13651 = ~Vous ne vous êtes pas fait que des amis par ici ! Du vent !~
@13652 = ~Bonjour, ça va ? Oh, c'est encore vous. Si vous voulez bien m'excuser, je ne suis pas franchement d'humeur à discuter pour le moment. Laissez-moi.~
@13653 = ~Encore ?! Vous tentez le diable en osant revenir dans MA maison ! Je ne supporterai pas votre présence une seconde de plus que nécessaire ! Hors de ma vue !~
@13654 = ~Sortez ou on vous jettera dehors !~
@13655 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13656 = ~Vous avez abusé de notre hospitalité !~
@13657 = ~Vous avez abusé de notre hospitalité !~
@13658 = ~Vous avez mal agi ! Partez !~
@13659 = ~Re-bonjour. Je suppose que vous appréciez Bérégost dans toute sa piètre splendeur ?~
@13660 = ~Vous n'avez rien à faire chez moi. C'est une phrase que je n'ai pas l'habitude de prononcer, mais elle n'en est pas moins appropriée. Veuillez quitter les lieux.~
@13661 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13662 = ~Ne me dérangez pas, je dois préparer mes bagages.~
@13663 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13664 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13665 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13666 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13667 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13668 = ~Je vous flanque une gifle si jamais vous avancez d'un millimètre de plus !~
@13669 = ~Laissez-moi tranquille ! J'ai du travail !~
@13670 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13671 = ~Alors j'lui dis au type : « Mais chi ch'est ta shœur, où ch'qu'elle est ma FEMME ? » OUAH ! Oh pardon, j'vous ai craché dessus ? Ah, ça fait plaisir de vous revoir ! Je bois pour m'donner le cœur de repartir sur c'te piste poussiéreuse. Mais j'vais peut-être m'attarder un chouïa ; le ciel est clair mais pas ma tête.~
@13672 = ~Surprenant, ce coup de pied dans la tête, non ? Notre rabat-joie a rejoint le pays des fêtards. Je suppose que vous allez vous montrer un peu plus aimable maintenant ?~
@13673 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13674 = ~Sans vouloir vous offenser, je préférerais que vous déguerpissiez sur-le-champ.~
@13675 = ~Laissez-moi, espèce d'ordure !~
@13676 = ~Vous avez laissé passer votre chance avec moi, il est trop tard ! Du vent !~
@13677 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13678 = ~Je ne tolérerai pas votre présence après ce que vous avez fait !~
@13679 = ~Excusez-moi, mais je dois m'occuper de mes cultures.~
@13680 = ~Laissez-moi. Je n'ai rien pour vous.~
@13681 = ~Pardon si je vous offense, mais il faut que je parte, et vite.~
@13682 = ~Vous m'avez assez dérangé comme ça !~
@13683 = ~Hors de ma vue ! Je ne peux rien pour vous !~
@13684 = ~Quel plaisir de vous revoir ! Eh bien, je ferais mieux d'y aller, car j'ai des têtes à couper.~
