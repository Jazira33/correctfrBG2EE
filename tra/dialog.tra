@23893 = ~Aaaah ! Môman !~
@23894 = ~Vous ferez pas d'mal à Môman ou Pôpa !~
@23895 = ~Vous êtes drôle. Pas comme les autres.~
@23896 = ~~
@23897 = ~~
@23898 = ~Si vous venez à bout de ma patience, je vous attacherai au bout de mon ancre.~
@23899 = ~Abandonnez le navire, matelots ! Nous coulons !~
@23900 = ~Je vous ferai tous passer sous la quille !~
@23901 = ~Le garçon de cabine, le garçon de cabine, ah le petit salopiau... ahh, la mer, elle m'appelle.~
@23902 = ~~
@23903 = ~~
@23904 = ~Je dois sortir d'ici ! Je dois sortir d'ici !~
@23905 = ~~
@23906 = ~~
@23907 = ~Laissez-moi tranquille ! Reculez !~
@23908 = ~~
@23909 = ~~
@23910 = ~Je ne peux rien faire ici ! Pourquoi chercher ?~
@23911 = ~Je ne suis pas encore morte ! Allez-vous-en !~
@23912 = ~Défendez-vous ! Votre mort est proche !~
@23913 = ~Je ne laisserai pas cet endroit gagner !~
@23914 = ~~
@23915 = ~~
@23916 = ~Ah, c'est vous la nouveauté. Je n'ai jamais vu personne comme vous avant.~
@23917 = ~~
@23918 = ~Vous ne pourrez plus faire de mal !~
@23919 = ~Vous êtes... intéressant ! Je ne suis pas habitué aux gens tels que vous !~
@23920 = ~~
@23921 = ~~
@23922 = ~Eh bien, voilà une étrange vision.~
@23923 = ~Je ne veux plus vous voir !~
@23924 = ~~
@23925 = ~Vous êtes très étrange. Je trouve ça... intéressant.~
@23926 = ~~
@23927 = ~~
@23928 = ~J'vous causerai si vous en avez envie.~
@23929 = ~Hey, salut la jeunesse.~
@23930 = ~On dirait que vous n'êtes pas du coin.~
@23931 = ~Bienvenue dans notre petit village.~
@23932 = ~Faites vite, je n'ai pas de temps à perdre.~
@23933 = ~Vous êtes nouveau, ça se voit.~ ~Vous êtes nouvelle, ça se voit.~
@23934 = ~pourquoi est-ce que vous me dérangez ?~
@23935 = ~Oooh, une nouvelle tête dans le village, hein ?~
@23936 = ~Vous voulez me parler ? Eh bien, faites.~
@23937 = ~Oui ? Vous voulez dire quelque chose ?~
@23938 = ~Dernièrement, il y a eu un peu d'animation.~
@23939 = ~C'est toujours un plaisir de parler à de nouvelles connaissances.~
@23940 = ~Vous n'avez pas entendu et vous ne verrez pas.~
@23941 = ~Votre heure viendra. Sachez l'accepter quand ce sera le cas.~
@23942 = ~Laissez-nous et ne revenez pas avant la fin de votre monde.~
@23943 = ~Nous n'avons pas de temps à perdre avec vous.~
@23944 = ~Vous êtes... différent.~ ~Vous êtes... différente.~
@23945 = ~Je sens... des étrangers ?~
@23946 = ~Parlez puis partez ! Je ne veux pas vous voir dans le coin.~
@23947 = ~vous n'êtes pas comme nous.~
@23948 = ~Certains ne vous feront pas confiance... certains comme moi.~
@23949 = ~Je vous livre mes pensées : partez dès que vous pouvez !~
@23950 = ~Vous n'êtes pas comme nous.~
@23951 = ~Vous n'êtes pas comme nous. Vous n'êtes pas d'ici.~
@23952 = ~intéressant. Vous êtes très différents.~
@23953 = ~Vous êtes de l'extérieur ? Bienvenue dans ce cas.~
@23954 = ~Je ne vous connais pas. Vous êtes. étranger.~ ~Je ne vous connais pas. Vous êtes. étrangère.~
@23955 = ~Je n'en avais jamais vu des comme vous avant.~
@23956 = ~Bougez-vous, soldats ! Les ennemis sont partout !~
@23957 = ~En avant, soldats ! Cherchez les survivants et méfiez-vous des illusions magiques.~
@23958 = ~Oui, mon seigneur. Cela sera fait selon vos instructions.~
@23959 = ~Pour la reine !~
@23960 = ~Tueurs d'enfants ! La colère des justes vous emportera aujourd'hui !~
@23961 = ~Déposez vos armes, et préparez-vous à vivre comme des esclaves !~
@23962 = ~Votre ville est condamnée ! L'esclavage est préférable à la mort, n'est-ce pas ?~
@23963 = ~Si Irenicus devait un jour gouverner, cela ne serait que sur un royaume de mort.~
@23964 = ~Les enfants de Rillifane ne se prosterneront jamais devant vous ! Mort à nos ennemis !~
@23965 = ~Fouillez les profanateurs !~
@23966 = ~Rappelez votre démon puant, Alutho ! J'ai souillé mon armure.~
@23967 = ~Mort à la vermine humaine !~
@23968 = ~*les corps de nombreux voleurs aux cagoules noires jonchent le sol du couloir, apparemment tués par une déflagration massive de nature magique... d'après les explosions encore audibles au loin, il semblerait que la bataille qui a causé leur mort n'est pas encore achevée*~
@23969 = ~*la salle des fêtes de Dame Galvena est actuellement fermée... il faudra revenir plus tard*~
