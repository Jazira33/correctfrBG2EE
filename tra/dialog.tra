@72046 = ~Yoshimo est mort et ne peut donc pas être importé dans Baldur's Gate II : Le Trône de Bhaal.~
@72047 = ~Imoen ne peut être importée dans Baldur's Gate II : Le Trône de Bhaal tant que vous ne l'avez pas sauvée. Vous pourrez néanmoins disposer d'une « version mise à jour » d'Imoen depuis Baldur's Gate II : Le Trône de Bhaal.~
@72048 = ~Dragon pourpre~
@72049 = ~Dragon pourpre~
@72050 = ~C'était pas loin... Y a eu de la casse ?~
@72051 = ~Rien de bien grave...~
@72052 = ~<CHARNAME>~
@72053 = ~<CHARNAME>~
@72054 = ~Maître ténébreux~
@72055 = ~Maître ténébreux~
@72056 = ~Ainsi... Mélissanne, tu es revenue dans mon monastère.~
@72057 = ~En effet. Balthazar, j'ai besoin de...~
@72058 = ~Il suffit ! On m'a raconté ce qui s'est passé à Saradush. Je sais tout au sujet de l'enfant de Bhaal.~
@72059 = ~Oui, c'est regrettable. Mais je peux tout expliquer, mon vieil ami...~
@72060 = ~Non. Tu me forces à dévoiler mon jeu. Il est temps pour toi de mourir.~
@72061 = ~Quoi ? Mais que fais-tu ?!~
@72062 = ~Appel de la Sombre Meute~
@72063 = ~Tu n'es pas une enfant de Bhaal, Mélissanne. Ton rôle s'arrête ici... Je vais m'en assurer. Mes frères, saisissez-la !~
@72064 = ~Cette gemme est semblable à un diamant... mais elle luit d'un éclat intense et est tellement froide que l'on ne peut la toucher. Même enveloppée dans plusieurs épaisseurs de tissu, elle continue de refroidir l'air alentour.

PARAMÈTRES :

Poids : 0~
@72065 = ~~
@72066 = ~*la petite créature draconique ronronne d'un air perplexe en écarquillant les yeux... puis, elle recule nerveusement vers <CHARNAME>... visiblement, elle ne souhaite pas vous parler*~
@72067 = ~*la petite créature draconique bat des ailes joyeusement, en vous regardant avec des yeux changeants, presque kaléidoscopiques* « Vous désirez quelque chose ? » *elle attend avec impatience, en remuant la queue, que vous lui prêtiez attention*~
@72068 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72069 = ~*les yeux de la créature s'illuminent, et elle saute spontanément dans vos bras, prête à être rangée dans vos affaires, où elle pourra dormir et, de temps à autre, sortir la tête à l'extérieur*~
@72070 = ~*la caresser et jouer avec elle*~
@72071 = ~*le dragon gazouille de contentement, ses yeux multicolores tourbillonnent alors que vous caressez sa peau chaude et tannée* « Vous êtes très gentil avec moi, mon maître. » *dit-il en ronronnant*~ ~*le dragon gazouille de contentement, ses yeux multicolores tourbillonnent alors que vous caressez sa peau chaude et tannée* « Vous êtes très gentille avec moi, ma maîtresse. » *dit-il en ronronnant*~
@72072 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72073 = ~Tu n'aurais pas un conseil à me donner, par hasard ?~
@72074 = ~*le familier courbe le cou et vous regarde d'un air un peu perplexe* « Vous voulez me demander conseil, ô maître ? À moi ? »~ ~*le familier courbe le cou et vous regarde d'un air un peu perplexe* « Vous voulez me demander conseil, ô maîtresse ? À moi ? »~
@72075 = ~~
@72076 = ~~
@72077 = ~~
@72078 = ~~
@72079 = ~~
@72080 = ~~
@72081 = ~~
@72082 = ~~
@72083 = ~Comment vas-tu ? Tout va bien ?~
@72084 = ~*le dragon agite la queue de contentement et vous contemple de ses yeux colorés* « Tant que vous allez bien, maître, alors tout va bien pour moi aussi. »~ ~*le dragon agite la queue de contentement et vous contemple de ses yeux colorés* « Tant que vous allez bien, maîtresse, alors tout va bien pour moi aussi. »~
@72085 = ~« Cependant, je... je suis légèrement blessé, maître. Mes coupures picotent et ça saigne. Ce... ce n'est guère agréable. »~ ~« Cependant, je... je suis légèrement blessé, maîtresse. Mes coupures picotent et ça saigne. Ce... ce n'est guère agréable. »~
@72086 = ~« Cependant, je... je suis grièvement blessé, maître ! Je ne veux pas mourir, papa ! Je veux rester avec vous. » *le dragon gémit faiblement et enroule sa queue autour de votre jambe*~ ~« Cependant, je... je suis grièvement blessé, maîtresse ! Je ne veux pas mourir, maman ! Je veux rester avec vous. » *le dragon gémit faiblement et enroule sa queue autour de votre jambe*~
@72087 = ~« Mais puisque vous me le demandez, je ne serais pas contre un petit encas. Peut-être un bel écureuil. Ou une tarte... ooooh, oui, j'adore les tartes ! »~
@72088 = ~« J'aime voyager en votre compagnie. J'aime beaucoup, ô maître. Vous auriez une pomme ? Je pourrais la faire légèrement caraméliser et ensuite la dévorer. C'est très bon, les pommes ! »~ ~« J'aime voyager en votre compagnie. J'aime beaucoup, ô maîtresse. Vous auriez une pomme ? Je pourrais la faire légèrement caraméliser et ensuite la dévorer. C'est très bon, les pommes ! »~
@72089 = ~« Je suis émerveillé par tous les nouveaux lieux que je découvre avec vous. Tout est si merveilleux et si coloré ! Le monde entier est-il fait ainsi, maître ? »~ ~« Je suis émerveillé par tous les nouveaux lieux que je découvre avec vous. Tout est si merveilleux et si coloré ! Le monde entier est-il fait ainsi, maîtresse ? »~
@72090 = ~« Je me sens merveilleusement bien, mon maître. Ma peau est propre, et je suis prêt à vous aider contre tous les dangers ! »~ ~« Je me sens merveilleusement bien, ma maîtresse. Ma peau est propre, et je suis prêt à vous aider contre tous les dangers ! »~
@72091 = ~Alors continuons à avancer.~
@72092 = ~*le dragon remue la queue d'un air satisfait, puis tourne à nouveau son regard vers le chemin devant vous* « Selon vos désirs, ô mon maître. »~ ~*le dragon remue la queue d'un air satisfait, puis tourne à nouveau son regard vers le chemin devant vous* « Selon vos désirs, ô ma maîtresse. »~
@72093 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72094 = ~*les yeux de la créature s'illuminent, et elle saute spontanément dans vos bras, prête à être rangée dans vos affaires, où elle pourra dormir et, de temps à autre, sortir la tête à l'extérieur*~
@72095 = ~Tu n'aurais pas un conseil à me donner, par hasard ?~
@72096 = ~Comment vas-tu ? Tout va bien ?~
@72097 = ~Non, tout va bien. Continuons à avancer.~
@72098 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72099 = ~Samej~
@72100 = ~Samej~
@72101 = ~Regarde-moi, <CHARNAME>. Regarde ce que tu aurais été si Gorion avait pris Sarevok à ta place... si tu avais suivi un autre chemin.~
@72102 = ~Regarde-moi et sache que je te méprise, que je suis indigné par la vie facile à laquelle tu as eu droit. J'aurais tout donné pour avoir un foyer et un père comme Gorion.~ ~Regarde-moi et sache que je te méprise, que je suis indignée par la vie facile à laquelle tu as eu droit. J'aurais tout donné pour avoir un foyer et un père comme Gorion.~
@72103 = ~Je refuse de te laisser vivre. Arrête-moi... si tu le peux.~
@72104 = ~Troll du désert~
@72105 = ~Tu... tu es l'un des nôtres. Tu es un enfant de Bhaal, n'est-ce pas ?~ ~Tu... tu es l'une des nôtres. Tu es une enfant de Bhaal, n'est-ce pas ?~
@72106 = ~Oh, mais... inutile de t'inquiéter pour moi. Je suis mort. Je ne suis plus personne. J'ai grandi dans un petit village de fermiers... je ne savais même pas qui j'étais avant qu'ils ne viennent me chercher.~
@72107 = ~Mais je savais que j'étais différent. Tu peux entendre les cris dans la nuit, n'est-ce pas ? Tu peux sentir le sang des morts qui est versé tout autour de toi... mille douleurs différentes, mais tu n'es qu'un écho solitaire.~
@72108 = ~Mais cela n'a rien de terrible. C'est une invitation, un appel. Et si tu t'y abandonnes, si tu lui ouvres ton cœur tout entier, tout devient clair comme du cristal. Un meurtre, deux, un millier... ils font partie de toi.~
@72109 = ~J'ai tué trois filles avant d'être... banni. Ensuite, je suis parti vers la ville. Les meurtres y étaient plus faciles, et j'en ressentais le besoin chaque nuit. Tu peux goûter à la vie, tu sais... et c'est divin.~
@72110 = ~Je peux sentir la même chose en toi... je sais que tu entends cet appel et que tu y réponds comme je l'ai fait, n'est-ce pas ? Ce pouvoir n'appartient qu'à nous seuls, enfants de Bhaal. Et la seule chose que tu dois craindre...~
@72111 = ~Mais... tu y résistes, n'est-ce pas ? Pourquoi ? Je peux sentir que tu as massacré beaucoup de gens, et pourtant tu résistes à tout le bien que nous seuls, les enfants de Bhaal, pouvons apprécier. Après tout... tu ne dois craindre qu'une seule chose...~
@72112 = ~... le châtiment.~
@72113 = ~Gavid~
@72114 = ~Gavid~
@72115 = ~Vous avez peut-être vaincu le prince élémentaire, mais je ne suis pas aussi facile à tuer. Anéantissez cette racaille !~
@72116 = ~Jamis Tombelthen~
@72117 = ~Jamis Tombelthen~
@72118 = ~Capitaine du Téthyr~
@72119 = ~Capitaine du Téthyr~
@72120 = ~Piquier du Téthyr~
@72121 = ~Piquier du Téthyr~
@72122 = ~Archer du Téthyr~
@72123 = ~Archer du Téthyr~
@72124 = ~Mage de combat du Téthyr~
@72125 = ~Mage de combat du Téthyr~
@72126 = ~*cette échelle vétuste ne semble pas en très bon état, mais vous pouvez tenter de la gravir si vous le souhaitez... pour l'escalader, interagissez avec la partie supérieure pour descendre et avec la partie inférieure pour monter*~
@72127 = ~*vous tentez de grimper sur l'échelle mais ne parvenez pas à atteindre le sommet*~
@72128 = ~Corde~
@72129 = ~Cette corde a été spécifiquement conçue pour les expéditions spéléologiques. Elle permet de nager le long de tortueux tunnels inondés sans pour autant se perdre.

PARAMÈTRES :

Poids : 5~
@72130 = ~Corde~
@72131 = ~Potion de respiration~
@72132 = ~Cette potion permet de retenir sa respiration beaucoup plus longtemps que la normale. Il y en a suffisamment pour une seule dose, ce qui devrait vous permettre de traverser le plus long tunnel immergé.

PARAMÈTRES :

Poids : 1~
@72133 = ~*vous tentez de descendre sur l'échelle mais tombez en cours de route*~
@72134 = ~Parchemin d'inversion~
@72135 = ~Parchemin d'inversion~
@72136 = ~Ce parchemin peut dissiper le sort de quête d'Abazigal sur le dragon qui le garde.~
@72137 = ~Yuan-ti d'élite~
@72138 = ~Yuan-ti d'élite~
@72139 = ~Prince yuan-ti~
@72140 = ~Prince yuan-ti~
@72141 = ~Le dessus de cette table est recouvert de formes enflammées. Il est possible de la tourner.~
@72142 = ~Cette table est froide au toucher et il est possible de la faire pivoter.~
@72143 = ~Vous recevez une décharge d'électricité statique quand vous touchez cette table. Il semble que vous pouvez la faire pivoter.~
@72144 = ~Malgré l'odeur atroce qui s'en dégage, vous pouvez faire bouger cette table.~
@72145 = ~Salamandre du froid~
@72146 = ~Salamandre du froid~
@72147 = ~~
@72148 = ~Je suis une partie de toi que tu as oubliée, <CHARNAME>. Une partie de toi que tu as rejetée.~
@72149 = ~C'est moi qui ai grandi à Château-Suif, ignorant mon héritage... ignorant le Mal qui guettait dans mon âme. J'ai quitté mon foyer il y a longtemps, les yeux brillants à l'idée d'affronter le monde.~
@72150 = ~Je suis ton innocence, <CHARNAME>.~
@72151 = ~Il est inutile de me perdre pour toujours. Tu n'as pas besoin de me repousser, <CHARNAME>. Ta lutte contre la souillure de ton père m'a usée, mais je suis encore là. Tu peux encore me reconquérir !~
@72152 = ~~
@72153 = ~~
@72154 = ~~
@72155 = ~~
@72156 = ~~
@72157 = ~~
@72158 = ~~
@72159 = ~~
@72160 = ~~
@72161 = ~~
@72162 = ~~
@72163 = ~~
@72164 = ~~
@72165 = ~~
@72166 = ~~
@72167 = ~~
@72168 = ~~
@72169 = ~~
@72170 = ~~
@72171 = ~~
@72172 = ~~
@72173 = ~~
@72174 = ~~
@72175 = ~Je ne te connais pas. C'est toi qui a poussé <CHARNAME> à me perdre à jamais, sans aucun doute ! Arrière, arrière !~
@72176 = ~Je suis une partie de ce qui était autrefois dans chaque recoin de ton âme, <CHARNAME>, mais je m'affaiblis un peu plus chaque jour. Tu m'as abandonné.~
@72177 = ~J'ai pris forme à Château-Suif pendant ta jeunesse, ignorant ton héritage... ignorant le mal qui imprégnait ton âme. C'est moi qui ai veillé sur toi, qui connaissait tes limites, qui t'a conseillé la prudence.~
@72178 = ~Je suis ton doute, <CHARNAME>, ton incertitude.~
@72179 = ~~
@72180 = ~~
@72181 = ~~
@72182 = ~~
@72183 = ~~
@72184 = ~~
@72185 = ~~
@72186 = ~~
@72187 = ~~
@72188 = ~~
@72189 = ~~
@72190 = ~~
@72191 = ~~
@72192 = ~~
@72193 = ~~
@72194 = ~~
@72195 = ~~
@72196 = ~~
@72197 = ~~
@72198 = ~~
@72199 = ~~
@72200 = ~~
@72201 = ~~
@72202 = ~~
@72203 = ~~
@72204 = ~Je ne te connais pas. C'est peut-être toi qui m'a fait perdre <CHARNAME>. Mais va t'en, arrière !~
@72205 = ~Renversement~
@72206 = ~Fiole vide de potion de respiration~
@72207 = ~Fiole vide de potion de respiration~
@72208 = ~Cette fiole peut contenir une dose de Potion de respiration, si vous arrivez à trouver un endroit pour la remplir. Cette potion vous permettra de nager dans les tunnels immergés sous l'enclave.

PARAMÈTRES :

Poids : 1~
@72209 = ~*bien que l'eau trouble et le panache de vapeur de la source chaude ait failli vous faire rater sa présence, vous remarquez un tunnel sous la surface de l'eau... vous pouvez y plonger et l'explorer si vous le souhaitez*~
@72210 = ~*le tunnel est droit et vous apercevez une lumière au bout, mais il est bien trop long pour être traversé à la nage... si seulement vous pouviez retenir votre souffle un peu plus longtemps, vous pourriez y arriver*~
@72211 = ~*le tunnel serpente sous vos pieds... il est trop dangereux de se risquer à y plonger sans corde et sans moyen de s'alimenter en oxygène... vous devrez revenir plus tard*~
@72212 = ~*vous plongez dans le tunnel et nagez aussi vite que possible jusqu'à l'autre extrémité*~
@72213 = ~*cette fontaine magique permet de produire une petite quantité de Potion de respiration... ce liquide magique vous permettra de retenir votre respiration pendant une longue durée... vous pouvez essayer d'en rassembler suffisamment pour remplir la fiole*~
@72214 = ~Les tunnels. *tousse* Les tunnels sont la seule solution. Les cavernes d'Abazigal sont reliées par des tunnels souterrains. Vous devrez les explorer pour trouver votre chemin à travers le labyrinthe de grottes.~
@72215 = ~*vous avez besoin d'une Fiole vide de potion de respiration pour recueillir le liquide*~
@72216 = ~*vous parvenez à récupérer assez de liquide pour remplir la fiole*~
@72217 = ~*impossible de remplir la fiole dans son intégralité... la fontaine devrait se réalimenter le temps que vous utilisiez la potion que vous avez déjà*~
@72218 = ~Puisque vous êtes arrivés jusqu'ici, vous devez déjà avoir découvert que certains bassins à l'intérieur du complexe contiennent un liquide qui permet à vos poumons de respirer dans l'eau pendant un court moment. *tousse grassement*~
@72219 = ~Vous devez déjà avoir mis la main dessus pour être parvenus aussi loin. Ne le perdez pas !~
@72220 = ~Je voudrais savoir pourquoi Balthazar vous a envoyé ici tout seul.~
@72221 = ~Je connais déjà ces tunnels. C'est en les utilisant que je suis arrivé ici.~ ~Je connais déjà ces tunnels. C'est en les utilisant que je suis arrivée ici.~
@72222 = ~Mais il y a certains tunnels que je ne puis utiliser !~
@72223 = ~Certains tunnels sont longs et sombres. *tousse* Il est facile de s'y perdre à l'intérieur. *tousse plus sèchement* Si vous disposiez d'une corde, vous pourriez l'utiliser pour vous guider dans l'obscurité.~
@72224 = ~Ce serait formidable si vous aviez cette corde.~
@72225 = ~Laissez-moi deviner... vous avez une corde en votre possession.~
@72226 = ~J'avais caché cette corde sous ma robe, au cas où se présenterait l'occasion de s'échapper de cet effroyable endroit. *tousse* Prenez-la. Elle vous permettra de traverser même les plus longs tunnels.~
@72227 = ~Y a-t-il autre chose que je devrais savoir ?~
@72228 = ~Merci pour la corde, pouilleux ! Je vais vous laisser ici et poursuivre ma route !~
@72229 = ~Oui, en effet. *tousse* Quelque chose que vous devez faire avant d'affronter Abazigal. L'entrée de son sanctuaire est défendue par un dragon.~
@72230 = ~Ce n'est pas un ver de terre qui va m'empêcher de parvenir jusqu'à Abazigal !~
@72231 = ~Ne vous inquiétez pas. Les dragons, c'est ma spécialité.~
@72232 = ~Le dragon ne sert pas Abazigal de son plein gré. *tousse* Un sort de quête le contraint à défendre l'entrée du sanctuaire. *tousse* Et même si vous arrivez à le vaincre, le sort qui scelle les portes n'en serait pas brisé pour autant.~
@72233 = ~Quand Balthazar m'a envoyé ici pour ma... mission, *tousse* j'ai amené avec moi un puissant parchemin d'inversion pour briser le sort de quête et ouvrir l'entrée des chambres privées d'Abazigal. *tousse*~
@72234 = ~Le parchemin me fut pris, mais il ne peut être détruit et... *tousse* je crois qu'il est toujours en possession des sous-fifres d'Abazigal. *tousse* Vous devez trouver ce parchemin pour pouvoir briser le sort de quête et arriver jusqu'à Abazigal.~
@72235 = ~Je suis au service de Balthazar. *tousse* Les hommes lézards m'ont torturé pendant des semaines mais je ne leur ai rien dit de plus. Mais ma mission est désormais sans importance. L'essentiel est qu'Abazigal soit bientôt anéanti.~
@72236 = ~Y a-t-il autre chose que je devrais savoir ?~
@72237 = ~*un mur de force invisible vous empêche d'entrer dans la caverne... vous devez trouver un moyen de le dissiper avant de pouvoir entrer*~
@72238 = ~Je ne puis vous le dire. *tousse* Ma mission s'achève avec ma mort. *tousse* Je dois accepter l'idée que je ne quitterai pas cet endroit vivant.~
@72239 = ~Ne vous inquiétez pas... Je trouverai bien un chemin pour vous sortir d'ici.~
@72240 = ~Malchance~
@72241 = ~Écoute-moi, <CHARNAME> !~
@72242 = ~Ébriété~
@72243 = ~Nous devons parler ! Je t'en prie !~
@72244 = ~Ne m'oblige pas à faire ça !~
@72245 = ~L'enclave d'Abazigal

J'ai découvert un des disciples de Balthazar emprisonné ici. Avant de mourir, le moine m'a expliqué comment trouver et vaincre Abazigal. Je dois trouver le Parchemin d'inversion pour rompre le sort de quête qui contraint le dragon gardien et qui scelle l'entrée de l'enclave intérieure d'Abazigal.

Les cavernes sont reliées entre elles par des tunnels sous-marins. Heureusement, j'ai maintenant une corde et un peu plus de potion de respiration aquatique, et je pourrai donc explorer ces tunnels. Que je le veuille ou non, je suppose qu'il va falloir que je m'adonne à la spéléologie.~
@72246 = ~Draconis est mort ! Fermez l'enclave ! Ils ne doivent pas atteindre Abazigal !~
@72247 = ~*l'alarme a été déclenchée et l'antre d'Abazigal est bouclé... il va falloir trouver un autre chemin*~
@72248 = ~Bienvenue, enfant de mon vieil ennemi. Il est temps que nous parlions, toi et moi.~ [CYRIC01]
@72249 = ~Mais d'abord... assurons-nous de ne pas être ennuyés par un de tes soi-disant amis... il s'agit d'une affaire privée.~ [CYRIC02]
@72250 = ~tuy~
@72251 = ~hgfhg~
@72252 = ~Bien. Commençons par le moins important. Sais-tu qui je suis ?~ [CYRIC03]
@72253 = ~Non. Aucune idée.~
@72254 = ~Ton visage me rappelle vaguement quelque chose...~
@72255 = ~Tu es... l'actuel dieu du meurtre ?~
@72256 = ~Oui. Tu es Cyric, le dieu du meurtre régnant.~
@72257 = ~Tsss. Je pensais que Bhaal aurait semé ses graines un peu plus intelligemment. Mais peu importe. Je suis Cyric, le dieu du meurtre régnant... mais aussi celui des conflits, des mensonges et des illusions.~
@72258 = ~Eh vous ! L'intrus ! Pourquoi harcelez-vous le serviteur préféré d'Abazigal ?~ ~Eh vous ! L'intruse ! Pourquoi harcelez-vous le serviteur préféré d'Abazigal ?~
@72259 = ~Mes affaires ne vous regardent pas.~
@72260 = ~Je cherche un Parchemin d'inversion. En avez-vous vu un ?~
@72261 = ~Oui, tu le savais, n'est-ce pas ? Je suis Cyric, en effet... le dieu du meurtre mais aussi celui des conflits, des mensonges et de l'illusion, entre autres choses que nous ne détaillerons pas ici.~
@72262 = ~Qui êtes-vous et qui sont ces... serviteurs ?~
@72263 = ~J'ai été guéri récemment d'un léger accès de folie... bien que cela n'ait aucune importance pour toi... pour constater en me réveillant que les enfants de mon prédécesseur avaient poussé un peu partout comme des mauvaises herbes.~
@72264 = ~Je suis Iycanth l'Éclairé, le magicien favori d'Abazigal, gouverneur de Toril ! Ces adorables créatures sont mes dernières expériences et mes meilleurs amis.~
@72265 = ~Vos meilleurs amis sont des globes oculaires ?~
@72266 = ~Les choses commencent à se résoudre d'elles-mêmes, et il ne reste plus qu'une poignée d'enfants de Bhaal. Ils sont comme toi très puissants, ce sont des mortels pleins de ressources. Comme je l'étais autrefois. Je pense que tu peux comprendre mon inquiétude, hein ?~
@72267 = ~Je cherche un Parchemin d'inversion. Pouvez-vous me renseigner ?~
@72268 = ~Des expériences ? Avec des globes oculaires ?~
@72269 = ~Il ne reste plus qu'une poignée d'enfants de Bhaal, bien sûr. Comme toi. Je ne suis pas convaincu que tu aies le tempérament ou le désir de régner sur le meurtre... mais on ne sait jamais. Tu comprends mon inquiétude, hein ?~
@72270 = ~Un mets Unthérien ? À découper et à consommer avec des poireaux ?~
@72271 = ~Euh... non. Un parchemin d'inversion. Un sort pour annuler un puissant sort de quête ?~
@72272 = ~Je suppose que vous êtes fou ?~
@72273 = ~Vous remarquerez, jeune homme, l'absence de bouche ou de tout autre orifice vomitoire sur les globes. Vous feriez bien d'essayer d'évoluer de cette manière. Bien, que voulez-vous ?~ ~Vous remarquerez, mademoiselle, l'absence de bouche ou de tout autre orifice vomitoire sur les globes. Vous feriez bien d'essayer d'évoluer de cette manière. Bien, que voulez-vous ?~
@72274 = ~Eh bien, en effet, il se pourrait que j'en ai un quelque part qui traîne dans mon tiroir à chaussettes. C'est une vraie pagaille !~
@72275 = ~Je vois. Puis-je avoir le parchemin d'inversion ?~
@72276 = ~Donnez-moi le parchemin, pauvre fou, ou je l'arracherai de votre cadavre !~
@72277 = ~Très bien, je vais te libérer. *lire le parchemin*~
@72278 = ~Qu'est-ce qui m'empêche de te tuer et de prendre la pierre ?~
@72279 = ~Comment puis-je être sûr que tu es Cyric ? Tu n'as pas du tout l'air d'un dieu.~ ~Comment puis-je être sûre que tu es Cyric ? Tu n'as pas du tout l'air d'un dieu.~
@72280 = ~Vous êtes fou !~
@72281 = ~Comment puis-je être sûr que tu es Cyric ? Tu n'as pas du tout l'air d'un dieu.~ ~Comment puis-je être sûre que tu es Cyric ? Tu n'as pas du tout l'air d'un dieu.~
@72282 = ~Voilà qui est dit. Bon. Que voulez-vous ?~
@72283 = ~Par rapport à qui ? Un sinistre avatar comme l'Écorcheur ? Un nuage de fumée ? Un immense visage dans le ciel à la voix retentissante ? Je ne suis ici que pour te parler, pour évaluer la menace que tu représentes pour moi... si c'est le cas.~ [CYRIC04]
@72284 = ~~
@72285 = ~Je cherche un Parchemin d'inversion. Pouvez-vous me renseigner ?~
@72286 = ~Si je représente une menace pour toi, pourquoi ne me tues-tu pas ?~
@72287 = ~Je ne fais principalement qu'explorer le coin. Je ne cherche pas à vous créer d'ennuis.~
@72288 = ~Me débarrasser de vous et prendre tout ce que vous possédez de valeur.~
@72289 = ~Euh, si seulement cela était aussi simple. Mais je suis impliqué dans toute cette histoire d'enfants de Bhaal, et mes adversaires divins interviendraient alors. Mystra... ou Kelemvor, peut-être.~ [CYRIC05]
@72290 = ~Eh bien, ce sont des grottes privées. Allez donc ennuyer un des dragons si vous voulez vous amuser. Je vous souhaite bien le bonjour.~
@72291 = ~Et il semble que Ao, l'Archipère, s'intéresse lui aussi à cette affaire... ce qui est très étrange. Il souhaite que les rejetons de Bhaal connaissent leur fin sans aucune intervention de notre part.~ [CYRIC06]
@72292 = ~Et donc moi, le grand Cyric, je dois me contenter de regarder et d'observer. Et pourtant, si quelqu'un doit se sentir menacé par un enfant de l'ancien Seigneur du Meurtre, c'est bien moi. Il n'y a vraiment plus de justice.~ [CYRIC07]
@72293 = ~Dragon-garou majeur~
@72294 = ~Ah ! Observateurs ! Donnez à ce singe la leçon qu'il mérite ! (hum... peut-être y avait-il un meilleur qualificatif que « singe »... bah !)~
@72295 = ~Dragon-garou majeur~
@72296 = ~J'ai suivi tes progrès depuis quelque temps. Je suis très impressionné. J'en ai tiré quelques conclusions, mais je préfère l'entendre de ta bouche. À quel point dois-je te craindre ?~ [CYRIC08]
@72297 = ~Tu n'as pas besoin de me craindre... je n'ai pas l'intention de devenir le Seigneur du Meurtre.~ ~Tu n'as pas besoin de me craindre... je n'ai pas l'intention de devenir la Reine du Meurtre.~
@72298 = ~Tu es un dieu... je ne pense pas que tu aies des raisons d'avoir peur de moi, ni de quiconque.~
@72299 = ~Je cherche un Parchemin d'inversion. Pouvez-vous me renseigner ?~
@72300 = ~~
@72301 = ~Je ne fais principalement qu'explorer le coin. Je ne cherche pas à vous créer d'ennuis.~
@72302 = ~Me débarrasser de vous et prendre tout ce que vous possédez de valeur.~
@72303 = ~Je ne sais pas comment se passent les choses là d'où vous venez, mais ici, dans l'enclave d'Abazigal, nous devons travailler pour obtenir des parchemins d'Inversion.~
@72304 = ~Que voulez-vous que je fasse ?~
@72305 = ~Je n'ai pas le temps. Pourquoi ne pas me le donner avant que je ne vous tue ?~
@72306 = ~Pour être parfaitement honnête, je ne puis abandonner mes sujets d'expérience. Ils sont très fragiles. Et en plus, j'adore leur odeur. Ça me rappelle le fromage.~
@72307 = ~Et alors ?~
@72308 = ~Tu dois me craindre plus que tout ! Je vais m'occuper de toi, Cyric. Je vais vivre ma destinée !~
@72309 = ~Toi, ainsi que toutes les autres créatures maléfiques, vous devriez me craindre !~
@72310 = ~Ha ! Ne me fais pas rire !~
@72311 = ~Je refuse de répondre. Qu'importe ce que je peux dire, à toi de te faire ton idée.~
@72312 = ~Je vois. Je savais que tu dirais cela.~ [CYRIC09]
@72313 = ~Qui aurait pu prévoir que ce niveau des Abysses, ce « Trône de Bhaal », me causerait autant de problèmes ? Hum. Si seulement je l'avais détruit dès le début...~ [CYRIC10]
@72314 = ~Pourquoi ne pas en avoir pris la succession quand tu es devenu Seigneur du Meurtre ?~
@72315 = ~Je n'en avais pas besoin. Je n'en voulais pas. J'ai déjà mon plan dans le Pandémonium, merci... et il vaut largement le plus beau coin des Abysses. Mais apparemment, j'aurais dû prêter plus d'attention à cet endroit sinistre.~ [CYRIC11]
@72316 = ~Mais peu importe. Je ne peux pas défaire ce qui est fait... et si tu essaies, cela entraînera toutes sortes de problèmes. Et je n'ai pas envie de me retrouver encore dans un sac de nœuds.~ [CYRIC12]
@72317 = ~Quant à toi... tu décideras peut-être de chercher mon royaume. Si tu arrives jusque là, bien entendu. Mais reste à savoir si tu as le pouvoir de tenter cette aventure, sans même parler de ta réussite.~ [CYRIC13]
@72318 = ~Quant à toi... je doute que tu décides de rechercher mon royaume. Si tu arrives jusque là, bien entendu. Je n'ai pas envie de voir un autre enfant divin me défier... en admettant que tu aies un pouvoir suffisant pour le faire.~ [CYRIC14] ~Quant à toi... je doute que tu décides de rechercher mon royaume. Si tu arrives jusque là, bien entendu. Je n'ai pas envie de voir une autre enfant divine me défier... en admettant que tu aies un pouvoir suffisant pour le faire.~ [CYRIC14]
@72319 = ~Je crois que tu dois être mis à l'épreuve. C'est bien à cela que servent ces petites salles, n'est-ce pas ? Pour te mettre à l'épreuve ? Mystra et Ao ne pourront pas me blâmer de ne pas t'avoir aidé dans ce but, n'est-ce pas ?~ [CYRIC15] ~Je crois que tu dois être mise à l'épreuve. C'est bien à cela que servent ces petites salles, n'est-ce pas ? Pour te mettre à l'épreuve ? Mystra et Ao ne pourront pas me blâmer de ne pas t'avoir aidée dans ce but, n'est-ce pas ?~ [CYRIC15]
@72320 = ~Nous nous reverrons peut-être, un jour. Pour l'instant, voyons comment tu te débrouilles contre mes favoris. Je te conseille de bien te préparer.~ [CYRIC16]
@72321 = ~Cyric~
@72322 = ~Cyric~
@72323 = ~Favori de Cyric~
@72324 = ~Favori de Cyric~
@72325 = ~Il y a quelques jours de cela, j'ai surpris un gauth en train de contempler mes jolis yeux. L'un d'entre eux semblait le fasciner. Quoi qu'il en soit, il avait lui aussi des yeux magnifiques.~
@72326 = ~Inutile de vous dire que je n'ai guère attendu pour prendre une dague et essayer de lui arracher un de ces superbes spécimens de globes oculaires, mais le gredin a plongé dans l'un des bassins à l'est d'ici et a disparu.~
@72327 = ~J'ai besoin de ce pédoncule oculaire. Malheureusement, la caverne dans laquelle il a plongé est maintenant infestée de kobolds.~
@72328 = ~Des kobolds ?~
@72329 = ~Ou peut-être s'agit-il de la grotte de l'orbe ancien... je ne me souviens plus. C'est sans importance. Rapportez-moi le pédoncule et vous aurez le parchemin.~
@72330 = ~Pauvre Mateo. Il est seul au monde, comme Minsc avant que Bouh ne le trouve ! Oui, Bouh, tu as raison, comme les héros, nous devons aider la veuve et l'orphelin ! Venir en aide aux innocents ! Enfin... vous voyez.~
@72331 = ~Je suis un enfant de Bhaal, et ceci est indigne de moi !~ ~Je suis une enfant de Bhaal, et ceci est indigne de moi !~
@72332 = ~Vous voulez que je retrouve votre pédoncule ? Je ne m'abaisse pas à ce genre de tâches.~
@72333 = ~Voilà qui ne vaut guère que j'y consacre du temps, mais j'imagine que je n'ai pas le choix.~
@72334 = ~Iycanth le Fou~
@72335 = ~Je refuse. Donnez-moi le parchemin ou je vous tue.~
@72336 = ~Iycanth le Fou~
@72337 = ~Eh bien, excusez-moi ! Mais si vous êtes trop important pour ce travail, pourquoi ne sous-traitez-vous pas l'affaire ?~
@72338 = ~Avec qui ?~
@72339 = ~Ces hommes, là. Ils avaient l'air intéressés par les « croisades » et « l'aventure », il n'y a pas si longtemps...~
@72340 = ~Ils ont l'air d'être des amateurs.~
@72341 = ~Oui, je suppose que c'est le cas, mais vous êtes plein de ressources. Trouvez un moyen de les aider et je suis certain qu'ils accepteront une petite « croisade ».~
@72342 = ~Je respire le doux fumet d'un profit potentiel, <CHARNAME> ! Les mères affligées peuvent se montrer très douces.~
@72343 = ~Pédoncule oculaire d'Iycanth

J'ai été chargé par Iycanth, le sorcier fou, de lui rapporter le pédoncule d'un gauth. Apparemment, ce gauth a disparu dans un des bassins à l'est du laboratoire d'Iycanth.

Cette mission semble indigne de moi, pourtant Iycanth m'a conseillé d'engager quelques aventuriers. Mais ils ont été pétrifiés. Si je veux achever la « Quête », je dois les transformer. Quoi qu'il en soit, dès que j'aurai le pédoncule, je dois retrouver le chemin du laboratoire du mage et échanger le pédoncule contre le Parchemin d'inversion.~ ~Pédoncule oculaire d'Iycanth

J'ai été chargée par Iycanth, le sorcier fou, de lui rapporter le pédoncule d'un gauth. Apparemment, ce gauth a disparu dans un des bassins à l'est du laboratoire d'Iycanth.

Cette mission semble indigne de moi, pourtant Iycanth m'a conseillé d'engager quelques aventuriers. Mais ils ont été pétrifiés. Si je veux achever la « Quête », je dois les transformer. Quoi qu'il en soit, dès que j'aurai le pédoncule, je dois retrouver le chemin du laboratoire du mage et échanger le pédoncule contre le Parchemin d'inversion.~
@72344 = ~Observateur~
@72345 = ~Observateur~
@72346 = ~<CHARNAME> ! En tant que membre de l'Ordre du Cœur radieux, je ne puis te laisser accomplir quelque chose d'aussi mauvais. Que tous ceux qui veulent combattre le Mal me rejoignent !~
@72347 = ~Vigilant~
@72348 = ~Vigilant~
@72349 = ~Œil de gorgone~
@72350 = ~Œil de gorgone~
@72351 = ~Chercheur~
@72352 = ~Chercheur~
@72353 = ~Non... la dame ne doit pas mourir ! Tu es un méchant, <CHARNAME> ! Que tous ceux qui sont de véritables héros se joignent à moi pour défendre cette femme contre le vilain <CHARNAME> !~ ~Non... la dame ne doit pas mourir ! Tu es une méchante, <CHARNAME> ! Que tous ceux qui sont de véritables héros se joignent à moi pour défendre cette femme contre la vilaine <CHARNAME> !~
@72354 = ~Œil du tyrannœil~
@72355 = ~Œil du tyrannœil~
@72356 = ~Œil du mort~
@72357 = ~Œil du mort~
@72358 = ~J'ai supporté beaucoup de choses, <CHARNAME>, mais l'assassinat d'une femme innocente, jamais ! Je ne resterai pas les bras croisés à te regarder faire ! Que tous les ennemis du mal joignent leurs lames aux miennes !~
@72359 = ~<CHARNAME> ! En tant que Ménestrelle, je ne puis tolérer de pareils actes ! Je défendrai cette femme au péril de ma vie ! Avec moi, ceux qui combattent pour la justice !~
@72360 = ~Œil d'aigle~
@72361 = ~Œil d'aigle~
@72362 = ~Sentinelle~
@72363 = ~Sentinelle~
@72364 = ~Encore vous ! Que voulez-vous ?~
@72365 = ~<CHARNAME> ! Je te suspectais depuis longtemps de n'être qu'une entité maléfique venue souiller notre terre, et en voilà la confirmation ! Que tous ceux qui se battent pour le droit et la justice se dressent avec moi pour défendre cette innocente femme contre les assauts abominables de <CHARNAME> !~
@72366 = ~Pédoncule oculaire de gauth. Il a été coupé net !

PARAMÈTRES :

Poids : 0~
@72367 = ~J'ai le pédoncule du gauth.~
@72368 = ~Nanoc le barbare~
@72369 = ~Je vois. Que vouliez-vous déjà que je vous trouve ?~
@72370 = ~Nanoc le barbare~
@72371 = ~*soupire* Un pédoncule de gauth. Il a plongé dans l'un des bassins à l'est de mon labo. Maintenant, laissez-moi tranquille !~
@72372 = ~À quoi sert tout cet équipement ?~
@72373 = ~Bondari~
@72374 = ~Bondari~
@72375 = ~Il faut que je vous l'épelle ? Je fais des yeux. Des yeux qui flottent. Des yeux mortels et merveilleux.~
@72376 = ~Vous travaillez pour Abazigal. Réalisez-vous à quel point il est mauvais ?~
@72377 = ~Je vois. Que vouliez-vous déjà que je vous trouve ?~
@72378 = ~Et ces œufs ?~
@72379 = ~C'est ici que mes précieux globes sont incubés. La meilleure fournée est néanmoins encore en incubation. Ne les touchez surtout pas !~
@72380 = ~Tim Maindor~
@72381 = ~C'est tout pour l'instant.~
@72382 = ~Tim Maindor~
@72383 = ~Bonne journée.~
@72384 = ~Rien pour l'instant.~
@72385 = ~Abazigal est mon protecteur. S'il veut s'emparer du monde et égorger tous ceux qui l'habitent, ça ne me regarde pas. C'est vrai que je développe pour lui une super armée de globes mortels, mais ce n'est pas à moi de juger la moralité de tout ça. Je suis avant tout un étudiant des sciences obscures.~
@72386 = ~Cela ne vous empêche pas d'être responsable de vos actes.~
@72387 = ~Vos excuses ne m'intéressent pas ! Je vais vous tuer ainsi qu'Abazigal !~
@72388 = ~Alors comme ça, vous voulez jouer ! Alors, on va jouer !~
@72389 = ~En fait, je crois que ça m'est complètement égal. Maintenant, laissez-moi !~
@72390 = ~J'ai quelques questions à vous poser, Kiser.~
@72391 = ~Je cherche un Parchemin d'inversion. Pouvez-vous me renseigner ?~
@72392 = ~Ah, c'est parfait ! Et voilà votre parchemin d'inversion ! Maintenant, excusez-moi, mais j'ai un nouveau fils à élever.~
@72393 = ~Laissez-moi, maintenant. Je suis las de votre visage et de votre odeur.~
@72394 = ~Ainsi, vous avez essayé de vendre Saradush à l'ennemi, et vous avez échoué. Un plan diabolique de destruction d'une ville n'est jamais aussi simple à exécuter qu'il le paraissait initialement. J'ai appris cette dure leçon à la Porte de Baldur.~
@72395 = ~Meurs, démon maléfique !~
@72396 = ~Crève, maudit globe ! Hein ? Quoi ? Euh... on se connaît ?~
@72397 = ~Je vous ai libéré de votre prison de pierre, jeune aventurier.~
@72398 = ~Non, mais tu vas faire connaissance avec ma lame ! Meurs !~
@72399 = ~Euh, ben, merci. Vous allez bien, les gars ?~
@72400 = ~Ouais.~
@72401 = ~Oui. (Et ce n'est pas grâce à toi... incapable que tu es de poignarder un globe par derrière !)~
@72402 = ~Euh... j'imagine qu'il faut que je vous remercie de nous avoir sauvés. De quelle manière de braves aventuriers comme nous peuvent-ils vous payer leur dette ? Que pouvons-nous faire pour vous ?~
@72403 = ~Un Mal terrible s'est abattu sur le pays et les vies de millions de pauvres gens sont en jeu. Tu as été choisi, Bondari, et tu ne dois pas échouer dans ta croisade !~
@72404 = ~Une croisade ! Hou hou ! C'est formidable ! Que devons-nous faire ?~
@72405 = ~Peux-tu me dire comment vous êtes arrivés là ?~
@72406 = ~Je veux juste m'occuper de toi comme il convient, sale chien !~
@72407 = ~Ah ! Tim ! Balance-lui le projectile magique dans la gueule ! Nanoc ! Attaque ! Je suis là !~
@72408 = ~Je suis Nanoc le Barbare ! J'ai été élevé dans les territoires arides du nord et suis immunisé contre vos pathétiques sentiments et civilités. L'épée à la main, j'affronte le danger sans connaître la peur. Et toujours je suis le vaincu...~
@72409 = ~Meurs ! Pour le Soleil Noir !~
@72410 = ~C'est ça, Nanoc. Mais j'ai à faire.~
@72411 = ~Qu'est-ce que j'ai dit ?~
@72412 = ~Un monstrueux tyrannœil et ses cohortes de kobolds ont infesté une grotte à l'est d'ici. Un dragon maléfique menace le pays ! Je dois trouver le pédoncule oculaire du tyrannœil pour pouvoir tuer le dragon et sauver les populations d'une mort affreuse !~
@72413 = ~Par le masque de Mask ! Nous ne pouvons tolérer ça !~
@72414 = ~Va, noble aventurier, et retrouve le pédoncule. Le destin du Téthyr est entre tes mains !~
@72415 = ~Mais quel genre de récompense peut-on espérer ?~
@72416 = ~La satisfaction du travail bien fait et de sauver le monde. Ne perds pas de temps à discuter, le dragon est déjà en train de lever une armée pour anéantir le monde !~
@72417 = ~Je te donnerai... 100 pièces d'or !~
@72418 = ~100 pièces d'or ! Nous sommes riches ! Marché conclu, monsieur ! On va aller vous chercher ce pédoncule... et sauver le monde ! On y va, les gars !~ ~100 pièces d'or ! Nous sommes riches ! Marché conclu, madame ! On va aller vous chercher ce pédoncule... et sauver le monde ! On y va, les gars !~
@72419 = ~Attendez ! Je dois me reposer et mémoriser projectile magique !~
@72420 = ~Ne t'inquiète pas, elfe, Nanoc te protège !~
@72421 = ~Bon, si c'est pour sauver le monde... d'accord, on le fera ! Allons-y, les gars !~
@72422 = ~Je suis Tim Maindor, elfe du Bois d'Épine. Mes parents ont été assassinés quand je n'étais qu'un bébé et j'ai été élevé par les loups jusqu'à l'âge de vingt ans. Et en fait, c'est un très beau rôdeur qui, séduit par ma mystérieuse sauvagerie, m'a emmené de la forêt et m'a...~
@72423 = ~Laissez tomber.~
@72424 = ~L'histoire est vraiment intéressante. Vous devriez l'entendre en entier !~
@72425 = ~Mon nom est Bondari Halfman ! J'ai quitté mon paisible village natal des Vaux en quête d'aventure et de fortune ! J'ai rencontré Tim et Nanoc dans une taverne, et nous avons monté une expédition pour explorer Ombre-Terre. Nous avons trouvé une grotte. Et puis ces yeux... qui nous ont transformés en pierre.~
@72426 = ~Bon. Pourquoi ne pas rester ici ? Tu y es en sécurité.~
@72427 = ~Euh... d'accord.~
@72428 = ~J'ai un travail pour toi, Bondari. Un Mal terrible s'est abattu sur le pays et les vies de millions de pauvres gens sont en jeu. Tu as été choisi, Bondari, et tu ne dois pas échouer dans ta croisade !~
@72429 = ~Bouh n'aime pas Kiser, <CHARNAME> ! Vois-tu comment son nez remue ? Il flaire quelque chose de mauvais, et ce ne sont pas les pets qui lui sortent du derrière.~
@72430 = ~(Je vous dis que nous pouvons nous emparer de <CHARNAME>. Nanoc, les faiblesses du monde civilisé ne t'ont pas infecté ! Tim, tu peux lancer un projectile magique ! Je m'occupe de poignarder ! Je parie qu'il y a un gros trésor à la clef !)~
@72431 = ~Méfie-toi, <CHARNAME>. La ruse et la fourberie sont un art de vivre là d'où je viens. Et je crois que Kiser s'y adapterait fort bien.~
@72432 = ~(Mais on ne peut pas compter sur Tim ! Tu te rappelles le roi kobold ? Il a lancé un sort puis il s'est planqué derrière un rocher et on a dû tout faire nous-mêmes !)~
@72433 = ~(Eh ! J'ai des potions de soins ! Je peux vous soigner !)~
@72434 = ~(Je peux ignorer un coup qui mettrait à terre un homme normalement constitué ! Vos bonnes manières ne m'ont pas infecté, je...)~
@72435 = ~(Ça suffit ! Prêts ?) À L'ATTAQUE !~
@72436 = ~Euh, voilà votre pédoncule, monsieur. On a aussi trouvé quelque chose d'autre. J'espère que ça va vous plaire.~ ~Euh, voilà votre pédoncule, madame. On a aussi trouvé quelque chose d'autre. J'espère que ça va vous plaire.~
@72437 = ~Bravo, Bondari. Voilà ta récompense.~
@72438 = ~Tu nous as tous sauvés, tu es un héros.~
@72439 = ~Magnifique, maintenant, va te faire voir ailleurs.~
@72440 = ~Merci. Ce fut une grande croisade. J'ai trouvé une dague et Tim un parchemin d'Identification. D'ici un ou deux jours, il devrait pouvoir m'en dire plus sur cette dague.~
@72441 = ~Salut.~
@72442 = ~Merci encore, <CHARNAME> ! Adieu ! Et bonne chance avec le dragon, hein !~
@72443 = ~Mes mauvaises manières ne me permettent pas de vous saluer.~
@72444 = ~Le Ravageur~
@72445 = ~Le Ravageur~
@72446 = ~Cela ne fait que confirmer ce que je dis tout le temps : un bon magicien est un magicien mort !~
@72447 = ~Évidemment... tout le monde s'en prend au mage. (Ça doit être la jalousie qui rend ces inférieurs si méchants.)~
@72448 = ~En-dehors de toute courtoisie professionnelle, j'insiste pour que nous nous occupions de la Comtesse et que nous épargnions le magicien. (Même si la liquidation d'un magicien pourrait évidemment permettre l'acquisition de plusieurs objets puissants.)~
@72449 = ~Ça ne me dérange pas de liquider ce magicien, mais l'idée d'égorger la Comtesse de sang-froid me fiche la nausée.~
@72450 = ~Tueur à gages ? <CHARNAME>, c'est contre tout ce pour quoi je me bats.~
@72451 = ~Rassure-toi, Jaheira, nous n'avons encore rien fait.~
@72452 = ~C'est moi qui prends les décisions ici, Ménestrelle. À moins que j'aie raté le vote qui t'a nommée cheffe ?~
@72453 = ~Tu as raison, <CHARNAME>. Je dois te juger sur ce que tu fais, et non pas sur ce que je crains que tu fasses.~
@72454 = ~Tu... tu n'es pas l'homme que je croyais, <CHARNAME>. Je ne marcherai plus à tes côtés.~ ~Tu... tu n'es pas la femme que je croyais, <CHARNAME>. Je ne marcherai plus à tes côtés.~
@72455 = ~Vous ne pensez pas donner suite à cette offre scandaleuse, <CHARNAME> ?~
@72456 = ~Patience, Anomen. Fais-moi confiance et juge-moi à la fin.~
@72457 = ~Si ça ne te plaît pas, tu peux t'en aller !~
@72458 = ~Bien, <CHARNAME>, vous n'avez peut-être pas tort. La patience est une vertu et la confiance doit en être une autre. Je sais que vous ferez ce qui est juste.~
@72459 = ~Votre présence me couvre de honte, <CHARNAME>. Je vous prenais pour un seigneur de la vertu, mais il faut croire que je me suis fourvoyé. Nos routes se séparent ici.~
@72460 = ~Ce misérable ne mérite que du mépris... tout comme toi, <CHARNAME>, si tu écoutes ses mots !~
@72461 = ~Du calme, Mazzy. Tu me juges pour des actes que je n'ai pas commis.~
@72462 = ~Tu me fatigues avec tes remarques, demi-portion !~
@72463 = ~Bon, j'imagine que tu as raison. Très bien, <CHARNAME>, je réserve mon jugement dans cette affaire.~
@72464 = ~Ta langue cruelle montre bien ton méchant caractère, <CHARNAME>. Je ne veux plus rester avec toi !~
@72465 = ~Les mots de ce crétin sont un affront pour mes pauvres oreilles ! <CHARNAME>, tu ne peux quand même pas tolérer ces propositions sans scrupules !~
@72466 = ~Du calme, Keldorn. Tout va bien se passer.~
@72467 = ~La dernière chose dont j'ai besoin, c'est bien de ton avis !~
@72468 = ~Tu as gagné ma confiance à travers nos exploits communs, <CHARNAME>. Alors je ferai preuve de patience.~
@72469 = ~Tu n'es qu'un misérable ! <CHARNAME> est le seigneur de la pourriture et de la vilenie ! L'honneur m'impose d'abandonner immédiatement cette odieuse compagnie !~
@72470 = ~Quelle insolence ! Mes sentinelles vont éradiquer le monde de votre misérable existence !~
@72471 = ~Lame d'os~
@72472 = ~Lame d'os~
@72473 = ~Désir de mort~
@72474 = ~Je sais que vous êtes impliqué d'une manière ou d'une autre dans cette affaire, Kiser. Je cherche juste la preuve.~
@72475 = ~Je sais que vous êtes impliqué d'une manière ou d'une autre dans cette affaire, Kiser. Je cherche juste la preuve.~
@72476 = ~*plusieurs jours plus tard*~
@72477 = ~Je ne souhaite pas partir pour l'instant.~
@72478 = ~Je ne souhaite pas partir pour l'instant.~
@72479 = ~*Bondari recharge*~
@72480 = ~Je suis ce qui est en toi.~
@72481 = ~Je suis l'ultime expression de ton pouvoir, enfant de Bhaal.~
@72482 = ~Je suis le dernier rempart que tu as érigé entre toi-même et ta destinée. Si tu peux me vaincre, ce plan n'existera plus... il n'y aura plus que le Trône de Bhaal.~
@72483 = ~Mais tu ne pourras pas me vaincre. Car je suis le Ravageur.~
@72484 = ~*le dernier des enfants de Bhaal étant mort, vous pouvez maintenant pénétrer dans le royaume abyssal du Trône de Bhaal... une fois que vous aurez pénétré dans ce royaume, l'Antichambre sera alors détruite à jamais*~
@72485 = ~Si vous avez une affaire à régler, vous feriez mieux d'aller en haut parler à Kiser. Ici, il n'y a rien à voir.~
@72486 = ~Que faisons-nous ici ? Euh... on monte la garde ! Ça se voit pas ?~
@72487 = ~Que faites-vous dans la cave de Kiser ?~
@72488 = ~Mais cet endroit est vide. Il n'y a rien à garder !~
@72489 = ~Je crains de devoir vous laisser.~
@72490 = ~Vous ne devez pas valoir grand-chose, si Kiser vous cantonne ici.~
@72491 = ~Très bien. Je vais y aller.~
@72492 = ~Écoutez... Kiser donne les ordres, et on les exécute. S'il veut que nous gardions une cave vide, on le fait sans discuter. C'est compris ?~
@72493 = ~Alors, retournez en haut. Kiser ne veut voir personne ici !~
@72494 = ~Caserne des gardes de Gromnir~
@72495 = ~*devant vous se tient un djinn au pouvoir immense, l'air qui l'entoure est chargé d'électricité... il vous regarde calmement* « Je te salue, jeteur de sorts. Es-tu prêt à entamer les négociations ? »~ ~*devant vous se tient un djinn au pouvoir immense, l'air qui l'entoure est chargé d'électricité... il vous regarde calmement* « Je te salue, jeteuse de sorts. Es-tu prête à entamer les négociations ? »~
@72496 = ~Les négociations ? De quoi parles-tu ?~
@72497 = ~Je n'ai pas le temps de négocier en plein combat !~
@72498 = ~Je suis prêt.~ ~Je suis prête.~
@72499 = ~Non, j'ai changé d'avis. Repars d'où tu viens.~
@72500 = ~*le djinn vous adresse un large sourire en vous faisant un clin d'œil* « C'est peut-être le choix le plus sage, jeteur de sorts. Très bien... il en sera fait selon ton désir. »~ ~*le djinn vous adresse un large sourire en vous faisant un clin d'œil* « C'est peut-être le choix le plus sage, jeteuse de sorts. Très bien... il en sera fait selon ton désir. »~
@72501 = ~*le djinn marque une pause, surpris, avant d'éclater de rire* « Nous sommes suspendus entre deux instants, jeteur de sorts. Le temps n'a plus d'emprise sur nous pendant que je te parle, ne sois pas inquiet. »~ ~*le djinn marque une pause, surpris, avant d'éclater de rire* « Nous sommes suspendus entre deux instants, jeteuse de sorts. Le temps n'a plus d'emprise sur nous pendant que je te parle, ne sois pas inquiète. »~
@72502 = ~Alors explique-moi ce que tu voulais dire par « négociations ».~
@72503 = ~Alors, allons-y.~
@72504 = ~Laisse tomber. Repars là d'où tu viens, djinn.~
@72505 = ~Ekim Cyre~
@72506 = ~« Le sort que tu as lancé est une tentative de contrôler temporairement un immense pouvoir cosmique. Il est instable, et il n'est donc vraiment utile que lors des combats... à moins, bien sûr, que tu n'aies des années à consacrer à la formulation de ton souhait. »~
@72507 = ~« C'est cette formulation qui nécessite des négociations. » *le djinn fait apparaître une plume et une feuille de papier en souriant* « Comme tu n'as pas des années à perdre, tu vas essayer de me décrire ce que tu souhaites obtenir de ton souhait. »~
@72508 = ~« Et moi... » *dit-il d'un air satisfait* « je ferai appel à mon immense intelligence pour déformer ta volonté selon mon bon vouloir. Ne sois pas mal à l'aise... les forces à l'œuvre ici sont telles que rares sont ceux qui obtiennent vraiment ce qu'ils désirent. »~
@72509 = ~« Mais tu peux certainement essayer. Les sages s'en sortent souvent bien... et vous autres jeteurs de sorts, vous êtes souvent très sages, n'est-ce pas ? » *il tapote pensivement sa tête avec la plume* « Alors, veux-tu commencer ? »~
@72510 = ~Ekim Cyre~
@72511 = ~Mais nous n'avons pas le temps de faire ça au beau milieu d'un combat !~
@72512 = ~Oui, allons-y.~
@72513 = ~Non, j'ai changé d'avis. Repars d'où tu viens.~
@72514 = ~Cellule de Mateo~
@72515 = ~*le djinn hoche la tête* « À ton service. » *aussitôt, vous commencez alors tous deux à négocier un contrat complexe... le djinn est rusé et tente soigneusement de changer le sens de vos propos par des mots, des expressions juridiques et des clauses légales que vous comprenez à peine*~
@72516 = ~*vous comprenez soudain beaucoup mieux les mystères du monde, comme si une porte venait de s'ouvrir dans votre esprit*

<GABBER> gagne 1 point de SAGESSE.~
@72517 = ~*heureusement, vous comprenez vite ce qu'il se passe... en peu de temps, vous commencez à votre tour à déformer les formulations du djinn, le laissant plutôt perplexe et frustré... vous n'avez pas la certitude d'obtenir exactement ce que vous avez demandé, mais il y a fort à parier que le djinn ne parviendra pas à vous tromper*~
@72518 = ~*vous trouvez un petit interrupteur caché derrière un piège... il faut d'abord désamorcer le piège pour actionner l'interrupteur*~
@72519 = ~*vous actionnez l'interrupteur... vous entendez le bruit sourd des engrenages qui tournent*~
@72520 = ~*vous êtes suffisamment avisé pour suivre le rythme du djinn, l'empêchant ainsi de prendre pleinement l'avantage sur vous... néanmoins, le contrat est difficile à comprendre et vous vous demandez quel sera le résultat final*~ ~*vous êtes suffisamment avisée pour suivre le rythme du djinn, l'empêchant ainsi de prendre pleinement l'avantage sur vous... néanmoins, le contrat est difficile à comprendre et vous vous demandez quel sera le résultat final*~
@72521 = ~*vous vous sentez soudain nettement plus sûr de vous, une solide confiance émane de vous... une confiance que les autres peuvent ressentir*

<GABBER> gagne 1 point de CHARISME.~ ~*vous vous sentez soudain nettement plus sûre de vous, une solide confiance émane de vous... une confiance que les autres peuvent ressentir*

<GABBER> gagne 1 point de CHARISME.~
@72522 = ~*tout au long du processus, le djinn ne cesse de vous déconcerter... et vous ne savez même plus si le souhait que vous venez d'énoncer sera similaire à celui que vous aviez formulé au départ... tâchant de faire au mieux, vous évitez les clauses qui vous semblent les plus défavorables*~
@72523 = ~*en actionnant le dernier interrupteur, vous entendez une porte s'ouvrir*~
@72524 = ~*votre manque de sagesse vous fait définitivement perdre l'avantage... tout au long de la rédaction du contrat, le djinn vous intimide mentalement pour que vous ne puissiez que le regarder rédiger seul le document... vous n'avez que peu d'objections à lui formuler*~
@72525 = ~*une fois le contrat rempli, le djinn enfile une paire de lunettes et l'examine avec un froncement de sourcils* « Très bien, jeteur de sorts, je peux interpréter les éléments énumérés ici de plusieurs manières. Choisis avec précaution celui que tu préfères. »~ ~*une fois le contrat rempli, le djinn enfile une paire de lunettes et l'examine avec un froncement de sourcils* « Très bien, jeteuse de sorts, je peux interpréter les éléments énumérés ici de plusieurs manières. Choisis avec précaution celui que tu préfères. »~
@72526 = ~- Lancer un sort de « Brèche » sur toutes les créatures présentes, y compris les membres du groupe.~
@72527 = ~- Éloigner tout le monde, y compris les membres du groupe, du jeteur de sorts.~
@72528 = ~- Soigner tout le monde, les membres du groupe ainsi que les ennemis.~
@72529 = ~- Donner temporairement une Force de 18 à toutes les créatures présentes, y compris les ennemis.~
@72530 = ~- Lancer un sort de « Fourvoiement magique » sur toutes les créatures présentes, y compris les membres du groupe.~
@72531 = ~- Lancer un sort de « Résistance à la magie » sur toutes les créatures présentes, y compris les ennemis.~
@72532 = ~- Lancer un sort de « Flétrissure abominable d'Abi-Dalzim » sur toutes les créatures présentes, y compris les membres du groupe.~
@72533 = ~- Toutes les créatures présentes, membres du groupe et ennemis, seront en état d'ébriété.~
@72534 = ~- Attirer la malchance sur toutes les créatures présentes, y compris les membres du groupe.~
@72535 = ~- Lancer un sort de « Silence » sur toutes les créatures présentes, y compris les membres du groupe.~
@72536 = ~- Lancer un sort de « Hâte » sur toutes les créatures présentes, y compris les ennemis.~
@72537 = ~- Lancer un sort de « Hâte améliorée » sur tous les membres du groupe.~
@72538 = ~- Lancer un sort de « Brèche » sur tous les ennemis présents.~
@72539 = ~- Lancer un sort de « Restauration » sur tous les membres du groupe.~
@72540 = ~*vos membres deviennent plus rapides et plus agiles, vous marchez d'un pas plein d'entrain*

<GABBER> gagne 1 point de DEXTÉRITÉ.~
@72541 = ~- Augmenter toutes les caractéristiques des membres du groupe à 25 pendant 4 rounds.~
@72542 = ~- Lancer un sort de « Résurrection » sur tous les membres morts du groupe.~
@72543 = ~- Tous les membres du groupe bénéficient temporairement de la capacité de haut niveau « Coup fatal ».~
@72544 = ~*vous sentez un léger picotement à la base de votre cerveau, et il se répand bientôt dans tout votre crâne*

<GABBER> gagne 1 point d'INTELLIGENCE.~
@72545 = ~- Tous les membres du groupe bénéficient temporairement de la capacité de haut niveau « Résistance d'acier ».~
@72546 = ~- Créer une baguette aléatoire dans l'inventaire du jeteur de sorts.~
@72547 = ~- Créer une potion aléatoire dans l'inventaire du jeteur de sorts.~
@72548 = ~- Faire en sorte que le groupe soit reposé pendant une nuit entière et qu'il ait remémorisé tous ses sorts.~
@72549 = ~- Lancer un sort de « Arrêt du temps » et « Enchaînement » de double durée sur le jeteur de sorts.~
@72550 = ~- Soigner tous les ennemis présents.~
@72551 = ~- Lancer un sort de « Hâte améliorée » sur tous les ennemis présents.~
@72552 = ~- Convoquer une nouvelle créature hostile dans le secteur.~
@72553 = ~- Drainer deux niveaux d'expérience à chaque membre du groupe.~
@72554 = ~- Retirer temporairement la moitié des points de vie du jeteur de sorts.~
@72555 = ~- Retirer temporairement 15 % des points de vie de chaque membre du groupe.~
@72556 = ~- Le jeteur de sorts oublie tous les sorts mémorisés.~
@72557 = ~- Le groupe perd 10 000 pièces d'or.~
@72558 = ~- Lancer un sort de « Nuée de météores » sur le jeteur de sorts.~
@72559 = ~- Réduire temporairement à 3 la Force de tous les membres du groupe.~
@72560 = ~- Réduire temporairement à 3 la Sagesse de tous les membres du groupe.~
@72561 = ~- Réduire temporairement à 3 la Constitution de tous les membres du groupe.~
@72562 = ~- Réduire temporairement à 3 la Dextérité de tous les membres du groupe.~
@72563 = ~- Réduire temporairement à 3 l'Intelligence de tous les membres du groupe.~
@72564 = ~- Lancer un sort de « Lenteur » sur tous les membres du groupe.~
@72565 = ~Revenez me trouver au labo lorsque vous aurez le pédoncule. L'un des bassins devrait vous permettre d'y accéder.~
@72566 = ~Pourquoi faut-il toujours que je me retrouve impliqué dans ce genre de conversations abracadabrantes ? Nous ferions bien mieux de nous concentrer sur le destin de Féérune au lieu de parler de fromage !~
@72567 = ~Vous savez, je me considère modestement comme un connaisseur en fromages. Lorsque je faisais de la contrebande... euh, je veux dire du commerce maritime, la connaissance de ce type de marchandises s'est imposée à moi comme une... nécessité. Pour une raison inexplicable, il semblait que tout le monde en Amn voulait mettre du fromage sur ses biscuits. En ce qui me concerne, je préfère les navets.~
@72568 = ~J'admets ne pas être une experte en fromage, mais as-tu vraiment senti l'odeur de tes créatures ces derniers temps ? Je ne connais personne qui pourrait se mettre quelque chose qui a cette effroyable odeur dans la bouche.~
@72569 = ~Des kobolds ? Je ne me vois pas encore perdre mon temps pour ces moucherons, <CHARNAME> ! Mais si c'est pour un massacre en gros, je lève les deux poings !~
@72570 = ~Les kobolds se répandent comme la vermine, <CHARNAME>. Même si cela peut sembler indigne de nous, nous devrions nous débarrasser de leur nid.~
@72571 = ~De puissants héros comme <CHARNAME> et Minsc n'ont rien à prouver devant des adversaires aussi pitoyables. Peut-être que Bouh pourrait s'en occuper tout seul... Minsc plaisante, bien sûr ! Que la fête commence !~
@72572 = ~Nous ne sommes pas des domestiques, <CHARNAME>, ramenons ces laquais pétrifiés à la vie et faisons-leur faire le sale boulot.~
@72573 = ~Même si nous avons l'intention d'exécuter la tâche du magicien nous-mêmes, nous devrions ramener ces malheureux aventuriers à la vie.~
@72574 = ~Encore un magicien fou qui se moque totalement des conséquences de ses expériences sur le monde. Suis-je le seul à ne pas être surpris ?~
@72575 = ~Tais-toi, Tim ! Eh bien, je vous salue, Messire, mon nom est Bondari dit le Rapide, et je suis un voleur. Mes compagnons sont Nanoc le Barbare et Tim Maindor. Tim est un elfe. Et un mage.~ ~Tais-toi, Tim ! Eh bien, je vous salue, gente Dame, mon nom est Bondari dit le Rapide, et je suis un voleur. Mes compagnons sont Nanoc le Barbare et Tim Maindor. Tim est un elfe. Et un mage.~
@72576 = ~Si jeunes et enthousiastes... *soupire* je ne puis croire avoir été un jour aussi naïve et innocente que ces trois là.~
@72577 = ~Vraiment, <CHARNAME>, je suis stupéfaite. J'ai rarement rencontré des personnes aussi naïves que celles qui composent ce trio.~
@72578 = ~Cet enfant est le tien, <CHARNAME>... il partage le sang de Bhaal. Tu as vu ce qui est arrivé aux tiens à Saradush. Je ne peux aller nulle part, aucune cachette ne protégera ton enfant, il sera pourchassé et massacré.~
@72579 = ~Tant que le bébé sera dans mon corps, il tirera sa force de moi.~
@72580 = ~Si l'enfant naît avant la fin de notre aventure, je le porterai sur mon dos, comme le veut la coutume chez les avariels.~
@72581 = ~Je ne sais pas si j'ai envie qu'il porte ce nom.~
@72582 = ~Je ne suis pas d'accord.~
@72583 = ~*soupire* Très bien, mon amour... Nous penserons à une autre nom plus tard, si tu préfères. Mais permets-moi de l'appeler Quayle en attendant, c'est tout ce que je demande. Juste... quelque temps.~
@72584 = ~Très bien. Nous lui trouverons un nom plus tard.~
@72585 = ~*la petite créature vous regarde avec méfiance... après vous avoir examiné quelques instants, elle se retourne pour vous faire admirer son arrière-train en se dirigeant nonchalamment vers <CHARNAME>*~
@72586 = ~*le familier soupire, son nez tressaillant légèrement de curiosité tandis qu'il lève son sombre regard sur vous* « Qu'y a-t-il encore, chef ? J'ai faim. J'aimerais être cajolé et nourri. »~ ~*le familier soupire, son nez tressaillant légèrement de curiosité tandis qu'il lève son sombre regard sur vous* « Qu'y a-t-il encore, cheffe ? J'ai faim. J'aimerais être cajolé et nourri. »~
@72587 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72588 = ~*le familier inspecte votre sac, puis se faufile à l'intérieur à contrecœur* « Très bien. Il vaut mieux que vous me portiez. Mais évitez de me secouer dans tous les sens, cette fois. »~
@72589 = ~*caresser le familier*~
@72590 = ~« Aaaahhh... » *le familier ferme à demi les yeux de contentement, un large sourire de satisfaction s'inscrivant sur son visage* « Oui, ça fait du bien. Un repas ferait du bien également. »~
@72591 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72592 = ~Tu n'aurais pas un conseil à me donner, par hasard ?~
@72593 = ~*l'animal vous regarde, presque déconcerté* « Moi ? J'ai bien quelques idées qu'il m'amuserait de partager, mais allez-vous seulement les considérer, chef ? »~ ~*l'animal vous regarde, presque déconcerté* « Moi ? J'ai bien quelques idées qu'il m'amuserait de partager, mais allez-vous seulement les considérer, cheffe ? »~
@72594 = ~~
@72595 = ~~
@72596 = ~~
@72597 = ~~
@72598 = ~~
@72599 = ~~
@72600 = ~~
@72601 = ~~
@72602 = ~Comment vas-tu ? Tout va bien ?~
@72603 = ~*il vous observe de ses yeux sombres, apparemment satisfait d'être simplement à vos côtés... il soupire et détourne brièvement le regard* « Nous sommes liés, vous et moi. Si vous allez bien, alors il en est de même pour moi. »~
@72604 = ~« Je souffre cependant de quelques blessures superficielles. Je suis renforcé par votre force supérieure à la mienne, mais si vous pouviez traiter mes blessures, cela me ferait bien plaisir. »~
@72605 = ~« Je suis cependant moi-même grièvement blessé. Je saigne, chef. Je pourrais y survivre... ou peut-être pas. Nous verrons bien. »~ ~« Je suis cependant moi-même grièvement blessé. Je saigne, cheffe. Je pourrais y survivre... ou peut-être pas. Nous verrons bien. »~
@72606 = ~« Mais puisque vous me le demandez, je suis habité d'une envie irrésistible de nourriture. Procurez-m'en un peu et je vous permettrai de me caresser un peu plus longtemps. »~
@72607 = ~« Et je pense que vous faites un bon compagnon de voyage. Je suis satisfait des progrès que nous avons fait. Peut-être resterai-je avec vous pour encore un moment, nous verrons bien. »~ ~« Et je pense que vous faites une bonne compagne de voyage. Je suis satisfait des progrès que nous avons fait. Peut-être resterai-je avec vous pour encore un moment, nous verrons bien. »~
@72608 = ~*le petit animal semble chercher quelque chose à vous dire, mais son attention est attirée par quelque chose de plus intéressant que vous ailleurs... il s'éloigne en vous présentant son arrière-train, tout en dandinant de la queue*~
@72609 = ~« Tout va comme il faut, chef. Pourquoi ? Vous n'allez pas bien ? Vous n'allez quand même pas tomber malade et mourir sous mes yeux en me laissant orphelin, n'est-ce pas, papa ? Si vous mourez cela me chagrinerait beaucoup. Momentanément. »~ ~« Tout va comme il faut, cheffe. Pourquoi ? Vous n'allez pas bien ? Vous n'allez quand même pas tomber malade et mourir sous mes yeux en me laissant orphelin, n'est-ce pas, maman ? Si vous mourez cela me chagrinerait beaucoup. Momentanément. »~
@72610 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72611 = ~*le familier regarde votre sac pendant un instant, puis se glisse à l'intérieur à contrecœur* « Très bien. Il est préférable que vous me transportiez. Cependant, ne cognez pas trop le sac partout cette fois-ci. »~
@72612 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72613 = ~*le familier regarde votre sac pendant un instant, puis se glisse à l'intérieur à contrecœur* « Très bien. Il est préférable que vous me transportiez. Cependant, ne cognez pas trop le sac partout cette fois-ci. »~
@72614 = ~Donne-moi tout ce que tu as dérobé, veux-tu ?~
@72615 = ~*soupire* « Très bien. Mais n'allez pas croire que quelques caresses suffiront pour que je coopère la prochaine fois. »~
@72616 = ~Alors continuons à avancer.~
@72617 = ~*le familier soupire et tourne son regard désintéressé vers le chemin qui s'offre à vous* « Je préférerais choisir moi-même notre chemin, mais vous allez sûrement encore vous entêter à ce sujet. »~
@72618 = ~Tu n'aurais pas un conseil à me donner, par hasard ?~
@72619 = ~Comment vas-tu ? Tout va bien ?~
@72620 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72621 = ~Approche. Je veux te prendre pour te mettre dans mon sac, où tu seras plus en sécurité.~
@72622 = ~Donne-moi tout ce que tu as dérobé, veux-tu ?~
@72623 = ~*le familier vous regarde avec méfiance* « Mais quand je prends des choses, elles m'appartiennent ensuite. »~
@72624 = ~C'est hors de question. Donne-moi ça.~
@72625 = ~*le petit animal lève les yeux au ciel et soupire bruyamment* « Très bien. Mais vous êtes très cruel avec moi, vous savez. »~ ~*le petit animal lève les yeux au ciel et soupire bruyamment* « Très bien. Mais vous êtes très cruelle avec moi, vous savez. »~
@72626 = ~Allez, s'il te plaît ? Je te nourrirai et je te caresserai...~
@72627 = ~*le petit animal remue la queue en réfléchissant* « Eh bien... peut-être. Mais je veillerai à ce que vous teniez parole. » *soupire* « Oh, très bien. Cela m'amuse de vous voir me supplier. »~
@72628 = ~Oh, comme tu veux, alors.~
@72629 = ~« Et c'est bien normal. Je l'ai bien mérité, après tout. »~
@72630 = ~Un peu plus tard, peut-être. Continuons à avancer.~
@72631 = ~*la créature malicieuse vous dévisage avec une dérision évidente, tirant grossièrement sa langue fourchue en signe de moquerie... puis, elle file vers <CHARNAME>... de toute évidence, elle ne veut pas vous parler*~
@72632 = ~*la créature espiègle vous regarde suspicieusement, se méfiant d'un coup de pied ou d'une claque qui lui serait destiné, avant de faire un pas ou deux pour se rapprocher* « Ouais, patron ? Vous voulez quoi ? »~ ~*la créature espiègle vous regarde suspicieusement, se méfiant d'un coup de pied ou d'une claque qui lui serait destiné, avant de faire un pas ou deux pour se rapprocher* « Ouais, patronne ? Vous voulez quoi ? »~
@72633 = ~Viens ici. Pour l'instant, tu vas dans mon sac.~
@72634 = ~« Oh, bien sûr. Fourrez-moi dans votre sac qui pue. Vous n'avez jamais pensé à mettre un peu de menthe là-dedans ? Beurk... » *à contrecœur, la petite créature diabolique rampe dans votre sac*~
@72635 = ~Ne sois pas si effrayé, idiot. *caresser le familier*~
@72636 = ~*il semble dégoûté tandis que vous lui caressez la tête* « Oh, je suis un mignon petit lapin maintenant ? À d'autres, patron. Oubliez-moi un peu. » *la créature file comme une flèche en esquissant un pas de danse*~ ~*il semble dégoûté tandis que vous lui caressez la tête* « Oh, je suis un mignon petit lapin maintenant ? À d'autres, patronne. Oubliez-moi un peu. » *la créature file comme une flèche en esquissant un pas de danse*~
@72637 = ~Allez, viens ici. Rentre dans mon sac.~
@72638 = ~*frapper le familier à la tête*~
@72639 = ~*le petit démon chancelle sous le coup reçu* « Héééééé ! Diantre ! C'était pour quoi, ça ?! J'ai fait tout ce que vous m'aviez demandé, patron ! Pfff ! Y a de ces gens... »~ ~*le petit démon chancelle sous le coup reçu* « Héééééé ! Diantre ! C'était pour quoi, ça ?! J'ai fait tout ce que vous m'aviez demandé, patronne ! Pfff ! Y a de ces gens... »~
@72640 = ~Allez, viens ici. Rentre dans mon sac.~
@72641 = ~*le frapper à nouveau*~
@72642 = ~*une seconde claque l'envoie au sol, tandis qu'il tente désespérément de se protéger la tête* « Aaaah ! D'accord, d'accord ! C'est vous qui commandez, patron ! Je ne suis qu'un petit serviteur ! J'ai compris ! »~ ~*une seconde claque l'envoie au sol, tandis qu'il tente désespérément de se protéger la tête* « Aaaah ! D'accord, d'accord ! C'est vous qui commandez, patronne ! Je ne suis qu'un petit serviteur ! J'ai compris ! »~
@72643 = ~Allez, viens ici. Rentre dans mon sac.~
@72644 = ~Tu n'aurais pas un conseil à me donner, par hasard ?~
@72645 = ~*il vous regarde d'un air incrédule, se demandant si vous parlez sérieusement ou s'il va prendre une baffe* « Vous voulez que je vous donne des conseils, patron ? C'est bien la première fois ! »~ ~*il vous regarde d'un air incrédule, se demandant si vous parlez sérieusement ou s'il va prendre une baffe* « Vous voulez que je vous donne des conseils, patronne ? C'est bien la première fois ! »~
@72646 = ~~
@72647 = ~~
@72648 = ~~
@72649 = ~~
@72650 = ~~
@72651 = ~~
@72652 = ~~
@72653 = ~~
@72654 = ~Bon... tout va bien de ton côté ?~
@72655 = ~*la créature vous regarde avec méfiance, en louchant avec ses yeux sulfureux* « Hmpf, c'est nouveau, cet intérêt soudain pour moi. Depuis quand vous vous souciez de moi, patron ? Jusqu'à maintenant il n'était question que de vous, vous et vous. »~ ~*la créature vous regarde avec méfiance, en louchant avec ses yeux sulfureux* « Hmpf, c'est nouveau, cet intérêt soudain pour moi. Depuis quand vous vous souciez de moi, patronne ? Jusqu'à maintenant il n'était question que de vous, vous et vous. »~
@72656 = ~« Mais si vous voulez tout savoir, je ne dirais pas non à quelques soins. J'ai reçu quelques écorchures, vous savez... Vous voudriez pas que je meure, pas vrai ? Je suis bien trop utile ! »~
@72657 = ~« Mais puisque vous demandez, des soins ne seraient pas de refus. Je perds tout mon ichor... Vous voudriez quand même pas me renvoyer dans les plans, n'est-ce pas ? Ce serait vraiment trop dommage... »~
@72658 = ~« Mais, voyons voir... hmmm... J'ai un peu faim. Pourquoi pas un sandwich au chiot ? Ou un steak ? Un poulet sacrifié ? Allez, balancez-moi au moins un os ! Pfff... »~
@72659 = ~« Mais puisque vous demandez, je pense que vous devriez gagner plus d'or. Je veux dormir dans un ÉNORME sac d'or. Je pourrais plonger et nager dedans... ouais, c'est bien ça, nager dans de l'or... ouais... »~
@72660 = ~« Mais je voudrais vous dire que vous courez beaucoup trop dans tous les sens. On va là-bas, puis ailleurs, puis on revient ici... Pfff ! Ça vous arrive jamais de faire une pause, patron ? Parce que j'ai bien besoin d'une pause, moi ! »~ ~« Mais je voudrais vous dire que vous courez beaucoup trop dans tous les sens. On va là-bas, puis ailleurs, puis on revient ici... Pfff ! Ça vous arrive jamais de faire une pause, patronne ? Parce que j'ai bien besoin d'une pause, moi ! »~
@72661 = ~« Mais puisque vous demandez, j'ai une réclamation. Où sont MES trucs magiques ? Je veux une grosse épée... et un sac de contenance... et quelques baguettes... oh ouais, des baguettes... »~
@72662 = ~Bien, continuons à avancer.~
@72663 = ~*il regarde devant lui et soupire, en se grattant ostensiblement le derrière* « Oh, d'accord. Allez, quoi, encore une cinquantaine d'années de vagabondage à tirer ? Vous ne vous installez donc jamais ? Pfff... »~
@72664 = ~Allez, viens ici. Rentre dans mon sac.~
@72665 = ~*il lève les yeux au ciel* « Oh, bien sûr. Fourrez-moi dans votre sac qui pue. Vous n'avez jamais pensé à mettre un peu de menthe là-dedans ? Beurk... » *puis il se glisse à l'intérieur de votre sac à contrecœur*~
@72666 = ~Allez, viens ici. Rentre dans mon sac.~
@72667 = ~*il lève les yeux au ciel* « Oh, bien sûr. Fourrez-moi dans votre sac qui pue. Vous n'avez jamais pensé à mettre un peu de menthe là-dedans ? Beurk... » *puis il se glisse à l'intérieur de votre sac à contrecœur*~
@72668 = ~*le frapper à nouveau*~
@72669 = ~« Aïe ! Bon sang, arrêtez ! Je ferais tout ce que vous voudrez, mais arrêtez les claques ! » *il recule de quelques pas, maugréant sur « les relations interdépendantes abusives », ou quelque chose comme ça*~
@72670 = ~Allez, viens ici. Rentre dans mon sac.~
@72671 = ~Tu n'aurais pas un conseil à me donner, par hasard ?~
@72672 = ~Bon... tout va bien de ton côté ?~
@72673 = ~Bien, continuons à avancer.~
@72674 = ~Allez, viens ici. Rentre dans mon sac.~
@72675 = ~Allez, viens ici. Rentre dans mon sac.~
@72676 = ~*le frapper à nouveau*~
@72677 = ~*la créature démoniaque parvient à esquiver au dernier moment* « Nah ! Pfffrrrttt ! Vous rateriez une vache dans un couloir ! Vous êtes nul ! » *il file comme une flèche avant de se prendre des représailles*~ ~*la créature démoniaque parvient à esquiver au dernier moment* « Nah ! Pfffrrrttt ! Vous rateriez une vache dans un couloir ! Vous êtes nulle ! » *il file comme une flèche avant de se prendre des représailles*~
@72678 = ~Tu n'aurais pas un conseil à me donner, par hasard ?~
@72679 = ~Tout va bien de ton côté ?~
@72680 = ~Bien, continuons à avancer.~
@72681 = ~Allez, viens ici. Rentre dans mon sac.~
@72682 = ~Allez, viens ici. Rentre dans mon sac.~
@72683 = ~Allez, viens ici. Rentre dans mon sac.~
@72684 = ~Allez, viens ici. Rentre dans mon sac.~
@72685 = ~Tu n'aurais pas un conseil à me donner, par hasard ?~
@72686 = ~Tout va bien de ton côté ?~
@72687 = ~Bien, continuons à avancer.~
@72688 = ~*frapper le familier à la tête*~
@72689 = ~Viens ici. Pour l'instant, tu vas dans mon sac.~
@72690 = ~Viens ici. Pour l'instant, tu vas dans mon sac.~
@72691 = ~As-tu un conseil pour moi, petit familier ?~
@72692 = ~Comment vas-tu, familier ? Tout va bien ?~
@72693 = ~Non, rien. Continuons.~
@72694 = ~*le petit dragon vous regarde un instant, des étincelles dans les yeux* « Vous devez survivre, mon maître ! Il le faut ! Votre héritage est un lourd fardeau à porter ! » *il remue la queue d'un air agité*~ ~*le petit dragon vous regarde un instant, des étincelles dans les yeux* « Vous devez survivre, ma maîtresse ! Il le faut ! Votre héritage est un lourd fardeau à porter ! » *il remue la queue d'un air agité*~
@72695 = ~*ses yeux lumineux se plongent dans les vôtres* « Déjà tant de morts, de destructions, ô maître. Mais je suis sûr que vous trouverez une façon de résoudre le problème et faire ce qui est juste. »~ ~*ses yeux lumineux se plongent dans les vôtres* « Déjà tant de morts, de destructions, ô maîtresse. Mais je suis sûr que vous trouverez une façon de résoudre le problème et faire ce qui est juste. »~
@72696 = ~*le petit dragon grogne férocement pendant un moment* « L'imposteuse doit mourir, mon maître ! Vous devez monter sur le trône de Bhaal et la confronter ! »~ ~*le petit dragon grogne férocement pendant un moment* « L'imposteuse doit mourir, ma maîtresse ! Vous devez monter sur le trône de Bhaal et la confronter ! »~
@72697 = ~*il se gratte la tête un instant avant de répondre* « On a un gros problème, patron. Le temps est venu, pour tous les enfants de Bhaal. Les carottes sont cuites ! C'est le moment de payer l'addition, vous voyez ? Essayez juste de ne pas y laisser votre peau, c'est tout ce que je peux vous dire. »~ ~*il se gratte la tête un instant avant de répondre* « On a un gros problème, patronne. Le temps est venu, pour tous les enfants de Bhaal. Les carottes sont cuites ! C'est le moment de payer l'addition, vous voyez ? Essayez juste de ne pas y laisser votre peau, c'est tout ce que je peux vous dire. »~
@72698 = ~*la créature malicieuse vous fait un sourire carnassier* « Ben... y'a qu'à tous les tuer avant qu'ils ne vous tuent. C'est ce que mon grand-père disait toujours... jusqu'à ce qu'il se fasse... hum... tuer... »~
@72699 = ~*il hausse les épaules* « Ça me semble pourtant simple, patron. Tuez cette garce ! »~ ~*il hausse les épaules* « Ça me semble pourtant simple, patronne. Tuez cette garce ! »~
@72700 = ~*le petit animal hausse les épaules, visiblement las... il ne semble guère pressé de vous répondre* « Je sais pas, moi ! Le magicien est mort, vous avez récupéré votre âme... on pourrait pas simplement s'en aller, chef ? » *il bâille ostensiblement* « Et lever une armée. Non ? N'est-ce pas ce que vous faites d'habitude ? »~ ~*le petit animal hausse les épaules, visiblement las... il ne semble guère pressé de vous répondre* « Je sais pas, moi ! Le magicien est mort, vous avez récupéré votre âme... on pourrait pas simplement s'en aller, cheffe ? » *il bâille ostensiblement* « Et lever une armée. Non ? N'est-ce pas ce que vous faites d'habitude ? »~
@72701 = ~*il cligne des yeux plusieurs fois, en réfléchissant intensément* « Il... me semble qu'il doit bien y avoir une raison pour que tous les enfants de Bhaal se réunissent... ça doit être la confrontation finale qui approche ! » *il sourit* « Et bien sûr, c'est vous qui devez gagner ! »~
@72702 = ~« La seule solution est évidente... Il faut retrouver celle qui vous a menti et la tuer ! Il faut voyager jusqu'aux Abysses pour en finir avec elle ! » *il hausse les épaules* « Enfin... moi, c'est ce que je ferais... »~
@72703 = ~Création de baguette~
@72704 = ~Aidez-nous !~
@72705 = ~L'armée va nous massacrer !~
@72706 = ~Courez ! Courez !~
@72707 = ~Ha ha ha !~
@72708 = ~Ce sont eux ! Ceux que Yaga-Shura recherche !~
@72709 = ~C'est l'enfant de Bhaal qui devait être dans la ville !~
@72710 = ~Attrapez-les ! Il y a une récompense !~
@72711 = ~*les derniers gardiens du sceau se sont éveillés... vous avez l'intime conviction qu'il vous faudra les vaincre sans peine si vous voulez pouvoir face à l'Emprisonné et survivre*~
@72712 = ~Vous ne pouvez pas poser davantage de pièges ici.~
@72713 = ~*vous placez la clef dans la serrure... interagissez à nouveau pour tourner la clef et réveiller qui sait quelles créatures vous attendent*~
