@89054 = ~Très bien ! On va faire ça vite et bien.~ [MALE2a]
@89055 = ~Vous pouvez m'faire confiance, avec moi, il n'y a jamais d'problèmes.~ [MALE2b]
@89056 = ~Ce n'est pas mon genre de m'plaindre, mais là j'fatigue.~ [MALE2c]
@89057 = ~J'ai besoin d'action, sinon je rouille.~ [MALE2d]
@89058 = ~Notre... collaboration... risque fort de faire long feu... si vous n'm'aidez pas... ah... tout de suite ! Ahh.~ [MALE2e]
@89059 = ~Ouais ?~ [MALE2f]
@89060 = ~Je suis tout ouïe.~ [MALE2g]
@89061 = ~J'attends.~ [MALE2h]
@89062 = ~J'espère que ça en vaut la peine.~ [MALE2i]
@89063 = ~J'm'en charge !~ [MALE2j]
@89064 = ~Comme si c'était fait.~ [MALE2k]
@89065 = ~Non, Ahhh !~ [MALE2l]
@89066 = ~Non, oooh, ooaaaahhhh, ahhh...~ [MALE2m]
@89067 = ~C'est parti !~ [MALE2s]
@89068 = ~S'il faut l'faire...~ [MALE2t]
@89069 = ~Autant qu'je m'en charge.~ [MALE2u]
@89070 = ~Pas d'problème.~ [MALE2v]
