@61738 = ~Aaaaaaaaaah !~ [VAMPM07]
@61739 = ~Aaaahhh... ahhhh...~ [VAMPM08]
@61740 = ~Nous n'en avons pas fini ensemble, mortel !~ [VAMPM09] ~Nous n'en avons pas fini ensemble, mortelle !~ [VAMPM09]
@61741 = ~Je suis la prédatrice au milieu des moutons.~ [VAMPFX01]
@61742 = ~Laisse-moi goûter, allons.~ [VAMPFX02]
@61743 = ~La mort t'attend. Alors que moi...~ [VAMPFX03]
@61744 = ~Hahahahaha, hinhinhin...~ [VAMPFX04]
@61745 = ~Je me repaîtrai de ton cœur !~ [VAMPFX05]
@61746 = ~C'est un très grand honneur d'apaiser ma faim !~ [VAMPFX06]
@61747 = ~Ah !~ [VAMPFX07]
@61748 = ~Ooooooohhhhh...~ [VAMPFX08]
@61749 = ~Je reviendrai, imbécile !~ [VAMPFX09]
@61750 = ~Ce lieu sera ton tombeau !~ [UNEARM01]
@61751 = ~Jamais tu n'aurais dû parvenir jusqu'ici !~ [UNEARM02]
@61752 = ~Tu souffriras avant de rendre l'âme, je te le promets.~ [UNEARM03]
@61753 = ~Ta dernière heure est venue !~ [UNEARM04]
@61754 = ~J'aurai plaisir à t'arracher le cœur !~ [UNEARM05]
@61755 = ~Aaaah !~ [UNEARM06]
@61756 = ~Aaaaaaahhhhh...~ [UNEARM07]
@61757 = ~Non ! Je dois m'enfuir !~ [UNEARM08]
@61758 = ~Tu vas finir ici, pauvre fou !~ [UNEARF01] ~Tu vas finir ici, pauvre folle !~ [UNEARF01]
@61759 = ~Ta vie s'achève entre mes mains.~ [UNEARF02]
@61760 = ~La mort ne sera que le commencement pour toi...~ [UNEARF03]
@61761 = ~Je pendrai grand plaisir à te vider comme un poulet...~ [UNEARF04]
@61762 = ~L'heure est venue pour toi de payer pour tes crimes !~ [UNEARF05]
@61763 = ~Ooh !~ [UNEARF06]
@61764 = ~Oooooohh...~ [UNEARF07]
@61765 = ~Non ! Non ! Je dois m'échapper !~ [UNEARF08]
@61766 = ~Il existe mille et une façons de s'occuper de misérable comme vous !~ [HVILLF01]
@61767 = ~Faites vos prières, vous allez mourir !~ [HVILLF02]
@61768 = ~J'en ai soupée de vous !~ [HVILLF03]
@61769 = ~Vous aurez bien vite ce que vous méritez.~ [HVILLF04]
@61770 = ~Je vous veux mort !~ [HVILLF05] ~Je vous veux morte !~ [HVILLF05]
@61771 = ~Ouh !~ [HVILLF06]
@61772 = ~Aaaaah, ahhhh...~ [HVILLF07]
@61773 = ~On se retrouvera.~ [HVILLF08]
@61774 = ~Prépare-toi à cracher tes tripes, vil faquin.~ [HVILLM01] ~Prépare-toi à cracher tes tripes, vile faquine.~ [HVILLM01]
@61775 = ~~
@61776 = ~C'est à quel sujet ?~ [HVILLM02]
@61777 = ~Ceci va être long et douloureux.~ [HVILLM03]
@61778 = ~Tu souffriras. Oh, oui, tu souffriras...~ [HVILLM04]
@61779 = ~Je vais remuer tes tripes du bout de ma lame !~ [HVILLM05]
@61780 = ~Oooooh !~ [HVILLM06]
@61781 = ~Aaaaahhhhh...~ [HVILLM07]
@61782 = ~Un jour je t'aurai !~ [HVILLM08]
@61783 = ~Hein ? Tu veux quoi ?~ [HUMAN01]
@61784 = ~Je t'ai à l'œil !~ [HUMAN02]
@61785 = ~Cause, petit gars ! Cause donc !~ [HUMAN03] ~Cause, petite dame ! Cause donc !~ [HUMAN03]
@61786 = ~Toi et moi on s'entend pas !~ [HUMAN04]
@61787 = ~J'aime sentir les os du cou se briser entre mes mains ! RAAAAHHHHR !~ [HUMAN05]
@61788 = ~Je vais te massacrer, puceron !~ [HUMAN06] ~Je vais te massacrer, puceronne !~ [HUMAN06]
@61789 = ~Oooh !~ [HUMAN07]
@61790 = ~Oooooohhhh...~ [HUMAN08]
@61791 = ~Nooooon !~ [HUMAN09]
@61792 = ~Vous êtes nuisible, ce que je ne saurai tolérer !~ [TERMIN17]
@61793 = ~Il est temps, je pense, que je batte en retraite. Oui, voilà qui serait avisé.~ [TERMIN20]
@61794 = ~Impossible de donner l'objet, l'inventaire du personnage est plein.~
@61795 = ~On se retrouvera. Nous sommes loin d'en avoir terminé !~ [INSPEC20]
@61796 = ~À bientôt, pauvre fou ! Nous nous retrouverons !~ [ARDULA26] ~À bientôt, pauvre folle ! Nous nous retrouverons !~ [ARDULA26]
@61797 = ~Bien le bonjour.~ [PEASM301]
@61798 = ~On a beau temps, vous trouvez pas ?~ [PEASM302]
@61799 = ~Hé... euh... 'jour.~ [PEASM303]
@61800 = ~Est-ce que j'ai l'air d'avoir le temps de tailler une bavette ?~ [PEASM304]
@61801 = ~Pas possible de faire trois pas sans s'faire aborder de nos jours.~ [PEASM305]
@61802 = ~Dites ce que vous avez à dire, et disparaissez.~ [PEASM306]
@61803 = ~Aaah !~ [PEASM307]
@61804 = ~Aah ! Aaaaaahhhh...~ [PEASM308]
@61805 = ~Il faut fuir !~ [PEASM309]
@61806 = ~Soyez gais, mon ami !~ [PEASM201] ~Soyez gais, mon amie !~ [PEASM201]
@61807 = ~Joie et félicité !~ [PEASM202]
@61808 = ~Est-ce important ?~ [PEASM203]
@61809 = ~Tant que vous n'êtes pas le collecteur de la taille...~ [PEASM204] ~Tant que vous n'êtes pas la collectrice de la taille...~ [PEASM204]
@61810 = ~Vous parlez comme ça à tout le monde, ou seulement aux pauvres gens ?~ [PEASM205]
@61811 = ~Vous pensez vraiment qu'un pauvre homme n'a rien de mieux à faire ?~ [PEASM206]
@61812 = ~Ouuuh !~ [PEASM207]
@61813 = ~Ooohhh...~ [PEASM208]
@61814 = ~Aaaaaaaah !~ [PEASM209]
@61815 = ~Que vos affaires prospèrent, mon ami.~ [PEASM01] ~Que vos affaires prospèrent, mon amie.~ [PEASM01]
@61816 = ~Ooh, c'est une bien belle journée, n'est-ce pas ?~ [PEASM02]
@61817 = ~Bien sûr, j'échangerai volontiers quelques mots avec vous.~ [PEASM03]
@61818 = ~Hmpf ! Comme si je n'aurais rien de mieux à faire...~ [PEASM04]
@61819 = ~Je... je ne peux vous satisfaire...~ [PEASM05]
@61820 = ~Rien de pire qu'un filou de kobold.~ [PEASM06]
@61821 = ~Oula !~ [PEASM07]
@61822 = ~Ouille, aïe, oooohh, ohhhh, ohhh...~ [PEASM08]
@61823 = ~Aaaahhh... Courez !~ [PEASM09]
@61824 = ~Je gage que tout va pour le mieux ?~ [NOBMA201]
@61825 = ~Vous m'avez l'air digne de confiance.~ [NOBMA202]
@61826 = ~Je n'ai cure de telles grossièretés, manant.~ [NOBMA203] ~Je n'ai cure de telles grossièretés, manante.~ [NOBMA203]
@61827 = ~Je gage que vous savez à qui vous avez affaire.~ [NOBMA204]
@61828 = ~Sainte patience, priez pour moi, en voici encore un !~ [NOBMA205] ~Sainte patience, priez pour moi, en voici encore une !~ [NOBMA205]
@61829 = ~Vous n'êtes pas sans savoir ce qu'est un bain, n'est-ce pas ?~ [NOBMA206]
@61830 = ~Ouuuh !~ [NOBMA207]
@61831 = ~Oooooh, ooogr, ooog, ooogre, oohhhh...~ [NOBMA208]
@61832 = ~Courez ! Courez, avant qu'ils ne nous tuent tous !~ [NOBMA209]
@61833 = ~Je suppose que je peux vous serrer la main, mais il faudra que je m'épuce après.~ [NOBMA01]
@61834 = ~Oooh, c'est l'une de ces petites gens.~ [NOBMA02]
@61835 = ~Je n'ai que peu de temps. Soyez bref, manant.~ [NOBMA03] ~Je n'ai que peu de temps. Soyez brève, manante.~ [NOBMA03]
@61836 = ~Par mon sang, j'en ai le droit.~ [NOBMA04]
@61837 = ~Hors de ma vue, manant. J'ai à faire.~ [NOBMA05] ~Hors de ma vue, manante. J'ai à faire.~ [NOBMA05]
@61838 = ~Ne me touchez pas... Parlez, qu'on en finisse !~ [NOBMA06]
@61839 = ~Aaaah !~ [NOBMA07]
@61840 = ~Aaahhh, aaahhh, aahhhhh...~ [NOBMA08]
@61841 = ~Il... il me faut fuir !~ [NOBMA09]
@61842 = ~Mazzy m'a parlé de vous. Bienvenue chez moi, <CHARNAME>.~
@61843 = ~Nous n'en avons pas encore terminé !~ [TEOSXX20]
@61844 = ~Aaaaaaaaahh !~ [MAEVAR26]
@61845 = ~Je me sens mieux maintenant et ce n'est pas grâce à vous. Ma sœur ne souhaite pas vous voir ici, partez s'il vous plaît.~
@61846 = ~Je ne mourrai pas pour vous, hérétique !~ [YARRYL20]
@61847 = ~Que... Qu-qu'est-il arrivé à la reine ? Elle a été capturée, n'est-ce pas ?~ [MALELF01]
@61848 = ~C'est... c'est l'Exilé ! L'Exilé est revenu !~ [MALELF02]
@61849 = ~Il faut battre en retraite !~ [CELOGA32]
@61850 = ~Des monstres ! Les monstres ont envahi Suldanessalar !~ [MALELF03]
@61851 = ~Cela ne peut pas arriver, non !~ [MALELF04]
@61852 = ~Ah !~ [MALELF05]
@61853 = ~Aaaahhhh...~ [MALELF06]
@61854 = ~C'est l'Exilé ! C'est l'Exilé !~ [FEMELF01]
@61855 = ~Tant et tant sont morts. Mon dieu !~ [FEMELF02]
@61856 = ~L'Arbre de Vie ! L'Arbre de Vie doit être sauvé avant aucun d'entre nous !~ [FEMELF03]
@61857 = ~Rillifane ! Viens-nous en aide, je t'en supplie !~ [FEMELF04]
@61858 = ~~
@61859 = ~Livre~
@61860 = ~Aah !~ [FEMELF05]
@61861 = ~Aaahhh...~ [FEMELF06]
@61862 = ~Identifiez-vous ! Qui va là ?~ [SOLM01]
@61863 = ~Ne me détournez pas de mon devoir.~ [SOLM02]
@61864 = ~Au repos, citoyen.~ [SOLM03] ~Au repos, citoyenne.~ [SOLM03]
@61865 = ~Je gage que vos intentions ne sont pas hostiles.~ [SOLM04]
@61866 = ~Ma dague éprouvera ton cœur !~ [SOLM05]
@61867 = ~Aaah !~ [SOLM06]
@61868 = ~Ouuuuuhhhhhh...~ [SOLM07]
@61869 = ~Battons en retrait !~ [SOLM08]
@61870 = ~Parlez vite, citoyen. Je n'ai guère le temps pour ce genre de futilité.~ [SOLF01] ~Parlez vite, citoyenne. Je n'ai guère le temps pour ce genre de futilité.~ [SOLF01]
@61871 = ~Bonne journée à vous.~ [SOLF02]
@61872 = ~Je sers avec ma lame.~ [SOLF03]
@61873 = ~Ne jouez pas au plus fin et il n'y aura pas de problème.~ [SOLF04] ~Ne jouez pas à la plus fine et il n'y aura pas de problème.~ [SOLF04]
@61874 = ~Croisons nos lames que j'te pourfende !~ [SOLF05]
@61875 = ~Ah !~ [SOLF06]
@61876 = ~Aaaahhh, ahhh...~ [SOLF07]
@61877 = ~Aaaaah ! Je dois battre en retraite !~ [SOLF08]
@61878 = ~Nous n'en avons pas terminé ! Nous nous retrouverons !~ [UDSOLA28]
@61879 = ~~
@61880 = ~Oooh ! Pas les mains ! Pas les mains !~ [SARLES20]
@61881 = ~Ce n'est pas terminé ! J'en fais serment !~ [SIMYAZ28]
@61882 = ~C'est agréable de rencontrer quelqu'un qui pense comme moi.~ [STHMA01]
@61883 = ~Dis ce que t'as à dire.~ [STHMA02]
@61884 = ~Tu cherches quelque chose ?~ [STHMA03]
@61885 = ~Explique-toi et sois clair.~ [STHMA04] ~Explique-toi et sois claire.~ [STHMA04]
@61886 = ~Supplie-moi et je ferai ça vite !~ [STHMA05]
@61887 = ~Personne ne provoque impunément les Voleurs de l'ombre !~ [STHMA06]
@61888 = ~Aïe !~ [STHMA07]
@61889 = ~Aahhhhhh...~ [STHMA08]
@61890 = ~Je dois... retourner dans l'ombre !~ [STHMA09]
@61891 = ~C'est une très belle journée, quelles que soient tes intentions.~ [STHFE01]
@61892 = ~Hmmm ?~ [STHFE02]
@61893 = ~Ouais ?~ [STHFE03]
@61894 = ~Fais bien attention, moi j'ai l'œil vif !~ [STHFE04]
@61895 = ~J'crois bien que tu vas mourir !~ [STHFE05]
@61896 = ~Poison ou pas, tu seras mort bientôt !~ [STHFE06] ~Poison ou pas, tu seras morte bientôt !~ [STHFE06]
@61897 = ~Aaah !~ [STHFE07]
@61898 = ~Oh, oohhh, ohhh, oooohhhhhhh...~ [STHFE08]
@61899 = ~Tu peux pas affronter la guilde et t'en tirer comme ça !~ [STHFE09]
@61900 = ~Fuir ! Il faut fuir !~ [SASSAR25]
@61901 = ~N'avance plus, ou te le regretteras.~ [RUFFIA01]
@61902 = ~Je peux briser un bras ou une jambe pour quelques piécettes.~ [RUFFIA02]
@61903 = ~Ooooh, la barbe !~ [RUFFIA03]
@61904 = ~Tu n'es pas une chiffe. Ça, non !~ [RUFFIA04]
@61905 = ~Très bien ! Toi contre moi ! Allons-y !~ [RUFFIA05]
@61906 = ~Ooooh !~ [RUFFIA06]
@61907 = ~Ooooohhhhh...~ [RUFFIA07]
@61908 = ~Je me rends ! Je me rends !~ [RUFFIA08]
@61909 = ~Toucher vampirique~
@61910 = ~Toucher vampirique~
@61911 = ~Nous nous reverrons !~ [RENAL25]
@61912 = ~Non ! Il faut que je m'échappe !~ [TANNER20]
@61913 = ~AAAAAHHH !~ [RAELIS34]
@61914 = ~Un sort de Toucher vampirique a déjà été lancé~
@61915 = ~Une nouvelle mission pour le compte du temple

J'ai combattu Borinall le receleur pour l'Anneau de l'Aube. Je dois maintenant le rapporter à mes supérieurs.~
@61916 = ~Viconia, tu devrais savoir que j'ai l'intention de m'occuper d'Irenicus une bonne fois pour toutes.~
@61917 = ~Irenicus doit être arrêté... ce n'est pas aussi simple que tu le dis !~
@61918 = ~Je n'ai aucune intention de discuter de ça avec toi.~
@61919 = ~Oh ? Alors je dois faire ce que l'on me dit et me taire ? Sale bâtard, continue tes insultes et tu seras aux premières loges pour juger de la supériorité des femelles elfes noires.~ ~Oh ? Alors je dois faire ce que l'on me dit et me taire ? Sale bâtarde, continue tes insultes et tu seras aux premières loges pour juger de la supériorité des femelles elfes noires.~
@61920 = ~Si tu le dis, <CHARNAME>. Je ne vois pas pourquoi tu ne laisses pas ce chien tranquille là où il est... il y a des quêtes plus dignes de toi.~
@61921 = ~Irenicus a volé mon âme, Viconia... Suggères-tu que je la lui abandonne ?~
@61922 = ~Je ne le laisserai pas s'en tirer après ce qu'il a fait, quoi que tu en dises.~
@61923 = ~Tu as peut-être raison, mais il me semble que je n'ai pas beaucoup le choix en l'occurrence.~
@61924 = ~Ça suffit ! Nos objectifs ne sont pas les mêmes, tu ne sais rien de moi !~
@61925 = ~Pas du tout ! Vengeons-nous par tous les moyens. C'est juste lassant de te voir constamment obsédé par quelque croisade, morale ou autre.~ ~Pas du tout ! Vengeons-nous par tous les moyens. C'est juste lassant de te voir constamment obsédée par quelque croisade, morale ou autre.~
@61926 = ~Peut-être quelqu'un t'apprivoisera-t-il un jour et te mettra sur le chemin de ta propre destinée... C'est une pensée agréable.~
@61927 = ~Donc, voici une autre de tes croisades, n'est-ce pas ? Parcourir le monde sans trêve ni repos ? Quel fardeau pesant.~
@61928 = ~J'en sais beaucoup sur toi. Je sais que tu fuis ta vraie destinée, en refusant d'admettre les évidences. Au lieu de cela, tu te laisses distraire par ces quêtes insignifiantes. Comme ce doit être frustrant.~
@61929 = ~En fait, Madulf m'envoie vous faire une proposition... lui et ses gens protégeront le village en échange de relations paisibles et d'un peu de commerce.~
@61930 = ~En fait, Madulf m'envoie vous faire une proposition... lui et ses gens protégeront le village en échange de relations paisibles et d'un peu de commerce.~
@61931 = ~En fait, Madulf m'envoie vous faire une proposition... lui et ses gens protégeront le village en échange de relations paisibles et d'un peu de commerce.~
@61932 = ~TAC0 de base~
@61933 = ~Laissez-nous seuls.~
@61934 = ~Crypte de Franc-Marché~
@61935 = ~Maison de Tiris~
@61936 = ~Porte sud-ouest~
@61937 = ~Vers la prison de Franc-Marché~
@61938 = ~*le portail luminescent vous révèle un paysage tourmenté, parcouru par des ombres de toutes tailles*~
@61939 = ~Peau de Raïssa~
@61940 = ~La peau abandonnée de Raïssa. Les derviches peleurs lui ont volé et essayaient de se déguiser avec pour que leurs crimes restent impunis.

PARAMÈTRES :

Poids : 13~
@61941 = ~Peau de Raïssa~
@61942 = ~Voulez-vous quelques renseignements ou vous contentez-vous d'errer sans but ? Mae'Var se trouve dans les sous-sols de son trou à rats, comme si vous ne le saviez pas. J'en ai assez de vous !~
@61943 = ~Comme vous le souhaitez, mais je n'attendrai pas que vous, primates, terminiez le travail. Vous trouverez le bureau de Mae'Var à l'étage en dessous. Je me suis arrangé pour vous obtenir une clef qui vous permettra d'ouvrir son coffre-fort.~
@61944 = ~Si vous voulez bien m'excuser, j'ai mes propres bénéfices à retirer de cette trahison. Vous savez, vous n'êtes pas les seuls à piétiner Mae'Var pour le profit.~
@61945 = ~Si vous retrouvez vos esprits et si vous réalisez que vous pouvez tirer profit de mes talents magiques (comme je m'en suis rendu compte moi-même et c'est la seule raison pour laquelle j'accepterais de voyager avec ces primates), vous me trouverez à la Couronne de Cuivre.~
@61946 = ~Mes contacts dans la guilde m'ont appris que vous n'aviez pas encore amené ce qu'il souhaitait à Bloodscalp. Je vous avais averti que cette tâche ne serait pas facile. (Voilà ce qu'il en coûte de ne pas tenir compte de mes conseils !)~
@61947 = ~Peut-être avez-vous changé d'avis et vous rendez-vous maintenant compte de mon potentiel dans le domaine de la magie ! Si vous vous montrez agréable, nous pourrons faire un bout de chemin ensemble.~
@61948 = ~Ainsi... j'ai entendu dire que vous aviez réussi à faire sa fête à Mae'Var. (Un exploit surprenant pour de tels bouffons.) J'ai aussi entendu dire que cet idiot était encore en vie alors que Renal ne le voulait pas.~
@61949 = ~Ah ! Si ce n'est pas mon vieil ami... haa... euh... bah ! Cela n'a pas d'importance ! Je flaire toujours une occasion pour le profit quand je le vois.~ ~Ah ! Si ce n'est pas ma vieille amie... haa... euh... bah ! Cela n'a pas d'importance ! Je flaire toujours une occasion pour le profit quand je la vois.~
@61950 = ~Je préférerais vous voir au fond d'une tourbière, espèce de bâtard maniaque !~
@61951 = ~Si je me souviens bien, Edwin, vous m'avez promis de me servir pendant une année.~
@61952 = ~Non, merci. Je n'ai pas besoin de votre aide pour le moment.~
@61953 = ~Certainement... joignez-vous à moi.~
@61954 = ~C'est ce que vous dites. J'ai observé comment vous opériez... vous reviendrez. En attendant, j'ai plein de trucs pour me divertir ici.~
@61955 = ~Moi ? Pfeuh. Les promesses, ça va, ça vient. Voulez-vous que je vous aide ou pas ?~
@61956 = ~C'est ça ! Je ne veux plus vous entendre, magicien !~
@61957 = ~Jamais ! Autant faire confiance à la dague que vous planterez dans mon dos.~
@61958 = ~Non, je n'ai pas besoin de vous pour le moment.~
@61959 = ~Très bien, très bien. Joignez-vous à moi alors.~
@61960 = ~O-ho ! On part et on se met à faire de l'esprit ! De seconde zone d'ailleurs ! Très bien ! Vous ne me reverrez plus, espèces de primates !~
@61961 = ~O-ho ! Vous revoilà je vois. Avez-vous changé d'avis ? Je préférerais nettement qu'on s'occupe de Mae'Var une fois pour toute... et je ne vois personne d'autre que vous qui soit plus qualifié pour cela.~ ~O-ho ! Vous revoilà je vois. Avez-vous changé d'avis ? Je préférerais nettement qu'on s'occupe de Mae'Var une fois pour toute... et je ne vois personne d'autre que vous qui soit plus qualifiée pour cela.~
@61962 = ~Oui, j'ai changé d'avis. Je le ferai.~
@61963 = ~Non, je ne veux pas faire ça, Renal.~
@61964 = ~Alors pourquoi êtes-vous revenu ? Si la chose n'est pas faite, il n'y a pas de récompense. Cela n'a pas changé. Réfléchissez-y encore, si vous le souhaitez.~ ~Alors pourquoi êtes-vous revenue ? Si la chose n'est pas faite, il n'y a pas de récompense. Cela n'a pas changé. Réfléchissez-y encore, si vous le souhaitez.~
@61965 = ~Vous avez tué des membres de ma guilde ?! Je me fiche de savoir pourquoi vous êtes ici, mourrez maintenant !~
@61966 = ~Vous avez sauvé notre cité d'un tragique destin. Allez en paix !~
@61967 = ~Vous êtes l'élu de la prophétie de Sekolah. Puisse la fortune vous accompagner, <PRO_RACE>.~ ~Vous êtes l'élue de la prophétie de Sekolah. Puisse la fortune vous accompagner, <PRO_RACE>.~
@61968 = ~*vous bénéficiez maintenant d'un bonus de 2 à tous vos jets de sauvegarde*~
@61969 = ~*vous avez obtenu 200 000 points d'expérience*~
@61970 = ~*vous bénéficiez maintenant de 20 % de résistance au feu, au froid et à l'électricité*~
@61971 = ~*vous avez obtenu 2 points de Force*~
@61972 = ~*vous avez obtenu 1 point de Sagesse et 1 point de Charisme*~
@61973 = ~Initiation

Retrouver le saphir étoilé pour Belt.~
@61974 = ~Je gage que tout va pour le mieux.~ [GDWARF01]
@61975 = ~Je n'ai pas de temps à perdre avec ceux de votre espèce.~ [GDWARF02]
@61976 = ~Prenez garde, ou je vous ferais pendre par la langue !~ [GDWARF03]
@61977 = ~Mon épée éprouvera votre impétuosité !~ [GDWARF04]
@61978 = ~Aaaaaah !~ [BREGAX18]
@61979 = ~Justice... sera... faite...~ [BREGAX05]
@61980 = ~Bien le bonjour.~ [GGFEM01]
@61981 = ~Votre fin est proche !~ [GGFEM02]
@61982 = ~Vous avez fait une erreur de jugement fatale.~ [GGFEM03]
@61983 = ~~
@61984 = ~~
@61985 = ~Aaaaah !~ [WOMLC03]
@61986 = ~Ahh ! Aaaahh, ahhhhh...~ [WOMCO04]
@61987 = ~Que se passe-t-il encore ?~ [GGMAL01]
@61988 = ~Parlons, et finissons-en !~ [GGMAL02]
@61989 = ~Je vais nettoyer les royaumes de votre répugnante lignée.~ [GGMAL03]
@61990 = ~Vous ne méritez ni plus ni moins que la mort !~ [GGMAL04]
@61991 = ~Aah !~ [ISAEAX04]
@61992 = ~Ah ! Aaaahhhh...~ [ISAEAX05]
@61993 = ~Comme toujours, le plaisir est pour moi.~ [GNFEM01]
@61994 = ~Ne m'énervez pas !~ [GNFEM02]
@61995 = ~Vous paierez pour ça, et pas qu'un peu !~ [GNFEM03]
@61996 = ~Vous allez souffrir !~ [GNFEM04]
@61997 = ~Aaaarrrrr !~ [PHAERE05]
@61998 = ~Aaaah, aahhhh...~ [PHAERE06]
@61999 = ~Vous êtes le bienvenu ici.~ [GNMAL01] ~Vous êtes la bienvenue ici.~ [GNMAL01]
@62000 = ~Bonne journée à vous.~ [GNMAL02]
@62001 = ~Ma sentence sera rapide et sans appel !~ [GNMAL03]
@62002 = ~Hmm !~ [KAYLXX04]
@62003 = ~Aïïïïïïïïaaah, uh aahhhhhh...~ [MANCO04]
@62004 = ~J'espère que tout va bien ?~ [GNMAL201]
@62005 = ~J'en ai assez de vous !~ [GNMAL202]
@62006 = ~Dégagez, ou vous en subirez les conséquences !~ [GNMAL203]
@62007 = ~Aaaaaah !~ [RENAL06]
@62008 = ~Aaaaah, aaahhhh...~ [RENAL07]
@62009 = ~Journal de Tizzak~
@62010 = ~Journal de Tizzak~
@62011 = ~~
@62012 = ~Note de Demin~
@62013 = ~Note de Demin~
@62014 = ~Ce morceau de papier est une sorte de journal rapidement tenu par le voleur Tizzak. Un passage en particulier attire votre regard :

J'ai découvert que le sanctuaire d'Aran est protégé par deux portes magiques. Elles sont impossibles à crocheter ou à enfoncer. La première s'ouvre à l'aide d'un interrupteur, la seconde à l'aide d'une clef.

Le bouton se trouve au nord, tout au bout d'un long couloir piégé.

Quant à la clef, je ne sais où elle est... Je sais seulement que le conseiller spécial d'Aran est un mage du nom de Haz. Il est peut-être en possession de la clef.~
@62015 = ~Rillifane dort et ses enfants souffrent !

L'Exilé a enlevé la Reine Ellésime et ses suppôts nous tueront tous !

Nous devons réveiller Rillifane mais le temple a été profané. Le dragon possède la Coupe de vie mais personne n'oserait s'opposer à lui. Je ne sais où la Lame de lune et le Talisman de Rillifane sont cachés. Et quand bien même nous les trouvions tous, qui donc aurait le courage de pénétrer dans le temple et de les placer sur l'autel ? Mais il le faut, Rillifane ne peut être éveillé autrement !~
@62016 = ~-- Espace laissé vide intentionnellement --~
@62017 = ~-- Espace laissé vide intentionnellement --~
@62018 = ~-- Espace laissé vide intentionnellement --~
@62019 = ~-- Espace laissé vide intentionnellement --~
@62020 = ~-- Espace laissé vide intentionnellement --~
@62021 = ~-- Espace laissé vide intentionnellement --~
@62022 = ~Les objets à utilisation limitée, comme la Trompe de destruction, disparaissent de la barre des objets dès qu'on y a recours. Ils réapparaissent dès qu'ils sont à nouveau disponibles.~
@62023 = ~Le tyrannœil meurt et laisse à terre plusieurs objets.~
@62024 = ~Vous ne pouvez pas changer d'armure en cours de combat.~
@62025 = ~Mais tu ne peux plus me vaincre. Tu t'es vidé, rien ne te reste, sauf ton instinct. Tu es vide à l'intérieur.~ [PPBHAA08] ~Mais tu ne peux plus me vaincre. Tu t'es vidée, rien ne te reste, sauf ton instinct. Tu es vide à l'intérieur.~ [PPBHAA08]
@62026 = ~Vous ne pouvez pas lancer de sort de Familier au cours de l'initiation.~
@62027 = ~Vous avez stupidement assassiné Goldander Blackenrock, un acte maléfique qui doit être ignoré pour le moment.~
@62028 = ~Vous n'avez pas encore identifié le bouclier. Pour cela, effectuez un clic droit dessus et choisissez Identifier.~
@62029 = ~*après votre assaut sur le dragon, l'illusion elfe noire se dissipe*~
@62030 = ~Il n'y a rien d'autre à dire.~
@62031 = ~~
@62032 = ~*les esprits des illithids ont façonné la pierre pour la transformer en une sorte de récipient parfait pour nourrir le géancéphale*~
@62033 = ~*les relents chimiques de cerveaux en pleine fermentation vous assaillent alors que vous découvrez le fameux géancéphale des illithids... l'instant d'après, une sorte de fouet psionique déchire votre esprit*~
@62034 = ~Qu'est-ce qui a provoqué ça ? Nous ne sommes pas dans la nature en ce moment.~
@62035 = ~Tu penses trop à ces choses, Jaheira. Tout le monde n'apprécie pas la nature autant que toi.~
@62036 = ~C'est vrai, c'est vrai. Mais nous avons tellement voyagé... et, la dernière fois que nous nous sommes retrouvés au cœur de la nature, je ne l'ai même pas remarqué. Ça me perturbe, <CHARNAME>. Je ne devrais pas oublier ce que la nature signifie pour moi.~
@62037 = ~Je me préoccupe des choses à venir et je n'ai pas le temps de papoter.~
@62038 = ~La rançon de dame Elgea

J'ai rencontré Welther en face de la Couronne de Cuivre, et j'ai reçu la rançon initialement destinée à Camitis et Reti. Welther sait désormais où se trouve Dame Elgea. Retourner à cet endroit ne sera peut-être pas une bonne idée.~
@62039 = ~S'il vous plaît ! Nous devons trouver le joyau planaire, nous le devons ! Je vous en supplie... Retournons à Mekrath pour que dame Raelis puisse obtenir la gemme qu'elle souhaite. S'il vous plaît.~
@62040 = ~Prêtresse de Sekolah~
@62041 = ~Prêtresse de Sekolah~
@62042 = ~Partez. Vous n'avez rien vu.~
@62043 = ~Viekang~
@62044 = ~Viekang~
@62045 = ~~
@62046 = ~Inutile de dire quoi que ce soit. J'ai senti la mort d'Haer'Dalis avant que vous ne veniez. Cela me brise le cœur de voir une telle âme brisée sur ce plan.~
@62047 = ~Une récompense, pour votre peine... et moi et ma troupe allons retourner chez nous. Il n'y a pas grand-chose d'autre qui nous retient ici. Nous attendrons jusqu'à votre départ.~
@62048 = ~Ahhh... notre pauvre acteur compte pour notre groupe. Mais son étincelle de vie l'a quitté. Quelle tragédie... mais on peut y faire quelque chose... un moment s'il vous plaît.~
@62049 = ~Temple de Sekolah~
@62050 = ~Le Père des Requins observe. Avez-vous besoin des services de ce temple ?~
@62051 = ~Oui, puis-je voir ce que vous proposez ?~
@62052 = ~Je n'ai besoin de rien venant de vous.~
@62053 = ~J'ai assez passé de temps avec ces idiots, je dois partir et faire une offrande à Lolth.~
@62054 = ~Conduisez <CHARNAME> auprès de moi. L'affaire est trop grave pour qu'un intermédiaire s'en mêle.~
@62055 = ~Les portes d'Ust Natha ont été scellées sur ordre de la Mère Matrone. On ne peut ni entrer ni sortir sans la permission de la Mère Matrone Ardulace.~
@62056 = ~Vous... vous êtes celui qui nous a libérés ! Je... je vous remercie.~ ~Vous... vous êtes celle qui nous a libérés ! Je... je vous remercie.~
@62057 = ~Nous sommes libres ! Maintenant... maintenant nous devons sortir de cette prison.~
@62058 = ~Nous devons trouver le directeur ! Nous devons le trouver et le tuer avant qu'il ne nous enchaîne de nouveau.~
@62059 = ~Bonjour, <CHARNAME>. Tout va bien ?~
@62060 = ~Éloignez-vous de moi. S'il vous plaît. Je ne veux blesser personne.~
@62061 = ~En fait, je n'aime pas que l'on me menace.~
@62062 = ~Vous semblez plutôt sinistre... quel est le problème ?~
@62063 = ~Vous pensez pouvoir me faire du mal ? Hah !~
@62064 = ~Très bien, je vous laisse.~
@62065 = ~Je ne vous menace pas, messire. J'ai juste tendance à attirer les ennuis, c'est tout. Le genre d'ennuis qu'on préfère éviter, croyez-moi.~ ~Je ne vous menace pas, ma dame. J'ai juste tendance à attirer les ennuis, c'est tout. Le genre d'ennuis qu'on préfère éviter, croyez-moi.~
@62066 = ~J'aimerais pouvoir en parler mais vous ne pourriez pas comprendre. Laissez-moi.~
@62067 = ~Vous seriez surpris. Mais je n'ai pas l'intention de vous faire du mal... des choses se passent autour de moi. On ne m'appelle pas le paratonnerre pour rien.~ ~Vous seriez surprise. Mais je n'ai pas l'intention de vous faire du mal... des choses se passent autour de moi. On ne m'appelle pas le paratonnerre pour rien.~
@62068 = ~Merci. Je veux juste oublier... ce que je suis. Vous ne comprendriez pas.~
@62069 = ~Écoutez, je vous ai dit que je voulais qu'on me laisse tranquille ! Pourquoi ne pouvez-vous... oh... oh NON ! PAS ENCORE !~
@62070 = ~Que... non ! Non ! Un rejeton de Bhaal ? Ici !~ ~Que... non ! Non ! Une rejetonne de Bhaal ? Ici !~
@62071 = ~Calmez-vous... qui êtes-vous ?~
@62072 = ~Comment savez-vous ce que je suis ?! Parlez !~
@62073 = ~Je ne vous veux aucun mal, monsieur...~
@62074 = ~Si vous êtes encore un des ses chasseurs, je vous jure que je vous ouvre le ventre.~
@62075 = ~Non, non ! Pas après tout ce temps ! Je ne... ah... AHHH, PAS ENCORE !~
@62076 = ~Des chasseurs, ici ?! Non !~
@62077 = ~Partez. Partez avant que je ne change d'avis.~
@62078 = ~*ce bassin d'eau salé est un lieu de culte pour les kuo-toas... c'est ici qu'ils font leurs offrandes à Blibdoolpoolp, la mère des océans*~
@62079 = ~Récupérer les œufs du dragon d'argent

J'ai attaqué Adalon, la femelle dragon d'argent, et je dois maintenant trouver un autre moyen de sortir d'Ombre-Terre.~
@62080 = ~Quoi ? Comment... ? Pas grave, après tout ! Le piège marchera quand même... pour Mae'Var !~
@62081 = ~*le quartier-maître vous attend à la guilde pour récolter le dû de Renal*~
@62082 = ~*Renal ne veut plus attendre que vous lui payiez son dû... il vous retire les rênes de la guilde*~
@62083 = ~*vos voleurs sont revenus de leurs missions*~
@62084 = ~Ainsi meurt l'idiot...~
@62085 = ~~
@62086 = ~Aube~
@62087 = ~Crépuscule~
@62088 = ~Black Isle~
@62089 = ~Bioware~
@62090 = ~Mort(e)~
@62091 = ~Fin~
@62092 = ~Asile~
@62093 = ~Ombre-Terre~
@62094 = ~Suldanessalar~
@62095 = ~Les Enfers~
@62096 = ~Infinity Engine~
@62097 = ~Introduction~
@62098 = ~Repos en extérieur~
@62099 = ~Repos en intérieur~
@62100 = ~Repos à l'auberge~
@62101 = ~Sondal~
@62102 = ~Sondal~
@62103 = ~Kurt l'Infâme~
@62104 = ~Kurt l'Infâme~
@62105 = ~Gros Canon~
@62106 = ~Gros Canon~
@62107 = ~Nous voici dans la maison de mon père... vous n'allez tout de même pas m'abandonner maintenant !~
@62108 = ~Je crains que si. Je n'ai pas de temps pour cela.~
@62109 = ~Je suppose que non.~
@62110 = ~Alors partez. Et ne revenez pas.~
@62111 = ~Voici la récompense pour ce que vous avez fait.~
@62112 = ~Disparaît de ma vue, sale chien. C'est votre vile conduite qui m'a amené à tout ceci. J'ai échoué dans mon épreuve, à cause de vous. Je n'ai plus rien à faire avec vous.~ ~Disparaît de ma vue, sale chienne. C'est votre vile conduite qui m'a amené à tout ceci. J'ai échoué dans mon épreuve, à cause de vous. Je n'ai plus rien à faire avec vous.~
@62113 = ~J'ai réussi mon épreuve, <CHARNAME>. Jamais je n'ai été aussi heureux ! Bien que vous m'ayez abandonné... je suis disposé à me joindre à vous si vous voulez bien de moi !~
@62114 = ~Peut-être une autre fois, Anomen.~
@62115 = ~Certainement... Je serais heureux de vous avoir à mes côtés.~ ~Certainement... Je serais heureuse de vous avoir à mes côtés.~
@62116 = ~Comme vous le souhaitez. Je serai là si vous changez d'avis.~
@62117 = ~Qu'il en soit ainsi ! Si je dois aller à la Grande-Maison du Cœur radieux, je le ferai sans l'aide de personne ! Je ne vous dis pas merci <CHARNAME>. J'aurais aimé avoir votre aide, mais il semble que je doive m'en passer !~
@62118 = ~Docteur Hawkins~
@62119 = ~Docteur Hawkins~
@62120 = ~Arny Max~
@62121 = ~Arny Max~
@62122 = ~Cocktail Molotov~
@62123 = ~Cocktail Molotov~
@62124 = ~Sort MDK2~
@62125 = ~~
@62126 = ~~
@62127 = ~Sort MDK2~
@62128 = ~On dirait que ce parchemin est sorti d'un appentis bleu surmonté d'une lumière. Il semble qu'il s'agisse d'un sort d'invocation.~
@62129 = ~Mon... mon fils est mort. Vous... vous ! C'EST VOTRE FAUTE ! LA VÔTRE !~
@62130 = ~Hors de ma vue, manant. Nous n'avons rien à nous dire.~ ~Hors de ma vue, manante. Nous n'avons rien à nous dire.~
@62131 = ~Retirez-vous, Anomen. Je n'ai plus rien à vous dire.~
@62132 = ~C'est... c'est bon de vous revoir, <CHARNAME>. J'ai réussi mon épreuve et je suis désormais un vrai chevalier de l'ordre, malgré toutes mes inquiétudes. Je serais honoré de voyager de nouveau avec vous... si vous voulez de moi.~
@62133 = ~Peut-être une autre fois, Anomen.~
@62134 = ~Certainement... Je serais heureux de vous avoir à mes côtés.~ ~Certainement... Je serais heureuse de vous avoir à mes côtés.~
@62135 = ~<CHARNAME>... L'ordre m'a refusé ! Il m'a rejeté ! IL M'A REJETÉ ! Et tout ça pour avoir tué ce meurtrier, Saerk ! Je ne peux... S'il vous plaît... emmenez moi loin d'ici !~
@62136 = ~Comme vous voulez... joignez-vous de nouveau à moi, Anomen.~
@62137 = ~Oubliez ça. Je n'ai pas de place pour vous.~
@62138 = ~Vous n'avez pas... ? Je vois. Bon, je suis rejeté à la fois par vous et par l'ordre. J'ai travaillé comme un esclave pendant tant d'années. Qu'il en soit ainsi ! Allez tous aux Neuf Enfers.~
@62139 = ~Vous devez être Haer'Dalis.~
@62140 = ~Vous devez être Edwin.~
@62141 = ~Vous devez être Viconia.~
@62142 = ~Vous devez être le joueur ! Yay !~
@62143 = ~Vous êtes quelqu'un d'autre.~
@62144 = ~Sortie~
@62145 = ~~
@62146 = ~Magie~
@62147 = ~~
@62148 = ~Une note toute simple rédigée dans une écriture délicate :

Berinvar,

Ne vous inquiétez pas à propos du voleur. S'il a des complices, ils se montreront bientôt. Quant au voleur lui-même... Les harpistes fantômes ne le libéreront de sa malédiction que lorsqu'ils penseront qu'il a retenu la leçon. Et dans le cas contraire, nous pouvons toujours espérer qu'il prenne goût aux graines pour oiseaux, n'est-ce pas ?

Amitiés,

T.~
@62149 = ~Je ne peux te parler pour le moment, <PRO_LADYLORD>.~
@62150 = ~Statue d'Amaunator~
@62151 = ~Un tel défi n'est désormais plus nécessaire. Je suis le Grand Druide et le bosquet est maintenant un lieu de paix.~ ~Un tel défi n'est désormais plus nécessaire. Je suis la Grande Druidesse et le bosquet est maintenant un lieu de paix.~
@62152 = ~Gloire et honneur au Grand Druide ! La nature a choisi son champion !~ ~Gloire et honneur à la Grande Druidesse ! La nature a choisi sa championne !~
@62153 = ~Aaaarrrrr !~ [PPBHAA09]
@62154 = ~Oooh ! Oooooh ! AAAAARRRRHHHhhhh...~ [PPBHAA10]
@62155 = ~L'épreuve est achevée.~
@62156 = ~Évasion de l'asile

Je dois trouver la « Main du créateur » pour avancer. Je ne vois pas ce que cela peut signifier.~
@62157 = ~Évasion de l'asile

Je dois également trouver le « Focus de pouvoir » pour avancer. Je ne vois pas ce que cela peut signifier. Peut-être une sorte d'appareillage magique, ou un cristal.~
@62158 = ~Vous devez attendre que la conversation soit terminée.~
@62159 = ~Mais j'ai la preuve de la traîtrise de Mae'Var !~
@62160 = ~Certes, mais j'avais besoin de cette preuve AVANT sa mort ! J'entends déjà des rumeurs comme quoi ces preuves sont fabriquées de toutes pièces !~
@62161 = ~Je ne vais rien changer, c'est inutile.~
@62162 = ~Je vous ferai mon rapport sur leur travail dans cinq jours.~
@62163 = ~Alors, laisse-les ainsi.~
@62164 = ~Ne restez pas ici ! Descendez donc voir s'il en reste !~
@62165 = ~Arrêtez-les ! Tuez-les ! C'est pour ça que vous êtes ici, non ?~
@62166 = ~Mais pourquoi vous acharnez-vous à vouloir me faire perdre mon temps ?~
@62167 = ~Ce n'est pas si simple. J'ai de nouvelles informations : ce domaine que vous revendiquez ne semble pas être le vôtre.~
@62168 = ~Subissez la colère de Beshaba !~
