@60030 = ~Il y a tant à faire. Trêve de bavardages.~ [TERMIN01]
@60031 = ~La théorie vous échappe, passons à la pratique. Si la raison ne suffit pas, peut-être les coups y arriveront-ils ?~ [TERMIN03]
@60032 = ~Eh !~ [TERMIN04]
@60033 = ~Eeehhhrrr ! Ahhhh...~ [TERMIN05]
