@59978 = ~La beauté du monde renaît à chaque aurore, et la route s'éclaire alors.~ [THADDI01]
@59979 = ~Tu ne verras pas la prochaine aube !~ [THADDI03]
@59980 = ~Ouh !~ [THADDI04]
@59981 = ~Aaah, aahhhh...~ [THADDI05]
