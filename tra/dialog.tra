@59963 = ~Ne trahis jamais notre confiance. Telle est la volonté du justicier.~ [OISIGX01]
@59964 = ~Le devoir exige que justice soit faite !~ [OISIGX03]
@59965 = ~Aaaaaaah !~ [OISIGX04]
@59966 = ~Ooh, oooooohhhh, ahhh...~ [OISIGX05]
