@13732 = ~Quoi ?! Je crois que j'ai de la visite. Moi Krotan le Roc. Je vous en prie, entrez.~
@13733 = ~~
@13734 = ~TUEZ-LES ! TUEZ-LES ET NOUS EMPOCHONS LES GAINS !~
@13735 = ~~
@13736 = ~C'est ici que vous mourrez !~
@13737 = ~Que personne ne se mette sur le chemin de Krotan !~
@13738 = ~Vous tomberez sous mes yeux !~
@13739 = ~~
@13740 = ~~
@13741 = ~Par ici, cher monsieur ! Par ici !~
@13742 = ~Je ne veux que la paix ! Laissez-nous tranquilles !~
@13743 = ~--NOTEXT--~
@13744 = ~~
@13745 = ~Essayez de faire le moins de grabuge possible.~
@13746 = ~Je m'excuse, mais j'ai des méditations qui m'attendent.~
@13747 = ~Devant... beaucoup... il faut les arrêter...~
@13748 = ~Prenez ça... au cas où...~
@13749 = ~~
@13750 = ~~
@13751 = ~Ahhh ! Je LA vois dans tous les miroirs ! J'entends SA voix dans chaque souffle ! Je m'écorcherais bien moi-même pour me défaire de SON enveloppe ! Je ne suis pas ELLE ! Tue-moi, tue-moi encore, je ne suis pas ELLE ! Mais je me déferai de toi !~
@13752 = ~Ouais, j'ai entendu dire qu'un sorcier est devenu fou en ville, mitraillant tout de feu magique et de trucs de ce genre. Heureusement que les Cagoulés l'ont enlevé avant qu'il ne fasse de mal à quelqu'un.~
@13753 = ~*dans les profondeurs troubles de cette machine, vous pouvez voir les restes sans vie d'une étrange créature sphérique d'où jaillissent de nombreux pédoncules oculaires... elle semble morte depuis un certain temps*~
@13754 = ~Cette chose étrange~
@13755 = ~C'est bien triste qu'le Gardien Herolde ait disparu. Y paraît qu'on n'a r'trouvé qu'son casque. Ce s'rait pas parce qu'y aurait un prêtre de Heaum dans les parages à rôder, si ?~
@13756 = ~N'allez pas dans les bas quartiers maintenant, je vous préviens... Si vous avez l'air de quelqu'un qui a deux sous en poche, vous serez agressé en moins de deux !~ ~N'allez pas dans les bas quartiers maintenant, je vous préviens... Si vous avez l'air de quelqu'un qui a deux sous en poche, vous serez agressée en moins de deux !~
@13757 = ~Étrangers barbares.~
@13758 = ~~
@13759 = ~Je n'attendais rien de plus de la part de canailles de votre espèce !~
@13760 = ~Que voulez-vous de moi ?~
@13761 = ~Espérons que tout cela finira bientôt.~
@13762 = ~Partez, et faites votre devoir.~
@13763 = ~Votre présence ne me réconforte en aucun cas.~
@13764 = ~~
@13765 = ~~
@13766 = ~Oh, j'ne serai pas d'un grand secours. J'fais qu'rester assis avec ces beautés qu'j'admire.~
@13767 = ~À L'AIIIIDE !~
@13768 = ~~
@13769 = ~Moi être triste, mais l'éclat est réconfortant.~
@13770 = ~J'n'aime pas les discours tristes. J'vais m'asseoir avec mes beautés.~
@13771 = ~Avant j'avais un tas d'joyaux qui montait jusqu'au ciel ! Mais j'sais plus où qu'ils sont.~
@13772 = ~Vous allez retrouver mes amis, pas vrai ?~
@13773 = ~~
@13774 = ~~
@13775 = ~Puis-je vous aider ?~
@13776 = ~Ah ! Mais c'est absurde !~
@13777 = ~C'est absurde ! Nous n'avons pas besoin de nous battre !~
@13778 = ~Monstre ! Ce n'est qu'un enfant ! À l'aide !~
@13779 = ~Je n'ai plus grand-chose à ajouter.~
@13780 = ~Vous connaissez mes histoires. Rien n'a changé depuis notre dernière discussion.~
@13781 = ~Laissez-moi ! Je ne veux personne !~
@13782 = ~~
@13783 = ~~
@13784 = ~Eh là... psitt. Par ici.~
@13785 = ~J'en ai assez !~
@13786 = ~Ma lame vous coupera en morceaux !~
@13787 = ~Ce qui se passe est tout à fait inhabituel par ici, et je ne veux pas y prendre part.~
@13788 = ~J'vous avais dit qu'c'était Eldoth qui avait agi. Je n'sais rien de plus, alors laissez-moi partir.~
@13789 = ~J'me sortirai d'ici. J'n'ai plus rien à y faire maintenant.~
@13790 = ~Que les dieux vous gardent si vous réussissez. Moi, je m'en vais !~
@13791 = ~~
@13792 = ~~
@13793 = ~Allons ! Tous les gardes ne s'indignent pas de votre arrivée comme le fait Eldoth.~
@13794 = ~La bataille est perdue ! Je dois m'enfuir !~
@13795 = ~J'aperçois un ennemi ! C'est le moment !~
@13796 = ~J'en ai déjà trop dit. Je dois partir.~
@13797 = ~J'ai dit ce que j'avais à dire. Le reste est votre affaire.~
@13798 = ~Je ne peux plus rien pour vous, ou ce serait de la trahison.~
@13799 = ~Je vous souhaite bon courage pour votre mission. Que Tyr guide votre lame.~
@13800 = ~~
@13801 = ~~
@13802 = ~Par Ilmater, s'il vous plaît, renvoyez-le chez lui.~ [DWARF03]
@13803 = ~C'en est trop ! Je n'en peux plus !~
@13804 = ~Créatures dégoûtantes ! Vous ne ferez plus de mal à personne !~
@13805 = ~Moi ? Je nous guiderai comme il faut.~
@13806 = ~Que puis-je faire pour vous ?~
@13807 = ~Que dois-je faire ?~
@13808 = ~Il vous suffit d'indiquer le chemin.~
@13809 = ~Qu'Ilmater nous protège.~
@13810 = ~Certainement.~
@13811 = ~Je ferai de mon mieux.~
@13812 = ~Ce corps... on dirait... non... NON !~
@13813 = ~Mon cher Montgomery. Mon tendre Montgomery.~
@13814 = ~Eh bien, il... il n'y a pas grand-chose que je puisse faire ici. En avant...~
@13815 = ~C'est vous qui êtes à l'origine de tout cela ?! Dans ce cas, vous allez MOURIR ! MOURIR ET POURRIR !~
@13816 = ~Comment avez-vous pu détruire cette beauté ! Je jure que VOUS... ALLEZ... MOURIR !~
@13817 = ~~
@13818 = ~~
@13819 = ~Non ! Combien de morts faudra-t-il encore ?!~
@13820 = ~Que les Neuf Enfers vous poursuivent.~
@13821 = ~Ah ! Le Conseil a instauré un nouvel impôt pour nous les pauvres ! Ils ne me feront jamais croire qu'ils en avaient vraiment besoin !~
@13822 = ~Le bruissement des feuilles agite mon cœur d'une douce mélancolie. Peut-il y avoir plus belle chose au monde que la nature à l'état sauvage ?~ [CERND83]
@13823 = ~Mon cousin vient d'arriver de Nashkel pour faire la connaissance de ma femme, et qu'est-ce qui lui arrive, hein ? Il se fait agresser dans ces maudits bas quartiers, m'ouais ! La garnison devrait monter une expédition là-bas et brûler tout ça vite fait bien fait !~
