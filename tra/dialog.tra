@73179 = ~Tu vas souffrir par mes poings !~ [1AMONK03]
@73180 = ~Oooh !~ [1AMONK04]
@73181 = ~Aaaaaaahhhh...~ [1AMONK05]
@73182 = ~Il n'y a pas de honte à battre en retraite !~ [1AMONK06]
