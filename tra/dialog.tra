@48454 = ~Domaine Lurraxol~
@48455 = ~Entrée du bosquet des druides~
@48456 = ~Entrée du cottage d'Adratha~
@48457 = ~Entrée du tertre des trolls~
@48458 = ~Autel~
@48459 = ~Autel~
@48460 = ~Tr-très bien ! Merci encore, seigneur ! Je suis sûr que la Dame de la Joie vous sourira !~ ~Tr-très bien ! Merci encore, madame ! Je suis sûr que la Dame de la Joie vous sourira !~
@48461 = ~Très beau geste de votre part, <CHARNAME>. Un homme de moindre bien aurait laissé là ces enfants, à errer dans les rues, affamés et sans le sou.~ ~Très beau geste de votre part, <CHARNAME>. Une femme de moindre bien aurait laissé là ces enfants, à errer dans les rues, affamés et sans le sou.~
@48462 = ~*soupire* Malheureusement, je connais bien cette ville, et la fille se fera détrousser avant la nuit. Dans quel monde vivons-nous...~
@48463 = ~Bah ! Ce serait gâcher notre or de le donner à la fille ! À quoi bon courir l'aventure si tu donnes tout à la veuve et à l'orphelin ?~
@48464 = ~Ne t'emballe pas, fillette. Elle ne profitera pas de cet or. On risque surtout de retrouver son cadavre proprement détroussé, un peu plus tard.~
@48465 = ~Oui, ça c'est vrai, beauté ! Et si tu étais plus petite et barbue, je te montrerais comment j'ai acquis ma réputation parmi les femmes de mon clan !~
@48466 = ~Tu n'as donc aucun sens de la charité, nain ? À quoi bon libérer ces enfants pour les plonger ensuite dans la pauvreté et la misère ?~ ~Tu n'as donc aucun sens de la charité, naine ? À quoi bon libérer ces enfants pour les plonger ensuite dans la pauvreté et la misère ?~
@48467 = ~Comme c'est indigne ! Nous avons bien assez d'or pour leur donner l'aumône... ces quelques pièces représentent tant pour eux, et votre part n'en sera pas diminuée !~
@48468 = ~Vous n'êtes qu'une bête puante, Korgan !~
@48469 = ~Vous... vous êtes un odieux personnage, Korgan ! Je ne parviens pas à croire que vous puissiez proférer des horreurs pareilles !~
@48470 = ~Ils... ils voudraient amener les enfants ici pour qu'ils se fassent assaillir par ces créatures ? Co... comment est-ce possible ? Pourquoi ?!~
@48471 = ~Il ne faut pas trop y penser, Aerie. Certains endroits du monde sont horribles, et les chemins qui y mènent sont bien souvent les plus courts.~
@48472 = ~Oui, jeune fille. C'est un très grave sujet de réflexion. Mais n'avons-nous pas fait notre part quand nous avons mis fin à cette vile tyrannie ? Raccrochez-vous à cette pensée, si vous le pouvez.~
@48473 = ~Un peu de maturité, fillette ! Devons-nous subir ces miaulements à chaque fois ? (Hmmm, je me demande comment elle sera dans vingt ans. Peut-être qu'avec mon aide...)~
@48474 = ~Un tel esclavage est autorisé depuis des années dans cette ville et cela me rend malade. C'est une bonne chose qu'il y ait des héros comme nous, n'est-ce pas ?~
@48475 = ~Vraiment, <CHARNAME>, tu n'aurais pas pu garder un peu d'or pour l'enfant ? Tu ne les as sauvés que pour les replonger dans la famine, et pire...~
@48476 = ~*un bruit sourd signale l'ouverture d'une porte massive*~
@48477 = ~Tu vas demander des bonnes actions à <CHARNAME> maintenant, druide ? Parfois je me demande si la notion de vertu t'est familière. Tu me rends malade, demi-elfe !~
@48478 = ~Tremblez, mortels, car vous avez troublé mon repos.~
@48479 = ~Quoi ? Donner notre or durement gagné à une orpheline qui se fera détrousser avant la nuit ? Tu es stupide, druide.~
@48480 = ~Et on se demande combien de temps tu as pu dissimuler ton arrogance et ton dédain derrière un semblant d'honneur, Anomen. Heaum désapprouverait, je pense.~
@48481 = ~Je ne te crains pas, chevalier ! Dès que tu souhaiteras m'affronter sur le champ de bataille, je serai là !~
@48482 = ~Ne te moque ni de moi, ni de ma foi, femme ! J'ai tué plus d'un infidèle par le passé et je n'aimerais pas en ajouter un à ma liste !~
@48483 = ~*la main de la créature empalée se détache sous votre prise*~
@48484 = ~Lève-toi et parle, que je puisse entendre tes mensonges ! C'est cette Bodhi qui t'envoie, n'est-ce pas ? As-tu mission de me tuer, ou es-tu aussi damné que moi ?~ ~Lève-toi et parle, que je puisse entendre tes mensonges ! C'est cette Bodhi qui t'envoie, n'est-ce pas ? As-tu mission de me tuer, ou es-tu aussi damnée que moi ?~
@48485 = ~Je ne suis pas surprise qu'un nain immoral de ta sorte ait un cœur de pierre, Korgan. Je m'attends à mieux de la part de <CHARNAME>.~
@48486 = ~Fermez-la, vous deux !~
@48487 = ~Va au diable, Jaheira ! J'ai sauvé tout le monde, non ?~
@48488 = ~Tu as peut-être raison. Je vais réfléchir à tes paroles.~
@48489 = ~Sortons d'ici.~
@48490 = ~Hein ? On ne ferait que se chamailler, <CHARNAME>. Pas besoin de te compliquer la vie.~
@48491 = ~Tu l'as fait, <CHARNAME>, mais de telles actions entraînent aussi des responsabilités. Tu devrais y réfléchir à l'avenir.~
@48492 = ~Tu vas rester pendu à chaque mot de cette demi-elfe croqueuse de plantes vertes ? Bah ! Tu n'es qu'un kobold à foie jaune.~ ~Tu vas rester pendue à chaque mot de cette demi-elfe croqueuse de plantes vertes ? Bah ! Tu n'es qu'une kobold à foie jaune.~
@48493 = ~Courtisane~
@48494 = ~Assez, Korgan. Ferme-la.~
@48495 = ~Hé... tu es vraiment drôle, Korgan.~
@48496 = ~Ignore-le.~
@48497 = ~Ignore-le.~
@48498 = ~Silence ! Continuons.~
@48499 = ~Ah, ce n'est qu'une petite plaisanterie, <CHARNAME>. Inutile de te mettre martel en tête.~
@48500 = ~Ah bon ? Je n'en ai peut-être pas l'air, mais dans mon clan, les femelles se jettent à mes pieds ! Har !~
@48501 = ~T... très bien, <CHARNAME>, mais je ne sais pas combien de temps je pourrai supporter la présence de cette... de cette brute !~
@48502 = ~Parlez pour vous, <CHARNAME>. Il ne passe pas son temps à vous reluquer l'arrière-train.~
@48503 = ~Quoi ? Je suis innocent, je le jure ! Har ! Har !~
@48504 = ~Comment ? N'ont-ils pas honte d'ainsi faire commerce de la vie des autres ? Vilains, je vous présente ma fidèle épée ! Épée : JE TE PRÉSENTE LE MAL !~
@48505 = ~Ils... ils avouent être des esclavagistes ? C'est révoltant ! Nous allons tous vous anéantir, espèces de monstres !~
@48506 = ~Bah ! Même moi, je ne vendrais pas des femmes et des enfants comme du vulgaire bétail ! Il faut leur planter une hache dans le crâne, <CHARNAME> !~
@48507 = ~C'est un cercueil.~
@48508 = ~Tues-moi donc s'il le faut, impétueux jeune homme, mais la lame n'en sera pas plus vite entre tes mains cupides pour autant !~
@48509 = ~Assez ! S'il y a un trésor à prendre, tu devrais nous l'donner sans nous bassiner avec tes sornettes et tes stupides énigmes, de peur qu'ma hache ne trouve ta langue !~
@48510 = ~Les énigmes usent notre patience, rat d'égout ! Si tu sais quelque chose au sujet d'une lame spéciale, dis-le sans attendre !~
@48511 = ~Vos viles manières me dégoûtent. Je serais dorénavant vigilant à votre place.~ [KELDORA7] ~Vos viles manières me dégoûtent. Je serais dorénavant vigilante à votre place.~ [KELDORA7]
@48512 = ~Comme c'est triste d'avoir été maintenu prisonnier dans un tel état. Et par quoi ? La présence dans l'épée ? Ça n'a aucun sens.~
@48513 = ~Au... au moins, il est libre, à présent. Oh, le pauvre homme.~
@48514 = ~Le voici libre à présent. Je me demande combien de temps il a passé dans ces... égouts. Quelle horrible expérience !~
@48515 = ~C'est apparemment une énigme. Nous devons trouver les quatre choses dont il est question pour élucider le mystère caché ici. Qui cacherait quelque chose de cette manière, je me demande ?~
@48516 = ~Ah, oui, le vieux tour de la boîte secrète. Ma Jansen cachait les clefs du garde-manger de la sorte, bien que cela ne nous ait jamais arrêtés. « Jan », me disait-elle toujours, « un de ces jours, tu finiras par manger un ris de veau de trop ! ». Ça ne m'est jamais arrivé, bien que c'est ce qu'avait fait mon cousin Arfie le jour où il a explosé. Triste histoire.~
@48517 = ~Nous devrions peut-être aller voir ce Quallo pour qu'il nous éclaire sur cette énigme. Quelqu'un s'est donné beaucoup de mal pour mettre quelque chose en sécurité ici, et j'ai les moustaches qui me démangent à l'idée de découvrir de quoi il s'agit !~
@48518 = ~<CHARNAME>, cette interminable marche à travers la fange et la crasse en vaut-elle vraiment la peine ? Je propose qu'on torture ce Quallo pour obtenir des réponses et qu'on quitte cet endroit puant une bonne fois pour toutes !~
@48519 = ~Étrange. On pourrait aisément penser que vous vous sentez chez vous dans la fange, Viconia.~
@48520 = ~C'est intéressant. J'aurais pensé que tu te sentirais chez toi dans cette fange, Viconia.~
@48521 = ~Ne cherche même pas à te gausser de moi, mâle, si tu tiens à ta langue.~
@48522 = ~Bizarre. J'aurais pensé que tu te sentirais comme à la maison dans la fange, Viconia. Il me semble même avoir vu un de tes cousins, dans le coin.~
@48523 = ~Non, je ne veux pas que tu partes maintenant, Yoshimo.~
@48524 = ~Nous n'avons pas besoin de tes services pour l'instant. Je regrette, Yoshimo.~
@48525 = ~Oh ! Prendre les armes contre des monstres d'une grande malignité ! Je sens déjà mon Bouh frétiller d'excitation !~
@48526 = ~Bien sûr que c'est Bouh. Bouh est toujours heureux d'avoir une opportunité de prouver son héroïsme. Nous allons écraser ces ogres et tous les rôdeurs et les hamsters du monde conteront nos exploits !~
@48527 = ~Es-tu bien sûr que c'est ton rongeur, Minsc ? J'ai déjà ressenti la même excitation, avant qu'une terrible calamité ne s'abatte sur moi. Cela s'est révélé être un cas d'indigestion bénigne. Tu devrais faire examiner ça, tu sais... j'ai dû garder la couche des semaines, à ne manger que des crèmes glacées et du porridge, or nous ne voudrions pas nous transformer en berserker potelé, n'est-ce pas ?~
@48528 = ~Hmm... Es-tu sûr de parler de ton rongeur, Minsc ? Pas d'une crise cardiaque ? Je t'ai vu t'exciter, après tout...~
@48529 = ~Bien... j'ai entendu parler du Seigneur Jierdan, <CHARNAME>, si cela peut t'aider. Il a les moyens de payer. Il n'a pas la réputation d'être le noble le plus sympathique d'Amn, mais qui l'est ?~
@48530 = ~Je crois que ce serait une bonne idée de sortir de la ville et rendre justice à ces créatures maléfiques. La tyrannie doit toujours s'affronter à armes égales.~
@48531 = ~Pfff ! Je te connais, druide. Tout ce que tu veux, c'est retourner à tes chers arbres, c'est tout. Je parie que tu vas décamper dès que tu verras un ogre !~
@48532 = ~Tu peux essayer quand tu veux, demi-elfe...~
@48533 = ~Je... je ne sais pas, Jaheira. Je connais ce Seigneur Jierdan de réputation. On le dit brutal, et cela ne lui ressemble guère de se montrer si bon avec ses gens. Tout cela ne me dit rien qui vaille.~
@48534 = ~J'ai combattu beaucoup d'ogres et de nains dans le passé, et mille autres redoutables créatures du Mal, mais jamais ça. Tu devrais être prudent si tu ne veux pas finir sur la liste.~ ~J'ai combattu beaucoup d'ogres et de nains dans le passé, et mille autres redoutables créatures du Mal, mais jamais ça. Tu devrais être prudente si tu ne veux pas finir sur la liste.~
@48535 = ~On continue comme avant. En route.~
@48536 = ~Si ce foutu noble veut nous récompenser, pourquoi se soucier de ses motivations, fillette ? Finissons-en, <CHARNAME> ! Le sang des ogres attend ma hache !~
@48537 = ~Allons chacun de notre côté.~ ~Allons chacune de notre côté.~
@48538 = ~Assez, femme ! Que les ogres écrasent les faibles ou ces affaires de nobles, il faut quand même annihiler ce Mal ! Infligeons-lui le châtiment qu'il mérite.~
@48539 = ~Ensemble nous tiendrons tête au pire adversaire qui soit, mon ami ! Dragon ! Nous t'attendons de pied ferme ! Je te défierai jusqu'à mon dernier souffle s'il le faut !~
@48540 = ~Tu... tu veux que nous combattions un dragon ? Pauvre débile ! Je ne veux pas courir à une mort certaine ! Si le reptile t'avale tout cru, peu m'importe !~
@48541 = ~Alors... euh... vous voulez que je revienne ?~ [EDWIN91]
@48542 = ~Oui, j'ai besoin de tes talents.~
@48543 = ~Non.~
@48544 = ~Je savais que tu réfléchirais.~
@48545 = ~Bien, reviens me voir quand tu apprécieras ce que je t'offre.~
@48546 = ~Je suis heureux d'être enfin débarrassé de votre engeance !~ [EDWIN92]
@48547 = ~Alors c'est là que tout s'achève, n'est-ce pas ? Il en sera donc ainsi ? (Seul un véritable imbécile ne peut réaliser mon importance.)~ [EDWIN93] ~Alors c'est là que tout s'achève, n'est-ce pas ? Il en sera donc ainsi ? (Seule une véritable imbécile ne peut réaliser mon importance.)~ [EDWIN93]
@48548 = ~Oui, nous n'avons plus besoin de tes services.~
@48549 = ~Non, ne pars pas.~
@48550 = ~Très bien ! Si jamais tu réfléchis (encore faudrait-il en être capable), où veux-tu me revoir, mmmh ?~
@48551 = ~Ah, Gorion m'a dit autrefois qu'avec d'autres Ménestrels, ils avaient porté un coup humiliant à un dragon dans les Cornes des Tempêtes. Je ne savais pas que c'était celui-là.~
@48552 = ~Mais... nous ne pouvons pas laisser les choses se terminer ainsi ! C'est un monstre légendaire... non, nous ne laisserons pas ce manipulateur s'en tirer comme ça ! Trop de gens on souffert de ses caprices !~
@48553 = ~Vous avez peut-être raison, paladin... mais il y aura d'autres moments plus propices pour affronter vos ennemis. En particulier lorsqu'ils sont aussi puissants que cette créature. Nous ne servirons guère votre cause si nous sommes morts.~
@48554 = ~Moi, je préférerais quitter cet endroit en sauvant ma peau. Mais c'est à <CHARNAME> de décider, bien sûr... s'il dit de se battre, alors je ferai de mon mieux.~ ~Moi, je préférerais quitter cet endroit en sauvant ma peau. Mais c'est à <CHARNAME> de décider, bien sûr... si elle dit de se battre, alors je ferai de mon mieux.~
@48555 = ~Fais ce que suggère le dragon, <CHARNAME> ! Il ne sert à rien d'attaquer ce monstre ! Comme dit le proverbe... euh... prudence est mère de sûreté !~
@48556 = ~Pfff ! Que savez-vous de la bravoure, mage ? Vous n'écoutez que votre premier instinct, qui est de faire volte-face et de fuir !~
@48557 = ~Que connais-tu du courage, mage ? Ton corps pâle et fin est la seule chose qui t'importe et nous le savons tous.~
@48558 = ~Ne me parle pas sur ce ton, pauvre fou ! Je ne m'intéresse à nos vies qu'en présence d'une ancienne force que tu ne pourras JAMAIS comprendre ! Bah !~ ~Ne me parle pas sur ce ton, pauvre folle ! Je ne m'intéresse à nos vies qu'en présence d'une ancienne force que tu ne pourras JAMAIS comprendre ! Bah !~
@48559 = ~Je... je serais heureux de charger au nom du bien, <CHARNAME>... mais ce dragon est si... si... Ce ne serait pas couardise que revenir un autre jour avec de plus grandes épées !~
@48560 = ~Oui... je crois que vous avez raison, <CHARNAME>. Ils sont tout ensanglantés, mais je crois que ce sont des membres de mon propre Ordre que nous voyons ici massacrés.~
@48561 = ~Je reconnais l'un d'eux, c'est un chevalier qui rôdait aux confins de la Côte des Épées... son nom était Ajantis. Quelle infamie ce subterfuge nous a fait commettre !~
@48562 = ~Il semble que l'on nous ait tendu un piège pour que nous tuions ces chevaliers !~
@48563 = ~Il semble que l'on nous ait tendu un piège pour que nous tuions ces chevaliers !~
@48564 = ~<CHARNAME>, vous devriez prendre un instant pour réfléchir à ceci. C'est le seul qui puisse attester notre innocence. Je doute que l'Ordre croie à notre histoire sans son soutien.~
@48565 = ~Vous m'avez convaincu, Keldorn. J'écouterai son histoire jusqu'au bout.~
@48566 = ~Si je veux connaître votre opinion, je vous la demanderai.~
@48567 = ~Je ne vous ai jamais vu impoli sans raison, <CHARNAME>, donc je serai bref. L'ordre nous pourchassera sans relâche, et si nous ne trouvons pas une cachette ce sont eux qui nous trouveront.~ ~Je ne vous ai jamais vue impolie sans raison, <CHARNAME>, donc je serai bref. L'ordre nous pourchassera sans relâche, et si nous ne trouvons pas une cachette ce sont eux qui nous trouveront.~
@48568 = ~Je sais ce que je fais, Keldorn.~
@48569 = ~Très bien, j'écouterai ce que cet homme a à raconter.~
@48570 = ~Excusez-moi, mais je n'en crois pas un mot. Auriez-vous perdu l'esprit ?~
@48571 = ~Je ne vous crois pas.~
@48572 = ~Cela suffit ! Je ne peux plus supporter votre compagnie.~
@48573 = ~Je suis sûre que tu as tes raisons, <CHARNAME>, mais ne refuse pas trop vite une offre de salut. Je ne souhaite pas combattre des paladins sans bonnes raisons.~
@48574 = ~J'ai déjà fait l'objet d'une vengeance personnelle, jadis. Si ces chevaliers humains croient que tu as assassiné un des leurs, ils te pourchasseront avec une détermination encore plus forte que si tu étais un elfe noir.~ ~J'ai déjà fait l'objet d'une vengeance personnelle, jadis. Si ces chevaliers humains croient que tu as assassiné un des leurs, ils te pourchasseront avec une détermination encore plus forte que si tu étais une elfe noire.~
@48575 = ~J'espère que tu as un autre plan. J'ai déjà vu l'Ordre à l'œuvre quand on le provoque, et ce n'est pas beau à voir.~
@48576 = ~*vous appuyez sur le levier de toutes vos forces... à l'ouest, vous entendez le craquement bruyant d'une porte qui s'ouvre*~
@48577 = ~Corne de minotaure~
@48578 = ~Corne d'ombre des roches~
@48579 = ~Meurtrier~
@48580 = ~Meurtrier~
@48581 = ~Je me souviens de lui maintenant ! Il est devenu riche et puissant bien trop vite pour être honnête. Que peut-il nous vouloir ?~
@48582 = ~Oui, c'est logique. J'ai déjà entendu ce nom dans des endroits peu fréquentables. Ce Jierdan semble être un cas spécial.~
@48583 = ~N'y a-t-il rien que tu puisses faire pour nous aider, sire ?~
@48584 = ~Tout ce que vous pourrez faire pour nous sera apprécié, Garren Lancevent.~
@48585 = ~<CHARNAME>, nous devons retrouver ce démon qui vole les enfants et déguise les chevaliers en monstres et lui administrer un bon bottage au nom du bien ! Ils doivent tous être vengés !~
@48586 = ~Pour une fois, je suis d'accord avec ce triste rôdeur. Je n'aime pas être manipulé et j'aimerais connaître les raisons du seigneur Jierdan, mais pas question de porter secours.~
@48587 = ~Ce ridicule barbare s'exprime comme un crétin, mais c'est son droit. <CHARNAME>, nous devons rendre visite à cet homme qui nous manipule comme des marionnettes et lui rendre la monnaie de ses insultes.~
@48588 = ~Nous devons retrouver l'enfant de Garren ! Il... il nous a disculpé aux yeux des paladins, c'est vraiment le moins que l'on puisse faire ! Nous devons essayer !~
@48589 = ~Ah, oui, partir à la rescousse de la pauvre victime enlevée pour redorer sa réputation ! Cela me rappelle une histoire que tante Bertha m'avait contée... quoique là, c'était sa recette de la tourte aux navets qui avait été ravie. Mais les navets sont une affaire très sérieuse dans ma contrée natale. Tu aurais dû voir arriver tante Bertha, armée jusqu'aux dents, assaillant tante Binny pour revendiquer sa recette. Le village entier s'est embrasé et cette affaire a failli provoquer une guerre... la pire crise depuis la famine des griffons en 22. Ahhh, nostalgie, quand tu nous tiens...~
@48590 = ~Oui, je vous en sens capable. C'est une question délicate, et je ne peux pas tout dire à chaque âme curieuse. Je dois avoir votre parole pour cette mission.~
@48591 = ~Ne sois pas stupide, <CHARNAME>. Ces mages te tiendront pour responsable, peu importe ce qu'ils veulent ! Nous n'avons pas besoin d'eux, ni de leurs machinations !~
@48592 = ~Exact. Ils veulent ton accord avant de te demander de faire ce qu'ils souhaitent. Les Mages cagoulés ne sont pas dignes de confiance, <CHARNAME>, tu le sais bien.~
@48593 = ~Je ne sais pas... je n'ai encore jamais accepté une prime sans savoir de quoi il s'agissait. Mais les Mages cagoulés savent très bien récompenser, d'après ce que je sais.~
@48594 = ~Pfff ! Si tu y crois, je peux aussi te vendre un pont à Anauroch. Je te dis de ne pas lui faire confiance !~
@48595 = ~Il joue peut-être une douce mélodie, mon corbeau, mais il nous faut encore écouter le cœur. Danserons-nous sur l'air du mage, qu'en penses-tu ? Moi, je suis intrigué.~
@48596 = ~Ça suffit, sorcier ! S'il y a un trésor à prendre, je veux le savoir !~
@48597 = ~Allons-nous nous abaisser à jouer les chasseurs de prime, à présent, <CHARNAME> ? Même si nous ne tuons pas cet homme, le livrer aux Mages cagoulés serait-il une sentence moins cruelle ?~
@48598 = ~L'idée même de faire cela me met mal à l'aise, <CHARNAME>. Je ne l'approuve pas.~
@48599 = ~Tous les meurtriers doivent être punis, je me demande quelle serait la justice des Mages cagoulés. C'est à ne pas négliger.~
@48600 = ~Quoi ?! Vous connaissez le sort que les mages réservent à Valygar et vous parlez quand même ?! Vous êtes tout à fait méprisable, et je ne prendrai aucune part à ceci !~
@48601 = ~Je suis déçu de vous voir adopter une telle conduite, <CHARNAME>. Je suis convaincu que les Mages cagoulés sont les plus coupables dans cette affaire. Je ne peux pas, en mon âme et conscience, rester plus longtemps à vos côtés.~
@48602 = ~Pourquoi... pourquoi feriez-vous cela à Valygar ? C'est un homme d'honneur et vous le trahissez ! Vous... vous n'êtes pas celui que j'imaginais, <CHARNAME>. Je... je ne peux pas rester plus longtemps...~ ~Pourquoi... pourquoi feriez-vous cela à Valygar ? C'est un homme d'honneur et vous le trahissez ! Vous... vous n'êtes pas celle que j'imaginais, <CHARNAME>. Je... je ne peux pas rester plus longtemps...~
@48603 = ~Allez-vous-en, alors. Je doute qu'on se revoie un jour.~
@48604 = ~Je me sens crasseuse, <CHARNAME>. Je n'avais pas idée que voyager en votre compagnie puisse être aussi salissant. Tâchons de nous consacrer à des activités plus... propres à l'avenir, voulez-vous ?~
@48605 = ~Bien, voilà le sorcier qui traîne un cadavre. Ce n'est pas le genre de chose qu'on voit tous les jours, à moins, bien sûr, de vivre avec un nécromancien. Ça m'est arrivé, lorsque je travaillais pour Golodon. Il revenait tous les deux jours à la tour avec un cadavre sur les épaules. Je lui lançais des regards lourds de suspicion et lui demandais où il les avait trouvés, mais il se contentait de hausser les épaules en me répondant vaguement « oh... par-ci, par-là ».~
@48606 = ~Cela m'a pris un moment, mais j'ai fini par conclure que Golodon n'était pas complètement régulier avec moi, au sujet des corps. Depuis, je n'ai jamais fait confiance aux sorciers qui ont plus de bras et de jambes que la nature ne leur en a donnés... à moins, bien sûr, qu'il ne soient polymorphes, mais même dans ce cas-là, il est plus prudent de garder ses distances.~
@48607 = ~Nous en avons enfin terminé avec les Mages cagoulés ! (Mais j'aurais bien aimé voir ce qu'ils voulaient faire avec le rôdeur.)~
@48608 = ~Je n'ai fait que me défendre de ces cupides sorciers qui ne rêvent que de piller les richesses magiques de mon sinistre ancêtre. Tout ce qu'ils ont pu vous raconter n'est que piètre stratagème.~
@48609 = ~Oh... voilà pourquoi ils veulent votre corps. Pour pénétrer dans cette sphère et... et s'emparer de son trésor. Nous... nous ne saurions tolérer cela, <CHARNAME> !~
@48610 = ~Oui, le mystère est enfin résolu. Les Mages cagoulés ne s'arrêteront devant rien pour entrer dans cette sphère. J'approuve leur position, bien sûr.~
@48611 = ~Ho-ho ! Ils veulent utiliser ton sang pour entrer dans la sphère planaire, n'est-ce pas ? Non pas que ça me dérangerait qu'ils l'enlèvent. Elle cache la moitié de la vue de ma maison, telle une bille géante tombée de nulle part. C'est étrange qu'ils n'en aient pas fait mention, mais tous les sorciers que j'ai connus avaient un gros problème de mémoire. Golodon oubliait d'enfiler ses culottes au moins une fois par semaine, et Binky, son familier, n'avait de cesse de piquer des crises d'hystérie.~
@48612 = ~Ils... ils veulent vous utiliser pour s'introduire dans le cercle. Je savais qu'il ne fallait pas faire confiance à ces maudits Mages cagoulés ! Mais... nous avons donné notre parole !~
@48613 = ~Cette nouvelle me met encore plus mal à l'aise qu'avant. Je ne peux pas, en toute honnêteté, envisager le meurtre d'un innocent simplement pour favoriser les plans de ces mages.~
@48614 = ~Ces mages vous traquent comme un chien... simplement pour accéder à cette sphère ? Comment se fait-il que personne ne se dresse contre ces monstres ?~
@48615 = ~Cela change tout ! Un frère rôdeur mis en péril par de vils magiciens ! Même mon Bouh se recroqueville à l'idée de ce que nous avons été envoyés accomplir ! <CHARNAME>, cela ne peut être !~
@48616 = ~C'est un rôdeur, <CHARNAME>, et par conséquent un homme d'honneur. Je pense que nous pouvons croire ce qu'il dit. Et je suis de moins en moins sûr que nous devons obéir aux mages.~
@48617 = ~Un rôdeur ne nous mentirait pas, <CHARNAME>... et il doit y avoir une raison pour que les Mages cagoulés pourchassent ainsi cet homme, car je ne le crois pas capable de meurtre.~
@48618 = ~Un frère des bois ! Est-ce là l'homme que les sorciers nous ont envoyés assassiner ? <CHARNAME>, dis-moi que ce n'est pas ça !~
@48619 = ~Je... je ne peux pas vous suivre dans cette voie, <CHARNAME> ! Vous avez beaucoup de bonnes actions à votre crédit, mais ceci je ne peux pas l'admettre. Pardonnez-moi, mais je dois vous quitter...~
@48620 = ~Vous... vous tueriez cet homme ? À la demande de mages bien moins honorables que lui ? De toute évidence, j'avais tort de vous suivre, mais c'est terminé ! Je prends la défense de cet homme !~
@48621 = ~C'est un homme de bien, <CHARNAME>. Je ne peux commettre cet acte en votre nom ni en celui de quiconque.~
@48622 = ~Je vous ai soupçonné de vilenie, <CHARNAME>, et à présent je vois que c'est vrai ! C'est un rôdeur, un homme d'honneur... et je ne vous permettrai pas de le tuer !~ ~Je vous ai soupçonnée de vilenie, <CHARNAME>, et à présent je vois que c'est vrai ! C'est un rôdeur, un homme d'honneur... et je ne vous permettrai pas de le tuer !~
@48623 = ~Tu... tu ne nous écarteras pas du droit chemin, Bouh et moi ! Nous faisons le bien, nous sommes des héros ! Cet homme ment, et je me battrai avec <CHARNAME>, je le dis !~
@48624 = ~Non ! Je ne te permettrai pas d'assassiner un frère des bois ! Tu es devenu mauvais et je ne laisserai pas ceci se produire ! Je ne resterai pas plus longtemps immobile !~ ~Non ! Je ne te permettrai pas d'assassiner un frère des bois ! Tu es devenu mauvaise et je ne laisserai pas ceci se produire ! Je ne resterai pas plus longtemps immobile !~
@48625 = ~Je... je ne peux pas vous laisser faire ça, <CHARNAME> ! Je me refuse à assassiner des honnêtes gens ! Jamais !~
@48626 = ~Cet homme ment comme il respire ! C'est un meurtrier qui dirait n'importe quoi pour éviter la justice ! Je me bats avec <CHARNAME> !~
@48627 = ~Êtes-vous... sûr que c'est juste, <CHARNAME> ? Je... je suppose qu'il pourrait mentir. Je pense que je me battrai avec vous...~ ~Êtes-vous... sûre que c'est juste, <CHARNAME> ? Je... je suppose qu'il pourrait mentir. Je pense que je me battrai avec vous...~
@48628 = ~Mettons-nous en route, dans ce cas. Les Mages cagoulés auront, sans nul doute, vent de mon action... et du fait que vous m'accompagnez... bien assez tôt. Nous devrons être prêts.~
@48629 = ~Tu ne sais pas ce que tu fais, <CHARNAME>. Tu nous dresses contre les Mages cagoulés. Les Mages cagoulés ! Bah !~
@48630 = ~Nous devons rester sur nos gardes avec les Mages cagoulés à nos trousses. Mais c'est une juste cause, et un nouveau compagnon à nos côtés est toujours le bienvenu.~
@48631 = ~Sois le bienvenu, frère des bois ! Ensemble, toi et Bouh et moi allons marcher droit devant nous et écraser le mal sur notre passage ! Malheur à vous, vilains !~
@48632 = ~Il est bon de voir un autre défenseur de la nature dans nos rangs, Valygar. Si les Mages cagoulés cherchent à t'utiliser, je me dresserais contre eux !~
@48633 = ~Oooh, il n'est rien de plus excitant qu'une babiole que l'on ne peut voir. Ne puis-je vraiment pas y jeter un coup d'œil ?~
@48634 = ~Comme je l'ai déjà dit, pas tant que Gaelan ne le voudra pas. Bonne journée.~
@48635 = ~Je ne suis tout de même pas certain que je trouverais vos marchandises à mon goût. Je les soupçonne bien mal acquises.~
@48636 = ~Comme je l'ai déjà dit, tant que Gaelan ne le souhaite pas vous pouvez garder votre avis pour vous.~
@48637 = ~Je ne comprends pas... pour quelle raison ne voudrait-il pas que nous guérissions sa mère ? Il n'aurait plus besoin de mendier dans la rue.~
@48638 = ~Tu ne peux pas être aussi naïve, Nalia. Ils ne t'ont donc rien appris dans ton château ?~
@48639 = ~Je ne me sens pas très bien, moi-même. Je... je voudrais sortir de cet horrible endroit.~
@48640 = ~Êtes-vous sérieuse, Nalia ? Êtes-vous simplement sarcastique ou ne savez-vous vraiment pas de quoi vous parlez ?~
@48641 = ~Tu es aussi naïve que stupide, ma fille. Le mendiant a toujours la bouche pleine d'excuses pour aller se répandre dans la boisson. Même toi tu devrais être capable de t'en rendre compte.~
@48642 = ~Tiens bon, mon garçon. Tu t'y feras, à la fin. La misère est un sujet d'étude intéressant...~
@48643 = ~Ha ! Un menteur démasqué ! Prétexter une mère malade... une telle roublardise me fend le cœur.~
@48644 = ~Réjouis-toi de ta tâche, chétif mâle. C'est une position honorable que tu as là.~
@48645 = ~Et tu as bien raison. C'est du travail de lâche, méprisable jusqu'au bout.~
@48646 = ~Hé ben t'es une sacrée mauviette ! Y en a qui sont naturellement doués pour ça.~
@48647 = ~Clef de la cave des Voleurs de l'ombre~
@48648 = ~Tiens-tu VRAIMENT à donner ton or comme s'il poussait sur les arbres ? Nous allons être assaillis ! (Et puis, il pourrait tout aussi bien ME le donner !)~ ~Tiens-tu VRAIMENT à donner ton or comme s'il poussait sur les arbres ? Nous allons être assaillis ! (Et puis, elle pourrait tout aussi bien ME le donner !)~
@48649 = ~Je n'ai rien pour toi, chien. Tu es bien faible si tu dois moisir ici !~
@48650 = ~Donner ainsi nos richesses aux pauvres est une insulte à la détermination, <CHARNAME>. Ces misérables imbéciles gagneraient davantage à se débrouiller seuls.~
@48651 = ~Pauvres créatures ! <CHARNAME>, je ne pourrai pas en supporter davantage. Faites-moi sortir d'ici.~
@48652 = ~Il va sans dire que tu mérites ton sort bien que cet endroit soit à peine à ta mesure.~
@48653 = ~Hé... je crois bien que tu viens d'être contraint de commettre un acte de charité, <CHARNAME>.~
@48654 = ~Eh bien, c'est plutôt énigmatique. Oh... tu veux dire que tu n'avais de toute façon pas l'intention de donner ton or au mendiant, <CHARNAME> ? C'est étrange... à la façon que tu as eue de présenter ta poche, j'aurais juré que tu allais le faire. Bon.~
@48655 = ~Avez-vous vu cela ?! Le malotru ! Il a pris notre or quand même !~
@48656 = ~Quelle fin interminable... C'est tout l'univers qui s'incarne en elle, même s'il n'y trouve certainement pas un rôle à sa mesure.~
@48657 = ~Vous feriez mieux de prier pour que je ne vous voie jamais à l'œuvre, voleur. Je suis ici par force, mais je ne fermerai pas les yeux.~
@48658 = ~Cette Épée d'argent vorpale irradie une sombre aura quand elle est examinée de près, et la lame est si aiguisée qu'on pourrait couper une tête en un seul coup.

PARAMÈTRES :

Capacités de combat :
- 25 % de chances de décapiter la cible sur le coup (jet de sauvegarde contre la mort à -2 pour annuler)

TAC0 : +3
Dégâts : 1d10 +3 (tranchant)
Facteur de vitesse : 7
Type de compétence : épée à deux mains
Type : arme à deux mains
Nécessite :
 14 en Force

Poids : 15~
@48659 = ~Les toits ! Les murs ne me font pas peur, et je m'en étais contentée jusqu'à présent.~
@48660 = ~Il y a bien deux ou trois choses que je pourrais t'apprendre, si tu voulais, fillette. En guise de dessert, peut-être ?~
@48661 = ~Euh... non merci.~
@48662 = ~Pourquoi continue-t-il à fouetter ces pauvres créatures ? Oh, c'est horrible ! Je ne peux pas regarder ça !~
@48663 = ~<CHARNAME>, je sais que nous n'avons guère le choix, mais pourrions-nous éviter les plus criminels de ces gens ? Autrement les conflits seront inévitables.~
@48664 = ~Cela me rend malade d'assister à pareil spectacle. Cet insensé ne se rend-il pas compte que ces monstres qu'il fouette pourraient le réduire en charpie s'ils le voulaient ?~
@48665 = ~Vous vous trompez lourdement ! Ce n'est que par nécessité que nous sommes partenaires !~
@48666 = ~Je ne participerai pas à ce genre de choses ! Je m'opposerais à vous tous si notre association n'était pas indispensable.~
@48667 = ~Ce marchand est sot d'avoir fait venir de tels monstres, ici, en ville, mais je ne les laisserai pas répandre son sang ! Venez, <CHARNAME>, nous devons les arrêter !~
@48668 = ~Tu te trompes. Je ne porte pas ce nom, et je ne le porterai pas. La grande harmonie exige ma présence ici.~
@48669 = ~Vous vous êtes avéré un être de piètre sens moral. Je suis heureuse de partir.~ [MAZZY95] ~Vous vous êtes avérée une être de piètre sens moral. Je suis heureuse de partir.~ [MAZZY95]
@48670 = ~Oh oh ! On dirait que la roue a tourné pour le marchand, hein ? Il ne sera pas dit que Korgan aura refusé une bonne compagnie !~
@48671 = ~Je respecte votre taille comme j'espère que les autres respectent la mienne, mais je ne prendrai pas ce nom. Notre association est temporaire.~
@48672 = ~Eh bien, je suppose qu'il y a une leçon à en tirer. Tu n'as jamais fouetté un ogre malade ? Jamais ordonné à quelqu'un qui fait deux fois ta taille de ramasser quelque chose au sol ? Jamais mené quelqu'un par le bout du nez sans avoir la certitude de courir plus vite ? Ah, ah ! Si tu veux engager des ogres, rends-les malades et profites-en ou ils te tueront. Oui... je pense que cela résume assez bien la situation.~
@48673 = ~*cette statue n'a plus de cornes*~
@48674 = ~Abuser de la charité des autres, c'est une ruse méprisable. C'est d'une bassesse impardonnable.~
@48675 = ~Har har har ! Je crois que ce gros lard de marchand devrait se contenter de prendre des bêtes qui courent moins vite !~
@48676 = ~*une porte a été ouverte*~
@48677 = ~Nul doute que vous y gagniez au change. Vous me dégoûtez. J'en viendrais à regretter que les ogres n'aient pas fini le travail.~
@48678 = ~Estime-toi heureux que nous ayons empêché ces créatures d'achever leur travail. Tu es stupide, marchand ! Tu devrais penser avec ta tête, pas avec ta bourse.~
@48679 = ~Que de tricherie et de tromperie ! Un outrage aux personnes bien-pensantes !~
@48680 = ~Êtes-vous sûr de vouloir que je parte ? Nous avons encore tant de bonnes œuvres à accomplir ici.~ [MAZZY96] ~Êtes-vous sûre de vouloir que je parte ? Nous avons encore tant de bonnes œuvres à accomplir ici.~ [MAZZY96]
@48681 = ~Maudit rivvin ! Tu devrais te prosterner en nous remerciant d'avoir sauvé ta misérable cachette ! Une centaine de coups de ton propre fouet te mettraient sûrement du plomb dans la tête, demeuré !~ ~Maudite rivvin ! Tu devrais te prosterner en nous remerciant d'avoir sauvé ta misérable cachette ! Une centaine de coups de ton propre fouet te mettraient sûrement du plomb dans la tête, demeurée !~
@48682 = ~Je préférerais que vous restiez dans le groupe.~
@48683 = ~Il vaut mieux que nous continuions seuls.~ ~Il vaut mieux que nous continuions seules.~
@48684 = ~Oooh, tu t'prends pas pour d'la merde. Sûr'ment que quand on t'met en rogne tu d'viens tout fou...~
@48685 = ~Je n'ai que faire de ton ton, femme !~
@48686 = ~Pas d'problème. Bye-bye, mon grand.~ ~Pas d'problème. Bye-bye, ma grande.~
@48687 = ~Il vaut mieux que nous continuions seuls.~ ~Il vaut mieux que nous continuions seules.~
@48688 = ~Louable acceptation de ton destin. Je t'y abandonne.~
@48689 = ~*soupire* Je donnerais n'importe quoi pour attraper des poissons rien qu'en claquant dans mes doigts ! Je sais pas ce qui se passe, mais la pêche est extrêmement difficile ces derniers temps.~
@48690 = ~J'aurais aimé rester. Je vous en prie, au moins, vengez mes amis et détruisez le Seigneur des ombres. Je vais rentrer chez moi à Franc-Marché. Adieu et bonne chance.~
@48691 = ~*vous libérez les internes prisonniers avant de vous préparer à affronter Irenicus*~
@48692 = ~Si ton imagination est aussi limitée en ce qui concerne la magie, imbécile, je comprends pourquoi vos notables sont assez stupides pour l'interdire !~
@48693 = ~Je pense que j'aimerai me promener ici quand nous n'aurons plus besoin du démon que nous connaissons.~
@48694 = ~Peut-être les dieux te refusent ils la prospérité à cause de ton blasphème ! Rends-toi dans un temple, roturier, et implore le pardon pour tes paroles viles !~
@48695 = ~Aaaah... Les dieux doivent m'en vouloir, je vous jure ! Je passe mon temps à travailler et je suis de plus en plus pauvre ! Satanés dieux !~
@48696 = ~Je suis heureuse que tu sois de retour. Je n'ai aucun endroit où aller dans cette maudite ville de la surface. Puis-je me joindre à vous à présent ?~ [VICONIB8]
@48697 = ~Je serais très heureux de t'accueillir dans mon groupe.~ ~Je serais très heureuse de t'accueillir dans mon groupe.~
@48698 = ~Pas pour le moment. Tu es en sécurité, ici. Je reviendrai si j'ai besoin de toi.~
@48699 = ~Certes. C'est un lieu funeste qui a besoin de la lumière purificatrice.~
@48700 = ~Je vous ai déjà vu par ici, sale gnome ! Vous et ceux de votre espèce n'êtes bons qu'à boire et raconter des histoires à mon mari pendant toute la nuit alors que sa femme l'attend ! Allez, ouste ! Du balai !~
@48701 = ~Va au diable, elfe noire ! Je ne laisserai pas ta présence me souiller davantage !~
@48702 = ~Qu'il en soit ainsi. Je n'en attendais pas plus.~
@48703 = ~Je ne connais même pas votre mari, m'dame. Quoi que... n'était-ce pas ce nabot qui m'a acheté une caisse de bière de navets, voilà deux semaines ? Si c'est lui, vous le trouverez à deux pâtés de maisons vers l'ouest, chantant « Ramona » avec une voix de baryton enroué et embrassant le pavé toutes les dix secondes... mais je ne vous ai rien dit.~
@48704 = ~Je vous demande pardon ? Je rassemblerais tous les clochards et tous les criminels de la ville si je le pouvais, chère madame. Si seulement les choses pouvait être changées aussi facilement.~
@48705 = ~Et vous, là ! Au lieu de vous pavaner dans votre belle armure, vous feriez mieux de faire la chasse aux voleurs dans notre quartier !~
@48706 = ~Des gens très biens m'ont même raconté qu'on trouve des livres de magie partout. On devrait tous les brûler et bannir ce savoir maléfique une bonne fois pour toute !~
@48707 = ~Hum. Je lisais beaucoup au château. C'est ce qui m'a amenée à la magie. J'ai horreur de laisser perdre un savoir... cela me paraît mal !~
@48708 = ~Oncle Quayle m'a montré des choses si merveilleuses avec la magie, que... que je ne pourrais pas imaginer le monde sans elle. Ce serait si... si ennuyeux.~
@48709 = ~En fait, quand vous réfléchissez bien... Les grands malheurs de ce monde sont tous dus à la magie. Tout irait bien mieux sans ça !~
@48710 = ~Oui, je suis d'accord. La justice n'est pas assez sévère et la mémoire des gens ne dure qu'un moment. Quel dommage.~
@48711 = ~Il n'y a pas de justice en ce bas monde... Si y'en avait une, y'aurait pas de voleurs.~
@48712 = ~Mais il le cherchait, petite-femme ! Il a mis sa petite main dans mes poches, alors j'ai dû la lui couper avec ma hache. Et tu seras gentille de ne plus jamais en parler.~
@48713 = ~Moi ? Non, Bouh ne permettrait jamais une telle chose ! Mon épée n'est destinée qu'à être fermement plantée dans le cœur du mal !~
@48714 = ~Vous ! Je me souviens de vous ! Vous avez massacré mon pauvre cousin Bobby il y a trois semaines ! Au secours !~
@48715 = ~V-vous... Vous êtes monstrueusement grand, même pour une personne de grande taille... Vous n'oseriez tout de même pas vous en prendre à une pauvre petite-femme comme... comme moi, n'est-ce pas ?~
@48716 = ~Bienvenue à toi, fidèle Anomen. J'espère que tout se passe bien au sein de l'Ordre ?~
@48717 = ~Bienvenue à toi... qu-qu'est-ce que cela ? Tu fais entrer une elfe noire dans la maison de la Sentinelle ? Pourquoi diable fais-tu cela ?~
@48718 = ~Ça va, Gardien. Je suis impatient d'être évalué, mais d'ici là je me contente de servir le Garde Suprême. Je me fais un nom avec mes amis aventuriers ici.~
@48719 = ~Shar et ton dieu insomniaque sont souvent en conflit, prêtre, mais ce n'est pas ce que recherche ici. Je vais me tenir à l'écart de tes regards inquiets, évite de trop t'agiter.~
@48720 = ~Bienvenue à toi, Sire Keldorn. Nous sommes honorés d'avoir un serviteur de Torm dans nos murs. Tu es réputé au sein de ton Ordre et Heaum respecte ceux qui ont un tel respect pour le devoir.~
@48721 = ~C'est moi qui suis honoré, Gardien. Heaum tient une place particulière dans le cœur de tous les membres de l'Ordre.~
@48722 = ~Que Heaum veille sur moi, mais je suis certain que j'avais ma bourse il y a encore une minute ! Où a-t-elle bien pu passer ?~
@48723 = ~Hé ! Maintenant que j'y pense, vous ressemblez beaucoup à un elfe mais vous avez quelque chose de bizarre... Vous n'êtes pas du coin, pas vrai ?~
@48724 = ~Hmm... tu veux parler de cette bourse, je pense ? Je l'ai trouvée par terre. Elle résonne richement, tu devrais faire un peu plus, euh... attention.~
@48725 = ~Oui, bige. Je suis éloigné plus que tu ne pourrais l'imaginer d'un homme simple tel que tu te le représentes. Et si mon visage te trouble, c'est qu'il est d'une beauté plus rare que celle des diamants rouges.~
@48726 = ~Hé ! Mais c'est vous le gnome à qui j'ai donné quatorze pièces pour un truc qui marche même pas ! Je veux mon argent, espèce de voleur !~ ~Hé ! Mais c'est vous le gnome à qui j'ai donné quatorze pièces pour un truc qui marche même pas ! Je veux mon argent, espèce de voleuse !~
@48727 = ~Euh... Non...~
@48728 = ~Vous là... Habillé tout en cuir... Vous seriez pas un Corthala ? Je croyais pourtant que vous étiez tous morts et enterrés... Du moins, c'est ce qu'on raconte !~
@48729 = ~Allons, allons. Les avez-vous oints tous les matins comme je vous l'avais dit ?~
@48730 = ~Alors, que ME reprochez-vous ? La repousse des cheveux est un délicat processus, vous savez. Rentrez chez vous et tâchez de les oindre tous les jours, si cela ne fonctionne toujours pas au bout d'une semaine... eh bien, vous serez plus qu'en droit d'obtenir un complet remboursement !~
@48731 = ~*soupire* Non... nous ne sommes pas tous morts, pas encore. Gardez vos réjouissances jusqu'à mon trépas, si vous le voulez bien.~
@48732 = ~Hé, vous, damoiselle ! Je vous ai rencontrée au cirque de Riatavin, non ? Mais... vous aviez...~
@48733 = ~V-vous ! Je me souviens de vous ! Vous êtes le magicien qui... ah...~ ~V-vous ! Je me souviens de vous ! Vous êtes la magicienne qui... ah...~
@48734 = ~Des ailes. C'était il y a bien longtemps. Mais, oui, j'avais des ailes... et vous pouvez cesser de me dévisager ainsi, je vous en prie.~
@48735 = ~Ouiiiii. Si tu tiens à ta peau, tu vas m'oublier très vite. (Zut ! La boule de feu l'a VRAIMENT manqué !)~ ~Ouiiiii. Si tu tiens à ta peau, tu vas m'oublier très vite. (Zut ! La boule de feu l'a VRAIMENT manquée !)~
@48736 = ~Hum... J'aime pas trop cet Ordre du soi-disant Cœur radieux. Pour moi, ce n'est qu'une bande de frimeurs qui se pavanent dans leurs uniformes...~
@48737 = ~Oui, si tu avais besoin de notre aide, petit. Nous protégeons les faibles et faisons justice aux méchants. Souviens-toi de cela.~
@48738 = ~*grogne* Hé ! Toi ! L'argent, TOUT ton argent, et que ça saute !~
@48739 = ~*grogne* Hé ! Toi ! Ton...~
@48740 = ~C'est peu probable, brute ! Vos entrailles auront souillé le sol avant que vous n'ayez réussi à voler quelqu'un d'autre !~
@48741 = ~Ma hache est soudain comme du sang d'ogre ! Har har !~
@48742 = ~Hmmmm... Vous êtes un homme fort, à ce que je vois. Alors, trésor ? Que diriez-vous d'un voyage au pays des plaisirs, le long des avenues du quartier ?~ ~Hmmmm... Vous êtes une femme forte, à ce que je vois. Alors, trésor ? Que diriez-vous d'un voyage au pays des plaisirs, le long des avenues du quartier ?~
@48743 = ~Ooooh... On s'est déjà rencontré quelque part, c'est certain... Vous là, qui êtes habillé en cuir. Ne faisiez-vous pas partie des éclaireurs ? Vous avez de si beaux... muscles... J'aimerais beaucoup vous revoir !~
@48744 = ~Est-ce à MOI que tu t'adresses ? Hors de ma vue, sale femme ! Cesse de cracher ton venin ! Hors de ma vue !~
@48745 = ~Assez, gueuse. Inutile de vous fatiguer... je ne suis pas intéressé.~
@48746 = ~Je ne suis pas intéressé par une femme qui s'est donnée à tous les hommes d'Amn et d'ailleurs. Quant à cette prostituée, elle ne me convient pas non plus. Pensez-en ce que vous voulez, Viconia.~
@48747 = ~Elle ne t'intéresse pas ou ce sont les femmes qui ne t'intéressent pas ? Je me demande, rôdeur, si même mes charmes pourraient t'arracher une réponse, au nom de toutes les femmes...~
@48748 = ~Je dois bien avouer que les nains m'ont toujours plu... Si vous me donnez un tout petit peu d'argent, je saurai m'occuper de votre corps...~
@48749 = ~Vous là ! Ne me dites pas que vous refuseriez un peu de bon temps avec moi ! Hum... Qu'en dites-vous ?~
@48750 = ~Ha ! J'aime bien que les filles se battent un peu et me crachent dans l'œil, mais je me souviendrai de toi, beauté.~
@48751 = ~C'est une offre intéressante, ma bonne dame, mais je suis un peu occupé pour l'instant. Plus tard, peut-être, quand je serai seul...~
@48752 = ~Des ennuis hein ? Je vais t'en causer des ennuis, sale voleur !~
@48753 = ~*soupire* Vraiment, <CHARNAME>... ne pourriez-vous pas faire vos achats dans un endroit plus approprié ?~
@48754 = ~Ah ! Il est plaisant de rencontrer un ami dans cette étrange cité. J'ai été absent des planches bien trop longtemps.~
@48755 = ~Non, mon ami. Je n'en ai pas besoin pour l'instant. Mais le moineau reviendra te voir, le moment voulu. Ne t'inquiètes pas... notre marché tient toujours...~
@48756 = ~Eh bien, je... Mais oui, c'est bien vous, Haer'Dalis en personne ! Maintenant que j'y pense, ça fait un moment que je ne vous avais pas vu sur le pont !~ ~Eh bien, je... Mais oui, c'est bien vous, Haer'Dalis en personne ! Maintenant que j'y pense, ça fait un moment que je ne vous avais pas vue sur le pont !~
@48757 = ~Alors... Vous cherchez la même chose que d'habitude, mon ami ?~ ~Alors... Vous cherchez la même chose que d'habitude, mon amie ?~
@48758 = ~Alors, c'est quoi votre accord avec Haer'Dalis ?~
@48759 = ~Ah ça ! C'est entre lui et moi, cher <PRO_LADYLORD>, et je vous prierai à l'avenir de ne plus y faire allusion !~ ~Ah ça ! C'est entre lui et moi, chère <PRO_LADYLORD>, et je vous prierai à l'avenir de ne plus y faire allusion !~
@48760 = ~Est-ce que je m'occupe de tes affaires, bige ? Je suis scandalisé.~
@48761 = ~Euh... vous êtes une femme elfe, n'est-il pas ? Pourquoi froncez-vous toujours les sourcils ?~
@48762 = ~Je... je ne fronce pas toujours les sourcils, je... Oh, va-t'en, petit. Pourquoi les enfants de cette ville sont-ils si agaçants ?~
@48763 = ~MA MÈRE DIT QUE LES ELFES NOIRS DEVRAIENT ÊTRE PENDUS, À MOINS QU'ILS S'APPELLENT DRIZZT !~
@48764 = ~MA MÈRE DIT QUE LES GNOMES SONT ISSUS DE LA SALETÉ !~
@48765 = ~*soupire* Qu'y a-t-il d'autre de nouveau ?~
@48766 = ~Ta mère ne serait-elle pas mariée à oncle Scratchy, par hasard ? Cela ressemble fort à son tempérament...~
@48767 = ~~
@48768 = ~Oh, ah, Elanda. Hum. Eh bien, tu vois, mon rossignol, ce n'est pas du tout ce que tu crois, vraiment...~
@48769 = ~Eh bien, en fait...~
@48770 = ~Comment ? Non, ne dis rien. Tu étais retenu par un magicien, et tu n'as pu ni sortir ni envoyer de message ?~
@48771 = ~C'est assez ! C'en est trop ! Hors de ma vue, misérable !~
@48772 = ~Je n'en crois pas mes yeux... je me souviens de toi, de tes mœurs légères et de tes belles promesses ! Où étais-tu donc ces derniers mois ?~
@48773 = ~*soupire* C'est ainsi que vont les choses. Tu connais le prix, mon petit rossignol.~
@48774 = ~J'ai payé une très grosse somme en or. Dites-moi où je peux trouver Imoen.~
@48775 = ~~
@48776 = ~Hé ! Regarde où tu marches, le nain ! T'as trouvé moyen de renverser ma bière ! Forcément, avec toute cette ferraille, tu vois plus où tu marches !~
@48777 = ~Quelqu'un a laissé entrer un elfe sombre ? Hé, on ne va pas le laisser nous polluer ? Allez, tout le monde... tous sur lui ! Allez !~
@48778 = ~Bon, alors excuse-moi. Je devrais peut-être te découper à la hache, tu t'inquiéteras moins après pour ta précieuse bière, non ?~
@48779 = ~Calme-toi, rivvin. Je ne veux aucun mal à aucun de vous, à moins que vous ne frappiez les premiers, auquel cas, les événements prendraient une tournure trop sanglante à ton goût, je te l'assure.~
@48780 = ~Je pense que je t'ai déjà vu quelque part, mon mignon... tu es un des acteurs, non ? Des Cinq Chopes ?~
@48781 = ~Mmmm, qui est ce grand gaillard ? Quels beaux muscles, et ces cicatrices... dieux, dieux. Vous devez avoir vu bien des... ah ! Qu'est-ce que c'est ? UN RAT ?~
@48782 = ~Ce moineau fut acclamé dans la troupe que vous décrivez, madame... ou tout au moins je le fus. Mais je ne suis ici que de passage, et n'entretiens point de projet d'installation. Excusez-moi.~
@48783 = ~OÙ ÇA ? Où y a-t-il un rat ? Oh, vous avez effrayé Bouh avec votre cri strident. Calme-toi, Bouh. Tu vois ? Nous nous éloignons de la femme bruyante.~
@48784 = ~Restauration~
@48785 = ~Bien le bonjour, ma bonne... Mazzy ! Par les pas furtifs de Brandobaris, cela fait des années que je ne t'avais pas revue !~
@48786 = ~Samuel... Samuel Thunderburp. Meilleur guerrier de Hautval et vaurien notoire. Oh, oui, cela fait longtemps.~
@48787 = ~Alors ? Quoi de neuf, depuis le temps ? Aux dernières nouvelles, j'ai entendu dire que tu t'étais installée avec Patrick et sa bande à... comment déjà ? Franc-Marché ? Que sont devenus les autres ?~
@48788 = ~Patrick est mort, Samuel. Comme les autres. Je serais morte, moi aussi, si je n'avais pas été délivrée par <CHARNAME>, que voici, des griffes d'une créature des plus malfaisantes.~
@48789 = ~Certes. Que le Lévrier Noir veille sur eux. Ils ont été enterrés et honorés, Samuel... pour cela, au moins, je suis soulagée.~
@48790 = ~Patrick est... Oh ! Mazzy ! C'est affreux ! *soupire* Puisse le Lévrier Noir veiller sur eux et les aider à trouver la paix !~
@48791 = ~C'est bien. C'est donc toi que je dois remercier, <CHARNAME>, pour avoir sauvé la vie de ma paladine petite-personne préférée. Tiens, je te fais cadeau de mes vieilles bottes d'aventuriers. Elles te seront plus utiles qu'à moi.~
@48792 = ~Quant à toi, Mazzy, c'est bon de te revoir. Passe donc le bonjour à Thalia à l'occasion... et reviens me voir un de ces jours !~
@48793 = ~D'accord, Samuel. Ce sera pour une autre fois.~
@48794 = ~Ho Ho ! Bien le bonjour, étranger. Ça fait un bail qu'on ne s'était vus !~ ~Ho Ho ! Bien le bonjour, étrangère. Ça fait un bail qu'on ne s'était vus !~
@48795 = ~Je te salue aussi, mon minuscule ami. Oui, j'ai été absent pendant bien longtemps... mais ça n'était pas selon ma volonté, crois-le bien.~
@48796 = ~Eh bien ! Plusieurs personnes ont demandé après toi, sans parler de tous tes amis les acteurs.~
@48797 = ~Des gens me cherchaient ? Vraiment ?~
@48798 = ~On peut dire que tu as été très demandé. Une jolie femme l'autre jour... oh ! J'y pense ! Un grand type a laissé ça pour toi. Il m'a dit de te remercier de sa part.~ ~On peut dire que tu as été très demandée. Une jolie femme l'autre jour... oh ! J'y pense ! Un grand type a laissé ça pour toi. Il m'a dit de te remercier de sa part.~
@48799 = ~Un diamant, hmmm ? Eh bien, le bige a dû apprécier, en effet. Merci à toi, bon Rot du Tonnerre, tu es un modèle de courtoisie et un gentilhomme.~
@48800 = ~Ha ! Et de telles flatteries ne te vaudront pas autre chose qu'une bière à l'œil. Allez ! Continue ta route, grand dadais de mon cœur.~ ~Ha ! Et de telles flatteries ne te vaudront pas autre chose qu'une bière à l'œil. Allez ! Continue ta route, grande bringue de mon cœur.~
@48801 = ~Les moines ne peuvent pas utiliser d'armes à deux mains.~
@48802 = ~Hé ? Yoshimo ? Je croyais que vous étiez mort !~
@48803 = ~Vos caractéristiques ne vous permettent pas d'utiliser cet objet.~
@48804 = ~Oh, ah... excusez-moi, je...~
@48805 = ~Force insuffisante~
@48806 = ~Intelligence insuffisante~
@48807 = ~Constitution insuffisante~
@48808 = ~Sagesse insuffisante~
@48809 = ~Charisme insuffisant~
@48810 = ~Dextérité insuffisante~
@48811 = ~Niveau insuffisant~
@48812 = ~Clones~
@48813 = ~Mort ? Moi ? Je ne sais pas qui est ta source d'informations, mon ami, mais elle est peu recommandable.~ ~Mort ? Moi ? Je ne sais pas qui est ta source d'informations, mon amie, mais elle est peu recommandable.~
@48814 = ~Hmm... une petite minute... on se connaît ?~
@48815 = ~J'y suis. Un agent de Zhentarim, si mes souvenirs sont exacts, mais sans importance. Ignore-le, <CHARNAME>.~
@48816 = ~Euh..., non je ne pense pas. En fait, je dois partir...~
@48817 = ~Nalia ? Est-ce vous ? Nalia de'Arnise ? Mais que faites-vous dans un endroit pareil ?~
@48818 = ~Oui. Et vous êtes toujours ce nobliau arrogant et stupide. Si vous voulez faire du vent, sachez au moins où se trouve votre cul, « Monseigneur ».~
@48819 = ~Qu'est-ce que vous faites ici accoutrée comme une marchande ambulante, ma petite ? Oui, vous là avec vos oreilles, jeune fille... Vous feriez mieux de vous marier et d'avoir de beaux bébés.~
@48820 = ~Ah, je vois que tu as laissé tomber la vente de navets, gnome. Dommage, j'aimais bien tes navets... toujours frais, qu'ils étaient.~
@48821 = ~Avoir des... avoir des bébés ? Je... je commence à croire que ce n'est pas dans les cirques que l'on entend les pires atrocités. Je crois que j'ai ma dose de découvertes pour aujourd'hui.~
@48822 = ~Je suis toujours accablé à l'idée de décevoir un bon client. Tantine Kylie pourrait toutefois te vendre de bons navets Jansen, cela ne fait pas de doute... mais je déteste envoyer mes clients chez quelqu'un d'autre. Ohhh, comme je souhaite que cette aventure en vaille la peine !~
@48823 = ~Mais vous... vous êtes bien la plus jolie petite personne que j'aie jamais vue. Vous venez ici souvent ?~
@48824 = ~Ah, vous êtes jolie comme un cœur, mam'zelle. Me... me feriez-vous l'honneur de m'épouser ?~
@48825 = ~Oh, je vous en prie. Ce n'est pas que je fréquente les tavernes et autres lieux de ce genre, mais ce doit être l'approche la plus maladroite que j'aie jamais eu à subir. Reprenez vos esprits, soudard.~
@48826 = ~En mariage ? Vous devez être saoul ! J'en suis... ravie... un peu. Ah... voilà que vous... vomissez, maintenant. D'ac... d'accord, je me sens beaucoup moins flattée tout à coup.~
@48827 = ~Ahhh, mais c'est notre chère Nalia de'Arnise ! Cela me fait tellement plaisir de vous voir en ville, mon enfant ! Delcia est-elle avec vous ? J'aimerais TELLEMENT lui parler !~
@48828 = ~Seigneur Keldorn, c'est bien vous ? Quel plaisir de vous revoir ! Comment vont vos deux adorables filles ? Bien, j'espère ?~
@48829 = ~Au dire de tatie, vous auriez délibérément versé du thé sur sa robe lors de votre dernière rencontre, aussi me paraît-il assez insultant que vous vous intéressiez à elle maintenant. Veuillez m'excuser.~
@48830 = ~Ils vont bien, mais hélas je crains de ne pas les voir assez. Le devoir m'appelle, comme toujours, ma dame.~ ~Elles vont bien, mais hélas je crains de ne pas les voir assez. Le devoir m'appelle, comme toujours, ma dame.~
@48831 = ~Je me souviens de toi. Valygar, c'est ça ? Tu es l'un des éclaireurs qui sont rentrés des Sélénæ à bord de mon bateau.~
@48832 = ~Corne du pirate~
@48833 = ~Corne du pirate~
@48834 = ~Je suis surpris que vous vous en souveniez. C'était il y a deux ans. Belle, c'est bien ça ? Capitaine Belle ? Je suis ravi de vous revoir.~
@48835 = ~Oui. Je me souviens de tous ceux qui montent à mon bord... surtout les beaux rôdeurs basanés. J'ai toujours besoin de gens costauds sur mon navire, Valygar, si jamais tu te lasses de la terre ferme.~
@48836 = ~C'est une proposition... intéressante, Capitaine. Je tâcherai de m'en souvenir.~
@48837 = ~Wah ! Mazzy Fentan ! Je me souviens de vous !~
@48838 = ~Ouaip. Vous verrez... je serai connu comme le plus grand sorcier petit-homme des environs de Féérune dans les années à venir ! Vous allez voir !~
@48839 = ~Hé, vous ! La grande dame ! Est-ce que vous m'avez regardé de votre hauteur ! Hein ? Ce n'est pas très gentil, vous savez !~
@48840 = ~Ah... Jerry. Je me souviens de vous aussi, et de notre... pénible... rencontre à Scornubel. Cherchez-vous toujours à apprendre la magie ?~
@48841 = ~Mais... mais je suis OBLIGÉE de vous regarder de haut. Vous êtes, euh... plus petit que moi, monsieur. Je, euh... oh, ne faites pas attention.~
@48842 = ~Algor~
@48843 = ~Étrange. J'étais sûr que tout ogre que je rencontrerais ne mériterait rien de plus qu'un coup d'épée dans le ventre... mais celui-ci semble non seulement civilisé, mais aussi relativement intelligent.~
@48844 = ~Ah... oui. Ha. Je crois que vous avez raison.~
@48845 = ~Je ne suis pas sourd. J'avais le même avis sur vous autres humains, mais il semble que vous ne soyez pas si stupides que je le pensais.~
@48846 = ~Circulez. J'attends quelqu'un, et je ne veux pas de problèmes.~
@48847 = ~Par les six enfers ? PFFFAAAAAUGHH ! Je ne veux pas porter ce satané gong, il pue la crotte ! Je te jure que je vais tordre le cou à cette ordure pour cette indignité !~
@48848 = ~Désolé de vous avoir dérangé.~ ~Désolée de vous avoir dérangé.~
@48849 = ~Et si je ne veux pas partir ?~
@48850 = ~Je dois vous parler. Nous avons un ami en commun.~
@48851 = ~Je ne vous ai jamais dit de partir. Allez autre part, c'est tout. Il y a de la place pour tout le monde !~
@48852 = ~*renifle* Ah, même Bouh se contracte devant une telle puanteur. Cet instrument ne risque certes plus de donner une belle musique.~
@48853 = ~Pff... fffuuiii, <CHARNAME>, mettez au moins quelque chose là-dessus ! Arhhh, j'ai suffisamment subi ces effluves fétides lorsque j'étais au cirque ! *tousse*~
@48854 = ~Pas de problème. Bonne journée.~
@48855 = ~Sale esclavagiste !~
@48856 = ~Ça m'étonnerait. Et de qui s'agirait-il ?~
@48857 = ~Désolé, j'ai dû vous confondre avec quelqu'un d'autre.~ ~Désolée, j'ai dû vous confondre avec quelqu'un d'autre.~
@48858 = ~Désolé, j'ai dû vous confondre avec quelqu'un d'autre.~ ~Désolée, j'ai dû vous confondre avec quelqu'un d'autre.~
@48859 = ~Barg, le pirate.~
@48860 = ~Isaéa Roenal. Vous le connaissez certainement.~
@48861 = ~Mais... Je vous connais ! Vous en avez du toupet pour venir vous promener sous mon nez !~
@48862 = ~Vous avez tué le capitaine Haegan ! Vous correspondez à la description ! Vous voulez tuer un autre esclavagiste, c'est ça ? Mais je ne me laisserai pas faire aussi facilement !~
@48863 = ~Barg ? Désolé, mais je ne vous parlerai pas quand même. Dites à ce vieux brigand d'arrêter de m'envoyer des mendiants.~
@48864 = ~Bien. Je m'en vais.~
@48865 = ~Bien. Je m'en vais.~
@48866 = ~Attendez, je connais aussi Isaéa Roenal !~
@48867 = ~Certes, je connais Isaéa Roenal. Suffisamment bien pour savoir qu'il ne parlerait pas de nos petits arrangements à qui que ce soit !~
@48868 = ~Qui êtes-vous ? On essaye de me piéger, hein ? Vous voulez vous faire un esclavagiste, c'est ça ?~
@48869 = ~L'endroit est sûrement encerclé, c'est ça ? Ha ! Je ne me rendrai pas sans combattre !~
@48870 = ~Pardon ? Pourquoi dites-vous ça, mon ami ?~ ~Pardon ? Pourquoi dites-vous ça, mon amie ?~
@48871 = ~Notre ami commun, Isaéa Roenal.~
@48872 = ~Ce n'est pas grave, je m'en vais.~
@48873 = ~Ce n'est pas grave, je m'en vais.~
@48874 = ~Pas question ! Je ne sais pas ce qui se passe ici, mais je crois que vous en savez un peu trop sur moi à mon goût !~
@48875 = ~Andante~
@48876 = ~Andante~
@48877 = ~Tu es fou ? Maintenant, nous devons nous abaisser à jouer... les justiciers ! Mon savoir pourrait être mieux utilisé que pour récupérer les dettes des autres... gratuitement, en plus !~ ~Tu es folle ? Maintenant, nous devons nous abaisser à jouer... les justiciers ! Mon savoir pourrait être mieux utilisé que pour récupérer les dettes des autres... gratuitement, en plus !~
@48878 = ~Dirbish le Noir~
@48879 = ~Il n'y a aucun mal à aider quelqu'un à obtenir justice. Nul doute que ce « Dennis » se croit assez fort pour ignorer la dette qu'il a contractée. Allons, suivons-le.~
@48880 = ~Dirbish le Noir~
@48881 = ~Pourquoi devons-nous sans cesse être impliqués dans les problèmes des autres, <CHARNAME>. N'avons-nous pas mieux à faire ? *soupire* Comme vous voudrez.~
@48882 = ~Hmpf... Je vois où cela nous mène...~
@48883 = ~Peut-être... peut-être pourrions-nous tâcher de le retrouver, <CHARNAME>. Il n'y a aucune raison pour que cet homme soit blessé davantage...~
@48884 = ~Je ne soutiens pas les actions de ce Vittorio, mais je ne peux pas le voir souffrir sans rien faire. Si nous ne cherchons pas ce... ce gong... nous devons empêcher le Capitaine de tirer vengeance.~
@48885 = ~Eh bien... nous pourrions peut-être essayer de trouver cette chose, <CHARNAME>. Combien de temps cela nous prendrait-il ? Je ne veux plus que personne n'ait à souffrir si nous pouvons l'éviter.~
@48886 = ~Redis-moi pourquoi nous faisons cela, <CHARNAME> ? Nous allons descendre arpenter ces égouts puants pour retrouver un homme qui détient quelque chose ? J'en dis que nous n'avons qu'à laisser mourir l'ivrogne.~
@48887 = ~Vous me dégoûtez, maudite elfe noire. Vous méritez la mort, et mieux encore, au fil de mon épée. <CHARNAME> vous permet de rester, mais si vous tenez à la vie, vous garderez le silence !~
@48888 = ~Vous êtes odieuse, Viconia ! Je sais que vous êtes une elfe noire, mais... tâchez de faire preuve d'un minimum de compassion ! Cela... cela ne sera pas long !~
@48889 = ~Tiens donc... le célèbre talent des elfes noirs pour la pitié refait surface. Ignore-la, <CHARNAME>, et finissons-en au plus vite.~
@48890 = ~Ahhh, je vois déjà les bardes chanter nos exploits : Les Aventuriers du Gong Perdu ! La vie d'un ivrogne dépend de l'équilibre tout comme <CHARNAME> et sa bande d'aventuriers luttant pour retrouver un musical trésor au tréfonds des égouts ! Passions et aventures s'ouvrent à nous ! J'en ai les larmes aux yeux. *renifle* Je n'avais pas pris part à une aussi grandiose épopée depuis qu'oncle Gerhardt s'est saoulé à la bière de navets quatre jours durant et a pris oncle Scratchy pour un griffon.~
@48891 = ~Hé, pense à tout ce que je gagnerai en livrant un sale traître comme toi ! Gardes ! Cet homme complote contre vous !~
@48892 = ~Toi, mon seigneur, tu es un vrai druide et un ami de la terre. Tu as gagné la bénédiction du bosquet et je t'offre en remerciement le Bâton de foudre et tonnerre.~ ~Toi, ma dame, tu es une vraie druidesse et une amie de la terre. Tu as gagné la bénédiction du bosquet et je t'offre en remerciement le Bâton de foudre et tonnerre.~
@48893 = ~Pendant que tu réfléchis, imagine aussi ce que je gagnerai en te livrant aux autorités. Garde ! Vous ne faites rien ?~
@48894 = ~Cet engagement est inutile, <CHARNAME>, même pour vous. Finissons-en avec cette affaire, si toutefois vous le voulez bien.~
@48895 = ~~
@48896 = ~Oh, de grâce, parlez doucement ! Je ne puis vous aider, mais je ne veux plus voir de victimes... oh, non, on vous a entendu !~
@48897 = ~Nous ne ferons rien de la sorte, <CHARNAME>. Ce faquin est démasqué, maintenant. Regardez.~
@48898 = ~Repose-toi au milieu du bosquet et l'Esprit viendra t'offrir sa bénédiction. Fais-le lorsque tu seras prêt à accepter le joyeux fardeau offert par l'Esprit. Rappelle-toi de ramasser tout équipement abandonné avant le défi.~ ~Repose-toi au milieu du bosquet et l'Esprit viendra t'offrir sa bénédiction. Fais-le lorsque tu seras prête à accepter le joyeux fardeau offert par l'Esprit. Rappelle-toi de ramasser tout équipement abandonné avant le défi.~
@48899 = ~Le départ de Faldorn nous laisse sans personne pour nous guider. J'espère que tu accepteras de le faire si le bosquet t'en estime digne. Je te remercie encore une fois !~
@48900 = ~Non ! Je ne peux pas rester les bras ballants pendant que ce Vittorio se fait assassiner devant mes yeux pour une simple dette ! Je me dois d'intervenir !~
@48901 = ~Ah, Berinvar, <CHARNAME> n'est pas un Ménestrel, mais je le suis. Traiter mes invités en amis, est-ce une réponse ? Je présume que les gardiens sont des harpistes fantômes ?~ ~Ah, Berinvar, <CHARNAME> n'est pas une Ménestrelle, mais je le suis. Traiter mes invités en amis, est-ce une réponse ? Je présume que les gardiens sont des harpistes fantômes ?~
@48902 = ~Ils... ils attaquent ce drôle de bonhomme ? Pourquoi ? Ce mal doit être arrêté avec une généreuse dose d'escrime ! Viens, Bouh, on vise les yeux !~
@48903 = ~Vous ne pouvez pas rester ainsi à regarder sans intervenir, <CHARNAME> ! Et moi non plus, je ne saurais le permettre !~
@48904 = ~Nilthiri~
@48905 = ~Je regrette, Jaheira, mais ce n'est pas le moment d'en parler.~
@48906 = ~Nilthiri~
@48907 = ~Lui et les autres semblent préoccupés par les colifichets qu'ils portent au cou. Je trouve étrange de ne pas avoir entendu parler de cette habitude des colliers avant aujourd'hui. Les Ménestrels portent rarement des symboles attirant encore davantage l'attention sur eux.~
@48908 = ~Ne soyez pas ridicule. Pour ma part, je ne vais pas déplorer le refus d'objets volés. En d'autres circonstances j'exigerais que tout soit rendu mais... Mais nous servons une plus grande cause, elle passe avant tout.~
@48909 = ~Ouais ! Super ! SACRÉMENT FORMIDABLE ! Ouais, on va attaquer des foutus TROLLS pour avoir ce gong... mais POUR RIEN, s'il vous plaît ! Mois je propose de retourner à la taverne pour lui BOTTER LE CUL !~
@48910 = ~N'y prête pas attention, <CHARNAME>. Elle est toujours un peu bourrue envers les étrangers, j'en suis sûr...~
@48911 = ~Hmm. Récupérer ce gong nous éloigne peut-être un peu de notre chemin, mais contre un troll je suis toujours prêt à engager mon épée. La mort d'un tel monstre est un bien, quelle qu'en soit la raison.~
@48912 = ~*glousse* L'affaire se corse, mon corbeau ! Qu'en penses-tu ? Crois-tu que cet insaisissable gong n'est plus en possession de ce chaman ? Je suis curieux de voir ?~
@48913 = ~On va laisser passer une bonne affaire sous prétexte qu'elle n'est pas entre les mains du propriétaire ? On se ramollit, moi j'dis !~
@48914 = ~Loren~
@48915 = ~Loren~
@48916 = ~Chaos~
@48917 = ~Chaos~
@48918 = ~Quelle répugnante créature ! Je vous le dis, <CHARNAME>, être dans cet endroit demande plus de retenue que n'importe quel paladin devrait être obligé de supporter.~
@48919 = ~Oui. Cela nous fait de la peine à tous que des hommes de valeur puissent en arriver là... mais les germes de la corruption sommeillent en chacun de nous. Nous devons rester toujours vigilants pour lutter contre.~
@48920 = ~Je le jure, si nous n'étions pas engagés dans une plus grande cause je devrais agir. Je me ferai un devoir de revenir ici seul un jour.~
@48921 = ~Je ne supporte plus. Je m'en retournerai à cet endroit avec une nouvelle troupe une fois que notre association ne sera plus nécessaire.~
@48922 = ~Hmm. Une telle soif de vengeance devrait être condamnée à mon avis. Être un paladin et renoncer à ses vœux est inconcevable.~
@48923 = ~Enfant des bois, je te souhaite la bienvenue. Par tes actions, la terre et le bosquet ont souffert et ont été soulagés.~
@48924 = ~Je ne supporte pas cette personne, <CHARNAME>. Je suggère de partir, sinon je risque d'ignorer la grande harmonie et de le réduire en poussière.~
@48925 = ~Il est triste que même les preux chevaliers de l'Ordre puissent céder aux plus sombres tentations de l'âme. Mais quel est le rapport avec nous, Sire Ryan ?~
@48926 = ~Tu as sans doute exercé autrefois votre métier pour des gens honnêtes. Ton harmonie finira par revenir. Aucun acte ne reste impuni.~
@48927 = ~Hé ! C'est ce que je me dis tout le temps ! Bien vu !~
@48928 = ~Ça, de la justice ? Ses crimes ont peut-être été vils, mais cela... c'est horrible. Allons-nous-en, <CHARNAME>. S'il vous plaît ?~
@48929 = ~Quelle implacable justice. Sa mort était peut-être méritée, mais de cette façon ?~
@48930 = ~Lance de flétrissement +4~
@48931 = ~Qui êtes-vous ? Qu'êtes-vous ?~
@48932 = ~Je suis heureux de rendre service. Vous êtes l'Esprit du bosquet, je suppose ?~ ~Je suis heureuse de rendre service. Vous êtes l'Esprit du bosquet, je suppose ?~
@48933 = ~Je cherche à apporter l'équilibre à tout ce que je trouve.~
@48934 = ~Je suis l'Esprit du bosquet, enfant. Je suis l'eau, la terre, les arbres et le soleil. Je suis la vie et la mort : le cycle éternel.~
@48935 = ~Comment se fait-il que vous puissiez parler ?~
@48936 = ~Que voulez-vous de moi ?~
@48937 = ~Parfait ! C'est une invitation à lancer des sorts sur les paladins, anciens ou non ! (Avec un peu de chance, je pourrai convaincre <CHARNAME> de m'amuser aussi !)~
@48938 = ~Par le ver de l'Avarice ! Grand sera le jour où je planterai ma hache dans l'armure de ces guerriers saints ! En route, je suis impatient de me battre !~
@48939 = ~Vaincus ou non, ces hommes étaient mes camarades. Je déplore la manière dont s'est terminé le chemin de leur vie. Ce ne sera pas une tâche agréable.~
@48940 = ~La voie du druide n'est jamais facile et tes travaux ne font que commencer. Le bosquet te donnera sa bénédiction si tu veux bien accepter le manteau du commandement.~
@48941 = ~Un homme qui sert la cause de l'équilibre est ce qu'il nous faut. Le bosquet a besoin d'un chef à la main de velours. Servirez-vous le bosquet en tant que tel ?~ ~Une femme qui sert la cause de l'équilibre est ce qu'il nous faut. Le bosquet a besoin d'une cheffe à la main de velours. Servirez-vous le bosquet en tant que telle ?~
@48942 = ~Il est temps pour vous d'affronter la justice, Sire Anarg. Je déplore ce que vous êtes devenu... maintenant c'est terminé !~
@48943 = ~Je suis honoré d'avoir été choisi, Esprit. Comment puis-je servir la nature ?~ ~Je suis honorée d'avoir été choisie, Esprit. Comment puis-je servir la nature ?~
@48944 = ~Soumets-toi au jugement des hommes si tu ne veux pas connaître celui de ma lame !~
@48945 = ~J'ai beaucoup de choses à accomplir en-dehors du bosquet. Je ne suis pas sûr d'avoir assez de temps pour vous servir efficacement.~ ~J'ai beaucoup de choses à accomplir en-dehors du bosquet. Je ne suis pas sûre d'avoir assez de temps pour vous servir efficacement.~
@48946 = ~Les héros du bien se passent de mise en garde ! Où que nous passions, le mal tremble à notre approche !~
@48947 = ~Ha ! Si un imbécile riche ou pauvre ose me prendre pour cible, moi ou <CHARNAME>, il finira avec les tripes au soleil, c'est la vérité.~
@48948 = ~Je vous remercie pour cette offre mais je ne peux l'accepter.~
@48949 = ~Cela m'a l'air... effroyable. Je ne pourrais rien imaginer de si affreux ! Comment peut-on vouloir faire une telle chose ?~
@48950 = ~Ceci semble être l'œuvre d'un bien sinistre individu. Nous devrions aller voir cela de plus près, <CHARNAME>. Nous trouverons peut-être un indice qui a échappé aux autres.~
@48951 = ~Le confinement dans la ville affecte gravement la santé mentale de ses habitants, mais je me demande s'il n'y a pas une autre force. Il vaut mieux rester sur nos gardes.~
@48952 = ~<CHARNAME> ! Oh ! Ne pourrait-on lui donner juste UNE pièce ? Humpf !~
@48953 = ~Épargne-nous tes boniments, mendiant. Les faibles ne méritent aucune charité.~
@48954 = ~<CHARNAME> ! Comment pouvez-vous ainsi tourner le dos aux plus infortunés ? Ils ont besoin de nous.~
@48955 = ~Ah, oui... nous avons affronté des monstres, le Poing Enflammé, les sbires de Sarevok... tout ça pour tomber sur un voleur à l'appétit immodéré pour la chair. Excellente conclusion.~
@48956 = ~Ne t'inquiète pas pour nous, lieutenant. D'après ce que j'ai vu, <CHARNAME> et ses alliés savent se protéger de presque tout.~
@48957 = ~Allons-nous récompenser le faible ? Une telle infamie ne serait jamais tolérée, sous mon commandement.~
@48958 = ~Hrrm... ? Qu'est-ce que vous faites dans le coin avec toutes ces épées et ces armures ? Vous allez tuer quelqu'un, hein ?~
@48959 = ~J'aurais plutôt donné une épée. Donnez un poisson à un homme et il mangera une journée, mais apprenez-lui à se battre et il pourra dévorer la moelle charnue du mal !~
@48960 = ~Je ne pense pas que le lieutenant devrait y aller seul. Nous avons la preuve et le coupable, mais nous ne savons rien de ses compétences. Nous allons peut-être au devant de dangers inconnus.~
@48961 = ~Êtes... êtes-vous sûr qu'il est bien prudent de le laisser partir comme ça ? Et si le meurtrier s'en prenait à lui ? Oh, je n'aime pas ça du tout !~ ~Êtes... êtes-vous sûre qu'il est bien prudent de le laisser partir comme ça ? Et si le meurtrier s'en prenait à lui ? Oh, je n'aime pas ça du tout !~
@48962 = ~Je désapprouve la charité. L'homme devrait être formé de façon à pouvoir subvenir à ses besoins.~
@48963 = ~Il part seul confondre le meurtrier, ce tanneur ? C'est courageux... ou c'est de la folie. Je me demande.~
@48964 = ~Vous découvrirez que je suis plus que capable de contrer la furie de votre folle foi, cyriquiste !~
@48965 = ~Oh oh ! Quelle démonstration de pur fanatisme ! Ça me rappelle chez moi, où que soit ce chez moi.~
@48966 = ~Aarrghhh !~
@48967 = ~Son travail ? De quoi parle-t-il ? Vite, <CHARNAME>, nous devons l'arrêter avant qu'il ne puisse s'échapper !~
@48968 = ~Comment ? C'est le maléfique individu qui vole les peaux ? Il doit être arrêté ! Il doit être arrêté ou tous ceux qui ont une peau dormiront dans la peur !~
@48969 = ~Nous répondrons à ton attaque, bien que même Bouh n'y voit aucun sens !~
@48970 = ~Tu manques d'équilibre, mon ami. Je crains que cela ne cause ta perte.~
@48971 = ~Tu n'iras pas loin, meurtrier ! La justice ne saurait tarder à te punir, engeance du Mal !~ ~Tu n'iras pas loin, meurtrière ! La justice ne saurait tarder à te punir, engeance du Mal !~
@48972 = ~Ne tente pas de tels marauds, même pour plaisanter, <CHARNAME> ! Ils ne connaissent d'autre réponse que celle-ci !~
@48973 = ~Folie ! La même obstination que les rashémis, mais en encore plus stupide !~
@48974 = ~Je sais que vous avez dit cela pour éviter la confrontation, mais nous ne devrions pas parler d'une telle allégeance, pas même en plaisantant. Il n'est jamais prudent de tenter les dieux.~
@48975 = ~<CHARNAME>, je vous en prie, ne tentez pas les dieux des ténèbres. Je recherche des faveurs, mais pas à un tel prix pour mon âme.~
@48976 = ~Ce... cet endroit sent la mort à plein nez, <CHARNAME>, et son évidence nous entoure. Mesure tes pas, je crois que nous pénétrons dans l'atelier sacré d'un fou.~
@48977 = ~Ah, oui ! L'atelier du tanneur. Ces entrailles exposées sont du plus bel effet. Je me demande quelle est la nature exacte de son « travail ». C'est sûrement intéressant...~
@48978 = ~Prudence, <CHARNAME>... nous entrons dans la tanière d'une bête des plus féroces. C'est, sans nul doute, dans sa nature de protéger cet endroit à l'aide de pièges... évitons de trop nous empresser !~
@48979 = ~Oh ! Oh... quelle infection ! Baervan nous préserve, c'est i... ici qu'il entrepose toutes ses victimes ? Il n'y a que des cadavres, là-dedans !~
@48980 = ~Heaum, protège-nous... Je sens le Mal ici. Les innocents attendent d'être vengés... mais le Mal est fort ici. Alors soyons prudents, compagnons.~
@48981 = ~Cet endroit est sinistre ! À quoi s'affaire donc cet homme ?! Seraient-ce des... des cadavres ?! Pouah ! Quelle odeur nauséabonde !~
@48982 = ~J'ai tendance à croire que nous trouverons aussi le lieutenant Aegisfield quelque part, <CHARNAME>... j'espère qu'il vit encore.~
@48983 = ~Ce stupide inspecteur qui a pris la fuite... comment s'appelait ce rivvin ? Peu importe. Je suppose que nous retrouverons son inutile carcasse quelque part.~
@48984 = ~Il est probable que nous fassions la sinistre découverte du corps de l'inspecteur ici. J'espère que je me trompe et que l'homme a su échapper à un tel sort.~
@48985 = ~Ah, oui. *soupire* Le corps de ce malheureux inspecteur. Nous devons amener ce corps aux autorités dès que possible. Au siège du gouvernement, dans le quartier du gouvernement, il y aura quelqu'un qui pourra... nous en décharger.~
@48986 = ~Une sinistre découverte en effet, car le lieutenant semblait être un homme honorable. Nous porterons le corps au quartier du gouvernement dès que nous le pourrons.~
@48987 = ~Ah... l'inspecteur. Si tu le souhaites, nous pouvons facilement le livrer à Brega dans le bâtiment du gouvernement dans le quartier du gouvernement. Je ne vois pas d'autre endroit où l'emmener.~
@48988 = ~Nous... c'est en partie notre faute. C'est nous qui l'avons envoyé ici, <CHARNAME>. Peut-être devrions-nous... disposer de son corps, le rapporter aux autorités, que sais-je.~
@48989 = ~Toujours je parle. Mais je ne souhaite pas toujours me faire entendre. Écoute donc mes paroles, enfant de la nature.~
@48990 = ~Sois béni, enfant ! La nature te sourit vraiment. Il y a beaucoup de travail à accomplir. Écoute et apprends la voie de l'équilibre, la voie du Cycle Éternel.~ ~Sois bénie, enfant ! La nature te sourit vraiment. Il y a beaucoup de travail à accomplir. Écoute et apprends la voie de l'équilibre, la voie du Cycle Éternel.~
@48991 = ~Si tel est ton choix, le bosquet ne te retiendra pas. Repars sur la route et suis les chemins que tu dois. Tu seras toujours le bienvenu ici, même si cela ne doit pas être ta demeure. Adieu.~ ~Si tel est ton choix, le bosquet ne te retiendra pas. Repars sur la route et suis les chemins que tu dois. Tu seras toujours la bienvenue ici, même si cela ne doit pas être ta demeure. Adieu.~
@48992 = ~Les cycles de la nature évoluent lentement, enfant. Tu auras le temps qu'il te faudra pour poursuivre ta quête en-dehors du bosquet.~
@48993 = ~Dans ce cas je suis honoré que le bosquet me trouve digne de cette tâche.~ ~Dans ce cas je suis honorée que le bosquet me trouve digne de cette tâche.~
@48994 = ~Même ainsi, je n'ai pas le temps.~
@48995 = ~La pierre commande, je dois obéir. Cette armure est la récompense de ceux qui ont un esprit sain. Un puzzle. Une énigme. Un don. Ainsi, j'ai bâti ma demeure et j'ai accompli mes devoirs. Vous vous en sortez bien, <CHARNAME>.~
@48996 = ~Aimant~
@48997 = ~Aimant~
@48998 = ~Tête de Neb~
@48999 = ~Tête de Neb~
@49000 = ~Tête de Neb le gnome, un être méprisable s'il en fut.

PARAMÈTRES :

Poids : 2~
@49001 = ~Haha ! Je savais qu'il devait y avoir des renforts ici-bas. Il ne pouvait pas être aussi puissant tout seul, ça non !~ [GENMG06]
@49002 = ~Je vais vous renvoyer ad patres. Nous allons mettre un terme aux plans d'Irenicus et à votre petite guerre des guildes avant la fin de la journée !~
@49003 = ~Guerre des guildes ? De quoi parlez-vous ? Je veux simplement sortir de ce donjon.~
@49004 = ~Qui que vous soyez, ôtez-vous de mon chemin ou je vous tue.~
@49005 = ~Êtes-vous responsables de ma présence ici ? Répondez-moi !~
@49006 = ~Irenicus n'est pas un ami. Je me joins à vous pour le combattre.~
@49007 = ~La vie est sacrée et ce sacré prend sa source dans l'équilibre : prédateur et proie, pluie et soleil, naissance et mort. Un période de déséquilibre s'est terminée avec la mort de Faldorn mais une nouvelle rupture s'annonce dans le cycle.~
@49008 = ~Longtemps les trolls du mont ont vécu sous la protection du bosquet. Mais ces derniers temps ont vu l'avènement d'une nouvelle cheffe.~
@49009 = ~Parlez tant que vous voulez, cela ne sert à rien. Tous ceux que j'ai rencontrés ici nous ont attaqués ou ont tenté d'obtenir ma confiance pour mieux nous tromper.~
@49010 = ~Je n'ai aucune raison de mentir. Je veux juste retrouver ma liberté.~
@49011 = ~Battez-vous ou bien écartez-vous. Si près de la liberté, personne ne peut m'arrêter.~
@49012 = ~Je connais Irenicus pour avoir été son prisonnier. Je peux vous aider à le combattre !~ ~Je connais Irenicus pour avoir été sa prisonnière. Je peux vous aider à le combattre !~
@49013 = ~Je peux peut-être vous aider. Qu'est-ce que cette guerre des guildes dont vous parliez ?~
@49014 = ~Vous ne vous échapperez pas sans un combat. Votre maître meurt là-haut et vous allez bientôt le rejoindre !~
@49015 = ~Alors je vais vous rendre la liberté. Tombez devant nos armes et nos sortilèges et vous serez libre ! Votre chute et celle d'Irenicus marqueront la fin de la guerre !~
@49016 = ~Je ne vous crois pas. Je ne peux pas me permettre de faire confiance au premier venu dans cet endroit infernal, ce serait de l'inconscience pure.~ ~Je ne vous crois pas. Je ne peux pas me permettre de faire confiance à la première venue dans cet endroit infernal, ce serait de l'inconscience pure.~
@49017 = ~Je ne vous dirai rien. Il faut savoir garder ses secrets en temps de guerre. Tout ce que j'ai à vous dire, c'est que votre guilde est vouée à sa perte.~
@49018 = ~Nilthiri la chamane mène les trolls vers le chaos. Elle les pousse à étendre leur territoire et elle fait venir de nouveaux trolls au mont sans songer aux conséquences.~
@49019 = ~Si cela continue, les trolls envahiront le bosquet et la nature en souffrira. Un serviteur de la nature doit mettre fin au cycle de la vie de Nilthiri pour le bien de tous.~
@49020 = ~Feras-tu cela pour le bosquet, enfant <CHARNAME> ?~
@49021 = ~Clef de la cellule de la prison~
@49022 = ~Kyland Lind~
@49023 = ~Je n'y comprends rien, mais si l'assassin de Dynahéir est plus loin, Bouh et Minsc ne feront qu'une bouchée de ta personne !~
@49024 = ~Kyland Lind~
@49025 = ~C'est bien. Ce gourdin fut laissée par Marek le fondateur du bosquet quand sa vie prit fin, comme toutes le doivent. Il pourra t'aider dans la bataille.~
@49026 = ~En ce moment même Nilthiri pratique des rituels d'invocation. Il faut l'arrêter. Tu la trouveras sur le chemin vers l'est du Mont des Trolls.~
@49027 = ~Quand l'acte sera accompli, je viendrai à toi. Jusque-là, la bénédiction du bosquet sera avec toi. Va et fais ce que tu dois.~
@49028 = ~Peu importent vos paroles, vous mourrez avec votre guilde !~
@49029 = ~Je suis honoré d'avoir été choisi, Esprit. Je causerai la mort de Nilthiri et l'équilibre sera rétabli.~ ~Je suis honoré d'avoir été choisie, Esprit. Je causerai la mort de Nilthiri et l'équilibre sera rétabli.~
@49030 = ~Tu te trompes, mais peu m'importe ! Khalid sera vengé, écarte-toi, de gré ou de force !~
@49031 = ~Les trolls sont de viles créatures ! Pourquoi ne pas les tuer tous ?~
@49032 = ~Je ne peux pas faire ça.~
@49033 = ~Les trolls, eux aussi, sont des enfants de la nature. Ils ont leur place dans ce royaume tant qu'est maintenu l'équilibre.~
@49034 = ~Très bien. Je causerai la mort de Nilthiri et l'équilibre sera rétabli.~
@49035 = ~Hors de mon chemin ! Je ne veux pas me battre avec aucun d'entre vous, je veux juste m'enfuir d'ici !~
@49036 = ~Je refuse d'accomplir cette tâche.~
@49037 = ~Le bosquet a besoin de toi, druide. Veux-tu vraiment laisser une telle situation s'envenimer ?~ ~Le bosquet a besoin de toi, druidesse. Veux-tu vraiment laisser une telle situation s'envenimer ?~
@49038 = ~C'est possible mais malgré tout je n'ai pas le temps de vous aider.~
@49039 = ~Si c'est aussi urgent que vous le dites je le ferai.~
@49040 = ~Tes allées et venues insouciantes sur la grande Terre-Mère ne resteront pas impunies.~
@49041 = ~Nous avons combattu selon le vœu de notre maîtresse. Il est temps à présent de nous rendre, de retourner dans la forêt et de rétablir l'équilibre.~
@49042 = ~La chose est faite et la fragile balance de l'équilibre s'est rétablie pour l'instant. Tu as fait du bon travail, enfant de la nature.~
@49043 = ~Je ne vous cacherai pas ce que j'attends de vous. Vous allez devoir tuer et vous allez devoir terroriser. À vous de savoir si vous avez les tripes pour ça.~
@49044 = ~On a besoin de toi au-delà des confins du bosquet tu dois partir pour un temps. Mais ne laisse pas passer trop de semaines avant ton retour au bosquet. Il aura peut-être bientôt besoin de toi à nouveau.~
@49045 = ~Lorsque tu reviendras, dors dans le bosquet lui-même et l'Esprit viendra à toi si l'on a besoin de tes services. Adieu.~
@49046 = ~Ce sera une arrivée relativement tranquille. Les morts seront stratégiques, presque artistiques. Vos coups seront précis.~
@49047 = ~Si ce n'est pas à votre goût, alors vous devez décider en fonction de cela. Ma route sera sanglante et vous ne vous y ferez pas beaucoup d'amis.~
@49048 = ~Réfléchissez bien avant d'agir. Vous regretteriez de m'avoir pour ennemie. Je vous offre l'opportunité de savourer la destruction de vos maîtres. Relèverez-vous ce gant ensanglanté ?~
@49049 = ~Si vous travaillez pour moi, vous vous opposerez à une organisation criminelle molle. Si vous travaillez pour eux, vous vous opposerez à... comment dire ? Quelqu'un de « très inquiétant », pour reprendre vos propres termes.~
@49050 = ~Enfant de la nature, on a besoin de toi à nouveau. L'équilibre est menacé et le chaos est à nos portes. Veux-tu servir le bosquet ?~
@49051 = ~Voyons, cela ne rime à rien. Je suis votre meilleure option. Je vous permettrai d'agir comme bon vous semblera. Vous serez redouté.~
@49052 = ~Qui ose interrompre l'Appel ? Des humains ?! Cela sera payé par le sang !~
@49053 = ~Les esprits de la forêt ne vaincront pas le Sombre Pouvoir du tertre ! À l'attaque !~
@49054 = ~Que voulez-vous de moi ?~
@49055 = ~Je ne peux pas aider le bosquet.~
@49056 = ~Il y a beaucoup de choses que tu ignores sur le bosquet. Cette histoire t'aidera à comprendre le chemin qui doit être suivi. Écoute, enfant, et apprends.~
@49057 = ~Le bosquet est jeune à l'échelle de la nature et ancien à l'échelle humaine. Il y a des siècles Marek de Halruaa établit un protectorat de la nature dans ces bois.~
@49058 = ~Il fit venir des druides des terres lointaines pour stopper l'avancée du « progrès » des races « civilisées ».~
@49059 = ~Marek éveilla l'âme du bosquet, et je suis sa voix. Mais depuis sa fondation, le bosquet a été menacé par des forces cherchant à détruire l'ordre naturel des choses.~
@49060 = ~Oh ! Vous attendiez-vous à une grande bataille pendant que je vous crierais quelques malédictions ? Cela viendra, mais pas ici. Retirez-vous maintenant.~
@49061 = ~Je vais prendre les 15 000 pièces d'or, naturellement. Oh, c'est secondaire mais cela fait partie du contrat. Maintenant, passons à ce que j'attends de vous.~ [BODHIX17]
@49062 = ~N'ayez pas l'air surpris. Vous ne pensiez tout de même pas qu'ils vous laisseraient vous balader sans vous surveiller.~
@49063 = ~Pour le moment, je vous suggère de vous occuper de ce bateau. Ils ne resteront pas aux quais très longtemps et, si vous ne mettez pas la main sur la cargaison dans les prochains jours, vous aurez échoué.~
@49064 = ~~
@49065 = ~Et soyez assuré que je vous aiderai à trouver Imoen et Irenicus mais pas uniquement pour vos propres raisons. Irenicus m'intéresse également.~ ~Et soyez assurée que je vous aiderai à trouver Imoen et Irenicus mais pas uniquement pour vos propres raisons. Irenicus m'intéresse également.~
@49066 = ~Vous voulez que je trouve Irenicus ? De quoi parlez-vous ? Êtes-vous en cheville avec lui ?~
@49067 = ~Considérez cela comme une condition supplémentaire. J'offre beaucoup et j'attends beaucoup en retour. Imoen et Irenicus seront vos deux objectifs le moment venu.~
@49068 = ~Permettez-moi de ne pas m'étendre sur les détails. Si vous souhaitez en savoir plus, joignez-vous à moi. Comme je l'ai dit, votre tâche ne sera pas des plus morales et vous pouvez être confronté à plus d'ennemis que vous ne l'auriez souhaité.~ ~Permettez-moi de ne pas m'étendre sur les détails. Si vous souhaitez en savoir plus, joignez-vous à moi. Comme je l'ai dit, votre tâche ne sera pas des plus morales et vous pouvez être confrontée à plus d'ennemis que vous ne l'auriez souhaité.~
@49069 = ~Je ne me soucie pas des tendances suicidaires de mon frère. Il les a mis en colère comme beaucoup d'autres. Peut-être à cause d'expériences qui ont mal tourné.~
@49070 = ~Alnarow~
@49071 = ~15 000 pièces d'or représentent une somme importante mais vous en aurez pour votre argent. Vous finirez par retrouver Imoen et, également, par mettre la main sur quelques babioles magiques.~
@49072 = ~Damnation ! J'ai déjà rendu un sacré paquet de services ! Je veux des réponses en échange de mon or !~
@49073 = ~Symbole : mort~
@49074 = ~Et, comme vous le savez, je suis <CHARNAME>. Et maintenant, pourrions-nous passer aux choses sérieuses ?~
@49075 = ~Je regrette que tu aies pu penser avoir été trompé. Je te promets qu'il a été fait bon usage de tout ce que tu as payé.~ ~Je regrette que tu aies pu penser avoir été trompée. Je te promets qu'il a été fait bon usage de tout ce que tu as payé.~
@49076 = ~Mais ces choses prennent du temps. En vérité, nous avons commencé à y travailler bien avant que tu ne nous donnes l'or. Il ne reste plus que quelques détails à mettre au point, mais il ne faut pas les négliger.~
@49077 = ~Avant tout, tu seras dédommagé pour l'or que tu as versé. Je vais te donner plusieurs objets magiques ; tu pourras les conserver quoi qu'il arrive.~ [ARAN08] ~Avant tout, tu seras dédommagée pour l'or que tu as versé. Je vais te donner plusieurs objets magiques ; tu pourras les conserver quoi qu'il arrive.~ [ARAN08]
@49078 = ~Je sais que tu es impatient de retrouver Imoen, et je t'assure qu'il ne faudra plus attendre très longtemps. Mais rassembler les fonds nécessaires n'est pas chose facile. Quoi qu'il en soit, je t'assure que nous tiendrons nos engagements.~ [ARAN09] ~Je sais que tu es impatiente de retrouver Imoen, et je t'assure qu'il ne faudra plus attendre très longtemps. Mais rassembler les fonds nécessaires n'est pas chose facile. Quoi qu'il en soit, je t'assure que nous tiendrons nos engagements.~ [ARAN09]
@49079 = ~Plus très longtemps, j'espère.~
@49080 = ~Je le savais. Vous n'avez pas l'intention de nous aider du tout !~
@49081 = ~Ce délai me tracasse. Y aurait-il un problème que j'ignore ?~
@49082 = ~Non, non, non, tout est normal. Nous avons juste rencontré quelques difficultés imprévues. Je regrette d'avoir à te demander quelques services.~
@49083 = ~Je sais, je sais, tu es fatigué et tu as déjà travaillé dur. Je suis désolé, mais cette guerre des guildes... nous empêche de progresser comme nous le devrions.~ ~Je sais, je sais, tu es fatiguée et tu as déjà travaillé dur. Je suis désolé, mais cette guerre des guildes... nous empêche de progresser comme nous le devrions.~
@49084 = ~Ah, <CHARNAME>, je dois admettre que la marchandise ne serait pas très bien vue par la milice. Essentiellement des armes, mais défense d'y toucher.~
@49085 = ~La guilde que nous combattons n'est pas comme nous. Aussi corrompus que puissent être les Voleurs de l'ombre, nous respectons un certain code. Cette nouvelle guilde ne respecte rien.~
@49086 = ~Je vais le faire, mais ensuite vous avez intérêt à me donner ce que vous m'avez promis.~
@49087 = ~Je ne ferai rien de tel ! J'exige de savoir où est Imoen ! J'ai payé !~
@49088 = ~<CHARNAME>, c'est une affaire plutôt délicate, et tu finiras par voir que la guilde que nous combattons y est aussi impliquée.~
@49089 = ~Examine attentivement les choix qui s'offrent à toi. En te joignant à nous, tu t'es fermé d'autres portes. Accomplir les missions que je te propose est le seul moyen d'atteindre ton objectif.~ ~Examine attentivement les choix qui s'offrent à toi. En te joignant à nous, tu t'es fermée d'autres portes. Accomplir les missions que je te propose est le seul moyen d'atteindre ton objectif.~
@49090 = ~Je te laisse décider par toi-même, mais n'attends pas trop. Va sur les quais dès que tu auras admis que c'est la seule solution. Vas-y de nuit et trouve Mook.~
@49091 = ~Si dans cette affaire tu cherches à défendre la morale, tu verras qu'elle est du côté des Voleurs de l'ombre. Cela peut paraître étonnant, mais je t'assure que c'est la vérité.~
@49092 = ~Si un chef des druides tu souhaites vraiment devenir, tu dois aider la nature à combattre ses ennemis.~
@49093 = ~Que puis-je faire pour vous aider ?~
@49094 = ~Pourtant, je dois refuser cet honneur.~
@49095 = ~Continuez.~
@49096 = ~Je ne souhaite pas entendre la suite de ce récit.~
@49097 = ~Celui qui n'a pas connaissance de l'histoire ne pourra jamais bénéficier de l'expérience du passé. Un druide devrait connaître l'importance de ceci.~ ~Celui qui n'a pas connaissance de l'histoire ne pourra jamais bénéficier de l'expérience du passé. Une druidesse devrait connaître l'importance de ceci.~
@49098 = ~Dans ce cas, continuez, je vous en prie.~
@49099 = ~Et pourtant, je ne souhaite pas en entendre plus.~
@49100 = ~Marek et le bosquet attirèrent dans cette contrée beaucoup d'hommes et de femmes de bien désireux de servir comme protecteurs. Mais il attira également le mal qui réside en Amn dans une certaine mesure.~
@49101 = ~Marek savait qu'il avait été reconnu comme notre chef... et il a déclenché les événements qui ont conduit à ta présence ici aujourd'hui.~
@49102 = ~Marek établit une hiérarchie qui assurerait le commandement après sa mort. Puis il construisit des défenses d'une solidité à toute épreuve pour protéger le bosquet.~
@49103 = ~Symbole : étourdissement~
@49104 = ~Palais~
@49105 = ~La force et l'esprit de Marek venaient d'une compréhension parfaite de la terre. Cet esprit ne pouvait être détruit et il a toujours été ici dans le bosquet, tel un partenaire silencieux de la nature.~
@49106 = ~Avant sa mort, Marek avait une femme et un enfant. Quand il sut qu'il devrait mourir pour le bosquet, il les fit emmener très loin pour leur propre sécurité.~
@49107 = ~Maintenant, ainsi que Marek l'avait prévu, ses descendants sont revenus et de vieux ennemis rallient leurs forces. Un enfant appelé Loren est récemment arrivé à Franc-Marché.~
@49108 = ~Cet enfant est l'héritier de l'esprit de Marek il n'a pas encore la connaissance lui permettant d'utiliser ce pouvoir. Il sera sûrement tué par les forces du chaos si tu ne le sauves pas.~
@49109 = ~Mook est morte mais la cargaison est intacte. Maintenant je veux mon dû.~
@49110 = ~En ce moment même il est seul et en danger, ses parents tués par par un mal qui le hante. Tu dois trouver l'enfant Loren à Franc-Marché et combattre les vieux ennemis de Marek pour sauver la vie de l'enfant.~
@49111 = ~Je comprends votre préoccupation, mais ne pourrait-on pas en revenir à nos affaires ?~
@49112 = ~Je vais le faire tout de suite.~
@49113 = ~Pourquoi l'Esprit du bosquet ne peut-il rien faire pour le protéger ?~
@49114 = ~Je ne peux pas aider ce garçon. Je n'ai pas le temps.~
@49115 = ~Ce garçon est destiné à commander ce bosquet une fois que tu seras parti, à l'appel de ta propre destinée. Je viendrai à toi quand l'enfant sera en sécurité... va maintenant, et fais vite !~
@49116 = ~Assez ! Je veux ce que je vous ai payé, si vous permettez.~
@49117 = ~L'esprit qui fut un jour Marek est parti aider l'enfant... mais l'esprit n'est pas le pouvoir que l'homme fut autrefois et il ne peut pas espérer tenir longtemps. Porte-lui secours, ou tout sera perdu.~
@49118 = ~Je vais dès maintenant aller trouver cet enfant.~
@49119 = ~Je ne peux pas aider ce garçon. Je n'ai pas le temps.~
@49120 = ~Le bosquet te tient pour un chef et un véritable protecteur de la nature. Veux-tu lui donner tort ? N'as-tu que du mépris pour ce qui est bien à présent ?~ ~Le bosquet te tient pour une cheffe et une véritable protectrice de la nature. Veux-tu lui donner tort ? N'as-tu que du mépris pour ce qui est bien à présent ?~
@49121 = ~Je suis désolé mais je ne peux pas vous aider.~ ~Je suis désolée mais je ne peux pas vous aider.~
@49122 = ~Je ne manquerai pas à mon devoir. Je vais aller trouver l'enfant et l'aider.~
@49123 = ~Êtes-vous celui qui vient pour... me tuer ? J'entends sans cesse des voix... Je voudrais tant que ça s'arrête, oh, je voudrais tant que tout ça s'arrête !~ ~Êtes-vous celle qui vient pour... me tuer ? J'entends sans cesse des voix... Je voudrais tant que ça s'arrête, oh, je voudrais tant que tout ça s'arrête !~
@49124 = ~Tes fantaisies enfantines ne m'intéressent pas. Pousse-toi, gamin !~
@49125 = ~J'ai juste... l'obscurité a dit... Je ne veux pas vous déranger, <SIRMAAM>.~
@49126 = ~Je suis le druide <CHARNAME>, Loren. Je suis venu te délivrer de ces voix. Ils veulent te faire du mal, mais pas moi.~ ~Je suis la druidesse <CHARNAME>, Loren. Je suis venue te délivrer de ces voix. Ils veulent te faire du mal, mais pas moi.~
@49127 = ~Dis-moi de quoi parlent ces voix, petit.~
@49128 = ~Comment pouvez-vous me sauver, <SIRMAAM> ? Elles ont tué mes parents et elles ont dit que... que je leur appartenais maintenant. Elles disent qu'elles sont à l'intérieur de moi... Et... je n'arrive pas à les faire sortir !~
@49129 = ~Elles n'arrêtent pas de me parler. Elles disent... Elles disent que je leur appartiens... et qu'elles me tueront et que Marek ne peut pas m'aider. Êtes-vous Marek ? Elles ont l'air d'avoir peur de lui.~
@49130 = ~Marek est ta propre force intérieure, mon enfant. Tu dois lutter contre ces voix. Tu dois les chasser de ton corps et je me battrai contre elles.~
@49131 = ~Tu es un descendant de Marek, qui a été détruit par ces mêmes esprits qui te hantent aujourd'hui.~
@49132 = ~Je dois partir, maintenant.~
@49133 = ~Alors je suis perdu... Elles me tueront comme elles l'ont tué... *soupire* Je ne veux pas mourir, <SIRMAAM>... Aidez-moi !~
@49134 = ~Marek est la force qui vit à l'intérieur de toi, mon enfant. Son esprit te protégera. Tu dois lutter contre ces voix, les chasser de ton corps afin que je puisse les combattre.~
@49135 = ~Vous en êtes réduit à me menacer ? J'ai plus que payé pour votre aide.~
@49136 = ~Alnarow~
@49137 = ~Je comprends ton inquiétude, mais pour avancer il faut d'abord dégager la route. Je te donnerai exactement ce que tu veux, mais il faut d'abord résoudre ce problème.~
@49138 = ~Je ne peux pas t'aider. Adieu.~
@49139 = ~Tu dois lutter contre ces voix. Tu dois les chasser de ton corps et je me battrai contre elles. Ensuite, nous trouverons un endroit où tu seras en paix.~
@49140 = ~Je vais te dire ce qui doit être fait maintenant. Tu comprendras en quoi c'est nécessaire.~
@49141 = ~Je ne peux pas te sauver, mon enfant.~
@49142 = ~Je vais essayer... Les voix sont en colère maintenant... Elles veulent que vous partiez...~
@49143 = ~Dis-leur que je ne partirai pas. Dis-leur de sortir et de venir m'affronter.~
@49144 = ~Je m'en vais.~
@49145 = ~Aaah, elles me font mal, <SIRMAAM> ! Elles disent qu'elles vont me tuer si vous ne partez pas !~
@49146 = ~Si elles pouvaient te tuer, elles l'auraient déjà fait depuis longtemps. Elles doivent venir m'affronter ; elles n'ont pas le choix.~
@49147 = ~Je m'en vais.~
@49148 = ~Aaaaaaaaahhhhhh...~
@49149 = ~Tu prends des risques, druide ! Le chaos risque fort de te le faire payer !~ ~Tu prends des risques, druidesse ! Le chaos risque fort de te le faire payer !~
@49150 = ~Nous verrons bien lequel de nous deux le paiera le plus cher...~
@49151 = ~Pourquoi tourmenter ce garçon ?~
@49152 = ~Tu vas enfin savoir ce qu'est le vrai pouvoir, druide !~
@49153 = ~Il est à nous ! Marek le maudit pensait pouvoir nous vaincre mais nous sommes le Pouvoir Sombre, le Pouvoir Éternel du chaos de la nature. Personne ne peut nous vaincre ! Cet enfant ne suivra pas les traces de Marek !~
@49154 = ~Bonjour, <SIRMAAM>. Merci de m'avoir sauvé. J'avais presque perdu tout espoir...~
@49155 = ~Je suppose que vous avez un autre plan que de me regarder me taper la tête contre les portes ?~
@49156 = ~Alors nous aurons besoin d'aide pour les ouvrir.~
@49157 = ~Et que suis-je censé faire ?~ ~Et que suis-je censée faire ?~
@49158 = ~Que vas-tu faire maintenant ?~
@49159 = ~Je suis heureux d'avoir pu t'aider. Adieu !~ ~Je suis heureuse d'avoir pu t'aider. Adieu !~
@49160 = ~J'ai parlé avec... l'Esprit. Je crois que je veux devenir druide. L'Esprit a dit que je protégerai le bosquet quand vous serez parti... que mon destin est ici...~ ~J'ai parlé avec... l'Esprit. Je crois que je veux devenir druide. L'Esprit a dit que je protégerai le bosquet quand vous serez partie... que mon destin est ici...~
@49161 = ~J'y vais, mais vous avez intérêt à tenir votre engagement.~
@49162 = ~C'est vrai, Loren. Apprends bien et prends soin de toi.~
@49163 = ~On dirait que nous avons tous les deux un destin particulier... J'espère que nous réussirons tous les deux à l'accomplir...~
@49164 = ~Merci, <SIRMAAM> ! Bonne chance !~
@49165 = ~Je donne ce que je peux et j'honorerai tous mes engagements. Cette rivale est un obstacle très important dont il faut s'occuper. Je t'en prie, je ne te dis que la vérité.~
@49166 = ~Le quartier du cimetière n'est pas loin. Vas-y, et tu verras l'étendue de ma gratitude à ton retour.~
@49167 = ~Et ce sont eux qui t'empêchent d'aller au secours d'Imoen. Fais-moi confiance, <CHARNAME>, tu ne le regretteras pas.~
@49168 = ~Nous avons appris ta capture presque instantanément. Nous sommes informés de presque tout ce qui se passe dans cette ville.~
@49169 = ~Nous n'en avons pas tenu compte. Même si ça s'est fait sans les Voleurs de l'ombre, nous n'attachions pas d'importance à un simple enlèvement.~
@49170 = ~Mais peu après nous avons commencé à perdre du monde. C'est là que Bodhi a fait son apparition, même si nous ne connaissions pas encore son nom.~
@49171 = ~Certains de nos membres ont été menacés, ou séduits par sa nouvelle guilde. Aucun n'a refait surface. Nous ne savons toujours pas où ils sont. Même son état-major n'a pas pu tous les dévorer.~
@49172 = ~Par chance un corps a été retrouvé dans les égouts ; c'est ce qui nous a permis de trouver Irenicus et son étrange repaire souterrain. Nous l'avons attaqué, sans grand succès, mais les Mages cagoulés l'ont capturé, comme tu as pu le voir.~
@49173 = ~J'ai assisté à votre attaque. C'était un massacre.~
@49174 = ~Alors on vous a arraché votre vengeance à vous aussi.~
@49175 = ~À cause de ça j'ai perdu bien plus. Je suis toujours sans nouvelle d'Imoen.~
@49176 = ~Nous acceptons une part de responsabilité dans la perte d'Imoen, mais nous nous intéressions surtout à Irenicus. Nous ne savons toujours pas pourquoi il tuait les membres de notre guilde.~
@49177 = ~Victoire, <CHARNAME> ! Loren est vivant et son destin est intact. Et grâce à cela, l'avenir du bosquet est assuré. Bravo.~
@49178 = ~Alors nous t'avons suivis. Vous étiez les seuls êtres vivants à sortir de sa prison. Nous avons surveillé chacun de tes mouvements et fait en sorte que tu restes à notre portée.~
@49179 = ~Le bosquet perçoit qu'une sombre destinée t'attend, avec beaucoup de danger, moral comme physique. Car maintenant ta mission est accomplie dans le bosquet.~
@49180 = ~Vous vouliez quelqu'un pour vous mener à lui. Votre aide n'avait rien d'un acte de charité en fin de compte.~
@49181 = ~Alors pourquoi tout cet argent ? Pourquoi ne pas simplement m'interroger ?~
@49182 = ~Vous avez dû voir que je n'étais pas avec lui.~
@49183 = ~Nous devions être sûrs. Nous étions trop affaiblis pour permettre à un ennemi d'entrer dans la guilde. Et à dire vrai, nous avions aussi grand besoin de ton or.~ ~Nous devions être sûrs. Nous étions trop affaiblis pour permettre à une ennemie d'entrer dans la guilde. Et à dire vrai, nous avions aussi grand besoin de ton or.~
@49184 = ~Bientôt tu pourras revenir pour te battre pour l'ascension au sein du bosquet. Jusqu'à ce jour, je ne t'appellerai pas. Va de l'avant et trouve la voie de l'équilibre dans ta vie.~
@49185 = ~Nous pensions que tu pourrais nous mener à lui, et c'est le cas. Tu cherches Imoen et Irenicus, et nous cherchons des réponses à nos questions. Ils ont été emmenés au même endroit.~
@49186 = ~La danger pour le bosquet est éloigné, maintenant, et Loren sera emmené au bosquet où il pourra commencer à apprendre la voie de la nature. Nous attendrons ton retour.~
@49187 = ~Que la forêt ouvre toujours un chemin, sage druide. Adieu !~ ~Que la forêt ouvre toujours un chemin, sage druidesse. Adieu !~
@49188 = ~Votre dernière victoire n'avait aucun sens. Vous n'avez fait que retarder l'inévitable.~
@49189 = ~Tu dois comprendre l'équilibre si tu veux vivre de la générosité de la terre. Le poisson reviendra avec le temps.~
@49190 = ~Prête pas attention à un vieil homme ronchonneur, mon fils.~ ~Prête pas attention à un vieil homme ronchonneur, ma fille.~
@49191 = ~Je dirai une prière pour vous, en espérant que votre générosité vous sera rendue.~
@49192 = ~Ce ne sont pas les mots qui vont remplir mes filets, mon p'tit bonhomme. Mais merci quand même.~ ~Ce ne sont pas les mots qui vont remplir mes filets, ma p'tite dame. Mais merci quand même.~
@49193 = ~Je n'ai rien demandé. Va-t'en, tu me fais des courants d'air.~
@49194 = ~Je te promets de pleurer toutes les larmes de mon corps le jour où je m'en soucierai.~
@49195 = ~Je pourrais te citer un millier de raisons, mon ami. Mais j'ai un faible pour la simple promenade.~
@49196 = ~Ah ! Enlevez vos mains délicates d'ici.~
@49197 = ~Certes, ce texte se révélera être un héritage embarrassant, mais je dois ordonner mes pensées de peur qu'elles ne me sortent de l'esprit.

Je contrôle Spellhold. Dès que je fus sorti de ma torpeur, je m'occupai rapidement de ses défenses. Le directeur Wanev s'est judicieusement retiré de ses fonctions, ayant étrangement réagi à l'un de mes sorts. Je ne me souviens même plus de quoi il s'agissait ; peut-être quelque chose que j'ai entendu dans les temples de Suldanessalar... cela a-t-il vraiment de l'importance maintenant ?

Ma condition empire, et je ne me souviens plus que vaguement de ma « maison ». Je vois des images de personnes dont je ne me souviens plus, les noms défilent devant mes yeux, et je rêve d'émotions que je n'éprouve plus. À certaines occasions, j'ai l'impression que la nature est ma mère, et que je n'ai jamais quitté son giron, mais de tels instants sont rares. Je supporte les attaques de la sénilité avec la rage et la puissance d'un jeune elfe qui se lamente.

Bodhi a mieux supporté que moi la malédiction, mais elle était plus concentrée, plus intense, et, plus important, déjà morte-vivante. Désormais, elle accepte totalement sa condition vampirique, malgré son échec pour échapper à la sentence de mort. Elle a accueilli avec plaisir l'immortalité, excitée par la puissance, mais maintenant, elle est confuse. L'âme d'Imoen l'a restaurée, mais ses motivations restent transparentes, voire simplistes. Elle s'affirme dans son côté charnel, carnassier, même si l'elfe qui est encore en elle méprise la créature qu'elle est devenue.

Je pourrais prendre en pitié ma « sœur » si j'en étais capable, mais de telles émotions ne me viennent plus que par brusques bouffées. Ellésime m'a privé de réelles sensations, et m'a laissé avec les débris d'un cœur humain, ou celui d'une autre créature à l'espérance de vie pitoyablement limitée. Je ne supporterai plus ça encore longtemps.

Spellhold a répondu à mes attentes. Ils avaient pris l'habitude de s'exercer sur les pensionnaires depuis un moment, même si leurs méthodes étaient plutôt barbares. J'ai raffiné leurs techniques et terminé la préparation des rituels nécessaires. J'en ai terminé avec Imoen, mais elle peut encore me servir d'appât. Je suis certain que <CHARNAME> fera une apparition, à un moment ou un autre.

Bodhi m'a apporté plus d'assassins que je n'en avais besoin. Je me suis occupé de certains à l'avance, mais cela m'a semblé être du gâchis. Je pense qu'elle l'a fait exprès, car elle a relâché ceux en trop dans le labyrinthe souterrain, et elle les a chassé avec un grand plaisir. Je m'émerveille devant son appétit et elle semble désormais si « vivante » dans sa non-mort (ou sa non-vie). Peut-être est-ce l'âme d'Imoen. Je verrai bientôt par moi-même. <CHARNAME> ferait mieux de se dépêcher.~
@49198 = ~Victoire ! Je suis à nouveau moi-même ! <CHARNAME> m'a fait don d'exactement ce qu'il fallait, comme je le demandais, et maintenant je comprends où Bodhi a trouvé une telle flamme ! Je sens l'essence des dieux en moi ! Maudite soit Ellésime pour sa malédiction souffreteuse : je suis libre désormais. <CHARNAME> n'a pas su faire bon usage de l'héritage qui lui avait été laissé.

Le temps de la vengeance est venu. Je ne permettrai pas aux auteurs d'un tel crime de ne pas être châtiés. Quelle audace que celle d'Ellésime, en demandant ma condamnation, et quelle hypocrisie que celle de « mon » peuple en la lui accordant ! Cela ne restera pas impuni. Je prendrai ce que je veux, et ceux qui oseront barrer mon chemin seront écrasés comme les insectes qu'ils sont. De grands jours s'annoncent.~
@49199 = ~Ou nous avons erré par inadvertance parmi les hommes sales et répréhensibles.~
@49200 = ~Dans c'coin-ci, votre attitude va vous attirer des ennuis.~
@49201 = ~Oui, bien sûr, je ne repousse jamais une belle femme.~
@49202 = ~Oui, bien sûr, je ne repousse jamais une belle femme.~
@49203 = ~Oui, bien sûr, je ne repousse jamais une belle femme.~
@49204 = ~Oh non, j'espère que vous plaisantez. C'est affreux. Cette femme mérite un bien meilleur traitement.~
@49205 = ~Ceci ne sera pas toléré en ma présence. Cette jeune femme ne peut pas être échangée comme une marchandise.~
@49206 = ~Je ne crois pas ! Mon enfant, tu vaux certainement mieux que ça ? Tu es certain de ton choix ?~ ~Je ne crois pas ! Mon enfant, tu vaux certainement mieux que ça ? Tu es certaine de ton choix ?~
@49207 = ~Oui, l'enfant a intérêt à faire très tôt l'apprentissage de la dureté de la vie s'il veut survivre.~
@49208 = ~Cette sévérité n'était pas nécessaire. Je vois que nous serons en désaccord très souvent, elfe noir.~ ~Cette sévérité n'était pas nécessaire. Je vois que nous serons en désaccord très souvent, elfe noire.~
@49209 = ~La vie est trop dure pour ceux qui sont petits. J'ai appris cela dans le temps.~
@49210 = ~Je consacrerai à présent ma vie au rétablissement de l'équilibre que Faldorn a rompu avec tant d'insouciance. Je te remercie pour ton aide et te souhaite chance et prospérité.~
@49211 = ~J'ai fait ce que j'ai pu. Le reste dépend de vous, <CHARNAME>.~
@49212 = ~Dans ce cas, le prix vient subitement d'augmenter. Il vous en coûtera 500 pièces d'or supplémentaires.~
@49213 = ~Je vous en prie ! Je n'ai plus d'or ! Tout ce que je possède se trouve dans mon château. Vous trouverez certainement de quoi vous satisfaire.~
@49214 = ~Il est temps de me dire contre quoi nous nous battons. Je dois connaître notre ennemi.~
@49215 = ~Ce n'est pas suffisant. Trouvez quelqu'un d'autre pour vous aider.~
@49216 = ~Je me moque de la mission. Payez-moi 500 pièces d'or d'avance ou disparaissez de ma vue.~
@49217 = ~Je me moque de la mission. Payez-moi 500 pièces d'or d'avance ou disparaissez de ma vue.~
@49218 = ~Mais... je n'ai pas le choix. Vous êtes cruel et je suis aux abois. Voici 186 pièces d'or. C'est tout ce que je possède.~ ~Mais... je n'ai pas le choix. Vous êtes cruelle et je suis aux abois. Voici 186 pièces d'or. C'est tout ce que je possède.~
@49219 = ~Mmm. Si c'est tout ce que vous avez... ça fera l'affaire. Racontez-moi tout.~
@49220 = ~Ce n'est pas assez. J'en veux 500.~
@49221 = ~Je vous aiderai si vous payez. Je veux 500 pièces d'or d'avance.~
@49222 = ~~
@49223 = ~*tousse* Ils sont... trop nombreux... Repartez !~
@49224 = ~J'ai fait ce que j'ai pu. Le reste dépend de vous, <CHARNAME>.~
@49225 = ~Non ! Par pitié ! Ne me punissez plus !~
@49226 = ~Aidez-moi ! Je vous en prie...~
@49227 = ~Marmotte~
@49228 = ~Plus vous avancerez dans le château et plus vous rencontrerez de trolls et de yuan-tis. Ouvrez le pont-levis et nous les attaquerons. C'est peut-être votre seule chance.~
@49229 = ~Ha ! R'gardez-moi la tête de l'autre, là-bas ! On dirait qu'il a eu du mal à se glisser dans son bel habit !~
@49230 = ~Eh ! Mais j'vous ai pas déjà vu dans le cirque, vous ? Alors, comment on se porte ? J'ai un peu de monnaie pour qu'on aille boire un verre, qu'est-ce que vous en dites ?~ ~Eh ! Mais j'vous ai pas déjà vu dans le cirque, beauté ? Alors, comment on se porte ? J'ai un peu de monnaie pour qu'on aille batifoler ; qu'est-ce que vous en dites ?~
@49231 = ~Si cette remarque était pour moi, je te conseille de réfléchir avant d'être obligé de me demander pardon à genoux. (Hmpf ! Je suis en pleine forme !)~
@49232 = ~Qu... quel rustre ! Vous feriez bien de prendre quelques leçons de correction, monsieur... avant que quelqu'un ne vous l'enseigne d'une façon que vous ne risquez guère d'apprécier !~
@49233 = ~Ha ! Je parie que dans moins d'une heure vous quitterez les quais en hurlant, le corps en sang, après vous être fait complètement dépouiller de vos biens. Ça, je peux vous le garantir.~
@49234 = ~Regardez-moi cette drôle de tête, là ! C'est un démon, aussi sûr que sûr est sûr ! Un démon !~
@49235 = ~Tu ne sais pas de quoi tu parles, brave homme. Vérifie à nouveau tes poches et tu décideras ensuite qui est la véritable victime des quais, d'accord ?~
@49236 = ~*vous chancelez, la tête vous tourne, et vous vous sentez terriblement mal en point... pendant une poignée de secondes, vous ne percevez rien d'autre que votre sang qui bouillonne*~
@49237 = ~Moi, un démon ?! Ce moineau avait peut-être un ou deux ancêtres étranges qui expliqueraient ta peur, bruyant ami, mais je ne me repaîtrai pas de tes entrailles, ne t'inquiètes pas.~
@49238 = ~Il y a un peu de justice dans cet acte, Yoshimo, mais agir comme un tire-laine est indigne d'un héros. À l'avenir, vous garderez vos tours de passe-passe pour ceux qui le méritent.~
@49239 = ~Je suis désolée, <CHARNAME>, mais j'étais tellement inquiète...~
@49240 = ~Holà, arrêtons-nous un instant. Comment te sens-tu ? Pendant un moment, tu as eu l'air vraiment malade.~
@49241 = ~Je suis contente de te revoir, tu sais ! Ah ! Que c'est bon d'être ensemble ! Bon, on y va ? J'aimerais encore voyager à tes côtés.~ [IMOEN77A]
@49242 = ~Un simple vol par fierté, Yoshimo ? Vous me surprenez. Même un idiot tel que lui ne mérite pas d'être dévalisé.~
@49243 = ~Oh oh ! Un mouvement prompt, mon ami voleur ! Et sa facette ironique réjouit mon cœur ! Tu as l'esprit d'un poète, Yoshimo, le moineau te l'affirme.~
@49244 = ~Je me réjouis que nous n'ayons pas eu à... tuer ce pauvre homme. C'est terrible, ce que nous sommes obligés de faire, parfois.~
@49245 = ~Bien que cette ordure ait mérité la mort la plus cruelle, <CHARNAME>, je suis heureux de voir que vous n'êtes pas dénué de compassion.~ ~Bien que cette ordure ait mérité la mort la plus cruelle, <CHARNAME>, je suis heureux de voir que vous n'êtes pas dénuée de compassion.~
@49246 = ~Tu le laisses s'en aller ?! C'est un voleur ! Il te trahira comme il a trahi son maître, et on aura fait tout ceci pour rien ! Tu aurais dû le tuer et en finir !~
@49247 = ~<CHARNAME> prend des risques en agissant comme il le fait... mais même le plus modeste de nos frères mérite la compassion. Ne voudriez-vous pas que l'Ordre prenne un risque avec vous ?~ ~<CHARNAME> prend des risques en agissant comme elle le fait... mais même le plus modeste de nos frères mérite la compassion. Ne voudriez-vous pas que l'Ordre prenne un risque avec vous ?~
@49248 = ~Un tel manque de compassion sied mal à un chevalier. Laisserais-tu les autres te juger aussi vite ?~
@49249 = ~Ne t'en fais pas. Tu es blessée ? Qu'est-ce qu'il t'a fait ?~
@49250 = ~Oui, c'était extrêmement déplaisant. Mais nous voilà réunis et tout va aller pour le mieux.~ ~Oui, c'était extrêmement déplaisant. Mais nous voilà réunies et tout va aller pour le mieux.~
@49251 = ~Nous avons survécu, mais ça nous a marqué. Je dois savoir ce qu'il m'a... ce qu'il nous a fait.~
@49252 = ~Oui, oui, j'étais là. Retournons dans cette salle et achevons-le.~
@49253 = ~J'ai largement fait mes preuves à l'Ordre, Keldorn. Ne me compare pas à ce... maraud.~
@49254 = ~Tais-toi, vil faquin ! Je connais la vertu et l'ai largement prouvé. Ne me compare pas à ce... maraud.~
@49255 = ~Bien... tu prends un risque en laissant filer Embarl comme ça. Mais je doute qu'il reste dans le coin pour parler de ta générosité, donc pas d'inquiétude. Nous ferions mieux de rapporter cette dague.~
@49256 = ~Tu vas bien ? J'ai eu tellement peur... tu as fait tout ce chemin pour moi et on était presque...~ [IMOEN76]
@49257 = ~Je... je ne sais pas trop. La même chose qu'à toi, je suppose... puisque nous... nous sommes pareils ?~ ~Je... je ne sais pas trop. La même chose qu'à toi, je suppose... puisque nous... nous sommes pareilles ?~
@49258 = ~Problème animalier à Franc-Marché : un fâcheux contretemps

Faldorn contrôle toujours le bocage. Un autre druide devra tenter de la défier, sinon Franc-Marché est perdu.~
@49259 = ~J'ai entendu parler de lui, <CHARNAME>... enfin, un peu. Il a beaucoup de relations dans les bas-fonds de cette ville. C'est aussi un homme de parole, pour ce que ça vaut.~
@49260 = ~Son nom me dit quelque chose, <CHARNAME>. J'ai vaguement entendu parler de lui. On dit qu'il a de nombreuses relations... mais je n'en sais guère plus.~
@49261 = ~Gaelan Bayle ? Des Bayle de Hottentrot ? Hum. Probablement pas. J'ai déjà entendu parler de lui, <CHARNAME>. Mais le gnome qui l'avait mentionné a aussi dit qu'Elminster avait une collection privée de plus d'une centaine de singes, alors qui sait ce que l'on peut croire, de nos jours ?~
@49262 = ~Il a peut-être raison, <CHARNAME>. Il faut des hommes d'influence pour trouver de bonnes informations sur les Mages cagoulés... c'est peut-être ta seule chance de trouver Imoen.~
@49263 = ~Il ne faut pas repousser si vite une main tendue, <CHARNAME>, mais je me méfie de ses origines mystérieuses. Nous pourrons peut-être trouver Imoen sans aide.~
@49264 = ~Pendentif~
@49265 = ~Bâton~
@49266 = ~Le plan à venir, à propos des elfes noirs et d'autres choses.~
@49267 = ~Khelben~
@49268 = ~~
@49269 = ~Nous n'avons pas besoin d'argent pour retrouver Imoen ! Nous sommes des héros ! Nous écraserons sorcier après sorcier pour la retrouver ! Hum, nous devrions commencer tout de suite, si nous voulons avoir fini avant le dîner...~
@49270 = ~Je serai heureux de t'avoir avec moi.~ ~Je serai heureuse de t'avoir avec moi.~
@49271 = ~Je n'ai pas besoin de toi pour le moment.~
@49272 = ~Très bien. Je serai toujours dans les parages quand tu changeras d'avis. Je te connais.~
@49273 = ~Bien, allons-y.~
@49274 = ~Cet homme nous a mis en contact avec les Voleurs de l'ombre, après tout. Si la vie de votre ami n'était pas en jeu, je ne le tolérerais pas un instant.~ ~Cet homme nous a mis en contact avec les Voleurs de l'ombre, après tout. Si la vie de votre amie n'était pas en jeu, je ne le tolérerais pas un instant.~
@49275 = ~Bon, très bien. Si c'est ce que tu veux, vas-y ! Ce que tu peux être têtu ! Je serai dans la taverne... la Couronne de Cuivre... Tu sais où me trouver, hein, si tu as besoin de moi.~ [IMOEN78] ~Bon, très bien. Si c'est ce que tu veux, vas-y ! Ce que tu peux être têtue ! Je serai dans la taverne... la Couronne de Cuivre... Tu sais où me trouver, hein, si tu as besoin de moi.~ [IMOEN78]
@49276 = ~Bon, très bien. Si c'est ce que tu veux, vas-y ! Ce que tu peux être têtu ! Je serai dans la taverne... la Couronne de Cuivre... Tu sais où me trouver, hein, si tu as besoin de moi.~ [IMOEN79A] ~Bon, très bien. Si c'est ce que tu veux, vas-y ! Ce que tu peux être têtue ! Je serai dans la taverne... la Couronne de Cuivre... Tu sais où me trouver, hein, si tu as besoin de moi.~ [IMOEN79A]
@49277 = ~Oui, c'est mieux ainsi.~
@49278 = ~Ah oui, Aran Linvail. Le véritable chef des Voleurs de l'ombre dans cette ville, et donc l'un des hommes les plus puissants de Féérune. Il faut rester prudent, <CHARNAME>.~
@49279 = ~Non, reste avec moi.~
@49280 = ~Si c'est ce que tu veux. J'essayerai de trouver mon chemin jusqu'à la Couronne de Cuivre, mais on serait mieux ensemble...~
@49281 = ~Premier journal de Jon Irenicus~
@49282 = ~Les Voleurs de l'ombre ? Nous allons enfin savoir pourquoi nous les intéressons autant.~
@49283 = ~Encore des voleurs ? Dois-je être uniquement confronté à ce genre d'activités dans mon association avec vous <CHARNAME> ? J'espère que non car ma patience a atteint ses limites.~
@49284 = ~Le tumulte de votre sang s'apaise, et vous regagnez la maîtrise de votre esprit comme de votre corps. De votre volonté défaillante, la quintessence de Bhaal a su tirer profit.~
@49285 = ~Et enfin : le Maître des ombres. Nous allons affronter un grand pouvoir, <CHARNAME>. Je te conseille de contrôler ton tempérament.~
@49286 = ~Par ici, petit, petit, la chasse arrive à son terme.~ [BODHIX35]
@49287 = ~Je sais que je suis en avance, mais je ne pouvais pas vous laisser partir. Tout cela était très divertissant, mais la partie est terminée. Que nos chemins se croisent dans le sang une dernière fois.~ [BODHIX36]
@49288 = ~Qu'est-ce donc ? Une créature si sombre et maléfique ! Enfant de Bhaal, qu'es-tu donc devenu ?~ [BODHIX37] ~Qu'est-ce donc ? Une créature si sombre et maléfique ! Enfant de Bhaal, qu'es-tu donc devenue ?~ [BODHIX37]
@49289 = ~Hors de ma vue ! Irenicus doit être mis au courant ! Nous nous tiendrons à distance pour tout observer !~ [BODHIX38]
@49290 = ~Vous avez mentionné un fait intéressant... Garren possède toujours l'acte de cette propriété. En avez-vous besoin ?~
@49291 = ~Ce n'est qu'une pure formalité. L'armée amnienne aurait beau venir faire des recherches sur la disgrâce de Lancevent, le fait que je possède l'acte ferait s'arrêter une bataille par trop ennuyeuse.~
@49292 = ~Second journal de Jon Irenicus~
@49293 = ~Troisième journal d'Irenicus~
@49294 = ~Je me fiche de Garren. Que se passerait-il si je devais obtenir l'acte de vous ? Je suppose qu'une petite récompense serait d'actualité...~
@49295 = ~Même mes Ménestrels nous ont utilisés. J'aurais dû m'en douter... les colliers voyants, l'invitation... Tant pis. Si Xzar faisait ce qu'elle a dit, il méritait son destin.~
@49296 = ~Alors je ferais tout pour que vous ne l'obteniez jamais. Je reviendrai pour vous détruire !~
@49297 = ~Comme sur des roulettes ! Par les Ménestrels, pas moins ! Si je dois tuer, ce sera à mes propres fins ! (Mais je n'ai jamais aimé ce nécro, ni son petit-homme, d'ailleurs...)~
@49298 = ~Nous nous sommes laissé dupés en menant un assassin à sa cible ! Qu'un tel homme mérite de mourir est un fait, mais je ne participerai pas à un tel acte !~
@49299 = ~Oh, c'est le vieux tour de « c'est l'oiseau l'assassin », c'est ça ? J'aurais dû le voir venir. Mon Cousin Belar l'a jadis joué à mon grand-oncle Tookar, bien que pour être honnête, il n'avait l'intention de tuer personne. Il est arrivé transformé en colibri pour reprendre sa forme normale, c'était une farce pour l'anniversaire de mon oncle... et le vieux gnome a eu un tel choc que son cœur a lâché. Les anciens étaient si furieux qu'ils changèrent Belar en colibri pour de bon. Cela lui plût, toutefois, et il prit son envol (cette branche de la famille a toujours été un peu perchée, si tu vois ce que je veux dire)... pour finir dévoré par un griffon une semaine plus tard. Je suppose qu'il y a toujours une justice.~
@49300 = ~Sorsha~
@49301 = ~Sorsha~
@49302 = ~Venez, espèce d'imbécile et laissez-moi prouver ma valeur à la bête que je sers !~
@49303 = ~Ne pouvons-nous pas en discuter ?~
@49304 = ~Vous ne vivrez pas au-delà de cette rencontre !~
@49305 = ~Je cherche à ce que vous relâchiez votre prisonnier. J'offrirai plus que votre maître actuel.~
@49306 = ~Mahar~
@49307 = ~Conster~
@49308 = ~Mahar~
@49309 = ~Conster~
@49310 = ~Mais nous n'aurons aucune discussion ! Je vais être victorieux, ici, ou j'en mourrais ! Regardez-moi, seigneur Firkraag ! Regardez-moi !~
@49311 = ~Vous parlez avec trop d'empressement, pauvre imbécile ! Je serai victorieux ici, ou je mourrai heureux. Soyez témoin de ma dévotion, Firkraag !~
@49312 = ~Vous n'êtes pas capable d'imaginer le prix qu'un dragon offrirait pour la loyauté ! Battez-vous, que le seigneur Firkraag voie mon dévouement !~
@49313 = ~Avez-vous retrouvé mon enfant ?~
@49314 = ~Votre enfant est mort. Firkraag a gagné. Donnez-moi le titre de propriété, Garren. Votre vie est finie.~
@49315 = ~Je me moque de votre enfant. Je suis venu pour le titre de propriété. Firkraag l'aura, ou vous mourrez.~ ~Je me moque de votre enfant. Je suis venue pour le titre de propriété. Firkraag l'aura, ou vous mourrez.~
@49316 = ~Vous êtes un monstre ! Le mal vous sied comme les écailles au serpent. Je ne plierai plus ! Meurs, traître !~ ~Vous êtes un monstre ! Le mal vous sied comme les écailles au serpent. Je ne plierai plus ! Meurs, traîtresse !~
@49317 = ~Vous m'avez trahi ? Vous m'avez vendu ? Ne reste-t-il plus de justice en ce monde ?~
@49318 = ~Donnez-moi le titre, Garren, ou vous mourrez. Faites à votre guise, votre choix m'importe peu.~
@49319 = ~La seule justice qui reste est celle que procure la force. La justice n'est pas pour les faibles de votre espèce.~
@49320 = ~Toi ! Je me souviens de toi ! Et Bouh aussi ! Un magicien lâche qui voyage avec son petit-homme malveillant !~
@49321 = ~Ah ! Quel fascinant retournement de situation ! Vous allez trahir Lancevent et me ramener l'acte ? La trahison est une habitude dangereuse, <CHARNAME>. Est-ce vraiment ce que vous voulez ?~
@49322 = ~Je me demandais quand tu te montrerais, Zhent. Je me doutais que nos derniers adieux ne seraient pas définitifs, et mes doutes étaient bien fondés.~
@49323 = ~Je ne suis pas venu pour vous parler, misérable Ménestrelle sans cœur. Je suis ici pour faire appel à votre compagnon d'antan, <CHARNAME>.~
@49324 = ~Comment osez parler ainsi de ce pauvre Monty ! Je ne suis pas là pour vous parler de toute façon, vous avez trouvé le moyen d'excuser un rôdeur. Je suis ici pour demander une faveur à <CHARNAME>.~
@49325 = ~Une faveur ? Que voulez-vous ?~
@49326 = ~Auriez-vous oublié notre dernière rencontre, nécromancien...~
@49327 = ~Ne devriez-vous pas être mort, Xzar ?~
@49328 = ~Appel ? Que voulez-vous ?~
@49329 = ~Peut être avez-vous oublié notre dernière rencontre...~
@49330 = ~Qu'en avez-vous à faire de ce que je pense ? Voulez-vous l'acte oui ou non ?~
@49331 = ~Pour autant que je m'en souvienne, Xzar, vous devriez être mort.~
@49332 = ~C'est ce que je veux.~
@49333 = ~Cela dépend de ce que vous pensez offrir en échange.~
@49334 = ~La récompense sera choisie par mes soins. La tâche est assez facile. Garren est vieux et éreinté.~
@49335 = ~Sommes-nous d'accord ?~
@49336 = ~Je ne ferai rien sans une récompense importante.~
@49337 = ~Vous n'êtes qu'un être cupide. Nous ne sommes pas d'accord, loin s'en faut.~
@49338 = ~Très bien. Allez voir Garren Lancevent et trouvez l'acte des collines de Lancevent. Je me fiche qu'il vive ou qu'il meure. Conster ! Allez vous occuper de l'enfant. On n'a plus besoin d'eux. <CHARNAME>, revenez lorsque vous aurez l'acte.~
@49339 = ~Prends garde, <CHARNAME>, les Ménestrels ne toléreront pas la moindre ingérence, et ce Zentharim a sûrement les pires intentions dans l'âme.~
@49340 = ~L'homme empoisonné était un Ménestrel ? C'est une organisation qui fait de bonnes choses, <CHARNAME>, quoi que l'on puisse dire. Je ne souffrirai aucune tentative de ce crétin de les mettre en péril.~
@49341 = ~S'il y a des Ménestrels dans cette ville, ils protégeront leur vie privée. Et durement. Je méfierais de tout ce que cet... homme... te demande de faire.~
@49342 = ~Oui, oui, je ne vous demande pas de rentrer et de les massacrer, n'est-ce pas ? Aussi tentant que cela puisse être, je ne suis pas aussi stupide que vos amis ne pourraient le penser.~
@49343 = ~Que voulez-vous exactement de moi ?~
@49344 = ~Je n'ai pas l'intention de me frotter aux Ménestrels, malgré vos garanties.~
@49345 = ~Je n'ai pas l'intention de faire que ce soit pour vous, Xzar.~
@49346 = ~Acte de propriété des collines de Lancevent~
@49347 = ~Si tu veux enquêter pour savoir ce qui est arrivé à l'espion, c'est ton choix, <CHARNAME>. Je conseille la prudence, et un peu de bon sens.~
@49348 = ~Si les Ménestrels acceptent de nous parler, ce dont je doute, ils n'iront pas jusqu'à nous dire ce qu'ils ont fait du petit-homme.~
@49349 = ~Te voilà de retour. Apportes-tu le parchemin dans ces vertes collines ? Apportes-tu l'acte ?~ [FIRKRA14]
@49350 = ~J'ai ramené l'acte. Quelle récompense m'offrez-vous en échange ?~
@49351 = ~Tu aimerais parler aux Ménestrels et délivrer le compagnon de ce maudit homme ? En voilà une quête mystérieuse... mais je n'ai jamais fait confiance aux Ménestrels. Cela pourrait être intéressant.~
@49352 = ~Je n'ai pas encore récupéré l'acte.~
@49353 = ~Les Ménestrels ne nous diront pas facilement ce qui est arrivé à son espion... mais ils pourraient répondre à quelques questions, car nous les avons aidés avec l'autre homme.~
@49354 = ~Ce fou aurait été réduit en poussière s'il s'était fait prendre. Apportez une urne. Xzar fera une drôle de tête quand nous reviendrons avec les cendres de Montaron. Ha !~
@49355 = ~Vous aurez droit à un objet de ma réserve. Utilisez cette cape et soyez reconnaissant non seulement de vivre, mais aussi d'avoir profité de notre rencontre. Allez-vous-en maintenant et ne revenez plus.~ ~Vous aurez droit à un objet de ma réserve. Utilisez cette cape et soyez reconnaissante non seulement de vivre, mais aussi d'avoir profité de notre rencontre. Allez-vous-en maintenant et ne revenez plus.~
@49356 = ~Yoshimo, tout s'est passé selon mes instructions ?~
@49357 = ~Ou-oui, maître Irenicus, comme tu le souhaitais.~
@49358 = ~Alors ne m'ennuyez plus avant de revenir avec.~
@49359 = ~Yoshimo, de quoi parles-tu ?~
@49360 = ~Traître ! Tu connais cette créature maléfique ?~
@49361 = ~Ce n'est pas un traître, <CHARNAME>. Il a fait preuve d'une loyauté exemplaire depuis le début. Envers moi.~
@49362 = ~Il parle de loyauté, <CHARNAME>, de sa loyauté à mon égard dans toutes ses épreuves.~
@49363 = ~Merci, maître Irenicus.~
@49364 = ~Tu es peut-être déçu, mais je suis satisfait. Mes serviteurs ont démontré leur maîtrise des herbes et de l'illusion. Tes repas en mer étaient préparés exactement selon mes recommandations.~ ~Tu es peut-être déçue, mais je suis satisfait. Mes serviteurs ont démontré leur maîtrise des herbes et de l'illusion. Tes repas en mer étaient préparés exactement selon mes recommandations.~
@49365 = ~De quoi parles-tu ? Que se passe-t-il ici ?~
@49366 = ~Je te combattrai ! Tu vas le payer !~
@49367 = ~Je peux repousser une embuscade. Tes paroles ne m'inquiètent pas.~
@49368 = ~Allez-y mes mignons ! Accomplissez votre destinée et détruisez les intrus ! Même le Maître sera impressionné de ces transmutations ! Allez !~
@49369 = ~Je ne vois pas mon serviteur avec toi. Je me demande si tu as découvert la trahison de Yoshimo ? J'en serai très surpris. Il était très bon.~
@49370 = ~Ton destin était écrit bien avant ton arrivée. Un simple additif à tes rations et à tes repas par un maître herboriste, Saemon Havarian.~
@49371 = ~Je ne participerai à aucune tentative de dévaliser le temple de Lathandre, <CHARNAME>. Si vous vous sentez obligé de continuer dans cette voie, alors vous le ferez seul. Peut-être nous reverrons-nous un jour.~ ~Je ne participerai à aucune tentative de dévaliser le temple de Lathandre, <CHARNAME>. Si vous vous sentez obligée de continuer dans cette voie, alors vous le ferez seule. Peut-être nous reverrons-nous un jour.~
@49372 = ~C'est un crime atroce que tu envisages de commettre <CHARNAME> même si je comprends tes motivations. Je te suis... pour l'instant... mais si tu décides de mettre en œuvre de tels actes, je partirai.~
@49373 = ~Ruhk Transmutateur~
@49374 = ~Bien que je sache où cela mène, un pareil vol dans la maison de Lathandre me laisse très amère. Nous devrions prendre garde à ne pas devenirs pareils à ceux que nous voulons condamner.~
@49375 = ~Ruhk Transmutateur~
@49376 = ~Transformation en Écorcheur~
@49377 = ~Tu veux vraiment piller le temple de Talos, hein ? Mazette, ce n'est pas une mince affaire. J'ai jadis eu un compagnon qui s'est risqué à subtiliser un objet ou deux au nez et à la barde des talassiens... et je parle de lui au passé, naturellement, car les talassiens ont la passion des éclairs, or ce soir-là, mon ami avait confondu ses bottes en acier avec ses bottes « Le Présent de Talos », et il en a subi les conséquences prévisibles. C'est vrai, bien que ça ait l'air d'une plaisanterie. Tu ne serais pas résistant à l'électricité, par hasard ?~ ~Tu veux vraiment piller le temple de Talos, hein ? Mazette, ce n'est pas une mince affaire. J'ai jadis eu un compagnon qui s'est risqué à subtiliser un objet ou deux au nez et à la barde des talassiens... et je parle de lui au passé, naturellement, car les talassiens ont la passion des éclairs, or ce soir-là, mon ami avait confondu ses bottes en acier avec ses bottes « Le Présent de Talos », et il en a subi les conséquences prévisibles. C'est vrai, bien que ça ait l'air d'une plaisanterie. Tu ne serais pas résistante à l'électricité, par hasard ?~
@49378 = ~Écorcheur~
@49379 = ~Écorcheur~
@49380 = ~Subtiliser dans le temple du dieu des Tempêtes ne t'attirera certainement pas la gratitude des prêtres talassiens, <CHARNAME>. Mieux vaut procéder avec prudence dans cette tâche.~
@49381 = ~Il... il nous envoie piller un temple ? J'en tremble d'avance, même si c'est celui de Talos. Jusqu'où nous abaisserons-nous pour sauver votre amie, <CHARNAME> ?~
@49382 = ~Idiots ! Le Maître ne souffrira aucune incompétence ! Vous devez nettoyer ses golems favoris et votre travail est pitoyable ! Le Maître est furieux ! Il leur accorde plus de valeur qu'à cent d'entre vous !~
@49383 = ~Les jours deviennent plus dangereux, et les ombres de bois s'allongent. Il faut faire quelque chose avant que les animaux ne nous submergent !~
@49384 = ~Il est bon de savoir que c'est notre dernière tâche. Je n'apprécie pas les chasseurs de prime, mais nous devons trouver ce voleur et en finir au plus vite.~
@49385 = ~On pourrait se demander comment une telle assemblée considérerait un traître. Le rivvin serait soit un démon, soit un saint. Quoi qu'il en soit, hâtons-nous de donner la chasse à ce pleutre, si c'est là notre tâche.~
@49386 = ~Nous devons traquer quelqu'un ? Pourrait-on se débrouiller pour... prendre sa dague à cet homme sans... lui faire de mal ? Je me sens si... sale, à l'idée de travailler pour des bandits de cette espèce, <CHARNAME>.~
@49387 = ~De quoi parles-tu ? Le seul traître ici, c'est toi.~
@49388 = ~Yoshimo ? Il a toujours été loyal depuis notre rencontre dans... ton donjon...~
@49389 = ~Je n'y crois pas. Tu l'accuses alors qu'il ne peut se défendre. C'est un mensonge.~
@49390 = ~Nous faire mieux, grosse brute ! Gerg pas s'être engagé pour se faire baffer par sale chien.~
@49391 = ~Non, non, pas taper, le chien ! Ça fait mal ! Ça fait mal !~
@49392 = ~Non, tu as connu la trahison de l'intérieur. Jamais ils n'ont agi contre ma volonté. Yoshimo a bien prouvé sa valeur, avec un peu d'encouragement.~
@49393 = ~Tu te trompes, ordure ! Le chien, c'est celui qui rampe, et cela ne peut être que toi !~
@49394 = ~Grrr... qui est le prochain dont je goûterai le sang ?~ ~Grrr... qui est la prochaine dont je goûterai le sang ?~
@49395 = ~Et s'il ne l'avait pas fait, alors Saemon Havarian aurait scellé ton destin. De toutes manières, tu as déjà perdu.~
@49396 = ~Gerg pas prêt à mourir dans ce trou puant ! Moi partir !~
@49397 = ~Je va retourner à la butte. Pas de maître pour moi !~
@49398 = ~Quoi ? Je te ferai échouer dans cette trahison !~
@49399 = ~Cet idiot ? Je vais le pourchasser après t'avoir tué !~
@49400 = ~Je peux repousser une embuscade. Tu n'obtiendras rien en essayant de te battre.~
@49401 = ~Tu nous prends pour des imbéciles ? Tout le pouvoir et l'influence que les Ménestrels obtiennent pendant leur « service » ne serait que pure coïncidence ?~
@49402 = ~Et la puissance que tes compagnons acquièrent en maintenant cet équilibre ne veut rien dire pour toi ? J'ai du mal à croire que les Ménestrels soient capables d'un tel altruisme.~
@49403 = ~Ainsi, tu combats les excès du bien comme du mal ? Comment peux-tu faire la différence ? Et le pouvoir accumulé par ta propre organisation équilibre le tout, n'est-ce pas ?~
@49404 = ~Oui, c'est une construction étrange de la part des Ménestrels. Je n'ai jamais entendu parler d'un endroit aussi riche que celui-ci. La consigne était de garder le secret.~
@49405 = ~~
@49406 = ~C'est pure folie ! Tu as perdu la tête !~
@49407 = ~~
@49408 = ~Je ne vous le conseille pas, Jaheira. Les gardiens pourraient ne pas vous reconnaître sans les... protections appropriées. Mieux vaut ne pas les déranger sans une raison vitale.~
@49409 = ~C'est pure folie ! Tu as perdu la tête !~
@49410 = ~Je suis une Ménestrelle, Meronia. Puis-je parler à ces gardes ? Je présume que ce sont des harpistes fantômes.~
@49411 = ~Capitaine~
@49412 = ~~
@49413 = ~~
@49414 = ~Ils toléreront mon attitude tant que j'en déciderai ainsi, mon garçon, sinon ils seront coupés en deux par ma hache, tout comme toi.~
@49415 = ~Oh, je ne marche jamais sur les pieds... à part, peut-être, par accident. Si on marchait sur les pieds de Bouh pour de vrai, les orteils voleraient glorieusement dans le sillage de mon épée !~
@49416 = ~Eh bien, on m'a parlé d'une méthode pour te faire tournoyer la tête, mon garçon. Ou du moins, celle de ma tante Patty. Oncle Rufus y a longuement et durement travaillé, je peux te le dire, tant et si bien que Patty a eu mal au cou pendant des semaines. Elle ne lui a jamais vraiment pardonné, mais c'est l'essence même des expériences, enfin c'est ce qu'ils en disent.~
@49417 = ~Oui. Ne laisse jamais personne t'affirmer, bige, que la force brute est ce qui permet de jauger la valeur d'un homme. L'esprit sournois et retors fera toujours la décision finalement, même contre ceux qui se sont conçus invincibles.~
@49418 = ~Ne te vante pas autant de vos plans avec les Ménestrels, mon garçon, tu risques de rencontrer un de ceux qui sont concernés... et qui pourrait t'arracher les tripes.~
@49419 = ~Oui... j'ai remarqué tes amulettes. Je connaissais les broches des Ménestrels, mais pas ceci. Est-ce une coutume locale ?~
@49420 = ~Bodhi et moi venons de te transmettre la malédiction qui nous frappait. Inutile de me remercier, je l'ai fait de bon cœur. Tu finiras par nous implorer de te laisser mourir. La nôtre n'est plus, mais la tienne ne fait que commencer. Tu te faneras, tu te flétriras et tu mourras.~ [IRENIC49]
@49421 = ~Acte de propriété amnien officiel pour le terrain des collines de Lancevent et alentour. Le nom sur l'acte est celui de Garren Lancevent.~
@49422 = ~Acte de propriété amnien officiel pour le terrain des collines de Lancevent et alentour. Le nom sur l'acte est celui de Garren Lancevent.~
@49423 = ~~
@49424 = ~~
@49425 = ~Tu aurais pu te douter de quelque chose, si tu avais su pour Yoshimo. Mais ma petite drogue n'en aurait pas fait moins d'effets. Il suffit d'un ingrédient magique versé dans une soupe pour que tout finisse bien.~ [IRENIC43]
@49426 = ~C'était son idée. Le meilleur moyen de te capturer indemne. Bien entendu... ta santé est désormais sans importance.~ [IRENIC44]
@49427 = ~Irenicus ! Je t'ai bien servi ! Par pitié !~
@49428 = ~Calme-toi, Yoshimo, et arrête de déblatérer sur la mort. Tu es en sécurité maintenant, et mes projets pour <CHARNAME> dépassent le simple meurtre. Tu le constateras bien assez tôt.~
@49429 = ~Ou-oui, maître Irenicus, comme tu le souhaitais.~
@49430 = ~Yoshimo, tout s'est passé selon mes instructions ?~
@49431 = ~Je ne vois pas mon serviteur avec toi. Je me demande si tu as découvert la trahison de Yoshimo ? J'en serai très surpris. Il était très bon.~
@49432 = ~Ton destin était écrit bien avant ton arrivée. Un simple additif à tes rations et à tes repas par un maître herboriste, Saemon Havarian.~
@49433 = ~Temple de Rillifane~
@49434 = ~Euh... Yoshimo, de quoi parles-tu ?~
@49435 = ~Traître ! Tu connais cette créature maléfique ?~
@49436 = ~Ce n'est pas un traître, <CHARNAME>. Il a fait preuve d'une loyauté exemplaire depuis le début. Envers moi.~
@49437 = ~Il parle de loyauté, <CHARNAME>, de sa loyauté à mon égard dans toutes ses épreuves.~
@49438 = ~Tu es peut-être déçu, mais je suis satisfait. Mes serviteurs ont démontré leur maîtrise des herbes et de l'illusion. Tes repas en mer étaient préparés exactement selon mes recommandations.~ ~Tu es peut-être déçue, mais je suis satisfait. Mes serviteurs ont démontré leur maîtrise des herbes et de l'illusion. Tes repas en mer étaient préparés exactement selon mes recommandations.~
@49439 = ~De quoi parles-tu ? Que se passe-t-il ici ?~
@49440 = ~Je te combattrai ! Tu vas le payer !~
@49441 = ~Je peux repousser une embuscade. Tes paroles ne m'inquiètent pas.~
@49442 = ~De quoi parles-tu ? Le seul traître ici, c'est toi.~
@49443 = ~Yoshimo ? Il a toujours été loyal depuis notre rencontre dans... ton donjon...~
@49444 = ~Je n'y crois pas. Tu l'accuses alors qu'il ne peut se défendre. C'est un mensonge.~
@49445 = ~Non, tu as été usurpé de l'intérieur. Jamais ils n'ont agi contre ma volonté. Yoshimo a certainement prouvé sa valeur.~ ~Non, tu as été usurpée de l'intérieur. Jamais ils n'ont agi contre ma volonté. Yoshimo a certainement prouvé sa valeur.~
@49446 = ~Et s'il ne l'avait pas fait, alors Saemon Havarian aurait scellé ton destin. De toutes manières, tu as déjà perdu.~
@49447 = ~Quoi ? Je te ferai échouer dans cette trahison !~
@49448 = ~Cet idiot ? Je vais le pourchasser après t'avoir tué !~
@49449 = ~Je peux repousser une embuscade. Tu n'obtiendras rien en essayant de te battre.~
@49450 = ~Vous m'aviez dit que j'avais une chance de m'enfuir ! Vous ne m'en avez pas donné le temps !~
@49451 = ~Je m'attendais à votre venue. Vous auriez été folle de me laisser atteindre Irenicus.~
@49452 = ~Venez, il doit y avoir quelque chose que je puisse faire pour vous apaiser.~
@49453 = ~Je voudrais le croire, mais ça n'est pas vrai, hein ? Tout a changé maintenant... maintenant que nous sommes... pareils ?~ ~Je voudrais le croire, mais ça n'est pas vrai, hein ? Tout a changé maintenant... maintenant que nous sommes... pareilles ?~
@49454 = ~Je suppose... si on peut se mesurer à lui. Nous sommes très affaiblis après ce qu'il... ce qu'il nous a fait.~ ~Je suppose... si on peut se mesurer à lui. Nous sommes très affaiblies après ce qu'il... ce qu'il nous a fait.~
@49455 = ~<CHARNAME>, il m'a montré ce que tu es et... ce que je suis. Et ensuite il me l'a enlevé.~
@49456 = ~Je ne sais plus qui je suis, <CHARNAME>. Tu ne le sens peut-être pas encore, mais moi, le rituel m'a comme complètement vidée.~
@49457 = ~Il a pris quelque chose de vital... il a dit que c'était mon âme divine ? Je découvre que je suis la fille d'un dieu et me voilà du même coup vide et mourante. Et toi aussi...~
@49458 = ~Nous survivrons en nous aidant mutuellement, comme tu m'as aidé dans le rêve pendant le rituel.~ ~Nous survivrons en nous aidant mutuellement, comme tu m'as aidée dans le rêve pendant le rituel.~
@49459 = ~Je suis fort, je ne me laisserai pas dépérir. J'ai bien survécu au combat dans le rêve, non ?~ ~Je suis forte, je ne me laisserai pas dépérir. J'ai bien survécu au combat dans le rêve, non ?~
@49460 = ~Imoen, nous nous en sortirons très bien. Tu apprendras à tenir le coup comme moi. Ça n'est pas si terrible.~
@49461 = ~Alors abandonne et meurs. Il m'a pris la même chose qu'a toi, mais moi je continuerai à me battre. Je le dois.~
@49462 = ~Les choses qu'il m'a montrées étaient si sombres et hideuses... mais une partie de moi adorait ça. Je ne m'étais encore jamais préoccupée de ce genre de choses. Maintenant ma vie n'est que l'attente de la mort...~
@49463 = ~Le rêve ? <CHARNAME>, je n'ai pas fait de rêve pendant le rituel. Je n'ai senti que l'obscurité, et ma volonté qui m'échappait.~
@49464 = ~Je suis désolée, les choses qu'il m'a montrées étaient si sombres et hideuses... mais une partie de moi adorait ça. Je ne m'étais encore jamais préoccupée de ce genre de chose. Maintenant ma vie n'est que l'attente de la mort...~
@49465 = ~Récupérer le titre de propriété des collines de Lancevent

J'ai conclu un marché avec Firkraag le dragon. Si je parviens à reprendre le titre de propriété des collines de Lancevent à Garren Lancevent et que je le ramène à Firkraag, je recevrai une récompense.~
@49466 = ~Te voilà donc ! Pourquoi te bats-tu encore ? Tu es déjà mort intérieurement. Irenicus s'en est chargé. Je suis ici pour détruire ton enveloppe physique.~ [YOSHIM66] ~Te voilà donc ! Pourquoi te bats-tu encore ? Tu es déjà morte intérieurement. Irenicus s'en est chargé. Je suis ici pour détruire ton enveloppe physique.~ [YOSHIM66]
@49467 = ~Traître ! Tu vas mourir pour ce que tu as fait !~
@49468 = ~Yoshimo, comment as-tu pu ? Nous avons voyagé ensemble si longtemps !~
@49469 = ~Il ne pourra pas réussir. Tu devrais reconsidérer ton allégeance envers lui.~
@49470 = ~Je me bats car il le faut. Tu sais que j'ai raison. Tu me connaissais bien...~
@49471 = ~Libère ta colère, si tu en es si sûr de ton fait. Je doute cependant que tu survives bien longtemps. Abandonne-moi, je ne m'embarrasserai pas d'excuses, je ne peux rien contre ses sorts.~ [YOSHIM67] ~Libère ta colère, si tu en es si sûre de ton fait. Je doute cependant que tu survives bien longtemps. Abandonne-moi, je ne m'embarrasserai pas d'excuses, je ne peux rien contre ses sorts.~ [YOSHIM67]
@49472 = ~La mission de Firkraag est achevée

J'ai rapporté le titre de propriété des collines de Lancevent à Firkraag. Il m'a donné une cape magique pour me remercier. Il me conseille de partir, maintenant que ma tâche est terminée.~
@49473 = ~Pas de rédemption, pas de seconde chance ! Il faut vaincre ! Je cours vers l'enfer promis par Irenicus ! Ilmater a pris mon âme, je n'ai pas le choix ! Finissons-en !~ [YOSHIM68]
@49474 = ~Tu auras le nom que tu mérites ! Tu es l'ennemi de feu la juste Dynahéir, ce qui fait de toi mon ennemi ! Tu mourras pour le bien de tous !~
@49475 = ~La Faucheuse Impie~
@49476 = ~Récupérer le titre de propriété des collines de Lancevent

J'ai obtenu le titre de propriété de Lancevent auprès de Garren, mais il ne me l'a pas donné de son plein gré. Je n'ai plus qu'à retourner dans l'antre de Firkraag pour obtenir ma récompense.~
@49477 = ~Ir'revrykal +5~
@49478 = ~Ah, voici le piètre protecteur de cette sorcière rashémie. T'es-tu enfin occupé d'elle une fois pour toutes, rôdeur ? Est-elle en train de se faire ronger par les vers, comme elle le devrait ?~
@49479 = ~Tu ne parleras pas de la douce Dynahéir de la sorte ! La terrible justice du hamster va s'abattre sur toi ! VISE LES YEUX, BOUH, VISE...~
@49480 = ~Silence ! Tu as adhéré à la guilde de Mae'Var avec ton groupe, rôdeur. Veux-tu déjà ruiner vos plans ? Crois-tu que ton chef appréciera ?~
@49481 = ~Je... non. Non, notre cause ne doit pas être bouleversée. La légitime fureur attendra pour l'heure, mais un jour, le magicien paiera ses paroles de son sang ! Minsc en fait le serment !~
@49482 = ~Bien, nous verrons combien de temps ton épée résiste à ma magie. Mais assez radoté ! Toi, là, <PRO_RACE>, tu sembles être responsable de ce groupe. Finissons-en.~
@49483 = ~Je ne suis pas resté aussi longtemps avec <CHARNAME> pour qu'il se fasse tuer. Cela aurait pu arriver une douzaine de fois.~ ~Je ne suis pas resté aussi longtemps avec <CHARNAME> pour qu'elle se fasse tuer. Cela aurait pu arriver une douzaine de fois.~
@49484 = ~Tu ne me reconnais pas, Edwin ? C'est moi, <CHARNAME>.~
@49485 = ~Travailler avec toi, Thayen ? Plutôt me noyer dans les égouts !~
@49486 = ~D'accord. Mae'Var m'a dit de venir te voir pour rendre un service. Que désires-tu ?~
@49487 = ~Le château de'Arnise a été envahi

Le capitaine Arat m'a dit qu'il tenterait de repousser autant d'ennemis que possible avec ses hommes, mais je dois leur ouvrir le pont-levis. La roue permettant d'ouvrir le pont-levis doit certainement se trouver sur les remparts du château, juste au-dessus du pont-levis.~
@49488 = ~Le château de'Arnise a été envahi

J'ai baissé le pont-levis du château, et comme promis, le capitaine Arat et ses soldats ont repoussé la plupart des ennemis. Cela devrait faciliter la percée dans le château.~
@49489 = ~Tu as une mémoire sélective, Sorcier Rouge. Pourquoi travailles-tu maintenant avec les Voleurs de l'ombre, et quel est ton rôle dans notre capture par Irenicus ? Khalid est mort et j'obtiendrai une réponse !~
@49490 = ~Je sais que je suis macabre, mais j'ai été seule ici tellement longtemps. Et je n'ai pas ta longue expérience du problème. C'est comme un mauvais rêve.~
@49491 = ~Je n'ai rien à voir avec la mort de ton mari, druide... et pour tes réponses, tu devrais aller voir en plus haut lieu.~
@49492 = ~Je ne cherche nullement à attirer l'attention des Mages cagoulés, <CHARNAME>, mais cela ne me déplaît pas non plus d'éliminer un de leurs membres. Faites comme bon vous semble.~
@49493 = ~Nous... nous allons rien moins que partir assassiner quelqu'un ? Parce qu'il nous l'ordonne ? Je... je ne pense pas que ce soit bien, <CHARNAME>. Nous n'allons pas vraiment le faire, n'est-ce pas ?~
@49494 = ~Cesse tes jérémiades, femme ! Je ne crois pas qu'il existe un seul Mage cagoulé qui ne mérite pas une mort rapide, nous n'avons apparemment pas le choix.~
@49495 = ~Assez, elfe ! Un bon coup de hache dans le dos d'un sorcier, ça ne fait jamais de mal ! Nous sommes venus ici dans un but précis, je te le rappelle !~
@49496 = ~Ce rôle d'assassin me déplaît, <CHARNAME>. Cependant, il serait très naïf de tenir un Mage cagoulé pour une créature innocente. Mettons-nous à l'œuvre, si vous êtes déterminé.~ ~Ce rôle d'assassin me déplaît, <CHARNAME>. Cependant, il serait très naïf de tenir un Mage cagoulé pour une créature innocente. Mettons-nous à l'œuvre, si vous êtes déterminée.~
@49497 = ~N'as-tu pas peur d'attirer la colère des Mages cagoulés, <CHARNAME> ? J'espère que les Voleurs de l'ombre seront blâmés à notre place pour ce forfait.~
@49498 = ~Et toi aussi. Tu m'as donné terriblement de mal dans mes rêves, surtout pendant le dernier rituel.~
@49499 = ~Et pourtant tu avais l'air si sûre de toi quand tu m'aidais dans mon rêve.~
@49500 = ~Ça a eu un effet différent sur toi ? Tu ressens l'essence de Bhaal depuis plus longtemps... sans doute la contrôles-tu mieux...~
@49501 = ~Ou peut-être te contrôle-t-elle mieux.~
@49502 = ~Je n'en sais rien. De toute façon, nous devons récupérer ce qu'Irenicus nous a pris.~
@49503 = ~Qu'est-ce que tu veux dire ? Nous sommes pareils maintenant que tu en as conscience. C'est ça ?~ ~Qu'est-ce que tu veux dire ? Nous sommes pareilles maintenant que tu en as conscience. C'est ça ?~
@49504 = ~C'est pas le moment de philosopher. Ça attendra qu'Irenicus ait payé.~
@49505 = ~Encore une insulte comme celle-là, sorcier, et tu pleureras en voyant tes tripes pendre de ton ventre. On va s'occuper de ta petite affaire, mais tu n'as pas besoin de la ramener.~
@49506 = ~Mon courroux est difficile à maîtriser ! Parle-nous comme si nous étions tout sauf des héros, sorcier, et tu recevras la juste raclée que tu mérites !~
@49507 = ~Voilà le genre de loyauté dont rêveraient toutes les familles. Je devrais en faire un roman... « La Main Droite dont Mae'Var n'avait jamais voulue ». Ah, oui, tous les voleurs du monde s'en gonfleraient d'orgueil !~
@49508 = ~Tu as choisi une voie dangereuse, sorcier. D'après tes dires, tu n'es qu'un opportuniste. Non pas que je pense que nous devrions nous plaindre...~
@49509 = ~Vous vous retournez contre votre maître après toutes ces années de service ? Non pas que je n'ai rien à reprocher à Mae'Var, mais... vous êtes vraiment un homme malfaisant.~
@49510 = ~L'ennemi de Dynahéir nous accompagne ? De grâce, <CHARNAME>, dis-moi que cela ne va pas arriver ! Et si ça le doit, fais que ce soit bref ! Bouh tremble d'un juste courroux et je ne peux l'en blâmer !~
@49511 = ~Ce Sorcier Rouge est un danger public ! J'espère qu'il nous quittera bientôt. Sa présence finira par mettre notre mission en péril... et s'il continue à proférer ses blasphèmes, cela ne saurait tarder.~
@49512 = ~Êtes-vous bien sûr de vouloir permettre à cette ordure de se joindre à nous ? Tout ce que je tiens pour néfaste dans la magie est doublement vrai chez quelqu'un comme cet Edwin. Il nous trahira, souvenez-vous de ce que je vous dis.~ ~Êtes-vous bien sûre de vouloir permettre à cette ordure de se joindre à nous ? Tout ce que je tiens pour néfaste dans la magie est doublement vrai chez quelqu'un comme cet Edwin. Il nous trahira, souvenez-vous de ce que je vous dis.~
@49513 = ~La mort n'est souvent qu'un inconvénient temporaire pour les gens comme moi. Mon ultime mission est trop importante pour me laisser distraire par des nigauds.~
@49514 = ~Je me souviens de toi, Edwin. Si ma mémoire est bonne, tu devrais être mort.~
@49515 = ~Je me souviens de toi, Edwin. Si ma mémoire est bonne, tu devrais être mort.~
@49516 = ~Je veux être payé d'avance. Vous voulez de l'aide. Donnez-moi un peu d'or tout de suite ou je m'en vais.~ ~Je veux être payée d'avance. Vous voulez de l'aide. Donnez-moi un peu d'or tout de suite ou je m'en vais.~
@49517 = ~Je veux être payé d'avance. Vous voulez de l'aide. Donnez-moi un peu d'or tout de suite ou je m'en vais.~ ~Je veux être payée d'avance. Vous voulez de l'aide. Donnez-moi un peu d'or tout de suite ou je m'en vais.~
@49518 = ~Pas question ! Les rodomontades ne sont pas les bienvenues ici. Si le salaire ne vous plaît pas, il ne fallait pas accepter le travail. Revenez lorsque vous saurez faire preuve de courtoisie.~
@49519 = ~C'est une manière... égoïste de faire des affaires. Je suppose que les citadins agissent tous comme ça. Très bien, je suis autorisé à vous offrir 300 pièces d'or d'avance.~
@49520 = ~Ce n'est vraiment pas grand-chose, mais il faudra que cela fasse l'affaire. Dites-moi ce qui se passe.~
@49521 = ~Vous m'insultez ! Je suis un aventurier estimé ! Je ne vais pas passer mon temps à patauger dans la boue pour 300 malheureuses pièces d'or !~ ~Vous m'insultez ! Je suis une aventurière estimée ! Je ne vais pas passer mon temps à patauger dans la boue pour 300 malheureuses pièces d'or !~
@49522 = ~Mes rêves avaient aussi un aspect malveillant. Je me demande s'il n'y avait pas une autre volonté derrière tout ça.~
@49523 = ~Je l'ignore. Même morts, il faut se méfier des dieux. Quoi qu'il en soit, nous devons donner priorité à notre existence mortelle.~
@49524 = ~Je l'espère. Mais je m'inquiète de ce que l'avenir nous réserve. Âme divine ou pas, nous sommes en face d'une sacrée menace pour nos existences mortelles.~
@49525 = ~Je ne sais pas. Tu m'as décrit quelque chose de très différent que ce dont j'ai fait l'expérience. Quoi qu'il en soit, nous courons le même danger pour nos existences mortelles.~
@49526 = ~Je suis d'accord. Âme divine ou pas, une terrible menace pèse sur nos existences mortelles. Je m'inquiète de ce qui va arriver maintenant.~
@49527 = ~Je sens que je m'affaiblis, <CHARNAME>, et ça ne fait que quelques jours que j'ai été soumise au rituel.~
@49528 = ~Si nous n'inversons pas ce qu'il nous a fait... si nous ne récupérons pas nos âmes... nous allons sûrement mourir tous les deux.~ ~Si nous n'inversons pas ce qu'il nous a fait... si nous ne récupérons pas nos âmes... nous allons sûrement mourir toutes les deux.~
@49529 = ~Alors allons-y. Rejoins le groupe et échappons-nous d'ici tout de suite.~
@49530 = ~Khelben~
@49531 = ~Il faut donc partir sans délai. Rejoins le groupe et allons-y. Ne perdons plus de temps.~
@49532 = ~D'accord, mais il y a un problème. Je suis désolé, Imoen, mais je n'ai plus de place pour toi.~ ~D'accord, mais il y a un problème. Je suis désolée, Imoen, mais je n'ai plus de place pour toi.~
@49533 = ~Si Bodhi ne mentait pas quant à nous obtenir un délai, notre seule chance de survie est certainement de sortir d'ici et de retrouver Irenicus.~
@49534 = ~Tu devrais y réfléchir, <CHARNAME>. S'il y a une organisation dans cette ville qui peut t'aider, ce sont bien les Voleurs de l'ombre.~
@49535 = ~TOI, tu vas sans doute mourir. MOI, je vais poursuivre Irenicus. Adieu.~
@49536 = ~Bah ! Allons-nous-en d'ici, mes amis. Nous n'avons pas besoin du genre de « travail » que ces chiens ont à offrir, et je ne pense pas non plus pouvoir supporter de leur être associé.~
@49537 = ~Mon équipe est équilibrée et il n'y a plus de place pour toi. Peux-tu sortir d'ici par tes propres moyens ?~
@49538 = ~Ne sois pas stupide. Les voleurs de cette ville ont des coffres pleins d'or ! Il n'y a aucune raison de le faucher, sauf pour un ventre jaune !~
@49539 = ~Bien. Ça m'a manqué de voyager avec toi, <CHARNAME>, même dans les moments difficiles.~
@49540 = ~Que fais-tu de la conscience, nain ? Et de la moralité ? <CHARNAME> sait peut-être ce qui est le mieux.~
@49541 = ~Quoi ? Je... je sais bien que ça fait longtemps que nous n'avons pas voyagé ensemble, mais de là à me laisser tomber si facilement... après tout ce qui s'est passé ?~
@49542 = ~P... peut-être que <CHARNAME> n'a tout bonnement pas envie d'offrir son bras à ces bandits, Korgan ! Peut-être <CHARNAME> a-t-il une conscience, lui, ça ne vous a pas traversé l'esprit ?~ ~P... peut-être que <CHARNAME> n'a tout bonnement pas envie d'offrir son bras à ces bandits, Korgan ! Peut-être <CHARNAME> a-t-elle une conscience, elle, ça ne vous a pas traversé l'esprit ?~
@49543 = ~Pfeh ! S'il fallait choisir entre la conscience et l'or, je pourrais compter sur les doigts d'une main le nombre de secondes qu'il faudrait pour résoudre le problème. Arrête tes sornettes, fillette.~
@49544 = ~Je... je dois pouvoir me glisser dehors seule... peut-être... je... je ne sais pas.~
@49545 = ~Ça me va. Allez.~
@49546 = ~Je suis désolé. Sois prudente, surtout. J'espère que nous nous reverrons.~ ~Je suis désolée. Sois prudente, surtout. J'espère que nous nous reverrons.~
@49547 = ~Bon d'accord, rejoins le groupe. On va sortir d'ici ensemble.~
@49548 = ~Je... je vais essayer de retourner à... Athkatla, c'est ça ? Il y a une auberge là-bas... la Couronne de Cuivre ? Je tenterai d'y arriver.~
@49549 = ~J'espère que nous nous reverrons, <CHARNAME>. Je suppose qu'en quelque sorte tu es... mon frère...~ ~J'espère que nous nous reverrons, <CHARNAME>. Je suppose qu'en quelque sorte tu es... ma sœur...~
@49550 = ~Hé, hé... surtout pas avec cette nouvelle guilde dans les rues, hein, Bloodscalp ? Je me disais que c'est un sacré surnom que tu as là. D'où te vient-il ? De sérieux problèmes de pellicules ? Si c'est le cas, Ma Jansen fait le meilleur des baumes de navets. Il pourrait résoudre ton petit tracas, si tu te dépêches. Tu ferais bien d'y réfléchir... les gens seraient peut-être tentés de te donner un surnom plus sympathique si tu avais une chevelure plus avantageuse.~
@49551 = ~Surtout avec la guerre qui vous opposent, n'est-ce pas ? Vous n'iriez pas demander de l'aide à des étrangers si ceux de l'autre guilde ne représentaient une grave menace.~
@49552 = ~Ne nous fais pas rire, maître voleur. Nous avons entendu parler de votre guerre des guildes. Tu ne t'approcherais pas des étrangers si notre toit était solide, non ?~
@49553 = ~<CHARNAME> ! Tu abandonnerais Imoen ici ? C'est moi qui partirai si tu la laisse croupir ici. Ce n'est pas juste.~
@49554 = ~Nous obéissons aux brigands, maintenant ? Beurk... j'ai l'estomac qui se retourne comme un hamster qui court dans une roue. Cela ne peut être un bon présage, <CHARNAME>.~
@49555 = ~J'en ai assez de ces pleurnichements ! Si cela peut accélérer les choses, je vais partir et tu pourras prendre l'enfant ! Je m'en sortirai sûrement mieux qu'elle.~
@49556 = ~La Rashéménie est ma patrie, mais je ne l'ai pas vue depuis bien des lunes. Je fais mon dajemma. J'ai... failli à ma dernière sorcière... mais il n'arrivera rien à Aerie ! Rien !~
@49557 = ~Non, cela ne se peut ! <CHARNAME>, laisse Minsc et Bouh tenter leur chance. N'abandonnons pas Imoen ici.~
@49558 = ~Je suppose que nous en avons terminé. Nous vous remercions pour vos services, mercenaire. Maintenant, partez. Vous avez été payé.~ ~Je suppose que nous en avons terminé. Nous vous remercions pour vos services, mercenaire. Maintenant, partez. Vous avez été payée.~
@49559 = ~Non. Si nous devons abandonner quelqu'un ici ce sera moi. Peut-être n'en reviendrai-je pas, mais j'ai plus de chances de m'en sortir seul que cette jeune femme.~
@49560 = ~Pas si vite. L'argent que vous m'avez donné n'était qu'une avance. Je veux davantage qu'une vieille armure. Payez-moi, ou je me fâche.~
@49561 = ~Alors nous allons enquêter sur cette autre guilde, c'est cela ? Et qu'aurons-nous à faire, là-bas ? Voler ? Tuer ? Je n'aime pas ce à quoi cela semble nous mener, <CHARNAME>.~
@49562 = ~C'est une excellente opportunité, <CHARNAME>... pour nous tous. Mais n'oublie pas que tu dois agir avec loyauté envers la guilde, sinon nous serons découverts.~
@49563 = ~Je ne serais pas une brillante défenseuse du bien si je vous laissais faire cela, <CHARNAME>. Abandonnez-moi plutôt pour mettre ma foi à l'épreuve. Ne mettez pas cette personne en danger.~
@49564 = ~Inutile de vous fâcher. Demander à être payé d'avance est une pratique classique, et vous devez admettre que je suis compétent.~ ~Inutile de vous fâcher. Demander à être payé d'avance est une pratique classique, et vous devez admettre que je suis compétente.~
@49565 = ~Ne sois pas idiot, <CHARNAME> ! Sacrebleu ! Nous avons fait déjà presque tout le boulot, qu'importe un petit massacre ? Moi, en tout cas, je veux ma récompense !~ ~Ne sois pas idiote, <CHARNAME> ! Sacrebleu ! Nous avons fait déjà presque tout le boulot, qu'importe un petit massacre ? Moi, en tout cas, je veux ma récompense !~
@49566 = ~Notre village est pauvre. Vous n'avez donc aucune pitié ? Je vous ai donné ce que je possédais de plus précieux.~
@49567 = ~Quelle homme stupide tu fais ! À quoi t'attends-tu ? Mae'Var est déjà un homme mort ! Allons chercher la récompense nous-mêmes !~ ~Quelle femme stupide tu fais ! À quoi t'attends-tu ? Mae'Var est déjà un homme mort ! Allons chercher la récompense nous-mêmes !~
@49568 = ~Je ne peux pas accepter d'abandonner cette jeune femme ici. Garde une vue d'ensemble plutôt qu'une vision à court terme. Garde-la et laisse-moi ici à sa place.~
@49569 = ~Je ne tiens pas à vous laisser dans la misère. Je m'en vais.~
@49570 = ~Sans moi, ce village est perdu. Donnez-moi ce que je veux, ou vous en subirez les conséquences.~
@49571 = ~Très bien. Je ne voulais pas être désagréable. Dans notre village, les affaires se traitent sans brutalité et sans égoïsme. Merci et au revoir.~
@49572 = ~Vas-tu vraiment laisser notre tâche inachevée et non récompensée, <CHARNAME> ? Je croyais que tu avais plus d'estomac que ça.~
@49573 = ~Ahh, la pleurnicheuse. Je préfère me cogner cet endroit tout seul plutôt que d'entendre ses gémissements une minute de plus.~
@49574 = ~Vous... vous êtes un homme cruel. Je vous payerai. Voilà toute ma fortune, jusqu'au moindre sou. Quittez la ville et ne faites de mal à personne. Je vous en prie...~ ~Vous... vous êtes une femme cruelle. Je vous payerai. Voilà toute ma fortune, jusqu'au moindre sou. Quittez la ville et ne faites de mal à personne. Je vous en prie...~
@49575 = ~Hmm. Si tu veux mener une traite de voleurs, cela te regarde. Ne m'implique pas dans tes affaires. Je me verrai dans l'obligation de tuer tous tes compagnons.~
@49576 = ~Alors maintenant vous devenez un Voleur de l'ombre vous-même, <CHARNAME>. Je surveillerai vos actions d'autant plus près, dans ce cas... prenez garde, car je ne tolérerai rien qui me semblera mauvais.~ ~Alors maintenant vous devenez une Voleuse de l'ombre vous-même, <CHARNAME>. Je surveillerai vos actions d'autant plus près, dans ce cas... prenez garde, car je ne tolérerai rien qui me semblera mauvais.~
@49577 = ~C'est un bon choix, mon ami. Bloodscalp est un maître exigeant, mais on devient riche très rapidement quand on dirige une guilde. J'espère que je pourrai t'aider.~ ~C'est un bon choix, mon amie. Bloodscalp est un maître exigeant, mais on devient riche très rapidement quand on dirige une guilde. J'espère que je pourrai t'aider.~
@49578 = ~Comme vous voudrez. Dans les environs, vous devrez trouver une pierre de soleil pour passer une des portes des ombres. Attention ! Une fois retirée de l'autel, sa lumière ne vous protégera plus contre les ombres.~
@49579 = ~Empoisonné et mourant ! Cette tragédie me bourdonne aux oreilles ! Nous devons nous hâter de mener cet homme à bon port, <CHARNAME> !~
@49580 = ~Pauvre homme ! Pourquoi voudrait-on lui faire une chose pareille ? Nous... nous devons trouver l'endroit dont il a parlé et le ramener là-bas au plus vite !~
@49581 = ~Ce manant est probablement ivre et non pas en train de mourir <CHARNAME>. Pourquoi faire attention à tous les délinquants que nous croisons ? Haa, faites comme vous voulez, si vous êtes inquiet à ce point-là.~ ~Ce manant est probablement ivre et non pas en train de mourir <CHARNAME>. Pourquoi faire attention à tous les délinquants que nous croisons ? Haa, faites comme vous voulez, si vous êtes inquiète à ce point-là.~
@49582 = ~Pourquoi autant d'histoires pour un cadavre ? Pfff... moi je dis qu'il faut le détrousser et laisser le reste aux charognes.~
@49583 = ~Je reconnais cet endroit. Vous voyez cette pierre de soleil sur le piédestal ? Tant qu'elle restera là, aucune ombre ne nous approchera et nous serons en sécurité. Une fois la pierre enlevée, les créatures attaqueront.~
@49584 = ~Nous avons besoin de cette pierre pour passer une des Barrières des ombres. Nous devons simplement être prêts à nous battre dès que nous l'aurons prise.~ ~Nous avons besoin de cette pierre pour passer une des Barrières des ombres. Nous devons simplement être prêtes à nous battre dès que nous l'aurons prise.~
@49585 = ~Laissez-nous, s'il vous plaît. Nous ne voulons pas de problèmes, et je vous ai déjà donné tout ce qui avait de la valeur.~
@49586 = ~Tu laisserais une personne désespérée se débrouiller seule ? Je m'attendais à mieux de ta part, <CHARNAME>.~
@49587 = ~<CHARNAME> ! Ce... cet homme se meurt ! Vous, vous ne pouvez pas le laisser comme ça ! C'est froid et cruel ! De grâce, ne faites pas ça !~
@49588 = ~Nous ne pouvons pas le laisser là. Tâchons au moins de savoir de qui il parle ou de lui trouver de l'aide. Je vous en prie, <CHARNAME>, nous ne pouvons pas le laisser mourir.~
@49589 = ~Eh bien moi, je ne peux pas laisser mourir cet homme. Si vous ne voulez pas l'aider à trouver de l'aide avec moi, je le ferai seul.~
@49590 = ~Très bien. Si c'est ce que vous voulez, allez-y.~
@49591 = ~Nous avons autre chose à faire, Keldorn. Oubliez-le.~
@49592 = ~D'accord... nous l'amènerons donc là où il veut aller, si vous insistez.~
@49593 = ~Vous me décevez, <CHARNAME>. Cependant je dois faire ce que me dicte ma conscience. Retrouvez-moi si vous le souhaitez au quartier général de l'Ordre quand j'aurai fini.~
@49594 = ~Protéger les faibles est ce que j'ai de mieux à faire. Je chercherai de l'aide pour cet homme tout seul. Quand j'en aurai terminé, vous pourrez me trouver au quartier général de l'Ordre.~
@49595 = ~Ce vide effroyable où fut plongée votre âme avec une barbarie sans égale, signe d'une divinité à présent disparue... Quel épouvantable spectacle, quel tableau insensé !~
@49596 = ~*l'affreuse sensation commence à se dissiper, mais hélas, infiniment trop lentement à votre goût*~
@49597 = ~Viles créatures contre-nature ! Faldorn et ses Druides de l'ombre protègent cette forêt maintenant !~
@49598 = ~Pour le bosquet ! Tous les intrus doivent mourir !~
@49599 = ~Mais c'est la vérité, non ? Je suis moi-même une Ménestrelle, et nous voulons simplement être traités comme des invités. <CHARNAME> vous a ramené votre ami empoisonné, après tout.~
@49600 = ~Pour le bosquet ! Tous les intrus doivent mourir !~
@49601 = ~Pour le bosquet ! Tous les intrus doivent mourir !~
@49602 = ~Alustriel~
@49603 = ~La souillure imposée par Bhaal n'a pas eu sur vous le même effet que sur Imoen. En effet, une réaction s'est opérée entre la corruption même et la puissance de votre volonté. Vous risquez cependant de perdre votre intégrité, à moins vous ne parveniez à regagner l'âme qui vous a été dérobée.~
@49604 = ~Il s'agirait là d'un sort plus terrible que le trépas lui-même, ce qui n'a d'ailleurs pas manqué d'échapper à vos camarades.~
@49605 = ~Il s'agirait là d'un sort plus terrible que le trépas lui-même, à moins que vous ne parveniez à débusquer Irenicus et recouvrer votre dû.~
@49606 = ~C'était stupide, <CHARNAME> ! Les Ménestrels pouvaient t'aider. *soupire* Mais je suppose que tu vas n'en faire qu'à ta tête, comme d'habitude, petit entêté.~ ~C'était stupide, <CHARNAME> ! Les Ménestrels pouvaient t'aider. *soupire* Mais je suppose que tu vas n'en faire qu'à ta tête, comme d'habitude, petite entêtée.~
@49607 = ~J'ai bien peur que ce ne soit le cas, Jaheira, Ménestrelle ou non. Vos amis sont des étrangers... Ils doivent nous prouver leur bonne foi avant que nous ne leur faisions part de nos secrets dans cette ville.~
@49608 = ~Je suis une Ménestrelle, mon ami, et je crois comprendre où cela nous mène... est-ce vraiment nécessaire ?~
@49609 = ~*soupire* Si les Ménestrels t'ont confié cette tâche pour éprouver ta valeur, alors nous ne pouvons faire autrement. Allons-y, et finissons-en avec ces « créatures ».~
@49610 = ~Nous devons mener des vagabonds pour ces Ménestrels maintenant, même après en avoir sauvé un ? Et tout ça pour cette... cette... demi-personne, amie du nécromancien ?! Que le diable les emporte tous !~
@49611 = ~Pourquoi les Ménestrels nous confieraient-ils une tâche aussi simple ? Pour notre droit d'entrée ? Ce n'est pas normal... je flaire un piège, <CHARNAME>. Sois prudent si tu le fais.~ ~Pourquoi les Ménestrels nous confieraient-ils une tâche aussi simple ? Pour notre droit d'entrée ? Ce n'est pas normal... je flaire un piège, <CHARNAME>. Sois prudente si tu le fais.~
@49612 = ~Hmmm... Je suis surprise qu'ils nous laissent entrer, même après tout ce qui est arrivé. Je te préviens, <CHARNAME>, sois poli. La raison de notre présence est déjà suffisamment discutable.~ ~Hmmm... Je suis surprise qu'ils nous laissent entrer, même après tout ce qui est arrivé. Je te préviens, <CHARNAME>, sois polie. La raison de notre présence est déjà suffisamment discutable.~
@49613 = ~O-ho ! Les Ménestrels ouvrent enfin leur porte ! Je me demande quels secrets nous pourrons voler à la barbe des Ménestrels quand nous serons là-dedans...~
@49614 = ~La porte s'ouvrit en grand, soudain, et c'est avec une grande appréhension que nos héros s'avancèrent dans les ténèbres de la tanière du lion...~
@49615 = ~Bon sang ! Au nom des Abysses, qu'est-ce que t'es censé foutre ici ?~
@49616 = ~Ouais, maint'nant ! Regarde où tu mets les pieds ! T'as failli m'faire tomber, ouais !~
@49617 = ~Es-tu en train d'essayer de me dire que tu ne sais pas reconnaître un elfe noir lorsque tu en vois un ? Dans ce cas, vois moi comme une nymphe qui serait tombée dans un conduit de cheminée, et tu en seras bien plus heureux.~ ~Es-tu en train d'essayer de me dire que tu ne sais pas reconnaître un elfe noir lorsque tu en vois un ? Dans ce cas, vois moi comme une nymphe qui serait tombée dans un conduit de cheminée, et tu en seras bien plus heureuse.~
@49618 = ~Si j'avais voulu te cogner, humain, tu serais éparpillé sur le sol avec une hache plantée dans le crâne. Alors estime-toi heureux que ce n'était qu'un geste brusque.~
@49619 = ~Oh, tu es revenu, mon trésor ! Je ne t'ai pas vu depuis si longtemps !~
@49620 = ~Euh... ah... tu dois sûrement me prendre pour quelqu'un d'autre, jeune fille, je...~
@49621 = ~Moi, me tromper ? Ohhh, tu me fais marcher, grand fou ! Je reconnaîtrais ta mignonne petite barbichette n'importe où, Eddie !~
@49622 = ~Ah... Je m'appelle Edwin, je t'assure, et...~
@49623 = ~Eddie, grand idiot ! *glousse* Oh, tu es venu avec tes amis ? Tout le monde te prend pour une brute, mais moi je sais combien tu peux être tendre et gentil... Et tous ceux qui disent le contraire auront affaire à moi !~
@49624 = ~Bon. Puisque tu le prends comme ça... alors D'ACCORD.~
@49625 = ~ASSEZ ! Hors de ma vue, gueuse, DÉGAGE ! J'ai passé une nuit chez toi et c'est TOUT... parles-en encore une fois et je te ferai rôtir la peau sur les os ! Gaaaaah !~
@49626 = ~*grogne* (Un mot de plus, un mot de plus et je les tue TOUS ! Oh oui, je crois que je suis d'humeur à le faire ! Un... seul... mot...)~
@49627 = ~Hmmm... c'est bon de savoir que tu as un côté « tendre » et « gentil »... « Eddie ».~
@49628 = ~Tss. Nul doute que tu as l'art de séduire les femmes, Eddie, mon pote. Elles se jettent toutes à tes pieds, hein ? Merveille des merveilles !~
@49629 = ~Ahhhhh, quel plaisir de pouvoir contempler ainsi l'amour sous toutes ses formes. Je ne puis rien faire sinon me représenter la douce jeune fille chatouillant les pieds du bel Edwin dans le boudoir, et le mage gloussant comme une écolière.~
@49630 = ~Har har ! Ton sang de thayen est aussi chaud qu'on le dit, sorcier ! Un vrai coureur de jupons ! Har har har !~
@49631 = ~Et tous craignaient l'Écorcheur, car il marchait tel un mortel, mais ensuite vinrent les meurtres, et à la fin la mort.~
@49632 = ~Est-ce que... est-ce que ça va ? Je... je n'ai jamais rien vu de tel...~
@49633 = ~<CHARNAME>, c'était... c'était l'Écorcheur. C'est l'un des avatars de Bhaal ! Tu... tu es devenu l'Écorcheur ?~ ~<CHARNAME>, c'était... c'était l'Écorcheur. C'est l'un des avatars de Bhaal ! Tu... tu es devenue l'Écorcheur ?~
@49634 = ~Ha ha ! Enfin quelqu'un pour jouer !~
@49635 = ~Oui oui oui ! Quelqu'un va jouer avec nous, maintenant !~
@49636 = ~Ça nous change un peu de ce vieux ronchon de Roi-poisson !~
@49637 = ~Ouais ! Ce vieux grincheux de Roi-poisson ! Baaaah ! Aucun sens de l'humour !~
@49638 = ~Aucun ! Mais... hé hé ! C'est bien le trésor que vous voulez, comme toutes les grandes-gens ?~
@49639 = ~C'est toujours les trésors des elfes noirs que veulent les grandes-gens ! Toujours !~
@49640 = ~Le trésor des elfes noirs sera à vous ! Mais il faut d'abord jouer avec nous ! Hé hé ! Il faut jouer avec nous !~
@49641 = ~Alors, mon grand ? On veut le trésor ? On joue, alors ?~ ~Alors, ma grande ? On veut le trésor ? On joue, alors ?~
@49642 = ~Et pourquoi jouerais-je avec vous ?~
@49643 = ~Et qu'est-ce qui peut bien m'empêcher de le prendre, ce trésor ?~
@49644 = ~Bon, je vais jouer avec vous.~
@49645 = ~Pas question. Poussez-vous, les diablotins, et faites silence.~
@49646 = ~Hé hé ! Vous pouvez parfaitement regarder ce qu'il y a dans chacun des coffres si vous y tenez vraiment...~
@49647 = ~Vous pouvez toujours essayer ! Hé hé ! De toute façon, presque tous les coffres sont vides !~
@49648 = ~Enfin presque tous ! Tous sauf un... celui qui est fermé à clef et qui contient le trésor des elfes noirs ! Tout le trésor !~
@49649 = ~Et aussi autre chose !~
@49650 = ~Il y a un horrible affreux méchant à l'intérieur qui vous prendra votre âme si vous l'ouvrez ! Et vous serez mort pour de vrai !~ ~Il y a un horrible affreux méchant à l'intérieur qui vous prendra votre âme si vous l'ouvrez ! Et vous serez morte pour de vrai !~
@49651 = ~Hé hé ! On peut ouvrir le coffre et vous protéger de l'horrible affreux méchant...~
@49652 = ~Mais seulement si vous jouez avec nous ! Il faut jouer avec nous, oui ! Alors, grandes-gens ? On joue ?~
@49653 = ~Très bien, je vais jouer avec vous, si vous y tenez tant.~
@49654 = ~Je vais tenter ma chance sans vous.~
@49655 = ~Disparaissez, maudits diablotins ! Je n'ai que faire de votre jeu ou de votre trésor !~
@49656 = ~Oohh ! Il veut regarder dans les coffres sans nous ! Hé hé ! Sans nous !~ ~Oohh ! Elle veut regarder dans les coffres sans nous ! Hé hé ! Sans nous !~
@49657 = ~Si vous faites ça, grandes-gens, vous aurez des ennuis ! De très gros ennuis, je vous le dis ! Sauf si vous jouez d'abord avec nous !~
@49658 = ~Et pourquoi ça ? Qu'est-ce qui peut bien m'empêcher de regarder dans ces coffres ?~
@49659 = ~Bon... dans ce cas, je vais jouer avec vous.~
@49660 = ~Je tenterai ma chance malgré tout, diablotins. Écartez-vous.~
@49661 = ~Les grandes-gens vont jouer avec nous ! Youpi ! Youpi !~
@49662 = ~Youpi ! Youpi !~
@49663 = ~Bon... grandes-gens, voici les règles du jeu ! Il y a cinq coffres vides ! Devant chacun de ces coffres, vont apparaître des grandes-gens illustres !~
@49664 = ~Des grandes-gens illustres ! Oh, oui ! Illustres et puissants !~
@49665 = ~Chacune des grandes-gens va vous remettre quelque chose appartenant à l'une des autres... et aussi un indice vous permettant de retrouver quelle est la chose qui lui appartient.~
@49666 = ~Quand vous pensez avoir trouvé à qui appartient l'un des objets, mettez-le dans le coffre qui se trouve derrière les grandes-gens à qui vous pensez, d'accord ? C'est très facile !~
@49667 = ~Quand vous les aurez placés tous les cinq, on vous révélera le résultat ! Si vous avez perdu, on vous nargue ! Si vous avez gagné, on ouvre le sixième coffre et c'est vous qui narguez l'horrible affreux méchant !~
@49668 = ~On va bien s'amuser ! Allez, c'est parti !~
@49669 = ~Aahh ! Les grandes-gens ne sont pas amusantes.~
@49670 = ~Il n'est pas amusant, exactement comme ce vieux ronchon de Roi-poisson.~ ~Elle n'est pas amusante, exactement comme ce vieux ronchon de Roi-poisson.~
@49671 = ~Tant pis pour vous. Vous n'aurez qu'à revenir quand vous serez de meilleure humeur. Ou peut-être bien que l'horrible affreux méchant va venir prendre une âme.~
@49672 = ~Dans les deux cas, nous, ça nous va !~
@49673 = ~Revenez ! Revenez ! Allez, venez jouer, quoi !~
@49674 = ~Allez ! Venez jouer, quoi ! Allez, dites oui !~
@49675 = ~Dites-moi d'abord quel danger présentent ces coffres.~
@49676 = ~Allez, les diablotins, envoyez le trésor... ou je vous fais avaler mon épée, ça va faire ni une ni deux !~
@49677 = ~Bon. Je veux bien jouer avec vous.~
@49678 = ~Laissez tomber.~
@49679 = ~Ça a l'air amusant !~
@49680 = ~Et puis après, il affrontera sans nous l'horrible affreux méchant, hé hé !~ ~Et puis après, elle affrontera sans nous l'horrible affreux méchant, hé hé !~
@49681 = ~Puisque c'est comme ça, nous, on va jouer ailleurs, espèce de rabat-joie !~
@49682 = ~De quel « méchant » parlez-vous exactement ? Est-il dans un des coffres ? Y a-t-il un danger ?~
@49683 = ~*soupire* Bon. Je veux bien jouer avec vous, si vous y tenez tant que ça.~
@49684 = ~Je vais tenter ma chance sans vous... ça ne me fait pas peur.~
@49685 = ~Perdu, perdu, perdu ! Vous n'avez pas fait pas fait ce qu'il fallait ! Hé hé ! Vous avez vraiment mis les objets dans les coffres, pas vrai ?~
@49686 = ~Hé hé ! Les diablotins sont imbattables, imbattables ! Hé hé ! Vous vous êtes trompé, mais je ne vous dirais pas où !~ ~Hé hé ! Les diablotins sont imbattables, imbattables ! Hé hé ! Vous vous êtes trompée, mais je ne vous dirais pas où !~
@49687 = ~Alustriel~
@49688 = ~Piergeiron~
@49689 = ~Piergeiron~
@49690 = ~Je ne pensais pas que je vous reparlerais, voyous, mais je fais ce que mon oncle Gaelan me dit quand je peux.~
@49691 = ~Gaelan Bayle voudrait que vous alliez le voir avant de prendre une décision hâtive. Il aimerait améliorer l'accord.~
@49692 = ~Comment saurait-il que j'ai une décision à prendre ? Suis-je suivi ?~ ~Comment saurait-il que j'ai une décision à prendre ? Suis-je suivie ?~
@49693 = ~Allez vite lui dire que j'y serai le plus tôt possible.~
@49694 = ~Je n'ai plus besoin de lui. D'autres envisagent de m'engager apparemment.~
@49695 = ~Très bien, j'irai, mais si il n'est pas à la hauteur de la nouvelle offre que l'on m'a faite, c'est dommage pour lui.~
@49696 = ~Oohh ! Il a gagné ! Il nous a battus à plate couture !~ ~Oohh ! Elle a gagné ! Elle nous a battus à plate couture !~
@49697 = ~Oohh ! La partie est déjà finie ?~
@49698 = ~D'accord, d'accord. On joue le jeu. Allez ouvrir le dernier coffre, maintenant, et nous, les diablotins, on nargue l'horrible affreux méchant et on vous sauve la mise !~
@49699 = ~Pas mal ! Allez donc l'ouvrir, mon grand !~ ~Pas mal ! Allez donc l'ouvrir, ma grande !~
@49700 = ~Je m'appelle Elminster... Vous avez certainement entendu parler de moi, je suis le plus vieux sorcier du pays. Mais au fond de moi, je ne suis qu'un vieil homme... et j'ai besoin d'un objet pour passer le sable du temps.~
@49701 = ~Va nous attendre à la Couronne de Cuivre. Si les choses changent, nous viendrons te voir.~
@49702 = ~Prenez ce cimeterre, je suis bien trop vieux pour me battre. Vous la donnerez à un autre guerrier, avec la peau noire comme la nuit.~
@49703 = ~Attends-nous ici. Nous reviendrons plus tard.~
@49704 = ~Va à la Couronne de Cuivre. Nous t'y retrouverons si nous avons de nouveau besoin de tes services.~
@49705 = ~Je m'appelle Khelben, je suis un magicien très puissant... L'un des meilleurs de la plus belle ville du Nord. J'ai besoin de l'objet qui m'a donné mon surnom le plus affectueux... et une jambe supplémentaire quand je marche.~
@49706 = ~Ne bouge pas d'ici. Nous reviendrons plus tard si nous avons besoin de ton aide.~
@49707 = ~Je vous donne ce pendentif en argent, car il appartient à quelqu'un d'autre. Mettez-le autour du cou d'une femme qui est sœur mais pas encore mère.~
@49708 = ~Je suis Alustriel, fille de Mystra, une des Sept. Dame de la lune, donne-moi mon symbole de l'épée transmise par ma mère depuis sa demeure au royaume des cieux.~
@49709 = ~Où veux-tu me retrouver si nous devons reprendre ensemble l'aventure ?~
@49710 = ~Va à la Couronne de Cuivre. Si nous avons besoin de toi, nous t'y retrouverons.~
@49711 = ~Je t'offre cette pipe de racines et de magie... son pouvoir est grand, je ne mentirai pas. Transmettez-la à un homme, à ma place, plus âgé encore que moi.~
@49712 = ~Attends ici. Si nous avons besoin de toi, nous reviendrons.~
@49713 = ~*cet énorme coquillage émerge depuis les profondeurs du bassin... vous ne savez pas trop ce qui le soutient ainsi*~
@49714 = ~Je suis Piergeiron, paladin au service de la foi de Tyr et Seigneur éclairé de mes terres du nord. Si vous le désirez, déposez donc dans le creux de ma main un symbole de mon autorité.~
@49715 = ~*cette statue de raie manta, bien que ternie, témoigne d'un savoir-faire exemplaire... elle a été magnifiquement travaillée et ne semble pas du tout à sa place dans cette cité à la culture barbare*~
@49716 = ~Je vous fais don de ce bâton de la plus sombre couleur. Il a affronté déjà plus d'un terrible ennemi. Il n'est certes pas à moi, mais je puis vous confier que je connais la personne à qui il appartient.~
@49717 = ~Je suis Drizzt, un elfe noir. J'ai abandonné ma terre natale que je détestais pour devenir un véritable héros. J'ai besoin d'une chose qui m'a permis d'être vainqueur dans de nombreuses batailles.~
@49718 = ~Je vous donne ce casque. Un symbole, m'a-t-on dit, de souveraineté dans une ville glacée du Grand Nord.~
@49719 = ~*cette statue troublante représente un effroyable habitant des profondeurs... une forte odeur de mort et de sang séché baigne l'atmosphère*~
@49720 = ~*l'eau de mer jaillit continuellement à travers et sous ce labyrinthe de plateformes... certains bassins semblent plus profonds et plus sombres que les autres... vous pensez que ces canaux mènent à l'océan*~
@49721 = ~*un souffle d'air putride vous submerge alors que vous contemplez cette pièce infernale... des corps en décomposition de toutes formes et de toutes tailles gisent dans l'eau stagnante, baignant dans leur sang*~
@49722 = ~Lacédon~
@49723 = ~Ahh... oui, je ssssssuis libre... enffffffin... ha ha ha ha !~
@49724 = ~Lacédon~
@49725 = ~Je vais mmmmmaintenant utiliser ta fffffffforce vitale pour fffffffuir cet endroit... addddddddieu...~
@49726 = ~Ahh... je sssssssssuis libre...~
@49727 = ~Je vous aurai averti !~
@49728 = ~Mais... je ne pppppppeux prendre ta ffffffforce vitale !~
@49729 = ~Ha ha ! Pauvre horrible affreux méchant !~
@49730 = ~Tu ne peux rien faire, l'horrible ! On le protège ! Pfffuiiittt !~ ~Tu ne peux rien faire, l'horrible ! On la protège ! Pfffuiiittt !~
@49731 = ~Non ! Nnnnnnnnon ! Je ssssssssuis si ffffffaible...~
@49732 = ~Faux cœur de Villynaty~
@49733 = ~Ha ha ! On s'est bien amusés !~
@49734 = ~Faux cœur de Villynaty~
@49735 = ~On s'est bien amusés, les grandes-gens ! On s'en va, maintenant.~
@49736 = ~Rabat-joie ! Tricheur ! Les grandes-gens sont toujours désagréables !~ ~Rabat-joie ! Tricheuse ! Les grandes-gens sont toujours désagréables !~
@49737 = ~Ce n'est pas amusant ! Mauvais joueur ! Puisque c'est comme ça, on s'en va !~ ~Ce n'est pas amusant ! Mauvaise joueuse ! Puisque c'est comme ça, on s'en va !~
@49738 = ~Sale tricheur ! Mauvais joueur ! Rabat-joie de grandes-gens !~ ~Sale tricheuse ! Mauvaise joueuse ! Rabat-joie de grandes-gens !~
@49739 = ~*une gigantesque gueule béante émerge de l'eau pour former un autel... il s'agit apparemment d'un temple à la gloire de Sekolah, le dieu sahuagin... il a été déserté récemment, sans doute suite à l'invasion des rebelles*~
@49740 = ~Oui, retournez au cirque. Si nous avons de nouveau besoin de vous, nous reviendrons vous chercher.~
@49741 = ~Vous ne pouvez pas retourner au cirque. Restez ici, et nous reviendrons vous chercher dès que nous aurons besoin de vous.~
@49742 = ~Nous te retrouverons à la Couronne de Cuivre si toutefois nous avons besoin de tes services.~
@49743 = ~Tu ne peux pas aller là-bas ; attends-nous ici. Nous reviendrons quand nous aurons besoin de tes services.~
@49744 = ~Où nous retrouverons-nous si vous changez d'avis ?~
@49745 = ~Retrouvons-nous à la Couronne de Cuivre.~
@49746 = ~Restez où vous êtes et nous viendrons vous chercher plus tard.~
@49747 = ~Prêtresse~
@49748 = ~Prêtresse~
@49749 = ~Très bien, nous t'y retrouverons si nous changeons d'avis.~
@49750 = ~Tu ne peux pas faire cela. Attends ici, Korgan. Nous reviendrons si nous avons besoin de toi.~
@49751 = ~Très bien, nous te retrouverons là-bas.~
@49752 = ~C'est tout bonnement impossible. Jan, contente-toi de nous attendre ici. Nous reviendrons te chercher si nous avons besoin de toi.~
@49753 = ~Nous te retrouverons au cimetière, si nous avons de nouveau besoin de toi.~
@49754 = ~Attends ici, Viconia. Si nous avons de nouveau besoin de toi, nous reviendrons te chercher.~
@49755 = ~Nous te retrouverons au bosquet des druides si nous avons à nouveau besoin de toi.~
@49756 = ~Reste ici. Si nous avons besoin de toi, nous reviendrons.~
@49757 = ~Maison de Demin~
@49758 = ~Artemis Entreri~
@49759 = ~Je vous retrouverai là-bas si j'ai besoin de vos services.~
@49760 = ~Vous ne pouvez pas aller là-bas. Pourquoi n'attendriez-vous pas ici même, et si nous avons encore besoin de vous nous reviendrons vous chercher.~
@49761 = ~Très bien... nous te retrouverons peut-être là-bas ultérieurement.~
@49762 = ~C'est impossible. Pourquoi n'attends-tu pas là, et nous reviendrons te prendre plus tard ?~
@49763 = ~J'ai besoin d'aide.~
@49764 = ~Défendez-moi !~
@49765 = ~Terrassez mon assaillant !~
@49766 = ~Je ne peux pas le supporter !~
@49767 = ~Assez !~
@49768 = ~Pitié !~
@49769 = ~Je vais vous aider !~
@49770 = ~Ne me regardez pas. Je fais ce que l'on me dit. Il m'a dit de venir vous dire que l'offre était meilleure, alors me voici.~
@49771 = ~Pour sûr, mais ne le faites pas trop attendre. Je passerai pour un menteur si vous n'allez pas le voir.~
@49772 = ~Ça ne coûte rien d'aller l'écouter. On m'a parlé d'ceux à qui vous avez dû parler, c'est pas une option si vous voulez rester en sécurité dans cette ville.~
@49773 = ~Allez voir Gaelan avant d'aller voir... *s'éclaircit la gorge* votre nouveau contact. Je ne serai payé que si vous allez le voir, et cela ne vous prendra pas beaucoup de temps, vous savez.~
@49774 = ~Zut... je n'arrive pas à viser.~
@49775 = ~Prenez garde, <CHARNAME> ! Je devine quelque chose d'anormal et de maléfique en cette créature ! Ne palabrez pas avec elle... cela n'amènera rien de bon !~
@49776 = ~Il y a quelque chose d'anormal chez cette... cette « Bodhi ». Je ne m'y fie pas, <CHARNAME>. Tout en ce lieu respire le mal et la fausseté.~
@49777 = ~Sois prudent mon ami. Cette créature est une créature du Mal... si tu veux avoir affaire à elle, fais attention. Je me prépare à invoquer Heaum en cas de perfidie.~ ~Sois prudente mon amie. Cette créature est une créature du Mal... si tu veux avoir affaire à elle, fais attention. Je me prépare à invoquer Heaum en cas de perfidie.~
@49778 = ~C'est un endroit sinistre pour rencontrer cette femme, <CHARNAME>, et j'ai une impression gênante d'une force non naturelle chez cette femme. Sois prudent.~ ~C'est un endroit sinistre pour rencontrer cette femme, <CHARNAME>, et j'ai une impression gênante d'une force non naturelle chez cette femme. Sois prudente.~
@49779 = ~Il était temps ! C'est trop pour moi, rôder dans les cimetières la nuit, pendu à chaque mot de cette femelle ! Bah !~
@49780 = ~Sacrebleu, ce n'est pas trop tôt ! J'étais sur le point de brandir ma hache pour faire un peu avancer les choses, ici.~
@49781 = ~Non. Ne traitez pas avec cette créature, <CHARNAME>. Si vous le faites, je n'y aurai aucune part. C'est mon dernier mot.~
@49782 = ~Surtout, n'acceptez pas cette offre, mon ami. Tout ceci me paraît plus mauvais de minute en minute... Je ne supporterais pas de travailler pour une telle créature.~ ~Surtout, n'acceptez pas cette offre, mon amie. Tout ceci me paraît plus mauvais de minute en minute... Je ne supporterais pas de travailler pour une telle créature.~
@49783 = ~Comment connaît-elle nos rapports avec les Voleurs de l'ombre ? Et que penseraient-ils de cette entrevue ? Sois prudent, <CHARNAME>, nos vies sont peut-être en jeu.~ ~Comment connaît-elle nos rapports avec les Voleurs de l'ombre ? Et que penseraient-ils de cette entrevue ? Sois prudente, <CHARNAME>, nos vies sont peut-être en jeu.~
@49784 = ~Une telle offre venant de cette femme me donne autant de frissons dans l'échine qu'une belette affamée... <CHARNAME> saura quoi faire. Même Bouh en est persuadé.~
@49785 = ~Je ne pourrais pas prétendre me sentir tout à fait à mon aise à l'idée de côtoyer cette... femme. Cet endroit fourmille de morts-vivants et pire encore. Toutefois, faites comme bon vous semble... je vous suivrai, pour le moment.~
@49786 = ~Je... je me demande si c'est vraiment une bonne idée, <CHARNAME>. Je... je ne me sens pas très rassurée, tout à coup. Et si nous partions d'ici ?~
@49787 = ~Un pacte curieux... mais cela nous économiserait des forces, non ? Cependant cela ressemble à un pacte avec le diable. Il serait sage d'inverser les rôles avec ces maudits voleurs.~
@49788 = ~Ha ! Autant d'or, c'est une très bonne affaire ! Ne rate pas l'occasion, <CHARNAME>, sinon la donzelle va changer d'avis !~
@49789 = ~Peut-être... que c'est une bonne idée. Nous économiserions beaucoup d'argent pour atteindre le même but, je pense. Mais... nous nous ferions des ennemis chez les Voleurs de l'ombre...~
@49790 = ~Assez. Il est évident que vous avez des questions. Posez-les moi et apaisez votre curiosité si ce n'est votre conscience.~
@49791 = ~Comment êtes-vous au courant de mes engagements avec les Voleurs de l'ombre et même qu'il s'agit des Voleurs de l'ombre ?~
@49792 = ~Vous en savez beaucoup sur moi. Où avez-vous appris tout ça ?~
@49793 = ~On dirait que vous m'avez espionné. Pourquoi vous ferais-je confiance ?~ ~On dirait que vous m'avez espionnée. Pourquoi vous ferais-je confiance ?~
@49794 = ~Pourquoi feriez-vous ça ? Qu'avez-vous à y gagner ?~
@49795 = ~Bill le pirate~
@49796 = ~Bill le pirate~
@49797 = ~Dan le pirate~
@49798 = ~Dan le pirate~
@49799 = ~Jimmy le pirate~
@49800 = ~Jimmy le pirate~
@49801 = ~Scotty le pirate~
@49802 = ~Scotty le pirate~
@49803 = ~Paul le pirate~
@49804 = ~Je vois que vous avez pris votre décision. Je ne m'acoquinerai pas avec une créature maléfique, <CHARNAME>, ni avec ceux qui sont prêts à le faire. Adieu.~
@49805 = ~Paul le pirate~
@49806 = ~Newf le pirate~
@49807 = ~Newf le pirate~
@49808 = ~Je ne peux pas, en mon âme et conscience, rester dans un groupe qui a choisi une telle voie. Je prierai pour votre âme, <CHARNAME>. Je... ne crois pas que nous reverrons.~
@49809 = ~Bouteille de potion vide~
@49810 = ~Oui, et quand ce jour viendra, démon, nous serons là pour t'attendre.~
@49811 = ~D'accord, femelle. Quoi qu'il arrive, tu mourras aussi vite que les autres, je parie.~
@49812 = ~Quelle fierté, créature ! Et pourtant, tu ne nous affrontes pas. <CHARNAME> a été largement sous-estimé. Tu le regretteras le jour de la véritable bataille, je pense.~ ~Quelle fierté, créature ! Et pourtant, tu ne nous affrontes pas. <CHARNAME> a été largement sous-estimée. Tu le regretteras le jour de la véritable bataille, je pense.~
@49813 = ~Eh bien, ce n'était pas si mal, finalement. Après tout cela, j'ai cru qu'on allait nous envoyer voler les bonbons des enfants et marcher sur les cors des grand-mères. Dire que je me suis presque fait dessus sans la plus petite raison...~
@49814 = ~C'est... tout ce que nous avons à faire ? Ah, je suis soulagée ! Toutefois, <CHARNAME>, je me demande si ce n'est vraiment qu'un début. Qui est cette femme, en réalité ? Et pourquoi fait-elle tout cela ?~
@49815 = ~Eh bien, ce n'est pas si terrible. Je m'attendais à bien pire. Débarrassons-nous vite de cette corvée.~
@49816 = ~Nous n'avons donc que ça à faire ? Une petite course ? Ah, oui... qu'est-ce que sera contre les Voleurs de l'ombre ! Bah ! Finissons-en, alors !~
@49817 = ~C'est aussi bien. Je devine un très grand mal dans cette créature, et je suis bien aise de son départ. Qu'avez-vous de spécial, <CHARNAME>, pour attirer de tels égards ?~
@49818 = ~Et elle est partie ? Comme ça ? Nous avons été menés jusqu'ici en pleine nuit juste pour entendre les énigmes et les excuses d'une... maudite... créature ? C'est vraiment étrange !~
@49819 = ~On dirait qu'on a perdu notre temps. La femme ne connaissait pas ta nature de voleur, <CHARNAME>, c'était évident... bien qu'elle semblait savoir beaucoup d'autres choses.~ ~On dirait qu'on a perdu notre temps. La femme ne connaissait pas ta nature de voleuse, <CHARNAME>, c'était évident... bien qu'elle semblait savoir beaucoup d'autres choses.~
@49820 = ~Elle... elle est partie ? Il est temps de... sortir d'ici, d'accord, <CHARNAME> ? Cet endroit me donne des frissons, je ne saurais dire pourquoi. Enfin, je rends grâce au ciel qu'elle soit partie, quelle qu'en soit la raison.~
@49821 = ~C'est une option qui ne tolère aucune interrogation ! <CHARNAME> est un héros, comme nous le sommes tous ! Nous devons toujours faire le choix de la vertu !~ ~C'est une option qui ne tolère aucune interrogation ! <CHARNAME> est une héroïne, comme nous le sommes tous ! Nous devons toujours faire le choix de la vertu !~
@49822 = ~Je ne suis pas sûr d'avoir envie de savoir quelle idée se fait Bodhi d'une mission discutable, <CHARNAME>. Bien entendu, je doute que sa mission « héroïque » soit plus décente.~
@49823 = ~Je... je me refuse à commettre des actes si horribles. Surtout pas pour elle, pour rien au monde. Si on s'en tenait à... quelque chose de moins pendable, d'accord ?~
@49824 = ~Est-ce un défi ? Prends la voie la plus sombre, <CHARNAME>... montre à cette créature que tu ne reculeras pas devant une tâche qui doit être accomplie.~
@49825 = ~Ah, le premier choix me semble meilleur. Ma soif de sang ne sera jamais assouvie par ce charabia sur la morale.~
@49826 = ~Le choix est entre vos mains <CHARNAME>. C'est vous que j'engage. Qu'en dites-vous <CHARNAME> ?~
@49827 = ~Je ne veux pas me salir les mains plus qu'elles ne le sont. Je choisis la mission du ressort des héros.~
@49828 = ~Je n'ai rien contre un peu de maquignonnage. Je me charge de la mission immorale.~
@49829 = ~De telles jérémiades sont soûlantes et vaines. Qu'en dites-vous <CHARNAME> ? Accomplirez-vous cette mission ou non ?~
@49830 = ~Très bien, il ne passera pas la nuit.~
@49831 = ~C'est un peu plus radical que je ne l'imaginais. Ne pourrai-je pas me contenter de le rosser un peu ?~
@49832 = ~Je ne m'attendais pas à un meurtre.~
@49833 = ~Non ! Dis-moi que ce n'est pas vrai ! Aucun héros ne commettrait un tel acte ! <CHARNAME>, je ne pourrais plus jamais regarder Bouh dans les yeux si je participais à un tel méfait !~ ~Non ! Dis-moi que ce n'est pas vrai ! Aucune héroïne ne commettrait un tel acte ! <CHARNAME>, je ne pourrais plus jamais regarder Bouh dans les yeux si je participais à un tel méfait !~
@49834 = ~Je ne m'abaisserai pas à commettre ce genre de meurtre, <CHARNAME>, qu'importe ce que vous avez fait pour moi. Si cette femme ne peut nous confier une autre tâche, je me verrai dans l'obligation de partir.~
@49835 = ~Brus m'a dit que vous aviez un autre marché à me proposer. De quoi s'agit-il ?~
@49836 = ~Brus m'a dit que vous aviez un autre marché à me proposer. De quoi s'agit-il ?~
@49837 = ~Comment ? Tuer quelqu'un ? Vous... vous n'avez pas vraiment l'intention de le faire, n'est-ce pas, <CHARNAME> ? C'est tellement... tellement sinistre.~
@49838 = ~Brus m'a parlé d'un nouveau marché. C'est de cela qu'il s'agit ?~
@49839 = ~Ah, 15 000 pièces d'or. Y veulent accélérer un peu les choses, dans leur intérêt comme dans l'tien. Y veulent qu'leurs relations avec toi soient aussi amicales que possible.~
@49840 = ~Tu as brisé le cœur de mon hamster en tombant si bas, <CHARNAME> ! Comment cela a-t-il pu arriver ? C'est de ma faute, entièrement de ma faute. Je n'aurais jamais dû laisser cela se produire.~
@49841 = ~Reviens lorsque t'auras les 15 000 pièces d'or. Nous pouvons être bons amis, tous autant qu'nous sommes. Qu'tu le saches ou non, nous sommes du même côté dans cette affaire.~
@49842 = ~Voici donc l'dernier décompte. Le prix t'satisfait ? Nous sommes certainement l'allié l'moins dangereux qu'tu puisses choisir dans cette affaire.~
@49843 = ~Je... je dois partir pour noyer mon chagrin. Si tu te reprends, je serai à la Couronne de Cuivre. J'en ai le souvenir d'un bon point de départ pour l'aventure, oh oui !~
@49844 = ~Je vais payer les 15 000 pièces d'or maintenant.~
@49845 = ~Je ne suis pas encore prêt.~ ~Je ne suis pas encore prête.~
@49846 = ~Je suis surpris. Je vous croyais meilleur que cela. Il semble que je me sois trompé. Adieu, <CHARNAME>.~ ~Je suis surpris. Je vous croyais meilleure que cela. Il semble que je me sois trompé. Adieu, <CHARNAME>.~
@49847 = ~C'est plus dans ce goût-là ! Un sauvetage chez les ravisseurs ! Tous trembleront dans le sillage de notre vertueuse fureur ! Oui, Bouh, montre-leur comme ils vont trembler !~
@49848 = ~Sale esclavagiste ! Tes mains sont encore tâchées du sang de ma famille !~
@49849 = ~~
@49850 = ~Eh bien... ça aurait pu être pire, je crois. Au moins, nous avons sauvé quelqu'un.~
@49851 = ~*un petit-homme maculé de sang est assis, mordant dans une jambe humaine encore partiellement couverte d'une armure de cuir encrassée... il lève la tête, sourit et vous dit :* « Plus de viande pour le festin ! »~
@49852 = ~Tuer... Aran Linvail ? Le Maître des ombres ? Mais... es-tu folle, femme ?~
@49853 = ~Occire le gros tas, hein ? Ahhh, ça me rappelle des souvenirs. Mon oncle Scratchy a mené le siège de la tour du Roi Goodbar, tu sais. Bien sûr, Goodbar n'était pas vraiment un roi. Et rameuter une horde de vieux gnomes affamés, en colère pour une histoire de pénurie de tabac, et grommelant dans leur barbe en montant à l'assaut avec leurs torches n'est pas tout à fait la même chose, mais tu saisis le concept. Si Goodbar n'avait pas eu l'esprit aussi vif, les choses auraient pu très mal tourner. Il y a tout de même eu des bulles partout pendant des semaines... aussi je suppose que les dégâts ont déjà été suffisamment importants.~
@49854 = ~Tel était donc notre but depuis le début ? C'est impossible ! Comment... comment allons-nous nous y prendre ? Le Maître des ombres n'a qu'à claquer des doigts pour que ses assassins accourent !~
@49855 = ~Tuer le Maître des ombres... si nous réussissons, ce serait un exploit et non des moindres, <CHARNAME>. Mais beaucoup ont déjà essayé, et nul n'a pu réussir.~
@49856 = ~Nous allons charger au beau milieu de ce repaire de brigands et les retourner comme des crêpes ! Toute cette gloire qui nous attend ! Et le petit-déjeuner aussi.~
@49857 = ~Ainsi, nous allons tuer le Maître des ombres, l'homme le plus puissant de cette ville ? C'est très intéressant. Ne commets pas d'erreur, <CHARNAME> !~
@49858 = ~Vous venez trop tard, <RACE> de la surface. Vous avez déjà accompli la tâche que vous avait confiée le roi... nous n'avons plus de raison de nous parler.~
@49859 = ~Alors allez-y. Passez votre chemin et profitez de ce qu'Ixilthetocal a bien voulu vous donner. Vous n'êtes pas les envoyés de Père-Requin, comme je l'ai cru.~
@49860 = ~Ne pensez même pas à m'attaquer. Allez jeter vos sorts ailleurs.~
@49861 = ~Seigneur zombie des mers~
@49862 = ~Seigneur zombie des mers~
@49863 = ~J'ai rencontré le prince et il m'a demandé de l'aider à tuer le roi.~
@49864 = ~Alors faites ce qu'il vous suggère et nous aurons bientôt la victoire ! Allez !~
@49865 = ~Plus de viande !~
@49866 = ~Vous avez été prévenus... maintenant, subissez les conséquences.~
@49867 = ~Bâton~
@49868 = ~Oh, mon pauvre monsieur ! Quelle sorte de monstre pourrait faire ça... à quiconque ? <CHARNAME>, nous devons retrouver les responsables et mettre fin à leurs crimes.~
@49869 = ~Enterré vivant... ? Je... je ne peux rien imaginer de plus affreux. Et tout ceci par cupidité. Pff !~
@49870 = ~Nous n'avons pas le temps, <CHARNAME> ! En quoi cela nous concerne-t-il si cet idiot se laisse enterrer vivant ? Bah ! Nous ne sommes pas les gardes de la ville !~
@49871 = ~Ceux qui enterrent les vivants doivent être inhumés par la fureur de notre vertu ! Malheur adviendra à ceux qui se rient de la justice ! Ainsi dit Minsc, bien que « adviendra » était le mot de Bouh.~
@49872 = ~Ne pourrions pas nous lancer dans des aventures plus intéressantes ? Cette façon... d'aider m'est très pesante. C'est l'affaire des troupes en garnison, <CHARNAME>.~
@49873 = ~C'est pour nous une parfaite occasion de participer à une bonne cause où la garde de la cité n'a aucune chance, <CHARNAME>. Vous ne voudriez tout de même pas que continuent ces activités criminelles ?~
@49874 = ~Tu vas le remettre à la garde ? Cela ne fait manifestement pas longtemps que tu es en ville. La garnison préférerait sûrement l'ensevelir plutôt qu'avoir à rédiger un rapport. C'est jadis arrivé à mon cousin Biffle, tu sais. Un mage errant avait invoqué un tremblement de terre et ouvert un gouffre dans lequel le pauvre Biffle est tombé. C'était un spectacle insoutenable, surtout lorsque son plateau entier de génoises au navet de tante Gertie l'a suivi dans l'abîme. Elle avait espéré remporter le concours de pâtisserie local, et nous avons été privés des semaines parce que Gertie n'avait pas eu son prix. Elle avait mis des jours à cuisiner, tu sais. Personne n'a jamais compris pourquoi elle avait confié le plateau à Biffle... il avait toujours été poursuivi par une sorte de poisse, on aurait dit qu'il avait offensé les dieux. Tss. Hum... où en étais-je ?~
@49875 = ~Ce n'est rien. Un petit vertige, c'est tout. C'est déjà terminé.~
@49876 = ~Je ne sais pas. As-tu ressenti des effets négatifs depuis qu'ils ont effectué le rituel sur toi ?~
@49877 = ~Laisse-moi tranquille. Ça va aller.~
@49878 = ~Tu parlais des injustices de la garnison, je crois, mon ami riquiqui.~
@49879 = ~Euh... ce n'était pas au sujet de la garnison ? Et de ce pauvre homme enseveli ?~
@49880 = ~Si tu le dis. Je me suis sentie très faible après mon rituel moi aussi, mais tu donnais vraiment l'impression que tu allais t'effondrer. Repose-toi un peu, <CHARNAME>.~
@49881 = ~Oui, tu as raison ! Eh bien, les gardes attendaient autour, se demandant comment ils allaient rédiger leur rapport sur la catastrophe lorsque Biffle a miraculeusement réapparu, rampant vers la surface. Il haletait et toussait, tremblant d'épuisement. Impressionnant spectacle, me suis-je dit. Toutefois, les gardes avaient déjà notifié la mort de Biffle... et ont préféré le renvoyer dans le vide à coups de pieds plutôt qu'avoir à réécrire leur rapport.~
@49882 = ~Je m'affaiblie petit à petit, je crois, mais ça ne m'a encore jamais rendue aussi mal en point. Prends soin de toi, d'accord ? C'est vraiment bizarre que tu sois malade.~
@49883 = ~C'est terrible !~
@49884 = ~Vous mentez plus mal que jamais, gnome. Ils n'ont tout de même pas fait une chose pareille.~
@49885 = ~Eh bien... peut-être pas jusqu'au fond. Ce pauvre Biffle a rebondi plusieurs fois avant d'être retenu à un pic de roche par les bretelles. Il y est resté ainsi pendu quelques jours, balancé par le vent, jusqu'à ce que quelqu'un entende ses cris. Il n'est plus jamais redevenu le même, pauvre cousin Biffle. Il a fini dévoré par un griffon. C'était vraiment le mieux qu'il pouvait lui arriver.~
@49886 = ~Mesure tes pas, tu as très mauvaise mine. Comment te sens-tu ?~
@49887 = ~~
@49888 = ~~
@49889 = ~~
@49890 = ~Le quoi ? Comment est-ce que tu sais ça ?~
@49891 = ~Je n'y suis pour rien... c'est arrivé malgré moi. Qu'est-ce qui a pu déclencher ça ?~
@49892 = ~Je n'ai jamais ressenti une telle puissance. C'était moi ?~
@49893 = ~Tu parlais de la garnison, je crois.~
@49894 = ~J'ai déjà lu des descriptions de l'Écorcheur. Il est apparu pendant le Temps des Troubles, quand les dieux ont été contraints de descendre sur terre.~
@49895 = ~Oh, allons... ils n'ont pas pu faire ça, j'en suis sûr.~ ~Oh, allons... ils n'ont pas pu faire ça, j'en suis sûre.~
@49896 = ~<CHARNAME>, il faut reprendre nos âmes à Bodhi et Irenicus. Le vide qu'elles ont laissé en nous nous affecte, même si c'est de façon différente.~
@49897 = ~Pour ma part, je pense qu'il nous faut pourchasser ces hommes. Telle vilenie ne saurait rester impunie, <CHARNAME>. En sauvant ce Tirdir, nous en avons assumé la responsabilité.~ ~Pour ma part, je pense qu'il nous faut pourchasser ces hommes. Telle vilenie ne saurait rester impunie, <CHARNAME>. En sauvant cette Tirdir, nous en avons assumé la responsabilité.~
@49898 = ~Oui, c'était bien sûr la meilleure solution. *soupire*~
@49899 = ~Attends, <CHARNAME> ! Nous pourrions très bien rançonner cette femme nous-mêmes, non ? Il n'y a aucune raison de ne pas en profiter !~
@49900 = ~Hmpf. Si tu veux mon avis, je crois qu'on devrait en profiter. Faut récupérer la rançon de la dame, moi je dis. Un peu de fric, ça n'a jamais fait de mal.~
@49901 = ~Comment avez-vous l'audace de proférer de telles paroles ?! Libérez-moi sur-le-champ, je l'exige !~
@49902 = ~Vous exigez ? Il me semble pourtant que vous n'êtes point en mesure d'exiger quoi que ce soit.~
@49903 = ~N'ayez crainte. Je m'apprête à vous défaire de vos liens !~
@49904 = ~Pardonnez la grossièreté de mon ami, ma dame. Je vais détacher vos liens, et vous êtes libre, assurément. Vous n'êtes pas blessée, j'espère ?~ ~Pardonnez la grossièreté de mon amie, ma dame. Je vais détacher vos liens, et vous êtes libre, assurément. Vous n'êtes pas blessée, j'espère ?~
@49905 = ~Ignorez <CHARNAME>, gente dame. Je le trouve parfois aussi grossier qu'un nain ivre. Je vais vous libérer... Vous n'êtes pas blessée, j'espère ?~ ~Ignorez <CHARNAME>, gente dame. Je la trouve parfois aussi grossière qu'un nain ivre. Je vais vous libérer... Vous n'êtes pas blessée, j'espère ?~
@49906 = ~Allons, allons, je suis indemne. Mais veillez donc, désormais, à choisir vos partenaires avec plus de discernement, preux chevalier.~ ~Allons, allons, je suis indemne. Mais veillez donc, désormais, à choisir vos partenaires avec plus de discernement, noble dame.~
@49907 = ~Je ne sais pas, mais j'ai déjà lu des descriptions de l'Écorcheur. Il est apparu pendant le Temps des Troubles, quand les dieux ont été contraints de descendre sur terre.~
@49908 = ~Vous vous éveillez dans un sursaut, un martèlement agresse vos oreilles. Une douleur aiguë vous transperce le corps, tandis que votre esprit vous quitte, entraîné par les ténèbres.~
@49909 = ~Tu voudrais garder cette femme prisonnière ? Bouh n'est pas convaincu que ce soit juste. Je dois admettre que ça sent le mal à plein nez. Le mal, <CHARNAME> ! Le mal !~
@49910 = ~Parfait ! Nous allons profiter du complot d'un autre ! Quelle délicieuse ironie ! (Je devrais toucher une plus grosse part de la rançon pour y avoir pensé, en fait.)~
@49911 = ~Ainsi la dame est libre ? Quel besoin avons-nous d'obtenir une récompense de cet homme ? Ne sommes-nous pas des héros, toi et Bouh et moi ? C'est très embarrassant.~
@49912 = ~C'est un acte méprisable, <CHARNAME>. Si l'argent vous intéresse tant, la dame aurait pu offrir une récompense pour sa liberté.~
@49913 = ~Tu as ton argent, <CHARNAME>, mais tu aurais pu éviter d'avoir une réputation fatale de ravisseur. Parfois, je me demande si tu réfléchis avant d'agir.~ ~Tu as ton argent, <CHARNAME>, mais tu aurais pu éviter d'avoir une réputation fatale de ravisseuse. Parfois, je me demande si tu réfléchis avant d'agir.~
@49914 = ~Les tourments qui vous étreignent éveillent à leur tour vos camarades, dont l'impuissance les contraint à vous regarder souffrir davantage au fil des secondes.~
@49915 = ~Vous voilà solitaire, vos camarades ne sont pas là pour observer les tourments qui vous étreignent. Vous n'avez d'autre choix que d'espérer qu'il en sera bientôt fini de cette démence, ainsi que cela s'est déjà produit.~
@49916 = ~Ha ! Récupérer cette rançon est d'une délicieuse ironie qui vaudrait presque plus que l'or. Je trouve cela encourageant de voir que tu fais preuve d'un tel cran, <CHARNAME>.~
@49917 = ~Si tu as l'intention d'aller au-delà de ce point, <RACE> d'en haut, il vaut mieux que tu saches que cette zone ne fait plus véritablement partie de la Cité-des-Cavernes.~
@49918 = ~Au-delà de ce point s'étend un ancien territoire des elfes noirs qui recèle assez de dangers pour renvoyer quiconque s'y aventure dans le ventre du Père-Requin. Si tu y pénètres, c'est à tes risques et périls.~
@49919 = ~Je t'ai prévenu des dangers qui te guettent au-delà de ce point, créature d'en haut. Cesse de m'importuner ou il pourrait t'en cuire. J'ai les dents autrement plus acérées que les tiennes.~
@49920 = ~Vas-tu bien ? Je m'inquiète de plus en plus pour toi, tu sais. Je ne voudrais pas te perdre dans cet endroit maudit.~
@49921 = ~Jaheira, je me reculerais si j'étais toi. Je crois que ça recommence !~
@49922 = ~Recule, Jaheira, si tu tiens à la vie.~
@49923 = ~Laisse-moi, femme ! Tu es en danger si tu restes ici !~
@49924 = ~<CHARNAME> ? Tes lèvres bougent, mais je n'entends aucun son. <CHARNAME> ? <CHARNAME> !~
@49925 = ~Vous sentez-vous bien ? Je vous réconforterai de mon mieux si besoin est.~
@49926 = ~J'ai ici la tête de Neb, le tueur d'enfants. Je vous assure qu'il ne fera plus jamais de mal à personne.~
@49927 = ~De grâce, Aerie, restez en arrière. Je ne sais si je peux vous protéger.~
@49928 = ~Vous devez vous éloigner le plus possible, Aerie, pour votre sécurité.~
@49929 = ~Laissez-moi seul, Aerie ! C'est de la démence de rester ici !~ ~Laissez-moi seule, Aerie ! C'est de la démence de rester ici !~
@49930 = ~<CHARNAME> ? Vos lèvres bougent, mais les mots ne sortent pas... êtes-vous... non... NON ! <CHARNAME> !~
@49931 = ~J'ai en ma possession la tête du gnome tueur d'enfants, Neb. J'espère une récompense pour l'avoir tué.~
@49932 = ~Voyons ça... Oui, on peut penser que c'est bien notre assassin. Mais dans quel état...~
@49933 = ~Vous ne pouvez pas imaginer à quel point ce Neb était antipathique. Enfin si, je pense que vous vous en êtes rendu compte. Quoi qu'il en soit, je vous remercie pour votre aide. Voici votre récompense.~
@49934 = ~Tu as un air affaibli à vomir, ss'inssrigg, on dirait que tu viens de rencontrer ton propre fantôme. Est-ce que tu te sens bien ?~
@49935 = ~Viconia ! Écarte-toi de moi ! Je ne sais pas si je pourrai te protéger !~
@49936 = ~Reste sur tes gardes, Viconia. Je ne suis pas sûr de moi.~ ~Reste sur tes gardes, Viconia. Je ne suis pas sûre de moi.~
@49937 = ~Occupe-toi de tes affaires, elfe noire, si tu tiens à la vie !~
@49938 = ~Tu bafouilles comme un bouffon, mais je n'entends rien. Est-ce que tu te moques de moi, <CHARNAME> ? <CHARNAME>, tu m'entends ? Non !~
@49939 = ~Le Poing Enflammé lui courait également après. Je leur enverrai un rapport, histoire qu'ils interrompent leurs recherches.~
@49940 = ~Je vous remercie une nouvelle fois, citoyen.~ ~Je vous remercie une nouvelle fois, citoyenne.~
@49941 = ~Tu trembles, mon cher. Je vais attiser le feu même si je sens bien que tes frissons n'ont rien à voir avec la fraîcheur de l'air.~ ~Tu trembles, ma chère. Je vais attiser le feu même si je sens bien que tes frissons n'ont rien à voir avec la fraîcheur de l'air.~
@49942 = ~J'ai ici la tête de Neb, le tueur d'enfants. Je vous assure qu'il ne fera plus jamais de mal à personne.~
@49943 = ~J'ai en ma possession la tête du gnome tueur d'enfants, Neb. J'espère une récompense pour l'avoir tué.~
@49944 = ~Non. Va t'en Anomen. Je ne sais pas si je peux te protéger contre ça.~
@49945 = ~Tu mets ta vie en péril en te trouvant ici. Va t'en, pour ton bien.~
@49946 = ~Va t'en, idiot ! Tu mets ton insignifiante vie en péril !~
@49947 = ~Tes lèvres bougent, mais n'émettent aucun son. Es-tu sûr que ça va... <CHARNAME> ? Au nom du ciel, <CHARNAME> !~
@49948 = ~J'ai la tête d'un criminel ici, un gnome prénommé Neb. Est-ce à vous que je dois m'adresser ?~
@49949 = ~Comment ? Vous avez... AH ! Oh... mais c'est VRAIMENT une tête, n'est-ce pas ? Euh... je vous suggère de l'emmener à l'Inspecteur Brega. Il... pourra s'en occuper, j'en suis sûr. *frissonne*~ ~Comment ? Vous avez... AH ! Oh... mais c'est VRAIMENT une tête, n'est-ce pas ? Euh... je vous suggère de l'emmener à l'Inspecteur Brega. Il... pourra s'en occuper, j'en suis sûre. *frissonne*~
@49950 = ~J'ai la tête d'un criminel ici, un gnome prénommé Neb. Est-ce à vous que je dois m'adresser ?~
@49951 = ~la folie qui s'est emparée de vous tend à disparaître, et la quintessence maléfique s'éloigne. Mais si vos tourments devaient s'éterniser, vous vous perdriez vous-même et perdriez du même coup tout ce qui vous est cher.~
@49952 = ~Seul un fou se prosternerait devant un dieu qui prétend tourner la nature à son avantage. Le mal n'est pas dans la nature, seulement dans l'âme de votre dieu stérile.~
@49953 = ~La nature n'est pas aussi vindicative, imbécile. Elle se soucie peu de ceux qui se prosternent devant elle, mais uniquement de la protection de son équilibre.~
@49954 = ~Tu sais, ça me rappelle la fois où oncle Scratchy s'est attiré le courroux de Cyric. Tu n'as pas idée du degré de rage que l'un de vos démons moyens peut atteindre...~
@49955 = ~Ce n'est ni l'heure, ni l'endroit pour vos anecdotes inutiles, maraud.~
@49956 = ~Euh... vous ne souhaitez peut-être pas vous lancer dans ce genre d'équipée, Jan, avec un prêtre de Talos...~
@49957 = ~Sans nul doute, la confusion dont vous êtes la victime ne laisse pas d'inquiéter le groupe qui voyage en votre compagnie. La quête s'avère déjà si périlleuse... Comme s'il était besoin d'avoir en outre à se soucier des folies que vous pourriez commettre !~
@49958 = ~À ton avis ?! Courrouce les dieux et qu'obtiendras-tu ? La Grande Pénurie de Sous-Vêtements, voilà ce que tu obtiendras ! Tu ne saurais certes pas imaginer le sens de l'humour retors dont Tyr peut faire preuve, ça c'est sûr.~
@49959 = ~Nous n'avons certes pas l'intention de courroucer un prêtre de Talos, Jan... garde ton histoire pour toi.~
@49960 = ~Rien, tant qu'un tel enthousiasme est tempéré avec la connaissance de son devoir. Honnêtement, c'est étrange de faire preuve d'un tel optimisme tout le temps.~
@49961 = ~Manteau de bravoure~
@49962 = ~Rien du tout, sauf si tu vois une objection à ce que je vomisse sur ta chasuble rosâtre, cher prêtre.~
@49963 = ~C'est la poignée d'une épée longue. Elle a été forgée par un grand artisan, mais la lame est cassée depuis très longtemps et il manque un gros joyau sur le pommeau.

PARAMÈTRES :

Poids : 2~
@49964 = ~Bonté divine ! Il semble bien qu'au fil des jours, les fripouilles se fassent toujours plus nombreuses dans cette cité ! Je gage que bientôt, il y en aura davantage que d'honnêtes gens !~
@49965 = ~Par tous les saints ! Est-ce donc là quelque vermine que vous transportez avec vous ? Ignorez-vous donc toutes les affections qu'une telle créature est capable de répandre, ignorez-vous combien elle est malsaine ?~
@49966 = ~Si tu comptes les marchands parmi les voleurs d'Athkatla, tu approches déjà plus de la réalité de leur nombre.~
@49967 = ~Le péril où vous vous trouvez n'est hélas que trop clair, et les camarades qui se soucient de vous le ressentent jusque dans leur propre chair. Il faut à tout prix sortir de l'impasse, ou c'en est fini de vous.~
@49968 = ~C'est très dangereux de traiter Bouh de vermine, il risque de vous grimper dessus pour vous montrer son véritable esprit de guerrier. Rien ne peut retenir un hamster courroucé !~
@49969 = ~Tu m'aurais tuée si je t'avais laissé faire. Tu m'aurais laissée croupir dans cet endroit.~ ~Tu m'aurais tuée si je t'avais laissée faire. Tu m'aurais laissée croupir dans cet endroit.~
@49970 = ~Dans une vision d'horreur, le corps du troll explose violemment et deux trolls plus petits émergent de ses entrailles.~
@49971 = ~Je crains que cela ne soit pas la dernière fois. Je ne peux le contrôler.~
@49972 = ~J'ai voulu te prévenir, mais je ne pouvais pas parler. Je suis désolé. Je m'en vais.~ ~J'ai voulu te prévenir, mais je ne pouvais pas parler. Je suis désolée. Je m'en vais.~
@49973 = ~Ce n'était pas de ma faute. Pleurniche si tu veux, mais c'est moi qui suis dans le pétrin, ici.~
@49974 = ~Tu ne devrais pas tenter de le contrôler. Nous devons t'en éloigner, non t'en rapprocher. Nous ferons notre devoir, malgré le danger.~
@49975 = ~Non, tu ne dois pas rester seul. Nous nous en sortirons, j'en suis convaincue. Il faut continuer quoi qu'il arrive.~ ~Non, tu ne dois pas rester seule. Nous nous en sortirons, j'en suis convaincue. Il faut continuer quoi qu'il arrive.~
@49976 = ~Tu n'es pas le seul à être affecté ! C'est si dur de te voir...~ ~Tu n'es pas la seule à être affectée ! C'est si dur de te voir...~
@49977 = ~<CHARNAME>, je t'en prie, avançons. Nous réussirons, j'en suis sûre. Vraiment.~
@49978 = ~Vous étiez un monstre... UN MONSTRE ! Comment pouvais-je...~
@49979 = ~<CHARNAME>, j'aimerais penser que cela n'arrivera plus jamais. Je DOIS m'en persuader. De grâce, quittons cet endroit.~
@49980 = ~Tu... tu m'aurais envoyée au tapis... quelle puissance...~
@49981 = ~<CHARNAME>, nous allons tâcher de tirer parti de la situation, mais si tu me menace à nouveau, je devrai t'ensevelir sur place. Espérons que n'aurons pas à en arriver là.~
@49982 = ~Tu es maléfique ! Si je ne connaissais pas tes motivations, je t'étranglerais à l'heure qu'il est.~
@49983 = ~Nous devons mettre un terme à tout cela. N'en parlons plus avant de pouvoir affronter le responsable.~
@49984 = ~Le mal est fulgurant, vous vous tordez de douleur. Et pourtant, ni agresseur ni blessure... C'est alors que vous comprenez avec effroi ce qui vous persécute avec un tel acharnement.~
@49985 = ~Les tourments s'évanouissent sans tarder et vous reprenez les rênes. Mais votre esprit demeure tout pénétré de terreur, lorsque vous songez à ce qui pourrait advenir la prochaine fois.~
@49986 = ~J'arrive pas à croire qu'ils vous laissent déambuler comme de l'dire, en plein dans le quartier des temples, sacrée p'tite bande païenne. Avec vos dieux nabots, encore... Rien n'va plus.~
@49987 = ~Qui c'est qui t'a fait rentrer, minus ? C'est un lieu saint, pour sûr. On n'a pas b'soin de ta race puante, qu'est là à déambuler dans les parages pour tout souiller. Débarrasse donc le plancher, tu veux ?~
@49988 = ~Vous êtes ignorant, même pour un humain. Soyez heureux, Arvoreen veut que l'on soit patient avec les gens comme vous, ou je vous pourfendrais sur place pour un tel blasphème.~ ~Vous êtes ignorante, même pour une humaine. Soyez heureuse, Arvoreen veut que l'on soit patient avec les gens comme vous, ou je vous pourfendrais sur place pour un tel blasphème.~
@49989 = ~Un mot d'plus, longs-bras, et tu f'ras connaissance avec ma hache. J'ai aucune patience pour les imbéciles trop bavards.~
@49990 = ~C'est... c'est une elfe noire ! Une elfe noire se tient parmi nous, dans le quartier des temples ! Oh, les présages, les funestes présages ! Nous sommes condamnés, condamnés !~
@49991 = ~L'autel sombre projette une ombre noire.~
@49992 = ~Calme-toi, rivvin. Ou enfonce-toi ta propre lame dans la gorge, je m'en moque. L'hystérie que provoque ma seule présence chez ceux de ton espèce est risible.~
@49993 = ~Vous, ici... vous, cette abominable petite créature qui, ah...~
@49994 = ~Nul besoin d'être si timide, ma bonne dame. Tout le monde ne parvient pas à garder un teint parfait sous ce climat. Mais, l'autre jour, un homme a été suffisamment cuistre pour s'approcher de ma Cousine Kylie et lui demander si son visage avait bourgeonné avec le printemps. Elle était outrée, bien sûr, mais en fin de compte, c'était vraiment de sa faute car elle n'avait pas utilisé la lotion de navet que Ma Jansen lui avait prescrite. Kylie avait trouvé que la lotion donnait un excellent goût aux petits pains aux navets qu'elle vendait... et les clients se les arrachaient ! Puis on a découvert, bien sûr, que Ma Jansen mettait toujours quelques gouttes de ticojen dans sa lotion, mais elle n'avait jamais imaginé que quelqu'un L'AVALERAIT. Il a fallu un bon moment pour régler cette affaire avec la garnison.~
@49995 = ~... ah... Je vois... Je vous prie de bien vouloir me pardonner...~
@49996 = ~Ah... vous êtes le fils du seigneur Cor, n'est-il pas ? Si ma mémoire ne me fait point défaut, vous avez rejoint l'Ordre. Le seigneur me l'a appris lors de notre dernière entrevue. Vous ont-ils déjà chassé, ainsi que Cor s'y attendait ?~
@49997 = ~Tu n'es plus rien pour moi, manant. Tu peux rejoindre mon père en Enfer et colporter ce que tu voudras avec lui une fois là-bas.~
@49998 = ~a lâché un objet.~
@49999 = ~Ah, bien le bonjour, je... euh... attendez ! Je connais cet homme, là ! Il s'agit d'un magicien ! Un magicien parmi nous ! Les Mages cagoulés vont faire affaire avec toi, monstre !~
@50000 = ~Je m'occuperais bien de toi, imbécile, mais cela attirerait l'attention des Mages cagoulés. Tu as de la chance... hors de ma vue !~
@50001 = ~Avant votre départ, laissez-moi donc vous offrir quelques bibelots en provenance de la surface. Ils appartiennent à mon trésor, mais je vous les céderai volontiers en gage de remerciement pour votre aide inestimable. Allez-y, à présent ! Et adieu donc, mon petit <PRO_RACE> !~ ~Avant votre départ, laissez-moi donc vous offrir quelques bibelots en provenance de la surface. Ils appartiennent à mon trésor, mais je vous les céderai volontiers en gage de remerciement pour votre aide inestimable. Allez-y, à présent ! Et adieu donc, ma petite <PRO_RACE> !~
@50002 = ~Oui, et Arvoreen essaiera toujours de protéger ce foyer. La vigilance n'est pas un trait caractéristique de mon peuple, mais c'est une chose qu'il nous a bien fallu apprendre.~
@50003 = ~Ah, oui, les petites-personnes. Cela me rappelle une histoire, veux-tu l'entendre ?~
@50004 = ~Je n'ai pas l'intention d'écouter une histoire sordide d'une aventure que vous auriez eu avec mon espèce, gnome. Ma patience est déjà mise à rude épreuve.~
@50005 = ~As-tu une autre histoire à nous narrer, conteur ? Alors parle.~
@50006 = ~Tout va bien ? Il serait tout à fait normal que tu prennes un peu de temps pour te reposer. Tu as subi une rude épreuve.~
@50007 = ~Je me suis sentie étrange pendant quelque temps, comme si je ne me contrôlais plus.~
@50008 = ~Ce n'est rien, laisse-moi tranquille.~
@50009 = ~Je ne veux inquiéter personne. Oublie cela.~
@50010 = ~Ce n'est pas la peine de manquer à ce point de correction. Ce n'était qu'une histoire de pieds velus et des petites manies de gnomes adolescents. Ah, la jeunesse ! J'entends encore ce rire qu'elle avait en engloutissant ses biscuits aux navets les uns après les autres... un appétit rare, d'après mon souvenir.~
@50011 = ~Très bien, mais tiens-moi au courant de ton état. Imoen est censée avoir subi le même rituel, cependant elle ne semble pas souffrir de crises violentes comme celle-ci.~
@50012 = ~Oh, je crains que ce ne soit une piètre histoire. Ce n'est qu'un passage de ma jeunesse, une amourette avec une jeune petite-femme qui travaillait à la pâtisserie locale. Elle n'était cependant pas pâtissière. Elle était goûteuse et remportait tous les concours du plus gros mangeur, dans tous les festivals. Cette façon qu'elle avait d'engouffrer ces quatre-quarts, quel appétit ! Pour nous amuser, nous lui faisions dévaler la colline en roulant et regardions ses petons velus tournoyer dans tous les sens. Quel rire exalté elle avait ! Hum... à moins que ce ne fussent des cris d'effroi ? Tu sais, après le premier siècle, tu réalises que ta jeunesse était peut-être différente de ton souvenir.~
@50013 = ~C'est troublant. Je ne sais pas comment tu as été affecté par le rituel, mais il semblerait que tu ne souffres pas de la même manière qu'Imoen. C'est étrange.~ ~C'est troublant. Je ne sais pas comment tu as été affectée par le rituel, mais il semblerait que tu ne souffres pas de la même manière qu'Imoen. C'est étrange.~
@50014 = ~Tu as l'air faible. Ne me dis pas que tu es déjà en train de dépérir. Je te croyais plus fort que ça.~ ~Tu as l'air faible. Ne me dis pas que tu es déjà en train de dépérir. Je te croyais plus forte que ça.~
@50015 = ~Il n'y a pas de quoi s'inquiéter. J'ai juste perdu pied un instant, c'est tout.~
@50016 = ~Merci de ton inquiétude ô si sincère, Viconia. Fais-moi penser à danser sur ta tombe.~
@50017 = ~C'est étrange... j'ai eu l'impression de perdre le contrôle pendant quelques instants.~
@50018 = ~Quelle est cette histoire, Jan ?~
@50019 = ~Pas maintenant. Tes histoires fatiguent, gnome.~
@50020 = ~Je vois. C'est étrange qu'Imoen semble avoir mieux supporté le rituel que toi.~
@50021 = ~Aussi, je préférerais être prévenue si cette condition perdure. Nous avons besoin d'un commandement vigoureux si nous voulons surmonter les épreuves qui nous attendent, et si tu n'es pas à la hauteur...~
@50022 = ~Je m'inquiète simplement pour le bien du groupe. Je trouve juste étrange qu'Imoen ait mieux supporté le rituel que toi. Comme je te l'ai dit, je te croyais plus fort que cela.~ ~Je m'inquiète simplement pour le bien du groupe. Je trouve juste étrange qu'Imoen ait mieux supporté le rituel que toi. Comme je te l'ai dit, je te croyais plus forte que cela.~
@50023 = ~Reposez-vous un moment, je vous en prie. Je n'irai pas plus loin tant que vous aurez l'air de souffrir.~
@50024 = ~Ce n'est rien, Aerie, ça va aller mieux. Ne vous faites pas de soucis.~
@50025 = ~J'ai beau ne pas être en pleine possession de mes moyens, je suis toujours le chef du groupe. Continuons !~ ~J'ai beau ne pas être en pleine possession de mes moyens, je suis toujours la cheffe du groupe. Continuons !~
@50026 = ~Si vous le dites. Ce qui m'inquiète, c'est que votre état est encore pire que celui d'Imoen. Vous avez été tous deux victimes du même genre de rituel, n'est-ce pas ? Oh, pardon, je ne cherchais pas à vous tracasser.~ ~Si vous le dites. Ce qui m'inquiète, c'est que votre état est encore pire que celui d'Imoen. Vous avez été toutes deux victimes du même genre de rituel, n'est-ce pas ? Oh, pardon, je ne cherchais pas à vous tracasser.~
@50027 = ~Je connais bien Sire Keldorn. Je ne doute pas qu'il ait déjà enquêté sur ce culte. C'est un paladin accompli de l'Ordre, un fin guerrier... bien que quelque peu arrogant et très pieux.~
@50028 = ~Nous pouvons nous reposer si vous en ressentez le besoin. Je ne forcerai pas un homme souffrant à voyager.~ ~Nous pouvons nous reposer si vous en ressentez le besoin. Je ne forcerai pas une femme souffrante à voyager.~
@50029 = ~Je vais bien. J'ai juste perdu pied momentanément. Allons-y.~
@50030 = ~Ma santé ne vous regarde pas. Je vais bien et je ne veux plus rien entendre à ce sujet !~
@50031 = ~J'ai cru perdre le contrôle de moi-même pendant un instant. Ça va mieux, maintenant.~
@50032 = ~Alors... tu es en train de me dire qu'il n'est pas si différent de toi, hein, Ano ?~
@50033 = ~Pfff ! Comme si on avait besoin d'un autre dans le groupe. Moi, je dis qu'il faut éviter le paladin.~
@50034 = ~Venant de toi, ces mots résonnent comme un compliment. Ce Keldorn doit être un très grand chevalier.~
@50035 = ~Tu n'as que trop peu d'importance à mes yeux pour me dire de telles choses. Répète-les et je réagirai différemment.~
@50036 = ~Doit-on vraiment faire les commissions de ce temple de crétins, <CHARNAME> ? Si les rivvins de cette ville veulent adorer une abomination et y perdre les yeux, je ne vois pas en quoi cela nous concerne.~
@50037 = ~La voie que tu as choisie est la bonne, <CHARNAME>. Ce culte sent le mensonge, et c'est affront contre la nature que nous devons venger !~
@50038 = ~Parfait ! Une aventure digne de ce nom !~
@50039 = ~Très bien. Je commence à avoir envie de tuer tout ce qui bouge. Si ce tyrannœil a du sang, je le ferai couler comme les autres.~
@50040 = ~Tu as signé ta perte, <RACE>, en pénétrant dans notre domaine. Cette sphère ne te protégera jamais de la souffrance éternelle que nous t'offrons.~
@50041 = ~C'est très dangereux de traiter Bouh de vermine, il risque de vous grimper dessus pour vous montrer son véritable esprit de guerrier. Rien ne peut retenir un hamster courroucé !~
@50042 = ~Pourquoi as-tu pénétré cette sphère ? Ce sont les Mages cagoulés d'Athkatla qui t'envoient pour me tuer ?~
@50043 = ~Tes paroles sont téméraires ! As-tu le pouvoir de les assumer ?~
@50044 = ~Ta mort sera lente, et dans cette mort tu connaîtras la véritable souffrance.~
@50045 = ~Les stupides mortels ne nous contrôlent pas. Tu as envahi notre domaine, nous envahirons donc le tien !~
@50046 = ~Apparition de Sziltar~
@50047 = ~Apparition de Sziltar~
@50048 = ~J'espère que vous savez ce que vous faites !~
@50049 = ~Que c'est drôle ! Les gardiens s'éveillent !~
@50050 = ~Vous comptez accéder au temple de Talos... par les égouts ? Eh bien... je suis prête à tout pour empêcher ces gens de se mutiler.~
@50051 = ~On doit enquêter sur ce culte, mais il m'est difficile de répondre à un prêtre talassien sans grogner. C'est ton affaire... mais je n'y serai plus mêlé après ça.~ ~On doit enquêter sur ce culte, mais il m'est difficile de répondre à un prêtre talassien sans grogner. C'est ton affaire... mais je n'y serai plus mêlée après ça.~
@50052 = ~Je suis navré de constater que tu préfères t'aligner avec la faction du Seigneur des Tempêtes. L'Ordre inculque la tolérance... mais je veillerai sur toi, je t'en donne ma parole.~
@50053 = ~Tu te ranges aux côtés d'un temple qui menace ses fidèles ? Tu te prosternerais devant un dieu malveillant, <CHARNAME> ? Tu es vraiment étrange.~
@50054 = ~Silence ! <CHARNAME> a pris sa décision et le Seigneur des Tempêtes l'accepte au sein de son église.~
@50055 = ~Puis-je vous poser une question avant de m'en aller ?~
@50056 = ~Alors je prends congé.~
@50057 = ~Alors que le dernier sahuagin de l'embuscade s'écroule, vous entendez un cliquetis très net provenant du sud. On dirait qu'une porte s'est déverrouillée.~
@50058 = ~Par tous les dieux ! Je n'ai jamais entendu une chose aussi horrible ! Vous et Lehtinan êtes faits pour vous entendre ! Vous ne me tuerez pas aussi facilement que vous vous l'imaginez !~
@50059 = ~Vous devez y réfléchir, <CHARNAME> ! Nous devons rendre ce service à la Sentinelle ! Nous ne pouvons laisser un tel mal sans surveillance !~
@50060 = ~Artiste du cirque~
@50061 = ~La Sentinelle, Heaum, est un dieu sombre et vindicatif... et il place le devoir par-dessus tout. Garde cela en mémoire, <CHARNAME>... mais sois également le bienvenu.~ ~La Sentinelle, Heaum, est un dieu sombre et vindicatif... et il place le devoir par-dessus tout. Garde cela en mémoire, <CHARNAME>... mais sois également la bienvenue.~
@50062 = ~Je vais vous décevoir. J'ai parlé de vos projets d'évasion à Lehtinan et il m'a envoyé vous tuer en son nom.~ ~Je vais vous décevoir. J'ai parlé de vos projets d'évasion à Lehtinan et il m'a envoyée vous tuer en son nom.~
@50063 = ~Il est bon de voir un homme valeureux rejoindre les rangs d'une ligue aussi vertueuse. Vous ferez un très bon serviteur, <CHARNAME>.~ ~Il est bon de voir une femme valeureuse rejoindre les rangs d'une ligue aussi vertueuse. Vous ferez une très bonne servante, <CHARNAME>.~
@50064 = ~Avant d'aller voir l'acolyte Byron, puis-je vous poser une question, Oisig ?~
@50065 = ~Avant d'aller voir l'acolyte Byron, puis-je vous poser une question, Oisig ?~
@50066 = ~Il se trouve que je suis passé près des geôles des esclaves. Un certain Hendak prépare une évasion. Il a eu l'audace de demander mon aide.~ ~Il se trouve que je suis passée près des geôles des esclaves. Un certain Hendak prépare une évasion. Il a eu l'audace de demander mon aide.~
@50067 = ~Hendak ? Cet esclave barbare et ignorant ! C'est une bonne chose que vous soyez venu m'en parler. Si vous acceptez d'aller un peu plus loin, je vous récompenserais généreusement.~ ~Hendak ? Cet esclave barbare et ignorant ! C'est une bonne chose que vous soyez venue m'en parler. Si vous acceptez d'aller un peu plus loin, je vous récompenserais généreusement.~
@50068 = ~Vous avez dit récompense ? Qu'attendez-vous de moi ?~
@50069 = ~Je vous ai déjà rendu un service. Payez-moi pour le renseignement et j'écouterais votre requête.~
@50070 = ~*tousse* Très bien. Vous m'avez évité une révolte d'esclave. Prenez donc cette armure en remerciement. L'affaire pourrait devenir plus intéressante si vous achevez le travail.~
@50071 = ~Qu'attendez-vous de moi ?~
@50072 = ~Merci, mais ça ne m'intéresse pas.~
@50073 = ~Merci, mais ça ne m'intéresse pas.~
@50074 = ~Bien. Je vais faire en sorte que mes futurs ex-gardes s'en occupent. Merci encore pour le renseignement. Passez un bon séjour à la Couronne de Cuivre.~
@50075 = ~Ah... un œil-tyran. Nous avons de grandes cités d'yeux-tyrans dans l'Ombre-Terre... ce sont des créatures intelligentes qui font de formidables adversaires. Les elfes noirs ne les affrontent qu'en cas de véritable nécessité.~
@50076 = ~On m'a dit que certains montaient à la surface pour dominer les races inférieures. Ce doit être le cas de celui-ci. Mais quel pouvoir peut-il lui rester sans son œil ? Je me demande.~
@50077 = ~Allez exécuter Hendak pour son audace. *s'éclaircit la gorge* Je dois faire un exemple pour que ça ne se reproduise plus. Qu'en dites-vous ? Vous le ferez ?~
@50078 = ~Hein ? Il y a un tyrannœil là-dessous ? J'ai entendu parler de leur pouvoir... qui est immense... mais jamais d'un qui n'avait pas ses yeux.~
@50079 = ~Certainement. Je le ferai avec plaisir.~
@50080 = ~Un... tyrannœil ? Ils sont incroyablement rusés et puissants ! Leurs yeux renferment de la magie... enfin, vous voyez ce que je veux dire. Je n'ai moi-même jamais vu de tyrannœil sans yeux...~
@50081 = ~Je ne suis pas intéressé.~ ~Je ne suis pas intéressée.~
@50082 = ~*tousse* Excellent. Voici la clef de la cellule. Châtiez l'esclave et revenez. Vous serez bien récompensé.~ ~*tousse* Excellent. Voici la clef de la cellule. Châtiez l'esclave et revenez. Vous serez bien récompensée.~
@50083 = ~Hmmm... Il me semble que si un tyrannœil ou ses serviteurs ne peuvent pas accomplir cette tâche, nous serons de corvée. Il vaut mieux redoubler de prudence, <CHARNAME>.~
@50084 = ~C'est fait. Hendak est mort et les esclaves sont matés.~
@50085 = ~Alors pourquoi le vilain tyrannœil ne peut-il pas aller chercher ce bâton tout seul ? Je vais te le dire, pourquoi. Parce que Sunday l'a probablement piégé d'au moins trois façons différentes, voilà pourquoi. C'est une bonne chose que tu m'aies à tes côtés, <CHARNAME>. Tu as été bien inspiré de m'emmener. Tu iras loin, tu sais. Plus loin, peut-être, que mon cousin Bifflechips... bien que lui, il a été propulsé par une catapulte, aussi je suppose que ça ne compte pas vraiment...~ ~Alors pourquoi le vilain tyrannœil ne peut-il pas aller chercher ce bâton tout seul ? Je vais te le dire, pourquoi. Parce que Sunday l'a probablement piégé d'au moins trois façons différentes, voilà pourquoi. C'est une bonne chose que tu m'aies à tes côtés, <CHARNAME>. Tu as été bien inspirée de m'emmener. Tu iras loin, tu sais. Plus loin, peut-être, que mon cousin Bifflechips... bien que lui, il a été propulsé par une catapulte, aussi je suppose que ça ne compte pas vraiment...~
@50086 = ~Bien joué, mon ami. Vous m'avez rendu un grand service. Laissez-moi vous offrir cette récompense.~ ~Bien joué, mon amie. Vous m'avez rendu un grand service. Laissez-moi vous offrir cette récompense.~
@50087 = ~C'est fait. Hendak est mort et les esclaves sont matés.~
@50088 = ~Soyez prudent, <CHARNAME>. Si un tyrannœil a besoin d'aide, il doit y avoir une bonne raison, je veux dire, un piège... Nous ne devrions pas faire confiance à ce prêtre.~ ~Soyez prudente, <CHARNAME>. Si un tyrannœil a besoin d'aide, il doit y avoir une bonne raison, je veux dire, un piège... Nous ne devrions pas faire confiance à ce prêtre.~
@50089 = ~Bien joué, mon ami. Vous m'avez rendu un grand service. Laissez-moi vous offrir cette récompense.~ ~Bien joué, mon amie. Vous m'avez rendu un grand service. Laissez-moi vous offrir cette récompense.~
@50090 = ~Merci encore. Si vous voulez acheter quoi que ce soit, demandez à Bernard et vous aurez le tarif spécial. Bon séjour à la Couronne de Cuivre, vous tirerez sûrement profit de votre association avec Lehtinan.~
@50091 = ~Encore merci pour le service que vous m'avez rendu. Bonne fin de séjour à la Couronne de Cuivre. Notre association vous sera sûrement profitable.~
@50092 = ~Je savais qu'on ne pouvais pas faire confiance à un pareil monstre ! Aux armes, mes amis ! Il ne faut pas que le tyrannœil puisse se servir de cette relique !~
@50093 = ~Le prêtre nous attaque ! Quelle honte ! Bouh va lui ronger les globes oculaires pour une telle farce !~
@50094 = ~Trop tard, goule ! Votre maître est mort et vous allez le rejoindre bientôt ! Votre sinistre culte touche à sa fin !~
@50095 = ~Des paroles exaspérantes pour un démon exaspérant ! Ton mal touche à sa fin, vil faquin ! Prépare-toi à rejoindre ton maître dans les profondeurs des Abysses !~
@50096 = ~Le tremblement de ta voix trahit ta faiblesse, rivvin ! Ton précieux œil-tyran n'est plus que poussière et tu vas le rejoindre sur l'heure !~
@50097 = ~Votre malveillance est une insulte pour tout ce en quoi je crois ! Ces... ces mutilations vont cesser, et s'il faut vous tuer pour y parvenir, alors nous n'hésiterons pas !~
@50098 = ~Lehtinan nous a promis un prix d'ami, j'aimerais goûter ta bière.~
@50099 = ~Attendez, <CHARNAME> ! Retenez votre colère un instant. Hé, vous... quelles raisons aurions-nous de vous croire ? Pourquoi êtes-vous là, si vous ne faites plus partie de cette secte ?~
@50100 = ~Arrête, <CHARNAME>, ne sois pas stupide ! Toi, ici... comment pouvons-nous être certains de ton innocence ? Pourquoi es-tu ici si tu ne fais plus partie des fidèles du culte ?~
@50101 = ~Donne-moi une bière, s'il te plaît.~
@50102 = ~Je ne vous crois pas ! Préparez-vous à mourir !~
@50103 = ~Je ne vous crois pas ! Préparez-vous à mourir !~
@50104 = ~J'ai juré d'anéantir cette secte, <CHARNAME>, et je ne manquerai pas à ma promesse... surtout maintenant que je connais sa vraie nature. Nous DEVONS arrêter cette créature !~
@50105 = ~Et maintenant, mon corbeau ? Devons-nous interrompre l'histoire en cours de narration ? Rappelle-toi de quelle manière tu as obtenu le morceau de sceptre que tu détiens. Je doute que tu puisses t'affranchir de ta promesse aussi facilement.~
@50106 = ~Nous nous arrêtons ! Pourquoi nous arrêtons-nous ? Nous sommes des héros, et un héros doit affronter son ultime ennemi et le vaincre quel qu'en soit le prix !~
@50107 = ~Je vais vous l'indiquer sur la carte.~
@50108 = ~Je vous le dirai moyennant quelque trésor.~
@50109 = ~Je vous le dirai moyennant quelque trésor.~
@50110 = ~S'il existait un moyen d'asservir l'esprit de ce petit garnement, ce serait TELLEMENT plus facile. J'ai bien envie de lui fermer la bouche pour toujours !~
@50111 = ~L'artiste ne peut résister à sa muse qui l'inspire, n'est-ce pas ? Il semble que tout ce qui nous reste à faire, c'est d'aller jusqu'à là-bas et de trouver cet « illithium », ou quel que soit son nom. Viens, mon corbeau, nous nous amuserons peut-être.~
@50112 = ~L'illithium est un métal aussi rare que des mamelles sur un taureau, <CHARNAME>. Il paraît qu'on peut le copier, un alliage, si tu veux... on devrait peut-être faire ça, non ?~
@50113 = ~Cela ne me plaît pas. C'est par trop malhonnête. Quelle que soit la grossièreté dont a fait preuve l'artiste, nous devrions être honnêtes avec lui, ne trouvez-vous pas ?~
@50114 = ~C'est malhonnête, mais ce misérable ne mérite pas plus étant donné ce qu'il exige de l'église. Sire Sarles est bien trop orgueilleux et mériterait une bonne leçon.~
@50115 = ~Un tel tour serait très grossier... mais guère plus, je suppose, que l'artiste lui-même, cet odieux personnage. Illithium, hein ! Il aurait aussi bien pu dire non et en finir !~
@50116 = ~Ah ! On dirait que finalement, les choses ont bien tourné. L'artiste n'a pas voulu du matériau, mais il a accepté l'alliage pour ce qu'il vaut. Cela me suffit, je suis rassuré.~
@50117 = ~C'est plutôt amusant ! Tout allait pour le mieux ! Et j'étais persuadée que les ennuis n'allaient pas tarder à nous tomber dessus !~
@50118 = ~Si le supérieur de ce temple a ce genre de goûts, pourquoi ont-ils besoin de Sarles ? Je pourrais trouver un morceau comme ça tous les jours. Hé... mais au moins, cela a marché...~
@50119 = ~Sire Sarles... je suis désolé que mon compagnon ne vous l'ait pas dit plus tôt, mais nous n'avons pas pu obtenir exactement ce que vous avez demandé. Cet illithium est un alliage, il n'est pas pur.~
@50120 = ~Je m'excuse, <CHARNAME>, mais je ne peux pas soutenir un mensonge. Même à cet homme-là, pour une mince raison... je ne peux tout simplement pas. Nous... nous avons fait notre mieux, Sire Sarles.~
@50121 = ~<CHARNAME> ! C'est... c'est le même nain tueur d'enfants de la Porte de Baldur ! Je me souviens ! Pour la grande harmonie, sa tête doit être remise aux autorités !~
@50122 = ~Bouh se souvient ! La Porte de Baldur ! Neb l'infanticide ! À mort, le gnome, à mort ! AAAAARRRGGHHH !~
@50123 = ~<CHARNAME>... Je me souviens de qui il s'agit, maintenant ! C'est un tueur d'enfants de la Porte de Baldur qui s'est échappé ! Sa tête doit probablement être mise à prix !~
@50124 = ~Je... je comprends. C'est la réincarnation d'un dieu oublié, chargé de garder un objet qui a perdu son pouvoir. Le dégoût a fini par remplacer la foi de ses fidèles. Un destin éternel...~
@50125 = ~Est-ce un dieu ou son avatar ? Affaibli par le manque de foi... et ce que recherche le tyrannœil n'est plus aussi puissant. Je me demande si le tyrannœil en est conscient ?~
@50126 = ~Voilà une existence bien pathétique, pour un dieu. Pas suffisamment oublié pour finalement trouver le repos. Peut-être qu'un jour, un tel destin attendra la sombre Lolth... on ne peut que l'espérer.~
@50127 = ~Cor der noror rrin doth samman ?~
@50128 = ~Ainsi, nous avons fait tout ce trajet pour un objet pratiquement INUTILE ? Bah ! Son effet sur le tyrannœil vaut la peine, j'espère !~
@50129 = ~Bien. Tout cela est passionnant. Encore plus que la dernière fois que j'ai rencontré un dieu.~
@50130 = ~Le petit a rencontré un dieu avant ces événements ?~
@50131 = ~Vous n'avez pas fait une telle chose, gnome. Avec vous, on croirait que rencontrer des dieux est une chose ordinaire.~
@50132 = ~Ol raugh corl sargh ? Xunder to thuldin sonn ? Thuldul ol torst ?~
@50133 = ~Oui, j'ai eu la chance de voir les étranges divinités lors de mon séjour sur les plans. Ou du moins lorsqu'elles voyageaient ouvertement. De quel genre de rencontre parles-tu ?~
@50134 = ~Je suis désolé mais je ne comprends pas votre langue.~ ~Je suis désolée mais je ne comprends pas votre langue.~
@50135 = ~Je ne sais pas si vous êtes ami ou ennemi. Gardez vos distances et je garderai les miennes.~
@50136 = ~Parlez la langue commune, espèce de phénomène des profondeurs. Je n'ai pas le temps d'écouter vos non-sens.~
@50137 = ~Gordul ! Ta jarge.~
@50138 = ~Ah haha... *s'éclaircit la gorge* Veuillez excuser mes compagnons. Nous n'avons que rarement la visite de surfacins ici-bas.~
@50139 = ~Ils peuvent s'occuper de ces deux-là. Vous savez, la mordeuse de cous et le mage.~
@50140 = ~Oui, c'est très rare. Ils ne vivent pas bien longtemps.~
@50141 = ~C'était Oghma, le dieu du savoir. Quoique je ne peux pas dire l'avoir rencontré au sens propre du terme, car il était tellement ivre qu'il s'était endormi dans le jardin de cousin Roffer. Enfin, je devrais plutôt dire SUR le jardin de cousin Roffer... car c'était un gigantesque avatar, étendu et ronflant. Je me demande bien comment on peut faire pour saouler un dieu ?~
@50142 = ~Eh bien il peut se passer de drôles de choses ici-bas, mais nous n'en sommes pas responsables. Mon nom est Carlig, et je suis un camelot.~
@50143 = ~La « dernière fois » que tu as rencontré un dieu ?~
@50144 = ~C'est la chose la plus ridicule qu'il m'ait été donné d'entendre. Oghma est un dieu sérieux et sage qui mérite ton respect... si tu en es capable.~
@50145 = ~Vous devriez avoir honte, gnome. Oghma est un dieu très sérieux et pas du tout comme vous le dépeignez. Chacun devrait respecter les dieux des autres et ne pas faire d'eux des objets de moquerie.~
@50146 = ~Jan, comment pouvez-vous dire des choses pareilles ! Le dieu du savoir... ivre-mort sur la pelouse de votre cousin ?! Si j'étais Oghma je vous châtierais sur-le-champ.~
@50147 = ~Mais si, c'est vrai ! Quelqu'un lui avait même dessiné une moustache et relevé les culottes sur les omoplates. Je ne sais pas qui, mais cela avait dû être une mémorable orgie. Mais si tu ne veux pas me croire... eh bien, d'autant que cela puisse blesser le pauvre vieux Jan, je suppose que je ne puis rien y faire. *renifle* Pauvre Jan Jansen, quel menteur il fait. *sanglote*~
@50148 = ~Je doute fort que cela soit vraiment arrivé, Jan.~
@50149 = ~Je... *soupire* Parfois, gnome, vous dépassez les bornes.~
@50150 = ~Eh bien, je ne sais pas jusqu'à quel point j'apprécie de vous voir railler un dieu, mais c'est... enfin, c'est une image plutôt amusante. *ricane* Oh, vous êtes impossible !~
@50151 = ~Un de ces jours, tu seras écrasé comme un moustique à cause de ton impudence, gnome. Même moi, je n'oserais pas me moquer ainsi des dieux.~
@50152 = ~Révoquez-vous la faiblesse des voyants ?~
@50153 = ~J'accepte.~
@50154 = ~Alors vous révoquez le faux pouvoir de la vue pour adopter la véritable vision de la sainte cécité ?~
@50155 = ~J'y renonce.~
@50156 = ~Comment faire pour mettre de l'ordre dans tout ça ?~
@50157 = ~Ôte-moi ma vision impure, maître. Efface les orbes et leur image empoisonnée de mon esprit ! Fais de moi un être pur !~
@50158 = ~Ainsi soit-il ! Ayez de nobles et pures intentions et vous vivrez ! Accrochez-vous à la vue et vous mourrez. Qu'il en soit ainsi !~
@50159 = ~Aaaaghhh !~
@50160 = ~Encore vous, monsieur Jansen ? Pour la dernière fois, le gouvernement ne va pas établir une zone magique anti-griffon autour de la ville. Ils ne représentent pas une menace, donc cessez de nous importuner !~
@50161 = ~L'Œil Aveugle vous observe en permanence. Il Voit que vous n'êtes pas digne et le sang répandu à mes pieds en est la preuve. Emmenez-le ! Jetez le corps dans la Fosse aux Infidèles.~
@50162 = ~Il en sera fait ainsi.~
@50163 = ~*soupire* Nalia de'Arnise, n'est-ce pas ? Si vous êtes là pour régler vos problèmes de famille, le Conseil s'en charge déjà. Il paraît qu'une commission a été constituée. Maintenant, cessez de nous importuner !~
@50164 = ~Humpf. « Pas une menace ». Ta famille vient vivre en ville dans le but d'échapper aux griffons pour voir Mamie Jansen se faire emporter par l'un d'eux, et que disent-ils ? « Pas une menace ». Pfffffft !~
@50165 = ~Oubliez vos stupides incantations. Mon château a le temps de tomber en ruines cent fois avant que vous ne soyez prêts à agir.~
@50166 = ~Je suis <CHARNAME>. Je recherche d'autres « surfacins », si vous voyez ce que je veux dire.~
@50167 = ~Je viens d'arriver en ces lieux. Qu'y a-t-il à craindre par ici ?~
@50168 = ~Peu me chaut. Je dois juste retrouver deux raclures et quitter ce cloaque.~
@50169 = ~Oooh... attendez un peu, c'est bien vous Valygar Corthala ? Vous ne connaissez pas une certaine Magdelene Corthala par hasard ? À notre connaissance, elle n'a pas payé ses impôts depuis plus de sept ans.~
@50170 = ~Attendez... il s'agit bien d'un elfe noir ? Un impôt a été mis en place par le Conseil de 1 107... tous les elfes noirs sont tenus de payer chaque jour pour pouvoir rester dans la ville.~
@50171 = ~C'est de ma mère que vous parlez, esp... qui est morte par deux fois il y a des années. Transformée elle-même en morte-vivante puis tuée de ma main. Avez-vous une taxe pour cela aussi ?~
@50172 = ~J'ai payé ma dette lorsque les rivvins ont tenté de me brûler vive sur le bûcher, elg'caress. Demande-moi encore de payer pour avoir le « privilège » de visiter ta ville et tu y perdras la langue.~
@50173 = ~Bon, euh... alors ça ne fait rien.~
@50174 = ~Je vous en prie, mon ami ! Si vous n'êtes pas une illusion, venez à mon secours !~ ~Je vous en prie, mon amie ! Si vous n'êtes pas une illusion, venez à mon secours !~
@50175 = ~Si vous voulez un formulaire, il faut absolument connaître son intitulé et le nombre de copies souhaitées. Et on a besoin d'un répertoire pour...~
@50176 = ~*soupire* Si vous êtes ici pour vous plaindre des prestations vous devez remplir le second formulaire « truite » mais nous sommes en rupture de stock malheureusement.~
@50177 = ~C'est de la folie ! La plupart des bêtes ne sont même pas réelles ! Ce sont les ténèbres qui sont dangereuses ! Les ténèbres ! Les autres n'ont pas de substance, à moins que vous ne leur en donniez une ! Ignorez-les !~
@50178 = ~Si vous êtes tous ici pour obtenir un formulaire, tout ce que je peux vous dire c'est que... oh... monsieur Jansen ! Comment allez-vous ?~
@50179 = ~Mais bien sûr. J'aimerais une copie du formulaire de Windy Willows... il y aura évidemment trois copies.~
@50180 = ~... tu n'en publies qu'une centaine, il y a de nombreuses erreurs, pas d'index... et pourtant tu demandes 200 pièces d'or pour une copie. Et vous NOUS traitez de voleurs ?~
@50181 = ~C'est triste de voir un gouvernement qui ne sert plus son peuple. Ce « service », ce n'est qu'une forme de tromperie... le Conseil règne à sa guise, tout le monde le sait.~
@50182 = ~Je me porte à merveille, M. le gratte-papier du gouvernement. Tu sais, Ma Jansen a quelques soucis avec la police locale, elle dit qu'elle ne peut pas vendre ses navets où elle veut. Il y a un formulaire pour ça ? *fait un clin d'œil*~
@50183 = ~Je n'ai pas vu beaucoup d'étrangers par ici, et pourtant je connais tout le monde. Enfin, presque.~
@50184 = ~Les deux individus inquiétants sont repassés, Carlig. Vous savez, la mordeuse de cous et le mage.~
@50185 = ~Oh, les gens d'ici vous laisseront en paix si vous ne les laissez pas vous voir. Eh, je plaisante, bien sûr.~
@50186 = ~Merveilleux ! Désolé pour l'or, <CHARNAME>... tu n'as qu'à considérer cela comme un emprunt. Il faut savoir graisser les pattes, ici, si tu veux que les choses soient faites, tu sais.~
@50187 = ~Que cette corruption soit devenu la norme est intolérable... pis encore, que vous la pratiquiez, gnome. Comment les pauvres peuvent-il obtenir justice dans une telle situation ?~
@50188 = ~Je crains de ne pas avoir de réponse à cette question. Je ne risque rien ici, mais ce n'est peut-être pas votre cas.~
@50189 = ~C'est bon pour ceux qui ont de l'or, mais que faites-vous des pauvres ? Doivent-ils pâtir de ne pas enrichir quelqu'un qui n'en a guère besoin ? C'est injuste !~
@50190 = ~Ah oui, ces deux-là. De la mauvaise graine, je parierais. Je les ai aperçus à proximité de la ville des elfes noirs. J'espère pour eux qu'ils sont d'une quelconque importance pour les elfes noirs, parce que ceux-là n'ont pas pour habitude de laisser les étrangers vivre.~
@50191 = ~Absolument. Et c'est juste pour obtenir le formulaire. Attends de savoir combien il faut verser de pots de vin pour envoyer les exemplaires dans 3 endroits différents.~
@50192 = ~Oh oh ne croyez pas ça. Vous serez bientôt plus mort que vif si vous continuez ainsi.~ ~Oh oh ne croyez pas ça. Vous serez bientôt plus morte que vive si vous continuez ainsi.~
@50193 = ~Les deux autres étaient pareils eux aussi. Mais j'aurais pensé qu'ils pouvaient résister à la plupart des attaques. Vous savez, la mordeuse de cous et le mage.~
@50194 = ~Oui, ce sont bien eux que je recherche ! Bodhi et Irenicus ! Je dois les retrouver !~
@50195 = ~Merci pour l'avertissement, mais je vais tenter ma chance.~
@50196 = ~Oui, j'ai bien peur qu'ils auront plus de soucis à se faire que moi.~
@50197 = ~Le nom des membres du Conseil est gardé secret... ainsi personne ne sait qui corrompre.~
@50198 = ~Le Conseil délibère actuellement sur l'aggravation des peines à l'encontre de l'utilisation de la magie en ville. Je crains qu'ils ne puissent pas recevoir de nouvelles requêtes.~
@50199 = ~Vous admettrez certainement que le Conseil gouverne la ville d'Athkatla de façon efficace, malgré ce qu'on a pu vous dire. *renâcle*~
@50200 = ~Mais est-ce le but ? C'est étrange... quand je vois toutes ces pièces de monnaie qui changent de mains ici, j'en viens à penser que chacun sait exactement qui soudoyer.~
@50201 = ~Nous pouvons tous constater l'efficacité de leur limitation sur la magie, imbécile. Y a-t-il un seul bâtiment qui n'abrite pas un mage ou un Mage cagoulé ? Bande d'idiots.~
@50202 = ~Quel dommage que leur efficacité ne s'étende pas au reste de la nation. Peut-être devrions nous voir la rébellion de Riatavin comme un brillant exemple de bon gouvernement ?~
@50203 = ~Je ne resterai que si le jeu en vaut la chandelle. Que me donnerez-vous pour mon appui dans ce combat ?~
@50204 = ~Je vous souhaite bonne chance, quoi qu'il en soit. Je crains juste que vous ne puissiez pas même approcher la ville des elfes noirs.~
@50205 = ~Ainsi tu as choisi de suivre cette autre route. Et tu préfères considérer la question financière plutôt que l'intérêt de notre compagnie. Ce n'est pas ce à quoi je m'attendais, corbeau.~
@50206 = ~Je regrette, mais je ne puis t'aider.~
@50207 = ~Cet endroit vous tombera sur la tête plus durement qu'un tunnel sous-marin llargh.~
@50208 = ~Artiste du cirque~
@50209 = ~C'est leur choix, Finderlig. Il ne sert à rien de s'inquiéter pour eux. Mais renseignez-vous avant de donner l'assaut. Il y a peut-être mieux à faire.~
@50210 = ~Écarte-toi ! Je suis las de cette cité et de ces gueux qui me pressent sans relâche !~ ~Écarte-toi ! Je suis lasse de cette cité et de ces gueux qui me pressent sans relâche !~
@50211 = ~Ah !~
@50212 = ~Soit, mais j'ai tout de même des choses à vous vendre qui pourraient vous intéresser. Je suis toujours en quête de nouvelles têtes avec qui commercer. Peu importe la couleur de l'ombre qui vous habite.~
@50213 = ~Certainement pas ! Il n'y est pour rien, ce n'est qu'un pauvre bougre qui tente de survivre !~
@50214 = ~Et qu'avez-vous donc à vendre ?~
@50215 = ~Non merci. Une autre fois, peut-être.~
@50216 = ~Je ne suis pas ici pour faire mes courses. J'ai des affaires plus importantes à régler.~
@50217 = ~Écoutez-moi bien ! Ces pièces que je lui donne sont un présent, et non pas une aumône. N'avez-vous donc rien de mieux à faire que d'importuner ce pauvre homme ?~
@50218 = ~C'est une question plutôt maladroite, mon enfant. Il est très malséant d'imposer des exigences à des gens désespérés. Néanmoins, nous pourrons peut-être parvenir à un accord.~
@50219 = ~N... non ! Non ! C'est... c'est l'oncle de <CHARNAME>, et nous nous... arrêtions juste pour lui parler.~
@50220 = ~Fort bien, mais pensez à revenir me voir tant que vous le pouvez encore.~
@50221 = ~En fait... en fait, tenez, mon oncle. <CHARNAME> voulait vous remettre ces pièces pour que puissiez vous trouver un repas chaud et un endroit pour dormir cette nuit.~
@50222 = ~Ah, vous revoici. Voulez-vous regarder mes stocks, ou peut-être désirez-vous recourir à mes services ?~
@50223 = ~Aidez-nous à combattre les créatures qui voudraient passer par le portail, et nous vous donnerons le titre de propriété de ce théâtre avant de partir. Vous êtes un barde, vous saurez le mettre à profit.~
@50224 = ~Garde ! Je suis Sire Keldorn du très noble Ordre du Cœur radieux. Cet homme est dans le besoin et vous l'emprisonneriez pour cela ? Je ne le permettrai pas !~
@50225 = ~Voyons ce que vous avez à vendre.~
@50226 = ~Vous avez du nouveau sur mes deux « compatriotes » ?~
@50227 = ~Rien pour le moment. J'ai à faire.~
@50228 = ~Bonne chance.~
@50229 = ~Eh bien... C'EST la loi, Sire Keldorn, mais... mais je... passerai outre... cette fois-ci. Oui. Allez-vous-en, mendiant... euh, maintenant.~
@50230 = ~Hélas non, je n'ai rien appris à leur sujet. Je ne suis qu'un simple camelot, j'évite de me mêler des affaires des elfes noirs !~
@50231 = ~Voyons ce que vous avez à vendre.~
@50232 = ~Bon, je dois y aller.~
@50233 = ~M-malla c'rintri, très n-noble elfe noir. Je suis Carlig, simple camelot, et je me réjouis de votre venue. Lolth kyorl dos.~ ~M-malla c'rintri, très n-noble elfe noire. Je suis Carlig, simple camelot, et je me réjouis de votre venue. Lolth kyorl dos.~
@50234 = ~Je peux te répondre, garde. Le rivvin nous a abordé pour nous demander sa route et rien de plus.~
@50235 = ~Mais, je me pose une question. Il y avait une femme sans défense assaillie par la foule et presque brûlée sur le bûcher, près d'ici, il n'y a pas longtemps. Où étais-tu ? Tu pourchassais quelque mendiant sans relâche, je suppose ?~
@50236 = ~Je, euh... n'en avais pas entendu parler. Mais... pour ce qui est du mendiant, eh bien... je suppose que vous, une elfe noire, n'avez aucune raison de le protéger. Allez-vous-en, vieillard, et que je ne vous y reprenne pas.~
@50237 = ~Épargne mon langage de ta langue maladroite ! Qu'as-tu à vendre ? Vite !~
@50238 = ~As-tu vu deux étrangers par ici ? Tu sais de qui je veux parler, alors dépêche-toi de me répondre !~
@50239 = ~Je ne te veux pas de mal, vermisseau. Du moins, pas encore.~
@50240 = ~Ça a l'air formidable. Mais n'oubliez pas de me le remettre avant de partir. Je ne voudrais avoir à courir les Plans à votre recherche.~
@50241 = ~Quoi ? La charité ? De la part d'un elfe noir ? Serais-tu folle de moi, belle prêtresse d'onyx lascive ? Mmmmh ?~
@50242 = ~Que le grand cornu m'emporte ! Viconia aurait-elle fait quelque chose de bien ? Vite, que quelqu'un m'apporte du savon... je dois laver mes caleçons !~
@50243 = ~Oui... Bien sûr. L'elend zhah alurl. Je s-suis à votre service, si vous avez besoin de quoi que ce soit.~
@50244 = ~Cela ne te ressemble guère, mon bel oiseau noir, de faire montre de charité. Te sens-tu bien ?~
@50245 = ~Capitaine Bob Holmes~
@50246 = ~Ah, n... oui... Oui. Ils se sont dirigés vers la cité, v-votre cité. Un mage et une vampire. J'ai supposé qu'ils étaient là pour affaires.~
@50247 = ~Ne t'en mêle pas. Si je méprise la loi de cette ville, c'est parce que je sais combien elle peut léser certains. Ce pathétique rivvin peut pourrir dans l'Abîme, en ce qui me concerne.~
@50248 = ~M-mais je ne sais ce qu'ils y font. Ce n'est pas du tout mon affaire, d'ailleurs. Cela ne concerne qu'eux et les vôtres.~
@50249 = ~I-il y avait un autre groupe. Ils voulaient savoir où deux autres étrangers étaient allés. Mais ce ne sont pas mes affaires, bien sûr.~
@50250 = ~Mmmm. Et moi qui pensais être l'acteur de cette troupe. Comme c'est bizarre...~
@50251 = ~Hum, hum. Très convaincant, Vicky. La prochaine fois, elle s'occupera des malades et mettra en place un programme pour les prostituées désabusées. « Oh, seigneur », gémirons-nous, « qu'est-il arrivé à notre vicieuse petite Vicky ? »... hééé... à moins que non.~
@50252 = ~Si tu rencontres un groupe d'étrangers, n'oublie pas de les traiter comme des invités de marque. Me suis-je bien fait comprendre ?~ ~Si tu rencontres un groupe d'étrangers, n'oublie pas de les traiter comme des invités de marque. Me suis-je bien faite comprendre ?~
@50253 = ~Très bien. Montre-moi ce que tu as à vendre.~
@50254 = ~Oui, bien sûr. Il en sera fait ainsi.~
@50255 = ~C'est toi qui le dis, elfe noir. Je te suggère de boire un peu plus du poison qui rend ton âme si noire, et d'oublier ces stupidités à l'avenir.~ ~C'est toi qui le dis, elfe noire. Je te suggère de boire un peu plus du poison qui rend ton âme si noire, et d'oublier ces stupidités à l'avenir.~
@50256 = ~Voyons ce que vous avez à vendre.~
@50257 = ~Voyons ce que vous avez à vendre.~
@50258 = ~Et qu'avez-vous donc à vendre ?~
@50259 = ~Qu'était-ce donc que cela, Viconia ? Un acte de charité ?~
@50260 = ~Parfait. Je te laisse.~
@50261 = ~Bon, qu'as-tu à vendre ? Vite !~
@50262 = ~Je vais peut-être te laisser en vie, alors. Adieu.~
@50263 = ~Euh... si tu le dis.~
@50264 = ~Donnez-le-moi maintenant et vous aurez mon aide.~
@50265 = ~Si j'étais vous, je serais prudent dans cet endroit. Il y a de nombreux dangers à chaque recoin. Estimez-vous chanceux si vous survivez.~
@50266 = ~Ne vous inquiétez pas, <CHARNAME>. Je ne trahirai pas votre confiance.~
@50267 = ~Quoi qu'il en soit, j'insiste pour que vous me remettiez ce titre avant d'ouvrir le portail.~
@50268 = ~Mais n'oubliez pas de me le remettre avant de partir. Je ne voudrais pas avoir à courir les Plans à votre recherche.~
@50269 = ~Puisque vous insistez. Tenez, prenez le parchemin et préparez-vous.~
@50270 = ~Bien. Finissons-en.~
@50271 = ~Et à propos des autres... Qui êtes-vous <PRO_RACE> ? J'imagine que Raelis ne vous a pas engagé dans l'espoir de la sauver ?~ ~Et à propos des autres... Qui êtes-vous <PRO_RACE> ? J'imagine que Raelis ne vous a pas engagée dans l'espoir de la sauver ?~
@50272 = ~Ces gens sont mes amis et si vous les voulez, il faudra me passer sur le corps !~
@50273 = ~Qui moi ? Je ne suis absolument pas concerné. Vous pouvez emmener ces criminels. Moi, je suis juste le propriétaire de ce théâtre !~ ~Qui moi ? Je ne suis absolument pas concernée. Vous pouvez emmener ces criminels. Moi, je suis juste la propriétaire de ce théâtre !~
@50274 = ~Imbécile ! Je n'ai pas besoin de vous ! J'ai déjà les âmes de ceux-ci. Ça me suffit !~
@50275 = ~Traître ! Nous avions mis en vous notre confiance et nos espoirs ! Vous nous trahissez pour le titre de propriété d'un simple petit théâtre ? N'avez-vous donc aucune morale ?!~ ~Traîtresse ! Nous avions mis en vous notre confiance et nos espoirs ! Vous nous trahissez pour le titre de propriété d'un simple petit théâtre ? N'avez-vous donc aucune morale ?!~
@50276 = ~Je ne resterai que si le jeu en vaut la chandelle. Que me donnerez-vous pour mon appui dans ce combat ?~
@50277 = ~Ainsi tu as choisi de suivre cette autre route. Et tu préfères considérer la question financière plutôt que l'intérêt de notre compagnie. Ce n'est pas ce à quoi je m'attendais, corbeau.~
@50278 = ~Je suis à votre service, malla c'rintri, bien que je ne fasse pas du trafic de marchandises comme d'autres. Cependant, j'ai une histoire ; une histoire de bataille et de mort.~
@50279 = ~Il me reste 1 000 pièces d'Amn, et je n'en aurai plus besoin. Ce sera suffisant ? Je vous les donnerai quand le portail sera sécurisé.~
@50280 = ~Donnez-les moi maintenant et je reste.~
@50281 = ~Lil waela lueth waela ragar brorna lueth wund nind, kyorlin elghinn ! Sarn ! Usstan uil Viconia !~
@50282 = ~Il faudra bien que ça suffise. Finissons-en.~
@50283 = ~L'avarice n'a pas sa place entre amis. D'un autre côté, j'imagine que vous venez de montrer que nous ne sommes pas entre amis. Voici l'or.~
@50284 = ~Bien. Finissons-en.~
@50285 = ~Oui, merci, Malla Viconia. Je suis tout à votre service.~
@50286 = ~Traître ! Nous avions mis en vous notre confiance et nos espoirs ! Vous nous trahissez pour un millier de pièces d'or ? N'avez-vous donc aucune morale ?!~ ~Traîtresse ! Nous avions mis en vous notre confiance et nos espoirs ! Vous nous trahissez pour un millier de pièces d'or ? N'avez-vous donc aucune morale ?!~
@50287 = ~On dirait que Madame Chance a oublié de veiller sur vous aujourd'hui. Allons-y ! On n'a plus de temps à perdre avec vous et tous ceux de votre espèce !~
@50288 = ~Qui moi ? Je n'ai rien à voir avec ces gens. Alors laissez-moi en dehors de tout ça !~
@50289 = ~Attendez, attendez ! Carlig, elle ne porte aucun insigne de maison connue. Regardez ses compagnons ! C'est une hors-la-loi !~
@50290 = ~Comment oses-tu ?!~
@50291 = ~Mordin n'oses rien, je vous assure, mais il me paraît normal que nous cherchions à savoir avec qui nous traitons.~
@50292 = ~Veuillez les excuser, mais nous n'avons guère l'occasion de rencontrer des étrangers.~
@50293 = ~Si tu revois le deuxième groupe, traite-les avec tout le respect qui leur est dû. Ce sont des invités.~
@50294 = ~Qui m'amènes-tu là ? Serait-ce un de ces rustauds de la campagne ? Rassure-moi, tu n'es pas ici pour mendier, n'est-ce pas ? C'est interdit dans le quartier.~
@50295 = ~J'ai moi-même vu la mort récemment. Même les puissants ne peuvent y échapper.~
@50296 = ~Qu'est donc cela ? Oui, toi, avec toutes ces cicatrices. Cela me rappelle ce col en belette que m'avait fabriqué mon fils il y a quelques années.~
@50297 = ~Je suis peut-être un rustre gente dame, mais s'il faut adopter de telles manières pour être considéré comme civilisé, je préfère m'abstenir.~
@50298 = ~De quoi parlez-vous ? Qui est mort ?~
@50299 = ~Oui, oui, des horreurs à chaque tournant. Je suis persuadé que vous avez des dizaines d'histoires et autant de mensonges.~ ~Oui, oui, des horreurs à chaque tournant. Je suis persuadée que vous avez des dizaines d'histoires et autant de mensonges.~
@50300 = ~Eh bien, vous risquez de la voir d'un peu plus près si vous n'arrêtez pas d'essayer de me faire peur.~
@50301 = ~Bouh est mon fidèle compagnon, et il dit que si tu dois porter la peau d'un animal autour du cou, la sournoise belette aux dents longues est un bon choix.~
@50302 = ~Attends un peu... est-il possible que... ne serais-tu pas le fils de Cor ? Combien de fois n'ai-je pas changé tes couches ! Par les dieux, mais tu n'as pas changé !~
@50303 = ~Oh, bonjour... hmm... BONJOUR. Il y a fort longtemps que je n'avais vu en ces lieux un gentilhomme aussi bien vêtu et aussi bien né. Serais-tu thayen ?~
@50304 = ~Ho. Tu dois être ma gouvernante... euh... Martha ? Ou est-ce Marilynn peut-être ? Bonjour à toi, bonne dame.~
@50305 = ~Parles-tu de moi ? Prends garde à qui tu t'adresses avec autant de familiarité, femme du peuple... sinon je te cloue au sol pour toujours !~
@50306 = ~Il n'a pas beaucoup changé depuis. Il râle toujours autant, tape des pieds et des mains lorsqu'il pique une crise et rote après chaque repas. Mais au moins, il se nourrit. Un bon bougre.~
@50307 = ~Et il n'a pas changé depuis que tu lui as fait prendre un bain, femme. Il pleure toujours, il crie, il hurle et il rote après chaque repas.~
@50308 = ~Capitaine Bob Holmes~
@50309 = ~On ne voit pas la différence. Il pleure toujours tout le temps, dit n'importe quoi et rote après chaque repas. Heureusement qu'il a appris à être propre.~
@50310 = ~Marin ivre~
@50311 = ~Je ne me laisserai ridiculiser devant ma gouvernante ! Arrête ! Arrête ! Arrête !~
@50312 = ~Marin ivre~
@50313 = ~Eh bien, parlez et dites-moi ce que vous savez.~
@50314 = ~Vos histoires ne m'intéressent pas. Je ne me préoccupe que de ce qui est réel et immédiat.~
@50315 = ~Ce n'est pas un grand secret pour ceux qui viennent ici fréquemment. Un intrus qui a reçu ce qu'il méritait de la part de quelqu'un qu'il avait contrarié.~
@50316 = ~Pas de mensonge ni un grand secret pour ceux qui viennent ici fréquemment. Un intrus qui a reçu ce qu'il méritait de la part de quelqu'un qu'il avait contrarié.~
@50317 = ~Je pensais juste que vous seriez intéressé par les récents événements. Un intrus qui a reçu ce qu'il méritait de la part de quelqu'un qu'il avait contrarié.~ ~Je pensais juste que vous seriez intéressée par les récents événements. Un intrus qui a reçu ce qu'il méritait de la part de quelqu'un qu'il avait contrarié.~
@50318 = ~Eh bien, je suppose que cela ne s'est pas terminé dans un bain de sang mais ça a été tout de même une grande bataille. Je ne sais pas qui était l'agresseur mais je sais qui a perdu.~
@50319 = ~Un mage puissant, ça c'est sûr, mais finalement pas assez puissant. Désolant. Il semblait sur le point de découvrir un vieil artefact ou un truc du genre.~
@50320 = ~Seigneur Khellon Menold~
@50321 = ~Et qui était cette personne ?~
@50322 = ~Et alors ? Dites-moi qui c'était !~
@50323 = ~Et quelle récompense a-t-il reçue pour ses efforts ? Pire que la mort, même s'il semblait l'accepter. Emprisonné, magiquement emprisonné dans une caverne au nord d'ici. Désolant.~
@50324 = ~Que recherchait-il ? Qui l'a attaqué ?~
@50325 = ~Vous n'avez pas terminé votre histoire. Donnez-moi quelques détails.~
@50326 = ~Vous devrez lui demander vous-même. Je ne sais que ce que j'ai dit. Toutes mes excuses.~
@50327 = ~Je crains de ne pas avoir grand-chose d'autre à dire. J'évite soigneusement toute émotion, surtout ici.~
@50328 = ~Mis à part le magicien emprisonné dans la caverne au nord d'ici, je n'ai rien remarqué de particulier.~
@50329 = ~Oh... excuse-moi. Pardonne-moi cette question mais, ne serais-tu pas de sang orque ? Tes traits sont si... si particuliers... Je ne pense pas en avoir jamais vu de tels par ici.~
@50330 = ~Un nain ? Nous n'en voyons pas souvent, par ici. La plupart d'entre eux travaillent dans les mines des collines. Certains viennent parfois visiter la forge, mais...~
@50331 = ~Du sang orque ? Non, bige, il n'y en a point dans ce corbeau. J'ai peut-être un ou deux ancêtres plus déplaisants, du genre que tu n'aimerais pas croiser dans le désert.~
@50332 = ~Tu parles comme si les nains ne faisaient que ça. Je devrais peut-être t'arracher les tripes pour te prouver le contraire.~
@50333 = ~J'ai été très occupé ces derniers temps. Vous venez, comme ces deux autres... C'est mauvais signe...~
@50334 = ~Eh, toi ! Oui, toi, avec toutes ces cicatrices et ces muscles ! Tu m'as l'air de savoir manier l'épée ; pourquoi ne rejoindrais-tu pas l'armée ? Tu servirais ainsi ton pays !~
@50335 = ~Eh bien... tu as là une bien belle panoplie. Tu es certainement un chevalier de haut rang dans l'armée.~
@50336 = ~Pourquoi me dites-vous cela ?~
@50337 = ~Oui, pour tout le monde sauf moi.~
@50338 = ~Vous êtes un petit gars superstitieux, n'est-ce pas ?~
@50339 = ~C'est juste une question de bon sens. Les étrangers causent toujours des problèmes. Il n'y a rien à ajouter.~
@50340 = ~Oui, j'imagine que c'est également ce que pensaient les deux autres. Bonne chance à vous !~
@50341 = ~Non, simplement réaliste. Les gens d'ici sont très... méfiants... avec ceux qu'ils rencontrent. Bonne chance pour votre voyage.~
@50342 = ~Je ne vous reconnais pas, or je croyais connaître tous les membres de la patrouille locale.~
@50343 = ~Minsc et Bouh se battent avec les dents et l'épée pour le bien, pas pour les nations. Nous sommes des héros, pas des soldats, drôle de petit homme.~
@50344 = ~Nous sommes nouveaux ici, et nous commençons tout juste à nous familiariser avec les environs.~
@50345 = ~Je devrais te tuer pour oser prétendre connaître nos habitudes, mais je me sens dans un état d'esprit généreux.~
@50346 = ~Ce n'est pas le cas, et cela restera ainsi. Cela ne te regarde pas.~
@50347 = ~Je suis chevalier, mais pas de la sorte que vous croyez. J'ai fait vœu de faire respecter la loi mais aussi de protéger les faibles et les innocents... dans une armée, c'est le peuple qui compte le plus.~
@50348 = ~Je vois. Excusez mon indiscrétion, dans ce cas. Je vous laisse apprendre à connaître cette région... dans laquelle vous êtes né. Bonne nuit.~ ~Je vois. Excusez mon indiscrétion, dans ce cas. Je vous laisse apprendre à connaître cette région... dans laquelle vous êtes née. Bonne nuit.~
@50349 = ~Nalia ! Nalia de'Arnise ! Quelle joie de te revoir ! Mon cher fils Filbert m'a encore récemment demandé de tes nouvelles... ne reviendras-tu pas voir ce cher garçon ?~
@50350 = ~Ah, je suis désolé de vous avoir offensé. Ce n'était pas mon but et je ne prétendais pas me mêler de vos affaires.~
@50351 = ~Oui, vous avez tout à fait raison. Veuillez m'excuser.~
@50352 = ~Oooh, n'est-ce pas là le charmant acteur qui a tant fait parler de lui lorsque il était en représentation au quartier du pont ? C'est dans un lieu plus adapté à ses talents qu'il devrait jouer, et non ici !~
@50353 = ~Revoir Filbert ? *soupire* J'ai eu l'occasion de déjeuner une fois avec lui, et il goûtait tout aussi peu que moi vos tentatives de rapprochement. En outre, il m'a marché sur les pieds.~
@50354 = ~Le lieu me parait adéquat, chère madame. C'est la pièce qui compte, pas les dorures du théâtre ou les piliers de marbre. Nous avons joué bien souvent dans ce genre d'endroits sans nous porter plus mal, à Sigil.~
@50355 = ~Oh... mais tu ressembles tout à fait à l'une de mes servantes, elfe. Te dirait-il de la remplacer ? Je n'arrive pas à organiser ma garde-robe, c'est un véritable cauchemar.~
@50356 = ~Aah... merci de m'avoir libéré. Je m'étais résolu à rester emprisonné ici à jamais. Je n'ai jamais été aussi heureux de m'être trompé.~ [VITHAL02]
@50357 = ~S'il te plaît... oui, toi, en robe. Aurais-tu l'obligeance de me héler un attelage ? Je souhaiterais rentrer chez moi.~
@50358 = ~C'est curieux que mes sauveurs soient des elfes noirs. Sans vouloir manquer de respect à votre culture, vous n'êtes pas réputés pour votre gentillesse envers les étrangers.~
@50359 = ~J'ai une dette envers vous. Peut-être pourrions-nous collaborer ? J'avais de grands projets avant d'être aussi grossièrement interrompu.~
@50360 = ~Contre qui vous battiez-vous ?~
@50361 = ~Si vous tenez à risquer de venir ici, c'est que le trésor que vous cherchez doit être des plus précieux.~
@50362 = ~Je ferai partie de ces projets, que vous le vouliez ou non. C'est le prix à payer pour votre libération.~
@50363 = ~Durst~
@50364 = ~Je... je ne suis plus une jeune fille, même si je ressemble à qui vous savez. Et j'ai le sentiment qu'elle ne serait jamais partie si vous vous étiez mieux comporté avec elle.~ ~Je... je ne suis plus une jeune fille, même si je ressemble à qui vous savez. Et j'ai le sentiment qu'elle ne serait jamais partie si vous vous étiez mieux comportée avec elle.~
@50365 = ~Mais pour qui me prends-tu, stupide femelle ? Pour un vulgaire serviteur ? Dois-je te transformer en champignon aveugle pour améliorer ta perception ?~
@50366 = ~Je vois que les petites-gens sont toujours autorisés à déambuler dans les quartiers les plus riches de la cité. *soupire* Certaines choses ne changeront donc jamais...~
@50367 = ~Comment, une elfe noire dans les beaux quartiers ! Je vous imaginais cantonnés dans les bas quartiers, surveillés par les gardes, en compagnie des petites-gens et des nains. Que fais-tu de la valeur marchande !~
@50368 = ~Moi-même je ne le sais pas exactement, même si j'imagine avoir insulté un habitant avec mon ignorance des coutumes locales. La valeur de mon dessein m'a peut-être aveuglé.~
@50369 = ~Peut-être l'un de vos parents elfe noir, soit dit sans offense.~
@50370 = ~Je dois coûte que coûte poursuivre ce que j'ai commencé, et le ferai avec votre aide... si vous le voulez bien.~
@50371 = ~C'est exact, et mon dessein m'a peut-être empêché de voir les coutumes locales... J'ai peur de ne pas savoir chez qui j'ai pu provoquer de la fureur. Toujours est-il que cette fureur était formidable.~
@50372 = ~Je suppose que c'était justifié. J'ai déjà rendu quelqu'un furieux en poursuivant un but aveuglément et je ne voudrais pas que cela se reproduise.~
@50373 = ~C'est vrai ? Voilà qui est intéressant. J'ai déjà rendu quelqu'un furieux en poursuivant un but aveuglément et je ne voudrais pas que cela se reproduise.~
@50374 = ~*renâcle* Je vois qu'il permettent encore à ces grossiers humains de sortir de leur trou, même ici parmi les gens civilisés. Il y a des choses qui ne changent jamais.~
@50375 = ~Je vais y réfléchir.~
@50376 = ~Je doute que j'aie du temps pour cela.~
@50377 = ~Écoutez-moi jusqu'au bout et je suis sûr que je vous convaincrai. La récompense sera belle mais la recherche délicate.~
@50378 = ~Il faudrait peut-être déverser tes boyaux au sol, rivvin... et nous verrions bien combien tu t'inquiéterais pour la « valeur de tes biens », alors.~
@50379 = ~Cet endroit est « peu épais » et des sorts prudents devraient pouvoir briser les murs. De l'autre côté, il est possible de trouver des pouvoirs magiques inestimables, pour peu qu'on sache bien regarder.~
@50380 = ~Si vous pouviez m'aider un peu, je vous en serai toujours reconnaissant. Il y aura assez d'objets magiques pour nous deux.~
@50381 = ~Que dois-je faire ?~
@50382 = ~Je suppose que mon rôle sera de payer les pots cassés à votre place ?~
@50383 = ~Vous êtes trop évasif. Je n'ai aucune confiance en vous.~
@50384 = ~Ah... Anomen Delryn, je vois. Si c'est ton père qui t'envoie, mon cher, tu peux lui dire qu'il n'a pas été invité à ma dernière réception pour la bonne raison que...~
@50385 = ~Je ne peux pas vous mentir, il faudra se battre. Je pensais y être préparé mais mon échec m'a détrompé.~
@50386 = ~Hmmm... j'aurais pourtant juré porter cette bague en quittant ma demeure ce matin... l'un d'entre vous l'aurait-il vue ? Peut-être est-elle tombée au sol...~
@50387 = ~Avec votre aide, les choses devraient mieux se passer. Il est vrai aussi que vos premières missions seraient bien moins dangereuses : quelques courses à faire par exemple...~
@50388 = ~Pour qui me prenez-vous ?~
@50389 = ~J'ai l'habitude de ce genre de tâches.~
@50390 = ~Je commence déjà à penser que ce serait indigne de moi.~
@50391 = ~Je m'excuse si j'ai pu dire quoi que ce soit susceptible de vous offenser mais même les plans les plus grandioses comportent quelques inconvénients.~
@50392 = ~Je ne viens pas de la part de mon père, sale mufle. Si vous voulez exclure le Seigneur Cor à cause de sa pauvreté, cela vous regarde. Je ne voudrais pas imposer ce vil ivrogne à quiconque.~
@50393 = ~Je peux rester ici et commencer quelques sorts préparatoires mais je ne peux pas jeter les sorts qui feront tomber les murs sans les procédures de mon livre de rituels.~
@50394 = ~J'imagine qu'on me l'a pris après mon emprisonnement. Des svirfnebelins m'observaient alors que je me battais, peut-être l'ont-ils pris. Je ne peux pas les blâmer pour cela. Je suis sûr que j'avais l'air perdu de façon définitive.~
@50395 = ~Vous serez certainement ravi d'apprendre que mon père est maintenant mort et que vous n'aurez pas à vous soucier de lui expliquer son exclusion grossière. Partez maintenant.~
@50396 = ~Je me charge de récupérer votre livre de rituels. Qu'ont-ils pu en faire ?~
@50397 = ~Alors, pendant que je vous servirai de laquais, vous serez en train de faire vos préparatifs ici ?~
@50398 = ~Je ne vois pas pourquoi je vous aiderais.~
@50399 = ~Je ne vois cela nulle part, mon bon ami. Peut-être devrais-tu revenir sur tes pas ?~
@50400 = ~Ou peut-être que c'est CECI, monsieur. Peut-être qu'un voleur a essayé de vous le prendre. En tout cas, il est à nouveau en notre possession... comme il se doit.~ ~Ou peut-être que c'est CECI, monsieur. Peut-être qu'un voleur a essayé de vous la prendre. En tout cas, elle est à nouveau en notre possession... comme il se doit.~
@50401 = ~Est-ce que c'est ceci, sire ? Pendant un moment j'ai cru qu'on vous avait volé votre anneau... en tout cas, le voilà. Tenez.~
@50402 = ~Ma récente expérience m'a rendu nerveux à l'idée de voyager seul par ici. Je ne bougerai pas de cet endroit que vous vouliez m'aider ou non.~
@50403 = ~Ah... très bien. Je... je ferais mieux de m'en aller...~
@50404 = ~Vous ne pouvez pas le faire vous-même ? Ça ne me semble pas difficile.~
@50405 = ~Je crois qu'il y a un village svirfnebelin au nord. Ils ont peut-être emporté mes affaires là-bas. Si vous y allez, dites-leur qu'ils peuvent tout garder à l'exception du livre.~
@50406 = ~Je vous remercie d'avance. Je serai au portail des élémentaires de terre, en train « d'adoucir » le lieu avec des sorts mineurs.~
@50407 = ~Vous êtes de retour ! Tout se passe bien mais le travail ne manque pas. Ça avance mais il y a tant de choses que je ne peux pas faire sans votre aide !~ [VITHAL07]
@50408 = ~Il y avait un village svirfnebelin au nord. Les gnomes des profondeurs l'ont peut-être emporté là-bas. Ils peuvent garder le reste de mes affaires mais je dois récupérer mon livre.~
@50409 = ~Où pensez-vous que votre livre se trouve ?~
@50410 = ~J'en ai assez de jouer votre larbin. Ça n'en vaut pas la peine.~
@50411 = ~Désolé de vous déranger. Je reviendrai quand j'aurai retrouvé votre livre.~ ~Désolée de vous déranger. Je reviendrai quand j'aurai retrouvé votre livre.~
@50412 = ~Quoi que vous en disiez, je ne permettrai pas que l'on s'attaque aux faibles. Rappelez votre homme, monsieur, ou je serai forcé d'intervenir !~
@50413 = ~J'ai retrouvé votre livre de rituels. Tenez, prenez-le.~
@50414 = ~Toi là-bas ! Attends ! J'ai à te parler !~
@50415 = ~Qu'est-ce qui m'empêche d'utiliser votre livre pour réaliser les rituels moi-même ?~
@50416 = ~Il attaque ? Même le cœur de Bouh s'emplit de dégoût face à un tel étalage d'injustice ! Pour mon hamster, je dois botter certains arrières-train au nom du bien !~
@50417 = ~Un argument de poids. Néanmoins, la décadence et la mort attendent finalement tout être. Tu peux tuer l'homme, c'est vrai, mais le moineau est certain de posséder l'essence de ton être.~
@50418 = ~Bien au contraire. Je ne m'aventurerais pas ici si je ne pensais pas que le jeu en vaut la chandelle. Si vous pouvez m'aider, je vous en conjure faites-le.~
@50419 = ~Merci pour votre aide. Je ferai en sorte que vos efforts soient récompensés.~
@50420 = ~Je comprends ce que vous voulez dire mais n'y comptez pas. J'ai déjà mémorisé les sorts nécessaires dans mon laboratoire. Le livre contient les rituels qui les complètent et non les sorts entiers.~
@50421 = ~Absolument. La seule chose qui compte, c'est survivre. À quoi servent de tels idéaux s'ils ne te servent à rien ou ne te rendent pas plus fort ?~ ~Absolument. La seule chose qui compte, c'est survivre. À quoi servent de tels idéaux s'ils ne te servent à rien ou ne te rendent pas plus forte ?~
@50422 = ~Ha ha ha ! Cruel... mais efficace. Avec cela, tu pourrais complètement abrutir n'importe quel imbécile sans le moindre remords... c'est un peu ma philosophie.~
@50423 = ~J'avais pressenti quelque chose dans ce genre. J'ai fait en sorte d'être indispensable pour la réalisation de ce plan. Je vous dédommagerai loyalement, soyez tranquille.~
@50424 = ~Peuh ! Vous voulez donc gâcher mon plaisir ? Et puis après tout, mes thèses valaient les vôtres.~
@50425 = ~Très bien, voici votre livre.~
@50426 = ~Ce n'est pas encore suffisant. Je ne vous rendrai pas ce livre.~
@50427 = ~Nous voilà donc dans une impasse qui ne peut être résolue que par la violence. Je suis désolé que cela se termine ainsi une fois de plus... Levez vos armes, je n'ai pas le choix !~
@50428 = ~Merci, le voyage sera fructueux, vous verrez. Venons-en maintenant aux choses sérieuses. Il faudra que je passe trois portails.~
@50429 = ~Il y aura un gardien derrière chacun d'entre eux, et aucun ne sera content de nous voir. Je les attirerai l'un après l'autre. Vous devrez assurer la défense.~
@50430 = ~Allez-y, vous pouvez procéder au rituel.~
@50431 = ~Un gardien ? Quel genre de gardien ? À qui appartient donc le trésor que vous cherchez ?~
@50432 = ~Je le savais, nous allons nous jeter dans la gueule de je ne sais quelle créature et vous, vous ne lèverez pas le petit doigt.~
@50433 = ~Ah ! Vous êtes le seigneur Valygar Corthala, n'est-ce pas ? Je vous ai déjà vu, mais nous n'avons jamais eu le plaisir de nous rencontrer personnellement !~
@50434 = ~Très bien. Que les murs cèdent devant moi ! Que les espaces célestes deviennent solides afin qu'un mortel puisse les traverser !~
@50435 = ~Je ne sais pas à quoi ressemblent ces gardiens et j'ignore aussi qui les a placés là. J'imagine que l'endroit est l'ancienne cachette d'un mage des temps anciens mais je n'en suis pas sûr...~
@50436 = ~Ma famille ne revendique plus aucun titre de noblesse, ma dame. Je suis persuadé que vous ne verriez aucun intérêt dans un être tel que moi, en particulier avec la réputation de ma famille.~
@50437 = ~La curiosité qui me pousse à savoir ce qui se trouve ici est sans limite. Je suis désolé de vous mettre en danger mais je ne pourrais pas maintenir le sort et me battre. Je vous le promets, je vous paierai bien : vous recevrez une partie de ce que j'aurai trouvé.~
@50438 = ~Foutaises... Je désire toujours faire de la place pour quelqu'un qui a votre... physique. Et on aura beau dire des balivernes sur votre compte, c'est l'individu qui compte...~
@50439 = ~Alors, allez-y, procédez à vos rituels.~
@50440 = ~Je ne m'attendais pas à cela. Vous êtes sûr que cette créature n'est pas invincible ?~
@50441 = ~Vraiment ? Alors il est vraiment navrant que je sois si pris en ce moment. Peut-être... une autre fois.~
@50442 = ~Méfies-toi, noble dame. Il me parait manifeste que notre ami rôdeur n'a aucun penchant pour les femelles. Les goules peut-être, mais pas les femelles. Je pensais justement à teindre ses vêtements en rose.~
@50443 = ~Fais-le ! Montre-moi que tu es vraiment un homme, Valygar ! Montre-moi que tu as ce qu'il faut pour attirer l'attention d'une femme !~
@50444 = ~Taisez-vous, Viconia, ou je jure que je... !~
@50445 = ~Comme vous voudrez, garce d'elfe noire !~
@50446 = ~Voulez-vous que je vous laisse du temps pour vous préparer ?~
@50447 = ~Non, procédez à votre rituel.~
@50448 = ~Attendez encore un peu.~
@50449 = ~Oh, je vois que la petite demoiselle Nalia de'Arnise a décidé d'honorer la cité avec une autre de ses visites... Qu'est-ce que ce sera aujourd'hui, Nalia ? Jeter des miettes de pain aux nécessiteux ? Lécher les sabots des mendiants ?~
@50450 = ~Alors, je vais attendre. Dites-moi quand je pourrai commencer.~
@50451 = ~Vipère vicieuse ! La prochaine fois que je verrai Pehllus, je m'assurerai que vous payiez très cher cette remarque !~
@50452 = ~Rien de ce que vous pouvez dire n'a de prise sur moi, Oriana. Quand bien même je passerai la journée à me vautrer dans la fange, je me sentirai toujours plus propre qu'une catin de luxe de votre espèce.~
@50453 = ~C'est bon, vous pouvez y aller, accomplissez votre rituel et défions ce gardien.~
@50454 = ~Je ne suis pas encore en mesure de défier le gardien.~
@50455 = ~Parfait ! Nous pouvons à présent atteindre le premier portail. Nous touchons au but. Souhaitez-moi bonne chance.~ [VITHAL08]
@50456 = ~Voilà qui n'était guère agréable. Je ne peux survivre très longtemps de l'autre côté, ce qui est approprié, je présume.~ [VITHAL09]
@50457 = ~J'ai trouvé une partie du trésor. Mais ce n'est pas fini. Venez au portail de feu.~
@50458 = ~Nous entamons la seconde partie du voyage. Je vais entrer dans le Plan de feu et revenir... si possible. Souhaitez-moi une nouvelle fois bonne chance. Un autre gardien pourrait bien protéger ce portail. Restez sur vos gardes.~ [VITHAL10]
@50459 = ~Nous y sommes presque. Venez ! Hâtons-nous vers le portail de l'élémentaire de l'air. Une autre partie du trésor nous appartient désormais.~ [VITHAL11]
@50460 = ~Encore un voyage, et nous aurons tout récupéré. Quel dommage que je n'aie pas connu le mage qui les a cachés. Il se serait avéré un allié de taille.~ [VITHAL12]
@50461 = ~Souhaitez-moi une fois de plus bonne chance pour mon passage de l'autre côté. Mais encore une fois vous devrez d'abord faire face à un gardien.~
@50462 = ~Me voilà de retour ! Ahh, c'est bon de sentir sous ses pieds le sol des Plans primaires. L'autre côté a ses charmes mais rien ne vaut d'être chez soi.~ [VITHAL13]
@50463 = ~Et vous mon ami, l'étranger qui m'a aidé, sachez que je tiendrai parole. Vous recevrez votre dû, comme je vous l'avais promis.~ ~Et vous mon amie, l'étrangère qui m'a aidé, sachez que je tiendrai parole. Vous recevrez votre dû, comme je vous l'avais promis.~
@50464 = ~Je suis sûr que ceci vous satisfera. Je n'y ai jeté qu'un coup d'œil mais je suis persuadé qu'il vaut bien les efforts que nous avons faits. Ce n'est qu'une petite partie de l'ensemble mais cela est digne de vos services.~
@50465 = ~Merci. Je suis sûr que ce sceptre enchanté sera une rétribution suffisante.~ ~Merci. Je suis sûre que ce sceptre enchanté sera une rétribution suffisante.~
@50466 = ~Hmm, ma part est peut-être un peu trop petite. J'aimerais que vous y réfléchissiez de nouveau.~
@50467 = ~C'est tout ? Un simple sceptre enchanté ? Après tous les risques que j'ai pris ?~
@50468 = ~Il vous servira, j'en suis sûr. Adieu, mon ami, et prenez soin de vous au cours de votre voyage.~ ~Il vous servira, j'en suis sûr. Adieu, mon amie, et prenez soin de vous au cours de votre voyage.~
@50469 = ~Je crois plutôt qu'en l'occurrence, c'est moi qui ai pris la majorité des risques. C'est moi qui ai traversé les différents plans, je vous le rappelle.~
@50470 = ~Bon, puisque vous insistez tant, je suppose que je pourrais réévaluer un peu votre récompense mais je me réserve toujours le droit de conserver la plus grosse part pour moi.~
@50471 = ~Prenez ces deux parchemins de sorts. Cela devra vous suffire car vous n'aurez rien de plus.~
@50472 = ~C'est suffisant. Je vous remercie pour votre générosité.~
@50473 = ~Ce n'est toujours pas assez. Je vais devoir vous demander d'être plus généreux.~
@50474 = ~Je pense que je mérite le tout. Si vous ne me le donnez pas vous-même, je devrai vous le prendre par la force.~
@50475 = ~Je refuse votre demande. J'ai été plus que généreux et vous m'en demandez davantage ! Ce que je vous ai donné devra suffire ou nous devrons nous battre en duel.~
@50476 = ~Je n'en attendais pas moins d'un étranger en Ombre-Terre. Très bien, prenons les armes et les sorts et réglons notre querelle. Je regrette que nous en soyons arrivés là.~ ~Je n'en attendais pas moins d'une étrangère en Ombre-Terre. Très bien, prenons les armes et les sorts et réglons notre querelle. Je regrette que nous en soyons arrivés là.~
@50477 = ~Tu es donc le mercenaire envoyé par Logan pour nous sauver ? Sauras-tu mettre les druides en échec ?~
@50478 = ~Cela me convient.~
@50479 = ~Tout me revient ! Donnez-moi tout !~
@50480 = ~Cela reste à voir. Cependant, je suis sûr de mon succès.~ ~Cela reste à voir. Cependant, je suis sûre de mon succès.~
@50481 = ~Qui donc crois-tu être pour me questionner ainsi ?~
@50482 = ~Seigneur Khellon Menold~
@50483 = ~Notre accord est récent. Je m'étonne que tu sois déjà au courant de notre arrangement.~
@50484 = ~Alors, quelle mission notre « noble » Grand Marchand t'a-t-il donc proposé ?~
@50485 = ~Cela ne te regarde en rien.~
@50486 = ~Il m'a chargé de demander au druide Cernd pourquoi les druides et les animaux attaquent la cité.~
@50487 = ~Tu devrais surveiller tes paroles lorsque tu t'adresses à des gens qui te sont supérieurs, mon jeune ami. Je suis le Seigneur Khellon Menold, futur Grand Marchand de cette cité !~ ~Tu devrais surveiller tes paroles lorsque tu t'adresses à des gens qui te sont supérieurs, ma jeune amie. Je suis le Seigneur Khellon Menold, futur Grand Marchand de cette cité !~
@50488 = ~Vraiment ? As-tu porté cette décision à la connaissance de Logan ?~
@50489 = ~C'est toi qui devrais surveiller les tiennes. Écarte-toi de mon chemin.~
@50490 = ~Tiens, un petit-homme de haute lignée. Que puis-je faire pour toi ?~
@50491 = ~Ne sais-tu pas que l'homme de biens est puissant ? Il m'a été facile d'obtenir cette information. Alors dis-moi, que t'a demandé notre « noble » Logan ?~
@50492 = ~Cela ne te regarde en rien.~
@50493 = ~Il m'a chargé de demander au druide Cernd pourquoi les druides et les animaux attaquent la cité.~
@50494 = ~Hein ? Toi, là-bas... oui, toi, le gnome. Ton visage m'est familier... serais-tu apparenté à ce Comte de Navet avec qui j'ai une fois fait affaire ?~
@50495 = ~Même le plus grand des imbéciles saurait cela ! Ils veulent nos terres à tout prix. C'est l'esprit maléfique du « bosquet » qui les y pousse !~
@50496 = ~Mais dis-moi, désires-tu réellement nous aider à en finir ou ce sot de Logan a-t-il contaminé ton esprit avec ses idées ?~
@50497 = ~Gardien de la source~
@50498 = ~Gardien de la source~
@50499 = ~Hmmm. J'avoue que pour une elfe, tu as les traits gracieux. Les beaux yeux bleus que voilà... peut-être pourrais-je un instant oublier Oriana et passer un petit moment avec toi. Qu'en dis-tu ?~
@50500 = ~Bourreau~
@50501 = ~Pour quelle raison t'écouterais-je ? Logan est le maître de cette cité.~
@50502 = ~Je suis en effet intéressé par une solution définitive.~ ~Je suis en effet intéressée par une solution définitive.~
@50503 = ~Je suis lassé de tes discours. Écarte-toi.~ ~Je suis lassée de tes discours. Écarte-toi.~
@50504 = ~J'ai déjà entendu parler de lui. Un joli garçon, charmant et intelligent. Très diligent également, la prunelle des yeux de sa mère. Pourquoi cette question ?~
@50505 = ~Je serai bientôt Grand Marchand et tous les hommes de pouvoir de la cité me soutiennent. Les jours de Logan sont comptés. Que t'a-t-il demandé ?~
@50506 = ~Eh bien, je... je n'ai toujours aucune nouvelles de lui et de l'expédition. Après tout, cela fait maintenant bien longtemps qu'ils sont partis.~
@50507 = ~Cela ne te regarde en rien.~
@50508 = ~Il m'a chargé de demander au druide Cernd pourquoi les druides et les animaux attaquent la cité.~
@50509 = ~Eh bien, l'exploration est un métier si dangereux. Son navire a peut-être sombré au milieu d'une terrible tempête en voguant vers Maztica. Ah, oui, je l'imagine maniant vaillamment la barre, le regard plongé au cœur du maelström, tandis que le reste de l'équipage, pris de terreur, abandonne le navire. Tss. Quel gâchis de bon or serait une telle tragédie, en plus de nous prendre un gnome aussi respecté. Moi, j'ai le mal de mer.~
@50510 = ~Des visions ! Encore ces visions de mon esprit ! Ah ! Je vous renie ! Je sais donc je suis !~
@50511 = ~Petit ingrat ! Rustaud ! Tu ne sais donc pas te tenir à ta place ? Il vaut encore mieux que tu ne travailles pas pour moi, espèce de bon à rien ! Hmpf !~ ~Petite ingrate ! Rustaude ! Tu ne sais donc pas te tenir à ta place ? Il vaut encore mieux que tu ne travailles pas pour moi, espèce de bonne à rien ! Hmpf !~
@50512 = ~Humpf. Moi, je pense plutôt à vous envoyer vous faire voir, vous et votre flagorneur, là. Oncle Quayle m'a bien mise en garde contre les vieux dégoûtants de votre espèce.~
@50513 = ~Et toi, le plus obscur des elfes, pourquoi te vois-je dans ma tête ? Rêves de beauté noire ou sombres cauchemars ?~
@50514 = ~De nouveaux personnages qui hantent mon esprit ? Mais pourquoi ? J'en ai déjà vu tellement ! Maudit soit mon esprit stagnant pour toutes les scènes qui s'y déroulent !~
@50515 = ~Écarte-toi de mon chemin, petit-homme.~
@50516 = ~Les véritables détenteurs du pouvoir commencent à se lasser de l'affectation de Logan et de ses balivernes de paladin. Je serai bientôt Grand Marchand, et tu ferais preuve de sagesse en t'entendant avec moi.~
@50517 = ~Quoi que tu sois, je te bannis ! Je ne serai pas l'esclave de fantômes ! Je sais donc je suis !~
@50518 = ~Depuis combien de temps es-tu emprisonné, camarade ?~
@50519 = ~Je t'ai délivré. Détends-toi, te voilà libre.~
@50520 = ~Je ne t'ai pas délivré pour écouter tes divagations !~
@50521 = ~Calme-toi, afin que nous discutions le prix de ta liberté.~
@50522 = ~Très bien. Parle et je t'écouterai.~
@50523 = ~Je ne veux plus t'entendre ! Hors de ma vue !~
@50524 = ~Pourquoi mon propre esprit me demande-t-il la durée de son séjour ? Me raillerais-je moi-même à présent ? Je suis prisonnier ; tout cela n'est rien d'autre que le fruit de mon imagination ! Un rêve !~
@50525 = ~Mon propre esprit se raille de moi en me parlant de liberté, alors que je suis toujours prisonnier ! J'ai déjà trop souvent rêvé de liberté pour y croire encore cette fois-ci !~
@50526 = ~Un elfe noir ? Ici ? C'est à se demander ce qu'ils complotent en douce. Il semblerait que justice va être faite... que son cœur plein de noirceur soit réduit en poussière !~ ~Une elfe noire ? Ici ? C'est à se demander ce qu'ils complotent en douce. Il semblerait que justice va être faite... que son cœur plein de noirceur soit réduit en poussière !~
@50527 = ~Arrière ! Retourne te cacher dans mon esprit ! Va-t'en, je ne croirai pas ce mensonge !~
@50528 = ~Ne me force pas à te faire du mal ! Je ne souhaite que t'aider !~
@50529 = ~Tu es un peu perdu... ou peut-être fou... Calme-toi ou tu vas te faire du mal.~
@50530 = ~Bah ! Je ferais aussi bien de te tuer pour ne plus entendre toutes ces sottises !~
@50531 = ~Il semblerait qu'une elfe noire ait été capturée et soit sur le point d'être brûlée. Bien. Ce monstre a le sort qu'il mérite.~
@50532 = ~Arrière ! Tes paroles sont les miennes ! Je ne vois rien d'autre qu'une illusion de liberté ! Va-t'en, je parviendrai à te chasser !~
@50533 = ~Une... une elfe noire ? Ici ? Qu'a-t-elle bien pu manigancer ? Je me le demande. Et qu'a-t-elle fait à ces gens pour qu'ils veuillent... la brûler. Je... je suppose que tout le monde n'a pas forcément besoin d'une raison.~
@50534 = ~Je n'aime pas les elfes noirs, pas elle en particulier... mais je crois qu'elle n'a rien fait pour mériter ce sort, en dehors du fait d'être une elfe noire. Ce n'est pas la justice.~
@50535 = ~Je suis heureux de te l'entendre dire. Le fait est que ce couard de Logan va échouer. J'en viens même à me demander s'il souhaite réellement arrêter les druides fous !~
@50536 = ~Je... j'ai entendu parler des elfes noirs, mais celle-ci a-t-elle commis quelque crime ? C'est seulement pour la punir d'être ce qu'elle est qu'ils veulent la brûler. C'est injuste, <CHARNAME> ! Faites quelque chose !~
@50537 = ~Ils... ils ne vont pas brûler cette jolie elfe ? Il ne doit pas y avoir de bûcher si elle n'a commis aucun crime ! C'est de l'injustice ! <CHARNAME>, mettons fin à cette farce !~
@50538 = ~Thhhh... uhhhh...~
@50539 = ~Permets-moi de te présenter la situation. Tu comprendras ainsi les épreuves qui t'attendent et sauras ce qu'il te faudra accomplir.~
@50540 = ~Qui es-tu ?~
@50541 = ~J'ai pu te sauver, mais j'ai quelques questions. Tu comprends ?~
@50542 = ~Alors, est-ce un marché en échange de ta vie, ou préfères-tu mourir ici ?~
@50543 = ~Euh...~
@50544 = ~Ben...~
@50545 = ~Je crois que tu as perdu l'esprit. Tout va bien ?~
@50546 = ~Bonjour, il y a quelqu'un ?~
@50547 = ~Parle, sinon ta vie se termine ici !~
@50548 = ~Euuuuh...~
@50549 = ~Je t'écoute.~
@50550 = ~Que... quoi ? Qui... qui es-tu ?~
@50551 = ~Je n'ai aucune envie d'écouter ta stupide petite histoire. Hors de ma vue !~
@50552 = ~Je m'appelle <CHARNAME>. J'ai pu te sauver de ton horrible emprisonnement.~
@50553 = ~J'allais te demander la même chose.~
@50554 = ~Ah, tu as repris tes esprits. Maintenant nous pouvons parler de mon paiement.~
@50555 = ~C'est cela que tu appelles la justice, <CHARNAME> ? J'ai senti une grande tristesse derrière sa noirceur. Dans l'harmonie, elle aurait pu... qui sait ?~
@50556 = ~Emprisonnement... ? Je... mon emprisonnement a été... si long. Oh, merci ! Merci ! Mon esprit s'était perdu dans... le néant !~
@50557 = ~Nous ne la sauvons pas ? Quel fut son crime ? Les elfes noirs ne sont peut-être pas complètement bons, mais ils ne sont sûrement pas complètement mauvais. Je suis... confus. Qu'en pense Bouh ?~
@50558 = ~Je... je m'appelle... Raevilin... je crois. Je n'ai pas prononcé mon nom depuis si longtemps... depuis que je n'ai pas respiré pour prononcer mon nom...~
@50559 = ~Ainsi, c'est fait. Elle est morte, qui que ce fut. *frissonne* L... l'Ombre-Terre est un lieu terrible, <CHARNAME>. J'espère que nous n'aurons jamais à y aller !~
@50560 = ~Et justice est faite. Si ce pouvait être le sort de toutes les créatures maléfiques, le bien serait peut-être rétabli en ce monde. Au nom de Torm, j'ai juré de servir cette cause.~
@50561 = ~Paie... ment ? Je... je suis libre ! Je suis libre de cette... chose ! Je...~
@50562 = ~Tu... tu es un elfe noir ! Pourquoi m'as-tu libéré ?! Vas-tu maintenant me tuer ? Je ne jouerai pas ton jeu !~ ~Tu... tu es une elfe noire ! Pourquoi m'as-tu libéré ?! Vas-tu maintenant me tuer ? Je ne jouerai pas ton jeu !~
@50563 = ~N'écoutez pas l'elfe noire, <CHARNAME>. Vous l'avez sauvée, mais vous n'en êtes pas responsable. Elle est mauvaise, vous dis-je ! Elle n'a pas sa place parmi nous !~
@50564 = ~Bourreau~
@50565 = ~Silence, sorcière ! Ne la prenez pas parmi nous, <CHARNAME> ! Cela n'amènera que du mal ! Je n'en veux pas !~
@50566 = ~Sache bien que je n'ai rien contre le fait que Viconia voyage avec nous. Mais imagine ce que les autres penseront en nous voyant avec elle.~
@50567 = ~Est-ce toi qui m'as fait emprisonner ? Je ne veux pas te manquer de respect, mais je ne sais vraiment pas. J'étais en train d'explorer et... et je ne me souviens de rien d'autre.~
@50568 = ~Ne... ne la laissez pas nous accompagner, <CHARNAME> ! Les elfes noirs... tous les elfes noirs... sont des êtres cruels, des créatures terribles ! Ils déciment les avariels sans merci, on ne peut pas leur faire confiance !~
@50569 = ~Je n'emprisonnerais jamais quelqu'un d'autre. Je trouve cela cruel.~
@50570 = ~Je ne comprends pas pourquoi quelqu'un te ferait cela sans raison. Tu le crois vraiment ?~
@50571 = ~Peu importe. Écoute, tu ne m'intéresses pas, je veux simplement être payé pour ta libération.~ ~Peu importe. Écoute, tu ne m'intéresses pas, je veux simplement être payée pour ta libération.~
@50572 = ~Corsaire~
@50573 = ~T... taisez-vous ! <CHARNAME>, vous l'avez sauvée... faites-la partir, à présent !~
@50574 = ~Corsaire~
@50575 = ~C'était... le cas. Je te remercie d'avoir eu pitié de moi. Tiens, prends ceci en guise de paiement. Cela vaut son prix, mais je n'en aurai plus besoin. Je vais sortir d'ici et abandonner l'aventure.~
@50576 = ~Je ne pensais pas que cette elfe noire pouvait être si... impressionnante. Une belle créature, dépourvue de compassion, à ce que je sais. Amenez-la ou renvoyez-la, cela m'importe peu.~
@50577 = ~Oui, je le crois. Je ne sais pas comment j'ai pu me faire un ennemi. Mon groupe n'avait encore rien découvert d'important.~
@50578 = ~Nous l'avons sauvée et elle est sous notre responsabilité. Et si elle était de nouveau capturée ? Ni Bouh, ni moi ne pourrions nous regarder en face. Non, elle doit venir.~
@50579 = ~Je... je m'en vais. Je quitte cet endroit et l'aventure. Tiens, prends ceci. J'apprécie ce que tu as fait. Bonne chance.~
@50580 = ~Pipe~
@50581 = ~Tu veux simplement... ? Est-ce là une forme cruelle d'extorsion ? Payer ou rester en prison ? Est-ce toi qui as fait cela ?~
@50582 = ~Je ne te donnerai rien, et je ne me laisserai pas emprisonner à nouveau !~
@50583 = ~Et quelle est ta place ? Celle du meneur qui profère les accusations ? J'ai survécu à plus de rivvins suffisants que toi, et j'ai fait bien moins de mal !~ ~Et quelle est ta place ? Celle de la meneuse qui profère les accusations ? J'ai survécu à plus de rivvins suffisants que toi, et j'ai fait bien moins de mal !~
@50584 = ~Tu prétends être une avarielle, fillette ? Où sont tes ailes, dans ce cas ? T'ont-elles, comme moi, trouvée bégayante et pathétique, au point de s'envoler enfin loin de toi ?~
@50585 = ~Ha ! Je n'ai rien contre toi, la déplumée, mais à te voir trembler, je n'ai aucun mal à imaginer le piètre compagnon de voyage que tu peux être. Pourquoi la gardes-tu dans le groupe, <CHARNAME> ? Par pitié ?~
@50586 = ~Je survivrai, pourri. J'ai été prise par surprise aujourd'hui, mais j'ai longtemps vécu secrètement au milieu des rivvins. Je ne vois, moi non plus, aucune objection à voyager avec toi.~
@50587 = ~C'est à <CHARNAME> qu'il revient de prendre cette décision. Un peu de cran, <CHARNAME>... emmène-moi avec toi et je me battrai à tes côtés ! Ensemble, nous les vaincrons tous !~
@50588 = ~Certainement. Je suis sûr que tu seras très utile à notre cause.~ ~Certainement. Je suis sûre que tu seras très utile à notre cause.~
@50589 = ~Pas pour le moment, Viconia. Peut-être plus tard.~
@50590 = ~Ce n'est pas la première fois que ces monstres, ces adorateurs de la nature, nous posent des problèmes. Loin de là. L'an passé, ma compagnie a voulu ouvrir dans la forêt un chemin caravanier.~
@50591 = ~Jamais ! Je t'ai sauvée, Viconia, mais notre relation s'arrête là. Va-t'en... je ne veux plus jamais te revoir.~
@50592 = ~Très bien, jaluk. Tu es aussi faible que dans mes souvenirs. Si nous nous revoyons un jour, tu seras peut-être alors suffisamment fort pour me permettre de te rendre la pareille. Aluve', <CHARNAME>.~ ~Très bien, jalil. Tu es aussi faible que dans mes souvenirs. Si nous nous revoyons un jour, tu seras peut-être alors suffisamment forte pour me permettre de te rendre la pareille. Aluve', <CHARNAME>.~
@50593 = ~Cette route devait être immense, pavée et pratique d'accès. En d'autres termes, nous allions construire le plus beau chemin caravanier de toute la côte des Épées !~
@50594 = ~Très ambitieux. Que s'est-il passé ?~
@50595 = ~Je n'aurai pas dû t'écouter. Tu m'ennuies avec tes divagations et ta cupidité. Laisse-moi tranquille.~
@50596 = ~Thhh ! La bataille a été si longue à venir ! G'lth na dok ! Jamais plus je ne serai esclave !~
@50597 = ~Quoi ? Attends ! Nous ne sommes pas obligés de faire cela !~
@50598 = ~Mes hommes et moi avons entamé sa construction, mais, sitôt le premier arbre tombé, nous avons vu un druide jaillir d'un buisson, hurlant comme un banshee.~
@50599 = ~Il s'est mis à parler de l'Esprit du bosquet, de la nature sacrée et de bien d'autres sottises encore. Nous avons dû l'assommer pour le faire taire.~
@50600 = ~Je me défendrai s'il le faut, githyanki !~
@50601 = ~Enfin un combat digne de ce nom ! Allons-y !~
@50602 = ~La mort vivante doit être éradiquée ! Je me bats pour une place aux côtés de Gith !~
@50603 = ~Très vite, d'autres druides ont surgi, hurlant et jetant des sorts à mes hommes ! Ils m'ont ensuite ligoté avec des plantes grimpantes et des racines. Ils nous ont gardé l'après-midi durant, et nous avons dû les écouter pérorer sur la nature et je ne sais quelles foutaises.~
@50604 = ~Pendentif~
@50605 = ~Casque~
@50606 = ~Cimeterre~
@50607 = ~Enfin libre ! Les vivants paieront pour la non-mort de cette prison ! Je marche à nouveau !~
@50608 = ~C'en était trop ! Une fois notre liberté retrouvée, nous avons pu en tuer quelques-uns... Le druide Verthan est ensuite venu me trouver à Franc-Marché et m'a accusé d'incitation au meurtre !~
@50609 = ~Le malotru !~
@50610 = ~Cette histoire est complètement stupide ! Écarte-toi !~
@50611 = ~Oui, tu es libre. As-tu un mot gentil ou une récompense pour ton sauveur ?~ ~Oui, tu es libre. As-tu un mot gentil ou une récompense pour ta sauveuse ?~
@50612 = ~Mais quel genre de bête sauvage es-tu ?~
@50613 = ~Vile créature ! Arrière ! Retourne dans ta prison !~
@50614 = ~Les vivants s'adressent à Alchra. Ah, cela faisait longtemps que je n'avais entendu leurs cris. Je ne perdrai pas une minute de plus avec ces créatures simiesques.~
@50615 = ~Mourez rapidement, enfants-viande, j'ai à faire avec des traîtres d'elfes noirs.~
@50616 = ~Logan a pris leur parti et a interdit à ma compagnie de pénétrer dans le bosquet sous peine de mort. J'ai perdu 20 000 pièces d'or !~
@50617 = ~Quel est le rapport avec la situation qui nous occupe ?~
@50618 = ~Tu es cruel et égoïste. Je ne t'écouterai pas une minute de plus !~
@50619 = ~Les druides sont de plus en plus agressifs. Si on les laisse agir à leur guise, la population tout entière sera massacrée. Logan, leur instrument, connaîtra le même sort.~
@50620 = ~Logan tente de faire la paix avec les démons. J'entends mettre fin à leurs maléfices. Il est évident que tu as déjà bataillé. Je souhaiterais t'engager et faire de mon projet une réalité.~
@50621 = ~... JE NE ME RENDRAI JAMAIS ! SI TU CROIS QUE... mais ?~
@50622 = ~Qui... qui êtes-vous ? Je... j'étais en train d'affronter un groupe d'elfes noirs avec mes compagnons, et...~
@50623 = ~De quel projet parles-tu et quel y serait mon rôle ?~
@50624 = ~Je vois où tu veux en venir. Je refuse de prendre part à ce massacre, et je ne manquerai pas d'aviser Logan de tes intentions.~
@50625 = ~Non... laissez-moi vous expliquer... ces êtres étaient bien des elfes noirs, tout comme vous, mais ils étaient... ils étaient différents. Que voulez-vous ?~
@50626 = ~Imbécile ! Ne vois-tu pas que tu n'as rien qui puisse étayer tes dires ? Cours donc voir ton maître, fantoche, mais crois-moi lorsque je te dis que tu vas au devant des ennuis.~
@50627 = ~J'exige de connaître vos intentions sur-le-champ ! Qu'avez-vous fait de mes compagnons ? Parlez !~
@50628 = ~Dans le bosquet demeure un esprit maléfique qui ne désire rien moins que la destruction de cette cité et de tout ce qui s'y trouve. Et Logan, cet imbécile, n'en fait pas cas !~
@50629 = ~Je vois des elfes noirs parmi vos compagnons ! Ne vous approchez pas de moi ! Restez à bonne distance !~
@50630 = ~Ne dirige pas ton courroux contre moi, imbécile ! Ce n'est pas moi ton ennemi, ici !~
@50631 = ~L'homme est soit maître de la nature, soit son esclave, et je n'ai pas de goût pour la sujétion. Il n'existe qu'un moyen d'échapper à cette situation.~
@50632 = ~Et quel est-il ?~
@50633 = ~Je ne prendrai pas part à tes vilenies. J'aviserai Logan de ce projet !~
@50634 = ~Nous devons tuer les druides avant qu'ils ne nous tuent. Nous devons détruire leur pouvoir à la source, afin que plus jamais ne se reproduisent de tels événements. Nous devons libérer le bosquet de son esprit maléfique.~
@50635 = ~Le bosquet tient sa magie maléfique d'une « source sacrée » qui se trouve dans le repaire des druides. À toi de détruire la source et d'affaiblir les druides. La source disparue, il nous sera facile de les faire disparaître.~
@50636 = ~Cela me paraît bien vu. Comment comptes-tu détruire cette « source sacrée » ?~
@50637 = ~C'est monstrueux ! Comment oses-tu me proposer une telle chose ? Je refuse de prendre part à pareille vilenie, infernal petit-homme !~
@50638 = ~Je me suis procuré une fiole de poison sulfureux. Trouve la source et verses-y le poison. Les druides seront affaiblis et nous pourrons disposer d'eux aisément. Qu'en penses-tu ?~
@50639 = ~<CHARNAME> ? Tu es... c'est bien toi ? C'était... l'Écorcheur ! Tu es devenu une forme de réincarnation de Bhaal... mais le dieu est mort...~ ~<CHARNAME> ? Tu es... c'est bien toi ? C'était... l'Écorcheur ! Tu es devenue une forme de réincarnation de Bhaal... mais le dieu est mort...~
@50640 = ~<CHARNAME>, ça ne va pas du tout.~
@50641 = ~Vith'ir ! Je n'imaginais pas telle puissance ! <CHARNAME>, quelle sorte de créature...~
@50642 = ~Un aspect de Bhaal... un vestige de son avatar. Ce doit être ça. <CHARNAME>, tu es devenu une pure créature du crime.~ ~Un aspect de Bhaal... un vestige de son avatar. Ce doit être ça. <CHARNAME>, tu es devenue une pure créature du crime.~
@50643 = ~<CHARNAME> ! Êtes-vous... qu'est-ce que c'était ? Pouvez-vous...~
@50644 = ~<CHARNAME>, c'était un aspect de Bhaal... j'ai trouvé des explications dans des textes... vous êtes devenu... un élément d'un avatar... d'un dieu mort ?~ ~<CHARNAME>, c'était un aspect de Bhaal... j'ai trouvé des explications dans des textes... vous êtes devenue... un élément d'un avatar... d'un dieu mort ?~
@50645 = ~<CHARNAME> ! Tant de mal émane de toi ! As-tu retrouvé tes esprits ?~
@50646 = ~L'Ordre nous enseigne beaucoup sur Bhaal et ses différentes formes... ceci était... l'Écorcheur ? Tu serais un... avatar du dieu mort ?~
@50647 = ~Je serais bien incapable de te dire où ils se trouvent. Je viens d'arriver et je tombe sur toi, prisonnier de ce lieu.~
@50648 = ~C'est l'enfermement qui te fait perdre la tête ! À cause de lui tu vois des ennemis partout ! Je ne te veux aucun mal.~
@50649 = ~Ils se seront sans aucun doute enfui après t'avoir vu fait prisonnier, imbécile que tu es !~
@50650 = ~Je n'ai pas à te répondre. Tu me dois le respect, je t'ai libéré de cet enchantement.~
@50651 = ~Moi, prisonnier ? Que Diable... Ce fichu elfe noir a dû me jeter un sort ! Il me semblait si facile à battre... j'aurais dû m'en douter.~
@50652 = ~Durst~
@50653 = ~Gellal~
@50654 = ~Durst~
@50655 = ~Gellal~
@50656 = ~Lonk a trouvé la mort. Ce ne sont alors que chuchotements et manifestations de joie parmi les otages qui se voient soudain libres. Quant à vous, vous n'espérez qu'une chose : avoir agi au plus juste.~
@50657 = ~*lorsque vous tournez une page de l'ancien grimoire, un portail magique apparaît soudain, libérant un monstre assoiffé de sang !*~
@50658 = ~*le grimoire enchanté crée plusieurs objets magiques pour vous*~
@50659 = ~On ferait bien de s'assurer des prisonniers, <CHARNAME>. Mieux vaudrait éviter qu'il ne mettent tout à sac.~
@50660 = ~<CHARNAME>, nous devons agir vite ! Les mages que tu as relâchés ont besoin d'ordres, sinon ils seront impossibles à contrôler.~
@50661 = ~Pourquoi ne le fais-tu pas toi-même ?~
@50662 = ~Qui sont ces citoyens tourmentés que tu dis représenter ?~
@50663 = ~je serais ravi de t'aider. Tu m'as bien parlé d'une récompense ?~ ~je serais ravie de t'aider. Tu m'as bien parlé d'une récompense ?~
@50664 = ~Maintenant que nous avons libéré ces aliénés, nous ferions mieux de nous hâter de les orienter. Sinon, leur démence pourrait bien nous saisir.~
@50665 = ~Par Torm, <CHARNAME> ! Je viens juste de l'apprendre ! Qu'avez-vous fait ? Êtes-vous devenu fou ?~ ~Par Torm, <CHARNAME> ! Je viens juste de l'apprendre ! Qu'avez-vous fait ? Êtes-vous devenue folle ?~
@50666 = ~Ta proposition ne m'intéresse pas. Je refuse d'empoisonner le bosquet.~
@50667 = ~Quel est le problème, seigneur Coprith ?~
@50668 = ~Ne laissons pas les pensionnaires livrés à eux-mêmes trop longtemps. Agissons sur l'heure avant qu'ils ne deviennent incontrôlables.~
@50669 = ~Hâtez-vous, <CHARNAME>, ces pauvres pensionnaires pourraient se blesser si nous ne nous en occupons pas.~
@50670 = ~Bouh a peur que ces pensionnaires ne se blessent tous seuls, <CHARNAME>. Nous devrions vérifier qu'ils sont en sécurité et qu'ils ont tous un hamster bien à eux.~
@50671 = ~La dernière partie était mon idée.~
@50672 = ~*perd tous les pouvoirs de Bhaal*~
@50673 = ~Magnifique ! Le chat est mort et les souris dansent partout comme des folles. <CHARNAME>, donne quelque chose à faire à ces fous, sinon nous allons avoir des ennuis.~
@50674 = ~Ahhh, je ne supporte pas les fous ! <CHARNAME> ! Tu devrais enfermer ces lunatiques, sinon nous serons submergés !~
@50675 = ~Oh, cela me rappelle la dernière réunion de la famille Jansen... ce fut la dernière pour des raisons qui, j'en suis sûr, vont te paraître limpides dans un instant... c'était la veille du jour de l'Année des ombres, lorsque les dieux foulaient la terre et que la magie se déchaînait. Le cousin Bungle corsa le thé aux navets à la fin d'une gigue endiablée et la moitié des grands-parents finirent tellement ivres qu'ils montèrent à l'assaut d'un camp d'orques voisin. Tu ne peux pas savoir ce qu'est le chaos tant que tu n'as pas subi l'assaut d'une vingtaine de tranches-gobelins séniles exigeant tous des gemmes et de la bière, crois-moi.~
@50676 = ~Eh bien, je veux dire par là que nous ferions mieux de donner une bonne raison à ces mages de rester en notre compagnie ou nous risquons de baigner dans les ennuis jusqu'au cou.~
@50677 = ~Serais-tu sourd, par hasard ? Je te dis que « l'honorable » Grand Marchand a menacé de me tuer si je m'approche du bosquet. En outre, cette mission ne conviendrait pas à mes compagnons de haute naissance.~ ~Serais-tu sourde, par hasard ? Je te dis que « l'honorable » Grand Marchand a menacé de me tuer si je m'approche du bosquet. En outre, cette mission ne conviendrait pas à mes compagnons de haute naissance.~
@50678 = ~Nous devrions appliquer les lois de l'équilibre aux plans de ces magiciens que nous avons libérés, <CHARNAME>, si nous voulons qu'ils nous soient utiles.~
@50679 = ~User de magie pour diviser la force de ses adversaires, voilà qui est ingénieux, elfe noir... Mais ceux de ton espèce sont retors. Je ne me laisserai plus prendre à ton jeu.~
@50680 = ~Décidément, je ne connais pas plus retors que ces elfes noirs. User de magie pour diviser mon groupe, voilà qui est ingénieux. J'espère que mes compagnons ne s'y sont pas laissés prendre.~
@50681 = ~Cela suffit... Je dois vivre.~
@50682 = ~Qui sont ces citoyens tourmentés que tu dis représenter ?~
@50683 = ~Noon !~
@50684 = ~Je considérerai cela comme un compliment, humain.~
@50685 = ~Prend-le comme tu veux, elfe noir. Discuter avec toi me fait perdre mon temps. Je ne m'attends à rien d'autre qu'à de trahison dans cet endroit.~
@50686 = ~Soit. Je t'obéirai. Tu m'as bien parlé d'une récompense ?~
@50687 = ~Alors, nous affronterons-nous, toi et moi ? Ce sortilège n'a pas dû agir bien longtemps, car mon esprit est clair et je sais qu'une bonne action n'est jamais gratuite. Exprimes tes intentions.~
@50688 = ~Ta proposition ne m'intéresse pas. Je refuse d'empoisonner le bosquet.~
@50689 = ~Nobles, partisans, laquais, sympathisants... pourquoi t'en inquiètes-tu ? Acceptes-tu cette mission oui ou non ?~
@50690 = ~Pourquoi ne t'en charges-tu pas toi-même ?~
@50691 = ~Donne-moi ce poison et je te jure que tu n'entendras plus parler de ces druides. Tu m'as bien parlé d'une récompense ?~
@50692 = ~Ta proposition ne m'intéresse pas. Je refuse d'empoisonner le bosquet.~
@50693 = ~Lâche... tu vas mourir !~
@50694 = ~Hmpf. Je t'ai mal jugé. Tu es un couard. Cours rejoindre Logan au royaume des pleutres. Lorsque j'aurai le pouvoir, tu ne seras plus le bienvenu à Franc-Marché.~ ~Hmpf. Je t'ai mal jugé. Tu es une couarde. Cours rejoindre Logan au royaume des pleutres. Lorsque j'aurai le pouvoir, tu ne seras plus la bienvenue à Franc-Marché.~
@50695 = ~Je ne suis pas venu à ton secours pour me battre contre toi. Tu es libre de t'en aller.~ ~Je ne suis pas venue à ton secours pour me battre contre toi. Tu es libre de t'en aller.~
@50696 = ~Si tu ne changes pas de ton, nous risquons en effet d'avoir à nous battre. Mais je serai magnanime ; tu peux t'en aller.~
@50697 = ~Mon intention est de tirer avantage de ta condition de prisonnier.~
@50698 = ~Battons-nous puisque tu sembles y tenir. Je suis désœuvré.~ ~Battons-nous puisque tu sembles y tenir. Je suis désœuvrée.~
@50699 = ~Détecte les pièges / les illusions~
@50700 = ~Arrête de détecter les pièges / les illusions~
@50701 = ~Ta réponse me laisse sans voix. Je ne m'attendais certainement pas à rencontrer des êtres si aimables dans ces galeries.~
@50702 = ~Repousse les morts-vivants~
@50703 = ~Arrête de repousser les morts-vivants~
@50704 = ~A repoussé les morts-vivants~
@50705 = ~Chante un Chant du barde~
@50706 = ~Arrête son Chant du barde~
@50707 = ~Sommeil~
@50708 = ~Tirer avantage ? Veux-tu dire par là que tu désires une récompense ? Si j'avais eu de la fortune, j'aurais marchandé ma libération en moins de temps qu'il n'en faut pour le dire !~
@50709 = ~Tu m'attaquerais sans raison ? Ce serait répréhensible même dans un endroit tel que celui-ci.~
@50710 = ~Souhait~
@50711 = ~Tu ne sembles pas m'avoir bien compris. Tu es un imbécile. Puisque tu sembles y tenir, battons-nous. Ainsi je mourrai sans même une raison valable.~ ~Tu ne sembles pas m'avoir bien compris. Tu es une imbécile. Puisque tu sembles y tenir, battons-nous. Ainsi je mourrai sans même une raison valable.~
@50712 = ~À l'attaque ! À l'attaque !~
@50713 = ~Donne-moi de l'argent ou tu mourras. C'est aussi simple que cela.~
@50714 = ~Très bien. Après tout, tu n'as pas besoin de moi pour sortir d'ici.~
@50715 = ~Ah, battons-nous.~
@50716 = ~Ah oui, la récompense. Ne t'inquiètes pas, tu recevras ton pesant d'or. Si je suis satisfait de ton travail, il se peut que je te donne également un bouclier enchanté.~
@50717 = ~Cela me semble équitable. Donne-moi ce poison et je t'obéirai.~
@50718 = ~J'effectuerai ce travail seulement si tu me donnes plus d'argent.~
@50719 = ~Non, en effet. Le souvenir que je garderai de toi sera celui d'un vil personnage, d'un vil personnage dans le plus abominable des lieux.~
@50720 = ~Ta proposition ne m'intéresse pas. Trouve quelqu'un d'autre.~
@50721 = ~Nous nous battrons donc sans motif, et je mourrai sans doute. Ne vois-tu pas que tout ceci n'a aucun sens !~
@50722 = ~C'est notre dernière offre. Tu as déjà de la chance que nous te proposions une récompense.~
@50723 = ~Très bien. Donne-moi ce poison et je m'occuperai des druides.~
@50724 = ~Puisque c'est ainsi, tu devras trouver quelqu'un d'autre.~
@50725 = ~Tu devras faire preuve de prudence. Tu sais comme moi que les habitants de ce lieu ne goûtent que très peu les âmes charitables.~
@50726 = ~Je ne m'attendais certainement pas à rencontrer des elfes noirs si aimables. Mais les actes sont plus forts que les mots, et vous êtes à présent mes amis.~
@50727 = ~Le danger est ici le même pour tous, pour les nouveaux venus comme pour les anciens.~
@50728 = ~J'ai peur pour ma sécurité, mais je saurai affronter tous les dangers qui m'attendent.~
@50729 = ~Ne t'inquiètes pas pour moi, je ne cours aucun danger.~
@50730 = ~Connaissance est mère de sécurité. J'ai appris cela rapidement, ça oui. Si vous continuez vers l'est, vous trouverez un pont ; un groupe de kuo-toa y monte la garde. Soyez prudents, ils sont dangereux.~
@50731 = ~Je dois sortir d'ici et découvrir ce qu'il est advenu des miens. Bonne chance à vous.~
@50732 = ~Accepteras-tu si je te donne une avance de 200 pièces d'or ?~
@50733 = ~Problème animalier à Franc-Marché : une nouvelle alternative

Le seigneur Khellon Menold m'a demandé de débarrasser Franc-Marché de son problème druidique. Il m'a donné une bouteille de poison à verser dans la « source sacrée » des druides. Elle devrait les affaiblir suffisamment pour que je puisse les tuer. Le seigneur Khellon sera à la taverne du coin quand j'aurai terminé.~
@50734 = ~C'est d'accord. Donne-moi l'or et le poison et les druides ne seront bientôt plus de ce monde.~
@50735 = ~C'est trop peu. Trouve quelqu'un d'autre pour massacrer tes druides.~
@50736 = ~J'effectuerai ce travail seulement si tu me donnes plus d'argent.~
@50737 = ~Parfait. Voilà le poison. Le repaire des druides se trouve dans la section nord-ouest du bosquet. C'est là que tu trouveras la source. J'attendrai ton retour à la taverne. Hâte-toi !~
@50738 = ~Parfait ! Voilà le poison et l'or. Le repaire des druides se trouve dans la section nord-ouest du bosquet. C'est là qu'est cachée la source. Retrouve-moi à la taverne lorsque tu auras terminé ton ouvrage. Hâte-toi !~
@50739 = ~Te voilà donc de retour, barbare. J'ose espérer que tu m'apportes de bonnes nouvelles ?~
@50740 = ~Au nord se trouve une cité d'elfes noirs. Je la connais bien, une patrouille m'y a un jour tendu un piège, et j'ai bien failli ne pas en réchapper. Si vous vous rendez là-bas, soyez prudents.~
@50741 = ~Vos ennuis sont réglés. Le bosquet est empoisonné et la cheffe des druides, Faldorn, est morte.~
@50742 = ~Je n'ai pas encore accompli ma mission.~
@50743 = ~Eh bien dépêche-toi de t'y mettre, garçon !~ ~Eh bien dépêche-toi de t'y mettre, femme !~
@50744 = ~Qu'attendiez-vous de moi, déjà ?~
@50745 = ~Serais-tu simple d'esprit, garçon ? Rends-toi au bosquet des druides, empoisonne la source et tue les druides. Presse-toi un peu, tu me fais perdre mon temps !~ ~Serais-tu simple d'esprit, femme ? Rends-toi au bosquet des druides, empoisonne la source et tue les druides. Presse-toi un peu, tu me fais perdre mon temps !~
@50746 = ~Je te félicite, <CHARNAME> ! Tu as bien mérité ta récompense ! Les adorateurs de la nature ne nous ennuieront plus.~
@50747 = ~Cela est certain, Seigneur Khellon. Vous pouvez à présent construire votre route et faire tout ce qu'il vous plaira.~
@50748 = ~C'est pourtant bien ce que j'entends faire ! Pas plus toi que Logan ne me ferez obstacle ! Adieu, mon ami ! Saches que tu as rendu un grand service à Franc-Marché !~ ~C'est pourtant bien ce que j'entends faire ! Pas plus toi que Logan ne me ferez obstacle ! Adieu, mon amie ! Saches que tu as rendu un grand service à Franc-Marché !~
@50749 = ~Problème animalier à Franc-Marché : une tâche ingrate terminée

J'ai massacré les druides et empoisonné leur bénitier. Le seigneur Khellon veut faire construire une route pour traverser la région dès qu'il aura réuni les fonds nécessaires.~
@50750 = ~Je t'en supplie... je ne suis pas ton maître !~
@50751 = ~Je ne vous veux pas de mal, je le jure ! S'il vous plaît, arrêtez... et...~
@50752 = ~Vous... vous n'êtes pas... Vous venez de la surface ? Je ne vous ai jamais vu auparavant...~ ~Vous... vous n'êtes pas... Vous venez de la surface ? Je ne vous ai jamais vue auparavant...~
@50753 = ~Vous... vous êtes un elfe noir... Mais pas de ceux qui m'ont emprisonné ? Est-ce qu'ils ont fui ? À moins que vous ne soyez venu achever leur travail ?~ ~Vous... vous êtes une elfe noire... Mais pas de ceux qui m'ont emprisonné ? Est-ce qu'ils ont fui ? À moins que vous ne soyez venu achever leur travail ?~
@50754 = ~Mais vous en avez avec vous. Si vous voyagez avec la bénédiction des elfes noirs, je vous présente mes respects. J'espère que vous me laisserez en vie.~
@50755 = ~S'il vous plaît, parlez-moi de vos intentions. Je sais rester humble, et je ne désire que rentrer chez moi.~
@50756 = ~Du calme, petit. Si vous êtes Bedlen Daglefodd, je suis venu pour vous sauver.~ ~Du calme, petit. Si vous êtes Bedlen Daglefodd, je suis venue pour vous sauver.~
@50757 = ~Je ne sais pas qui vous êtes, mais vous n'avez rien à craindre de moi.~
@50758 = ~Je suis venu pour vous sauver, mais votre père ne m'avait pas dit que vous n'étiez qu'un chiot geignard.~
@50759 = ~Où que j'aille, ma conduite est dictée par le meilleur profit. Que pouvez-vous m'offrir pour votre libération ?~
@50760 = ~Père vous a envoyé ? Alors, cela fait au moins plusieurs jours que je suis enfermé ici. J'avais entendu parler de magie noire, mais je n'en avais jamais vu à l'œuvre.~ ~Père vous a envoyée ? Alors, cela fait au moins plusieurs jours que je suis enfermé ici. J'avais entendu parler de magie noire, mais je n'en avais jamais vu à l'œuvre.~
@50761 = ~Pauvre petit gnome. Mon cœur saigne, mais pas autant que le vôtre dans quelques instants.~
@50762 = ~Alors je vous remercie de m'avoir libéré, mais je dois me mettre en route au plus tôt. Mon père doit s'inquiéter.~
@50763 = ~Si jamais vous passez par notre village, parlez à mon père. Son nom est Therndle Daglefodd, et il saura vous prouver sa reconnaissance.~
@50764 = ~Une récompense ? Je... non, je n'ai rien, mais si vous passez par notre village, mon père vous dédommagera.~
@50765 = ~Quoi ? Qu'auriez-vous à gagner à me tuer ? S'il vous plaît, vous pourriez être récompensé, mais seulement si vous me laissez en vie.~ ~Quoi ? Qu'auriez-vous à gagner à me tuer ? S'il vous plaît, vous pourriez être récompensée, mais seulement si vous me laissez en vie.~
@50766 = ~Je... je vais partir. Si... si vous me laissez vivre, alors je dirai à mon père que vous m'avez sauvé. Il vous récompensera... mais seulement si vous me laissez partir.~
@50767 = ~Je vais me presser de rentrer et de dire à mon père que tout va bien. Je dirai que vous m'avez sauvé. Il sera reconnaissant, j'en suis sûr.~
@50768 = ~Kith ! Urdlenglas od flus dlen den ! Odg ! ODG !~
@50769 = ~Salut à vous ! Je cherche ma route à travers votre royaume !~
@50770 = ~Arrière, ou il me faudra vous faire tâter un peu de mon arme !~
@50771 = ~Tout cela ne paraît guère accueillant, vile créature !~
@50772 = ~Klodg do g'ith dal shaog gossath ! Geetaaah !~
@50773 = ~*soupire* Rien à faire... toute cette affaire risque de fort mal finir.~
@50774 = ~La menace est rien moins qu'évidente ! Il n'y a rien à tirer de semblables créatures !~
@50775 = ~Il serait bon, me semble-t-il, que vous vous gardiez de vous adresser à moi, quand bien même vous en seriez capable.~
@50776 = ~Sekath da glossanda ! Odg ! Dassa !~
@50777 = ~*s'éclaircit la gorge* Hep ! Vous là-bas ! Ne bougez plus ! Qui êtes-vous et que faites-vous là ?~
@50778 = ~Peu d'elfes noirs viennent en paix par ce chemin !~
@50779 = ~Edo, od golver d'tanyon ! Da sugden os tera !~
@50780 = ~<CHARNAME>, et je n'ai pas l'intention de créer des problèmes. Comme on dit, je viens en paix.~
@50781 = ~Chevalière de'Arnise +2~
@50782 = ~Inutile de vous montrer hostile. Nous pourrions peut-être faire un peu de commerce ?~
@50783 = ~Mon identité ne vous regarde pas. Laissez-moi passer.~
@50784 = ~Ce que je fais là ? Je viens éliminer des petites nuisances dans ton genre.~
@50785 = ~Je suis désolé, mais je ne vous comprends pas.~ ~Je suis désolée, mais je ne vous comprends pas.~
@50786 = ~Cesse de grogner et exprime-toi dans la langue commune, gnome des profondeurs.~
@50787 = ~Hmm... vous n'êtes pas d'ici, n'est-ce pas ? Des étrangers de la surface, alors ? Venir ici vous ne devriez pas, bien qu'utiles vous puissiez être.~
@50788 = ~Vous pouvez entrer, mais sage vous devez être. Allez parler au seigneur de notre demeure-granit. Il veillera à votre bien-être.~
@50789 = ~Et sachez ceci : je vois la ténébreuse qui vous accompagne. Amis des elfes noirs nous ne sommes pas, mais nous la tolérerons pour le moment. Respectez la paix.~
@50790 = ~Cessez de me menacer, ou du sang coulera sur la pierre. Nous sommes en paix avec les surfacins et avec les ténébreux.~
@50791 = ~Nous nous défendrons en masse s'il le faut, et toute notre demeure-granit se retournera contre vous. Et maintenant, redites-moi ce que voulez ?~
@50792 = ~Je ne voulais pas vous offenser. Toutes mes excuses.~
@50793 = ~Je ne redirai rien du tout. C'est vous qui me menacez. Défendez-vous !~
@50794 = ~Alerte ! De ston fall duth nada ! Aux armes !~
@50795 = ~Nous arrivons à la paix par le respect et la vigilance. Respectez-la, et nous vous respecterons.~
@50796 = ~Salut, ténébreux. Vous êtes libres de passer si vous respectez la paix. Nous vivons trop près les uns des autres pour nous battre sans cesse.~ ~Salut, ténébreuse. Vous êtes libres de passer si vous respectez la paix. Nous vivons trop près les uns des autres pour nous battre sans cesse.~
@50797 = ~Nous veillons sur le granite de nos demeures, et nous nous battons contre tous ceux qui voudraient nous écraser sous la pierre.~
@50798 = ~Respectez la paix de cet endroit, et en retour, vous serez respecté.~ ~Respectez la paix de cet endroit, et en retour, vous serez respectée.~
@50799 = ~Aaah, bienvenue dans notre belle cité, voyageurs. Voilà qui n'est pas commun, mais vous me semblez venir de bien loin. C'est déjà rare d'avoir des visiteurs, mais par-dessus le marché, à vous voir, on dirait que vous êtes des surfacins.~ [GOLDAN02]
@50800 = ~Ce passage est inaccessible sans la permission du seigneur de ces lieux. Parlez à notre chef et il vous autorisera peut-être à entrer.~
@50801 = ~En attendant, ce sceau est protégé par la magie gnome. N'y touchez pas, ou vous nous mettrez tous en danger.~
@50802 = ~J'ai été informé que vous pouviez entrer. Vous pouvez entrer si vous le désirez. Bien que je m'inquiète des grands dangers que vous allez devoir affronter.~
@50803 = ~C'est étonnant que vous voyagiez avec les ténèbres d'une elfe noire. Je ne veux pas vous manquer de respect, mais c'est étonnant.~
@50804 = ~Venez, je veux vous parler, si vous êtes disposé à m'entendre.~ ~Venez, je veux vous parler, si vous êtes disposée à m'entendre.~
@50805 = ~Je suis encore plus étonnée que vous, les gnomes svirfnebelins, risquiez mon courroux en me montrant constamment du doigt.~
@50806 = ~Je ne veux pas vous offenser, mais les gens de votre sorte viennent rarement « juste » pour nous rendre visite.~
@50807 = ~Parlez et je vous écouterai, même si je ne suis pas sûr de pouvoir faire quelque chose pour vous.~ ~Parlez et je vous écouterai, même si je ne suis pas sûre de pouvoir faire quelque chose pour vous.~
@50808 = ~Encore un groupe de minus des tunnels qui a besoin de mon aide. Quelle surprise !~
@50809 = ~Je suis disposé vous à écouter, tant que vous parlez d'or...~ ~Je suis disposée vous à écouter, tant que vous parlez d'or...~
@50810 = ~Da laden stoone od gam. Bienvenue dans mon humble auberge. Je dois dire que je n'ai vu aucun de vos pareils ici depuis fort longtemps.~
@50811 = ~Ad gos'l ta stoone ? Gos'l ? Da rot.~
@50812 = ~C'est une question que je préfère confier à un étranger. Elle a déjà fait couler assez de sang svirfnebelin.~ ~C'est une question que je préfère confier à une étrangère. Elle a déjà fait couler assez de sang svirfnebelin.~
@50813 = ~Baissez le ton. Nous ne sommes pas faibles. Il n'y a aucune honte à reconnaître que l'on est surclassé. Cette affaire a déjà fait couler trop de sang svirfnebelin.~
@50814 = ~Je ne parlerai ni d'or, ni de joyaux. Nous ne gardons pas nos trésors si près des camps des elfes noirs. Mais j'ai d'autres objets de valeur.~
@50815 = ~Je vais déjà vous donner les détails de la mission. Vous déciderez ensuite d'accepter ou non. Je tape le roc que vous le ferez.~
@50816 = ~Comme vous pouvez le voir, notre village-granit est presque désert. J'ai envoyé la majorité de mes concitoyens se mettre au noir, loin en dessous de nous. Notre demeure n'est plus sûre, et c'est de notre faute.~
@50817 = ~Nous avons creusé trop loin, et nous avons déterré une monstruosité. Une étrange caverne qui vomissait la mort, un monstre que nous n'avions vu que dans nos cauchemars.~
@50818 = ~Cet anneau a été donné à Nalia par son père à son passage à la majorité. Lié par le sang, cet anneau ne peut lui être enlevé, ni ses pouvoirs utilisés par quelqu'un d'autre. L'anneau octroie un bonus de 2 à tous les jets de sauvegarde, à la classe d'armure et 50 % de résistance au feu.

PARAMÈTRES :

Capacités d'équipement :
- Classe d'armure : +2
- Jets de sauvegarde : +2
- Résistance au feu : +50 %

Poids : 0~
@50819 = ~Le travail que je vous propose est simple à expliquer, mais difficile à accomplir. Je vous demande de tuer la bête et de sceller le tunnel.~
@50820 = ~Vous ne pouvez pas simplement faire ébouler le tunnel sur la créature ?~
@50821 = ~Gemme de lumière~
@50822 = ~Vous autres nabots des profondeurs êtes censés savoir creuser. Pourquoi ne pas l'enterrer vous-mêmes ?~
@50823 = ~Gemme de lumière~
@50824 = ~Je propose un échange de mots. J'ai besoin d'informations sur un groupe de fugitifs que je poursuis.~
@50825 = ~Je vous aiderai autant que je le peux, mais mon problème est prioritaire. Trop de sang svirfnebelin a déjà été répandu à cause de lui.~
@50826 = ~Arc d'Arvoreen +2~
@50827 = ~Cet arc enchanté est en possession de Mazzy Fentan depuis de nombreuses années ; c'est un don de son dieu, Arvoreen. Utilisable seulement par les petites-personnes, il donne un bonus de 2 aux jets d'attaque.

PARAMÈTRES :

TAC0 : +2
Facteur de vitesse : 4
Type de compétence : arc court
Type : arme à deux mains
Nécessite :
 6 en Force

Poids : 2~
@50828 = ~Oh, les tunnels s'effondreront, nous en sommes sûrs. Mais nous ne savons pas si cela tuera la bête, maintenant qu'elle est éveillée.~
@50829 = ~Comme je le disais, c'est une bête surgie de nos rêves, ou de nos cauchemars, si vous préférez. Elle n'est pas de la pierre. Je ne sais comment l'appeler.~
@50830 = ~Éveillée ? Contre quoi vais-je me battre ?~
@50831 = ~J'ai l'impression que cette créature n'est pas naturelle ?~
@50832 = ~Je vous écoute, mais rappelez-vous que nous ne sommes pas la plus riche des demeures-granit. Les elfes noirs sont tous proches, et nous serrent de bien près.~
@50833 = ~L'objectif est clair. Maintenant, je dois vous parler de ce dont j'ai besoin.~
@50834 = ~Ouais ouais, la tuer et l'enterrer. Facile à dire, mais quelle sera ma récompense ?~
@50835 = ~Amplificateur mental~
@50836 = ~Chevalier de la mort~
@50837 = ~Chevalier de la mort~
@50838 = ~*vous voyez un trou minuscule, assez étroit pour qu'un petit rongeur puisse s'y faufiler*~
@50839 = ~Amplificateur mental~
@50840 = ~Œufs d'Adalon~
@50841 = ~Œufs d'Adalon~
@50842 = ~Intrus ! Quittez ces lieux ! Ce n'est pas un endroit pour les non-druides.~
@50843 = ~Œufs de dragon factices (de Phaere)~
@50844 = ~Ce bassin a-t-il une importance particulière ?~
@50845 = ~Œufs de dragon factices (de Phaere)~
@50846 = ~Œufs de dragon factices (Solaufein)~
@50847 = ~Œufs de dragon factices (Solaufein)~
@50848 = ~Poison sulfureux~
@50849 = ~Désolé. Je m'en vais.~ ~Désolée. Je m'en vais.~
@50850 = ~Poison sulfureux~
@50851 = ~Je n'irai nulle part, misérable petit homme. Écarte-toi de mon chemin.~
@50852 = ~Ceci est la source sacrée du bosquet. C'est un bassin dont les pouvoirs mystiques sont réservés aux amis du bosquet. Tu n'en es pas un. Pars !~
@50853 = ~Je m'en vais.~
@50854 = ~Le simple fait que tu poses les yeux sur la source sacrée est déjà un sacrilège ! Ne reviens pas !~
@50855 = ~<PLAYER2> ? Qu'il en soit ainsi ! J'affronterai ce vermisseau en combat singulier. Le résultat de ce duel déterminera le sort de cet endroit !~
@50856 = ~<PLAYER3> ? Qu'il en soit ainsi ! J'affronterai ce vermisseau en combat singulier. Le résultat de ce duel déterminera le sort de cet endroit !~
@50857 = ~<PLAYER4> ? Qu'il en soit ainsi ! J'affronterai ce vermisseau en combat singulier. Le résultat de ce duel déterminera le sort de cet endroit !~
@50858 = ~<PLAYER5> ? Qu'il en soit ainsi ! J'affronterai ce vermisseau en combat singulier. Le résultat de ce duel déterminera le sort de cet endroit !~
@50859 = ~<PLAYER6> ? Qu'il en soit ainsi ! J'affronterai ce vermisseau en combat singulier. Le résultat de ce duel déterminera le sort de cet endroit !~
@50860 = ~Potion de saumure~
@50861 = ~Potion de saumure~
@50862 = ~Têtards infectés~
@50863 = ~Têtards infectés~
@50864 = ~Qu'adviendrait-il du bosquet si la source était... par exemple... empoisonnée ?~
@50865 = ~Je n'irai nulle part, misérable petit homme. Écarte-toi de mon chemin.~
@50866 = ~Attends que Faldorn apprenne ton impertinence ! Elle changera certainement d'avis et te tuera sur place ! Quitte le bosquet et ne reviens pas !~
@50867 = ~Quelle audace ! Ne t'ai-je pas fait comprendre clairement que tu n'es pas le bienvenu ici ?~ ~Quelle audace ! Ne t'ai-je pas fait comprendre clairement que tu n'es pas la bienvenue ici ?~
@50868 = ~Je voulais juste savoir de quel genre de mare il s'agit.~
@50869 = ~Tu es très clair. Je m'en vais.~
@50870 = ~Ha ! Ce n'est certainement pas toi qui va me donner des ordres !~
@50871 = ~Arrêtez ! Que faites-vous ? Qu'avez-vous mis dans la source sacrée ? C'est...~
@50872 = ~Phaere~
@50873 = ~Phaere~
@50874 = ~Solaufein~
@50875 = ~Solaufein~
@50876 = ~Dragon d'argent~
@50877 = ~Dragon d'argent~
@50878 = ~Imrae~
@50879 = ~Imrae~
@50880 = ~Svirfnebelin~
@50881 = ~Svirfnebelin~
@50882 = ~PAR LES DIEUX ! Qu'as-tu fait, pauvre fou ?! Faldorn ! Viens vite !~ ~PAR LES DIEUX ! Qu'as-tu fait, pauvre folle ?! Faldorn ! Viens vite !~
@50883 = ~Matrone Ardulace~
@50884 = ~Matrone Ardulace~
@50885 = ~Garde de la matrone~
@50886 = ~Garde de la matrone~
@50887 = ~Garde rituel~
@50888 = ~Garde rituel~
@50889 = ~L'armure de plates complète est la meilleure armure qu'un combattant puisse acquérir, tant en termes d'apparence que de protection. Les plaques, parfaitement ajustées et imbriquées les unes dans les autres, sont courbées de manière à dévier les coups et les projectiles. Les armures de plates complètes sont généralement décorées de riches gravures et de détails en relief. Cette armure de plates complète possède de puissantes propriétés magiques.

Comme pour la plupart des équipements elfes noirs, cet objet est fait d'adamantium, un alliage d'adamantite qui se transforme rapidement en poussière s'il quitte l'Ombre-Terre.

PARAMÈTRES :

Classe d'armure : -4 (-7 contre les armes tranchantes, perforantes et les projectiles)
Nécessite :
 15 en Force

Poids : 70~
@50890 = ~Non ! Restez derrière !~
@50891 = ~Ah, vous êtes les nouveaux venus qui m'ont été envoyés. J'ai déjà bien trop à faire pour devoir m'occuper du bien-être des faibles. Comme si je n'étais pas assez occupé comme ça sans être obligé de faire la charité.~ [UDSOLA02]
@50892 = ~Szordrin~
@50893 = ~Il n'y a pas de « refuge » en Ust Natha, crétins. Nous payons pour notre existence avec notre sang, et vous en ferez autant.~
@50894 = ~Szordrin~
@50895 = ~Cuisinier elfe noir~
@50896 = ~Cuisinier elfe noir~
@50897 = ~Ilmryn~
@50898 = ~Ilmryn~
@50899 = ~Je me nomme Solaufein. Si vous voulez prouver votre valeur aux yeux des Matrones, vous ferez ce que je vous dis. Si vous échouez, la mort vous attend.~
@50900 = ~Elfe noir~
@50901 = ~Eldarin~
@50902 = ~Elfe noir~
@50903 = ~Et n'essayez pas de me défier juste parce que vous êtes une femme. Vous êtes une étrangère et, tant que les Matrones n'en auront pas décidé autrement, vous ne valez pas mieux qu'une esclave.~
@50904 = ~Eldarin~
@50905 = ~Et n'essayez pas de me défier juste parce qu'il y a des femmes parmi vous. Vous êtes des étrangers... tant que les Matrones n'en auront pas décidé autrement, vous ne valez pas mieux que des esclaves.~
@50906 = ~Et n'essayez pas de me défier... pour un mâle, j'ai un rang élevé dans ma Société. Vous êtes étranger, et tant que les Matrones n'en auront pas décidé autrement, vous ne valez pas mieux que des esclaves.~
@50907 = ~Responsable du duel~
@50908 = ~Responsable du duel~
@50909 = ~Pfeu ! Je suppose qu'il faut que je commence à vous materner. Tu as un nom, vagabond ? Ou dois-je juste t'appeler mâle ?~ ~Pfeu ! Je suppose qu'il faut que je commence à vous materner. Tu as un nom, vagabonde ? Ou dois-je juste t'appeler femelle ?~
@50910 = ~Lesaonar~
@50911 = ~Lesaonar~
@50912 = ~Je reviendrai dans quelques heures, peut-être davantage si la discussion avec Madulf se passe bien. Revenez ensuite, nous parlerons.~
@50913 = ~Chalinthra~
@50914 = ~Chalinthra~
@50915 = ~Clerc~
@50916 = ~Clerc~
@50917 = ~Je m'appelle... euh... Veldrin.~
@50918 = ~Non ! Ce n'est pas possible ! Le bosquet est empoisonné ! L'Esprit est en danger ! Nous sommes maudits !~
@50919 = ~Je m'appelle Veldrin.~
@50920 = ~Je m'appelle Veldrin, et j'exige d'être traité avec le respect que je mérite !~ ~Je m'appelle Veldrin, et j'exige d'être traitée avec le respect que je mérite !~
@50921 = ~Je m'appelle <CHARNAME>...~
@50922 = ~Appelez-moi comme vous voulez. Visiblement, cela n'a pas beaucoup d'importance.~
@50923 = ~Garde des œufs~
@50924 = ~Garde des œufs~
@50925 = ~Hmm. Tu n'as pas l'air d'en être sûr. De toute évidence, tu ne portes pas ce nom depuis longtemps. Je vais devoir me coltiner un nouvel initié, hein ? Sale boulot...~ ~Hmm. Tu n'as pas l'air d'en être sûre. De toute évidence, tu ne portes pas ce nom depuis longtemps. Je vais devoir me coltiner une nouvelle initiée, hein ? Sale boulot...~
@50926 = ~Aucune importance. L'une des Matrones s'est intéressée à ton arrivée. Elle veut profiter de tes compétences.~
@50927 = ~Elle a envoyé une Vestale. Elle doit te rencontrer à la plateforme d'entrée de la ville. Je serai là, n'en doute pas. Je te guiderai dans ta mission comme une mère attentive.~
@50928 = ~Tavernier elfe noir~
@50929 = ~Je vais la chercher. Si tu es intelligent, tu vas te rendre rapidement à la plateforme d'entrée. Les Vestales manquent notoirement de patience.~ ~Je vais la chercher. Si tu es intelligente, tu vas te rendre rapidement à la plateforme d'entrée. Les Vestales manquent notoirement de patience.~
@50930 = ~Tavernier elfe noir~
@50931 = ~Comme je le pensais... aucune volonté. On m'inflige un elfe noir aussi féroce qu'un lapin ! Si je trouve qui m'a fait ce coup-là...~ ~Comme je le pensais... aucune volonté. On m'inflige une elfe noire aussi féroce qu'un lapin ! Si je trouve qui m'a fait ce coup-là...~
@50932 = ~Ah ! Tu n'auras rien de tel, et peu importent tes succès à Ched Nasad ! Mais ce genre de caractère pourra te rendre des services à Ust Natha, si tu sais quand le montrer.~
@50933 = ~Qu'est-ce que c'est que ce nom ? Un nom d'enfance récemment rejeté ? On m'inflige un initié de fraîche date ? Si je trouve qui m'a fait ce coup-là...~ ~Qu'est-ce que c'est que ce nom ? Un nom d'enfance récemment rejeté ? On m'inflige une initiée de fraîche date ? Si je trouve qui m'a fait ce coup-là...~
@50934 = ~*vous voyez un trou minuscule, assez étroit pour qu'un petit rongeur puisse s'y faufiler... dommage que vous ne puissiez pas vous transformer en rat ou en écureuil*~
@50935 = ~Je sais que ton nom est Veldrin, même si tu n'es pas capable de t'en souvenir. Visiblement, tu as à peine un siècle... et encore. Pour survivre ici, il faut être rusé, imbécile.~ ~Je sais que ton nom est Veldrin, même si tu n'es pas capable de t'en souvenir. Visiblement, tu as à peine un siècle... et encore. Pour survivre ici, il faut être rusée, imbécile.~
@50936 = ~Des surfacins ? D'autres que vous ? Ah, j'en ai entendu parler, mais vous aurez du mal à les trouver. Ils sont entrés dans la ville des elfes noirs, Ust Natha.~
@50937 = ~Je ne demande pas de paiement pour mon aide, mais je cherche deux surfacins qui sont venus dans cette direction.~
@50938 = ~Je m'en moque. Vous allez me payer et me parler des deux surfacins que je recherche.~
@50939 = ~*vous pourriez probablement utiliser votre Potion de métamorphose en écureuil pour entrer dans la cavité... interagissez à nouveau sur le trou pour utiliser la potion*~
@50940 = ~Ha ha ! J'aime bien ton humour ! Je t'appellerai Waela, l'idiot, mais on m'a dit que ton nom était Veldrin. Ton caractère te servira, si tu apprends à te taire.~ ~Ha ha ! J'aime bien ton humour ! Je t'appellerai Waela, l'idiote, mais on m'a dit que ton nom était Veldrin. Ton caractère te servira, si tu apprends à te taire.~
@50941 = ~Vous n'êtes qu'un imbécile, créature de la surface. Si tu voulais t'infiltrer parmi les elfes noirs, tu n'aurais pas dû, par tes actes, nous faire nous poser davantage de questions.~ [UDSOLA11] ~Vous n'êtes qu'une imbécile, créature de la surface. Si tu voulais t'infiltrer parmi les elfes noirs, tu n'aurais pas dû, par tes actes, nous faire nous poser davantage de questions.~ [UDSOLA11]
@50942 = ~Tu croyais que nous tu n'étais pas surveillé ? Tu croyais que les elfes noirs avaient survécu pendant tous ces siècles sans avoir gravé le soupçon dans leurs cours de pierre ?~ ~Tu croyais que nous tu n'étais pas surveillée ? Tu croyais que les elfes noirs avaient survécu pendant tous ces siècles sans avoir gravé le soupçon dans leurs cours de pierre ?~
@50943 = ~Ton manque de ponctualité et tes refus d'obéissance ont attiré l'attention des Matrones, et à présent, elles savent ce que tu es ! Préparez-vous à mourir, imbéciles !~
@50944 = ~Vous me sembliez pourtant plein de promesses. Je suis surprise de vous découvrir si stupide, Veldrin... ou quel que soit votre nom. Quelle déception de voir que vous n'êtes qu'un idiot...~ [PHAERE07] ~Vous me sembliez pourtant plein de promesses. Je suis surprise de vous découvrir si stupide, Veldrin... ou quel que soit votre nom. Quelle déception de voir que vous n'êtes qu'une idiote...~ [PHAERE07]
@50945 = ~Surpris ? Un vrai elfe noir ne le serait pas. Un vrai elfe noir saurait qu'il ne doit pas désobéir car les yeux de la Reine Araignée sont partout, aux aguets.~ ~Surprise ? Une vraie elfe noire ne le serait pas. Une vraie elfe noire saurait qu'elle ne doit pas désobéir car les yeux de la Reine Araignée sont partout, aux aguets.~
@50946 = ~Notre Mère Lolth a posé les yeux sur vous, vous révélant ainsi sous votre vraie forme, créature de la surface ! C'était de la folie de venir à Ust Natha ! Maintenant, il ne vous reste plus qu'à mourir !~
@50947 = ~Comment cela a-t-il pu se produire ? On ne peut pas uniquement blâmer les directives sauvages de Faldorn ! C'est votre main qui a délibérément commis cet acte maléfique.~
@50948 = ~Je recommande la prudence, dans cet endroit. Nous avons de la chance de ne pas avoir été pris en otage et vendus comme esclaves. Si elles nous demandent de prouver notre rang, alors nous devons servir ces Matrones jusqu'au bout.~
@50949 = ~Le moindre faux pas, aussi léger soit-il, attirera l'attention des guetteuses de la Reine Araignée. Et il ne fait aucun doute que notre présence attire déjà leur curiosité... nous ne voudrions pas qu'elles viennent vérifier, n'est-ce pas ?~
@50950 = ~N'oublies pas : obéissance absolue à ceux qui ont un rang plus élevé, en particulier les Vestales de Lolth et les Mères Matrones. Aucune pitié pour ceux d'un rang inférieur ou égal.~
@50951 = ~Sinon, tire avantage de toute faveur mise sur ton chemin. Pour les êtres comme nous, c'est le seul moyen d'accomplir ce pourquoi nous sommes venus au monde. Pas de pitié. C'est notre voie.~
@50952 = ~Si tu imagines pouvoir t'enfuir ou te rebeller, <CHARNAME>, tu ferais mieux de ne plus y penser. Je n'aime pas les elfes noirs, mais je sens quand je suis dans leur antre.~
@50953 = ~Les elfes noirs mineurs... c'est nous... ils marchent vite au son de leur prêtresse. Ou ils meurent de mille morts horribles qui choqueraient même Clangeddin.~
@50954 = ~Et les elfes noirs ne font confiance à personne. Ils ont des yeux partout, magiques ou non, pour surveiller tous nos gestes. Nous devons agir comme les créatures des ténèbres. N'oublie pas.~
@50955 = ~Ah... le rôle de modeste suppliant. Je le connais sur le bout des doigts, mon corbeau. Nous devons jouer les serviteurs empressés pour ces elfes au cœur sombre, et marcher au rythme de leur air avec enthousiasme.~
@50956 = ~L'alternative est d'endurer leur regard suspicieux et leurs magies... et nous ne savons pas quels yeux nous surveillent déjà. Si nous faisons exactement ce que nous avons dit, nous devrions pouvoir donner le change, je pense.~
@50957 = ~Nous sommes des subalternes, <CHARNAME>. Pour eux, nous sommes des elfes noirs inférieurs et on se méfie de nous. Toute désobéissance attirerait l'attention sur nous.~ ~Nous sommes des subalternes, <CHARNAME>. Pour eux, nous sommes des elfes noires inférieures et on se méfie de nous. Toute désobéissance attirerait l'attention sur nous.~
@50958 = ~La culture des elfes noirs est très rude, elle ne m'est pas familière. Nous devons durcir nos cœurs si nous voulons nous y fondre. L'autre alternative est la découverte et la mort.~
@50959 = ~Vous nous avez emmenés dans un endroit maléfique, <CHARNAME>. Mais je suppose que nous devons jouer les grands suppliants si nous voulons passer l'inspection car je sens qu'on nous observe au moment où je vous parle.~
@50960 = ~Il nous faut répondre à ses exigences rapidement. La suspicion de l'elfe noir est presque palpable. Si nous ne faisons pas ce qu'il demande, il nous ensorcellera.~
@50961 = ~Ne t'adresse pas à moi directement, vermine ! Encore une telle impertinence et tu sentiras la morsure du bâtonnet à tentacules qui arrachera la chair de tes os !~
@50962 = ~Ton histoire a été vérifiée jusqu'à maintenant, Veldrin de Ched Nasad, et c'est pourquoi tu n'as pas fini comme esclave ou dans une taverne pour amuser le peuple... mais tu n'as toujours pas ta place ici !~
@50963 = ~Ah, il était temps que vous arriviez. La Vestale Imrae a failli t'envoyer les prêtresses. Elles t'auraient fouetté les chevilles avec les bâtonnets à tentacules pour t'apprendre à te presser !~ [UDSOLA07]
@50964 = ~Mais nous voici. Une Matrone t'a préparé un travail. Ô Imrae, bénie de Lolth, voici les voyageurs venus de Ched Nasad.~
@50965 = ~Tu as vraiment de la chance que nos meilleurs guerriers soient occupés par... les préparatifs. Ailleurs. Et beaucoup de chance qu'une Mère Matrone décide de t'utiliser.~
@50966 = ~Accroches-toi à ce seul espoir, misérable, et ne déçois pas la Mère Matrone... car dans ce cas, l'horreur de ton châtiment sera bien pire que celle que tu as connue à l'entrée !~
@50967 = ~Explique ce qui s'est passé, Solaufein. Et fais vite, mâle, car la Reine Araignée a besoin de moi.~
@50968 = ~Te voici. C'est bien. Ton séjour à Ust Natha sera moins désagréable si tu continues à obéir immédiatement aux ordres.~
@50969 = ~Comme je le disais, une Matrone nous a assigné une mission. Ô Imrae, bénie de Lolth... voici le voyageur de Ched Nasad. Il pourra être très utile.~ ~Comme je le disais, une Matrone nous a assigné une mission. Ô Imrae, bénie de Lolth... voici la voyageuse de Ched Nasad. Elle pourra être très utile.~
@50970 = ~Lorsque tu es en présence de l'une des élues de Lolth... ou d'une Matrone... n'ouvre pas la bouche tant que l'on ne t'adresse pas la parole, idiot ! Es-tu fou ?~ ~Lorsque tu es en présence de l'une des élues de Lolth... ou d'une Matrone... n'ouvre pas la bouche tant que l'on ne t'adresse pas la parole, idiote ! Es-tu folle ?~
@50971 = ~Pardonne-moi, Vestale Imrae... c'est le méprisable excrément venu de Ched Nasad. À l'instant où j'ai posé les yeux sur lui, j'ai su qu'il ne valait rien !~ ~Pardonne-moi, Vestale Imrae... c'est le méprisable excrément venu de Ched Nasad. À l'instant où j'ai posé les yeux sur elle, j'ai su qu'elle ne valait rien !~
@50972 = ~Je veillerai à ce qu'il soit sévèrement torturé pour cela ! Je vais en trouver d'autres, qui serviront bien mieux la volonté de la Matrone !~ ~Je veillerai à ce qu'elle soit sévèrement torturée pour cela ! Je vais en trouver d'autres, qui serviront bien mieux la volonté de la Matrone !~
@50973 = ~Pardonne-moi, Vestale Imrae... c'était le mâle le plus prometteur, à mon avis. Mais il est jeune, fraîchement initié... et pas très malin.~ ~Pardonne-moi, Vestale Imrae... c'était la femelle la plus prometteuse, à mon avis. Mais elle est jeune, fraîchement initiée... et pas très maligne.~
@50974 = ~J'ai fait une erreur en les faisant venir. Je vais les renvoyer et en trouver d'autres qui serviront mieux la volonté de la Matrone. Accepte, je t'en prie, mes très humbles...~
@50975 = ~Tu ne feras rien avec eux, mâle. Ils se débrouilleront. Tu seras puni plus tard. Pour l'instant, je vais parler personnellement à ce mâle.~ ~Tu ne feras rien avec eux, mâle. Ils se débrouilleront. Tu seras puni plus tard. Pour l'instant, je vais parler personnellement à cette femelle.~
@50976 = ~Sur-le-champ, ô Vestale. Veldrin, si je te parle des dévoreurs... tu sais de quoi il s'agit, hein ?~
@50977 = ~Vous voulez parler des illithids ? Oui, je sais ce que c'est.~
@50978 = ~Vous voulez parler des flagelleurs mentaux ? Oui, je sais ce que c'est.~
@50979 = ~Euh... vous voulez parler d'un otyugh ?~
@50980 = ~Non, je ne sais pas.~
@50981 = ~Oui, je crois que c'est le nom qu'ils se donnent... très intelligent de ta part. Ces psions sont depuis fort longtemps parmi les plus féroces de nos ennemis.~
@50982 = ~Flagelleurs... mentaux ? Des choses qui flagellent l'esprit ? C'est un terme intéressant pour des dévoreurs psychiques. C'est ainsi qu'on les nomme à Ched Nasad ? Peu importe, tu as raison.~
@50983 = ~Non, bougre d'animal ! Je parle des dévoreurs... des illithids ! Des psions avec des tentacules qui mangent les cerveaux... quoi que dans ton cas, ils ne risquent pas l'indigestion.~
@50984 = ~Ah. Je parle des illithids, Veldrin. Des psions avec des tentacules qui dévorent les cerveaux. Je pensais qu'au cours de tes voyages, tu aurais pu en rencontrer un ou deux. Aucune importance.~
@50985 = ~Au cours d'une reconnaissance, la fille aînée d'une Matrone a rencontré des dévoreurs. Ses imbéciles de compagnons ont fui ou ont été tués. Elle a été capturée.~
@50986 = ~Les dévoreurs savent reconnaître ce qui a de la valeur. Ils vont emmener la fille jusqu'à leur ville. S'ils l'atteignent, elle sera perdue à jamais.~
@50987 = ~Avec les... préparatifs... des armées, nous sommes les seuls à pouvoir intercepter les dévoreurs. Nous devons nous rendre à l'entrée de leurs cavernes et les attendre.~
@50988 = ~La Vestale Imrae m'a donné un objet béni par Lolth qui arrachera les dévoreurs à leur voyage astral... et c'est alors que nous frapperons.~
@50989 = ~La Matrone ne veut pas que sa fille aînée serve d'encas aux dévoreurs ! Nous ne devons pas échouer ! C'est compris, Veldrin ?~
@50990 = ~Et avant que vous ne posiez la question, oui, je connais un moyen d'entrer dans la ville des elfes noirs. Enfin, je connais une entité qui pourra vous aider. Elle pourra vous faire entrer, mais après, vous mourrez sûrement.~
@50991 = ~Sans vouloir vous offenser, Malla, vous ne portez les symboles d'aucune Maison de ma connaissance. Vous ne vous en tirerez pas bien là-bas, surtout avec vos compagnons actuels.~
@50992 = ~Outrage après outrage, reste donc avec ton choix de sécurité, Goldander.~
@50993 = ~Si vous voulez courir ce risque, je vous indiquerai la direction avec joie. Le grand escalier conduit à son repaire. C'est le plus noir de tous les tunnels, mais l'autre côté est baigné par une merveilleuse lumière.~
@50994 = ~Elle a choisi de se nommer Adalon, mais vous pourrez l'appeler « Ma Dame ». Montrez-vous respectueux et elle vous respectera.~ ~Elle a choisi de se nommer Adalon, mais vous pourrez l'appeler « Ma Dame ». Montrez-vous respectueuse et elle vous respectera.~
@50995 = ~Si elle sait où sont les deux personnes que je cherche et qu'elle a un moyen de me conduire à eux, je n'ai pas besoin de vous.~
@50996 = ~Si elle est si puissante, pourquoi n'allez-vous pas lui demander de l'aide ? Pourquoi m'utiliser ?~
@50997 = ~Je dois vous retrouver à l'entrée des cavernes des illithids, et tendre une embuscade à un groupe d'illithids qui a capturé la fille d'une Matrone.~
@50998 = ~Exactement. Les tunnels des illithids sont dans la partie sud-est de la grande caverne d'Ombre-Terre. Je pars en éclaireur. Nous nous retrouverons là-bas à ton arrivée.~
@50999 = ~Nous n'attendons pas les illithids avant un petit moment. Tu as le temps de te reposer et de faire des provisions, si tu le désires.~
@51000 = ~Tu dois me retrouver à l'entrée des tunnels des illithids dans douze heures au plus tard. Ne sois pas en retard.~
@51001 = ~Bien sûr. D'innombrables horreurs exquises t'attendent dans les Fosses Démoniaques si tu échoues. Et si tu tentes de fuir, les driders te retrouveront.~
@51002 = ~Quant à toi, Solaufein... la Mère Matrone espère encore plus de toi. Fais ton rapport au temple avant de quitter la ville.~
@51003 = ~*vous buvez la Potion de métamorphose en écureuil, quelques instants plus tard la métamorphose en écureuil est complétée et vous entrez dans la cavité*~
@51004 = ~Comme... comme vous le désirez, ô Vestale.~
@51005 = ~Très bien, te voilà. Je commençais à me demander combien de temps je devrais attendre au milieu de ces maudits rochers.~
@51006 = ~Mais le moment est idéal. Je pense que les illithids seront bientôt à la bonne portée. Je vais pouvoir les arracher sans danger au plan astral.~
@51007 = ~Tu as une question avant la bataille, Veldrin ? Sois bref.~ ~Tu as une question avant la bataille, Veldrin ? Sois brève.~
@51008 = ~Tu te montres enfin ! Je commençais à me dire que j'allais devoir partir à ta recherche dans ces maudites cavernes ! Et que j'allais retrouver ta charogne rongée par un svirfnebelin !~
@51009 = ~Les druides qui suivaient Faldorn ont essayé de détruire une communauté entière. Ils n'ont eu que ce qu'ils méritaient.~
@51010 = ~Peut-être que détruire la vie même du bosquet était excessif. Mais que pouvais-je faire d'autre ?~
@51011 = ~Les illithids s'approchent avec leur prisonnière. Bientôt, je vais les arracher au plan astral et l'embuscade commencera. J'espère que tu te bats mieux que tu ne le penses.~
@51012 = ~Faldorn, par des moyens certes peu avouables, ne voulait que stopper les invasions. Vous n'aviez qu'à tuer Faldorn pour que l'équilibre soit rétabli. Et à la place vous avez choisi d'empoisonner la terre elle-même ?~
@51013 = ~Qui devons-nous sauver, au juste ?~
@51014 = ~Il y a quelque chose que je doive savoir sur la manière dont on combat les illithids ?~
@51015 = ~Non ! Le chaos règne en maître ! Le Pays se meurt ! Je ne peux tolérer cela ! <CHARNAME>, enfant maudit, vous venez d'être condamné à mort !~ ~Non ! Le chaos règne en maître ! Le Pays se meurt ! Je ne peux tolérer cela ! <CHARNAME>, enfant maudit, vous venez d'être condamnée à mort !~
@51016 = ~Que se passe-t-il ? Le bosquet souffre. Des problèmes ? Le bosquet en subit les conséquences... que s'est-il passé ici ?~ [CEFALD14]
@51017 = ~Oh, dieux...~ [CEFALD15]
@51018 = ~Non ! Non...~ [CEFALD16]
@51019 = ~L'âme du bosquet se consume ! L'eau agonise ! Tout est perdu !~ [CEFALD17]
@51020 = ~Aargh !~ [CEFALD18]
@51021 = ~Je suis désolé que vous soyez puni. Je ne voulais pas mettre la Vestale en colère.~ ~Je suis désolée que vous soyez puni. Je ne voulais pas mettre la Vestale en colère.~
@51022 = ~Non, pas de questions.~
@51023 = ~Elle s'appelle Phaere de la Maison Despana, aînée de la Matrone Ardulace. Veille à ne pas la blesser, même par accident.~
@51024 = ~Ne t'attends pas à être récompensé par Phaere, même si nous réussissons... elle n'en attend pas moins de la part d'elfes noirs inférieurs. Nous n'avons pas le choix.~ ~Ne t'attends pas à être récompensée par Phaere, même si nous réussissons... elle n'en attend pas moins de la part d'elfes noirs inférieurs. Nous n'avons pas le choix.~
@51025 = ~Assez parlé. Je sens les illithids approcher. Encore un peu de patience, je les arracherai au plan astral lorsqu'ils seront assez proches.~
@51026 = ~Pas grand-chose. Frappe vite, avant que leurs pouvoirs mentaux ne te paralysent. Ensuite, ils te dévoreront le cerveau à loisir. Protège-toi si tu le peux.~
@51027 = ~Je ne m'attends pas à ce que tu m'aides beaucoup. Avec toi à mes côtés, je suis tout à fait convaincu que je vais mourir entre les mains des dévoreurs. Pfeh !~
@51028 = ~Tu n'es pas un très bon elfe noir. Montrer une faiblesse ? De la sympathie ? Ton cœur doit être d'acier. Détruis les illithids. Cela me satisfera davantage que des excuses.~ ~Tu n'es pas une très bonne elfe noire. Montrer une faiblesse ? De la sympathie ? Ton cœur doit être d'acier. Détruis les illithids. Cela me satisfera davantage que des excuses.~
@51029 = ~Même si... j'apprécie... l'intention derrière tes paroles. La Vestale Imrae a pris trop de plaisir à administrer sa punition. Ce fut... difficile.~
@51030 = ~Comme tu veux. N'hésite pas à frapper les illithids, et tu nous satisferas pleinement, moi et la Matrone.~
@51031 = ~Mes ravisseurs sont enfin vaincus, il était temps ! Hmpf... Je commençais à croire qu'ils pourraient atteindre leur ville illithide, après tout.~
@51032 = ~Je te salue, Phaere, fille d'Ardulace. Es-tu indemne ?~
@51033 = ~Qui est-ce ? Solaufein ? Non... C'est la Mère Matrone qui t'envoie ? Ce doit être exaspérant de risquer ta vie pour sauver la mienne !~
@51034 = ~J'ai obéi aux ordres.~
@51035 = ~Oui... comme tout mâle le devrait. Tu as bien agi, je pense, avec tes... compagnons. Hmmm... qui est cet homme qui t'accompagne ?~ ~Oui... comme tout mâle le devrait. Tu as bien agi, je pense, avec tes... compagnons. Hmmm... qui est cette femme qui t'accompagne ?~
@51036 = ~Lui ? C'est...~ ~Elle ? C'est...~
@51037 = ~Je suis sûre qu'il sait parler. Ai-je raison ? Tu as une langue, n'est-ce pas ? Qui pouvez-vous donc être ?~ ~Je suis sûre qu'elle sait parler. Ai-je raison ? Tu as une langue, n'est-ce pas ? Qui pouvez-vous donc être ?~
@51038 = ~Je suis Veldrin, de Ched Nasad.~
@51039 = ~Je n'ai aucune importance.~
@51040 = ~Vous avez un sacré culot, femme ! Nous venons de vous sauver des illithids, et vous nous insultez ?~
@51041 = ~Un étranger ? Vraiment ? Comme c'est étrange... Il faut que nous parlions un peu plus, tous les deux, lorsque nous serons revenus à Ust Natha.~ ~Une étrangère ? Vraiment ? Comme c'est étrange... Il faut que nous parlions un peu plus, toutes les deux, lorsque nous serons revenus à Ust Natha.~
@51042 = ~Bravo, bonne attitude ! Mais je suis sûre que vous en savez plus que ça. Nous reparlerons de tout cela à Ust Natha.~
@51043 = ~Ahhh, une forte tête ! Nous reparlerons de votre attitude à Ust Natha.~
@51044 = ~Vous n'avez pas spécifiquement besoin de moi, mais elle ne reçoit pas n'importe qui. Elle a des... goûts très raffinés, peut-être plus que la moyenne de son espèce.~
@51045 = ~Quelle sorte de créature est cette Adalon ? Est-ce une svirfnebeline comme vous ?~
@51046 = ~Je vais rentrer et informer la Mère Matrone des... des services que tu nous as rendus, Solaufein. Tu as été très utile, tu peux t'en féliciter.~
@51047 = ~Tu vas revenir seule ? Non ! Et s'il y a encore du danger ? Je ne veux pas être responsable de...~
@51048 = ~Ta sollicitude me touche, Solaufein, mais je peux me débrouiller seule. Et c'est un ordre, tu dois donc obéir. Au revoir.~
@51049 = ~Maudite sois-tu, arrogante femelle ! Que la Reine Araignée pique ton cœur malveillant !~ [UDSOLA12]
@51050 = ~Elle est désireuse d'aider, bien sûr, mais elle respecte davantage ceux qui s'aident eux-mêmes. C'est une créature qui a de très curieuses relations, peut-être plus que la moyenne de son espèce.~
@51051 = ~Je vais la suivre pour m'assurer qu'elle ne nous met pas tous en danger par excès de confiance en elle. Rentre en ville, Veldrin. Je te retrouverai à l'entrée.~
@51052 = ~Oh, grands dieux, non. C'est une créature d'une grande beauté, comme vous le verrez, j'espère. Toutefois, elle a de très curieuses relations, peut-être plus que la moyenne de son espèce.~
@51053 = ~Je suis sûr qu'elle compatira à vos soucis si vous l'approchez poliment, mais j'ai peur de devoir limiter votre accès à elle jusqu'à ce que vous ayez résolu le problème de mon village.~
@51054 = ~Le passage qui mène à son repaire est protégé des intrus par une force de sa création. C'est la plus noire des ténèbres, elle empêche même les elfes noirs d'entrer.~
@51055 = ~Tu es enfin de retour. C'est bien. Je me faisais assez de souci à propos du retour de Phaere, je n'avais pas l'intention de me tracasser pour toi.~
@51056 = ~Oui. La fille de la Mère Matrone est rentrée en sécurité. Tu as très bien servi. Je sais que la Mère Matrone est satisfaite.~
@51057 = ~Lorsque la bête de la caverne sera morte, je vous donnerai une « Gemme de lumière » pour bannir les ténèbres du tunnel. Je la porte toujours avec moi, mais je vous l'offrirai volontiers pour vous récompenser de votre aide.~
@51058 = ~Phaere te donne également un ordre que tu ne dois pas ignorer. Tu dois la retrouver dans la taverne de cette ville. Elle veut te parler, mais je ne peux deviner pourquoi.~
@51059 = ~Tu n'aurais pas dû dire ça, imbécile ! Je vais te tuer et prendre la pierre ! Oublie notre marché !~
@51060 = ~Je vous aiderai, mais vous devrez payer plus que cela. Et maintenant, où dois-je aller ?~
@51061 = ~C'est honnête. Où dois-je aller pour trouver la bête que je dois tuer ?~
@51062 = ~Kamuzu~
@51063 = ~Elle veut te voir aussi, Solaufein. Vous devez vous reposer et vous détendre dans la taverne pour... vous récompenser... de vos services.~
@51064 = ~Mais, Vestale, je ne veux pas...~
@51065 = ~Je suis heureux de votre décision. Le passage est au nord-est, il est gardé par l'un de mes meilleurs sapeurs. Il vous laissera passer désormais.~
@51066 = ~Veux-tu subir un nouveau châtiment, mâle ? Tu feras ce qu'elle dit. Elle vous verra tous à la taverne avant un jour, pas plus. Ce sera tout.~
@51067 = ~Quoi ? Vous êtes fou ! Les ténèbres ont envahi vos sens ! À la garde ! Ada gon' tonda ! Gi !~ ~Quoi ? Vous êtes folle ! Les ténèbres ont envahi vos sens ! À la garde ! Ada gon' tonda ! Gi !~
@51068 = ~Prenez ce Parchemin de façonnage de la pierre. Il est lié magiquement à la roche de la caverne. Lorsque la bête sera morte, utilisez-le pour faire s'écrouler le plafond sur son cadavre. J'interdirai ensuite à jamais que l'on pénètre dans cette zone.~
@51069 = ~Merci, <CHARNAME>. Vous ne réalisez pas le bien que vous faites.~
@51070 = ~Bienvenue à nouveau parmi nous ! Nous nous faisions autant de soucis pour vous que si vous aviez été l'un des nôtres.~ [GOLDAN07] ~Bienvenue à nouveau parmi nous ! Nous nous faisions autant de soucis pour vous que si vous aviez été l'une des nôtres.~ [GOLDAN07]
@51071 = ~J'ai entendu le grondement de votre bataille, <CHARNAME>, et je suis heureux de vous revoir vivant. Je vous remercie infiniment.~ ~J'ai entendu le grondement de votre bataille, <CHARNAME>, et je suis heureux de vous revoir vivante. Je vous remercie infiniment.~
@51072 = ~Tu n'as rien à faire avec moi, mâle. Si tu dois aller au temple, fais-le vite, sinon je sacrifierai ton cœur pour le plaisir de Lolth.~ ~Tu n'as rien à faire avec moi, femelle. Si tu dois aller au temple, fais-le vite, sinon je sacrifierai ton cœur pour le plaisir de Lolth.~
@51073 = ~Pourquoi t'adresses-tu à moi ? Dois-je te frapper avec le bâtonnet à tentacules et t'apprendre ce qu'il en coûte de déranger une Vestale de Lolth ?~
@51074 = ~Si la Mère Matrone Ardulace veut bien te laisser déambuler sans escorte au lieu de te vendre comme esclave, c'est son affaire. Mais tu n'as pas ta place dans ce temple... alors va-t'en !~
@51075 = ~J'espère que vous n'avez pas oublié votre promesse. Tant que la bête vit, nous sommes tous en danger.~
@51076 = ~Kamuzu~
@51077 = ~*manipulez la facette pour libérer une âme emprisonnée*~
@51078 = ~*vous avez libéré une âme emprisonnée*~
@51079 = ~C'est tout ce que je peux faire pour vous.~
@51080 = ~Le tunnel s'étant éboulé, la créature ne sera plus dérangée. Je sais qu'elle est morte, mais avec ces choses, on ne sait jamais.~
@51081 = ~Je dois vous demander de retourner à la caverne où vous avez combattu la chose maléfique. Vous devez la faire s'écrouler avec le parchemin que je vous ai donné.~
@51082 = ~Cela ne vous troublera plus.~
@51083 = ~Le travail est fini. Payez, maintenant.~
@51084 = ~Que veux-tu ? J'ai déjà assez de mal à satisfaire les caprices de cette maudite sorcière... Dois-je aussi endurer ta présence insipide ?~
@51085 = ~Du calme. Je veux juste vous poser une ou deux questions.~
@51086 = ~C'est quoi, votre problème avec moi ?~
@51087 = ~Continue à me parler de cette façon, et je te greffe une lame à la place du cœur !~
@51088 = ~Je suppose que je vais m'en aller, alors.~
@51089 = ~Des questions ? Je ne tolérerai pas tes perpétuels radotages, imbécile ! Vas donc courir un peu en agitant les bras, et tu auras tous les elfes noirs que tu veux pour répondre à tes « questions ».~
@51090 = ~Inutile de me parler sur ce ton.~
@51091 = ~Continuez à me parler sur ce ton, et vous respirerez par des trous supplémentaires.~
@51092 = ~Bien, je m'en vais.~
@51093 = ~Mon problème ? Je ne veux pas être associé une minute de plus que nécessaire avec un elfe noir pleutre et stupide comme toi. Va donc grouilloter ailleurs, idiot.~ ~Mon problème ? Je ne veux pas être associé une minute de plus que nécessaire avec une elfe noire pleutre et stupide comme toi. Va donc grouilloter ailleurs, idiote.~
@51094 = ~Inutile de me parler sur ce ton.~
@51095 = ~Oui, et au plus vite. Je ne retarderai pas vos propres objectifs une seconde de plus. S'il vous plaît, acceptez cet objet magique comme un paiement partiel.~
@51096 = ~Et voici aussi la Gemme de lumière. Avec elle, vous pourrez franchir le grand escalier et pénétrer dans le repaire d'Adalon. Je vous souhaite bonne chance.~
@51097 = ~Et voici aussi la Gemme de lumière. Elle... je... elle n'a pas l'air d'être là... elle a disparu ! Vous l'avez... vous l'avez prise !~
@51098 = ~Vous avez méprisé notre accord, et volé un objet précieux que j'étais disposé à vous donner ! Nous ne vous devons plus rien ! Hors d'ici !~
@51099 = ~Trêve de discussions. Nous vous remercions pour les efforts que vous avez faits, mais nous devons à présent passer à d'autres problèmes.~ [GOLDAN08]
@51100 = ~Iblith ! Euh... pardonnez-moi cet accès de frayeur, dame elfe noire, mais je n'ai pas l'habitude de voir des membres de votre peuple. Veuillez honorer de votre présence nos humbles demeures de granite.~ [GOLDAN09]
@51101 = ~Vaque à tes affaires, Goldander. Je ne te dérangerai pas.~
@51102 = ~Cela n'a rien d'étonnant. Vous êtes trop petits pour que l'on vous remarque.~
@51103 = ~Et cela ne se reproduira pas ! Défendez-vous !~
@51104 = ~Comme vous le souhaitez. Mes gardes ne vous importuneront pas... si vous leur retournez cette faveur.~
@51105 = ~Vos opinions sont bien connues. Inutile de risquer des désagréments en les répétant ici. Vous êtes, bien entendu, libre d'aller et venir à votre guise.~
@51106 = ~Folie ! Nous sommes en paix ! Gardes ! Od godden Steth !~
@51107 = ~Je suis prêt à vous offrir une couche molle et paisible, si vous le désirez. Demandez, et vous l'aurez. Vous l'aurez.~
@51108 = ~Il y a un gnome qui a perdu son fils ? J'ai peut-être des nouvelles pour lui.~
@51109 = ~Comment faites-vous pour travailler ici, sous la menace des raids des elfes noirs ?~
@51110 = ~Pas de bla-bla. Je veux juste savoir ce que vous offrez.~
@51111 = ~Vous devez parler de Therndle Daglefodd, oui vous devez. Il n'a pas vu son fils depuis plusieurs éveils. Vous le trouverez près de sa forge.~
@51112 = ~Continue à me parler comme ça et nous croiserons le fer !~
@51113 = ~Bien, je m'en vais.~
@51114 = ~C'est quoi, votre problème avec moi ?~
@51115 = ~Du calme. Je veux juste vous poser une ou deux questions.~
@51116 = ~Hmmf. Eh bien, tu as peut-être un petit peu de caractère, en fin de compte. Rengaine ton épée, idiot. Je n'ai pas envie de faire couler ton sang.~ ~Hmmf. Eh bien, tu as peut-être un petit peu de caractère, en fin de compte. Rengaine ton épée, idiote. Je n'ai pas envie de faire couler ton sang.~
@51117 = ~Eh puis, je suppose que ce n'est pas ta faute si j'ai été désigné pour m'occuper de toi. Encore une machination de la sorcière et de sa satanée mère, je parie. Pfeh.~
@51118 = ~Qu'y a-t-il entre Phaere et toi ?~
@51119 = ~Qu'y a-t-il à faire ici ?~
@51120 = ~Savez-vous quelque chose sur des dragons qui vivraient dans ces cavernes ?~
@51121 = ~Je dois partir.~
@51122 = ~Bonne idée. Et ne reviens pas.~
@51123 = ~Visiblement oui, puisque tu es encore là à me parler. Disparaît, ou je serai forcé de t'éventrer comme le misérable chaton miaulant que tu es.~
@51124 = ~Du calme, je veux juste te poser des questions.~
@51125 = ~On va voir qui va éventrer qui !~
@51126 = ~Très bien, je m'en vais.~
@51127 = ~C'est quelque chose dont je n'ai pas envie de parler, Veldrin. Ni avec toi, ni avec personne.~
@51128 = ~Disons juste que j'ai eu affaire à Phaere et à la Maison Despana auparavant. Mais mes propres alliances les empêchent de se venger de moi. Pour l'instant.~
@51129 = ~Qu'y a-t-il à faire ici ?~
@51130 = ~Savez-vous quelque chose sur des dragons qui vivraient dans ces cavernes ?~
@51131 = ~Je m'en vais alors.~
@51132 = ~De nombreuses distractions s'offrent aux plus cruels ou aux plus luxurieux d'entre nous, Veldrin. Je suis sûr que tu pourras trouver quelque chose. Quant à moi, cela ne m'intéresse pas.~
@51133 = ~Dis-moi, qu'y a-t-il entre Phaere et toi ?~
@51134 = ~Savez-vous quelque chose sur des dragons qui vivraient dans ces cavernes ?~
@51135 = ~Je m'en vais alors.~
@51136 = ~Hein ? Des dragons ? On trouve des draconiens à travers tout Ombre-Terre, Veldrin. Je suis sûr que tu le sais déjà. Certains marchent parmi nous, lorsque la fantaisie les en prend.~
@51137 = ~Mais aux alentours d'Ust Natha, je dirai que non... il y a peu de draconiens par ici. Les plus dangereux ont été chassés il y a bien longtemps.~
@51138 = ~On dit qu'un très vieux dragon d'argent garde les passages vers la surface, où vivent nos cousins détestés. Peut-être ces histoires sont-elles vraies.~
@51139 = ~Qu'y a-t-il entre Phaere et toi ?~
@51140 = ~Qu'y a-t-il à faire ici ?~
@51141 = ~Je vais y aller.~
@51142 = ~Comme tu veux.~
@51143 = ~Qu'y a-t-il, Veldrin ? Je veux juste qu'on me laisse en paix, à bonne distance des griffes de cette sorcière Despana.~
@51144 = ~Les elfes noirs nous laissent vivre. Nous écraser ne les intéresse pas. Nous sommes un petit avant-poste.~
@51145 = ~Mais ils viennent parfois quand même avec de mauvaises intentions. C'est juste pour le sport, à mon avis, parce qu'ils ne nous suivent jamais très profond. Mais la plupart du temps, c'est paisible.~
@51146 = ~Puis-je savoir quels services vous proposez ?~
@51147 = ~Et d'abord, qu'y a-t-il entre Phaere et toi ?~
@51148 = ~Pouvez-vous me conseiller quelque chose à faire ?~
@51149 = ~Savez-vous quelque chose sur des dragons qui vivraient dans ces cavernes ?~
@51150 = ~Alors, je m'en vais.~
@51151 = ~Laissez-moi. Ton espèce m'a déjà donné assez de chagrins pour 1 000 ans, femelle. N'est-ce pas assez que d'avoir été conduit ici contre ma volonté ?~ [UDSOLA13]
@51152 = ~Oh non, noble elfe noir, je ne rêverai même pas de vous héberger. Cet endroit est indigne de vous, oh tellement indigne !~ ~Oh non, noble elfe noire, je ne rêverai même pas de vous héberger. Cet endroit est indigne de vous, oh tellement indigne !~
@51153 = ~Je ne veux pas te parler, à toi ou à personne, elfe noir. Va-t-en. Va raconter tes histoires de Ched Nasad à ceux que cela intéresse.~
@51154 = ~Acceptez mes excuses pour l'état de cet endroit, je vous en prie. Vous trouverez certainement de meilleurs endroits pour dormir. Des endroits plus sûrs, aussi.~
@51155 = ~Ah ! Veldrin arrive enfin pour saluer la femme qu'il a si vaillamment sauvée des griffes des dévoreurs !~ ~Ah ! Veldrin arrive enfin pour saluer la femme qu'elle a si vaillamment sauvée des griffes des dévoreurs !~
@51156 = ~Vous allez me dire immédiatement ce que vous proposez !~
@51157 = ~Très bien, j'irai me reposer ailleurs.~
@51158 = ~C'est pour le mieux, vraiment. Je le sais, j'en suis sûr.~
@51159 = ~Y a-t-il quelqu'un parmi vous qui ait perdu un enfant ? Si oui, j'aimerai lui parler.~
@51160 = ~Je vous en prie, ne le tourmentez pas ! Il est malade d'inquiétude, et vos petits jeux vont aggraver son état. Therndle Daglefodd est celui que vous cherchez. Mais laissez-le, s'il vous plaît.~
@51161 = ~Ah. Je dois avoir été invisible et inactif pendant cette rencontre, à ce que je vois.~
@51162 = ~Je parlais à Veldrin, Solaufein. La prochaine fois que je t'adresserai la parole, ce sera pour t'ordonner de lécher mes bottes. Alors, surveille ta langue, sinon...~
@51163 = ~Je ferai ce que bon me semble. Et maintenant, quels services proposes-tu ?~
@51164 = ~Cela ne vous regarde pas. Je continuerai ma mission à ma manière.~
@51165 = ~Ne faites pas attention aux sautes d'humeur hormonales de mon commandant, Veldrin, et soyez sûr que vous serez récompensé. La Mère Matrone a apprécié votre efficacité.~ ~Ne faites pas attention aux sautes d'humeur hormonales de mon commandant, Veldrin, et soyez sûre que vous serez récompensée. La Mère Matrone a apprécié votre efficacité.~
@51166 = ~Comme vous le désirez.~
@51167 = ~Elle connaît déjà les capacités de Solaufein, mais elle sera enchantée de voir que vous êtes également très habile au combat ! Nous aurions besoin de quelqu'un comme vous à Ust Natha, Veldrin.~
@51168 = ~Chez les elfes noirs, c'est la loi du plus fort qui prévaut... Vous pourriez avoir des esclaves à votre service, des récompenses... les faveurs de Lolth. Qu'en dites-vous ?~
@51169 = ~Pardonnez mon intrusion, mais j'ai des nouvelles. J'ai retrouvé votre enfant et je l'ai libéré.~
@51170 = ~Therndle ? J'ai des nouvelles de votre enfant. C'est bien le vôtre qui a disparu, n'est-ce pas ?~
@51171 = ~Je voudrais voir ce que vous avez à vendre.~
@51172 = ~Mon enfant ? Il est revenu il y a peu, et il a raconté l'histoire de son sauvetage. J'ai cru que la faim l'avait rendu fou, ou pire.~
@51173 = ~Cela me semble parfait !~
@51174 = ~Où est le piège ?~
@51175 = ~Non, cela ne m'intéresse pas.~
@51176 = ~Je ne sais pas pourquoi vous vous moquez de moi. Vous n'êtes pas des surfacins, vous êtes des elfes noirs d'Ust Natha. Il a dit que des surfacins l'avaient sauvé.~
@51177 = ~Je suis plus intéressé par votre personne que par des récompenses...~ ~Je suis plus intéressée par votre personne que par des récompenses...~
@51178 = ~Ne jouez pas avec moi. J'attends ses sauveteurs pour les récompenser. Visitez ma boutique, mais c'est tout ce que vous obtiendrez de moi.~
@51179 = ~Excellent ! Enfin quelqu'un qui a de l'ambition ! C'est si rare de nos jours... n'est-ce pas, Solaufein ?~
@51180 = ~Peut-être est-il incapable de voir l'hameçon derrière l'appât, Phaere. Les ignorants sont toujours heureux.~ ~Peut-être est-elle incapable de voir l'hameçon derrière l'appât, Phaere. Les ignorants sont toujours heureux.~
@51181 = ~Quelquefois, l'appât vaut bien l'hameçon, imbécile. Je pensais que tu l'avais compris depuis longtemps.~
@51182 = ~Vous ne l'avez pas sauvé. Mon fils a dit qu'il avait été sauvé par un elfe noir, et j'ai plus en confiance en sa parole qu'en la vôtre.~ ~Vous ne l'avez pas sauvé. Mon fils a dit qu'il avait été sauvé par une elfe noire, et j'ai plus en confiance en sa parole qu'en la vôtre.~
@51183 = ~Le piège ? Eh bien, ces faveurs, il faut les gagner, Veldrin ! Elles se méritent... et se payent par le sang et les sacrifices.~
@51184 = ~Bon vent.~
@51185 = ~Très bien... pour l'instant. Qu'avez-vous à vendre ?~
@51186 = ~C'est un outrage ! Vous le regretterez ! Au revoir !~
@51187 = ~Je suis le surfacin qu'il a vu. Un sortilège me donne l'apparence d'un elfe noir.~ ~Je suis la surfacine qu'il a vu. Un sortilège me donne l'apparence d'une elfe noire.~
@51188 = ~Silence ! Tous les elfes noirs n'ont pas oublié qu'il faut parfois faire des sacrifices... Tu devrais y repenser...~
@51189 = ~Je n'aurai jamais cru qu'un elfe noir viendrait à son aide. Pardonnez-moi, mais vous n'êtes pas, mais alors pas du tout, réputés pour votre charité.~ ~Je n'aurai jamais cru qu'une elfe noire viendrait à son aide. Pardonnez-moi, mais vous n'êtes pas, mais alors pas du tout, réputés pour votre charité.~
@51190 = ~Phaere, pourquoi ne lui as-tu pas encore arraché le cœur ? De toute façon, c'est ce que tu feras à la fin, n'est-ce pas ?~
@51191 = ~En son nom, acceptez ce cadeau. Je vous remercie.~
@51192 = ~Un instant ! Des intrus arrivent par ici !~
@51193 = ~Je n'aurais pas cru que des surfacins lui viendraient en aide. Ceux qui ne sont pas du granit baissent rarement les yeux vers nous.~
@51194 = ~Tuez-les tous ! Il ne doit subsister aucun témoin !~
@51195 = ~Quel dommage, mâle, car vous n'avez pas le choix. Échouez, et vous n'aurez rien... réussissez, et vous serez récompensé !~ ~Quel dommage, femelle, car vous n'avez pas le choix. Échouez, et vous n'aurez rien... réussissez, et vous serez récompensée !~
@51196 = ~Vous jouez avec mon cœur. De sales jeux d'elfe noir, et je ne suis pas d'humeur. Laissez-moi.~ ~Vous jouez avec mon cœur. De sales jeux d'elfe noire, et je ne suis pas d'humeur. Laissez-moi.~
@51197 = ~Arrêtez ! Vous n'irez pas plus loin ! Vous êtes resté libre trop longtemps !~ ~Arrêtez ! Vous n'irez pas plus loin ! Vous êtes restée libre trop longtemps !~
@51198 = ~Mon fils a échappé à la prison où il était retenu ? Je vous remercie... mais pourquoi n'est-il pas avec vous ?~
@51199 = ~Puis-je voir ce que vous avez à troquer ?~
@51200 = ~Alors, montrez-moi ce que vous avez à vendre.~
@51201 = ~C'est un outrage ! Je mérite une récompense ! Au revoir !~
@51202 = ~Mais c'était moi, l'elfe noir qui l'a sauvé. Un sortilège me donnait l'apparence d'un elfe noir !~ ~Mais c'était moi, l'elfe noire qui l'a sauvé. Un sortilège me donnait l'apparence d'une elfe noire !~
@51203 = ~Peut-être devrais-tu jouer de la lyre et danser un peu, Phaere. Et il pourrait bien commencer à y croire, alors.~ ~Peut-être devrais-tu jouer de la lyre et danser un peu, Phaere. Et elle pourrait bien commencer à y croire, alors.~
@51204 = ~Mais c'était moi, l'elfe noir qui l'a sauvé. Un sortilège me donnait l'apparence d'un elfe noir !~ ~Mais c'était moi, l'elfe noire qui l'a sauvé. Un sortilège me donnait l'apparence d'une elfe noire !~
@51205 = ~Fou comme un caillou ! Vous jouez à des jeux stupides. J'aurai pu vous croire si vos mots avaient sonné juste, mais vous n'avez pas assez de présence pour me faire gober vos mensonges !~ ~Folle comme un caillou ! Vous jouez à des jeux stupides. J'aurai pu vous croire si vos mots avaient sonné juste, mais vous n'avez pas assez de présence pour me faire gober vos mensonges !~
@51206 = ~Je ne suis pas d'humeur à jouer. Dehors ! Ag dano gone !~
@51207 = ~Si je dois danser, ce sera sur ta tombe ! Parlez-moi encore une fois sur ce ton, et ce jour viendra plus vite que tu ne le penses !~
@51208 = ~~
@51209 = ~~
@51210 = ~Vos mots sonnent vrai... vous avez une présence imposante, en vérité. Je crois à votre histoire.~
@51211 = ~Ahh, c'est ainsi ? Eh bien, je pourrais peut-être vous enseigner les plaisirs de la chair dont je suis seule capable, mâle... mais seulement si vous vous montrez digne de cet honneur.~ ~Ahh, c'est ainsi ? Eh bien, je pourrais peut-être vous enseigner les plaisirs de la chair dont je suis seule capable, femelle... mais seulement si vous vous montrez digne de cet honneur.~
@51212 = ~*renâcle* Si tu sais ce qui est bon pour toi, Veldrin, cours dès que l'araignée commencera à montrer ses crochets.~
@51213 = ~Quel dommage que certains ne comprennent pas les plaisirs que peut procurer ma morsure, Solaufein. Rares sont ceux qui peuvent supporter mon poison et frémir d'extase...~
@51214 = ~Rien. Désolé de vous avoir dérangé.~ ~Rien. Désolée de vous avoir dérangé.~
@51215 = ~Bo das gola stoone.~
@51216 = ~La boutique est fermée aujourd'hui, étranger. Je dois partir chercher mon fils avant d'échanger ne serait-ce qu'une gemme. Il faut retrouver Bedlen Daglefodd.~ ~La boutique est fermée aujourd'hui, étrangère. Je dois partir chercher mon fils avant d'échanger ne serait-ce qu'une gemme. Il faut retrouver Bedlen Daglefodd.~
@51217 = ~Votre enfant a disparu ? Je pourrais peut-être vous aider ?~
@51218 = ~Il y a une récompense ?~
@51219 = ~Vous me condamnez aussi ? J'ai besoin de matériel pour survire. Personne ne le trouvera si nous ne sommes pas préparés.~
@51220 = ~Vous semblez triste, comme si vous aviez perdu quelque chose. Qu'est-ce qui ne va pas ?~
@51221 = ~Comme vous semblez efficaces, Solaufein et Veldrin, il vous a été confié une nouvelle mission, pour la plus grande gloire de Lolth.~
@51222 = ~Mon fils Bedlen Daglefodd a disparu depuis le temps de creuser un tunnel. Je ne peux pas travailler avant de savoir ce qui lui est arrivé.~
@51223 = ~Rejoignez-moi sur la plateforme, à l'abri des oreilles indiscrètes. Mais pas tout de suite... Reposez-vous un peu, prenez du bon temps. À plus tard.~
@51224 = ~Mais n'attendez pas plus de quelques jours avant de me rejoindre. C'est la Mère Matrone qui en a décidé ainsi.~
@51225 = ~Très bien, alors finissons-en avec cette maudite affaire !~
@51226 = ~Ehh, je regarderai si je ne le trouve pas. Je suis sûr qu'il va... bien. Oui... bien. Je peux voir vos marchandises ?~ ~Ehh, je regarderai si je ne le trouve pas. Je suis sûre qu'il va... bien. Oui... bien. Je peux voir vos marchandises ?~
@51227 = ~Je sais ce qui lui est arrivé. Il est mort. J'ai... trouvé le corps d'un jeune svirfnebelin.~
@51228 = ~J'ai bien peur de savoir ce qui lui est arrivé, monsieur. Il est mort. J'ai trouvé son cadavre.~
@51229 = ~Je n'espère aucune aide hors des demeures-granit. Bon vent.~
@51230 = ~Puis-je voir la liste de vos marchandises ? Si je dois sauver votre enfant, il faut que je sois bien équipé.~ ~Puis-je voir la liste de vos marchandises ? Si je dois sauver votre enfant, il faut que je sois bien équipée.~
@51231 = ~Es-tu demeuré ? Qu'est-ce que tu cherches avec de telles propositions ? Tu n'es rien pour une fille comme elle... un moment de distraction qui ne lui coûte rien, mais qui pourrait te coûter cher !~ ~Es-tu demeurée ? Qu'est-ce que tu cherches avec de telles propositions ? Tu n'es rien pour une fille comme elle... un moment de distraction qui ne lui coûte rien, mais qui pourrait te coûter cher !~
@51232 = ~Serais-tu jalouse, Viconia ?~
@51233 = ~Tu sembles te faire un bien piètre opinion de mon effet sur les femmes.~
@51234 = ~Ce n'est qu'une ruse, Viconia... ne prends pas la mouche.~
@51235 = ~Comme cela devait être.~
@51236 = ~Merci. Je chercherai votre enfant si j'en ai la possibilité.~
@51237 = ~Du calme. Je verrai si je peux trouver votre mioche.~
@51238 = ~Garde ton avis pour toi, Viconia. Je fais ce que je veux.~
@51239 = ~*d'après ses vêtements et ses effets personnels, ce cadavre est certainement celui du père de Nalia*~
@51240 = ~Je n'espère aucune aide hors des demeures-granit. Dites ce que vous voulez, ce ne prouve pas que vos intentions soient bonnes.~
@51241 = ~Ah, cette dispute ne m'aide pas ! Voilà ce que j'ai à vendre, qu'on en finisse, dépêchez-vous, je n'ai pas le temps.~
@51242 = ~Merci. Lorsque j'aurai le temps, je chercherai votre enfant.~
@51243 = ~Je chercherai peut-être votre gamin... si je passe dans le coin.~
@51244 = ~Ne me fais pas rire. Dans cet endroit, tu ne joues pas seulement avec ta propre vie en proposant des examens si intimes. Tu nous mettras tous en danger, par tous les moyens, si tu ne peux pas résister aux appâts de la sorcière.~
@51245 = ~Calme-toi... ce n'est qu'une ruse, rien de plus.~
@51246 = ~C'est possible. Je ferai ce que je veux, Viconia, laisse-moi tranquille.~
@51247 = ~Ne me fais pas rire, <CHARNAME>. Tu sembles oublier que les elfes noires ne voient en toi qu'un mâle pathétique. Si c'est une sorte de ruse, je te suggère de la reconsidérer.~
@51248 = ~Et si c'est une ruse ? Quel mal y a-t-il à cela ?~
@51249 = ~Je fais ce que je veux, Viconia. Lâche-moi un peu la bride.~
@51250 = ~Les elfes noirs apprennent ce jeu dès le plus jeune âge et y jouent bien mieux que tu ne saurais l'imaginer. Évite de tels contacts avec Phaere, je te préviens... il ne pourra rien en sortir de bon.~
@51251 = ~Je l'ai tué. Bouh !~
@51252 = ~Je vois. Je suis tout d'un coup reléguée au rang de la harpie rabat-joie. Fort bien, <CHARNAME>... tu ne m'entendras plus. Fais donc ce que te dictent tes misérables désirs.~
@51253 = ~Vous avez tué mon fils ! J'aurai votre tête ! Nous aurons tous votre tête ! Got if sallen id ! Stoone da willen !~
@51254 = ~Que cherches-tu à faire, <CHARNAME> ? Tu crois que je suis aveugle au point de ne pas voir ton attitude stupide avec l'elfe noire ? Pourquoi jouerais-tu un jeu aussi stupide... tu as oublié ta situation ?~
@51255 = ~Vous... avez trouvé un corps ! Vous... vous mentez ! Je le sens ! Je n'ai jamais eu confiance dans vos pareils ! Vous l'avez tué !~
@51256 = ~Je ne croirai jamais un elfe noir ! Vos petits jeux sont transparents ! J'aurai votre tête ! Nous aurons tous votre tête ! Got if sallen id ! Stoone da willen !~ ~Je ne croirai jamais une elfe noire ! Vos petits jeux sont transparents ! J'aurai votre tête ! Nous aurons tous votre tête ! Got if sallen id ! Stoone da willen !~
@51257 = ~Tu es jalouse, Jaheira ? Je ne m'attendais pas à ça.~
@51258 = ~C'est un stratagème, Jaheira... rien d'autre.~
@51259 = ~Je ferai ce qui me plaît, Jaheira. Tu peux garder tes conseils.~
@51260 = ~Vous avez trouvé son... je vous crois... je sentais que quelque chose allait terriblement de travers... Merci de me l'avoir dit.~
@51261 = ~Jalouse d'un elfe noir qui baisse les yeux ? Tu as une si mauvaise opinion de moi ? Je pense qu'une amourette n'apporterait rien et nous mettrait tous en danger.~
@51262 = ~C'est un stratagème, Jaheira... rien d'autre.~
@51263 = ~Je ferai ce qui me plaît, Jaheira. Tu peux garder tes conseils.~
@51264 = ~C'est stupide. Les elfes noirs n'aiment ni la tendresse, ni la séduction intense. Le sexe n'est qu'un jeu pour eux. S'abandonner serait... décevant.~
@51265 = ~Ah ? Je suis déçue. Cède à ta sensualité, je t'en prie, si cela a tant d'importance pour toi. Je n'en dirai pas plus sur ce sujet ou un autre.~
@51266 = ~<CHARNAME> ? Qu... que faites-vous ? Pourquoi lui parlez-vous de la sorte ? Vous... vous n'appréciez pas vraiment cette elfe noire de cette... de cette façon, n'est-ce pas ?~
@51267 = ~Les tunnels... sont dangereux... Merci d'avoir été assez... bon pour me prévenir.~ ~Les tunnels... sont dangereux... Merci d'avoir été assez... bonne pour me prévenir.~
@51268 = ~Mes condoléances. Puis-je voir ce que vous avez à vendre, à présent ?~
@51269 = ~Pas de chance, je pense. Adieu.~
@51270 = ~En fait, je l'ai tué sans raison particulière. Gnyark nyark !~
@51271 = ~Vous n'êtes pas jalouse, Aerie, tout de même ?~
@51272 = ~Non, non... c'est juste un stratagème.~
@51273 = ~Je ne sais pas. Peut-être. Ce ne sont pas vos affaires.~
@51274 = ~Eh bien... peut-être un peu. Elle est très jolie, pour une elfe noire. Mais ils sont mauvais, <CHARNAME>, il faut que vous le sachiez ! Et... et à la façon que vous aviez de lui parler, j'ai pensé que peut-être...~
@51275 = ~Ce n'est qu'une ruse, Aerie, rien de plus.~
@51276 = ~Eh bien, peut-être. Cela ne vous regarde pas, de toute façon.~
@51277 = ~Oh. Je... je ne pense pas que l'on puisse manipuler une elfe noire de cette façon, <CHARNAME>. Et... et je n'aime vraiment pas ça. De grâce, n'allez pas trop loin, je vous en prie.~
@51278 = ~Vous pourriez... Avec quelqu'un de si sournois et méprisable ? Je crois que vous n'êtes pas du tout l'homme que j'imaginais, <CHARNAME>. Je crois... je crois que je vais me tenir à l'écart de vos affaires.~ ~Vous pourriez... Avec quelqu'un de si sournois et méprisable ? Je crois que vous n'êtes pas du tout celle que j'imaginais, <CHARNAME>. Je crois... je crois que je vais me tenir à l'écart de vos affaires.~
@51279 = ~Oui ? Que voulez-vous, Veldrin ?~
@51280 = ~Qu'y a-t-il entre vous et Solaufein ?~
@51281 = ~Que pouvez-vous me dire à propos des Mères Matrones et de votre Maison ?~
@51282 = ~Savez-vous quelque chose sur les dragons ?~
@51283 = ~Non, pas vraiment.~
@51284 = ~Lui avez-vous posé la question ? Sa réponse pourrait différer de la mienne... Disons simplement que... Solaufein est trop lamentable pour mériter mon respect.~
@51285 = ~La Mère Matrone l'aurait déjà sacrifié à Lolth, si cet arrogant ne s'était pas allié avec une puissante Maison ! Ainsi, ce mâle arrogant est libre.~
@51286 = ~Mais la roue tourne, Veldrin. La roue tourne...~
@51287 = ~Que pouvez-vous me dire à propos des Mères Matrones et de votre Maison ?~
@51288 = ~Savez-vous quelque chose sur les dragons ?~
@51289 = ~Je dois partir.~
@51290 = ~La Maison Despana est présente dans de nombreuses villes, Veldrin, pas seulement à Ust Natha. Ici, c'est Mère Ardulace qui gouverne, et nous avons les faveurs de Lolth.~
@51291 = ~J'ai de nombreuses sœurs qui lorgnent sur ma position. Mais les plus dangereuses, aînées ou cadettes, je m'en suis déjà occupée, par le poison ou l'acier.~
@51292 = ~Maintenant, je suis l'aînée et la plus puissante des filles d'Ardulace. Et quand elle sera vieille et faible, je la tuerai et je deviendrai la Mère Matrone de ma Maison.~
@51293 = ~C'est horrible !~
@51294 = ~Vous semblez très ambitieuse, Phaere.~
@51295 = ~Bravo ! Vous êtes très forte !~
@51296 = ~Vraiment ? Cela me semble assez innocent ! Voulez-vous dire que vous n'avez pas assez d'estomac pour ce genre d'intrigues ? Quel dommage...~
@51297 = ~Bientôt, la Maison Despana régnera sur toutes les autres d'Ust Natha, et je serai la Mère Matrone favorite de Lolth... Restez près de moi, vous pourrez profiter des miettes.~
@51298 = ~Pourquoi ? Qu'est-ce qui doit arriver bientôt ?~
@51299 = ~Vous verrez bien, Veldrin. Enfin... si vous êtes assez intelligent.~ ~Vous verrez bien, Veldrin. Enfin... si vous êtes assez intelligente.~
@51300 = ~Alors... Qu'y a-t-il exactement entre vous et Solaufein ?~
@51301 = ~Dites-moi... savez-vous quelque chose sur les dragons ?~
@51302 = ~Je vois. Je m'en vais.~
@51303 = ~Sur les dragons ? Peut-être... Pourquoi ?~
@51304 = ~Simple curiosité.~
@51305 = ~Comme ça...~
@51306 = ~Je veux juste être sûr qu'il n'y a aucun risque d'en rencontrer... J'ai entendu parler d'un dragon d'argent dans les cavernes qui donne la chasse aux elfes noirs.~ ~Je veux juste être sûre qu'il n'y a aucun risque d'en rencontrer... J'ai entendu parler d'un dragon d'argent dans les cavernes qui donne la chasse aux elfes noirs.~
@51307 = ~La curiosité est un vilain défaut pour un serviteur, Veldrin. Réfrénez vos questions pour l'instant, et vous apprendrez bien plus en temps voulu.~ ~La curiosité est un vilain défaut pour une servante, Veldrin. Réfrénez vos questions pour l'instant, et vous apprendrez bien plus en temps voulu.~
@51308 = ~Qu'y a-t-il, alors, entre vous et Solaufein ?~
@51309 = ~Que pouvez-vous me dire à propos des Mères Matrones et de votre Maison ?~
@51310 = ~Je vois. Je m'en vais.~
@51311 = ~Ah. Ne vous inquiétez pas à propos de ces racontars, Veldrin. Cette créature n'est plus une menace.~
@51312 = ~Ah bon ? Êtes-vous sûre ?~
@51313 = ~Oui, profitez de votre temps libre. Vous avez de la chance, Veldrin, que mon attention se soit tournée vers vous. Ensemble, les tâches à accomplir seront plus faciles.~
@51314 = ~Et si vous êtes obéissant et intelligent... et un amant imaginatif, si tel devait être mon désir... les choses deviendront nettement plus agréables pour vous.~
@51315 = ~Vous accompagnez Veldrin ? Il est à moi maintenant, femelle. Je vous conseille de ne plus l'approcher, quelles que soient vos anciennes relations... ou cela deviendra très déplaisant.~
@51316 = ~Qui êtes-vous et pourquoi devrais-je me soumettre à vos ordres ?~
@51317 = ~Vous accompagnez Veldrin ? Il est bon que Ched Nasad nous fournisse en femmes fortes... Ensemble, nous conquerrons Ust Natha. Mais pour l'instant, du balai... vous n'avez aucun intérêt pour moi.~
@51318 = ~Vous êtes un des compagnons mâles de Veldrin ? C'est intéressant... Peut-être me servirez-vous quand il sera exténué. Ne vous éloignez pas trop !~ ~Vous êtes un des compagnons mâles de Veldrin ? C'est intéressant... Peut-être me servirez-vous quand elle sera exténuée. Ne vous éloignez pas trop !~
@51319 = ~Brigands ! Jamais je ne me rendrai !~
@51320 = ~Je ne veux pas me battre. Je me rends, mais discutons.~
@51321 = ~Sage décision, <CHARNAME>. Clea ! Attache-lui les mains !~
@51322 = ~Ah, vous voilà enfin. Bien. Le minutage est excellent, puisque je viens d'arriver. Nous sommes donc prêts à partir.~
@51323 = ~*renâcle* Ne me parle pas. Phaere nous a fait traîner ici, et elle ne m'a rien dit. Tu es assez malchanceux pour t'être attiré sa faveur... Essaye de découvrir ses plans.~ ~*renâcle* Ne me parle pas. Phaere nous a fait traîner ici, et elle ne m'a rien dit. Tu es assez malchanceuse pour t'être attiré sa faveur... Essaye de découvrir ses plans.~
@51324 = ~Bah ! Je n'ai rien à voir avec cette expédition ! Ne m'en parle pas !~
@51325 = ~À quoi es-tu prête, au juste, Phaere ? Pourquoi nous as-tu fait amener ici ? Est-ce le produit de ton ambition dérangée ?~
@51326 = ~Mes ambitions sont tout ce qu'il y a de respectables, Solaufein. Et nous allons accomplir une tâche pour le bien de la cité et des Mères Matrones.~
@51327 = ~J'ignorais que Mère Ardulace ait jamais agi « pour le bien de la cité ».~
@51328 = ~Silence ! Tu vas obéir, mâle ! Un œil-tyran... un spectateur... est dans la ville, pour trafiquer de l'adamantite. Les Mères Matrones ont décidé qu'il nous fallait le tuer !~
@51329 = ~Vous me forcez la main, <CHARNAME> ! Je n'ai pas de réponse pour vous ! À l'attaque !~
@51330 = ~Comment ? Tu as dit « nous » ?~
@51331 = ~Soyez les bienvenus dans mon antre. Je vous ai observé avec grand intérêt.~ [SILVER02] ~Soyez les bienvenus dans mon antre. Je vous ai observée avec grand intérêt.~ [SILVER02]
@51332 = ~Oui. Je dois me joindre à vous pour cette tâche. L'œil-tyran est arrivé à bord de son vaisseau Spelljammer, près d'ici. Solaufein et moi nous partirons seuls en reconnaissance.~
@51333 = ~Veldrin... Je pense que vous pourrez trouver vous-même une voie d'accès au vaisseau. Il est sur l'une des plateformes au sud-est d'Ust Natha. Ne perdez pas de temps.~
@51334 = ~Madame, vos paroles m'honorent.~
@51335 = ~Vos paroles m'honorent.~
@51336 = ~Que mon allure doit être digne pour intéresser les yeux d'un dragon d'argent !~
@51337 = ~Viens Solaufein, ça nous rappellera le « bon vieux temps ».~
@51338 = ~Que mon allure doit être digne pour intéresser les yeux d'un dragon d'argent !~
@51339 = ~Votre « intérêt » m'importe peu. Je suis venu chercher des informations.~ ~Votre « intérêt » m'importe peu. Je suis venue chercher des informations.~
@51340 = ~Votre « intérêt » m'importe peu. Je suis venu chercher des informations.~ ~Votre « intérêt » m'importe peu. Je suis venue chercher des informations.~
@51341 = ~Pesez vos mots ! Mon « intérêt » ne signifie pas mon approbation ! Plutôt que de discuter, vous auriez pu, en d'autres temps, apprécier mes dents et mes griffes.~
@51342 = ~Je vous ai vu de loin. En tant que cruel meurtrier du fils de Therndle, vous devriez recevoir ma colère. Quelle mort inutile !~ ~Je vous ai vue de loin. En tant que cruelle meurtrière du fils de Therndle, vous devriez recevoir ma colère. Quelle mort inutile !~
@51343 = ~Vous êtes arrivé ici grâce à la ruse, sans exaucer les souhaits de Goldander Blackenrock. À cause de cela, lui et son peuple vont succomber au balor qu'ils ont déterré.~ ~Vous êtes arrivée ici grâce à la ruse, sans exaucer les souhaits de Goldander Blackenrock. À cause de cela, lui et son peuple vont succomber au balor qu'ils ont déterré.~
@51344 = ~Vous êtes un homme recherché, <CHARNAME>. Je ne m'intéresse qu'à la prime. Et je le redis : vous êtes resté libre trop longtemps !~ ~Vous êtes une femme recherchée, <CHARNAME>. Je ne m'intéresse qu'à la prime. Et je le redis : vous êtes restée libre trop longtemps !~
@51345 = ~Au cours de vos voyages, vous avez commis des crimes inutiles, privant Therndle de son fils, et vous êtes parvenu jusqu'ici grâce à la ruse, sans aider Goldander Blackenrock. S'ils ne sont pas déjà morts, ça ne saurait tarder.~ ~Au cours de vos voyages, vous avez commis des crimes inutiles, privant Therndle de son fils, et vous êtes parvenue jusqu'ici grâce à la ruse, sans aider Goldander Blackenrock. S'ils ne sont pas déjà morts, ça ne saurait tarder.~
@51346 = ~Je ne me rendrai pas à un chasseur de primes ! Qu'est-ce que c'est que cette histoire ?~
@51347 = ~Je ne veux pas me battre. Dites-moi de quoi il s'agit et je me rendrai peut-être.~
@51348 = ~Bien que vous soyez particulièrement infâme, j'ai besoin de vous. Et vous avez besoin de moi.~
@51349 = ~J'en suis certaine, mais ce n'est pas pour la flatterie que je vous ai permis de venir ici. Ne me prêtez pas trop de générosité ; je n'ai pas autant de tolérance que d'autres de mon espèce.~
@51350 = ~Vous avez bien trop d'ego. Intérêt ne signifie ni approbation, ni soutien. Ne croyez pas que je vous estime, <CHARNAME>, je ne suis pas la plus tolérante de mon espèce.~
@51351 = ~Pitié monsieur ! Pitié, je vous en prie !~ ~Pitié madame ! Pitié, je vous en prie !~
@51352 = ~Je sais très bien pour quelles raisons vous êtes là. Ne vous attendez pas à recevoir facilement ce que vous désirez. Je ne suis pas la plus tolérante de mon espèce.~
@51353 = ~Taisez-vous ! <CHARNAME>, laissez mon prisonnier tranquille. Cela ne vous regarde pas.~
@51354 = ~Mais maître Mae'Var. Cela fait dix ans...~
@51355 = ~Veldrin ! Enfin ! Nous avons vu l'équipage quitter le vaisseau pour se reposer, et je crois que l'œil-tyran va bientôt les suivre ! Nous devons être prêts !~
@51356 = ~Je suis Adalon, la gardienne, et j'ai rempli mon devoir du mieux que j'ai pu depuis de nombreux siècles. Bien que je ne fus pas la première, je connais l'histoire.~
@51357 = ~Silence Kamuzu ! Souhaites-tu tâter à nouveau de la table ?~
@51358 = ~Non, je... je vais rester tranquille, maître.~
@51359 = ~Assure-toi que vos attaques ne blessent ni Phaere, ni moi. Ce genre « d'accident » se produit bien trop souvent... et je n'ai pas confiance en toi.~
@51360 = ~Mon seigneur ! Vous avez réussi ! Le tyran est mort !~ ~Ma dame ! Vous avez réussi ! Le tyran est mort !~
@51361 = ~Je suis responsable des ruines elfiques situées plus haut, un ancien temple qui établit le passage vers l'Ombre-Terre. Il en existe d'autres ailleurs, mais celui-ci est le premier.~
@51362 = ~Pour une fois la mort est la bienvenue dans cet enfer ! S'il vous plaît, délivrez-moi ! J'ai été dans cette prison pendant dix ans !~
@51363 = ~Concentre tous tes efforts sur l'œil-tyran, Veldrin. Et ne blesse ni Phaere, ni moi... ce genre « d'accident » se produit bien trop souvent à mon goût.~
@51364 = ~Le temple symbolise l'endroit où les premiers elfes au cœur noir sont apparus, distinguant bien d'un côté les elfes et de l'autre les elfes noirs.~
@51365 = ~Bien sûr. Vous pouvez partir.~
@51366 = ~Hmm. Oui... mais je... Attendez ! Ne bougez plus ! Il approche, je le sens ! Soyez prêts !~
@51367 = ~Dix ans ? Qu'avez-vous fait pour mériter cela ?~
@51368 = ~Ce n'est pas dans mes habitudes de libérer du gibier de potence parmi la populace sans défense. Tu peux moisir dans ta cage !~
@51369 = ~Je dois signaler la mort de Mae'Var. Je vous libérerai à mon retour.~
@51370 = ~Merci mille fois ! Longtemps j'ai attendu, longtemps j'ai souffert. J'ai une dette éternelle envers vous, cher ami. Je dois partir maintenant car je ne peux plus supporter la puanteur de cet endroit.~ ~Merci mille fois ! Longtemps j'ai attendu, longtemps j'ai souffert. J'ai une dette éternelle envers vous, chère amie. Je dois partir maintenant car je ne peux plus supporter la puanteur de cet endroit.~
@51371 = ~Le premier quoi ?~
@51372 = ~Qu'est-ce que j'en ai à faire d'une ancienne ruine ?~
@51373 = ~Pourquoi cela fait-il de vous la gardienne ?~
@51374 = ~Les elfes noirs conservent ici l'avant-poste d'Ust Natha comme un symbole, pour lequel ils se battent régulièrement. Bien qu'ayant dirigé les combats, j'ai constaté plusieurs décennies de suite de paix.~
@51375 = ~Rien monsieur ! Je n'ai rien fait. Cette brute de Mae'Var a simplement trouvé que je l'avais regardé avec mépris. Il m'a fait capturer par ses hommes.~ ~Rien madame ! Je n'ai rien fait. Cette brute de Mae'Var a simplement trouvé que je l'avais regardé avec mépris. Il m'a fait capturer par ses hommes.~
@51376 = ~J'ai été torturé et emprisonné ici pendant dix ans. Toujours ils se sont moqués de mes protestations d'innocence. Ce monstre disait que je devais être un exemple pour la populace. Il ne fallait pas manquer de respect à Mae'Var.~
@51377 = ~Une victoire retentissante ! La Reine Araignée est de notre côté aujourd'hui ! Nous avons craché à la face des tyrans et avons survécu ! Nous avons craché dans le grand œil des yeux-tyrans et nous vivrons pour le raconter !~ [UDSOLA10]
@51378 = ~Pour une offense présumée je fus emprisonné mais mon tortionnaire est mort.~
@51379 = ~Un crime a été perpétré récemment ici, et je ne peux plus assurer mon engagement. J'ai besoin de votre aide, et je vous aiderai en retour.~
@51380 = ~Parlez. Après avoir écouté, je verrai ce que je peux faire.~
@51381 = ~Encore ? Vous avez vu comment j'aide les autres.~
@51382 = ~J'ai du mal à rendre service. Peut-être que si je goûtais à votre trésor ?~
@51383 = ~S'il vous plaît ! Pitié seigneur !~ ~S'il vous plaît ! Pitié madame !~
@51384 = ~Et si je n'ai pas besoin de votre aide ?~
@51385 = ~Silence ! Je... je vous dirai quand vous pourrez parler. C'est une affaire très importante et je ne veux pas être interrompue.~
@51386 = ~La réponse est toujours non.~
@51387 = ~Les elfes noirs ont toujours respecté les frontières de cet endroit ; ils n'en sortaient que pour se divertir et participer à de petites escarmouches. C'était l'équilibre.~
@51388 = ~Très bien. Vous êtes libre.~
@51389 = ~Le cauchemar continue... je vais finir mes jours dans ce trou.~
@51390 = ~Mais... s'il le faut. Revenez vite, je vous en prie ! Je ne vais pas supporter encore longtemps de vivre dans cette cage !~
@51391 = ~S'il vous plaît, monsieur ! Pouvez-vous me libérer maintenant ?~
@51392 = ~Bien sûr. Vous êtes libre, ami.~
@51393 = ~Pourquoi êtes-vous emprisonné ? Qu'avez-vous fait ?~
@51394 = ~Je ne vais pas libérer un criminel.~
@51395 = ~Ceux que vous cherchez, Bodhi et Jon Irenicus, ont, je crois, fait un pacte avec les elfes noirs afin de circuler librement. Ils ont trouvé un moyen de faire pencher la balance au détriment de leurs ennemis les elfes.~
@51396 = ~Bravo, bon travail. Mais ne touchez pas la carcasse, des acolytes vont venir s'en occuper.~
@51397 = ~Vous devez vous demander pourquoi je n'use pas de mon influence. Je ne peux pas. Irenicus possède mon bien le plus précieux. Il s'est introduit dans mon antre pour me voler. Les voleurs ont pris mes œufs.~
@51398 = ~S'en occuper ? De quoi parles-tu, Phaere ? Pourquoi des acolytes voudraient-ils faire quelque chose du cadavre d'un œil-tyran ?~
@51399 = ~Quelles infâmes créatures ! Comment peut-on commettre un tel crime !~
@51400 = ~C'est malheureux. J'imagine qu'ils menacent de les détruire si vous vous aventurez là-bas.~
@51401 = ~Ah ! Ils vous ont surpris en train de faire la sieste ? C'est le meilleur moyen pour ne pas se faire prendre.~
@51402 = ~Pas de questions, Solaufein. Nous devons retourner prévenir les Mères Matrones. Veldrin... je vous verrai dans trois jours à la taverne.~
@51403 = ~On m'a informée que si je sortais de mon antre, ils détruiraient mes œufs. J'ai été victime d'un grand nombre d'atrocités, celle-ci est la dernière en date.~
@51404 = ~Que ce passe-t-il ici, Phaere ? C'est réellement louche.~
@51405 = ~Fais ce que l'on t'ordonne, mâle. Veldrin, vous pouvez visiter la cité... mais n'oubliez pas notre rendez-vous. Ne soyez pas en retard !~
@51406 = ~Vous devez les récupérer pour moi. Si vous y parvenez, je vous dévoilerai une route sans danger pour quitter l'Ombre-Terre, et qui débouche près de l'endroit où Irenicus prépare son prochain coup.~
@51407 = ~Laissez-moi.~ [UDSOLA13]
@51408 = ~Pourquoi ? Qu'est-ce qui tourne mal ?~
@51409 = ~Pourquoi ? Qu'est-ce qui tourne mal ?~
@51410 = ~Très bien.~
@51411 = ~<CHARNAME> ! C'est moi, Kamuzu, que vous avez libéré de la prison de Mae'Var. J'ai à vous parler.~
@51412 = ~*soupire* Phaere et moi nous sommes... disputés. Cela n'a rien à voir avec toi.~
@51413 = ~Qu'y a-t-il, vieil homme ?~
@51414 = ~Ceci a l'air urgent ? Qu'y a-t-il ?~
@51415 = ~Je t'ai dit de me laisser ! Ton cerveau est-il trop dégénéré pour que tu comprennes mes ordres ? Peut-être comprendrais-tu mieux avec une dague plantée dans le crâne ?~
@51416 = ~Je n'ai pas le temps de vous parler pour le moment.~
@51417 = ~Menace-moi encore, Solaufein, et nous verrons qui de nous deux finira avec une dague dans le crâne.~
@51418 = ~Votre vie est peut-être en danger ! Écoutez-moi, je vous en prie !~
@51419 = ~*un groupe de guerriers elfes noirs se téléporte dans le secteur, vous sentez la puanteur de leur sinistre magie*~
@51420 = ~Très bien. Qu'y a-t-il ?~
@51421 = ~C'était juste une simple question.~
@51422 = ~Vous n'avez rien à dire qui puisse m'intéresser. Allez-vous-en !~
@51423 = ~Non seulement je vous rapproche de votre cible, mais je veux aussi vous offrir un élément de mon trésor. Il sera puissant et digne du service rendu.~
@51424 = ~Très bien, très bien, je vous laisse.~
@51425 = ~La femme qui était ici il y a un instant, je m'en méfierais à votre place !~
@51426 = ~Pourquoi cela ?~
@51427 = ~Même sans récompense, vous pourriez compter sur moi.~
@51428 = ~Vous me demandez d'affronter une force très puissante, alors que vous ne le feriez pas vous-même ? C'est du suicide !~
@51429 = ~Je me demande bien ce que je peux faire ? Vous voulez que j'affronte toute une cité d'elfes noirs.~
@51430 = ~Hmmf. Tu as un peu de caractère, finalement. Mais si tu tombes entre les griffes de Phaere, cela ne te servira à rien. Je ne verserai pas de sang ici, idiot... parle-lui si tu le souhaites.~ ~Hmmf. Tu as un peu de caractère, finalement. Mais si tu tombes entre les griffes de Phaere, cela ne te servira à rien. Je ne verserai pas de sang ici, idiote... parle-lui si tu le souhaites.~
@51431 = ~Comme vous voudrez.~
@51432 = ~Je la connais. Je l'ai vue à la prison avec Mae'Var. Je crois qu'ils étaient amants. Il se pourrait qu'elle essaie de vous tuer.~
@51433 = ~C'est ridicule. C'est une Voleuse de l'ombre de haut rang et je lui fais confiance plus qu'à vous.~
@51434 = ~En effet, voilà une information précieuse ! Je vous remercie, Kamuzu. Je serai prudent.~ ~En effet, voilà une information précieuse ! Je vous remercie, Kamuzu. Je serai prudente.~
@51435 = ~Une question simple posée par un esprit simple. Tu n'es pas un vrai elfe noir. Tous les mâles de Ched Nasad ne peuvent pas être comme toi, sinon cette ville aurait cessé d'exister il y a longtemps.~ ~Une question simple posée par un esprit simple. Tu n'es pas une vraie elfe noire. Toutes les femelles de Ched Nasad ne peuvent pas être comme toi, sinon cette ville aurait cessé d'exister il y a longtemps.~
@51436 = ~Je n'ai pas envie de vous parler, <MALEFEMALE>. Veldrin est le seul qui m'intéresse, pour le moment.~ ~Je n'ai pas envie de vous parler, <MALEFEMALE>. Veldrin est la seule qui m'intéresse, pour le moment.~
@51437 = ~Croyez ce que vous voulez mais j'ai vu cette femme avec Mae'Var. Je veux seulement vous mettre en garde. Je vais vous laisser à vos affaires.~
@51438 = ~C'est le moins que je puisse faire. Vous m'avez sauvé la vie ! Soyez prudent, <CHARNAME>. Vous devez vous méfier d'elle. Adieu !~
@51439 = ~Votre présence est réconfortante, Veldrin. Jusqu'à maintenant, je n'avais que Solaufein, et sa mélancolie chronique commençait à me porter sur les nerfs.~
@51440 = ~Si vous êtes si faible que ça, je devrais peut-être me servir directement dans votre trésor.~
@51441 = ~Je ne suis pas folle au point de conserver mon trésor près d'un avant-poste elfe noir. Non, vous aurez ce que je vous donnerai et pas une pièce de plus. Peut-être avez-vous parlé trop vite, mais c'est non.~
@51442 = ~C'est très noble de votre part, mais j'en ai vu plus d'un abandonner de tels engagements. Mon séjour ici m'a rendu amère de la compagnie des non-dragons.~ ~C'est très noble de votre part, mais j'en ai vu plus d'une abandonner de tels engagements. Mon séjour ici m'a rendu amère de la compagnie des non-dragons.~
@51443 = ~J'ai bien conscience du danger que représente cette mission, mais je ne vous demande pas de prendre la cité d'assaut. Non, il y a un moyen beaucoup plus subtil.~
@51444 = ~Pitié, pas tuer moi, <RACE> ! Je travaille juste dans fosse ! Moi pas détester vous ! Pas vous faire de mal !~
@51445 = ~Tu m'as attaqué et tu mérites de mourir !~ ~Tu m'as attaquée et tu mérites de mourir !~
@51446 = ~C'est très mal ! Très mal ! Je me bats si vous faites ça !~
@51447 = ~Je vous suis reconnaissante, et accompagnerait votre succès. Je ne vous demande pas de prendre la cité d'assaut, mais de vous y introduire subtilement.~
@51448 = ~Tu me fais pitié. Sauve-toi et ne reviens pas.~
@51449 = ~Votre groupe prendra l'identité d'un groupe d'elfes noirs que j'ai récemment expédié dans l'autre monde, un groupe d'une autre cité à destination d'Ust Natha.~
@51450 = ~D'accord, d'accord ! Pitié, pitié ! Je pars et reviens pas !~
@51451 = ~Je vous transformerai de telle sorte que vous infiltrerez les elfes noirs facilement. Ils ne découvriront pas la supercherie.~
@51452 = ~Quand vous atteindrez les portes, dites-leur que vous venez de la cité de Ched Nasad, et que vous cherchez l'asile à Ust Natha.~
@51453 = ~Jetez votre sort et que l'illusion commence.~
@51454 = ~Parchemin de façonnage de la pierre~
@51455 = ~Je cherche la logique là-dedans. Je ne connais pas suffisamment les habitudes des elfes noirs.~
@51456 = ~Improvisez. En ce moment, ils vivent dans l'agitation de la guerre, et ne feront pas attention. Ils ne refuseront pas des bras supplémentaires.~
@51457 = ~Je vous ai permis de vous échapper la première fois, mais je ne commettrai pas deux fois la même erreur. À l'attaque !~
@51458 = ~Vous pouvez aussi interroger la drow qui voyage avec vous. Je suis sûr qu'elle en sait beaucoup. Il vaudrait mieux pour elle qu'elle ne se fasse pas prendre, si j'ai bien compris.~
@51459 = ~Viconia, n'est-ce pas ? Vous êtes une paria autant méprisée par les drows que par les habitants de la surface. Quand bien même vous chercheriez la rédemption et me trahirez, sachez que je vous tuerai.~
@51460 = ~Nul besoin de me menacer. Occupe-toi juste de la transformation.~
@51461 = ~Je vais être brève pour ne pas vous retarder. Cela te plairait, Solaufein, non ?~
@51462 = ~Seules vos propres erreurs dévoileront votre véritable identité, alors faites bien attention à n'en commettre aucune.~
@51463 = ~Si tu le dois absolument, crache-le.~
@51464 = ~Bon. Les Mères Matrones ont décidé que les gnomes des profondeurs, les svirfnebelins, n'ont pas assez montré leur terreur des elfes noirs ces derniers temps.~
@51465 = ~Attendez, c'est beaucoup trop dangereux. Il doit y avoir un autre moyen.~
@51466 = ~Trouvez-vous un autre larbin. Je vais me débrouiller seul.~ ~Trouvez-vous une autre larbine. Je vais me débrouiller seule.~
@51467 = ~Le temps est venu de leur donner une leçon. La Mère Ardulace vous a désigné pour cette mission.~
@51468 = ~J'ai bien peur que vous n'ayez plus le choix.~
@51469 = ~Tu... tu veux que je tue des svirfnebelins ? Des gnomes ? La plus mineure des tâches, et je dois y consacrer mon temps ? J'ai mieux à faire, femme !~
@51470 = ~Commencez l'incantation, alors.~
@51471 = ~Attendez, c'est beaucoup trop dangereux. Il doit y avoir un autre moyen.~
@51472 = ~Tu as mieux à faire que servir la Reine des Fosses Démoniaques ? Mère Lolth elle-même ?~
@51473 = ~Bah ! Comme si la Reine Araignée se souciait de ce que nous faisons aux gnomes des profondeurs ! Envoie Veldrin, si tu y tiens. Je t'assure qu'il s'en sortira très bien sans moi !~ ~Bah ! Comme si la Reine Araignée se souciait de ce que nous faisons aux gnomes des profondeurs ! Envoie Veldrin, si tu y tiens. Je t'assure qu'elle s'en sortira très bien sans moi !~
@51474 = ~Oui, au travail.~
@51475 = ~Non. Tu iras avec Veldrin. Un mot de plus et je te coupe la langue, Solaufein !~
@51476 = ~Approchez le village svirfnebelin des grandes cavernes et attendez une patrouille. Massacrez-les... Et ramenez-nous des preuves. Revenez dans quelques jours.~
@51477 = ~Mes compagnons, prenez <CHARNAME> et tuez tous les autres. Ils ne valent rien. <CHARNAME> doit être pris vivant ! Allez !~ ~Mes compagnons, prenez <CHARNAME> et tuez tous les autres. Ils ne valent rien. <CHARNAME> doit être prise vivante ! Allez !~
@51478 = ~Voilà qui est fait. Vous êtes maintenant des elfes noirs, et votre blason devrait vous permettre de vous fondre dans le décor. N'oubliez pas : vous êtes des elfes noirs. Je vous conseille de vous comporter comme tel lors de vos échanges avec les personnes que vous rencontrerez.~ [SILVER07]
@51479 = ~L'illusion durera autant de temps que nécessaire. La magie serait rompue lorsque vous quitterez la cité par le portail principal et atteindrez la surface. Vous serez alors seul contre tous.~ ~L'illusion durera autant de temps que nécessaire. La magie serait rompue lorsque vous quitterez la cité par le portail principal et atteindrez la surface. Vous serez alors seule contre tous.~
@51480 = ~Si c'est la volonté de la Matrone, je n'ai pas le choix. Je vais y aller maintenant. Veldrin, rejoins-moi vite... Je t'attends, ne tarde pas.~
@51481 = ~Mais... quel mal les gnomes des profondeurs ont-ils pu faire ? Ils sont inoffensifs, vraiment, ce ne sont que des mineurs et autres gens de petite condition. Ils sont peut-être un peu austères, et je n'ai jamais entendu parler d'un amateur de navets chez eux, mais ils ne sont certes pas méchants. Tout cela est-il vraiment nécessaire ?~
@51482 = ~Mais... les gnomes des profondeurs ne sont pas mauvais ! Pourquoi faire cela ?!~
@51483 = ~Les gnomes des profondeurs ne sont pas une menace pour l'elfe noir... ils sont inoffensifs et neutres. Des mesures aussi sévères ne sont sûrement pas nécessaires pour leur instiller la peur que vous voulez inspirer !~ ~Les gnomes des profondeurs ne sont pas une menace pour l'elfe noire... ils sont inoffensifs et neutres. Des mesures aussi sévères ne sont sûrement pas nécessaires pour leur instiller la peur que vous voulez inspirer !~
@51484 = ~Mais... les svirfnebelins ne sont pas méchants ! Ce... ce ne sont que des petits gnomes inoffensifs ! Pourquoi doit-on faire une telle chose ?~
@51485 = ~Sentiment étrange, pour des elfes noirs. Que proposez-vous ? Les épargner ? Qu'en penseraient nos vrais ennemis ? Vous devez m'obéir, sans discuter !~
@51486 = ~Pardon, mais je dois protéger mes propres intérêts. Une fois que j'aurai récupéré mes œufs, mon influence vous permettra de fuir en toute sécurité.~
@51487 = ~Je ferai mon possible, Adalon.~
@51488 = ~Tant que vous respectez notre engagement, je serai satisfait.~ ~Tant que vous respectez notre engagement, je serai satisfaite.~
@51489 = ~Ahh, maintenant que je suis transformé en drow, je n'ai plus besoin de vous !~ ~Ahh, maintenant que je suis transformée en drow, je n'ai plus besoin de vous !~
@51490 = ~Merci. N'oubliez pas, vous venez de la cité de Ched Nasad. Prenez aussi un nom drow, « Veldrin » est très commun.~
@51491 = ~Vous arpentez un chemin dangereux ! Ne me tentez pas alors que je suis sur le point de perdre tout ce qui m'est précieux !~
@51492 = ~Vous venez de la cité de Ched Nasad ! Votre nom drow est... « Veldrin », c'est très commun ! Faites ce que je vous dis !~
@51493 = ~Vous êtes de retour !~
@51494 = ~Alors comme ça, j'pue le poisson ? Au large ! Fiche-moi le camp !~ [FEMSAL04]
@51495 = ~Je vous suggère d'aller retrouver Solaufein au village svirfnebelin, au nord-ouest de la caverne. Et vite ! Aucun retard ne sera toléré.~
@51496 = ~Te voilà enfin. Nous allons attendre ici que la patrouille vienne à nous. Elle ne tardera pas, je pense, et alors, nous pourrons en finir.~
@51497 = ~Très bien. Attendons qu'elle arrive.~
@51498 = ~Très bien ! Je suis impatient... ce sera facile.~ ~Très bien ! Je suis impatiente... ce sera facile.~
@51499 = ~Je peux me débrouiller, Solaufein, si vous préférez rentrer en ville.~
@51500 = ~Je peux me débrouiller, Solaufein, si vous préférez rentrer en ville.~
@51501 = ~*soupire* Ce ne sera pas long. Prépare-toi, et ne fait pas de sottises.~
@51502 = ~Hmpf. Tu attends cela avec impatience ? Les gnomes des profondeurs sont faibles, c'est une tâche trop facile. C'est presque indigne de moi que d'être ici.~
@51503 = ~Finissons-en vite.~
@51504 = ~Si vous ne voulez pas être là, partez donc. Je me charge du reste.~
@51505 = ~Si vous ne voulez pas être là, partez donc. Je me charge du reste.~
@51506 = ~Toutes les occasions de démontrer la supériorité des elfes noirs doivent être chéries. Si vous pensez le contraire, vous êtes faible.~
@51507 = ~Hmmm... Je vais peut-être accepter ta proposition. Phaere aime me faire danser, et je n'ai aucune envie de lui obéir. Es-tu sûr d'être à la hauteur ?~ ~Hmmm... Je vais peut-être accepter ta proposition. Phaere aime me faire danser, et je n'ai aucune envie de lui obéir. Es-tu sûre d'être à la hauteur ?~
@51508 = ~Oui, bien entendu.~
@51509 = ~J'ai peut-être parlé trop vite. Finissons-en.~
@51510 = ~*renâcle* Te laisser t'occuper seul des gnomes des profondeurs ? Je te connais, tu vas gaffer, te perdre ou pire. Pourquoi ferais-je une chose pareille ?~ ~*renâcle* Te laisser t'occuper seule des gnomes des profondeurs ? Je te connais, tu vas gaffer, te perdre ou pire. Pourquoi ferais-je une chose pareille ?~
@51511 = ~Très bien. Finissons-en vite.~
@51512 = ~Je me suis bien battu contre les illithids et un tyrannœil... Je peux me charger des svirfnebelins.~ ~Je me suis bien battue contre les illithids et un tyrannœil... Je peux me charger des svirfnebelins.~
@51513 = ~Je me suis bien battu contre les illithids et un tyrannœil... Je peux me charger des svirfnebelins.~ ~Je me suis bien battue contre les illithids et un tyrannœil... Je peux me charger des svirfnebelins.~
@51514 = ~Je peux me charger des gnomes des profondeurs. Mais si vous préférez danser au son de la musique de Phaere, c'est votre choix.~
@51515 = ~Idiot, cela prouve juste que les Matrones ont soif de sang. Quoique je suis certain que cela plaise fort à la Reine Araignée.~ ~Idiote, cela prouve juste que les Matrones ont soif de sang. Quoique je suis certain que cela plaise fort à la Reine Araignée.~
@51516 = ~Très bien, je m'en vais. Lorsque ce sera fait, prends le heaume de leur chef et rentre à la taverne d'Ust Natha... Je t'y attendrai. N'échoue pas, Veldrin.~
@51517 = ~Viens à moi... Kurtulmak trouve le foyer dans le cristal...~
@51518 = ~Les gnomes des profondeurs sont plus rusés que tu ne le crois. Et si tu échoues, j'échoue. Je ne veux pas finir sur l'autel à cause de ton incompétence !~
@51519 = ~C'est fait. Pfeh. Je rentre en ville, maintenant. Veldrin, trouve le heaume de leur chef. Prends-le et reviens au plus vite à la taverne. Nous nous retrouverons là-bas.~
@51520 = ~Seul le bâtisseur peut passer. Sa main seule ouvrira le chemin une fois que le pouvoir sera recentré.~
@51521 = ~Maintenant il est sous mon... influence et je contrôle cet endroit. C'est un chef-d'œuvre de folie, que vous finirez inévitablement par connaître.~
@51522 = ~Quoi ? Si vous avez vraiment tué la patrouille, où sont les preuves ? Où est le casque du chef ?! Retournez le chercher, idiot ! Je n'accepterai pas d'autres retards !~ ~Quoi ? Si vous avez vraiment tué la patrouille, où sont les preuves ? Où est le casque du chef ?! Retournez le chercher, idiote ! Je n'accepterai pas d'autres retards !~
@51523 = ~Ahhh... vous voilà, et avec le casque svirfnebelin, pas moins ! Bien ! Je suis sûre que ces gnomes sont en train de se dépêcher d'envoyer des présents à la Mère Matrone, au moment même où je vous parle !~
@51524 = ~Donne ce heaume à Phaere, et finissons-en. Si nous avons de la chance, la Matrone n'aura pas d'autre travail à nous donner.~
@51525 = ~Hmmf. Ah oui, je suis sûr que ta ruse et ta cruauté ont considérablement impressionné les gnomes. Je suis sûr qu'ils ne se doutaient absolument pas que nous étions capables d'être rusés et cruels.~
@51526 = ~Quoi ? Es-tu en train de perdre ton goût pour le sang, Solaufein ? La Reine Araignée n'aimerait pas entendre ça...~
@51527 = ~Je garde ma hargne pour les vrais ennemis des elfes noirs. Lolth le sait, tout comme la Matrone de ma propre Maison.~
@51528 = ~Ce n'est pas à toi d'en décider, mâle ! Si tu continues, je t'arracherai le cœur sur l'autel de mes mains !~
@51529 = ~Tu bluffes, chienne arrogante. Si tu agis, tu risques de déclencher une guerre entre nos Maisons. Qu'en penserait Mère Ardulace, à ton avis ?~
@51530 = ~Cela mériterait presque d'être fait ! Si ça pouvait te faire taire ! Si une Vestale t'entendait parler ainsi, elle te fouetterait sur l'instant !~
@51531 = ~Tu devrais être aussi chanceuse, chienne Despana.~
@51532 = ~Bah ! Assez ! Veldrin ! Rejoignez-moi dans mes quartiers de la tour de la Société des Combattantes. Dans une heure, Veldrin... et ne SOYEZ pas en retard !~
@51533 = ~Très bien, j'y serai.~
@51534 = ~Pourquoi ? Pourquoi dans vos quartiers privés ?~
@51535 = ~Phaere, j'ai d'autres choses à faire...~
@51536 = ~Bon. Toi, Solaufein, tu attends que les Mères Matrones te trouvent une autre mission. Puisses-tu y trouver une mort horrible, pauvre ver de terre !~
@51537 = ~Parce que j'ai besoin d'intimité, idiot ! Si vous ne venez pas, je vous y ferai traîner par des crochets !~ ~Parce que j'ai besoin d'intimité, idiote ! Si vous ne venez pas, je vous y ferai traîner par des crochets !~
@51538 = ~Ne me vexez pas, mâle ! Je n'hésiterai pas à vous sacrifier sur l'autel de Lolth ! Une heure, Veldrin... ou votre agonie fera faire des cauchemars aux esclaves pendant tout le mois prochain !~ ~Ne me vexez pas, femelle ! Je n'hésiterai pas à vous sacrifier sur l'autel de Lolth ! Une heure, Veldrin... ou votre agonie fera faire des cauchemars aux esclaves pendant tout le mois prochain !~
@51539 = ~Si tu es un vampire de sa création, alors nous sommes là pour te tuer !~
@51540 = ~Elle m'a condamné à rester enfermé ici. Nous devrions trouver ensemble un moyen de nous échapper !~ ~Elle m'a condamnée à rester enfermée ici. Nous devrions trouver ensemble un moyen de nous échapper !~
@51541 = ~Ah, oui ! Elle... nous envoie te détruire ! Maintenant indique le chemin par lequel tu comptais t'échapper !~
@51542 = ~Parchemin de façonnage de la pierre~
@51543 = ~Elle n'est pas venue elle-même ? Encore une insulte à mon génie ! Elle m'enferme, prend ma création, et maintenant elle ne m'expédie pas elle-même !~
@51544 = ~Nous nous battrons dans cet endroit que j'ai créé et il restera toujours muré ! Si je n'ai pas le contrôle alors personne ne l'aura ! Seule ma main peut ouvrir le chemin !~
@51545 = ~Ha HA ! J'ai enlevé le cristal qui concentre la magie de la porte ! Je l'ai jeté sur une pile d'ordures ! Les kobolds l'ont pris maintenant. Ils le vénèrent, ces idiots ! Vous ne pourrez pas sortir ! Vous mourrez de faim ici ! Vous mourrez !~
@51546 = ~Je n'ai pas envie de parler. Je veux juste rester ici et me noyer dans l'hydromel noir jusqu'à ce que j'ai tout oublié de cette sorcière.~
@51547 = ~*n'utilisez pas le Parchemin de façonnage de la pierre tant que le démon n'est pas vaincu*~
@51548 = ~Drow, od golver d'tanyon ! Da sugden os tera !~
@51549 = ~*vous utilisez le Parchemin de façonnage de la pierre pour sceller le puits... en quelques instants, la caverne reprend son apparence d'origine, avant d'être minée par les gnomes svirfnebelins*~
@51550 = ~Alerte ! De ston fall duth nada !~
@51551 = ~Vous êtes fou ! M'écoutez-vous au moins, ou voulez-vous seulement vous battre avec n'importe qui ?~
@51552 = ~Mais par les dieux, comment sort-on d'ici ?~
@51553 = ~Wird os gnassen vist ! Drow od mird Lolth !~
@51554 = ~Vous n'êtes pas tombé sur un morceau d'équipement « perdu », par hasard ? Qui aurait appartenu à un magicien ?~
@51555 = ~Je suis désolé, mais je ne comprends pas votre langue.~ ~Je suis désolée, mais je ne comprends pas votre langue.~
@51556 = ~Prépare-toi à mourir, vermine de svirfnebelin !~
@51557 = ~Ah... Je pensais beaucoup elfes noirs connaître simple langue de la pierre. Alors, moi parler langue des ténébreux, oui ?~
@51558 = ~Nous saluons vous, ténébreux. Et demandons votre raison pour être dans cette place. La paix vous respectez ?~
@51559 = ~On trouve bien des choses dans les tunnels, oh oui. Et ramasser ce qui est tombé des mains d'un mort n'a rien de mal.~
@51560 = ~Nous saluons vous, ténébreux. Nous venons de beaucoup grand village des gnomes profonds. Avons entendu beaucoup de morts en ce moment. Très mauvais. Que vous faire ici ?~
@51561 = ~Eh bien, ce magicien n'est plus mort. Et il aimerait récupérer son Livre de Rituels.~
@51562 = ~C'est comme ça que vous appelez le fait de dépouiller un cadavre encore tiède ?~
@51563 = ~Je ne vous reproche pas d'être des détrousseurs de cadavres. Je veux juste récupérer son livre.~
@51564 = ~Non. Je suis là pour vous massacrer, imbéciles. Préparez-vous à mourir !~
@51565 = ~Les elfes noirs m'envoient pour tuer votre patrouille... mais je ne veux pas le faire.~
@51566 = ~Oui. Je suis en reconnaissance aux alentours. Je vais m'en aller.~
@51567 = ~Il n'est plus mort ? Eh bien, c'est la guérison du siècle. Vous pouvez avoir son livre, mais je demande une prime de sauvetage.~
@51568 = ~*ce puits obscur vous procure une sensation de malaise*~
@51569 = ~*les ténèbres vous submergent... et vous sentez une autre présence*~
@51570 = ~Je suis là pour vous massacrer, imbéciles. Préparez-vous à mourir !~
@51571 = ~Les elfes noirs m'envoient pour tuer votre patrouille... mais je ne veux pas le faire.~
@51572 = ~Oui. Je suis en reconnaissance aux alentours. Je vais m'en aller.~
@51573 = ~C'est très terrible ! Pourquoi les ténébreux vouloir nous tuer ? Nous est en paix !~
@51574 = ~Ils pensent que vous ne les craignez pas assez, et ils veulent vous envoyer un message, à vous et à leurs autres ennemis.~
@51575 = ~Je ne sais vraiment pas.~
@51576 = ~En fait, j'ai changé d'avis. J'ai été envoyé pour vous tuer, alors autant le faire, juste pour être tranquille après.~ ~En fait, j'ai changé d'avis. J'ai été envoyée pour vous tuer, alors autant le faire, juste pour être tranquille après.~
@51577 = ~Cela est bien. La paix accompagner vous, ténébreux.~
@51578 = ~Nous déjà très craindre ténébreux ! Toujours pouvoir nous tuer, s'ils veulent ! Reconnaissants nous sommes pour votre pitié !~
@51579 = ~J'ai besoin d'une preuve qui montre que j'ai obéi aux ordres. Je peux prendre votre heaume ?~
@51580 = ~Mon heaume ? Si ça sauver vie à moi, oui... le voilà. Nous partir, maintenant, et dire aux seigneurs profonds que devoir beaucoup ramper et faire beaucoup courbettes aux ténébreux, pour guerre pas éclater.~
@51581 = ~Mercier vous pour votre pitié. Puisse le Frère Profond sourire gentiment à vous, toujours.~
@51582 = ~Vous revenir, ténébreux ? Que gnomes profonds pouvoir faire pour vous ?~
@51583 = ~Tu peux mourir, svirfnebelin !~
@51584 = ~Les elfes noirs m'envoient pour tuer votre patrouille... mais je ne veux pas le faire.~
@51585 = ~En fait, j'ai besoin de votre heaume.~
@51586 = ~Rien du tout. Je vais à présent te quitter.~
@51587 = ~Oui. Je, euh... j'ai besoin de votre heaume, en fait.~
@51588 = ~Oui. Je, euh... j'ai besoin de votre heaume, en fait.~
@51589 = ~Mon heaume partie de mon uniforme est. Le donner, je ne peux pas. Pourquoi vouloir mon heaume, ténébreux ?~ ~Mon heaume partie de mon uniforme est. Le donner, je ne peux pas. Pourquoi vouloir mon heaume, ténébreuse ?~
@51590 = ~J'en ai besoin pour prouver aux elfes noirs que j'ai exterminé votre patrouille... ce que je ne veux pas faire.~
@51591 = ~Je ne peux pas vous le dire... mais c'est très important. Pour vous comme pour moi.~
@51592 = ~Je ne peux pas vous le dire... mais c'est très important. Pour vous comme pour moi.~
@51593 = ~Et pour 100 pièces d'or ? Vous le vendriez ?~
@51594 = ~Oh, la barbe. Votre heure a sonné, je suppose.~
@51595 = ~Pour ténébreux, vous très digne confiance. Très bien... être juste heaume, et politique personnelle être quand ténébreux demande gentiment, donner heaume et courir, oui ?~ ~Pour ténébreuse, vous très digne confiance. Très bien... être juste heaume, et politique personnelle être quand ténébreuse demande gentiment, donner heaume et courir, oui ?~
@51596 = ~Nous partir en patrouille, maintenant, avant que vous demander aussi peut-être chaussures et chaussettes svirfnebelines. Portez-vous bien, ténébreux.~ ~Nous partir en patrouille, maintenant, avant que vous demander aussi peut-être chaussures et chaussettes svirfnebelines. Portez-vous bien, ténébreuse.~
@51597 = ~Il ne restait même plus de corps ! Je n'ai détroussé personne ! Presque tout était détruit, de toute façon ! Si vous y tenez, je vous donnerai son livre... en échange d'une petite prime.~
@51598 = ~Heaume pas important, vraiment, mais à moi. Juste le donner je ne peux pas. Demande confusionnante vous faites, ténébreux.~ ~Heaume pas important, vraiment, mais à moi. Juste le donner je ne peux pas. Demande confusionnante vous faites, ténébreuse.~
@51599 = ~C'est tout ? Pas de problème, vous pouvez récupérer ce petit paquet de feuilles... en échange d'une petite prime, vous voyez.~
@51600 = ~Je l'ai rangé à part, à l'écart de mes autres affaires. C'est une lecture intéressante. 300 pièces d'or, est-ce trop demander ?~
@51601 = ~J'en ai besoin pour prouver aux elfes noirs que j'ai exterminé votre patrouille... ce que je ne veux pas faire.~
@51602 = ~Tu me donne ton heaume ou je te bute, gnome stupide !~
@51603 = ~Très bien. Et si j'en offre 100 pièces d'or ?~
@51604 = ~Tu as eu ta chance, gnome. C'est l'heure de mourir.~
@51605 = ~Je suis revenu pour chercher le livre des rituels de ce magicien.~ ~Je suis revenue pour chercher le livre des rituels de ce magicien.~
@51606 = ~Hmm. Gnomes avoir proverbe : « les heaumes, ça va, ça vient ». Mais proverbe pas ajouter « pour autant d'or ». Le voilà, bizarre ténébreux.~ ~Hmm. Gnomes avoir proverbe : « les heaumes, ça va, ça vient ». Mais proverbe pas ajouter « pour autant d'or ». Le voilà, bizarre ténébreuse.~
@51607 = ~Casque de chef de patrouille~
@51608 = ~Casque de chef de patrouille~
@51609 = ~Alors, vous avez les 300 pièces d'or ?~
@51610 = ~Les voilà.~
@51611 = ~Non.~
@51612 = ~Très bien. Prenez les 300 pièces d'or.~
@51613 = ~Pas question, c'est hors de prix.~
@51614 = ~Errr... pas en colère vous mettre, ténébreux. Si vous vouloir heaume autant, supposer moi mieux vivant que mort. Dicton gnome dire : « les heaumes, ça va, ça vient ».~ ~Errr... pas en colère vous mettre, ténébreuse. Si vous vouloir heaume autant, supposer moi mieux vivant que mort. Dicton gnome dire : « les heaumes, ça va, ça vient ».~
@51615 = ~Sang du prince kuo-toa~
@51616 = ~Je vous salue, mon ami. Qu'est-ce qui vous amène par ici ?~ ~Je vous salue, mon amie. Qu'est-ce qui vous amène par ici ?~
@51617 = ~Alors, nous n'avons rien à discuter. Je vous souhaite de bons tunnels.~
@51618 = ~L'attrait de l'aventure, messire.~
@51619 = ~Sang du prince kuo-toa~
@51620 = ~Alors, marché conclu. Je vous remercie de votre visite, cher client.~ ~Alors, marché conclu. Je vous remercie de votre visite, chère cliente.~
@51621 = ~Rien qui vous regarde.~
@51622 = ~Attendez... votre tête me dit quelque chose. Vous ne seriez pas le fameux <CHARNAME>, par hasard ? À vrai dire, cher <PRO_SIRMAAM>, vos exploits sont célébrés à travers toute la Côte des Épées.~ ~Attendez... votre tête me dit quelque chose. Vous ne seriez pas la fameuse <CHARNAME>, par hasard ? À vrai dire, chère <PRO_SIRMAAM>, vos exploits sont célébrés à travers toute la Côte des Épées.~
@51623 = ~Œil d'un orbe ancien~
@51624 = ~Vous n'êtes pas tombé sur un morceau d'équipement « perdu », par hasard ? Qui aurait appartenu à un magicien ?~
@51625 = ~Œil d'un orbe ancien~
@51626 = ~Euh, oui... je l'ai... vous y tenez ? Alors, vous voudrez peut-être me l'acheter... euh... non, non, je vous l'offre. Un cadeau, pour améliorer nos relations, voilà.~
@51627 = ~Vous avez de la chance que je sois de bonne humeur, mâle. J'aimais bien l'idée de vous torturer pour mon divertissement, mais ce caprice s'est évanoui !~ ~Vous avez de la chance que je sois de bonne humeur, femelle. J'aimais bien l'idée de vous torturer pour mon divertissement, mais ce caprice s'est évanoui !~
@51628 = ~Effectivement, je suis <CHARNAME>. Alors vous avez entendu parler de moi ?~
@51629 = ~Vous avez réussi ! Je vois que vous avez sur vous mes merveilleux œufs. Donnez-les moi et je vous donnerai votre récompense.~
@51630 = ~Vous vous trompez, l'ami. Je ne suis pas ce <CHARNAME> dont vous parlez.~ ~Vous vous trompez, l'ami. Je ne suis pas cette <CHARNAME> dont vous parlez.~
@51631 = ~Vous vous trompez, l'ami. Je ne suis pas ce <CHARNAME> dont vous parlez.~ ~Vous vous trompez, l'ami. Je ne suis pas cette <CHARNAME> dont vous parlez.~
@51632 = ~Que cela vous soit utile dans le futur. Ahh, je vous ai aussi promis de fuir en toute sécurité, n'est-ce pas ? Et de vous mener près de Bodhi et d'Irenicus ?~
@51633 = ~Je vais vous y conduire et vous regarder partir en toute sécurité. Il est vrai que vous auriez pu y aller seul, mais cela aurait été plus sanglant.~ ~Je vais vous y conduire et vous regarder partir en toute sécurité. Il est vrai que vous auriez pu y aller seule, mais cela aurait été plus sanglant.~
@51634 = ~Ce fut un honneur de vous servir. Je présume que les elfes noirs vont être punis maintenant ?~
@51635 = ~Je suis très content que ce supplice soit terminé ; je peux maintenant remonter à la surface.~ ~Je suis très contente que ce supplice soit terminé ; je peux maintenant remonter à la surface.~
@51636 = ~Seuls les objets m'intéressaient. Vous n'avez servi à rien. Allons-y maintenant, vite.~
@51637 = ~Non, les elfes qu'ils affrontent leur donneront ce qu'ils méritent. Je refuse de continuer à garder cet enfer dans lequel la paix est impossible.~
@51638 = ~Ma dernière action ici sera peut-être quelques morts sélectives, pour donner une leçon à ceux qui sont responsables de mes querelles. Ils comprendront qu'il faut me laisser tranquille.~
@51639 = ~Je verrai cela plus tard. Tout d'abord je vous aide, comme promis, mes problèmes viennent après. Avant de vous conduire vers la surface, je dois prendre une forme plus appropriée.~
@51640 = ~Oh oui, <CHARNAME> ! Nous avons entendu parlez de vous. En fait, on nous a envoyés pour... nous occuper de vous.~
@51641 = ~Bien que mon devoir s'achève, je suis soulagée que tout soit terminé. Je refuse de continuer à garder cet enfer dans lequel la paix est impossible.~
@51642 = ~Oui, c'est pour cela que j'ai décidé de partir. Je refuse de continuer à garder cet enfer dans lequel la paix est impossible.~
@51643 = ~Quelle impertinence de venir jusqu'ici ! Où trouvez-vous le courage de vous présenter à moi, alors que mes œufs sont anéantis ?! Je sais qu'ils sont morts, je le sens !~
@51644 = ~Vous serez le premier à subir ma colère ! Toute participation à ce crime sera punie, mais votre défaite fait de vous le premier !~ ~Vous serez la première à subir ma colère ! Toute participation à ce crime sera punie, mais votre défaite fait de vous la première !~
@51645 = ~Que voulez-vous dire ?~
@51646 = ~Redoublez d'efforts. Je ne supporte pas que ces imbéciles possèdent mes œufs ! Je vous demande de reprendre l'illusion que nous avons concoctée.~
@51647 = ~Vous êtes Veldrin de la cité drow de Ched Nasad. Vous cherchez un refuge et voulez les aider à combattre les elfes de la surface. Maintenant, allez-y !~
@51648 = ~Vous pouvez frapper à la porte.~
@51649 = ~*les portes massives de la cité des elfes noirs sont fermées aux étrangers... seuls les elfes noirs peuvent pénétrer à l'intérieur de la cité*~
@51650 = ~Vous connaîtrez aussi le langage des elfes noirs, et on comprendra votre discours comme si vous aviez toujours parlé cette langue.~
@51651 = ~*les portes s'ouvrent*~
@51652 = ~Vous... vous êtes un incapable. Malgré l'illusion, qui était parfaite, vous avez réussi à élever toute la cité contre vous. Il n'y a plus rien à faire.~ ~Vous... vous êtes une incapable. Malgré l'illusion, qui était parfaite, vous avez réussi à élever toute la cité contre vous. Il n'y a plus rien à faire.~
@51653 = ~Je ne sais plus quoi faire, et seul un massacre vous attend. C'est écœurant mais il n'y a plus rien à faire. Partez.~
@51654 = ~Nous en avons terminé. Laissez-moi maintenant, j'ai besoin de paix. Et je vais la faire régner.~ [SILVER09]
@51655 = ~Les intrus dont la présence est injustifiée ici seront tués sur place ! Fais connaître tes intentions !~
@51656 = ~La main du bâtisseur ouvrira le chemin, mais le centre du pouvoir doit d'abord être rétabli.~
@51657 = ~Le centre du pouvoir peut être rétabli, mais seule la main du bâtisseur pourra ouvrir le passage.~
@51658 = ~Le centre du pouvoir peut maintenant être rétabli, et la main du bâtisseur ouvre le passage. La voie est libre.~
@51659 = ~Je travaille seul ici contre tout ce qui se présente ! J'ai scellé la sortie, et seule ma main peut ouvrir ce qui est maintenant fermé !~
@51660 = ~Ha ! Un brigand déguisé !~
@51661 = ~Non, je suis certain que vous êtes <CHARNAME>. On nous a envoyés pour... nous occuper de vous.~
@51662 = ~Ne soyez pas si nerveux, idiot ! Si j'avais besoin de vous pour ce que vous croyez, vous seriez déjà nu et ruisselant de sueur ! Non, j'ai besoin de vous pour autre chose...~ ~Ne soyez pas si nerveuse, idiote ! Si j'avais besoin de vous pour ce que vous croyez, vous seriez déjà nue et ruisselante de sueur ! Non, j'ai besoin de vous pour autre chose...~
@51663 = ~Que voulez-vous dire ?~
@51664 = ~Ha ! Un brigand déguisé !~
@51665 = ~Vous êtes au courant de ma relation avec Solaufein, n'est-ce pas ? Arrêtez de me regarder avec cet air stupide ! Notre animosité est évidente.~
@51666 = ~Son insolence dépasse les bornes. Je ne peux pas me permettre de la tolérer plus longtemps sans risquer de perdre ma position dans la hiérarchie de Lolth.~
@51667 = ~Mais, d'un autre côté, je ne peux pas prendre d'initiative qui remonterait jusqu'à moi ou ma Maison sans risquer la guerre. Alors, vous allez agir pour moi ! Vous tuerez Solaufein !~
@51668 = ~Quoi ? Mais je ne peux pas faire ça !~
@51669 = ~Et quelle serait ma récompense ?~
@51670 = ~Et comment pourrais-je faire ?~
@51671 = ~Vous pouvez, et vous le devez ! Vous aimez le sang, Veldrin, ne le niez pas ! Et que devez-vous à Solaufein ? Rien. À moins qu'une morale stupide ne vous retienne ?~
@51672 = ~Votre récompense sera la vie et ma gratitude. Vous accomplirez cette mission, parce que je vous l'ordonne... ou vous souffrirez mille morts !~
@51673 = ~Nous sommes des elfes noirs, et nous ne montrons aucune pitié. Mon heure approche, et il est hors de question qu'un vermisseau vienne me distraire.~
@51674 = ~Solaufein a quartier libre... Vous le trouverez dans ses appartements, à la Société des Combattants, en train de bouder comme il en a l'habitude.~
@51675 = ~Il ne s'attendra pas à vous voir... mais il ne se doutera de rien. Il vous accueillera, et vous le tuerez !~
@51676 = ~*lorsque vous lancez le sort, sa puissante magie libère un mage emprisonné dans les profondeurs de la terre*~
@51677 = ~Les membres de ma Maison seront les premiers à être interrogés... mais vous n'êtes pas apparenté à une Maison spécifique, vous pourrez vous en sortir indemne.~ ~Les membres de ma Maison seront les premiers à être interrogés... mais vous n'êtes pas apparentée à une Maison spécifique, vous pourrez vous en sortir indemne.~
@51678 = ~Quand vous aurez terminé, prenez sa... hmmm... sa cape piwafwi et ramenez-la-moi. Elle fera un excellent trophée.~
@51679 = ~Voilà ! Avez-vous compris ce que j'attendais de vous, Veldrin ? Si vous en parlez, c'est la mort pour vous. Je garderais bien ma langue, si j'étais vous...~
@51680 = ~Je comprends... rien qu'à l'idée de tuer cette bravache, mon sang ne fait qu'un tour !~
@51681 = ~Je suppose que je n'ai guère le choix...~
@51682 = ~Non, c'est hors de question !~
@51683 = ~Quel plaisir de voir un elfe noir avec de l'ambition ! Continuez sur cette voie, Veldrin, et vous ferez de grandes choses à Ust Natha !~ ~Quel plaisir de voir une elfe noire avec de l'ambition ! Continuez sur cette voie, Veldrin, et vous ferez de grandes choses à Ust Natha !~
@51684 = ~C'est vrai, mais est-ce si grave ? Allons, Veldrin, à Ched Nasad, aviez-vous les faveurs de l'aînée d'une Maison, et de grandes perspectives d'avenir ? Je ne crois pas !~
@51685 = ~Allez. Vous avez trois jours pour retrouver Solaufein et me ramener sa cape. Ne me décevez pas, Veldrin !~
@51686 = ~Je vois. Voulez-vous vraiment risquer votre vie pour épargner ce rat ? Je vais faire comme si je n'avais pas entendu votre première réponse... Allez-vous tuer Solaufein ?~
@51687 = ~Très bien. Je n'ai donc pas le choix...~
@51688 = ~Non ! C'est hors de question !~
@51689 = ~Vous osez ? Vous êtes un fou, Veldrin... vous venez de perdre mes faveurs ! Vos entrailles pourriront accrochées au plafond de la caverne quand j'en aurai fini avec vous !~ ~Vous osez ? Vous êtes une folle, Veldrin... vous venez de perdre mes faveurs ! Vos entrailles pourriront accrochées au plafond de la caverne quand j'en aurai fini avec vous !~
@51690 = ~Si je voulais vous parler, <MALEFEMALE>, j'aurais demandé à vous voir ! C'est à Veldrin que j'ai demandé de venir, et c'est à lui et à lui seul que je parlerai !~ ~Si je voulais vous parler, <MALEFEMALE>, j'aurais demandé à vous voir ! C'est à Veldrin que j'ai demandé de venir, et c'est à elle et à elle seule que je parlerai !~
@51691 = ~*lorsque vous placez le dernier objet dans sa statue, le coffre au centre de la salle s'ouvre en trombe... il semble contenir quelque chose qui n'y était pas auparavant*~
@51692 = ~Veldrin ? Que fais-tu là ? Les Matrones ne m'ont pas déjà choisi une nouvelle tâche, hein ? On m'avait donné la permission de me reposer !~
@51693 = ~Non, Solaufein. Je suis ici pour te tuer. C'est l'heure de mourir, imbécile.~
@51694 = ~Je suis désolé, Solaufein... Je n'ai pas le choix. Il faut que je te tue.~ ~Je suis désolée, Solaufein... Je n'ai pas le choix. Il faut que je te tue.~
@51695 = ~Solaufein, Phaere m'envoie te tuer. Mais je ne vais pas le faire.~
@51696 = ~Ah... elle agit enfin, hein ? Il fallait que cela se termine comme ça. Eh bien, petit pleurnichard, je ne serai pas une cible facile !~ ~Ah... elle agit enfin, hein ? Il fallait que cela se termine comme ça. Eh bien, petite pleurnicharde, je ne serai pas une cible facile !~
@51697 = ~Ah... c'était juste une question de temps. Elle et moi étions... amants, mais la Matrone a compris qu'elle tenait trop à moi, trop pour la Reine Araignée.~
@51698 = ~Elles l'ont torturée avec les bâtonnets à tentacules... Je frémis rien que d'y penser. Lorsque les Vestales en eurent terminé avec elle, il ne restait plus que son ambition.~
@51699 = ~Et moi... j'étais juste un rappel de sa faiblesse. Très bien. Il faut que cela se termine ainsi, je l'accepte. Mais Solaufein ne disparaîtra pas en silence !~
@51700 = ~Attends ! Nous n'avons pas à le faire !~
@51701 = ~Alors, finissons-en.~
@51702 = ~Je vois. Ce n'était qu'une question de temps avant qu'elle agisse, je suppose. Aucune alliance avec une autre Maison ne pouvait empêcher ce poignard invisible de plonger dans mon dos.~
@51703 = ~Phaere et moi avons été... amants. Mère Ardulace pensait que Phaere tenait trop à moi, et d'une manière indigne d'une elfe noire. Alors, elle l'a livrée à ses Vestales.~
@51704 = ~« La nuit j'apparais sans que personne ne puisse m'atteindre. Le jour je disparais sans que personne ne m'ait atteint. »~
@51705 = ~Elles l'ont torturée avec leurs bâtonnets à tentacules... des tortures effroyables, à faire frémir. Lorsqu'elles en eurent terminé avec elle, il ne restait de Phaere que son ambition.~
@51706 = ~Et moi... je suis resté un rappel perpétuel de sa faiblesse. *soupire* J'attendais ceci depuis fort longtemps.~
@51707 = ~« Sans début ni fin, je suis le symbole des cycles de la vie. »~
@51708 = ~Bien. Si tu ne veux pas me tuer, que proposes-tu ?~
@51709 = ~Je ne sais pas. Je pense qu'il va falloir que je te tue quand même... je ne vois pas d'autre moyen de m'en sortir.~
@51710 = ~J'ai besoin de ta cape piwafwi pour prouver ta mort à Phaere... mais que vas-tu faire ?~
@51711 = ~Tu peux te joindre à nous, Solaufein... et quitter cet endroit.~
@51712 = ~Qu'il en soit ainsi. Il fallait que cela se termine de cette façon.~
@51713 = ~Tu peux prendre ma cape, il ne me sert pas à grand-chose. Quant à moi, je ne sais pas. Je ne peux pas rester en ville sans mettre vos vies, et la mienne, en danger.~
@51714 = ~Et je ne veux pas la guerre entre ma Maison et les Despana. Je... je n'ai jamais voulu de mal à ceux qui n'étaient pas les véritables ennemis des elfes noirs, les êtres vils et maléfiques.~
@51715 = ~Je... je ne sais pas pourquoi je te dis ça... peut-être parce que tu as eu pitié de moi... Je pense que nous autres elfes noirs avons quitté la vraie voie. Il faudra que l'on nous y ramène.~
@51716 = ~Je chercherai peut-être ceux qui pensent comme moi. Je resterai dans l'ombre, et je ne trahirai pas notre secret, Veldrin.~
@51717 = ~Je te remercie d'avoir fait preuve de pitié. Cela me donne à penser qu'il reste peut-être de l'espoir pour notre peuple. Puisse... puisse Eilistraée, la Dame aux Cheveux d'Argent, veiller toujours sur toi.~
@51718 = ~« Nous sommes inséparables, nous portons de lourdes charges, toute la journée nous sommes ardemment pressés... vides, nous nous reposons, pleines nous travaillons. »~
@51719 = ~Me joindre à vous ? Partir ? Pour où, Ched Nasad ? Non... je sens que ce n'est pas ce que tu veux dire. En fait... en fait, tu n'es pas de là-bas, hein ?~
@51720 = ~« Ici, sur cette terre, vous m'avalez. Pourtant, si j'étais davantage, c'est moi qui vous engloutirais. »~
@51721 = ~Vraiment ? Je me suis peut-être trompé. Passez votre chemin, <PRO_SIRMAAM>. Vous n'êtes pas celui que nous cherchons.~ ~Vraiment ? Je me suis peut-être trompé. Passez votre chemin, <PRO_SIRMAAM>. Vous n'êtes pas celle que nous cherchons.~
@51722 = ~Tu n'es pas un elfe noir. J'aurai peut-être dû m'en douter plus tôt. Qui es-tu ? Pourquoi ce déguisement ?~ ~Tu n'es pas une elfe noire. J'aurai peut-être dû m'en douter plus tôt. Qui es-tu ? Pourquoi ce déguisement ?~
@51723 = ~« J'ai vu se dresser les montagnes. J'ai vu tomber Néthéril. Le vôtre est compté, le mien est intarissable. »~
@51724 = ~Tu n'es pas un elfe noir... j'aurais dû m'en douter plus tôt. Qui es-tu ? Pourquoi ce déguisement ?~ ~Tu n'es pas une elfe noire... j'aurais dû m'en douter plus tôt. Qui es-tu ? Pourquoi ce déguisement ?~
@51725 = ~« Je suis espoir pour ceux qui sont enfermés. Je suis enfer pour ceux qui osent m'approcher. »~
@51726 = ~Votre capture est impérative, <CHARNAME>. Quelqu'un tient absolument à votre présence. C'est le moment.~
@51727 = ~Tu m'as démasqué ? Alors, je me peux pas te laisser vivre. C'est un trop grand risque.~ ~Tu m'as démasquée ? Alors, je me peux pas te laisser vivre. C'est un trop grand risque.~
@51728 = ~Je suis <CHARNAME>, un <PRO_RACE> de la surface. Mais je ne peux pas te dire pourquoi je suis là.~ ~Je suis <CHARNAME>, une <PRO_RACE> de la surface. Mais je ne peux pas te dire pourquoi je suis là.~
@51729 = ~« Je sauverai votre vie, mais par moi vous périrez. Je résoudrai les disputes, mais pas avec des mots. »~
@51730 = ~Je suis <CHARNAME>, un <PRO_RACE> de la surface. J'ai été envoyé ici pour retrouver les œufs du dragon d'argent. Ils ont été volés.~ ~Je suis <CHARNAME>, une <PRO_RACE> de la surface. J'ai été envoyée ici pour retrouver les œufs du dragon d'argent. Ils ont été volés.~
@51731 = ~Je suis désolé, Solaufein, mais je ne peux rien te dire sur mon compte.~ ~Je suis désolée, Solaufein, mais je ne peux rien te dire sur mon compte.~
@51732 = ~« Prononcez mon nom et vous me briserez. »~
@51733 = ~Je vais maintenant passer le portail de feu.~ [VITHAL14]
@51734 = ~« Je dis toujours la vérité et pourtant ne parle pas. Regardez-moi et voyez la réalité. »~
@51735 = ~Je vais maintenant passer le portail de l'air.~ [VITHAL15]
@51736 = ~Mes frères ! Jetez vos sortilèges et mettez fin à cette rencontre.~
@51737 = ~« J'ai deux têtes et un seul corps. Plus je reste immobile, plus je suis rapide. »~
@51738 = ~« Essayez de me vaincre, mais essayez en vain. Quand mon heure vient, à vos souffrances je mets fin. »~
@51739 = ~Un... <PRO_RACE> de la surface ? Cela explique bien des choses, y compris ta pitié. Aucun elfe noir ne se serait comporté ainsi, j'en ai peur. Je ne te trahirai pas, <CHARNAME>.~ ~Une... <PRO_RACE> de la surface ? Cela explique bien des choses, y compris ta pitié. Aucune elfe noire ne se serait comporté ainsi, j'en ai peur. Je ne te trahirai pas, <CHARNAME>.~
@51740 = ~Tu m'as démasqué ? Alors, je me peux pas te laisser vivre. C'est un trop grand risque.~ ~Tu m'as démasquée ? Alors, je me peux pas te laisser vivre. C'est un trop grand risque.~
@51741 = ~Je suis <CHARNAME>, un <PRO_RACE> de la surface. Mais je ne peux pas te dire pourquoi je suis là.~ ~Je suis <CHARNAME>, une <PRO_RACE> de la surface. Mais je ne peux pas te dire pourquoi je suis là.~
@51742 = ~Je suis <CHARNAME>, un <PRO_RACE> de la surface. J'ai été envoyé ici pour retrouver les œufs du dragon d'argent. Ils ont été volés.~ ~Je suis <CHARNAME>, une <PRO_RACE> de la surface. J'ai été envoyée ici pour retrouver les œufs du dragon d'argent. Ils ont été volés.~
@51743 = ~Je suis désolé, Solaufein, mais je ne peux rien te dire sur mon compte.~ ~Je suis désolée, Solaufein, mais je ne peux rien te dire sur mon compte.~
@51744 = ~Je ne peux pas revenir à Ust Natha sans nous mettre tous les deux en danger. Comme tu viens de la surface, je vais te révéler quelque chose que je n'ai dit à personne d'autre...~
@51745 = ~Je ne porte pas la Reine Araignée dans mon cœur. Je vénère la Dame aux Cheveux d'Argent, Eilistraée. Comme elle, je crois que mon peuple a quitté la vraie voie.~
@51746 = ~Je vais rester dans l'ombre, et chercher d'autres dissidents. Il doit y en avoir... j'en suis sûr. Peut-être pourrons-nous sauver mon peuple de lui-même.~
@51747 = ~Nous y voilà ! Le temps presse ! L'avatar n'est pas net ! Le cristal n'est pas prêt !~
@51748 = ~Merci, <CHARNAME>... d'avoir eu pitié. Peut-être un jour irai-je à la surface pour voir la lune de mon Eilistraée... En attendant, adieu.~
@51749 = ~Je sais quelque chose là-dessus. Les Matrones affirment que le grand dragon d'argent qui garde les accès du temple des elfes de la surface ne nous gênera plus.~
@51750 = ~En fait, c'est Mère Ardulace qui l'a annoncé. Je pense qu'elle détient ces œufs... mais j'ignore où ils peuvent être.~
@51751 = ~L'avatar n'a pas pris forme ! Kurtulmak n'est pas prêt !~
@51752 = ~Je vois. Tu m'as rendu un service qu'aucun autre elfe noir ne m'aurait rendu. Je ne te trahirai pas. Je ne peux pas revenir en ville sans nous mettre tous les deux en danger.~
@51753 = ~Et je ne souhaite pas la guerre entre ma Maison et les Despana. Mon peuple s'est... égaré... je crois. Je pourrais peut-être en trouver d'autres qui pensent comme moi.~
@51754 = ~À l'avenir, je t'aiderai si je le peux, surfacin. En attendant ce jour, je te remercie. Jusqu'à ce que la fortune nous remette sur le même chemin, adieu.~ ~À l'avenir, je t'aiderai si je le peux, surfacine. En attendant ce jour, je te remercie. Jusqu'à ce que la fortune nous remette sur le même chemin, adieu.~
@51755 = ~Je ne vous reparlerai pas avant Solaufein que soit mort et que vous ne m'ayez apporté sa cape piwafwi. Allez !~
@51756 = ~Oui, oui, c'est bien, vous voilà de retour... Mais où est Veldrin ? Je souhaite parler à lui et à personne d'autre !~ ~Oui, oui, c'est bien, vous voilà de retour... Mais où est Veldrin ? Je souhaite parler à elle et à personne d'autre !~
@51757 = ~Ah, mon cher Veldrin, vous avez une magnifique cape piwafwi ! Il... Solaufein est mort, n'est-ce pas ? Oui, bien sûr, il... il est mort.~ ~Ah, ma chère Veldrin, vous avez une magnifique cape piwafwi ! Il... Solaufein est mort, n'est-ce pas ? Oui, bien sûr, il... il est mort.~
@51758 = ~Là, donnez-la-moi.~
@51759 = ~« L'amour est stupide. » Vous avez bien agi, Veldrin... vos services vous ont acquis une place d'honneur dans cette Maison. Naturellement, cela ne s'arrêtera pas là !~
@51760 = ~*cet étrange dispositif a une petite fente située sur un panneau magnifiquement gravé... un message est écrit sur une vieille planchette qui a été négligemment glissée dans une fissure dans la machine*~
@51761 = ~Le foyer... Protégez-moi ! Faites-le ou nous serons anéantis encore et encore. Appelez les Gardiens !~
@51762 = ~*le message indique :* « Maître, vos bottes sont bien rapetasemellées. J'ai dépuantisé les semelles. Ce fut une expérience captivante de procéder à cette tâche. Vous êtes, monsieur, un homme de grande distinction... » *la flatterie continue un certain temps*~
@51763 = ~Tout d'abord... je dois vous parler en privé, Veldrin.~
@51764 = ~Médaillon des étoiles~
@51765 = ~Médaillon du soleil~
@51766 = ~Il est temps de vous présenter à la Mère Matrone de la Maison Despana, Veldrin. Mère Ardulace est impatiente de voir le mâle qui a tant fait pour Ust Natha.~ ~Il est temps de vous présenter à la Mère Matrone de la Maison Despana, Veldrin. Mère Ardulace est impatiente de voir la femelle qui a tant fait pour Ust Natha.~
@51767 = ~Médaillon de l'épée~
@51768 = ~Venez me rejoindre, Mère Ardulace et moi, au temple. Ne tardez pas, Veldrin... Mère Ardulace veut vous parler immédiatement.~
@51769 = ~Bandeau doré~
@51770 = ~« Le système de jetonnage a été réglé selon vos spécifications précises. La machine fournira des chaussures de qualité sur insertion de jetons de mithril dans la fente. Subrepticement, Grophinet, votre bouffon. »~
@51771 = ~Vous êtes plein de ressources, Veldrin. Un mâle fort et puissant... digne de ma couche. Vous allez rester ici quelque temps pour me donner du plaisir... Allons !~ ~Vous êtes pleine de ressources, Veldrin. Une femelle forte et puissante... digne de ma couche. Vous allez rester ici quelque temps pour me donner du plaisir... Allons !~
@51772 = ~*vous pouvez actionner la machine en plaçant un nombre approprié de jetons dans la fente... vous devez avoir suffisamment de jetons pour vous en servir... que souhaitez-vous faire ?*~
@51773 = ~*placer 5 jetons dans la fente*~
@51774 = ~*placer 10 jetons dans la fente*~
@51775 = ~Statue d'une ombre~
@51776 = ~*placer 15 jetons dans la fente*~
@51777 = ~L'homme bâillonné~
@51778 = ~*placer 20 jetons dans la fente*~
@51779 = ~Crâne grimaçant~
@51780 = ~Crâne grimaçant~
@51781 = ~Je... je ne peux pas, Phaere.~
@51782 = ~Est-ce vraiment nécessaire ?~
@51783 = ~Je... je suppose que je n'ai pas le choix...~
@51784 = ~Je suis partant !~ ~Je suis partante !~
@51785 = ~Miroir~
@51786 = ~Comment ça « je ne peux pas » ? Je vous l'ordonne ! Cessez de tergiverser !~
@51787 = ~Parce que je n'en ai pas envie !~
@51788 = ~Parce que... « je ne peux pas » !~
@51789 = ~Parce que, euh... je me réserve pour quelqu'un d'autre...~
@51790 = ~Jarre d'eau~
@51791 = ~Jarre d'eau~
@51792 = ~Bon, si c'est un ordre, je n'ai plus qu'à m'exécuter !~
@51793 = ~*avec un léger « PING » la machine fournit une paire de bottes*~
@51794 = ~Cadran solaire~
@51795 = ~Cadran solaire~
@51796 = ~Miroir~
@51797 = ~Sablier~
@51798 = ~Sablier~
@51799 = ~Bien sûr que c'est nécessaire ! Si je l'ordonne, cela devient nécessaire ! Jetez votre armure à terre et approchez. Tout de suite !~
@51800 = ~Non, je ne veux pas.~
@51801 = ~Je ne peux pas, Phaere.~
@51802 = ~Je... je suppose que je n'ai pas le choix...~
@51803 = ~Excellent. Je vais vous montrer, mon sombre amant, pourquoi une nuit avec Phaere vaut bien une éternité avec les autres femmes. Viens... mon sang est en ébullition...~
@51804 = ~Sur le parchemin, vous pouvez lire :

« Prends garde, malade !

Le véritable test de folie est une simple mesure de la précision de l'esprit. Ceux qui sont soignés seront récompensés. Les affligés erreront sans le moindre recours. »~
@51805 = ~Vos désirs ne rentrent pas en ligne de compte, Veldrin ! Repoussez-moi encore une fois, et vous paierez le prix fort, comprenez-vous ? Maintenant... approche, ICI...~
@51806 = ~Note de l'intendant~
@51807 = ~Note de l'intendant~
@51808 = ~Non ! Quoi que vous disiez, je ne ferai rien avec vous !~
@51809 = ~Je... je ne peux pas, Phaere, « vraiment » pas.~
@51810 = ~J'appartiens à... euh... à une autre !~
@51811 = ~Très bien, si je n'ai pas le choix...~
@51812 = ~Vous... vous voulez parler d'un problème physique ? C'est une blague ?~
@51813 = ~Je... j'ai... j'ai prêté serment... à Lolth. Je... je ne peux pas en parler...~
@51814 = ~J'ai juré devant Lolth de rester chaste. Je ne peux pas en dire plus.~
@51815 = ~C'est... c'est une malédiction... que l'on ne peut retirer... Cela m'empêche de devenir... euh... intime...~
@51816 = ~Je suis affligé par une terrible malédiction, Phaere. On ne peut la retirer, j'en ai peur... Il n'y a rien à faire...~ ~Je suis affligée par une terrible malédiction, Phaere. On ne peut la retirer, j'en ai peur... Il n'y a rien à faire...~
@51817 = ~Euh... oui... un problème... Je suis... un eunuque.~
@51818 = ~Ce n'est pas une blague de mauvais goût. Je suis... vraiment... un eunuque.~
@51819 = ~Euhh... en fait, ce n'est peut-être pas physique... mais je ne peux pas...~
@51820 = ~Bon... je suis découvert. Bien... si je n'ai pas le choix...~
@51821 = ~*avec un léger « PING » la machine fournit une paire de bottes*~
@51822 = ~*avec un léger « PING » la machine fournit une paire de bottes*~
@51823 = ~Quoi ? Qui ?~
@51824 = ~Ma compagne, Jaheira.~
@51825 = ~Ma compagne, Aerie.~
@51826 = ~Ma compagne, Viconia.~
@51827 = ~Quelqu'un que vous ne connaissez pas...~
@51828 = ~*lorsque vous touchez le globe, la pièce se remplit d'énergie*~
@51829 = ~*laisser la machine de côté pour le moment et chercher davantage de jetons*~
@51830 = ~Euh... Bon, je suppose que je n'ai pas le choix, c'est ça ?~
@51831 = ~*avec un discordant bruit de ferraille, la machine fournit une armure !*~
@51832 = ~Tu viens de signer ton arrêt de mort, fou impuissant ! Je vais te réduire en poussière !~ ~Tu viens de signer ton arrêt de mort, folle impuissante ! Je vais te réduire en poussière !~
@51833 = ~*la machine n'a rien d'autre à fournir*~
@51834 = ~*ricane* Vous mentez très mal, Veldrin. C'est un jeu, hmm ? Viens vers moi, mon amant de l'ombre... Approche, et je vais le régler, moi, ton « petit problème »...~ ~*ricane* Vous mentez très mal, Veldrin. C'est un jeu, hmm ? Viens vers moi, mon amante de l'ombre... Approche, et je vais le régler, moi, ton « petit problème »...~
@51835 = ~Non. Je ne veux pas !~
@51836 = ~Ce n'est pas un jeu. C'est juste que... j'appartiens à une autre.~ ~Ce n'est pas un jeu. C'est juste que... j'appartiens à un autre.~
@51837 = ~Bon, si je n'ai pas le choix...~
@51838 = ~*soupire* Il faudra résoudre ce problème... Mais nous n'avons pas le temps. Je pensais avoir affaire à un vrai mâle avec toi, Veldrin ! Bon, tant pis...~ ~*soupire* Il faudra résoudre ce problème... Mais nous n'avons pas le temps. Je pensais avoir affaire à une vraie femelle avec toi, Veldrin ! Bon, tant pis...~
@51839 = ~*lorsque vous touchez le globe, la mosaïque du centre de la pièce vacille... il faut peut-être la stabiliser ou se tenir debout dessus*~
@51840 = ~Pff... Cette femelle qui se bat à tes côtés ? Peu m'importe que tu fricotes avec elle ! Mais je la ferai exécuter si tu la fais passer avant moi !~
@51841 = ~Bon, d'accord, ce n'est pas elle... c'est... quelqu'un que vous ne connaissez pas...~
@51842 = ~Mais c'est tout de même impossible, Phaere...~
@51843 = ~Bon, ce n'est pas vraiment une personne, c'est plutôt une affaire de morale...~
@51844 = ~Très bien. Je n'ai donc pas le choix...~
@51845 = ~Quelqu'un que... je... Ah, quelqu'un de Ched Nasad ! Une Vestale, c'est ça ? Ça me tenterait presque de briser ce lien, mais ce n'est pas de combat dont j'ai besoin en ce moment...~
@51846 = ~Quel dommage ! Je comprends maintenant que tu te sois enfui de Ched Nasad. Bientôt, mon cher Veldrin... bientôt je briserai ce lien, et je te libérerai... et nous ferons alors ce que nous voudrons...~ ~Quel dommage ! Je comprends maintenant que tu te sois enfuie de Ched Nasad. Bientôt, ma chère Veldrin... bientôt je briserai ce lien, et je te libérerai... et nous ferons alors ce que nous voudrons...~
@51847 = ~Mais je n'ai pas le temps pour une telle chose dans l'immédiat. Il va falloir que je trouve un autre mâle pour me satisfaire, quand j'en aurais le temps... Mais pour l'instant, j'ai encore du travail pour toi.~ ~Mais je n'ai pas le temps pour une telle chose dans l'immédiat. Il va falloir que je trouve une autre femelle pour me satisfaire, quand j'en aurais le temps... Mais pour l'instant, j'ai encore du travail pour toi.~
@51848 = ~Kaï~
@51849 = ~Ah. Enfin tu te réveilles. Allez... debout, fainéant. J'étais prête à appeler les esclaves pour qu'ils te battent. Tu as encore beaucoup à faire.~ ~Ah. Enfin tu te réveilles. Allez... debout, fainéante. J'étais prête à appeler les esclaves pour qu'ils te battent. Tu as encore beaucoup à faire.~
@51850 = ~Jeton de mithril~
@51851 = ~Jeton de mithril~
@51852 = ~C'est un petit disque de mithril aux bords ébréchés. Rien sur ce disque n'indique à quoi il peut servir.

PARAMÈTRES :

Poids : 0~
@51853 = ~Ah, vous voilà ! Matrone, c'est le mâle dont je vous ai parlé, Veldrin.~ ~Ah, vous voilà ! Matrone, c'est la femelle dont je vous ai parlé, Veldrin.~
@51854 = ~Qu'est-ce que c'est ? Quel est cet impertinent personnage qui ose s'adresser à moi ?~ [ARDULA02]
@51855 = ~Je vois très bien Veldrin, petite idiote. Tu me prends pour une aveugle ? Eh bien... Je ne remarque rien de spécial à son sujet. Qu'est-ce qui te fascine tant ?~
@51856 = ~Matrone, Veldrin excelle au combat... et c'est lui qui a résolu les petits... problèmes... de la Maison Despana.~ ~Matrone, Veldrin excelle au combat... et c'est elle qui a résolu les petits... problèmes... de la Maison Despana.~
@51857 = ~C'est celui-là ? Des illithids, des yeux-tyrans, des gnomes... et le puissant Solaufein ! Es-tu sûre ? Il a l'air tout maigre et il y a quelque chose de... bizarre...~ ~C'est celle-là ? Des illithids, des yeux-tyrans, des gnomes... et le puissant Solaufein ! Es-tu sûre ? Elle a l'air toute maigre et il y a quelque chose de... bizarre...~
@51858 = ~Je suis convaincue qu'il peut nous être d'une grande utilité, Matrone !~ ~Je suis convaincue qu'elle peut nous être d'une grande utilité, Matrone !~
@51859 = ~Euh... Peut-être... Laissons-lui le prouver, dans ce cas, s'il doit devenir tellement important aux yeux de Despana.~ ~Euh... Peut-être... Laissons-la le prouver, dans ce cas, si elle doit devenir tellement importante aux yeux de Despana.~
@51860 = ~Vous, jeune mâle ! Vous là... Veldrin, n'est-ce pas ? Écoutez-moi.~ ~Vous, jeune femelle ! Vous là... Veldrin, n'est-ce pas ? Écoutez-moi.~
@51861 = ~L'œil-tyran que vous avez tué en provenance de leur soi-disant ville. Ce n'était pas le bon. J'ai dit à cette fille, ici, quel type je voulais, et ce n'était pas le bon.~
@51862 = ~Mais, Matrone, je...~
@51863 = ~Silence, ma fille ! Je ne crois rien de tes mensonges ! Ouvre à nouveau la bouche et je t'envoie croupir dans les fosses de Lolth. As-tu vraiment envie d'avoir de nouveau affaire avec les driders, fillette ?~
@51864 = ~Quant à vous, Veldrin... Vous avez fait vos preuves. C'est bien... La Maison Despana a besoin de personnes compétentes, qualité rare quand on est entouré d'incapables...~
@51865 = ~La Maison Despana est sur le point de prendre le chemin de la gloire, Veldrin. Vous pouvez le suivre avec nous. La Mère Lolth aime les gagnants.~ ~La Maison Despana est sur le point de prendre le chemin de la gloire, Veldrin. Vous pouvez le suivre avec nous. La Mère Lolth aime les gagnantes.~
@51866 = ~Mais il me faut quelque chose d'assez rare pour entrer sur ce chemin de gloire... Peut-être pourriez-vous l'acquérir pour moi. Je vais vous confier cette tâche afin de voir si vous méritez les faveurs de Despana.~
@51867 = ~Aaaaahhhh...~ [FEMSAL05]
@51868 = ~Aah !~ [FEMSAL06]
@51869 = ~Fais ce qu'ordonne la matrone et tu vivras.~ [DRFEM101]
@51870 = ~Il me faut le sang de l'une des races voisines, Veldrin. Les races nobles seulement, et que ce soit le sang de l'un de leurs dirigeants. C'est une mission dangereuse.~
@51871 = ~La première possibilité est de m'apporter le sang d'un orbe ancien, le plus puissant des yeux-tyrans. Son œil ou son sang... J'avais confié cette mission à cette idiote de fille, mais elle a échoué.~
@51872 = ~L'œil-tyran du Spelljammer était supposé être un ancien, Matrone ! Je vous jure que c'est ce que les espions m'avaient rapporté ! Ils ont dû exagérer !~
@51873 = ~SILENCE ! Tu aurais dû vérifier cela toi-même, fille ! Ne te fies-tu donc qu'à ce mâle pour agir et penser à ta place ?~ ~SILENCE ! Tu aurais dû vérifier cela toi-même, fille ! Ne te fies-tu donc qu'à cette femelle pour agir et penser à ta place ?~
@51874 = ~Non, Matrone, non.~
@51875 = ~Cela suffit ! Si tu optes pour un orbe ancien, tu en trouveras sans doute un dans leurs tunnels, dans le quart sud-est des grottes principales.~
@51876 = ~Les autres possibilités sont de m'apporter le sang du géancéphale des illithids ou d'un prince kuo-toa. Mais ce serait aussi difficile que pour un orbe ancien.~
@51877 = ~Le géancéphale est bien gardé dans la ville illithide, à laquelle on accède par les cavernes du sud-est. Et une ancienne ruine des kuo-toas, dirigée par un prince fou, se trouve dans les grottes de l'ouest.~
@51878 = ~Partez donc, Veldrin. Rapportez-moi le sang de l'une de ces créatures. La Maison Despana attendra votre retour... mais ne tardez pas. C'est un ordre.~
@51879 = ~Artemis Entreri~
@51880 = ~Voleuse de vie +4~
@51881 = ~Contenant~
@51882 = ~dans le sac à dos~
@51883 = ~transférer~
@51884 = ~La lame de cette arme semble miroiter, révélant un tranchant de rasoir. De grandes compétences furent nécessaires pour forger cette arme, ainsi que les bénédictions de plusieurs instances supérieures, même si en comparaison, le travail effectué sur la poignée semble maladroit.

PARAMÈTRES :

TAC0 : +3
Dégâts : 1d8 +3 (tranchant)
Facteur de vitesse : 2
Type de compétence : cimeterre/wakizashi/ninjatō
Type : arme à une main
Nécessite :
 8 en Force

Poids : 3~
@51885 = ~Problèmes de l'île : l'histoire de Ginia

Ginia m'a raconté comment Desharik était arrivé sur l'île et s'en était emparé. Elle m'a aussi raconté que Chremy retenait son frère captif pour la forcer à être sa courtisane. J'ai dit que je ne pouvais pas l'aider.~
@51886 = ~Attends, c'est bien toi qui cherchait Neb, n'est-ce pas ? Prendre mon illithium et le laisser filer... bien joué.~
@51887 = ~Je suppose que tu ne sais pas qu'il a filé et qu'il a tué des enfants à Esmeltaran. C'est un rapide. Bravo.~
@51888 = ~Problèmes de l'île : l'histoire de Ginia

Ginia m'a raconté comment Desharik était arrivé sur l'île et s'en était emparé. Elle m'a aussi raconté que Chremy retenait son frère captif pour la forcer à être sa courtisane. J'ai dit que j'allais l'aider, peut-être en payant Calahan le contrebandier afin qu'il leur fasse quitter l'île à tous les deux. Il se trouve près des quais. Je vais également discuter avec Chremy. Il se trouve près de l'auberge.~
@51889 = ~Non, je sens que ce n'est pas le sang dont j'ai besoin, Veldrin. Je le sais... Mes pouvoirs magiques le sentent. Va et ne reviens pas sans le sang dont j'ai besoin.~
@51890 = ~Ne restez pas ici, idiot ! Partez ! Vite ! Nous avons beaucoup à faire pendant que vous ne serez pas là !~ ~Ne restez pas ici, idiote ! Partez ! Vite ! Nous avons beaucoup à faire pendant que vous ne serez pas là !~
@51891 = ~Vous avez le sang ! Vous avez réussi ! Bravo, Veldrin !~
@51892 = ~Ah... La Reine Araignée nous sourit... Notre pari se sera avéré payant, ma fille... Ton champion nous a apporté le sang dont nous avons besoin !~ ~Ah... La Reine Araignée nous sourit... Notre pari se sera avéré payant, ma fille... Ta championne nous a apporté le sang dont nous avons besoin !~
@51893 = ~Lolth soit louée ! Le rituel peut enfin commencer ! Despana va bientôt gouverner Ust Natha !~
@51894 = ~En effet. Mais nous devons rester sur nos gardes, ma fille, toujours faire attention. Le rituel pourrait être perturbé avant sa fin. L'argentée pourrait devenir désespérée.~
@51895 = ~Vous allez sceller la cité, Matrone ?~
@51896 = ~Oui. Nous ne pouvons pas nous permettre d'être dérangés de l'extérieur. Je vais faire les préparatifs qui s'imposent. Ce sera un jour de gloire, ah oui !~
@51897 = ~Veldrin. Vous avez rendu le plus grand des services à la Maison Despana. Aucun autre mâle ne sera aussi puissant que vous... Vous aurez des richesses et des esclaves.~ ~Veldrin. Vous avez rendu le plus grand des services à la Maison Despana. Aucune autre femelle ne sera aussi puissante que vous... Vous aurez des richesses et des esclaves.~
@51898 = ~Je verrai ça dès que le rituel sera terminé. Il est temps que vous vous reposiez, champion. Vous n'avez rien d'autre à me prouver.~ ~Je verrai ça dès que le rituel sera terminé. Il est temps que vous vous reposiez, championne. Vous n'avez rien d'autre à me prouver.~
@51899 = ~Mais je n'en ai pas encore fini avec lui. Veldrin... rejoignez-moi dans mes appartements. Dans une heure... et c'est un ordre !~ ~Mais je n'en ai pas encore fini avec elle. Veldrin... rejoignez-moi dans mes appartements. Dans une heure... et c'est un ordre !~
@51900 = ~Quoi ? Je croyais vous avoir demandé de partir, Veldrin. Restez si vous le souhaitez, mais ne me dérangez pas ou vous risquez de provoquer ma colère !~
@51901 = ~Faites-vous partie des compagnons de Veldrin, <MALEFEMALE> ? Je suis en pleins préparatifs. Si vous me dérangez une fois de plus, vos liens avec Veldrin ne pèseront pas lourd au fond de la fosse !~
@51902 = ~Je vous apprécie, <MALEFEMALE>... mais Veldrin est votre chef, et c'est à lui que je veux parler.~ ~Je vous apprécie, <MALEFEMALE>... mais Veldrin est votre cheffe, et c'est à elle que je veux parler.~
@51903 = ~Veldrin ? Bien, j'ai un plan... un plan qui va me propulser à la tête de la Maison Despana, au moment même où nous prendrons le contrôle d'Ust Natha en tant que légitime maison dominante !~
@51904 = ~Mais pour que ce plan réussisse, vous devez trahir la Mère Matrone. Êtes-vous prêt à le faire ? Réfléchissez bien avant de répondre...~ ~Mais pour que ce plan réussisse, vous devez trahir la Mère Matrone. Êtes-vous prête à le faire ? Réfléchissez bien avant de répondre...~
@51905 = ~Médaillon des étoiles~
@51906 = ~Bandeau doré~
@51907 = ~Clef du trésor de Despana~
@51908 = ~Je ne pense pas avoir le choix. Alors, je suppose que je suis d'accord.~
@51909 = ~Non. Sans moi !~
@51910 = ~Jarre d'eau~
@51911 = ~Jarre d'eau~
@51912 = ~Médaillon du soleil~
@51913 = ~Médaillon de l'épée~
@51914 = ~L'homme bâillonné~
@51915 = ~Secourir Haer'Dalis et sa gemme des griffes de Mekrath

J'ai facilement obtenu l'acte de propriété du théâtre que détenait cette idiote de Raelis, et cela ne m'a rien coûté. Croyait-elle vraiment que je risquerais ma vie pour elle ?~
@51916 = ~Secourir Haer'Dalis et sa gemme des griffes de Mekrath

J'ai facilement obtenu 1 000 pièces d'or de cette idiote de Raelis, et sans prendre de risques. Croyait-elle vraiment que je risquerais ma vie pour elle ?~
@51917 = ~Carlig~
@51918 = ~Carlig~
@51919 = ~Uder Mordin~
@51920 = ~Uder Mordin~
@51921 = ~Finderlig~
@51922 = ~Finderlig~
@51923 = ~Aganalo le dément~
@51924 = ~Riti~
@51925 = ~Riti~
@51926 = ~Alchra Diagott~
@51927 = ~Aganalo le dément~
@51928 = ~Alchra Diagott~
@51929 = ~Gont de Riatavin~
@51930 = ~Gont de Riatavin~
@51931 = ~Bedlen Daglefodd~
@51932 = ~Bedlen Daglefodd~
@51933 = ~Odendal Breachgnome~
@51934 = ~Odendal Breachgnome~
@51935 = ~Goldander Blackenrock~
@51936 = ~Goldander Blackenrock~
@51937 = ~Therndle Daglefodd~
@51938 = ~Therndle Daglefodd~
@51939 = ~*vous buvez ce qu'il reste de la Potion de métamorphose en écureuil, quelques instants plus tard la métamorphose en écureuil est complétée et vous entrez dans la cavité*~
@51940 = ~Armure de la famille Corthala +3~
@51941 = ~Armure de la famille Corthala~
@51942 = ~Cette armure, dans la famille Corthala depuis des générations, protège son porteur contre toutes les formes d'attaques. Elle est enchantée de façon à donner un bonus de 3 à la classe d'armure. Elle donne également un bonus contre l'acide, le feu et les attaques magiques. Cette armure immunise Valygar contre les charmes quand il la porte. Comme elle est à ses mesures, peu de personnes peuvent la porter.

PARAMÈTRES :

Capacités d'équipement :
- Immunité aux charmes
- Résistance au feu : +25 %
- Résistance à l'acide : +25 %
- Résistance aux dégâts magiques : +25 %

Classe d'armure : 2 (0 contre les armes tranchantes, 4 contre les armes contondantes)
Nécessite :
 6 en Force
 18 en Dextérité
 11 en Sagesse

Poids : 9~
@51943 = ~Lame de la famille Corthala +2~
@51944 = ~Lame de la famille Corthala~
@51945 = ~Ce katana d'exquise facture irradie une énergie magique quand il est porté par Valygar. Cette lame ne répond qu'à ceux qui ont du sang Corthala dans les veines. Il donne un bonus de 2, et inflige deux points de dégâts supplémentaires par hémorragie quand l'adversaire est touché.

PARAMÈTRES :

Capacités d'équipement :
- Classe d'armure : +2 contre les armes tranchantes

Capacités de combat :
- La cible subit 1 point de dégât de poison toutes les 2 secondes pendant 2 rounds

TAC0 : +2
Dégâts : 1d10 +2 (tranchant)
Facteur de vitesse : 2
Type de compétence : katana
Type : arme à une main
Nécessite :
 17 en Force
 18 en Dextérité
 16 en Constitution
 14 en Sagesse

Poids : 4~
@51946 = ~Entropie +2~
@51947 = ~Cette lame abyssale +2 en acier vert est l'une des armes préférées de Haer'Dalis. Cette épée courte inflige trois points de dégâts supplémentaires dus au poison si la victime rate son jet de sauvegarde. Cette lame ne peut être utilisée que par un tieffelin.

PARAMÈTRES :

Capacités de combat :
- La cible subit 1 point de dégât de poison par seconde pendant 3 secondes (jet de sauvegarde contre les poisons pour annuler)

TAC0 : +2
Dégâts : 1d6 +2 (perforant)
Facteur de vitesse : 1
Type de compétence : épée courte
Type : arme à une main
Nécessite :
 4 en Force

Poids : 2~
@51948 = ~Lame du chaos +2~
@51949 = ~La Lame du chaos est une épée courte +2 utilisable seulement par les tieffelins. À chaque fois qu'elle touche un adversaire, il perd 2 points de Dextérité (pour 30 secondes). Haer'Dalis se sert de cette épée en conjonction avec Entropie, ce qui fait de lui un adversaire redoutable.

PARAMÈTRES :

Capacités de combat :
- Lorsque la cible est touchée, elle perd 2 points de Dextérité pendant 5 rounds

TAC0 : +2
Dégâts : 1d6 +2 (perforant)
Facteur de vitesse : 1
Type de compétence : épée courte
Type : arme à une main
Nécessite :
 4 en Force

Poids : 2~
@51950 = ~Armure magnétique gondienne~
@51951 = ~Tenue d'aventurier de Jansen~
@51952 = ~Tenue d'aventurier chasse-métaux de marque Jansen (brevet en cours)

Cette étrange armure est faite d'un matériau inconnu, très souple mais solide au toucher. Conçue par et pour Jan Jansen, elle ne peut être portée que par son créateur. Cette armure ne donne pas de bonus à la classe d'armure, mais elle procure une résistance de 25 % contre tous les dégâts physiques et un bonus supplémentaire de 5 à la classe d'armure contre les projectiles. Elle permet aussi de lancer des sorts. Il faut ajouter qu'elle est également très élégante.

Note : nettoyage à sec exclusivement

PARAMÈTRES :

Capacités d'équipement :
- Résistance aux dégâts physiques : +25 %

Classe d'armure : 9 (4 contre les projectiles)
Nécessite :
 4 en Force
 17 en Dextérité

Poids : 3~
@51953 = ~Spectroscopes de Jansen~
@51954 = ~Micro-macro spectroscopes de marque Jansen (spectroscopes officiels de la confrérie pourpre)

Une autre des inventions de Jan Jansen, ces lunettes lui permettent de détecter l'invisibilité une fois par jour. Elles procurent également un bonus de 25 % à sa capacité Détection et désamorçage des pièges, et augmentent, grâce à tout un assortiment de lentilles, ses chances de détecter des illusions de 20 %. Ces lunettes sont si « discrètes » qu'il est inutile de les décrire. Elles ont néanmoins un certain style.

PARAMÈTRES :

Capacités d'équipement :
- Détection et désamorçage des pièges : +25 %
- Détection des illusions : +20 %
- Immunité à la cécité

Capacités de charge :
- Détection de l'invisibilité (une fois par jour)
  Zone d'effet : rayon de 4,5 mètres

Nécessite :
 17 en Dextérité

Poids : 0~
@51955 = ~Techno-gantelets de cyber-pickpocket de Jan~
@51956 = ~Outils de Baravar~
@51957 = ~Techno-gantelets de cyber-pickpocket de marque Jansen (marque déposée)

Ces gants de voleur permettent à Jan d'obtenir un bonus sur ses actions de Vol à la tire et de Crochetage de serrures. Lui seul peut utiliser ces gants, car personne d'autre ne saurait les faire fonctionner. Assez bizarrement, il semble pouvoir incanter même s'il les porte. Cela doit s'expliquer par leur style inimitable.

PARAMÈTRES :

Capacités d'équipement :
- Crochetage de serrures : +20 %
- Vol à la tire : +20 %

Nécessite :
 17 en Dextérité

Poids : 0~
@51958 = ~Créer Fiancées du Flasher~
@51959 = ~Je suis <CHARNAME>, de la tanière d'Adalon !~
@51960 = ~S'il te plaît, je t'en supplie, laisse-moi entrer. Je suis l'humble Veldrin de Ched Nasad.~
@51961 = ~Clef du trésor de Despana~
@51962 = ~Je te tuerai si tu ne me laisses pas entrer ! Pousse-toi donc !~
@51963 = ~Je suis Veldrin, de la cité de Ched Nasad.~
@51964 = ~Tir ajusté~
@51965 = ~Je n'aurais aucun scrupule à trahir la Mère Matrone.~
@51966 = ~J'ai besoin de vous, Veldrin... Sans votre arrivée en ville, rien de tout cela n'aurait été possible. Suivez mes instructions, et la récompense dépassera vos rêves les plus fous !~
@51967 = ~Refusez et... mais comment refuser ? Vous avez tout à y gagner, Veldrin, tout !~
@51968 = ~Je préférerais avoir plus de détails avant de prendre une décision.~
@51969 = ~Non. Je ne peux rien vous dire sans votre accord préalable. Je veux l'entendre de votre bouche, Veldrin.~
@51970 = ~Très bien. Je trahirai la Mère Matrone, comme vous le demandez.~
@51971 = ~Je n'ai pas vraiment le choix. Je ferai ce que vous m'ordonnez.~
@51972 = ~Non, je refuse. Je ne vous aiderai pas.~
@51973 = ~Alors, vous allez mourir ! Si vous n'êtes pas avec moi, vous êtes contre moi ! Les ténèbres seront la seule récompense à votre obstination !~
@51974 = ~Hmm. Je ne me contenterai pas d'un accord du bout des lèvres. Je dois m'assurer de votre totale dévotion. Vous allez devoir me convaincre de votre loyauté.~
@51975 = ~Euh... Quand je disais que je n'avais pas le choix, je voulais dire que mon seul choix était de vous servir, Phaere. La Mère Matrone ne signifie rien pour moi.~
@51976 = ~Vous êtes forte, et vous méritez la position de la Mère Matrone, Phaere. Votre présence renforcera les elfes noirs !~
@51977 = ~Je ne vous trahirai jamais, Phaere ! J'ai exécuté tous vos ordres, et j'attends les suivants !~
@51978 = ~Vous êtes forte, et vous méritez la position de la Mère Matrone, Phaere. Votre présence renforcera les elfes noirs !~
@51979 = ~Euh... Quand je disais que je n'avais pas le choix, je voulais dire que mon seul choix était de vous servir, Phaere. La Mère Matrone ne signifie rien pour moi.~
@51980 = ~Je ne vous trahirai jamais, Phaere ! J'ai exécuté tous vos ordres, et j'attends les suivants !~
@51981 = ~Pas besoin de preuves. Je ne trahirai jamais la Mère Matrone !~
@51982 = ~Hmmm... non. Non, je ne vous fais pas confiance, Veldrin. Vous me dénonceriez à la Mère Matrone pour votre propre profit, je crois ! Votre heure a sonné.~
@51983 = ~Ha ! Vous n'êtes qu'un vil flatteur, Veldrin. Mais c'est néanmoins la vérité. Je vous autorise à m'aider... et j'oublierai vos hésitations.~ ~Ha ! Vous n'êtes qu'une vile flatteuse, Veldrin. Mais c'est néanmoins la vérité. Je vous autorise à m'aider... et j'oublierai vos hésitations.~
@51984 = ~Avez-vous entendu la Mère Matrone parler du rituel ? Elle va invoquer un démon d'une grande puissance, Veldrin... un démon qui va nous aider à attaquer les elfes de la surface.~
@51985 = ~Bien. Alors, vous allez m'aider dans mes plans, et vous serez récompensé quand je serai la nouvelle Mère Matrone.~ ~Bien. Alors, vous allez m'aider dans mes plans, et vous serez récompensée quand je serai la nouvelle Mère Matrone.~
@51986 = ~Le sang est un élément essentiel du rituel : il sert à attirer l'attention du démon et à le faire venir jusqu'à nous.~
@51987 = ~La Maison Despana s'est procurée les œufs d'un dragon d'argent. Celui qui gardait la route vers la surface que nous, les elfes noirs, nous avions empruntée lors de la descente, il y a si longtemps.~
@51988 = ~Avec les œufs en « otage », le dragon nous laissera passer. Mieux, la Matrone compte s'en servir comme offrande au démon !~
@51989 = ~Quel démon pourrait refuser ? La Maison Despana aura ainsi ouvert la voie vers la surface et convoqué son plus puissant guerrier. Nous serons ainsi prédominant !~
@51990 = ~Mais rien ne dit qu'Ardulace doive rester la Mère Matrone d'une si puissante Maison...~
@51991 = ~Quoi ? Aucune patrouille n'est rentrée vivante de la tanière du serpent ailé ! C'est sûrement encore l'une de ses ruses et vous êtes exceptionnellement bête de m'avoir entraîné là-dedans !~
@51992 = ~Allez au trésor, Veldrin... Volez les œufs du dragon, et remplacez-les par les faux que j'ai fait fabriquer. Rapportez-moi ensuite les vrais.~
@51993 = ~La Matrone offrira au démon les faux œufs, et se fera tuer. Alors, je lui offrirai les vrais œufs. Le rituel sera complété, et je deviendrai la Mère Matrone.~
@51994 = ~La cité de Ust Natha te rejette ! Le sort qui t'est réservé ici n'est autre que le long sommeil de la mort !~
@51995 = ~Qui va là ?! Vous êtes un drow, mais il n'y a pas de patrouilles prévues aujourd'hui ! Identifiez-vous !~ ~Qui va là ?! Vous êtes une drow, mais il n'y a pas de patrouilles prévues aujourd'hui ! Identifiez-vous !~
@51996 = ~Là... voici la clef de la chambre du trésor, et les faux œufs. Prenez-les. Et revenez avec les vrais œufs avant que le rituel ne commence.~
@51997 = ~Gare à toi, <CHARNAME>. Les elfes noirs ne tremblent devant personne, et encore moins devant les leurs.~
@51998 = ~Je vais parler à ce vermisseau de mâle. Eh, toi, là ! Nous venons de la cité de Ched Nasad et tu vas nous laisser passer. Nous demandons le gîte et les services de tes temples !~
@51999 = ~C'est toi qui a le pouvoir, ici, <CHARNAME>. Les femelles sont les chefs dominants. Agis en conséquence.~
@52000 = ~Qu'attendez-vous ? Allez ! Allez ! Remplacez les vrais œufs par les faux, et ramenez-les-moi. Vite !~
@52001 = ~Prosterne-toi, vermine ! Je suis Veldrin de la cité de Ched Nasad. Laisse-moi passer !~
@52002 = ~Vous avez les œufs. Mais il fallait laisser les faux là où les vrais étaient ou la supercherie sera dévoilée ! Vite !~
@52003 = ~Pitoyable imitation ! Tu n'as rien d'un elfe noir... Tu trembles comme un kobold ! Un gringalet comme toi ne peut qu'être chassé de Ched Nasad !~ ~Pitoyable imitation ! Tu n'as rien d'une elfe noire... Tu trembles comme un kobold ! Une mauviette comme toi ne peut qu'être chassée de Ched Nasad !~
@52004 = ~Vous avez remplacé les vrais œufs, je le sais, mais où sont-ils ?! Pourquoi ne les avez-vous pas ramenés ?! Allez ! Retournez les chercher et ramenez-moi les vrais œufs ! Vite !~
@52005 = ~Tu viens de causer ta perte ! Ce n'est certes pas ainsi que l'on se présente à l'entrée de notre noble cité !~
@52006 = ~Je vous avertis... les gardes vont essayer de vous arrêter s'ils vous voient. Tuez-les qu'en cas de nécessité. Soyez discret, Veldrin... Partez maintenant.~ ~Je vous avertis... les gardes vont essayer de vous arrêter s'ils vous voient. Tuez-les qu'en cas de nécessité. Soyez discrète, Veldrin... Partez maintenant.~
@52007 = ~Toutes mes excuses. Je ne fais que mon devoir en te posant ces questions. Sois le bienvenu, Veldrin de Ched Nasad.~ ~Toutes mes excuses. Je ne fais que mon devoir en te posant ces questions. Sois la bienvenue, Veldrin de Ched Nasad.~
@52008 = ~Soyez les bienvenus, voyageurs de Ched Nasad. Excusez ce ton brusque, mais tout nouvel arrivant doit être examiné avant de pénétrer à Ust Natha.~
@52009 = ~Ahhhh, vous êtes une merveille, mon superbe mâle ! Si, si ! Vous avez suivi mes instructions à la lettre et vous êtes revenu à moi avec les œufs. Où sont-ils ?~ ~Ahhhh, vous êtes une merveille, ma superbe femelle ! Si, si ! Vous avez suivi mes instructions à la lettre et vous êtes revenue à moi avec les œufs. Où sont-ils ?~
@52010 = ~Veldrin ? Je ne connais pas ce nom, mais tu peux entrer. Les portes de Ust Natha s'ouvrent à toi.~
@52011 = ~Les voilà ! *donner les œufs de Solaufein*~
@52012 = ~Nous devrions normalement te questionner plus avant, mais nous attendions ton groupe de Ched Nasad. Ton arrivée tardive a repoussé les plans de Solaufein.~
@52013 = ~Les voilà ! *donner les vrais œufs*~
@52014 = ~Entre vite, et assure-toi de demander le conseil de Solaufein. C'est un membre de la Société des Combattants qui te présentera la cité d'Ust Natha et la conduite à y tenir.~
@52015 = ~Garde à l'esprit que ton entrée dans la cité est conditionnelle, et que si tu oublies de le rencontrer ou si tu te joues de lui de quelque manière que ce soit, tu seras poursuivi, traqué par tous comme une bête.~ ~Garde à l'esprit que ton entrée dans la cité est conditionnelle, et que si tu oublies de le rencontrer ou si tu te joues de lui de quelque manière que ce soit, tu seras poursuivie, traquée par tous comme une bête.~
@52016 = ~La Société des Combattants se trouve au nord de la cité, au-delà de la Société des Combattantes, juste avant la fosse aux araignées.~
@52017 = ~Ah ! Vous enfin réveiller ! Bien ! Maintenant, vous combattre !~
@52018 = ~Alors, ce sont les œufs du dragon d'argent ? Oui, c'est ça... Merci Veldrin... c'est du bon travail.~
@52019 = ~Excellent ! Quel plaisir d'avoir un serviteur tel que vous, mâle. Vous avez bien œuvré.~ ~Excellent ! Quel plaisir d'avoir une servante telle que vous, femelle. Vous avez bien œuvré.~
@52020 = ~Je vais au temple pour le rituel... Vous devez être là pour assister à mon triomphe. Rejoignez-moi là-bas, et ne soyez pas en retard, ce n'est pas le moment de me mettre en colère...~
@52021 = ~Vous êtes là ! Le rituel va bientôt commencer... et mon ascension va suivre... Nous n'avons plus qu'à patienter, Veldrin.~
@52022 = ~Veldrin ! Excellent, je t'ai trouvé. Je te surveillais depuis un moment, ici en ville.~ ~Veldrin ! Excellent, je t'ai trouvée. Je te surveillais depuis un moment, ici en ville.~
@52023 = ~Je ne sais pas ce que tu cherches, ou si tu vas m'écouter. Mais j'ai quelque chose à t'offrir... quelque chose qui donnera à cette traîtresse de Phaere ce qu'elle mérite.~
@52024 = ~Je l'ai suivie, j'ai vu qu'elle avait fait exécuter des copies des œufs du dragon... et j'ai deviné son plan. J'ai fait faire d'autres copies.~
@52025 = ~Phaere a fait marquer ses copies, de manière à les reconnaître. Mais mes doubles ne sont pas marqués... Si tu les lui donnes à la place des véritables œufs, elle s'y trompera.~
@52026 = ~Les prendras-tu, Veldrin ? Les prendras-tu pour les lui donner ?~
@52027 = ~Oui. Merci, Solaufein.~
@52028 = ~Non. Je ne compte pas trahir Phaere.~
@52029 = ~Très bien. Peu m'importe ce que tu es venu faire dans cette ville. Mais tu as épargné ma vie... Je regrette juste de ne pas être là pour voir sa tête.~ ~Très bien. Peu m'importe ce que tu es venue faire dans cette ville. Mais tu as épargné ma vie... Je regrette juste de ne pas être là pour voir sa tête.~
@52030 = ~Bonne chance et adieu, alors.~
@52031 = ~Tu es étrange. Tu m'épargnes, mais tu continues à obéir aux ordres de Phaere ? Elle dansera sur ta carcasse comme elle a dansé sur la mienne. Nous ne nous reverrons plus.~
@52032 = ~Je t'ai trouvé, surfacin ! Je me cache dans les ombres de la cité depuis un moment, et je pense que j'ai de quoi te dédommager de ta pitié.~ ~Je t'ai trouvée, surfacine ! Je me cache dans les ombres de la cité depuis un moment, et je pense que j'ai de quoi te dédommager de ta pitié.~
@52033 = ~Quel est cet endroit ?~
@52034 = ~Qui es-tu ?~
@52035 = ~Qu'est-ce que je fais ici ?~
@52036 = ~Ça me convient ! Ta tête fera un splendide trophée !~
@52037 = ~Tu ne m'as pas révélé la raison de ta présence dans une ville d'elfes noirs, mais je crois que je l'ai devinée. J'ai suivi Phaere, et j'ai vu qu'elle faisait exécuter des copies des œufs du dragon.~
@52038 = ~Des questions, encore des questions ! Toujours pareil avec nouveaux combattants. Vous écouter et moi dire vous tout ce que vous besoin de savoir.~
@52039 = ~J'ai compris son plan... et je suis certain qu'elle t'utilisera. Si c'est ce que tu désires, je pense connaître un moyen de la tromper.~
@52040 = ~J'ai fait exécuter une autre copie des œufs. Phaere a marqué ses doubles, afin de les reconnaître... mes exemplaires ne sont pas marqués. Si tu les lui donnes, elle s'y trompera.~
@52041 = ~Je me moque de la guerre entre les elfes noirs et nos cousins de la surface, et je crache sur Phaere et sa Maison. Je te donne cette copie des œufs pour que tu déjoues ses plans.~
@52042 = ~Tu m'as expliqué ta mission... et je crois que je vais pouvoir t'aider. J'ai suivi Phaere. Elle est allée faire fabriquer des copies des œufs du dragon.~
@52043 = ~Oui, donne-les moi. Cela devrait réussir.~
@52044 = ~Je n'ai pas confiance en toi, Solaufein. Je trouverai une autre solution.~
@52045 = ~Excellent. J'aimerais être là pour voir sa tête... et lui dire que c'est moi qui l'ai trompée. Mais il est préférable que je n'y sois pas.~
@52046 = ~Porte-toi bien, surfacin. Lorsque j'entendrai le bruit de la chute de la Maison Despana, je louerai ton nom.~ ~Porte-toi bien, surfacine. Lorsque j'entendrai le bruit de la chute de la Maison Despana, je louerai ton nom.~
@52047 = ~Tu ne me fais pas confiance ? C'est sage de ta part, surfacin... bien que j'aimerais pouvoir te convaincre du contraire. Je prierai pour que tu réussisses à organiser la chute de la sorcière sans mon aide.~ ~Tu ne me fais pas confiance ? C'est sage de ta part, surfacine... bien que j'aimerais pouvoir te convaincre du contraire. Je prierai pour que tu réussisses à organiser la chute de la sorcière sans mon aide.~
@52048 = ~Bonne chance, surfacin. Nous ne nous reverrons pas.~ ~Bonne chance, surfacine. Nous ne nous reverrons pas.~
@52049 = ~Hé Hé ! Non, stupide petit homme, vous pas combattre moi. Moi gagné le droit plus me battre. Non, vous combattre dans l'arène. Vous écouter et moi dire vous tout ce que vous besoin savoir.~ ~Hé Hé ! Non, stupide petite femme, vous pas combattre moi. Moi gagné le droit plus me battre. Non, vous combattre dans l'arène. Vous écouter et moi dire vous tout ce que vous besoin savoir.~
@52050 = ~Je prépare le rituel qui donnera à la Maison Despana la suprématie totale... alors votre interruption a intérêt à être justifiée, mâle. Est-ce le cas ?~ ~Je prépare le rituel qui donnera à la Maison Despana la suprématie totale... alors votre interruption a intérêt à être justifiée, femelle. Est-ce le cas ?~
@52051 = ~Vous savoir d'abord que pas moi capturer vous. Vous pénétrer sans autorisation dans maison des flagelleurs et eux attraper vous. Maintenant, vous payer séjour. Compris ?~
@52052 = ~Ensuite, vous intérêt bien combattre dans l'arène, sinon vous mourir. Si vous refuser combattre, mourir aussi.~
@52053 = ~Oui, c'est une chose importante. Phaere a projeté de vous trahir pendant la cérémonie.~
@52054 = ~Peut-être vous vivre assez longtemps pour obtenir poste serviteur. Meilleur que combattre. Oh ! Dernière règle : jamais attaquer flagelleurs. Ici chez eux. Eux tuer vous avec pensées.~
@52055 = ~Je le crois, oui. Mais il faut que je vous pose quelques questions.~
@52056 = ~Arme empoisonnée~
@52057 = ~Ainsi donc je dois combattre pour le bon plaisir des flagelleurs ! Serait-ce de « flagelleurs mentaux » qu'il s'agit ?~
@52058 = ~Personne ne m'obligera pas à combattre ! Je m'y refuse !~
@52059 = ~Tu n'as pas l'air d'un mauvais bougre. Tu pourrais être un homme riche si tu me laissais partir.~
@52060 = ~Je combattrai donc, puisqu'il le faut. Je m'y résoudrai... momentanément.~
@52061 = ~Non, je m'en vais.~
@52062 = ~Je n'ai que faire de vos questions, stupide mâle ! Partez ! Et ne m'interrompez plus !~ ~Je n'ai que faire de vos questions, stupide femelle ! Partez ! Et ne m'interrompez plus !~
@52063 = ~Alors disparaissez ! Si vous me dérangez encore une fois, vous servirez de nourriture aux driders, mâle impertinent !~ ~Alors disparaissez ! Si vous me dérangez encore une fois, vous servirez de nourriture aux driders, femelle impertinente !~
@52064 = ~C'est... très intéressant, mâle. Ce ne serait pas la première fois que l'une de mes filles essaierait de prendre ma place. Mais j'ai toujours réussi à tuer les traîtres.~ ~C'est... très intéressant, femelle. Ce ne serait pas la première fois que l'une de mes filles essaierait de prendre ma place. Mais j'ai toujours réussi à tuer les traîtres.~
@52065 = ~Mais je n'ai aucun indice de trahison de la part de Phaere, et ne renierais pas sans preuve une fille très bien placée dans les faveurs de Lolth. Avez-vous des preuves, mâle ?~ ~Mais je n'ai aucun indice de trahison de la part de Phaere, et ne renierais pas sans preuve une fille très bien placée dans les faveurs de Lolth. Avez-vous des preuves, femelle ?~
@52066 = ~Phaere m'a donné ces faux œufs de dragon pour remplacer les vrais dans le trésor.~
@52067 = ~Elle m'a fait voler les œufs de dragon... ceux-ci... afin de les remplacer par des faux.~
@52068 = ~Elle m'a donné la clef de votre salle du trésor, là où vous gardez les œufs de dragon.~
@52069 = ~Montrez-moi ça ! Oui, quelle ressemblance ! Je commence à comprendre son plan... Elle m'aurait trahie, si vous ne l'aviez pas dénoncée !~
@52070 = ~Et c'est vous qui avez maintenant les vrais œufs. Rendez-les moi. Ma fille a dû vous donner sa clef ; c'est le seul moyen d'entrer dans la salle du trésor.~
@52071 = ~Mais où sont les vrais œufs, alors ? Les avez-vous déjà sortis de la salle du trésor grâce à la clef de ma fille ? Si c'est le cas, rendez-les moi.~
@52072 = ~Les voici. *donner les vrais œufs*~
@52073 = ~Les voici. *donner les œufs de Solaufein*~
@52074 = ~Vous rester vivants si vous bien combattre. Attention : pas fâcher spectateurs. Eux très forts ici car eux gros cerveau. Premier combat tout de suite !~
@52075 = ~Parfait. Oui, ce sont les vrais... Et vous n'avez pu entrer qu'avec la clef de ma fille. De toute évidence, elle vous a pris pour son serviteur.~ ~Parfait. Oui, ce sont les vrais... Et vous n'avez pu entrer qu'avec la clef de ma fille. De toute évidence, elle vous a pris pour sa servante.~
@52076 = ~Eux maîtres des combats. Vous faire ce que moi dire et eux pas tuer vous. Vous affronter nombreux adversaires avant devenir serviteur comme moi.~
@52077 = ~*un frisson de danger parcourt soudainement votre nuque... quelque chose ici n'est pas normal*~
@52078 = ~La magie noire est à l'œuvre !~
@52079 = ~Où est Irenicus, femme ?~
@52080 = ~Vous serez récompensé pour votre loyauté, mâle. Et mon insensée de fille sera châtiée pour sa trahison... gardes ! Approchez !~ ~Vous serez récompensée pour votre loyauté, femelle. Et mon insensée de fille sera châtiée pour sa trahison... gardes ! Approchez !~
@52081 = ~Vous pas pouvoir acheter vie moi ! Non, si moi désobéir, moi tomber raide mort à cause collier. Non, vous pas comprendre. Vous combattre et espérer victoire.~
@52082 = ~Refus impossible. Assommer vous avant vous ici, pas vrai ? Eh bien ! Ici eux encore plus forts car eux très gros cerveau.~
@52083 = ~Mais je n'ai pas de preuve que cette trahison vient de Phaere. Vous êtes peut-être le seul traître ici, mâle. Avez-vous d'autres preuves ? Ou devrai-je vous tuer pour en savoir trop ?~ ~Mais je n'ai pas de preuve que cette trahison vient de Phaere. Vous êtes peut-être la seule traître ici, femelle. Avez-vous d'autres preuves ? Ou devrai-je vous tuer pour en savoir trop ?~
@52084 = ~Vous faire ce que moi dire et voilà tout. Moi obéir et moi vivant. Autres désobéir et eux morts.~
@52085 = ~J'ai la clef du trésor... Phaere me l'a donnée.~
@52086 = ~Euh, non... Je n'en ai pas.~
@52087 = ~C'est en effet la clef de ma fille. La seule autre clef, outre la mienne.~
@52088 = ~Il faut donc approfondir cette enquête... En attendant, mourrez, stupide mâle !~ ~Il faut donc approfondir cette enquête... En attendant, mourrez, stupide femelle !~
@52089 = ~Bravo ! Vous bien combattre ! Vous rester vivants ! Moi revenir dire vous quand prochain combat.~
@52090 = ~Maintenant vous combattre encore. Continuer bon travail. Moi soutenir vous. Githyankis terribles adversaires.~
@52091 = ~Vous combattre githyankis maintenant. Vous pas discuter avec eux. Ou tuer eux plus difficile. Moi savoir.~
@52092 = ~Montrez-moi ça ! Oui... Je commence à comprendre son plan... Et si vous les avez, c'est forcément qu'elle vous a donné sa clef... la seule outre la mienne.~
@52093 = ~Alors, vous prêts ? Combat devenir plus difficile, mais vous bien combattre. Nouveau combat bientôt alors vous préparer.~
@52094 = ~Euh... non, non. C'était juste une intuition.~
@52095 = ~Et la mienne, « d'intuition », c'est que vous allez mourir aujourd'hui, idiot de mâle !~ ~Et la mienne, « d'intuition », c'est que vous allez mourir aujourd'hui, idiote de femelle !~
@52096 = ~Gardes... faites venir ma fille aînée. Ne la laissez pas trouver d'excuses. Elle a trahi la Maison Despana.~
@52097 = ~Quoi ? Qu'est-ce que cela signifie, Matrone ? Pourquoi m'amène-t-on devant vous ?~
@52098 = ~Je vois outre tes mots innocents, ma fille. Tu es folle. Tu as trahi la Maison Despana.~
@52099 = ~Non ! Non ! Pourquoi dites-vous ça ?~
@52100 = ~Pourquoi ? Regarde qui se tient près de moi, ma fille... Et je suppose que tu comprends pourquoi.~
@52101 = ~Qui ? Veldrin ? Non, Matrone, non ! C'est son plan ! Le plan de Veldrin ! Je vous le jure, au nom de Lolth, il essayait de vous trahir !~ ~Qui ? Veldrin ? Non, Matrone, non ! C'est son plan ! Le plan de Veldrin ! Je vous le jure, au nom de Lolth, elle essayait de vous trahir !~
@52102 = ~Tu oses appeler la Reine Mère ? Tu es pathétique, Phaere... Pathétique et faible. J'aurais dû te tuer depuis longtemps. Mais je vais rectifier cette erreur immédiatement...~
@52103 = ~NON ! NON ! VELDRIN, ATTAQUEZ-LA ! TUEZ-LA ! JE VOUS L'ORDONNE ! AHHHHH ! QUE LES FLAMMES T'EMPORTENT, ALORS ! QUE TU POURRISSES POUR L'ÉTER...~
@52104 = ~Mère Lolth ! Je vous ai fait appeler pour anéantir cette impertinente ! Elle n'est plus digne de vous ! Anéantissez-la !~
@52105 = ~Voilà, c'est fait... Si elle avait été plus forte et plus digne de la Mère Araignée, elle aurait réussi.~
@52106 = ~Vous avez de nouveau agi en héros, Veldrin. Vous continuez à vous montrer digne des honneurs de la Maison. Très bien... vous assisterez donc à la cérémonie.~ ~Vous avez de nouveau agi en héroïne, Veldrin. Vous continuez à vous montrer digne des honneurs de la Maison. Très bien... vous assisterez donc à la cérémonie.~
@52107 = ~Vous vous tiendrez à une place de choix et vous assurerez qu'aucune autre... interruption ne vienne nous perturber, car cela empêcherait le déroulement complet du rituel.~
@52108 = ~Attendez ici. Un garde viendra vous cherchez pour vous amener sur le lieu du rituel dès qu'il sera prêt à commencer. Ce ne sera pas long, fidèle compagnon.~ ~Attendez ici. Un garde viendra vous cherchez pour vous amener sur le lieu du rituel dès qu'il sera prêt à commencer. Ce ne sera pas long, fidèle compagne.~
@52109 = ~Ahhh, me voilà, me voilà. Vous devez sûrement vous demander qui je suis ? Un loyal serviteur de l'argentée, pour toujours ! Que vous la serviez, elle ou ses plans, n'a pas d'importance.~
@52110 = ~Je vous ai observé ; c'était très intéressant. Rusé, rusé, rusé ! De supercherie en supercherie, les œufs ont été sauvés de toute agression.~ ~Je vous ai observée ; c'était très intéressant. Rusée, rusée, rusée ! De supercherie en supercherie, les œufs ont été sauvés de toute agression.~
@52111 = ~Je vous ai observé ; c'était très intéressant. Il est grand temps d'agir ! Les œufs doivent être sauvés !~ ~Je vous ai observée ; c'était très intéressant. Il est grand temps d'agir ! Les œufs doivent être sauvés !~
@52112 = ~Vous devez les sortir de la cité ! La cité est fermée, scellée, c'est de la magie. Si vous décidez de partir, la Mère Matrone Ardulace doit être morte.~
@52113 = ~Une fois que la Mère Matrone sera morte, vous devrez fuir avec les œufs. Les prêtresses seront très en colère, vous n'aurez que quelques minutes avant que votre déguisement ne tombe. Partez aussi vite que possible.~
@52114 = ~Faites cesser le rituel avant que le démon ne reçoive les œufs ! La Mère Matrone devra mourir pour que vous puissiez quitter la cité scellée.~
@52115 = ~Prenez ensuite les œufs et fuyez. Les prêtresses seront très en colère, vous n'aurez que quelques minutes avant que votre déguisement ne tombe. Partez vite !~
@52116 = ~Si vous échouez, elle viendra à vous. Vous n'apprécierez sûrement pas. Vous devez sauver les œufs.~
@52117 = ~Chuut ! Je dois faire silence ! Quelqu'un vient ! Je pense que le rituel va bientôt commencer ! Bonne chance, petit !~ ~Chuut ! Je dois faire silence ! Quelqu'un vient ! Je pense que le rituel va bientôt commencer ! Bonne chance, petite !~
@52118 = ~Allez voir la fille de la Mère Matrone... elle vous attend dans le temple. Le temps est compté. Bonne chance, petit...~ ~Allez voir la fille de la Mère Matrone... elle vous attend dans le temple. Le temps est compté. Bonne chance, petite...~
@52119 = ~Je suis la Mère Matrone de la Maison Despana, stupide mâle. Si vous me dérangez à nouveau sans raison, vous irez servir de pâture aux driders ! Allez-vous-en !~ ~Je suis la Mère Matrone de la Maison Despana, stupide femelle. Si vous me dérangez à nouveau sans raison, vous irez servir de pâture aux driders ! Allez-vous-en !~
@52120 = ~Cette insolence a assez duré ! C'est la dernière fois que vous me dérangez ! Votre heure est venue, insensé !~ ~Cette insolence a assez duré ! C'est la dernière fois que vous me dérangez ! Votre heure est venue, insensée !~
@52121 = ~Très bien. Tous les préparatifs sont faits. Il est temps de commencer le rituel. Dans quelques instants, les elfes noirs auront gagné toute suprématie et la Maison Despana sera la plus puissante de toutes.~
@52122 = ~Assurez-vous que rien n'interrompe mon allocution. Lorsque le démon apparaîtra, n'intervenez pas. La moindre erreur de l'un d'entre vous causerait sa mort immédiate et son éternel tourment.~
@52123 = ~Bien... je commence.~
@52124 = ~Bien... je commence.~
@52125 = ~Maudit sois-tu, insolente vermine ! Le rituel ne peut être à nouveau initié ! Ton ingérence causera notre perte ! Insensé !~ [ARDULA07] ~Maudit sois-tu, insolente vermine ! Le rituel ne peut être à nouveau initié ! Ton ingérence causera notre perte ! Insensée !~ [ARDULA07]
@52126 = ~Aucun elfe noir n'oserait jamais faire une telle chose ! Qui êtes-vous ? Que faites-vous ici ? Je le saurai et vous écorcherai vif, côte par côte !~ ~Aucune elfe noire n'oserait jamais faire une telle chose ! Qui êtes-vous ? Que faites-vous ici ? Je le saurai et vous écorcherai vive, côte par côte !~
@52127 = ~Quoi ?! Des créatures de la surface ?! Ici ?! Dissimulées parmi nous ?! VOUS MOURREZ DANS D'ATROCES SOUFFRANCES POUR VOTRE IGNOMINIE ! GARDES ! TUEZ-LES TOUS !~
@52128 = ~** JE SUIS VENU... VOUS M'AVEZ ARRACHÉ À MON PLAN, NOIRAUDE... SOIT VOUS AVEZ UNE BONNE RAISON, SOIT JE VOUS EN FERAI PAYER LE PRIX... DANS UNE MARE DE SANG NOIR... **~
@52129 = ~J'ai de bonnes raisons, seigneur des abysses inférieurs ! Je vous implore d'aider la cause des elfes noirs dans leur guerre contre leurs détestables cousins de la surface, et de nous aider à écorcher leur pâle chair !~
@52130 = ~** ET QUELLE SORTE DE RÉCOMPENSE M'OFFREZ-VOUS POUR UN TEL SERVICE, NOIRAUDE ? POURQUOI VOUS AIDERAIS-JE ? **~
@52131 = ~Je vous offre cela ; seigneur des fiélons... des œufs du dragon d'argent, vertueuse créature de lumière. Vous pourrez en disposer à votre guise, si vous acceptez de nous aider.~
@52132 = ~** AAAHHH, VOILÀ UNE RÉCOMPENSE TRÈS INTÉRESSANTE, NOIRAUDE. **~
@52133 = ~Alors prenez-les ! Prenez-les et détruisez nos ennemis communs !~
@52134 = ~** SAVEZ-VOUS, NOIRAUDE, QUE DES ALLIÉS DE VOS ENNEMIS ELFIQUES SONT ICI ? SI VOUS N'ÉTIEZ PAS AU COURANT, OBSERVEZ LEURS FORMES NATURELLES. **~
@52135 = ~QUOI ? Veldrin est... un <PRO_RACE> de la surface ? Non ! Non ! QUEL OUTRAGE ! DÉTRUIS CES CRÉATURES DE LA SURFACE, SEIGNEUR DE L'OMBRE ! TUE-LES TOUTES !~ ~QUOI ? Veldrin est... une <PRO_RACE> de la surface ? Non ! Non ! QUEL OUTRAGE ! DÉTRUIS CES CRÉATURES DE LA SURFACE, SEIGNEUR DE L'OMBRE ! TUE-LES TOUTES !~
@52136 = ~** AVEC PLAISIR. **~
@52137 = ~** STUPIDE NOIRAUDE. PENSEZ-VOUS SINCÈREMENT QUE MOI, JE VAIS ME LAISSER ABUSER PAR UNE SUPERCHERIE SI SIMPLISTE ? **~
@52138 = ~Que... Que veux-tu dire, ô seigneur de l'ombre ? Ce... ce sont...~
@52139 = ~** ILS SONT FAUX, MORTELLE ! DES VRAIS M'AURAIENT CONTENTÉ. MAIS JE SUIS DÉSORMAIS EN COLÈRE. TON SANG ME CALMERA, PETITE CRÉATURE SOMBRE ! **~
@52140 = ~NON ! NON ! LOLTH, PROTÈGE TA FIDÈL...~
@52141 = ~** COMMENT OSEZ-VOUS ? COMMENT OSEZ-VOUS M'APPÂTER AVEC DES ŒUFS EN DÉTESTABLE ARGENT POUR ENSUITE ME DÉCEVOIR DE LA SORTE ? J'AI BIEN ENVIE DE RÉDUIRE CETTE VILLE EN CENDRES À PRÉSENT ! **~
@52142 = ~Attendez, démon ! J'ai ici les œufs du dragon d'argent ! Je vous les offre en échange d'un service !~
@52143 = ~Partez, démon ! Vous n'avez rien à faire ici ! Celle qui vous a invoqué est morte !~
@52144 = ~*rester silencieux*~ ~*rester silencieuse*~
@52145 = ~** AH OUI ? JE COMMENCE À VOIR QUI VOUS ÊTES RÉELLEMENT, ENFANT DE BHAAL, ET CELA M'AMUSE BEAUCOUP. QUE PUIS-JE FAIRE POUR VOUS EN ÉCHANGE DE CETTE OFFRANDE ? **~
@52146 = ~J'aimerais réussir à sortir vivant d'ici... d'Ombre-Terre !~ ~J'aimerais réussir à sortir vivante d'ici... d'Ombre-Terre !~
@52147 = ~Je voudrais connaître la richesse !~
@52148 = ~J'aimerais un objet magique très puissant !~
@52149 = ~Je veux que vous me donniez de la puissance, une puissance inégalée !~
@52150 = ~Euh... Rien... J'ai changé d'avis. Ce n'est peut-être pas une si bonne idée.~
@52151 = ~** RIEN DE PLUS FACILE, ENFANT DE BHAAL. JE VAIS ME DIRIGER VERS LA SORTIE EN ÉLIMINANT LE MOINDRE DE VOS ENNEMIS SUR MON PASSAGE. SUIVEZ-MOI, PETIT DÉMON. **~
@52152 = ~** BAH. MA PATIENCE A DES LIMITES SURTOUT POUR DE TELLES ABSURDITÉS. IL SERAIT BEAUCOUP PLUS SIMPLE POUR MOI DE VOUS TUER, STUPIDE ENFANT DE BHAAL. **~
@52153 = ~** VOILÀ QUI EST FAIT. MARCHÉ CONCLU. À PRÉSENT, JE NE VEUX PLUS JAMAIS ENTENDRE PARLER DE VOUS. **~
@52154 = ~** JE N'AI PAS POUR HABITUDE D'ÊTRE PATIENT AVEC LES IMBÉCILES. SI JE NE RÉCUPÈRE PAS LES ŒUFS, JE RÉCUPÉRERAI AU MOINS VOTRE SANG, ENFANT DE BHAAL. **~
@52155 = ~** BAH ! JE N'AI PAS DE TEMPS À PERDRE AVEC DE TELS INSECTES. À PRÉSENT, NE ME DÉRANGEZ PLUS OU VOUS LE REGRETTEREZ, STUPIDES NOIRAUDS ! **~
@52156 = ~Halte, démon ! Je suis la fille de celle qui vous a invoqué... et j'ai les œufs que vous voulez. Je vous en fais l'offrande !~
@52157 = ~** AHAHAHAAH ! ON S'EST JOUÉ DE VOUS, PETITE FILLE. VOS ŒUFS SONT FAUX, EUX AUSSI ! **~
@52158 = ~Quoi ? Non, ce n'est... Veldrin ? VELDRIN ? QU'AVEZ-VOUS FAIT ?~
@52159 = ~** L'ENFANT DE BHAAL T'A TUÉ, PETITE FILLE ! AHAHAH ! C'EST TROP DRÔLE... AHAHAH ! VIENS, VIENS ET MEURS ! **~
@52160 = ~NON ! JE VOUS TUERAI, VELDRIN ! JE VOUS TROUVERAI ET JE MANGERAI VOTRE CŒUR ENCORE PALPITANT ! JE...~
@52161 = ~Vous n'allez rien faire avec ces œufs, Phaere. Donnez-les-moi ou je vous tue !~
@52162 = ~Vous osez me trahir ? Idiot ! De toute façon, vous ne me servez plus à rien maintenant. Lolth aurait apprécié ce sacrifice, mais tant pis ! Démon ! Je t'ordonne de détruire ces infidèles !~ ~Vous osez me trahir ? Idiote ! De toute façon, vous ne me servez plus à rien maintenant. Lolth aurait apprécié ce sacrifice, mais tant pis ! Démon ! Je t'ordonne de détruire ces infidèles !~
@52163 = ~** VOUS NE DONNEZ AUCUN ORDRE, ENFANT NOIRAUD ! JE REFUSE D'EN ENTENDRE DAVANTAGE ! JE VAIS TOUS VOUS TUER ET ENSUITE JE ME RÉGALERAI AVEC CES ŒUFS ! **~
@52164 = ~Soyez damné, Veldrin ! Vous nous avez tous condamnés ! Vous pourrirez dans les Fosses Démoniaques pour l'éternité !~ ~Soyez damnée, Veldrin ! Vous nous avez tous condamnés ! Vous pourrirez dans les Fosses Démoniaques pour l'éternité !~
@52165 = ~*rester silencieux*~ ~*rester silencieuse*~
@52166 = ~** AAAAHHHH, VOILÀ UNE TRÈS BELLE OFFRANDE, ENFANT NOIRAUD. JE SUIS RAVI. **~
@52167 = ~** SAVEZ-VOUS, NOIRAUDE, QUE DES ALLIÉS DE VOS ENNEMIS ELFIQUES SONT ICI ? SI VOUS N'ÉTIEZ PAS AU COURANT, OBSERVEZ LEURS FORMES NATURELLES. **~
@52168 = ~Prends les œufs, seigneur démon. Et pour la gloire de Lolth, conduis mon peuple à la surface, que nous tracions un chemin sanglant dans les rangs de nos cousins blafards !~
@52169 = ~V-Veldrin ? Quoi ?! Pas un elfe noir, mais un... un habitant de la surface ? Un espion ! QUELLE HONTE ! SEIGNEUR DÉMON, GARDES, TUEZ-LES TOUS !~ ~V-Veldrin ? Quoi ?! Pas une elfe noire, mais une... une habitante de la surface ? Une espionne ! QUELLE HONTE ! SEIGNEUR DÉMON, GARDES, TUEZ-LES TOUS !~
@52170 = ~** JE ME FERAI UN PLAISIR D'ÉLIMINER L'ENFANT DE BHAAL. **~
@52171 = ~** EH BIEN... ON DIRAIT QU'IL N'Y A PAS DE VÉRITABLES ŒUFS DE DRAGON POUR MOI. QUEL DOMMAGE ! JE VAIS DEVOIR PARTIR À MOINS QUE VOUS N'AYEZ UNE AUTRE PROPOSITION À ME FAIRE ? **~
@52172 = ~J'ai les œufs, démon. Je vous les donnerai en échange de votre aide.~
@52173 = ~Retournez d'où vous venez, démon... Ceux qui vous ont invoqué sont morts.~
@52174 = ~*rester silencieux*~ ~*rester silencieuse*~
@52175 = ~** AINSI SOIT-IL. APRÈS TOUT, LES MORTELS NE SONT JAMAIS QUE DES ÉTERNELS IMBÉCILES. **~
@52176 = ~Je vois... que nous ne sommes pas seuls en ces lieux. Notre destin est scellé car nous sommes encerclés par les illithids, ces terribles et méprisables créatures.~ [SIMYAZ02]
@52177 = ~Et rien que de penser que nous pourrions subir le même sort que vous... vous qui auriez dû mourir au cours de notre attaque en mer.~
@52178 = ~Nous sommes tous condamnés au même sort, comme jouets pour l'arène. C'est une manière infamante de mourir.~
@52179 = ~Quelles sortes de créatures êtes-vous ? Je n'ai jamais vu d'êtres tels que vous.~ ~Quelles sortes de créatures êtes-vous ? Je n'ai jamais vu d'être tels que vous.~
@52180 = ~Que savez-vous des illithids ? Sont-ils également appelés les flagelleurs mentaux ?~
@52181 = ~Ainsi vous allez devoir combattre là-bas ? Nous devrons certainement nous affronter !~
@52182 = ~Votre sort ne m'intéresse pas. Je trouverai seul un moyen de fuir.~ ~Votre sort ne m'intéresse pas. Je trouverai seule un moyen de fuir.~
@52183 = ~Nous sommes des githyankis et nous ne sommes pas venus ici par hasard. Quelqu'un a volé une de nos épées... une Épée d'argent. Nous étions venus la récupérer.~
@52184 = ~Mais notre navire a sombré et maintenant nous voilà prisonniers de nos ennemis les plus détestés, les flagelleurs mentaux illithids. C'est une abomination que je ne permettrai pas.~
@52185 = ~Nous haïssons les illithids et nous ferons en sorte qu'ils meurent avant d'en avoir fini. Ou nous mourrons.~
@52186 = ~Je ne peux parler davantage. Mes hommes doivent méditer pour se préparer à la bataille à venir. Il nous faudra faire preuve d'une grande force mentale pour nous échapper de cet endroit. Une Grande force.~
@52187 = ~Nous savons beaucoup de choses sur ces créatures tentaculaires. Elles réduisent en esclavage et elles tuent. Nous ne pouvons supporter de rester ici.~
@52188 = ~Peut-être l'un d'entre nous devra-t-il mourir. Ce n'est pas un risque qui nous est étranger. Nous sommes venus dans ce royaume dans le but de nous battre pour récupérer une Épée d'argent.~
@52189 = ~Cela vous vous concernera quand vous découvrirez que vous ne pouvez pas vous échapper seul. Les alliances les plus étonnantes sont forgées dans des endroits comme celui-ci.~ ~Cela vous vous concernera quand vous découvrirez que vous ne pouvez pas vous échapper seule. Les alliances les plus étonnantes sont forgées dans des endroits comme celui-ci.~
@52190 = ~S'il vous plaît, ne troublez pas notre méditation. Nous devons nous préparer soigneusement si nous voulons déceler une faiblesse dans la toile d'araignée des illithids.~
@52191 = ~Ils arrivent... L'affrontement est inévitable. Tenez-vous prêts, compagnons, car bientôt ces exécrables illithids pourront nous voir. Préparez vos armes, mes fidèles !~ [SIMYAZ07]
@52192 = ~Vous là-bas, nous avons mené à bien ce combat et je crois savoir qu'il est prévu que nous nous affrontions la prochaine fois que le geôlier passera.~ [SIMYAZ08]
@52193 = ~Nous pourrions nous contenter de fanfaronner pour savoir qui vaincra mais je crois que nous pouvons mettre sur pied un bien meilleur stratagème. Ce n'est qu'une chance infime mais c'est la seule que nous ayons.~
@52194 = ~J'écoute.~
@52195 = ~Inutile. Je vous vaincrai et je m'inquiéterai de fuir ensuite.~
@52196 = ~Je ne vous fais pas confiance.~
@52197 = ~Malgré un manque de confiance certain, je vous parlerai du plan et vous verrez qu'il est raisonnable.~
@52198 = ~Comme votre geôlier vous l'a dit, les illithids sont puissants, ici, dans leur domaine. Ils peuvent tuer comme bon leur semble et s'échapper est impossible.~
@52199 = ~Mais nous autres, les githyankis, disposons également de pouvoirs et je crois que nous pouvons semer la confusion parmi les illithids. Et permettre à quelqu'un de fuir.~
@52200 = ~Quand nous serons appelés pour la bataille, nous, les githyankis, nous méditerons dans le cercle pour repousser les esprits des illithids. Vous pourrez alors ouvrir les portes de l'arène pour que nous puissions tous fuir.~
@52201 = ~Vous devez trouver un moyen de fuir la cité des illithids. Nous les distrairons jusqu'à ce que vous réussissiez à vous frayer un passage dans cette cité torturée.~
@52202 = ~Une fois commencées nos méditations, il n'y aura plus de mort immédiate dans l'arène, mais la porte est la seule échappatoire possible.~
@52203 = ~Alors, c'est ce que je ferai. Nous allons coopérer.~
@52204 = ~Je ne vous fais pas du tout confiance. Je ne participerai pas à ce plan.~
@52205 = ~Nous verrons. Le moment venu, je réfléchirai à ce plan.~
@52206 = ~Alors préparez-vous, car le moment du combat est proche. Le geôlier va venir nous chercher dans très peu de temps.~
@52207 = ~Alors vous êtes fou. Nous n'avons pas le choix et nous continuerons que vous nous aidiez ou pas.~ ~Alors vous êtes folle. Nous n'avons pas le choix et nous continuerons que vous nous aidiez ou pas.~
@52208 = ~Nous contiendrons aussi longtemps que possible le pouvoir des illithids. Si vous n'agissez pas dès que nous aurons commencé, alors vous nous condamnez tous. Le geôlier ne va plus tarder.~
@52209 = ~Vous êtes fou si vous pensez qu'il y a un autre moyen. Une fois que nous aurons entamé nos méditations, il n'y aura plus qu'une seule chance à saisir. Faites-le et nous serons tous libres.~ ~Vous êtes folle si vous pensez qu'il y a un autre moyen. Une fois que nous aurons entamé nos méditations, il n'y aura plus qu'une seule chance à saisir. Faites-le et nous serons tous libres.~
@52210 = ~Vous ne servez en rien notre cause en attaquant les illithids ici ! Il y en a bien d'autres qui remplaceront ceux que vous avez occis ! Occupez-vous d'abord de la porte !~ [SIMYAZ09]
@52211 = ~Nous entamons les méditations ! Occupez-vous de la porte et libérez-nous tous ! Tuez ces kuo-toas et trouvez un moyen de fuir cet endroit. Nous nous occupons des illithids.~ [SIMYAZ10]
@52212 = ~Vous avez combattu vaillamment et les githyankis ont échappé à l'emprise de la toile mentale des illithids. Notre pouvoir est à nouveau libre et nous pouvons à présent quitter ces lieux de notre bon vouloir.~ [SIMYAZ11]
@52213 = ~Je crains que vous ne deviez rester ici, car nous ne pouvons vous emmener avec nous et rester libres. Nous reviendrons plus tard tuer tout ce que leurs tentacules ont touché.~
@52214 = ~Quoi ?! Je savais que je ne pouvais vous faire confiance !~
@52215 = ~Alors partez mais, quand nous nous reverrons, je ne ferai pas de quartier.~
@52216 = ~Couard. Vous n'affrontez ces créatures que quand cela vous convient ?~
@52217 = ~Ah ! Mais vous pouviez et nous vous avons libérés. Sans nous vous ne seriez pas allés aussi loin et tout n'est pas encore perdu.~
@52218 = ~Mais votre crime ne peut être pardonné. Vous possédez une de nos Épées d'argent et pour cela vous serez soumis au test.~
@52219 = ~Si vous pouvez triompher de cet endroit, si vous pouvez tuer le géancéphale, toutes les portes s'ouvriront et vous serez libres.~
@52220 = ~C'est acceptable. Nous attendons de voir si vous pouvez réunir toute la force nécessaire à vous libérer de cet endroit.~
@52221 = ~Nous les affrontons quand le combat peut s'avérer glorieux mais il y a des limites. Risquer sa vie face aux illithids quand il n'y a aucun espoir de victoire n'est pas une attitude que nous encourageons.~
@52222 = ~Dans le cas contraire, nous reviendrons en force plus tard. Ce nid d'immondices sera entièrement détruit.~
@52223 = ~Je vous souhaite succès et santé, et puissiez-vous fouler aux pieds le géancéphale.~
@52224 = ~J'espère que vous réussirez et que vous écraserez le géancéphale mais je souhaite aussi que la main qui étreint notre Épée d'argent vous soit arrachée.~
@52225 = ~Vous êtes vivant ! Les illithids vous ont laissé partir ?! Voilà qui est extraordinaire ! À moins que vous ne vous soyez allié à eux. Je vous préviens, si vous servez leur cause, vous partagerez leur sort.~ [SIMYAZ12] ~Vous êtes vivante ! Les illithids vous ont laissée partir ?! Voilà qui est extraordinaire ! À moins que vous ne vous soyez alliée à eux. Je vous préviens, si vous servez leur cause, vous partagerez leur sort.~ [SIMYAZ12]
@52226 = ~Non, pas vraiment. J'AI DÉTRUIT TOUTES CES CRÉATURES SANS VOTRE AIDE.~
@52227 = ~La bataille fut féroce mais j'ai vaincu. Cela aurait été plus simple si vous m'aviez aidé.~ ~La bataille fut féroce mais j'ai vaincu. Cela aurait été plus simple si vous m'aviez aidée.~
@52228 = ~Je ne vous en veux pas d'être parti. Il fut très difficile de fuir.~
@52229 = ~Je ressens une certaine hostilité. Je vous conseillerais de diriger votre colère ailleurs. Il est admirable que vous ayez survécu mais cela ne veut pas dire que vous pourrez nous vaincre.~
@52230 = ~Nous ne sommes pas d'humeur à tolérer vos gesticulations. Nous nous concentrons sur notre prochaine action ici et nous ne souhaitons pas être interrompus.~
@52231 = ~Nous allons devoir tester votre valeur, bien que votre mort soit le seul objectif que nous recherchons. Il est bien regrettable que ayez réussi à fuir.~
@52232 = ~J'avais espéré que vous échoueriez et que l'Épée d'argent que vous portez tomberait dans la cité illithide. Nous serions revenus en force pour appliquer une terrible condamnation.~
@52233 = ~On dirait que tu n'as pas pu résister au sort que t'a jeté cette elfe noire, <CHARNAME>. Je trouve ça plutôt amusant, en fait. T'a-t-elle forcé à l'acte ou l'as-tu fait de ton plein gré ?~ ~On dirait que tu n'as pas pu résister au sort que t'a jeté cette elfe noire, <CHARNAME>. Je trouve ça plutôt amusant, en fait. T'a-t-elle forcée à l'acte ou l'as-tu fait de ton plein gré ?~
@52234 = ~Peut-être mais les motivations ne sont jamais simples. Nous voulions revenir avec une force suffisante pour tout détruire. Vous nous avez épargné le dérangement.~
@52235 = ~Peu importe. Heureusement, nous avons une chance d'occire cette gueuse. Si je ne devais pas rester incognito, je la provoquerai publiquement et je lui arracherais la tête... mais on ne peut pas tout avoir...~
@52236 = ~Nous ne sommes pas partis par crainte. Nous voulions revenir avec une force suffisante pour tout détruire. Vous nous avez épargné de devoir le faire.~
@52237 = ~Maintenant que la cité illithide n'est plus, nous allons repartir là d'où nous venons. Laissez-nous tranquilles et nous ferons de même.~
@52238 = ~C'était plutôt étrange, <CHARNAME>. J'étais sûre que Phaere essayait de te séduire. Comment as-tu échappé à ses griffes ?~
@52239 = ~C'est peut-être mon image qui t'a fait garder ton célibat, hum ? Ha, ha... eh bien, ça m'épargne au moins l'effort d'écorcher vif l'un d'entre vous. C'est un rude labeur.~
@52240 = ~Tu as passé du temps dans les chambres des elfes noires, <CHARNAME>. Vas-tu me donner des explications sur ce que tu faisais, comme si je ne le savais pas.~
@52241 = ~Elle m'a forcé, Jaheira. Je n'avais pas le choix si je voulais sauver les apparences.~ ~Elle m'a forcée, Jaheira. Je n'avais pas le choix si je voulais sauver les apparences.~
@52242 = ~Elle m'a forcé, Jaheira. Je n'avais pas le choix si je voulais sauver les apparences.~ ~Elle m'a forcée, Jaheira. Je n'avais pas le choix si je voulais sauver les apparences.~
@52243 = ~C'était pour arriver à mes fins, rien de plus.~
@52244 = ~Je n'avais pas vraiment le choix. Je suis désolé.~ ~Je n'avais pas vraiment le choix. Je suis désolée.~
@52245 = ~De toute manière, ça ne te regarde pas.~
@52246 = ~Je présume que c'est en partie vrai, mais j'imagine bien quelques mensonges tu aurais pu raconter pour notre bien. Mais je te fais confiance. Et si on continuait ?~
@52247 = ~Hmmpf. Tu es bien du genre à me mentir à ce sujet. Et je me sens mal à l'aise, c'est encore pire. Je crois que je préfère rester seule pendant quelque temps.~
@52248 = ~Je les connais, tes fins. Simple autosatisfaction ou prétends-tu ici même qu'il n'y avait aucun moyen d'éviter cette situation ? Ah, assez ! Je ne veux plus en entendre parler.~
@52249 = ~Je suis moi aussi désolée et déçue, mais je pense que c'était inévitable... sachant que tu es un mâle, et vu ton apparence. Je vais... essayer de tout oublier.~ ~Je suis moi aussi désolée et déçue, mais je pense que c'était inévitable... sachant que tu es une femme, et vu ton apparence. Je vais... essayer de tout oublier.~
@52250 = ~Non ? Très bien. Je m'efforcerai de garder mes opinions de garce pour moi-même, à ce sujet et en tout ce qui nous concerne tous deux.~
@52251 = ~Hmmm... déjà dehors ? L'elfe noire n'a pas réussi à te retenir dans ses griffes ? Tant mieux. Je frémis à l'idée de ce qui aurait pu arriver sinon...~
@52252 = ~Vous... vous avez laissé cette elfe noire vous... toucher, n'est-ce pas ? Vous avez laissé un être aussi vil... contre vous ? Je... je ne parviens pas à comprendre comment vous pouvez accepter une telle chose !~
@52253 = ~Nous n'avons pas fui par crainte mais je pensais qu'il était préférable de revenir en force. Ces maudits illithids ne tueront plus aucun des nôtres.~
@52254 = ~Cette lame de métal étincelle d'une vague pulsation quand elle est touchée. Il s'agit d'une partie d'une arme plus grande.

PARAMÈTRES :

Poids : 2~
@52255 = ~Ne... ne prenez pas la peine de répondre... je ne veux rien entendre ! Je... je crois juste que je me suis lourdement trompée à votre sujet, <CHARNAME>. Je... j'aimerais être seule, un moment.~
@52256 = ~Vous... vous n'êtes pas resté longtemps dans sa chambre. Pas assez pour... enfin, je veux dire... vous vous êtes manifestement écarté d'elle. Cela... ça me soulage. Je commençais à me poser des questions.~ ~Vous... vous n'êtes pas restée longtemps dans sa chambre. Pas assez pour... enfin, je veux dire... vous vous êtes manifestement écartée d'elle. Cela... ça me soulage. Je commençais à me poser des questions.~
@52257 = ~Très bien, mais je vous conseillerais, à l'avenir, de mieux traiter vos alliés potentiels.~
@52258 = ~Je doute que je me contente de m'éloigner. Vous m'avez laissé mourir.~
@52259 = ~Je ne pense pas ! Je ne suis pas disposé à vous laisser tranquille ! Je vais vous faire payer votre trahison maintenant !~ ~Je ne pense pas ! Je ne suis pas disposée à vous laisser tranquille ! Je vais vous faire payer votre trahison maintenant !~
@52260 = ~Hiatus entropique :~
@52261 = ~Je n'ai pas volé une telle épée. C'est Saemon Havarian qui me l'a donnée.~
@52262 = ~Pourquoi cette arme est-elle tellement importante ?~
@52263 = ~Désolé de vous décevoir, mais je n'ai pas votre arme.~ ~Désolée de vous décevoir, mais je n'ai pas votre arme.~
@52264 = ~Gardez vos menaces pour vous. Elle est à moi désormais. Quoi que vous puissiez dire, je ne vous la rendrai pas.~
@52265 = ~Je parle à travers mon chef suprême, Simyaz. Si vous souhaitez connaître mes pensées vous pouvez l'interroger !~
@52266 = ~IIIAAAArrrrrgghghgh !~
@52267 = ~Je... je vis à nouveau ! Mais quel... quel outrage ! J'ai été empalée !~
@52268 = ~Tu en redemandes, immonde créature ?~
@52269 = ~C'est facile d'enlever l'épine de ta patte. Tout aussi facile de la remettre.~
@52270 = ~Oui, oui, maintenant dis-moi ce que tu sais de cet endroit ou je te recloue.~
@52271 = ~Le golem a les yeux fixés au loin. Il ne semble ni voir ni entendre. Il doit certainement être inactif.~
@52272 = ~Le golem a les yeux fixés au loin. Il ne semble ni voir ni entendre. Il doit certainement être inactif.~
@52273 = ~Comment ?! Mais tu n'es pas le contact elfe noir que j'attendais ! J'ai été trahi !~
@52274 = ~Je vous ai permis de vous échapper la première fois, mais je ne commettrai pas... pas... Valygar ?~
@52275 = ~Suna ? Suna Seni ? Que... que faites-vous ici ?~ [VALYGA84]
@52276 = ~Je chasse le rejeton de Bhaal, Valygar. Tu... tu ne devrais pas être avec lui. Va-t'en, pars avant que je ne sois obligée de te traiter comme le reste de ses compagnons !~ ~Je chasse la rejetonne de Bhaal, Valygar. Tu... tu ne devrais pas être avec elle. Va-t'en, pars avant que je ne sois obligée de te traiter comme le reste de ses compagnons !~
@52277 = ~Comment ?! Vous... travaillez pour cet homme qui traque <CHARNAME> ? Suna, ce sorcier est un terrible fléau ! Pourquoi faites-vous cela ?~
@52278 = ~Je... n'ai pas le choix. Je t'en prie, Valygar... si notre histoire a encore un sens pour toi, pars maintenant. Je ne veux pas avoir à te faire du mal.~
@52279 = ~Vous n'avez pas le choix ? Suna, si le sorcier vous contrôle de quelque manière, nous pouvons vous aider. Vous n'avez pas à vous abaisser à cela.~
@52280 = ~Valygar, je... tu ne peux pas m'aider. Allez-y... prenez <CHARNAME> et... tuez tous les autres.~
@52281 = ~Suna, non !~
@52282 = ~Je suis désolée, mon vieil amour. Vraiment désolée.~
@52283 = ~C'est un affreux gâchis que d'entraîner ainsi ses protégés. <CHARNAME>, allons-nous-en d'ici avant que je ne ruine votre quête en massacrant jusqu'au dernier tous les infâmes voleurs que je vois ici.~ ~C'est un affreux gâchis que d'entraîner ainsi ses protégées. <CHARNAME>, allons-nous-en d'ici avant que je ne ruine votre quête en massacrant jusqu'à la dernière toutes les infâmes voleuses que je vois ici.~
@52284 = ~C'est ainsi qu'on entraîne les voleurs, ici ? Je suis heureuse de n'être pas passée par là. Comme ce doit être affreux, d'être si peu considéré par ses maîtres...~
@52285 = ~Il n'aurait pas dû tomber dans le piège, n'est-ce pas ? C'est un système assez simple... et une telle erreur sur le terrain lui aurait coûté la vie.~
@52286 = ~Nous ne sommes pas tous obsédés par l'argent comme <CHARNAME>, mademoiselle. Bon... dites-nous à quoi nous nous attaquons ici, pour que nous puissions nous préparer à l'assaut.~
@52287 = ~<CHARNAME> ! C'est terrible ! Nous avions promis à Nalia que nous l'aiderions, et je pense que devons le faire ! Nalia... dites-nous ce qui nous... attend à l'intérieur.~
@52288 = ~Les vrais héros ne demandent aucune récompense, <CHARNAME>, et Bouh sait que tu es un vrai héros ! Tout ce dont nous avons besoin, c'est de savoir qui l'on doit affronter pour que le grand bottage puisse commencer !~ ~Les vrais héros ne demandent aucune récompense, <CHARNAME>, et Bouh sait que tu es une vraie héroïne ! Tout ce dont nous avons besoin, c'est de savoir qui l'on doit affronter pour que le grand bottage puisse commencer !~
@52289 = ~Ahh, alors je ne suis ramené à la vie que pour me battre ? Pourquoi te donner la peine de me libérer, homme de bien ? Peu importe, je suis volontaire ! Je serai libéré de cet endroit et de tous leurs maudits appareillages pour m'immobiliser !~ ~Ahh, alors je ne suis ramené à la vie que pour me battre ? Pourquoi te donner la peine de me libérer, femme de bien ? Peu importe, je suis volontaire ! Je serai libéré de cet endroit et de tous leurs maudits appareillages pour m'immobiliser !~
@52290 = ~Je vois votre menace et ce que vous voulez, mais je n'ai pas de service à vous offrir en échange de votre action. Je suis faible, et cet endroit a sapé ma volonté.~
@52291 = ~Si c'est tout ce que la dame peut offrir, <CHARNAME>, nous devons accepter. Refuser ne serait pas honorable. Nous t'aiderons, ma douce. Dis-nous ce dont souffre ta famille.~
@52292 = ~Considérez-vous payé pour vos services, <CHARNAME>. J'insiste pour que nous aidions cette jeune dame, que cela vous plaise ou non. Quel est le problème, exactement, mademoiselle ?~ ~Considérez-vous payée pour vos services, <CHARNAME>. J'insiste pour que nous aidions cette jeune dame, que cela vous plaise ou non. Quel est le problème, exactement, mademoiselle ?~
@52293 = ~Comment peux-tu refuser aussi froidement ? Je ne resterai pas sans réagir. Nalia... nous t'aiderons, tout comme <CHARNAME>, j'en suis sûre. Quel est exactement le problème ?~
@52294 = ~Har har ! Tu as entendu <CHARNAME>, beauté. Si tu veux notre aide, allonge la monnaie. Bien sûr... on pourrait s'arranger pour un échange... hé... ah ça oui...~
@52295 = ~Non ! Dis-moi que c'est impossible ! <CHARNAME>, nous devons sauver l'enfant de cet homme charmant et partir ! À moins... à moins que tu aies un plan ? Minsc est déconcerté.~
@52296 = ~Haaa... Je ne tolérerai aucune sorte d'accord avec cette bête, <CHARNAME>. Je tenterai de sauver l'enfant moi-même, s'il le faut.~
@52297 = ~Attention, <CHARNAME>. J'entends vos paroles et je ne suis pas impressionné. Je vous affronterai l'épée à la main, si vous faites ce que vous avez dit.~
@52298 = ~Au nom d'Arvoreen ! Êtes-vous capable d'envisager une telle action, <CHARNAME> ?! Je m'y oppose ! Ce n'est pas digne de vous !~
@52299 = ~<CHARNAME>... je sais que vos actes sont parfois... discutables, mais de grâce, pas ça. Je ne pourrais plus me regarder en face en sachant que j'y ai pris part. Je vous en supplie, ne le faites pas.~
@52300 = ~Vous êtes dans un atelier, où ils ont analysé ma chair et mes pensées. Ils craignent les non-morts, ces horreurs tentaculaires, car j'ai un esprit qu'ils ne peuvent goûter.~
@52301 = ~Oh-ho ! Des dissidents dans vos rangs, <CHARNAME> ? Comment est-ce possible ? Pourtant l'attitude de vos compagnons ne m'intéresse pas. Qu'est-ce que vous souhaitez faire ?~
@52302 = ~Cela dépend de ce que vous pensez offrir en échange.~
@52303 = ~Je ferai comme il me plaira, et voilà ce que je veux faire.~
@52304 = ~Je suppose que je vais sauver l'enfant, comme prévu. Nous nous recroiserons à l'avenir, dragon.~
@52305 = ~Peut-être pas. Mais nous nous rencontrerons à nouveau, vous et moi...~
@52306 = ~Non ! <CHARNAME> est-il tombé si bas ? Ce glorieux sauvetage est devenu un cauchemar aux proportions épiques ! Minsc et Bouh t'empêcheront d'aller plus loin !~ ~Non ! <CHARNAME> est-elle tombée si bas ? Ce glorieux sauvetage est devenu un cauchemar aux proportions épiques ! Minsc et Bouh t'empêcheront d'aller plus loin !~
@52307 = ~Goûter... euh, je ne sais pas ce que vous espérez... extraire de moi... il n'y a rien d'autre ici que les couronnes qu'ils utilisent pour communier avec leur vil cerveau... Ils la mettent sur la tête et ils vont à la cuve...~
@52308 = ~Alors, qu'il en soit ainsi. Je vous ai prévenu, <CHARNAME>, que je ne participerais pas à un tel méfait et je le maintiens. À présent, je dois vous arrêter.~ ~Alors, qu'il en soit ainsi. Je vous ai prévenue, <CHARNAME>, que je ne participerais pas à un tel méfait et je le maintiens. À présent, je dois vous arrêter.~
@52309 = ~Peut-être que si je... si je retrouvais mon ancienne force... peut-être que si vous me faisiez don d'un peu... de votre sang... je me rappellerais tellement plus de choses...~
@52310 = ~Ignoble monstre ! Le sang impur de votre dieu se montre enfin ! En vérité, si je suis là, c'est bien pour vous empêcher de continuer ! En garde !~
@52311 = ~Arrière, créature. Tu n'auras pas une goutte de mon sang !~
@52312 = ~Tu te souviendras très bien tel que tu es. Maintenant, continue.~
@52313 = ~Oh, et puis pourquoi pas. Tu peux en avoir un peu. Juste un peu, attention.~
@52314 = ~À votre aise. Vous avez fait votre choix, <CHARNAME>... et il est méprisable. Je ne tolérerai pas de telles activités.~
@52315 = ~Si... si c'est ce que vous comptez faire, alors vous devrez le faire sans moi, <CHARNAME>. Je... je retourne au cirque. Au moins... au moins on y trouve des gens décents.~
@52316 = ~Du sang... il me faut... la soif que j'ai... impérieuse !~
@52317 = ~Oui... juste un peu... un peu de... du sang... la soif que j'ai... dois apaiser ma soif !~
@52318 = ~Ah-ha ! Ça devrait être amusant, au moins ! Je suis heureux de vous observer, tant que votre bataille ne devient pas casse-pieds. Alors, <CHARNAME>... Voyons ce qui vient naturellement, hein ?~
@52319 = ~Tu fais une chose terrible là <CHARNAME>. Il ne me reste qu'à implorer ta libération grâce aux actes bons que tu as commis par le passé... mais je ne vais pas le faire ici. Adieu.~
@52320 = ~Sarn ! Nind ph' naut Ilythiiri !~
@52321 = ~Nous protégeons la Mère Matrone et sommes prêts à mourir s'il le faut. Ne provoquez pas la colère de la Matrone ni celle de la Reine Araignée, et vous n'aurez rien à craindre de nous.~
@52322 = ~La Matrone est morte ! Les Vestales parcourront toute la ville pour trouver le responsable ! Vous ! C'est peut-être vous, mâle... Nous verrons bien...~ ~La Matrone est morte ! Les Vestales parcourront toute la ville pour trouver le responsable ! Vous ! C'est peut-être vous, femelle... Nous verrons bien...~
@52323 = ~Nindol orn tlu jivvin. Ssussun pholor dos, shebali !~
@52324 = ~Kyorl ! Udos phu' naut dossta ogglen !~
@52325 = ~Nindol orn tlu jivvin. Oloth plynn dos, colnbluth !~
@52326 = ~N'avancez pas d'un pas ! Cette zone est fermée à tous à l'exception des chasseurs. Retournez dans la cité elle-même ou vous serez tué.~ ~N'avancez pas d'un pas ! Cette zone est fermée à tous à l'exception des chasseurs. Retournez dans la cité elle-même ou vous serez tuée.~
@52327 = ~Le moment du rituel arrive... la Mère Matrone m'envoie vous chercher pour que vous assistiez aux incantations. C'est un grand honneur, suivez-moi.~
@52328 = ~Ça ne s'est pas bien passé, <CHARNAME>. Ils n'entendront pas raison !~
@52329 = ~Ha ! Stupide voleur !~
@52330 = ~En voilà encore ! Tu vas mourir !~
@52331 = ~La... la Matrone est morte ?! Le rituel a échoué ?! Que s'est il passé ?! Quelqu'un devra payer quand les Vestales auront découvert qui est responsable !~
@52332 = ~Nous partirons lorsque nous l'aurons décidé. Nous avons des affaires pressantes à régler en dessous et tu ne nous retarderas pas.~
@52333 = ~Prudence ! D'autres ennemis approchent !~
@52334 = ~Personne n'est autorisé à passer sans notre accord. Vos mots peuvent sembler doux à l'oreille des buveurs éméchés d'une taverne, femelle, mais ici, ils n'auront aucun écho.~
@52335 = ~Je te salue, jolie femelle. Je suis Szordrin, le gérant de la fosse aux combats... une distraction pour nous tous, et un moyen de gagner la faveur de Lolth.~
@52336 = ~Je vais parler en mon nom, Viconia. Ces mâles seront obligés d'écouter.~
@52337 = ~Dis-leur, Viconia.~
@52338 = ~Je vais parler en mon nom, Viconia. Ils seront obligés d'écouter, même si je suis un mâle.~
@52339 = ~Je te salue, ami mâle. Je suis Szordrin, le gérant de la fosse aux combats. Ici, de vaillants combattants affrontent des animaux-esclaves pour la gloire de Lolth... et notre amusement.~
@52340 = ~Il n'y a rien à redire. Personne n'entre sans cause juste. Retournez dans la cité.~
@52341 = ~Tu sembles coriace. Si cela te tente, nous avons capturé plusieurs bêtes féroces qui n'attendent que ton coup de grâce, si tu l'oses.~
@52342 = ~Allez, il faut s'entraider... Peut-être voulez-vous que je contribue à améliorer votre ordinaire ?~
@52343 = ~Alors nous combattrons ! Je veux passer !~
@52344 = ~Viconia, que devons-nous faire ?~
@52345 = ~Tu es un Nasadran, n'est-ce pas ? Arrivé depuis peu ? J'ai entendu parler de toi. Bien des gens ici aimeraient savoir si tu te bats aussi bien qu'on le prétend.~ ~Tu es une Nasadrane, n'est-ce pas ? Arrivée depuis peu ? J'ai entendu parler de toi. Bien des gens ici aimeraient savoir si tu te bats aussi bien qu'on le prétend.~
@52346 = ~Bien sûr, si tu es lâche et blafard, tu n'es pas obligé d'essayer. Mais la Reine Araignée ne respecte que les forts.~ ~Bien sûr, si tu es lâche et blafarde, tu n'es pas obligée d'essayer. Mais la Reine Araignée ne respecte que les forts.~
@52347 = ~Un combat dans l'arène... de quoi s'agit-il exactement ?~
@52348 = ~Quelles sortes de « bêtes » aurais-je à combattre ?~
@52349 = ~Très bien... je combattrai dans ton arène, Szordrin.~
@52350 = ~Non, je n'ai pas le temps.~
@52351 = ~Non, je n'ai pas le temps.~
@52352 = ~Il nous faut entrer d'urgence ! Une attaque elfe va être lancée contre nos forces !~
@52353 = ~Voudriez-vous me corrompre ? Oseriez-vous me déshonorer juste avec la couleur éclatante de l'or ?~
@52354 = ~Tu as deux alternatives : Tenter une quelconque corruption ou les combattre. Je doute que tout ce que nous pourrons dire les influencera beaucoup.~
@52355 = ~C'est assez simple, mâle. J'ouvre brièvement la porte. Tu entres avant que je ne la ferme. Une fois que tu es à l'intérieur, je fais entrer la bête et tu te bats.~ ~C'est assez simple, femelle. J'ouvre brièvement la porte. Tu entres avant que je ne la ferme. Une fois que tu es à l'intérieur, je fais entrer la bête et tu te bats.~
@52356 = ~Si tu gagnes, tu sors. Tu reçois une récompense de 250 pièces d'or... et la satisfaction d'une bataille glorieuse. Si tu perds... les esclaves dévorent tes restes. C'est très simple.~
@52357 = ~Quelles sortes de « bêtes » aurais-je à combattre ?~
@52358 = ~Très bien... je combattrai dans ton arène, Szordrin.~
@52359 = ~Quoi ? Mais c'est impossible ! Nous aurions été mis au courant par nos commandants !~
@52360 = ~Non, je n'ai pas le temps.~
@52361 = ~Non, je n'ai pas le temps.~
@52362 = ~Nous capturons nos adversaires lors des escarmouches dans les tunnels, mâle. Des monstres-requins, des dévoreurs, des yeux-tyrans... tout dépend de ce qui survit le plus longtemps, en vérité.~ ~Nous capturons nos adversaires lors des escarmouches dans les tunnels, femelle. Des monstres-requins, des dévoreurs, des yeux-tyrans... tout dépend de ce qui survit le plus longtemps, en vérité.~
@52363 = ~Vos propos ne sont qu'un tissu de mensonges. Vous n'avez pas le droit de continuer à mentir de cette façon, votre chemin s'arrête ici.~
@52364 = ~Comment fonctionne cette arène ?~
@52365 = ~Que la lumière t'emporte, démon ! Tu ne survivras pas à ce jour !~
@52366 = ~Très bien... je combattrai dans ton arène, Szordrin.~
@52367 = ~Grands dieux, femme ! Quelle est cette chose ?~
@52368 = ~C'est un don fait à votre maison, un de ceux qui scellera de futures alliances au-delà de cet accord.~
@52369 = ~Quoi ? Quelques pièces d'or ne vous disent rien ?~
@52370 = ~Ton maître tombera devant la puissance des Voleurs de l'ombre !~
@52371 = ~Calme-toi. Ce n'est qu'une construction, un golem. Irenicus est puissant. Cela ne fait aucun doute.~
@52372 = ~C'est fastidieux. Pourquoi ne pas simplement les tuer ?!~
@52373 = ~Alors offrons-leur une augmentation conséquente du quelconque salaire qu'ils peuvent percevoir.~
@52374 = ~Essayons autre chose. Il faut nous laisser passer ! Les elfes vont attaquer nos troupes !~
@52375 = ~Le mage ne pourra pas se cacher éternellement. Le golem nous apprendra peut-être quelque chose sur Irenicus.~
@52376 = ~Il y a quelque chose ici... laisse-moi faire... Attention ! Ça bouge !~
@52377 = ~C'est une donation pour l'honneur de votre maison ! N'y voyez rien d'autre. Nous ne chercherions jamais à nous attirer votre courroux. C'est un tribut en vue d'alliances futures.~
@52378 = ~Les Mères Matrones ont mieux à faire que de se soucier des rebuts qu'elles ont placé à l'entrée ! Écarte-toi, mâle, nous devons passer !~
@52379 = ~Hum... confirmez-vous ces propos ? Redites-moi votre pensée et je verrai ce que j'en crois. Que les toiles de Lolth vous retiennent prisonnier si vous prêchez le faux.~ ~Hum... confirmez-vous ces propos ? Redites-moi votre pensée et je verrai ce que j'en crois. Que les toiles de Lolth vous retiennent prisonnière si vous prêchez le faux.~
@52380 = ~Non, je n'ai pas le temps.~
@52381 = ~Où est ton maître, démon ? Nous cherchons Irenicus. Livre-nous ce parvenu et tu auras la vie sauve !~
@52382 = ~Non, je n'ai pas le temps.~
@52383 = ~Pas besoin de douter de moi. Laissez-nous participer à l'exécution.~
@52384 = ~Vos doutes ne font que nous ralentir... Laissez-nous participer à l'exécution.~
@52385 = ~Peut-être devrais-je faire le rapport de votre retard. Les Matrones pourront apprécier votre sens du devoir pendant que les corps de notre peuple tomberont aux mains des elfes !~
@52386 = ~Je suis satisfait de voir que tu as du tempérament, mâle. Ton premier adversaire sera une ombre des roches, une créature de bonne taille. Elle est... contrariée.~ ~Je suis satisfait de voir que tu as du tempérament, femelle. Ton premier adversaire sera une ombre des roches, une créature de bonne taille. Elle est... contrariée.~
@52387 = ~Je suis déjà morte, voleur. Rejoins-moi dans les ténèbres...~
@52388 = ~Vous avez raison, bien sûr. Je n'aurais pas dû dire une chose pareille.~
@52389 = ~Assez ! Tuez cette créature et rasez la guilde. Irenicus va savoir ce qu'il en coûte de trahir les Voleurs de l'ombre !~
@52390 = ~Mais les temps sont durs ! Il nous faut survivre ! Il va y avoir... une attaque !~
@52391 = ~Vous adaptez votre histoire à votre convenance ! Pas un mot de ce que vous dites n'est vrai ! Vous serez poursuivis, vous, pauvres menteurs !~
@52392 = ~Comment osez-vous vous comporter comme si de rien n'était ? C'est très regrettable, ce qui ce passe ici...~
@52393 = ~Voilà qui est mieux. Bien, je prends ce que vous m'offrez et le place sur l'avenir de ma maison. C'est-à-dire, si cela est suffisant pour l'honorer dignement.~
@52394 = ~Peut-être voudriez-vous une pièce d'or pour vous convaincre ?~
@52395 = ~Je vais t'ouvrir la porte, maintenant. Entre vite. Si tu survis, reviens me voir après pour la récompense. Va ! Pour Mère Lolth !~
@52396 = ~Vous avez fait votre choix. Alors, passez, mais ne revenez pas sur vos pas ou alors je devrais oublier ma clémence.~
@52397 = ~Très bien, mais je n'accueillerai pas votre retour avec autant de générosité. Ne repassez plus par ici.~
@52398 = ~Comme tu veux, femelle. Puisse le sourire de Reine Araignée éclairer ton chemin, et puisse-t-Elle être sans pitié pour tes ennemis !~
@52399 = ~La maison d'un gardien ? 500 pièces d'or devraient suffire, je crois.~
@52400 = ~J'offre ce que j'estime juste et j'espère que cela conviendra. 1 000 pièces d'or...~
@52401 = ~Vous aurez tout ce que je possède : 1 000 pièces d'or.~
@52402 = ~Tu es une méprisable caricature d'elfe noir, mâle. Va trembler dans un coin, et prie la Reine Araignée pour qu'Elle te donne un peu de caractère un jour ou l'autre.~
@52403 = ~Vous discréditez votre offre en la rendant risible... Non, vous devez mourir ici.~
@52404 = ~Voici 5 000 pièces d'or pour vos bienfaits.~
@52405 = ~Je ne peux vous donner suffisamment pour honorer votre maison, mais je dois aller soutenir nos troupes.~
@52406 = ~Votre maison aurait-elle donc une valeur en or ? Peut-être devrais-je parler aux Mères Matrones du prix de votre respect.~
@52407 = ~C'est d'accord. Passez, mais ne revenez pas par ici, sinon je me montrerai beaucoup moins clément.~
@52408 = ~Je te salue une fois de plus. As-tu changé d'avis ? Es-tu prêt à montrer tes talents, mâle ? Voici quelque temps que je n'ai pas eu la visite d'un elfe noir digne de ce nom.~ ~Je te salue une fois de plus. As-tu changé d'avis ? Es-tu prête à montrer tes talents, femelle ? Voici quelque temps que je n'ai pas eu la visite d'une elfe noire digne de ce nom.~
@52409 = ~Explique-moi comment fonctionnent les combats dans l'arène.~
@52410 = ~Contre quoi me battrais-je exactement ?~
@52411 = ~Oui... je vais combattre dans ton arène, Szordrin.~
@52412 = ~Non, je n'ai pas changé d'avis.~
@52413 = ~Alors, pourquoi venir m'ennuyer ? Je suis là pour m'occuper de la fosse, pas pour répondre aux questions. Il y a des tas d'elfes noirs ivres d'hydromel noir qui pourront te rendre ce service !~
@52414 = ~Je vois que l'ombre des roches n'a pas été vaincue. Veux-tu que j'ouvre la porte une nouvelle fois ? Veux-tu une autre occasion de te couvrir de gloire, mâle ?~ ~Je vois que l'ombre des roches n'a pas été vaincue. Veux-tu que j'ouvre la porte une nouvelle fois ? Veux-tu une autre occasion de te couvrir de gloire, femelle ?~
@52415 = ~Pour sûr. Ouvre la porte et laisse-moi entrer.~
@52416 = ~Qu'est-ce que je gagne à le refaire ?~
@52417 = ~Non, ça ne m'intéresse pas.~
@52418 = ~Très bien ! Je vais prévenir les clients de la taverne qu'une glorieuse bataille va commencer ! Prépare-toi, mâle... la porte va bientôt s'ouvrir, et elle ne sera ouverte que peu de temps.~ ~Très bien ! Je vais prévenir les clients de la taverne qu'une glorieuse bataille va commencer ! Prépare-toi, femelle... la porte va bientôt s'ouvrir, et elle ne sera ouverte que peu de temps.~
@52419 = ~Hmpf. Reviens me voir après la bataille, et je te donnerai 250 pièces d'or pour avoir distrait les clients. Mais bien sûr, c'est la Reine Démon que tu dois impressionner.~
@52420 = ~Très bien... je combattrai dans ton arène.~
@52421 = ~En fait, pour le moment, cela ne m'intéresse pas.~
@52422 = ~Non, ça ne m'intéresse pas.~
@52423 = ~Comme tu le désire, femelle. Je ne peux pas t'en vouloir de refuser de t'abaisser à distraire de vils mâles. Que Lolth te bénisse.~
@52424 = ~Lâche, pleutre et couard ! Bon, bon, va boire ton hydromel noir, si c'est tout ce à quoi tu es bon.~ ~Lâche, pleutre et couarde ! Bon, bon, va boire ton hydromel noir, si c'est tout ce à quoi tu es bonne.~
@52425 = ~En fait, pour le moment, cela ne m'intéresse pas.~
@52426 = ~Ahhh ! La gloire est à toi, mâle ! Je suis sûr que la Reine des Fosses Démoniaques te sourit ! Une ombre des roches n'est pas un mince adversaire !~ ~Ahhh ! La gloire est à toi, femelle ! Je suis sûr que la Reine des Fosses Démoniaques te sourit ! Une ombre des roches n'est pas un mince adversaire !~
@52427 = ~Voici ta récompense. Et maintenant... si tu désires continuer à nous montrer tes talents, un autre esclave attend que tu fasses couler son sang, mâle...~ ~Voici ta récompense. Et maintenant... si tu désires continuer à nous montrer tes talents, un autre esclave attend que tu fasses couler son sang, femelle...~
@52428 = ~Un terrible nabassu des plans inférieurs, capturé par les Vestales parce qu'il avait contrarié une Matrone, et envoyé se battre dans l'arène. Qu'en dis-tu, mâle ?~ ~Un terrible nabassu des plans inférieurs, capturé par les Vestales parce qu'il avait contrarié une Matrone, et envoyé se battre dans l'arène. Qu'en dis-tu, femelle ?~
@52429 = ~Oui, je vais affronter le nabassu dans ton arène.~
@52430 = ~Pas tout de suite. Une autre fois, peut-être.~
@52431 = ~Comme tu préfères, mâle. Les clients sont impressionnés par tes talents... nous attendrons avec impatience ta prochaine démonstration. Reviens, surtout.~ ~Comme tu préfères, femelle. Les clients sont impressionnés par tes talents... nous attendrons avec impatience ta prochaine démonstration. Reviens, surtout.~
@52432 = ~Dois-je t'ouvrir les portes une nouvelle fois ? Le nabassu attend de voir couler ton sang... et je suis sûr qu'il se rit de toi, mâle.~ ~Dois-je t'ouvrir les portes une nouvelle fois ? Le nabassu attend de voir couler ton sang... et je suis sûr qu'il se rit de toi, femelle.~
@52433 = ~Oui. Ouvre la porte, Szordrin.~
@52434 = ~Non, ça ne m'intéresse pas.~
@52435 = ~Non, ça ne m'intéresse pas.~
@52436 = ~Tu as vaincu le nabassu ? Que ton nom soit loué, mâle ! La lutte a été très divertissante... voici 500 pièces d'or pour te remercier du spectacle.~ ~Tu as vaincu le nabassu ? Que ton nom soit loué, femelle ! La lutte a été très divertissante... voici 500 pièces d'or pour te remercier du spectacle.~
@52437 = ~Sois le bienvenu. J'imagine que tu viens te battre en duel dans cette arène parce que tu es lassé d'assister à la mise à mort de monstres pathétiques au nom du sport.~ ~Sois la bienvenue. J'imagine que tu viens te battre en duel dans cette arène parce que tu es lassée d'assister à la mise à mort de monstres pathétiques au nom du sport.~
@52438 = ~Oseras-tu continuer ? Nous avons un prince parmi les monstres-requins... ceux que l'on nomme « sahuagins ». Il est fort, et il a donné du fil à retordre à ceux qui l'on capturé lors d'un raid sur leur ville.~
@52439 = ~C'est un bon combattant, celui-là... mais toi aussi. Peut-être réussiras-tu là où d'autres ont échoué. Qu'en dis-tu, mâle ?~ ~C'est un bon combattant, celui-là... mais toi aussi. Peut-être réussiras-tu là où d'autres ont échoué. Qu'en dis-tu, femelle ?~
@52440 = ~Je vais le faire. Ouvre la porte, Szordrin.~
@52441 = ~Non, pas maintenant. Plus tard, peut-être.~
@52442 = ~Ah, je vois, je vois. Tu souhaites peut-être guérir de tes blessures ? C'est compréhensible. Nous attendrons avec impatience que tu reviennes nous faire l'honneur d'une autre démonstration.~
@52443 = ~As-tu décidé d'affronter le monstre-requin, mâle ? Tes combats nous ont grandement diverti jusqu'ici, et il serait dommage de t'arrêter.~ ~As-tu décidé d'affronter le monstre-requin, femelle ? Tes combats nous ont grandement diverti jusqu'ici, et il serait dommage de t'arrêter.~
@52444 = ~Oui, je vais le combattre. Ouvre les portes, Szordrin.~
@52445 = ~Non, cela ne m'intéresse pas pour le moment.~
@52446 = ~Non, cela ne m'intéresse pas pour le moment.~
@52447 = ~Le monstre-requin est vaincu ! La Reine Araignée te sourit ! Cette bête avait tué bien des elfes noirs plus faibles... il est bon de voir qu'elle a été remise à sa place !~
@52448 = ~Tu as fait tes preuves, mâle. Pour ta performance, je te donne 750 pièces d'or. Prends-les, et saches que tu es digne de la faveur de Lolth.~ ~Tu as fait tes preuves, femelle. Pour ta performance, je te donne 750 pièces d'or. Prends-les, et saches que tu es digne de la faveur de Lolth.~
@52449 = ~Inutile de continuer. Personne n'a été capable de battre le, ah... le seul esclave qui nous reste. Te faire tuer par cette créature serait du gâchis, mâle.~ ~Inutile de continuer. Personne n'a été capable de battre le, ah... le seul esclave qui nous reste. Te faire tuer par cette créature serait du gâchis, femelle.~
@52450 = ~Un mâle aussi respecté que toi sais que le seul adversaire à même de se mesurer à un elfe noir est un autre elfe noir. Je t'offre cette opportunité.~ ~Une femelle aussi respectée que toi sais que le seul adversaire à même de se mesurer à un elfe noir est un autre elfe noir. Je t'offre cette opportunité.~
@52451 = ~Le prochain combat est sur le point de commencer. Notre plus illustre compétiteur va donc pouvoir exercer ses talents.~
@52452 = ~Quelle sorte d'esclave ? Quel type de créature ?~
@52453 = ~Alors, je m'en vais.~
@52454 = ~Bien sûr. Personne ne pourra te tenir rigueur de ta décision. Marche la tête haute, mâle... tu t'es bien battu.~ ~Bien sûr. Personne ne pourra te tenir rigueur de ta décision. Marche la tête haute, femelle... tu t'es bien battue.~
@52455 = ~C'est... un œil-tyran, mâle, le fléau d'Ombre-Terre. Il a été capturé il y a quatre ans par un groupe d'elfes noirs animés par la vengeance. Il est invaincu depuis ce jour.~ ~C'est... un œil-tyran, femelle, le fléau d'Ombre-Terre. Il a été capturé il y a quatre ans par un groupe d'elfes noirs animés par la vengeance. Il est invaincu depuis ce jour.~
@52456 = ~Ses pouvoirs sont nombreux et meurtriers. Seuls les guerriers les plus braves ont tenté de l'affronter, et ils sont tous morts. Inutile de le combattre, mâle... à moins que tu ne le désires...~ ~Ses pouvoirs sont nombreux et meurtriers. Seuls les guerriers les plus braves ont tenté de l'affronter, et ils sont tous morts. Inutile de le combattre, femelle... à moins que tu ne le désires...~
@52457 = ~Je vais le combattre, Szordrin. Ouvre la porte.~
@52458 = ~Je vois. Peut-être une autre fois.~
@52459 = ~Tu es sûr ? Excellent ! ATTENTION TOUT LE MONDE : un vaillant mâle elfe noir a accepté d'affronter le plus horrible de nos esclaves de bataille ! Le redoutable et redouté ŒIL-TYRAN !~ ~Tu es sûre ? Excellent ! ATTENTION TOUT LE MONDE : une vaillante femelle elfe noire a accepté d'affronter le plus horrible de nos esclaves de bataille ! Le redoutable et redouté ŒIL-TYRAN !~
@52460 = ~Je vais t'ouvrir la porte... entre vite, car je ne la garderai pas longtemps ouverte. Que Lolth te bénisse.~
@52461 = ~Salut à toi, ô redoutable. Tu... tu n'as pas décidé d'affronter le dernier de nos esclaves de bataille, n'est-ce pas ? La Reine Araignée serait très impressionnée si tu prenais ce risque !~
@52462 = ~Quelle sorte de créature aurais-je à combattre ?~
@52463 = ~Oui, je vais la combattre. Ouvre les portes.~
@52464 = ~Non, je ne crois pas.~
@52465 = ~Tu... tu as tué l'œil-tyran ? Tu es digne de toutes les louanges et de toutes les bénédictions de Mère Lolth ! Voici... 1 000 pièces d'or en récompense du spectacle !~
@52466 = ~Je vois pourquoi la Maison Despana s'intéresse tant à toi. Même si tu es Nasadran, un mâle avec ton potentiel serait un ajout bienvenu pour n'importe quelle Maison !~ ~Je vois pourquoi la Maison Despana s'intéresse tant à toi. Même si tu es Nasadrane, une femelle avec ton potentiel serait un ajout bienvenu pour n'importe quelle Maison !~
@52467 = ~Malheureusement, il ne me reste plus d'esclaves de bataille... aucun qui soit digne de toi, en tout cas. Reviens plus tard, je vais voir ce que je peux récupérer, d'accord ?~
@52468 = ~Très bien. Alors, parle-moi de la Maison Despana.~
@52469 = ~Sais-tu quelque chose sur des dragons qui vivraient aux alentours ?~
@52470 = ~J'ai entendu dire que l'armée des elfes noirs était « occupée ». Sais-tu ce qu'elle fait ?~
@52471 = ~Faute de mieux, tu pourrais peut-être entrer dans l'arène, et je te combattrai.~
@52472 = ~Bon... Je vais passer mon chemin, dans ce cas-là.~
@52473 = ~Despana ? Une Maison puissante, dirigée par la Matrone Ardulace. Certains disent qu'un jour, ce sera la plus puissante d'Ust Natha... mais Mère Lolth est parfois capricieuse.~
@52474 = ~Il paraît que la Matrone s'intéresse aux réfugiés de Ched Nasad, autrement dit à vous, je suppose. Tes talents de combattant doivent en être la raison.~ ~Il paraît que la Matrone s'intéresse aux réfugiés de Ched Nasad, autrement dit à vous, je suppose. Tes talents de combattante doivent en être la raison.~
@52475 = ~Sais-tu quelque chose sur des dragons qui vivraient aux alentours ?~
@52476 = ~J'ai entendu dire que l'armée des elfes noirs était « occupée ». Sais-tu ce qu'elle fait ?~
@52477 = ~Faute de mieux, tu pourrais peut-être entrer dans l'arène, et je te combattrai.~
@52478 = ~Je m'en vais alors.~
@52479 = ~Les rumeurs sur les draconiens vont et viennent. Certains disent même que les Matrones commercent avec les redoutables dragons d'ombres des régions inférieures.~
@52480 = ~Le seul dont nous connaissons l'existence avec certitude est la terrible bête d'argent qui chasse les patrouilles d'elfes noirs lorsqu'elles s'aventurent près des anciens passages de notre première descente.~
@52481 = ~Je n'en sais rien. Peut-être l'un des conteurs, là-bas, pourra-t-il t'aider... si cela t'intéresse vraiment.~
@52482 = ~Alors, dis-moi ce que tu sais sur la Maison Despana.~
@52483 = ~J'ai entendu dire que l'armée des elfes noirs était « occupée ». Sais-tu ce qu'elle fait ?~
@52484 = ~Faute de mieux, tu pourrais peut-être entrer dans l'arène, et je te combattrai.~
@52485 = ~Je m'en vais alors.~
@52486 = ~On murmure que les traîtres détestés de la surface vont subir une grande saignée... à moins qu'une guerre ne se prépare contre les dévoreurs.~
@52487 = ~Mais tu as raison... Les Matrones rassemblent magiciens et guerriers. Mais tant qu'elles n'auront pas annoncé leurs plans, personne ne les connaîtra.~
@52488 = ~Alors, dis-moi ce que tu sais sur la Maison Despana.~
@52489 = ~Sais-tu quelque chose sur des dragons qui vivraient aux alentours ?~
@52490 = ~Faute de mieux, tu pourrais peut-être entrer dans l'arène, et je te combattrai.~
@52491 = ~Je m'en vais alors.~
@52492 = ~Euh... je ne suis pas assez bon pour toi, mâle. Si tu as à ce point soif de sang, je vais aller aux cages et voir s'il n'y a pas là-bas quelque chose de plus... adapté à tes goûts.~ ~Euh... je ne suis pas assez bon pour toi, femelle. Si tu as à ce point soif de sang, je vais aller aux cages et voir s'il n'y a pas là-bas quelque chose de plus... adapté à tes goûts.~
@52493 = ~Comme tu le désire, mâle. Puisse Mère Lolth te sourire sur ton chemin.~ ~Comme tu le désire, femelle. Puisse Mère Lolth te sourire sur ton chemin.~
@52494 = ~P-pitié... Arrêtez ! *gémit* Je vous en supplie ! Je... je n'ai rien fait pour vous offenser, n'est-ce pas ?~
@52495 = ~Je... je serai un esclave parfait ! Juré ! M-mais... n-ne faites pas ça !~
@52496 = ~Non ! Pitié ! Je n-ne veux pas m-m-mourir ! N-n'appuyez pas sur le bouton !~
@52497 = ~*gémit* Ooohhh... oooohhh, nooon, non...~
@52498 = ~Merci, mais je ne le souhaite pas.~
@52499 = ~Très bien, voyons ce qu'il en est.~
@52500 = ~J'ose croire que vous n'avez pas l'intention de faire combattre nos guerriers contre des prisonniers. Cela n'aurait plus rien d'une bataille.~
@52501 = ~Oui, voyons ce duel. Peut-être tenterai-je ma chance contre le vainqueur.~
@52502 = ~Métamorphose en loup-garou majeur~
@52503 = ~En aucune façon. Cela ne serait pas digne de la sorte de combattants que nous avons pour habitude d'employer. Tu ne verras ici que de la qualité.~
@52504 = ~Parfait. Que les combattants se préparent. Nous allons vivre un grand moment.~
@52505 = ~Je vous prie de m'excuser, honorable. Je ne voulais pas me mettre dans vos jambes. Je vous en supplie, ne m'envoyez pas à la torture, je vous promets d'essayer de faire mieux.~
@52506 = ~Ah ! Nos plats ne sont-ils pas à votre convenance, honorable ? Nous cuisinons... exactement selon vos requêtes, je vous en prie, vous devez me croire !~
@52507 = ~Je fais de mon mieux pour cuisiner aussi rapidement que possible, honorable. Permettez-moi de ne pas vous déranger par mon travail.~
@52508 = ~Hors de ma vue, tu m'empoisonnes, à la fin ! J'essaie tant que je peux de travailler, tu ne le voies donc pas ?~
@52509 = ~Si tu ne cesses de me déranger, tu vas faire partie du menu, toi aussi ! Je ne souffrirai pas les coups du bâtonnet à tentacules par ta faute !~
@52510 = ~Dégage de ma cuisine ! Je n'ai pas besoin de toi dans mes pattes !~
@52511 = ~Je te salue, mâle. Tu viens d'arriver de Ched Nasad, exact ? On m'a parlé de toi.~ ~Je te salue, femelle. Tu viens d'arriver de Ched Nasad, exact ? On m'a parlé de toi.~
@52512 = ~Puis-je avoir votre attention, s'il vous plaît ! Avec la permission de nos éminentes dames et de nos messieurs les plus hardis, je vous prie de tourner vos regards vers la fosse !~
@52513 = ~Nous autres elfes noirs, nous nous réunissons pour raconter nos conquêtes légendaires de la surface. Nos sombres histoires du passé. C'est une tradition à Ust Natha, et cette ville fut la première.~
@52514 = ~Merinid~
@52515 = ~Merinid~
@52516 = ~Baragh~
@52517 = ~Baragh~
@52518 = ~Tathlyn~
@52519 = ~Lesaonar, le maître des lames, fierté de la Première Maison, est venu exercer ses talents. Il a accepté de relever un défi inhabituel.~
@52520 = ~Tathlyn~
@52521 = ~Nym Khalazza~
@52522 = ~Nym Khalazza~
@52523 = ~Si tu souhaites une réponse honnête, mâle, tu devrais plutôt t'adresser à Nym Khalazza, là. C'est le doyen de ce groupe et c'est aussi le plus enclin à la discussion.~ ~Si tu souhaites une réponse honnête, femelle, tu devrais plutôt t'adresser à Nym Khalazza, là. C'est le doyen de ce groupe et c'est aussi le plus enclin à la discussion.~
@52524 = ~Puis-je te poser quelques questions ?~
@52525 = ~Que veux-tu dire par « la première » ?~
@52526 = ~As-tu des légendes à me raconter ?~
@52527 = ~Je dois partir.~
@52528 = ~Tu as dit « la première » tout à l'heure. Que voulais-tu dire ?~
@52529 = ~Quatre membres de la Société des Combattants ont été exposés à des propos calomnieux, et ils exigent à présent réparation. Le mépris de Lesaonar est grand, et il s'apprête à affronter les quatre en même temps !~
@52530 = ~À présent, observe. La vie de ces hommes va se jouer dans la fosse, et leur destin, dans leurs lames ! Le vainqueur s'emparera de l'équipement des vaincus.~
@52531 = ~*l'ignoble puanteur de la mort assaille vos narines... des tombeaux bordent ce hall, et vous entendez le bruit des pas traînants à l'intérieur*~
@52532 = ~Alors, as-tu des légendes à me raconter ?~
@52533 = ~Je vais aller le voir.~
@52534 = ~Hmmpf. Tu ne connais pas bien nos traditions si tu ne comprends pas de quoi je veux parler, mâle. Tu dois bien savoir QUELQUE CHOSE de notre histoire, non ?~ ~Hmmpf. Tu ne connais pas bien nos traditions si tu ne comprends pas de quoi je veux parler, femelle. Tu dois bien savoir QUELQUE CHOSE de notre histoire, non ?~
@52535 = ~Il y a très longtemps, quand nos méprisables cousins de la surface nous bannirent dans les profondeurs, c'est près de cet endroit que les elfes noirs descendirent pour la première fois.~
@52536 = ~Une redoutable légion, affrontant des ennemis implacables dans les moindres recoins d'Ombre-Terre. C'est à cet endroit que nous nous sommes réunis pour la première fois afin de nous protéger.~
@52537 = ~Ust Natha veut dire « la première »... le premier endroit de réunion. Celui où nous avons repris notre pouvoir après la condamnation de nos haïssables cousins.~
@52538 = ~C'est à partir d'Ust Natha que nous avons lancé l'invasion des villes du Peuple Robuste et que nous avons fondé le premier grand royaume de Telantiwar, dans la merveilleuse Bhaerynden.~
@52539 = ~Bhaerynden et Telantiwar ont disparu, mais Ust Natha est toujours là. Pour nous rappeler notre dette de sang envers nos frères maudits de la surface.~
@52540 = ~*ces tombes sont étrangement silencieuses, mais vous avez pourtant l'impression qu'on vous observe... prudence, ces tombes regorgent de nombreux pièges et autres dangers... chacun de vos pas pourrait être le dernier*~
@52541 = ~Ust Natha est donc proche de la surface ?~
@52542 = ~Puis-je te poser quelques questions ?~
@52543 = ~As-tu d'autres légendes à me raconter ?~
@52544 = ~Je dois partir.~
@52545 = ~Non, mais c'est la plus proche. Le passage qui mène vers la surface est tout près d'ici. Mais il est gardé par la grande créature d'argent, et donc inaccessible pour nous.~
@52546 = ~Gardé ? Que se passerait-il si, disons... si le passage n'était plus gardé ?~
@52547 = ~Je pense qu'il y a d'autres protections contre nous... mais la créature d'argent est la plus grande de toutes.~
@52548 = ~Si le passage n'était plus gardé, nous pourrions sans aucun doute éliminer les autres gardiens, et enfin rendre visite à nos ignobles cousins.~
@52549 = ~Puis-je te poser quelques questions ?~
@52550 = ~As-tu d'autres légendes à me raconter ?~
@52551 = ~Je dois partir.~
@52552 = ~Je n'ai pas encore accompli beaucoup d'exploits, mâle. J'ai terminé la Saignée il y a un an seulement, lorsque j'ai fait un long voyage vers la surface avec deux frères.~ ~Je n'ai pas encore accompli beaucoup d'exploits, femelle. J'ai terminé la Saignée il y a un an seulement, lorsque j'ai fait un long voyage vers la surface avec deux frères.~
@52553 = ~La surface est viciée et aveuglante... mais avec mes frères, nous avons trouvé l'une des elfes de la surface. Une femme pâle et délicieuse à contempler.~
@52554 = ~Elle fut presque trop facile à tuer. Nous étions pourchassés par des patrouilles d'elfes et mes frères furent tués aussi, mais j'ai ramené la tête de la femme vers l'Ombre-Terre.~
@52555 = ~C'était un beau trophée pour une Saignée. Ma Matrone était satisfaite, et a parrainé mon entrée dans la Société des Combattants l'année suivante.~
@52556 = ~As-tu d'autres légendes à me raconter ?~
@52557 = ~Puis-je te poser quelques questions ?~
@52558 = ~Tu as dit « la première » tout à l'heure. Que voulais-tu dire ?~
@52559 = ~Je vais y aller.~
@52560 = ~Non, pas vraiment. Je suis surtout ici pour écouter parler les autres.~
@52561 = ~Tu fais ce que tu veux.~
@52562 = ~La bataille aura lieu malgré tout. Tu peux assister au spectacle, mais ne gêne pas les spectateurs.~
@52563 = ~Ah ! Puis-te t'aider en quoi que ce soit, mâle ?~ ~Ah ! Puis-te t'aider en quoi que ce soit, femelle ?~
@52564 = ~Puis-je te poser une ou deux questions ?~
@52565 = ~Tu as dit « la première » tout à l'heure... que voulais-tu dire ?~
@52566 = ~As-tu des légendes personnelles à raconter ?~
@52567 = ~Rien, merci.~
@52568 = ~Je suis vainqueur ! Comme je le disais, ils n'étaient que des vers de terre ! Leur maison est faible, leurs lames ternes et alanguies !~
@52569 = ~Vous leur étiez visiblement supérieur en âge et en compétence. Vous jubilez souvent de vos victoires sur des enfants ?~
@52570 = ~Un beau combat, mais je parie qu'il en est d'autres qui pourraient vous battre.~
@52571 = ~Bien joué. Vous êtes visiblement un guerrier accompli... pour un mâle.~
@52572 = ~Une très belle démonstration. Avez-vous déjà croisé votre égal ?~
@52573 = ~Soyez le bienvenu, ô puissant mâle. Restez un moment, si vous le souhaitez... nous échangeons des histoires sur les exploits et les légendes du passé. J'ai peur que les Nasadrans n'en aient que rarement le temps, hein ?~ ~Soyez la bienvenue, ô puissante femelle. Restez un moment, si vous le souhaitez... nous échangeons des histoires sur les exploits et les légendes du passé. J'ai peur que les Nasadranes n'en aient que rarement le temps, hein ?~
@52574 = ~Quoi ? Qui me calomnie ? Venez dans la fosse si vous pensez pouvoir me battre !~
@52575 = ~Et où sont-ils ? Seriez-vous de ceux-là ? Venez prouver vos prétentions ! Je vous attends !~
@52576 = ~Je vois. Vous me flattez avec vos insultes. Je survivrai à tous vos efforts, si vous osez vous mesurer à moi. Et il en va de même pour toute personne présente.~
@52577 = ~Si c'était le cas, je serais mort. Nul ne l'a emporté sur moi et nul ne le fera. Est-ce que quelqu'un ici veut se mesurer à moi ? Personne ne l'ose ?~
@52578 = ~Un défi a été lancé. Le relèveras-tu ? Si tu as besoin de temps pour te préparer, je te l'accorde. Nous ne voulons ici que les meilleurs combattants.~
@52579 = ~Cette bataille mettra en présence deux combattants. L'heure n'est plus aux massacres inconsidérés.~
@52580 = ~J'ai une histoire pour vous, si cela vous intéresse. Une histoire que m'a contée la mère de ma maison. Si le cœur vous en dit, bien sûr...~
@52581 = ~Vous ! Je sais que vous êtes un prêtre de Heaum ! Votre dieu a besoin de vous !~ ~Vous ! Je sais que vous êtes une prêtresse de Heaum ! Votre dieu a besoin de vous !~
@52582 = ~Moi, Veldrin, j'accepte de livrer bataille. Conduis-moi à la fosse aux combats.~
@52583 = ~Guerrier elfe noir~
@52584 = ~Le moment est mal choisi. Je reviendrai une fois prêt.~ ~Le moment est mal choisi. Je reviendrai une fois prête.~
@52585 = ~Bien sûr, j'aimerais l'entendre.~
@52586 = ~En fait, j'aurais quelques questions...~
@52587 = ~Une autre fois, peut-être.~
@52588 = ~Je ne suis pas d'humeur à être assaillie de questions par un nouveau venu en ville. Vous avez déjà de la chance de ne pas être dans l'enclos des esclaves. Si vous devez vraiment importuner quelqu'un, allez voir Nym.~ ~Je ne suis pas d'humeur à être assaillie de questions par une nouvelle venue en ville. Vous avez déjà de la chance de ne pas être dans l'enclos des esclaves. Si vous devez vraiment importuner quelqu'un, allez voir Nym.~
@52589 = ~Qu'il en soit ainsi. Nous t'attendrons.~
@52590 = ~Qu'il en soit fait selon ton désir ! Oyez, public, voici à présent un nouveau défi ! Veldrin va entrer dans l'arène et affronter Lesaonar !~
@52591 = ~D'accord, racontez-moi plutôt votre histoire.~
@52592 = ~Alors je vais aller lui parler.~
@52593 = ~Alors Allez-vous-en !~
@52594 = ~Excellent ! Mon histoire... mon histoire se situe à une époque très reculée, quand notre peuple est descendu dans les profondeurs des cavernes obscures. Alors que nos demeures n'étaient pas encore faites de pierre et d'argile.~
@52595 = ~Les demeures des elfes noirs étaient faites de brindilles et de mousse, cette mousse noire que beaucoup avaient amené dans l'Ombre-Terre. Les maisons étaient peu nombreuses, bien sûr, mais la plus grande était déjà celle de la première Matrone.~
@52596 = ~La Matrone dirigeait les premières hordes d'elfes noirs, les aidant à survivre dans ces lieux hostiles. Elle était forte, puissante, et rusée... un grand bienfait pour son peuple, qui l'admirait énormément.~
@52597 = ~Pour lui faire honneur, un groupe d'elfes noirs s'en prit au peuple Requin et parvint à voler la pierre sculptée qui servait de trône à leur roi. Voulant offrir ce trophée à la Matrone, ils cachèrent la pierre à l'étage de sa demeure pour lui en faire la surprise.~
@52598 = ~Nous avons besoin d'un vassal pour libérer notre colère ! Vous là ! En tant que prêtre de Talos vous devez devenir l'instrument de la vengeance du Seigneur des Tempêtes.~ ~Nous avons besoin d'un vassal pour libérer notre colère ! Vous là ! En tant que prêtresse de Talos vous devez devenir l'instrument de la vengeance du Seigneur des Tempêtes.~
@52599 = ~Quand la Matrone revint chez elle, les guerriers drows montèrent chercher la pierre, mais ils virent avec horreur le trône, trop lourd pour les structures de mousse, passer au travers et écrabouiller la Matrone en dessous.~
@52600 = ~C'est une triste histoire de nos premiers labeurs dans cet endroit obscur... et qui contient également une morale. Pouvez-vous deviner cette morale, mâle ?~ ~C'est une triste histoire de nos premiers labeurs dans cet endroit obscur... et qui contient également une morale. Pouvez-vous deviner cette morale, femelle ?~
@52601 = ~Ha ! Ha, ha ! La morale est « pierre qui croule arrache la mousse », bien sûr !~
@52602 = ~Oui ! Oui ! C'est exactement ça !~
@52603 = ~Bah ! La Reine Araignée n'a pas de sens de l'humour ! Vhaeraun, au contraire...~
@52604 = ~Le Seigneur Masqué n'avance pas seul, crétins ! Je reviendrai !~
@52605 = ~Hum. Pierre qui croule arrache la mousse ?~
@52606 = ~Vous là-bas ! Vous êtes un prêtre de Lathandre. Le Seigneur de l'Aube a besoin pour un temps de vos services.~ ~Vous là-bas ! Vous êtes une prêtresse de Lathandre. Le Seigneur de l'Aube a besoin pour un temps de vos services.~
@52607 = ~Bouh le sait bien ! Pierre qui croule arrache la mousse !~
@52608 = ~Ce n'est qu'une morale simpliste, imbécile. « Pierre qui croule arrache la mousse », n'est-ce pas ? Le moineau a-t-il raison ?~
@52609 = ~Je n'en ai pas la moindre idée.~
@52610 = ~Imbécile ! Comment oses-tu raconter un mensonge aussi crétin sur l'histoire de notre peuple ! Pour une telle folie, Lolth te condamnera à une éternité d'agonie empoisonnée !~
@52611 = ~Tu oses ! Je te tuerai au nom de la mère de tous les elfes noirs, débile ! Il est à moi... personne ne doit intervenir !~
@52612 = ~Hum. Vous revenez vers moi ? Peut-être qu'après tout vous voulez entendre mon récit ?~
@52613 = ~Bien, écoutons ça.~
@52614 = ~En fait je me demandais si vous pourriez me parlez d'autre chose ?~
@52615 = ~Non, pas vraiment.~
@52616 = ~Te voici à nouveau parmi nous. Es-tu prêt à entrer dans l'arène et à affronter Lesaonar ?~ ~Te voici à nouveau parmi nous. Es-tu prête à entrer dans l'arène et à affronter Lesaonar ?~
@52617 = ~Informe-le que Veldrin l'affrontera en combat singulier.~
@52618 = ~Non. Je ne suis pas encore prêt.~ ~Non. Je ne suis pas encore prête.~
@52619 = ~N'y aurait-il pas d'autres combattants susceptibles de me livrer bataille ?~
@52620 = ~Non. Lesaonar n'a pas obtenu satisfaction, il ne quittera pas la fosse sans avoir démontré ses talents.~
@52621 = ~Informe-le que Veldrin l'affrontera en combat singulier.~
@52622 = ~Je souhaite l'affronter, mais je ne suis pas prêt.~ ~Je souhaite l'affronter, mais je ne suis pas prête.~
@52623 = ~Tu m'ennuies. À présent, regarde le combat.~
@52624 = ~<PLAYER2> va affronter Lesaonar.~
@52625 = ~<PLAYER3> va affronter Lesaonar.~
@52626 = ~<PLAYER4> va affronter Lesaonar.~
@52627 = ~<PLAYER5> va affronter Lesaonar.~
@52628 = ~<PLAYER6> va affronter Lesaonar.~
@52629 = ~<PLAYER2> va affronter Lesaonar.~
@52630 = ~<PLAYER3> va affronter Lesaonar.~
@52631 = ~<PLAYER4> va affronter Lesaonar.~
@52632 = ~<PLAYER5> va affronter Lesaonar.~
@52633 = ~<PLAYER6> va affronter Lesaonar.~
@52634 = ~Nous racontons des légendes, mâle, de nos exploits et de notre histoire. C'est une vieille coutume d'Ust Natha... quelque chose que tu ne connais pas, Nasadran.~ ~Nous racontons des légendes, femelle, de nos exploits et de notre histoire. C'est une vieille coutume d'Ust Natha... quelque chose que tu ne connais pas, Nasadrane.~
@52635 = ~Alors, parle-moi de l'histoire d'Ust Natha.~
@52636 = ~Alors, parle-moi de tes exploits.~
@52637 = ~Métamorphose en loup-garou~
@52638 = ~Qu'il en soit fait selon ton désir ! Oyez, public, voici à présent un nouveau défi ! <PLAYER2> va entrer dans l'arène et affronter Lesaonar !~
@52639 = ~Qu'il en soit fait selon ton désir ! Oyez, public, voici à présent un nouveau défi ! <PLAYER3> va entrer dans l'arène et affronter Lesaonar !~
@52640 = ~Qu'il en soit fait selon ton désir ! Oyez, public, voici à présent un nouveau défi ! <PLAYER4> va entrer dans l'arène et affronter Lesaonar !~
@52641 = ~Qu'il en soit fait selon ton désir ! Oyez, public, voici à présent un nouveau défi ! <PLAYER5> va entrer dans l'arène et affronter Lesaonar !~
@52642 = ~Pourrais-tu répondre à quelques questions ?~
@52643 = ~Alors, je m'en vais.~
@52644 = ~L'histoire de la ville, hein ? Oui, je suppose que tu ne sais rien d'elle, pauvre ignorant. Sais-tu au moins quel rôle Ust Natha a joué lors de la Dispersion ?~ ~L'histoire de la ville, hein ? Oui, je suppose que tu ne sais rien d'elle, pauvre ignorante. Sais-tu au moins quel rôle Ust Natha a joué lors de la Dispersion ?~
@52645 = ~La Dispersion ?~
@52646 = ~Bah ! Es-tu complètement dénué de sens ? Ta maîtresse devrait être écorchée vive pour avoir négligé ton instruction !~ ~Bah ! Es-tu complètement dénuée de sens ? Ta maîtresse devrait être écorchée vive pour avoir négligé ton instruction !~
@52647 = ~Lorsque les batailles magiques ont provoqué la chute de Bhaerynden, la grande caverne autrefois tenue par les nains, la plupart des elfes noirs ont été écrasés. Seuls quelques élus ont survécu.~
@52648 = ~Qu'il en soit fait selon ton désir ! Oyez, public, voici à présent un nouveau défi ! <PLAYER6> va entrer dans l'arène et affronter Lesaonar !~
@52649 = ~Des groupes d'elfes noirs ont fui les décombres, cherchant de nouvelles places fortes pour établir leur pouvoir, attaqués par nos ennemis. Voilà ce qu'a été la Dispersion, imbécile.~
@52650 = ~<PLAYER2> va affronter Lesaonar.~
@52651 = ~<PLAYER3> va affronter Lesaonar.~
@52652 = ~<PLAYER4> va affronter Lesaonar.~
@52653 = ~<PLAYER5> va affronter Lesaonar.~
@52654 = ~<PLAYER6> va affronter Lesaonar.~
@52655 = ~Ust Natha a été épargnée par la grande guerre, et des hordes d'elfes noirs sont venus s'abriter dans ses murs. Des dévoreurs et des yeux-tyrans les suivaient, cherchant à les éradiquer.~
@52656 = ~Pendant un siècle, nos ennemis nous ont livré une guerre constante. Mais les murs d'Ust Natha ont tenu... et nous avons repoussé l'ennemi dans une victoire implacable.~
@52657 = ~Beaucoup d'elfes noirs quittèrent ensuite Ust Natha à la recherche de grands espaces pour y vivre, de ressources à piller... et fondèrent ta chère Ched Nasad, entre autres.~
@52658 = ~Ched Nasad n'existerait pas aujourd'hui sans les murs d'Ust Natha. Voilà le rôle qu'Ust Natha a joué dans la Dispersion. Ne l'oublie jamais.~
@52659 = ~Parle-moi de tes exploits.~
@52660 = ~Puis-je te demander quelque chose ?~
@52661 = ~Je m'en vais.~
@52662 = ~L'elfe noir le plus talentueux a remporté la bataille. Lesaonar reste invaincu. Il soigne à présent ses blessures. Seras-tu son prochain adversaire ?~
@52663 = ~ATTENDEZ ! Je...~
@52664 = ~Je m'incline. Vous avez prouvé votre supériorité aujourd'hui. Je... je vous abandonne la victoire. Mon épée vous appartient, je ne la mérite plus.~
@52665 = ~J'en ai massacré beaucoup dans le temps, mâle, ne me pose pas cette question comme si tu l'ignorais. Je suis aussi aguerri que n'importe quel membre des Sociétés de Combattants.~ ~J'en ai massacré beaucoup dans le temps, femelle, ne me pose pas cette question comme si tu l'ignorais. Je suis aussi aguerri que n'importe quel membre des Sociétés de Combattants.~
@52666 = ~J'ai participé à un Raid glorieux il y a une centaine d'années, lorsqu'une caverne menant à la surface fut découverte. J'ai participé à l'attaque des communautés pendant la chasse.~
@52667 = ~Nombreux furent les humains pathétiques qui périrent par nos lames lors de ce Raid, pour la gloire d'Ust Natha. J'ai découvert un village de cette sous-race que l'on appelle les « petites-personnes ».~
@52668 = ~Guerrier elfe noir~
@52669 = ~Ces minuscules vers de terre se sont enfuis ! Je les ai tous traqués... j'ai encore leurs petits crânes aujourd'hui. Le Raid dura une bonne semaine avant que les humains n'organisent leur défense.~
@52670 = ~Les humains ont comblé le tunnel, mais un jour, nous en trouverons un autre... et je prie pour faire encore partie des elfes noirs qui participeront au Raid !~
@52671 = ~Je... vois. Mais la ville ? Que peux-tu me dire de son histoire ?~
@52672 = ~Puis-je te demander autre chose ?~
@52673 = ~Non. Je préfère ne pas ajouter mon nom à sa liste.~
@52674 = ~Oui, Veldrin est prêt à livrer bataille.~ ~Oui, Veldrin est prête à livrer bataille.~
@52675 = ~<PLAYER2> va affronter Lesaonar.~
@52676 = ~<PLAYER3> va affronter Lesaonar.~
@52677 = ~<PLAYER4> va affronter Lesaonar.~
@52678 = ~<PLAYER5> va affronter Lesaonar.~
@52679 = ~<PLAYER6> va affronter Lesaonar.~
@52680 = ~Je vois. Je... je m'en vais.~
@52681 = ~Je raconte mes histoires quand je le veux, et tu ne peux pas m'y inciter. Si tu veux poser des questions insipides, va donc ennuyer quelqu'un d'autre !~
@52682 = ~Alors, parle-moi de l'histoire de la ville.~
@52683 = ~Alors, parle-moi de tes exploits.~
@52684 = ~C'est ce que je vais faire.~
@52685 = ~Oui, fais-le. Va-t'en.~
@52686 = ~Hééééé... vous êtes celui qui cherche refuge loin de Ched Nasad, n'est-ce pas, mâle ? Je ne partage pas mes récits avec des gens tels que vous.~ ~Hééééé... vous êtes celle qui cherche refuge loin de Ched Nasad, n'est-ce pas, femelle ? Je ne partage pas mes récits avec des gens tels que vous.~
@52687 = ~J'ai scié les tentacules de la tête des dévoreurs, arraché les dents de la bouche de bébés humains, et plongé mes poignards dans l'œil d'un œil-tyran... mais ces récits sont trop précieux pour être partagés avec vous.~
@52688 = ~Du large ! Faites subir à d'autres votre odieuse présence, mâle.~ ~Du large ! Faites subir à d'autres votre odieuse présence, femelle.~
@52689 = ~L'imbécile blasphématoire ! Maintenant je dois aller expliquer cette mort aux Vestales ! Bah ! Un immonde suppôt de Vhaeraun... ici !~
@52690 = ~Il est à moi ! Dégagez ! Mêlez-vous de ça et je vous ferai écorcher vif, mâle !~ ~Il est à moi ! Dégagez ! Mêlez-vous de ça et je vous ferai écorcher vive, femelle !~
@52691 = ~Hum... Je ne vous reconnais pas. Qu'un tel mâle aussi puissant débarque ainsi de nulle part est pour le moins inhabituel.~ ~Hum... Je ne vous reconnais pas. Qu'une telle femelle aussi puissante débarque ainsi de nulle part est pour le moins inhabituel.~
@52692 = ~Lesaonar n'était qu'un pantin. Je n'ai pas vraiment eu à me surpasser.~
@52693 = ~Merci. Je m'enorgueillis de mes capacités.~
@52694 = ~Rien de tout cela ne vous concerne. À moins que vous ne puissiez nous faire les honneurs de votre Maison.~
@52695 = ~Je vois. Vous ne verrez donc aucune objection à m'affronter. Lesaonar était mon favori et son honneur est celui de la Première Maison.~
@52696 = ~Vous irez voir Sondal lorsque vous serez prêt à m'affronter. Vous avez une dette d'honneur envers moi.~ ~Vous irez voir Sondal lorsque vous serez prête à m'affronter. Vous avez une dette d'honneur envers moi.~
@52697 = ~Soit. Nous allons voir cela d'ici peu. Lesaonar est mon favori et l'honneur de la Première Maison est en jeu.~
@52698 = ~Ah ! Je ne vous ai pas vu approcher. J'ai la vue qui baisse, et bientôt je me ferai poignarder dans le dos sans rien voir. Je devrais être chez moi, mourant comme un vieil elfe, plutôt qu'écouter ici si souvent des récits.~ ~Ah ! Je ne vous ai pas vue approcher. J'ai la vue qui baisse, et bientôt je me ferai poignarder dans le dos sans rien voir. Je devrais être chez moi, mourant comme un vieil elfe, plutôt qu'écouter ici si souvent des récits.~
@52699 = ~Les honneurs de la Première Maison ont déjà été accordés à un autre. Vous le connaissez sans doute, il s'agit de Lesaonar, mon favori.~
@52700 = ~Puis-je te poser quelques questions ?~
@52701 = ~Racontez-moi votre histoire...~
@52702 = ~Je dois partir.~
@52703 = ~J'ai vécu de nombreuses aventures, mais je les ai déjà racontées trop souvent. Laissons les jeunes elfes noirs bomber le torse et se vanter tout leur saoul.~
@52704 = ~Puis-je vous poser quelques questions ?~
@52705 = ~Je dois partir.~
@52706 = ~Oui, oui, comme vous le voudrez.~
@52707 = ~Tu as été choisi pour te mesurer à la Supérieure de Lesaonar. Il est de son droit d'exiger qu'une telle bataille prenne place.~ ~Tu as été choisie pour te mesurer à la Supérieure de Lesaonar. Il est de son droit d'exiger qu'une telle bataille prenne place.~
@52708 = ~Parlez. Demandez si vous voulez savoir quelque chose. Je suis assez âgé pour m'asseoir un instant et répondre à vos questions.~
@52709 = ~Tu peux encore choisir celui qui relèvera le défi. Le souhaites-tu ?~
@52710 = ~Parlez-moi de Lolth.~
@52711 = ~Parlez-moi de la Maison Despana.~
@52712 = ~Que savez-vous de Solaufein ou de Phaere ?~
@52713 = ~Savez-vous s'il y a des dragons dans les environs ?~
@52714 = ~Il faut que j'y aille.~
@52715 = ~Oui. Veldrin se tient prêt.~ ~Oui. Veldrin se tient prête.~
@52716 = ~Ahhh. Je n'aime pas beaucoup parler de la Reine Araignée. Lolth est très orgueilleuse, et elle dirige la cité d'une main de fer. Si vous avez un peu de jugeote, ne faites pas allusion aux autres... dieux.~
@52717 = ~Aux autres dieux ?~
@52718 = ~<PLAYER2> va relever le défi qui lui a été lancé.~
@52719 = ~<PLAYER3> va relever le défi qui lui a été lancé.~
@52720 = ~<PLAYER4> va relever le défi qui lui a été lancé.~
@52721 = ~<PLAYER5> va relever le défi qui lui a été lancé.~
@52722 = ~<PLAYER6> va relever le défi qui lui a été lancé.~
@52723 = ~Je ne suis pas encore prêt. Je serai bientôt de retour.~ ~Je ne suis pas encore prête. Je serai bientôt de retour.~
@52724 = ~Oui. Vhaeraun, le dieu des voleurs... et Ghaunadaur, le dieu limon des cavernes. Ce sont deux de ses plus féroces adversaires. Et bien sûr Eilistraée...~
@52725 = ~La Vestale de l'ombre est une bonne déité pour notre race, si une telle chose existe. Elle veut nous détourner de notre sombre route, vous savez. Ah ! Mais, pour l'immense majorité des elfes noirs, Lolth est suffisante !~
@52726 = ~Je répondrai donc à son désir.~
@52727 = ~Un autre combattant souhaite-t-il m'affronter au péril de sa vie ?~
@52728 = ~La Reine Araignée est une déesse très jalouse, elle veut être le centre de toutes les adorations. La plupart des elfes n'oseront même pas se tourner vers d'autres divinités par peur de représailles. Quant à moi, je suis assez vieux pour me permettre de ne plus me sentir concerné, maintenant.~
@52729 = ~J'ai ici avec moi un mage qui désire fortifier son prestige dans la fosse. Si parmi tes compagnons se trouve un mage, il peut l'affronter.~
@52730 = ~Mais vous savez certainement déjà tout cela ! Tout elfe noir le sait, non ? Excusez mes radotages !~
@52731 = ~Je préférerais un autre adversaire.~
@52732 = ~Celui-là ne me plaît pas plus.~
@52733 = ~Et celui-ci encore moins.~
@52734 = ~Une grande Maison, avec des branches dans d'autres cités en dehors d'Ust Natha. La plupart des grandes familles ont leurs racines ici, dans la grande cité, non ?~
@52735 = ~Lolth apprécie les Despana, et beaucoup pensent que cette Maison a beaucoup d'ambition. Mais je ne connais rien de leurs plans...~
@52736 = ~Hmmm ? Oh, oui... la fille de la maison Despana et le commandant de la Société des Combattants. Bien sûr... il y a là une histoire qui mérite d'être racontée, si vous ne la connaissez pas.~
@52737 = ~On dit que Phaere estimait beaucoup ce Solaufein. Et pas seulement en tant que son mâle personnel, comme le décrète les préceptes de Lolth... elle ne l'a pas rejeté après l'avoir utilisé comme le veut la coutume des femelles !~
@52738 = ~On dit que Phaere a toujours des sentiments pour le commandant, des sentiments peu... courants, dans notre race. La Mère Matrone des Despana a été très déçue par la faiblesse de sa fille.~
@52739 = ~Ce qui a été fait, personne ne le sait ! Il est évident qu'ils s'ignorent maintenant. En fait, si le commandant n'était pas haut placé et dans les faveurs d'une autre Maison de haut rang, il serait aujourd'hui un drider !~
@52740 = ~Hmm. Je ne connais qu'un seul dragon dans les cavernes proches, et c'est cette vieille Adalon... le dragon d'argent envoyé par nos cousins de la surface pour garder les anciens passages.~
@52741 = ~Informe-le que Veldrin est prêt à livrer bataille.~ ~Informe-le que Veldrin est prête à livrer bataille.~
@52742 = ~<PLAYER2> va affronter le mage.~
@52743 = ~<PLAYER3> va affronter le mage.~
@52744 = ~<PLAYER4> va affronter le mage.~
@52745 = ~<PLAYER5> va affronter le mage.~
@52746 = ~<PLAYER6> va affronter le mage.~
@52747 = ~Aucun de mes compagnons ne souhaite relever ce défi.~
@52748 = ~On dit que ce dragon a eu un compagnon, il y a longtemps... un compagnon qui a été capturé par nos gens, quand nous habitions encore la surface. On m'a dit qu'on lui avait arraché le cœur !~
@52749 = ~La Reine des elfes noirs l'a utilisé pour une cérémonie, ce qui a provoqué la colère d'un des dieux blafards des elfes de la surface... Je ne sais pas lequel. Peu importe !~
@52750 = ~Quand nous avons été bannis de la surface, châtiés par nos cousins, leur dieu a passé un pacte avec Adalon. Il lui donnerait ce qu'elle désirait le plus, en échange de la surveillance des points d'accès à la surface.~
@52751 = ~Fort bien. Oublions cela. Rejoins-nous lorsque tu seras prêt.~ ~Fort bien. Oublions cela. Rejoins-nous lorsque tu seras prête.~
@52752 = ~Quand elle le désirerait, Adalon pourrait demander au dieu de lui donner des enfants... des œufs fécondés par l'âme de son ancien compagnon.~
@52753 = ~Enfin, c'est ce que dit la légende. Moi, je n'y croirais pas trop. Mais bon, je n'essayerais tout de même pas de m'aventurer dans ces parages, on ne sait jamais !~
@52754 = ~Oui, celle-là ! Que pouvez-vous me dire d'elle ?~
@52755 = ~Rien de plus récent ? À propos des œufs ?~
@52756 = ~Eh bien... j'ai entendu dire que les passages vers la surface avaient été réouverts. En tout cas, les Mères Matrones le croient, sinon, elles ne rassembleraient pas leurs armées. Adalon est peut-être morte, je ne sais pas !~
@52757 = ~Veldrin, c'est à toi ! Votre attention, s'il vous plaît ! Deux sorciers vont à présent s'affronter dans la fosse !~
@52758 = ~À votre guise. Bonne route.~
@52759 = ~Avez-vous besoin de quelque chose en particulier, mâle ? Un bol d'hydromel noir, peut-être ? Ou alors avez-vous trouvé une partenaire avec qui vous retirer dans les chambres de luxure ?~ ~Avez-vous besoin de quelque chose en particulier, femelle ? Un bol d'hydromel noir, peut-être ? Ou alors avez-vous trouvé un partenaire avec qui vous retirer dans les chambres de luxure ?~
@52760 = ~<PLAYER2> a rejoint la fosse. Votre attention, s'il vous plaît ! Nous allons maintenant assister à un combat entre deux mages !~
@52761 = ~<PLAYER3> a rejoint la fosse. Votre attention, s'il vous plaît ! Nous allons maintenant assister à un combat entre deux mages !~
@52762 = ~<PLAYER4> a rejoint la fosse. Votre attention, s'il vous plaît ! Nous allons maintenant assister à un combat entre deux mages !~
@52763 = ~<PLAYER5> a rejoint la fosse. Votre attention, s'il vous plaît ! Nous allons maintenant assister à un combat entre deux mages !~
@52764 = ~<PLAYER6> a rejoint la fosse. Votre attention, s'il vous plaît ! Nous allons maintenant assister à un combat entre deux mages !~
@52765 = ~Qu'avez-vous à proposer ?~
@52766 = ~Les chambres de luxure ?~
@52767 = ~Puis-je vous poser quelques questions ?~
@52768 = ~Rien, merci.~
@52769 = ~Comme l'on dit, le lit et l'esprit, c'est pour cela que je suis ici.~
@52770 = ~Ne soyez pas insipide, idiot. Ceci est un lieu de détente comme il y en a beaucoup. Lorsque les elfes noirs se sentent attirés par un partenaire, ils peuvent se retirer dans les chambres pour se faire masser ou pour tout autre petit plaisir.~ ~Ne soyez pas insipide, idiote. Ceci est un lieu de détente comme il y en a beaucoup. Lorsque les elfes noirs se sentent attirés par un partenaire, ils peuvent se retirer dans les chambres pour se faire masser ou pour tout autre petit plaisir.~
@52771 = ~Veldrin est maintenant dans la fosse, il s'apprête à livrer bataille à Chalinthra !~ ~Veldrin est maintenant dans la fosse, elle s'apprête à livrer bataille à Chalinthra !~
@52772 = ~Pitoyable. Votre victoire sur Lesaonar tient uniquement du miracle. Ce qui rend sa défaite encore plus... irritante.~
@52773 = ~À part cela, il y a des fosses de combat et les corps en décomposition des esclaves après l'explosion... pour ceux qui ont le cœur bien accroché. Il y a aussi de nombreux elfes qui racontent des histoires, ici, c'est une coutume de la cité.~
@52774 = ~Mais je suis sûr que vous n'avez pas besoin de moi pour vous guider... Vous avez des yeux, d'après ce que je vois. Avez-vous besoin d'autre chose ?~
@52775 = ~Qu'avez-vous à proposer ?~
@52776 = ~Bien. J'ai beaucoup de choses à faire.~
@52777 = ~Puis-je vous poser quelques questions ?~
@52778 = ~Non... alors je vais y aller.~
@52779 = ~Non, vous ne pouvez pas. Je ne suis pas ici pour répondre à vos questions, je suis là pour vous servir. Vous avez des questions ? Alors allez trouver les conteurs. Peut-être pourront-ils vous venir en aide, mâle.~ ~Non, vous ne pouvez pas. Je ne suis pas ici pour répondre à vos questions, je suis là pour vous servir. Vous avez des questions ? Alors allez trouver les conteurs. Peut-être pourront-ils vous venir en aide, femelle.~
@52780 = ~Qu'avez-vous dit à propos des « chambres de luxure » ?~
@52781 = ~Bon, voyons ce que vous avez à proposer...~
@52782 = ~Alors, je m'en vais.~
@52783 = ~Sondal ! Sors-moi ceux-là de l'arène ! Ils ont perdu et ne méritent pas de seconde chance !~
@52784 = ~Regardez, <PLAYER2> et Chalinthra ont engagé le combat !~
@52785 = ~Regardez, <PLAYER3> et Chalinthra ont engagé le combat !~
@52786 = ~Regardez, <PLAYER4> et Chalinthra ont engagé le combat !~
@52787 = ~Regardez, <PLAYER5> et Chalinthra ont engagé le combat !~
@52788 = ~Regardez, <PLAYER6> et Chalinthra ont engagé le combat !~
@52789 = ~Vous n'avez plus accès à la fosse. Vous avez perdu et n'êtes donc plus les bienvenus. Allez-vous-en.~
@52790 = ~Imbéciles ! Vous auriez dû tomber avec votre maison !~
@52791 = ~Lolth vous a condamné au tourment éternel dans les Fosses Démoniaques ! C'est tout ce que vous méritez !~
@52792 = ~Non ! Ayez pitié !~
@52793 = ~Libérez-nous ! Laissez-nous sortir d'ici !~
@52794 = ~Te libérer ? Tu essaies d'entrer dans Ust Natha en te faisant passer pour un elfe d'une vraie maison ? Tu mérites pire que cela !~ ~Te libérer ? Tu essaies d'entrer dans Ust Natha en te faisant passer pour une elfe d'une vraie maison ? Tu mérites pire que cela !~
@52795 = ~Non ! Nous sommes dévoués à la Reine Araignée ! Nous sommes ses fidèles serviteurs !~
@52796 = ~Tu es faible comme l'était ta maison, peu importe pour elle. Ta maison a été effacée de l'histoire, comme tu le seras bientôt.~
@52797 = ~Notre maison était forte ! Nous étions aimés de Lolth, nous l'étions ! Nous aurions dû triompher !~
@52798 = ~Oui, nous étions loyaux ! Maison DeVir, maison DeVir !~
@52799 = ~Un autre mage souhaiterait éprouver son habileté contre la tienne. La décision n'appartient qu'à toi.~
@52800 = ~La rumeur dit que certains de tes compagnons auraient de grands pouvoirs magiques. D'autres combattants souhaitent vous affronter. Y a-t-il parmi vous un mage prêt à livrer bataille ?~
@52801 = ~La maison DeVir n'est rien. Des cendres dans le vent. Comme toi bientôt, peut-être. Tu aurais dû mourir avec ta Matrone, dans ta ville. Maintenant... eh bien nous verrons, mais ce sera très amusant.~
@52802 = ~Non, les ténèbres vont TE prendre ! Ha ha ha ha ha ha !~
@52803 = ~Espèces de bâtards ! Ça pourrait être vous, bande d'idiots ! Que les ténèbres vous emportent !~
@52804 = ~Veldrin se tient prêt à combattre.~ ~Veldrin se tient prête à combattre.~
@52805 = ~<PLAYER2> va relever le défi.~
@52806 = ~<PLAYER3> va relever le défi.~
@52807 = ~<PLAYER4> va relever le défi.~
@52808 = ~<PLAYER5> va relever le défi.~
@52809 = ~<PLAYER6> va relever le défi.~
@52810 = ~Pas encore.~
@52811 = ~Veldrin se tient prêt à combattre.~ ~Veldrin se tient prête à combattre.~
@52812 = ~<PLAYER2> va relever le défi.~
@52813 = ~<PLAYER3> va relever le défi.~
@52814 = ~<PLAYER4> va relever le défi.~
@52815 = ~<PLAYER5> va relever le défi.~
@52816 = ~<PLAYER6> va relever le défi.~
@52817 = ~Je ne souhaite pas batailler. Je n'ai rien à prouver.~
@52818 = ~Je n'ai aucun autre combattant à te proposer. Reviens parmi nous lorsque tu seras prêt à affronter Chalinthra.~ ~Je n'ai aucun autre combattant à te proposer. Reviens parmi nous lorsque tu seras prête à affronter Chalinthra.~
@52819 = ~Si vous n'avez aucune pitié et ne voulez pas nous libérer, alors, laissez-nous à notre malheur, mâle.~ ~Si vous n'avez aucune pitié et ne voulez pas nous libérer, alors, laissez-nous à notre malheur, femelle.~
@52820 = ~Tu m'impressionnes. Voilà une victoire surprenante de la part d'un nouveau venu.~ ~Tu m'impressionnes. Voilà une victoire surprenante de la part d'une nouvelle venue.~
@52821 = ~Regardez-nous, rescapés de la Maison DeVir, mâle, et sachez que cela pourrait être aussi votre sort, un jour, si Lolth fait preuve de cruauté.~ ~Regardez-nous, rescapés de la Maison DeVir, femelle, et sachez que cela pourrait être aussi votre sort, un jour, si Lolth fait preuve de cruauté.~
@52822 = ~Je te remercie. Souhaites-tu me proposer d'autres défis ?~
@52823 = ~As-tu d'autres défis à me proposer ?~
@52824 = ~Je ne puis attendre le châtiment. Mère Lolth, je vous supplie de me pardonner...~
@52825 = ~Non ! Malafein ! Non !~
@52826 = ~Va-t'en, misérable mâle. Tu devrais être dans l'enclos des esclaves, si les choses étaient justes... ou encore, dans ces cages avec ces fous au destin noirci.~ ~Va-t'en, misérable femelle. Tu devrais être dans l'enclos des esclaves, si les choses étaient justes... ou encore, dans ces cages avec ces fous au destin noirci.~
@52827 = ~Un autre combattant désire-t-il s'opposer à moi ?~
@52828 = ~Reste-t-il un combattant qui souhaiterait m'affronter ?~
@52829 = ~C'est assez, je n'ai plus rien à prouver.~
@52830 = ~Laisse-moi, je n'ai pas fini d'insulter cette malheureuse vermine. Ha ! On essaie d'entrer dans la ville sous un déguisement... comme si on pouvait tromper les Vestales ! Ha !~
@52831 = ~Je n'ai plus de combattants de ta valeur à te proposer. Si ta Matrone apprend ton succès, sois sûr que tu connaîtras un destin des plus grands.~ ~Je n'ai plus de combattants de ta valeur à te proposer. Si ta Matrone apprend ton succès, sois sûre que tu connaîtras un destin des plus grands.~
@52832 = ~Salutations, mon ami. Avez-vous essayé ce divertissement ? Il vous suffit d'appuyer sur ce bouton et l'un de ces pauvres esclaves explosera !~ ~Salutations, mon amie. Avez-vous essayé ce divertissement ? Il vous suffit d'appuyer sur ce bouton et l'un de ces pauvres esclaves explosera !~
@52833 = ~Mais c'est magique ! Hahahaaa-haha ! Regardez... je vais vous montrer comment cela marche ! Qui sera le pauvre esclave choisi aujourd'hui, hum ?~
@52834 = ~Vous voyez ? Ha ha ! Je dois trouver le mage diabolique qui a créé cette chose merveilleuse et le récompenser comme il se doit ! Voulez-vous essayer ? Il ne vous en coûtera que 100 pièces d'or.~
@52835 = ~Dans ce cas, que la bataille commence ! Votre attention, s'il vous plaît ! Veldrin va s'engager dans un duel de sorciers !~
@52836 = ~Dans ce cas, que la bataille commence ! Votre attention, s'il vous plaît ! <PLAYER2> va s'engager dans un duel de sorciers !~
@52837 = ~Dans ce cas, que la bataille commence ! Votre attention, s'il vous plaît ! <PLAYER3> va s'engager dans un duel de sorciers !~
@52838 = ~Dans ce cas, que la bataille commence ! Votre attention, s'il vous plaît ! <PLAYER4> va s'engager dans un duel de sorciers !~
@52839 = ~Dans ce cas, que la bataille commence ! Votre attention, s'il vous plaît ! <PLAYER5> va s'engager dans un duel de sorciers !~
@52840 = ~Dans ce cas, que la bataille commence ! Votre attention, s'il vous plaît ! <PLAYER6> va s'engager dans un duel de sorciers !~
@52841 = ~Veldrin est dans la fosse ! Place au duel de sorciers !~
@52842 = ~<PLAYER2> est dans la fosse ! Place au duel de sorciers !~
@52843 = ~<PLAYER3> est dans la fosse ! Place au duel de sorciers !~
@52844 = ~<PLAYER4> est dans la fosse ! Place au duel de sorciers !~
@52845 = ~<PLAYER5> est dans la fosse ! Place au duel de sorciers !~
@52846 = ~<PLAYER6> est dans la fosse ! Place au duel de sorciers !~
@52847 = ~Vous, ici ! Vous avez pénétré les halls de Lolth sans autorisation. Un tel crime entraîne un seul châtiment ! Que Lolth soit louée !~
@52848 = ~Lolth choisit les visiteurs de son sanctuaire ! La foudre puni les autres ! La foudre vous punira !~
@52849 = ~Bienvenue dans mon échoppe, mon frère. Tu trouveras que mes lames sont fines et aiguisées. Tu n'en trouveras pas de meilleures.~ ~Bienvenue dans mon échoppe, ma sœur. Tu trouveras que mes lames sont fines et aiguisées. Tu n'en trouveras pas de meilleures.~
@52850 = ~Mais souviens-toi que je ne remplacerai rien une fois exposé au monde extérieur. Les armes et les armures d'adamantium se détériorent une fois qu'elles quittent la sombre protection de Lolth.~
@52851 = ~Tu ferais bien d'écouter attentivement ce que le Commandant Solaufein va te dire. Il est en grande faveur auprès de sa maison et dirige avec ferveur la Société des Combattants.~
@52852 = ~Je suis membre de la Société des Combattants, je m'entraîne pour atteindre la perfection et les faveurs de ma maison.~
@52853 = ~Hmpf. La plupart des traînards des autres cités qui viennent ici sont faits esclaves. Leur sang est versé dans les fosses. J'ignore pourquoi toi, mâle, tu as autant de chance.~ ~Hmpf. La plupart des traînardes des autres cités qui viennent ici sont faites esclaves. Leur sang est versé dans les fosses. J'ignore pourquoi toi, femelle, tu as autant de chance.~
@52854 = ~Laissez-moi voir ce que vous proposez.~
@52855 = ~Je n'ai besoin de rien actuellement.~
@52856 = ~Est-ce que rien ne peut empêcher une telle détérioration ?~
@52857 = ~Le voyage depuis Ched Nasad est long, et nombre de nos plus pires ennemis arpentent le chemin. Le fait que tu aies survécu est un signe du destin, mâle.~ ~Le voyage depuis Ched Nasad est long, et nombre de nos plus pires ennemis arpentent le chemin. Le fait que tu aies survécu est un signe du destin, femelle.~
@52858 = ~Hors de ma vue, mâle ! Je connais ton origine de Nasadran et je n'ai rien à faire avec toi !~ ~Hors de ma vue, femelle ! Je connais ton origine de Nasadrane et je n'ai rien à faire avec toi !~
@52859 = ~Je n'ai aucune idée du pourquoi l'on t'a laissé entrer à Ust Natha, mâle. Tu pues les passages inférieurs... dommage que les nains gris ne se soient pas débarrassés de toi avant ton arrivé.~ ~Je n'ai aucune idée du pourquoi l'on t'a laissée entrer à Ust Natha, femelle. Tu pues les passages inférieurs... dommage que les nains gris ne se soient pas débarrassés de toi avant ton arrivée.~
@52860 = ~Nous sommes les guerriers les plus illustres de la cité. Ne nous empêche pas de passer, et ne nous adresse pas la parole sans notre consentement.~
@52861 = ~Je dirige les forces de ma Maison pour défendre Ust Natha lorsque cela est nécessaire, pauvre imbécile. Tu ne servirais que de chair à archer, dans une telle bataille.~
@52862 = ~Une grande partie de nos forces se trouve ailleurs. Tu n'as pas le droit de poser de questions. Les Mères Matrones feront comme elles le voudront.~
@52863 = ~Nous te saluons, mâle. Peut-être seras-tu accepté dans les rangs de la Société des Combattants, une fois que tu auras gravi les échelons. Ou peut-être fera-t-on de toi un esclave. C'est Lolth qui décidera.~ ~Nous te saluons, femelle. Peut-être seras-tu acceptée dans les rangs de la Société des Combattantes, une fois que tu auras gravi les échelons. Ou peut-être fera-t-on de toi une esclave. C'est Lolth qui décidera.~
@52864 = ~La majorité des forces de la cité sont ailleurs, en train de se préparer à la grande bataille qui s'annonce. Les Mères Matrones vont nous conduire, triomphantes, à une victoire dans un bain de sang.~
@52865 = ~Si tu rencontres les Vestales de Lolth, baisse les yeux et ne leur parle pas. Tu n'es rien à leurs yeux, de même que tu n'es rien aux yeux d'une Mère Matrone.~
@52866 = ~Je suis diplômé de Sorcere, et je n'ai rien à dire à quelqu'un comme toi, mâle. Maîtrise les arts magiques comme je le fais, et alors peut-être seras-tu digne que je te parle.~ ~Je suis diplômé de Sorcere, et je n'ai rien à dire à quelqu'un comme toi, femelle. Maîtrise les arts magiques comme je le fais, et alors peut-être seras-tu digne que je te parle.~
@52867 = ~Non, et évidemment nous ne voudrions pas qu'il en soit autrement. Ce serait un outrage que de laisser à une autre race le droit de porter les armes des elfes noirs.~
@52868 = ~Je vois. Montrez-moi ce que vous avez en réserve.~
@52869 = ~Je n'ai besoin de rien d'autre en ce moment.~
@52870 = ~Est-ce que cela ne rend pas les raids à la surface difficiles ?~
@52871 = ~Tu es une sorte de mage, n'est-ce pas ? Tu devrais venir à la tour et te joindre à nous plutôt que de te laisser attirer par la Maison Despana.~
@52872 = ~Ah. Je suppose que tu maîtrises relativement bien les arts magiques, mâle. Bizarre, vraiment, que tu n'aies pas été envoyé vers nous... même si tu es originaire de Ched Nasad.~ ~Ah. Je suppose que tu maîtrises relativement bien les arts magiques, femelle. Bizarre, vraiment, que tu n'aies pas été envoyée vers nous... même si tu es originaire de Ched Nasad.~
@52873 = ~Très bien. Lolth vous garde.~
@52874 = ~Tu n'as pas été envoyé pour me remplacer, n'est-ce pas ? Tes arts magiques sont-ils supérieurs aux miens ? Je ne le supporterais pas ! Je suis très apprécié par ma Maison... Tu ne me remplaceras pas, entends-tu ?~ ~Tu n'as pas été envoyée pour me remplacer, n'est-ce pas ? Tes arts magiques sont-ils supérieurs aux miens ? Je ne le supporterais pas ! Je suis très apprécié par ma Maison... Tu ne me remplaceras pas, entends-tu ?~
@52875 = ~Les elfes noirs ne font pas de longs raids à la surface. Nous n'avons besoin de rien d'autre. Nous ne faisons des raids qu'occasionnellement pour des raisons spécifiques, et vous devriez le savoir.~
@52876 = ~Il semble... que tu sois un brillant élément, mais... tu es un mâle. Je n'ai jamais entendu parler d'aucun mage chez les elfes noirs qui soit un mâle. J'ai sûrement du me tromper... excuse-moi.~ ~Il semble... que tu sois un brillant élément, mais... tu es une femelle. Je n'ai jamais entendu parler d'aucun mage chez les elfes noirs qui soit une femelle. J'ai sûrement du me tromper... excuse-moi.~
@52877 = ~Bien sûr, maintenant, laissez-moi voir ce que vous avez en réserve.~
@52878 = ~Mais certainement. Merci, mais il faut que j'y aille.~
@52879 = ~Entrez. Soyez le bienvenu dans mon échoppe. Je propose des potions élaborées par les elfes noirs, avec l'aide des meilleurs esclaves alchimistes. De quoi avez-vous besoin, mon frère ?~ ~Entrez. Soyez la bienvenue dans mon échoppe. Je propose des potions élaborées par les elfes noirs, avec l'aide des meilleurs esclaves alchimistes. De quoi avez-vous besoin, ma sœur ?~
@52880 = ~Je... je fais mon travail, ma maîtresse... aussi vite que je le peux ! Excusez-moi...~
@52881 = ~Je ne peux vous aider... Je ne suis qu'un esclave. Je vous en prie, laissez-moi en paix.~
@52882 = ~Je t'en prie... ne me fais pas de mal ! Je n'ai rien fait ! Je... je vais essayer d'aller plus vite...~
@52883 = ~Je ne suis qu'un esclave... ne me fais pas de mal ! Je ne fais que mon travail, selon tes ordres...~
@52884 = ~Des... des gens de la surface ? Ici ? Grâce aux dieux ! P-pitié... pitié... libère-moi ! Brise mes chaînes et laisse-moi partir, je t'en supplie !~
@52885 = ~M-merci ! Merci ! Il y a... il y en d'autres que je dois libérer ! Je dois les aider ! Il doit y avoir une sortie !~
@52886 = ~T-tu... tu ne veux pas m'aider ? Maudite soit ton âme ! Qu'elle soit engloutie par l'Abysse !~
@52887 = ~Très bien. Tes chaînes n'ont pas l'air très solides. Cela ne prendra qu'une seconde.~
@52888 = ~Non, j'ai des choses plus importantes à faire.~
@52889 = ~Grrrrrrrrr... Je... travailler plus ! Pas blesser ! Grrrrrrrrrrrr~
@52890 = ~*grogne et râle* J'y vais ! Je travaille ! Je travaille ! *râle*~
@52891 = ~*râle* Pas frapper ! Moi, esclave ! Je travaille dur ! *grogne et râle*~
@52892 = ~Je suis désolé, j'ai peu de temps à vous accorder. J'ai des courses à faire rapidement, sans quoi je serai sévèrement puni.~
@52893 = ~Il semble qu'il n'y ait plus autant de gardiens que jadis... j'ai entendu dire que les Mères Matrones se préparaient à livrer une guerre.~
@52894 = ~Mon fils aîné a été tué par un œil-tyran il y a plus d'une semaine. Ils dissent que la bête rode autour de la grande caverne depuis plus d'un mois.~
@52895 = ~Bientôt, Lolth va détruire les autres faux dieux... et elle nous tiendra alors entièrement sous son joug. La Reine Araignée dirigera son hôte sombre de toutes ses forces !~
@52896 = ~Nous n'accueillons normalement aucun réfugié arrivant d'une autre ville... les Matrones ont dû avoir sacrément besoin de vous...~
@52897 = ~Mais où est donc parti cet enfant ? Il me faut le retrouver pour le souper, mais il est déjà parti, il a disparu ! Sa mère va être furieuse !~
@52898 = ~Je travaille pour l'une des maisons de marchands ici, à Ust Natha. Lolth ne nous gâte pas autant que les nobles, mais nous sommes tout aussi indispensables à la prospérité de la communauté.~
@52899 = ~Ma fille est sur le point de devenir majeure, mais il n'y a pas de voies accessibles vers la surface pour la Saignée, notre rituel de passage à l'âge adulte. Nous allons sans doute lui acheter un habitant de la surface et lui permettre de le traquer dans les cavernes, je pense...~
@52900 = ~J'ai beaucoup à faire avant que les cavernes ne soient plongées dans l'obscurité pour la nuit, mâle... laissez-moi en paix.~ ~J'ai beaucoup à faire avant que les cavernes ne soient plongées dans l'obscurité pour la nuit, femelle... laissez-moi en paix.~
@52901 = ~Mon compagnon a récemment découvert une précieuse veine d'adamantite, ce qui a rapporté une grande richesse à notre maison de marchands. Nous sommes très heureux.~
@52902 = ~L'an dernier, j'ai appartenu à une délégation faisant du commerce avec les kuo-toas. Quelles créatures infâmes ! Si nous n'avions pas besoin d'eux, je demanderais volontiers à Lolth de tous les tuer...~
@52903 = ~Du vent, mâle. Je suis persuadé que vous avez à vous préoccuper de bien d'autres choses que de moi.~ ~Du vent, femelle. Je suis persuadé que vous avez à vous préoccuper de bien d'autres choses que de moi.~
@52904 = ~Laisse-moi en paix, mâle. Je suis ici pour profiter du temps que ma Maison m'a accordé pour me reposer... et pas pour perdre mon temps avec toi.~ ~Laisse-moi en paix, femelle. Je suis ici pour profiter du temps que ma Maison m'a accordé pour me reposer... et pas pour perdre mon temps avec toi.~
@52905 = ~Allons, hors de ma vue, mâle, à moins qu'un coup de poignard dans le gosier ne te tente ?~ ~Allons, hors de ma vue, femelle, à moins qu'un coup de poignard dans le gosier ne te tente ?~
@52906 = ~Je suis ici pour l'hydromel noir, pas pour la compagnie.~
@52907 = ~As-tu essayé le jeu de la rune avec les esclaves ? C'est très drôle... bien que salissant. Tu devrais y aller et essayer tant qu'il reste des esclaves en réserve.~
@52908 = ~Si tu veux parler, pourquoi ne parles-tu pas aux conteurs ? Je suis persuadé qu'ils ne désirent rien de mieux.~
@52909 = ~Ne m'adressez pas la parole, mâle ! Regardez le sol lorsque je passe devant vous et remerciez la Mère Noire de tous les elfes noirs d'être toujours en vie, cloporte !~ ~Ne m'adressez pas la parole, femelle ! Regardez le sol lorsque je passe devant vous et remerciez la Mère Noire de tous les elfes noirs d'être toujours en vie, cloporte !~
@52910 = ~Que Lolth, la Reine des Araignées, soit louée !~
@52911 = ~Avez-vous accompli vos tâches dans le temple, mon enfant ? Si ce n'est pas le cas, vous recevrez des coups de bâtonnet à tentacules !~
@52912 = ~Je ne vous reconnais pas, mâle. Nous allons vous examiner, et si vous êtes un adepte fidèle de la Reine Araignée, vous agirez bientôt sur les ordres de la grande prêtresse.~ ~Je ne vous reconnais pas, femelle. Nous allons vous examiner, et si vous êtes une adepte fidèle de la Reine Araignée, vous agirez bientôt sur les ordres de la grande prêtresse.~
@52913 = ~Ne m'adressez pas la parole, <MALEFEMALE>. Le bâtonnet à tentacules touchera la chair de l'infidèle bien assez tôt. Ne provoquez pas sa morsure.~
@52914 = ~Je vous avertis, <MALEFEMALE>. Les Vestales de la Reine des Araignées ne souffrent pas les imbéciles. La colère de Lolth s'abattra sur vous si vous continuez sur la voie de l'impertinence.~
@52915 = ~Qui êtes-vous pour OSER... QUE VOIS-JE ?! DES SURFACINS ?! AVEC UN DÉGUISEMENT MAGIQUE ?! DROW... AU NOM DE LOLTH ! TUEZ-LES ! TUEZ-LES !~
@52916 = ~Magicien elfe noir~
@52917 = ~Magicien elfe noir~
@52918 = ~Client elfe noir~
@52919 = ~Client elfe noir~
@52920 = ~Prêtresse de Lolth~
@52921 = ~Prêtresse de Lolth~
@52922 = ~Vestale de Lolth~
@52923 = ~Vestale de Lolth~
@52924 = ~Laissez-moi voir ce que vous avez en réserve.~
@52925 = ~Je n'ai besoin de rien pour l'instant.~
@52926 = ~Je croyais que les potions des elfes noirs étaient les meilleures de toutes. Pourquoi aurions-nous besoin d'aide ?~
@52927 = ~Pose de piège spécial~
@52928 = ~Rien n'égale le savoir-faire ou l'alchimie des elfes noirs, mais nous faisons également travailler des créatures indignes. Vous devriez savoir cela.~
@52929 = ~Que les profondeurs de l'obscurité vous protègent.~
@52930 = ~Bien entendu, je le sais. Puis-je voir vos réserves, à présent ?~
@52931 = ~Évidemment. Il faut que j'y aille, maintenant.~
@52932 = ~Voulez-vous voir les artefacts magiques que j'ai acquis ? J'ai de nombreux objets magiques façonnés par des drows, mais aussi d'autres prélevés sur des races inférieures qui ne les méritaient pas.~
@52933 = ~Transformation en elfe noir~
@52934 = ~Oui, je veux voir ce que vous avez.~
@52935 = ~Non, il faut que j'y aille.~
@52936 = ~Que Lolth guide vos pas.~
@52937 = ~*des ténèbres impénétrables vous enveloppent... vous ne pouvez pas passer là sans une source de lumière*~
@52938 = ~Votre opinion n'a guère d'importance. Si vous aviez été incompétent, nous ne vous aurions même pas remarqué et vous seriez mort. Vous avez fait la preuve que vous méritiez de vivre.~ ~Votre opinion n'a guère d'importance. Si vous aviez été incompétente, nous ne vous aurions même pas remarquée et vous seriez mort. Vous avez fait la preuve que vous méritiez de vivre.~
@52939 = ~Vous pouvez prendre ça comme du respect circonspect ou comme une fourberie. Je m'en fiche. J'en ai fini avec vous.~
@52940 = ~Alors abandonnez-vous à votre fureur ! Vous avez vaincu les maudits illithids, vous êtes donc dignes de nous affronter.~
@52941 = ~Répulsion, invocateur~
@52942 = ~Ce n'est pas encore fini, <CHARNAME>. Nous nous reverrons sûrement !~
@52943 = ~Il ne pouvait pas vous la donner ! Déjà elle ne lui appartenait pas ! Elle a été volée à notre peuple et elle doit lui être restituée.~
@52944 = ~Venez, mes petits ! Des humains font intrusion dans notre royaume !~
@52945 = ~Des couleurs !~
@52946 = ~Écureuils~
@52947 = ~*une grosse crevasse a séparé en deux la structure qui se tient devant vous... son toit est recouvert de petits motifs complexes... vous feriez bien de les examiner*~
@52948 = ~Cette arme est une Épée d'argent, une arme confiée à nos plus grands chefs par la reine en personne. On ne peut ni la donner ni la vendre, sous peine de mort.~
@52949 = ~Nous savons que Saemon Havarian l'avait en sa possession et qu'il vous l'a donnée. Elle doit nous être rendue !~
@52950 = ~Bien entendu qu'il l'avait, mais avez-vous vu la transaction ? Peut-être qu'il a menti ?~
@52951 = ~Vous pouvez ne pas avoir vu la transaction. Peut-être que Saemon a menti ?~
@52952 = ~Si elle a tant de valeur à vos yeux alors je vous la rendrai. Je vous prie de m'excuser pour celui ou celle qui l'a prise.~
@52953 = ~J'avais votre épée, mais elle était de bien piètre qualité. Je m'en suis débarrassé.~ ~J'avais votre épée, mais elle était de bien piètre qualité. Je m'en suis débarrassée.~
@52954 = ~Vous insultez ce qui est tellement précieux à nos yeux ! C'est un crime dégradant ! Assez, nous allons vous tuer et voir par nous-mêmes si vous avez cette arme !~
@52955 = ~Pardon mais je m'en suis débarrassé il y a bien longtemps. Ce n'était pas une arme extraordinaire.~
@52956 = ~Non. Elle m'appartient désormais, bien que je ne comprenne pas son intérêt.~
@52957 = ~Salutations, <CHARNAME>, au nom du très noble Ordre du Cœur radieux. Permettez-moi de me présenter... je suis l'écuyer Cathras, assistant du prélat Wessalen.~
@52958 = ~Je ne pense pas ! Vous allez mourir ici et nous verrons par nous-mêmes si vous l'avez sur vous !~
@52959 = ~Vous nous la rendez ? Aussi simplement que cela ? Je ne pensais pas que cela se terminerait sans effusion de sang.~
@52960 = ~Je dois admettre que j'ai quelque peu suivi les récits de vos récents exploits, en particulier depuis que vous êtes entré dans l'Ordre. Vos faits d'armes sont impressionnants, c'est le moins qu'on puisse dire.~ ~Je dois admettre que j'ai quelque peu suivi les récits de vos récents exploits, en particulier depuis que vous êtes entrée dans l'Ordre. Vos faits d'armes sont impressionnants, c'est le moins qu'on puisse dire.~
@52961 = ~J'ai aussi quelque peu suivi les récits de vos exploits, même si vous n'êtes pas membre de l'Ordre. On dit que vos faits d'armes sont... très impressionnants.~
@52962 = ~Alors je vous laisserai en paix. À l'évidence vous n'avez rien à voir avec ce vol. Je vous remercie pour nos vies, car notre succès implique que nous pouvons repartir chez nous victorieux.~
@52963 = ~Pourtant, la dette doit être payée. Que vous nous l'ayez rendue est admirable mais vous êtes répugnant par bien des aspects. Je suis navré pour ce qui doit être fait mais il doit y avoir expiation !~ ~Pourtant, la dette doit être payée. Que vous nous l'ayez rendue est admirable mais vous êtes répugnante par bien des aspects. Je suis navré pour ce qui doit être fait mais il doit y avoir expiation !~
@52964 = ~J'ai aussi quelque peu suivi les nombreux récits de vos exploits, même si le prélat l'interdit. Vos faits d'armes sont légendaires, à mes yeux, malgré... ah... le fait que vous ayez quitté la Voie.~
@52965 = ~Peut-être que oui ou peut-être que non. Quoi qu'il en soit, ce n'est pas un sujet sur lequel nous pouvons nous permettre de prendre des risques. Si nous ne récupérons pas l'épée, nous sommes morts.~
@52966 = ~Je suis jeune, mais j'ai suivi les récits de vos nombreux exploits. Il est difficile de discerner la vérité, mais quelle que soit la vérité qu'il y a dans ces récits, elle doit quand même être tout à fait passionnante.~
@52967 = ~J'insiste... je ne l'ai pas. Ma parole ne vous suffit-elle pas ?~
@52968 = ~Si cela est tellement important, alors prenez l'arme, avec ma bénédiction.~
@52969 = ~L'épée m'appartient. Vous ne l'aurez pas, même si je n'en ai aucun besoin.~
@52970 = ~Peut-être que je l'avais mais plus aujourd'hui. Je me suis douté des ennuis qu'elle provoquerait et je m'en suis débarrassé.~ ~Peut-être que je l'avais mais plus aujourd'hui. Je me suis doutée des ennuis qu'elle provoquerait et je m'en suis débarrassé.~
@52971 = ~J'ai quelque peu suivi les récits que j'entends de vos exploits, même si le prélat l'interdit. Je dois vous mettre en garde, cependant... vous n'êtes pas vraiment le bienvenu, ici, avec votre réputation.~ ~J'ai quelque peu suivi les récits que j'entends de vos exploits, même si le prélat l'interdit. Je dois vous mettre en garde, cependant... vous n'êtes pas vraiment la bienvenue, ici, avec votre réputation.~
@52972 = ~Je suis content de vous rencontrer enfin. Veuillez m'excuser, cependant... vous êtes certainement venu dans un but précis, et je vous retiens. Avez-vous... avez-vous à faire avec l'Ordre, <CHARNAME> ?~
@52973 = ~Dans une affaire où la mort est la seule alternative, devrions-nous revenir sans l'épée ? Non, cela ne me suffit pas. Je regrette ce qui doit être fait pour connaître la vérité.~
@52974 = ~Nous en avons terminé. Laissez-nous tranquilles et partez en paix.~ [SIMYAZ13]
@52975 = ~L'ennemi noir est là ! Attaquez, pour que les forêts ne connaissent plus la souillure de leur pas ! Au nom de Suldanessalar !~
@52976 = ~Oui, mais je ne peux en parler qu'au prélat.~
@52977 = ~Vous ici ? Votre allure n'a rien de celle de notre ennemi noir ! Remontez à la surface et présentez-vous à Elhan immédiatement.~
@52978 = ~Oui, mais je ne peux en parler qu'au prélat.~
@52979 = ~*avec un crissement de pierre, le pont se répare et vous permet de traverser... la voix ne vous propose aucune autre énigme*~
@52980 = ~Tire-laine~
@52981 = ~Tire-laine~
@52982 = ~Je suis venu réclamer l'assistance de l'Ordre pour combattre une puissante vampire qui est dans la ville.~ ~Je suis venue réclamer l'assistance de l'Ordre pour combattre une puissante vampire qui est dans la ville.~
@52983 = ~Dace Sontan~
@52984 = ~Dace Sontan~
@52985 = ~Écarte-toi, gamin. Je peux parler moi-même.~
@52986 = ~Non, je ne crois pas.~
@52987 = ~Bien sûr, pardonnez-moi de me montrer aussi curieux. Je suis sûr que le prélat acceptera de parler avec vous. Suivez-moi.~ ~Bien sûr, pardonnez-moi de me montrer aussi curieuse. Je suis sûre que le prélat acceptera de parler avec vous. Suivez-moi.~
@52988 = ~Chaman kobold~
@52989 = ~Eh bien... je suppose que vous pourriez parler au prélat, mais je ne sais pas s'il sera très compréhensif avec vous, étant donné... enfin, vous savez. Mais bon, cela dépend de lui. Suivez-moi.~
@52990 = ~Une... une vampire ? Une aussi terrible créature existe vraiment ? Ici à Athkatla ? Je... je n'en savais rien !~
@52991 = ~Vous devez informer le prélat de ceci immédiatement ! Si un pareil monstre s'est introduit dans la ville, je suis sûr que l'Ordre fera tout ce qu'il pourra pour vous prêter main-forte. Venez !~ ~Vous devez informer le prélat de ceci immédiatement ! Si un pareil monstre s'est introduit dans la ville, je suis sûre que l'Ordre fera tout ce qu'il pourra pour vous prêter main-forte. Venez !~
@52992 = ~Je parle la langue commune pour que vous puissiez comprendre et prendre garde ! Tous ceux qui pénètrent la surface seront repoussés ! Attendez... vous n'êtes pas un elfe noir !~ ~Je parle la langue commune pour que vous puissiez comprendre et prendre garde ! Tous ceux qui pénètrent la surface seront repoussés ! Attendez... vous n'êtes pas une elfe noire !~
@52993 = ~Nous devons tout de suite avertir le prélat ! Malgré votre réputation, je suis sûr qu'il considérera cette créature comme un mal que l'Ordre doit combattre ! Venez ! Suivez-moi !~ ~Nous devons tout de suite avertir le prélat ! Malgré votre réputation, je suis sûre qu'il considérera cette créature comme un mal que l'Ordre doit combattre ! Venez ! Suivez-moi !~
@52994 = ~Ah... bien sûr, bien sûr. Vous voulez... parler au prélat en personne. Je comprends parfaitement. Je suis sûr que vous connaissez le chemin, alors, <PRO_SIRMAAM>.~ ~Ah... bien sûr, bien sûr. Vous voulez... parler au prélat en personne. Je comprends parfaitement. Je suis sûre que vous connaissez le chemin, alors, <PRO_SIRMAAM>.~
@52995 = ~Oh. Eh bien, comme je le disais... je suis content de vous rencontrer, <PRO_SIRMAAM>. Je suis certain que j'aurai encore bientôt de vos nouvelles. Au revoir et bonne journée.~ ~Oh. Eh bien, comme je le disais... je suis contente de vous rencontrer, <PRO_SIRMAAM>. Je suis certaine que j'aurai encore bientôt de vos nouvelles. Au revoir et bonne journée.~
@52996 = ~Je suis sûr que le prélat se laissera convaincre de vous aider, <CHARNAME>.~
@52997 = ~Alors nous allons vous aider à détruire une... une puissante vampire ? Par la grâce de Tyr, quelle bataille cela va être ! Je vais immédiatement transmettre le message à Sire Reirrac !~
@52998 = ~Je vois que le prélat vous a opposé un refus. Peut-être... peut-être y a-t-il encore un moyen de l'apaiser. Après tout, l'Ordre est là pour combattre les plus grands maux... peut-être que si vous pouviez l'en persuader...~
@52999 = ~Cet homme a été sévèrement torturé, et il a perdu connaissance.~
@53000 = ~Salutations, <CHARNAME>. Les récits de vos exploits vous précèdent... nous sommes au courant de vos hauts faits jusqu'ici dans l'Ordre. Une bénédiction pour la ville de vous voir arriver ici.~
@53001 = ~Salutations, <CHARNAME>. Veuillez m'excuser... j'aimerais beaucoup vous questionner sur vos voyages, mais l'Ordre ne laisse pas beaucoup de loisirs aux écuyers comme moi.~
@53002 = ~Talon Zogas~
@53003 = ~*une douleur lancinante pénètre votre esprit... des images de souffrance et de cruauté, d'arènes de combat et d'esclaves... puis vous sombrez dans une inconscience tranquille*~
@53004 = ~Le géancéphale~
@53005 = ~Le géancéphale~
@53006 = ~*comme on vous l'avait prédit, vous avez attiré toute la puissance de la malédiction sur vous en essayant de prendre le Sceptre des failles hors du repaire du culte de l'Œil Aveugle... vous mourez dans d'atroces souffrances*~
@53007 = ~Salutations, <GABBER>. Si <CHARNAME> est avec vous, j'aimerais lui parler... Il est le porte-parole de votre groupe, n'est-ce pas ?~ ~Salutations, <GABBER>. Si <CHARNAME> est avec vous, j'aimerais lui parler... Elle est la porte-parole de votre groupe, n'est-ce pas ?~
@53008 = ~<CHARNAME>... Je suis ravi d'accueillir un membre de l'Ordre de retour parmi nous. Vous avez l'air en pleine forme. Avez-vous une requête à me soumettre ?~
@53009 = ~Ah, <CHARNAME>... Je vous salue au nom du très noble Ordre du Cœur radieux. Soyez le bienvenu en ces lieux. Avez-vous une requête à me soumettre ?~ ~Ah, <CHARNAME>... Je vous salue au nom du très noble Ordre du Cœur radieux. Soyez la bienvenue en ces lieux. Avez-vous une requête à me soumettre ?~
@53010 = ~<CHARNAME>. C'est avec la lame de mon épée que je salue une vipère telle que vous ! Donnez-moi une seule bonne raison pour que je ne vous tue pas sur-le-champ !~
@53011 = ~En effet. Je dois combattre une horde de vampires très puissants dans cette ville et j'aimerais solliciter l'aide de l'Ordre.~
@53012 = ~Vous ne pouvez pas utiliser deux anneaux des arcanes en même temps.~
@53013 = ~Les flagelleurs mentaux déchaînent leurs pouvoirs psychiques sur vous... vous n'avez aucune chance de survivre.~
@53014 = ~Non, pas pour le moment. Une autre fois, prélat.~
@53015 = ~En effet. J'ai l'intention de combattre une horde de vampires très puissants dans cette ville et j'aimerais solliciter l'aide de l'Ordre.~
@53016 = ~En effet. Je dois combattre une horde de vampires très puissants dans cette ville et j'aimerais solliciter l'aide de l'Ordre.~
@53017 = ~En effet. J'ai l'intention de combattre une horde de vampires très puissants dans cette ville et j'aimerais solliciter l'aide de l'Ordre.~
@53018 = ~Ma dame ! Le seigneur Keldorn est de retour.~
@53019 = ~Liche d'ombre~
@53020 = ~Non, pas pour le moment. Une autre fois, prélat.~
@53021 = ~Parce que nous avons une ennemie commune. J'ai l'intention de combattre une horde de puissants vampires, ici, dans cette ville... Et j'aimerais solliciter l'aide de l'Ordre.~
@53022 = ~Parce que nous avons une ennemie commune. J'ai l'intention de combattre une horde de puissants vampires, ici, dans cette ville... Et j'aimerais solliciter l'aide de l'Ordre.~
@53023 = ~Parce que mon ennemie n'est autre qu'une puissante vampire, ici, à Athkatla. Et je viens vous offrir le privilège de vous joindre à moi afin de l'éliminer.~
@53024 = ~Parce que mon ennemie n'est autre qu'une puissante vampire, ici, à Athkatla. Et je viens vous offrir le privilège de vous joindre à moi afin de l'éliminer.~
@53025 = ~Ne me menacez pas, vieil homme. Vous pourriez le regretter.~
@53026 = ~Une raison ? Eh bien que pensez-vous de celle-là : je pars ? J'espère que vous êtes très fier de vous et de votre... accueil, vieil homme.~
@53027 = ~J'ai entendu parler de cette vampire. Son nom est Bodhi. Mais ne l'aviez-vous pas tuée elle et sa guilde pour le compte des Voleurs de l'ombre ?~
@53028 = ~J'ai détruit sa guilde pour obtenir l'aide des Voleurs de l'ombre mais je n'ai pu éliminer cette vampire. Elle est donc revenue à Athkatla et a depuis recouvré tous ses pouvoirs.~
@53029 = ~Non... non, je ne vous crois pas. Je ne peux pas prendre de risque avant d'avoir des nouvelles de... vous me faites perdre du temps ! Prenez-le !~ ~Non... non, je ne vous crois pas. Je ne peux pas prendre de risque avant d'avoir des nouvelles de... vous me faites perdre du temps ! Prenez-la !~
@53030 = ~J'ai détruit sa guilde pour obtenir l'aide des Voleurs de l'ombre mais je n'ai pu éliminer cette vampire. Elle est donc revenue à Athkatla et a depuis recouvré tous ses pouvoirs.~
@53031 = ~J'ai entendu parler de cette vampire, son nom est Bodhi... Vous travailliez pour elle et sa guilde lorsque vous avez éliminé les Voleurs de l'ombre. Pourquoi avez-vous fait ça ?~
@53032 = ~Je croyais que j'avais besoin de son aide et que les Voleurs de l'ombre étaient pires qu'elle. Mais désormais, je sais qu'elle fait partie d'une terrible conspiration et je ne peux l'éliminer seul.~ ~Je croyais que j'avais besoin de son aide et que les Voleurs de l'ombre étaient pires qu'elle. Mais désormais, je sais qu'elle fait partie d'une terrible conspiration et je ne peux l'éliminer seule.~
@53033 = ~Je croyais que j'avais besoin de son aide et que les Voleurs de l'ombre étaient pires qu'elle. Mais désormais, je sais qu'elle fait partie d'une terrible conspiration et je ne peux l'éliminer seul.~ ~Je croyais que j'avais besoin de son aide et que les Voleurs de l'ombre étaient pires qu'elle. Mais désormais, je sais qu'elle fait partie d'une terrible conspiration et je ne peux l'éliminer seule.~
@53034 = ~Je ne connaissais pas alors sa véritable nature et, à cette époque, je n'avais guère le choix. Aujourd'hui cependant, j'ai la ferme intention de l'éliminer... Mais pour cela, j'ai besoin de votre aide.~
@53035 = ~Je ne connaissais pas alors sa véritable nature et, à cette époque, je n'avais guère le choix. Aujourd'hui cependant, j'ai la ferme intention de l'éliminer... Mais pour cela, j'ai besoin de votre aide.~
@53036 = ~Mes raisons sont personnelles. Le fait est que cette puissante vampire est l'incarnation du mal et que je ne peux, par conséquent, l'éliminer seul. Voulez-vous m'aider ou non ?~ ~Mes raisons sont personnelles. Le fait est que cette puissante vampire est l'incarnation du mal et que je ne peux, par conséquent, l'éliminer seule. Voulez-vous m'aider ou non ?~
@53037 = ~Je ne suis pas là pour répondre à vos questions, vieil homme. Soit vous acceptez de m'aider, soit vous refusez mais décidez-vous.~
@53038 = ~Très bien, <CHARNAME>. Jusqu'aux dernières nouvelles, l'Ordre est là pour vous aider.~
@53039 = ~Hum... Nous avons entendu parler de cette vampire et de sa guilde également. Nous pensions que vous les aviez détruits... pour le compte de ces méprisables Voleurs de l'ombre !~
@53040 = ~Hum... Nous connaissons cette vampire, Bodhi... N'êtes-vous pas son serviteur ? N'avez-vous pas massacré les Voleurs de l'ombre sur sa demande ? Pourquoi devrions-nous vous faire confiance ?~
@53041 = ~Ah ! Nous connaissons cette vampire. Selon nos informations, vous l'auriez éliminée elle et sa guilde pour le compte des Voleurs de l'ombre. Pourquoi donc nous mentir à présent ? Quelles sont vos intentions, <CHARNAME> ?~
@53042 = ~Je m'opposerai aux forces du mal comme bon me semble. Quant à vous, prenez garde à votre langage dans un lieu de justice comme celui-ci ! Et maintenant, partez ou vous découvrirez pourquoi l'Ordre est craint par ceux de votre espèce !~
@53043 = ~Alors partez et ne revenez pas avant de vous être bonifié... ou notre jugement sera cruel.~ ~Alors partez et ne revenez pas avant de vous être bonifiée... ou notre jugement sera cruel.~
@53044 = ~Nous connaissons cette vampire. Et nous savons que vous avez massacré les Voleurs de l'ombre sur ses ordres. Comment voulez-vous que nous vous fassions confiance à présent ?~
@53045 = ~Je n'ai fait que détruire sa guilde. Mais désormais, elle a recouvré tous ses pouvoirs et elle est revenue... Elle est devenue trop puissante pour que je puisse la combattre seul.~ ~Je n'ai fait que détruire sa guilde. Mais désormais, elle a recouvré tous ses pouvoirs et elle est revenue... Elle est devenue trop puissante pour que je puisse la combattre seule.~
@53046 = ~Je n'ai pas à m'expliquer de mes actes devant vous. Le fait est que je n'ai pu l'éliminer à l'époque et que je ne le peux toujours pas aujourd'hui, si vous ne m'accordez pas votre aide.~
@53047 = ~Je ne connaissais alors pas sa véritable nature et, à l'époque, je n'avais guère le choix. Mais aujourd'hui, elle est mon ennemie... Elle est cependant trop puissante pour que je puisse la combattre seul.~ ~Je ne connaissais alors pas sa véritable nature et, à l'époque, je n'avais guère le choix. Mais aujourd'hui, elle est mon ennemie... Elle est cependant trop puissante pour que je puisse la combattre seule.~
@53048 = ~Les Voleurs de l'ombre ont eu le sort qu'ils méritaient. Mais j'ai depuis découvert qu'elle aussi était mon ennemie. J'ai la ferme intention de l'éliminer et pour cela, j'ai besoin de votre aide.~
@53049 = ~Je ne suis pas ici pour m'expliquer de mes actes devant vous. J'ai la ferme intention de l'éliminer... Croyez-moi ou non, comme il vous plaira. La seule chose que je vous demande est de l'aide.~
@53050 = ~Je ne mens pas. J'ai détruit sa guilde mais pas elle. Et maintenant, elle a non seulement recouvré tous ses pouvoirs mais elle est devenue encore plus puissante. Je ne peux pas l'éliminer seul.~ ~Je ne mens pas. J'ai détruit sa guilde mais pas elle. Et maintenant, elle a non seulement recouvré tous ses pouvoirs mais elle est devenue encore plus puissante. Je ne peux pas l'éliminer seule.~
@53051 = ~Je n'ai pas à m'expliquer de mes actes devant vous. Le fait est que je n'ai pu l'éliminer à l'époque et que je ne le peux toujours pas aujourd'hui, si vous ne m'accordez pas votre aide.~
@53052 = ~Je n'ai aucune mauvaise intention. Traitez-moi encore une fois de menteur et vous le regretterez, vieil homme.~ ~Je n'ai aucune mauvaise intention. Traitez-moi encore une fois de menteuse et vous le regretterez, vieil homme.~
@53053 = ~Et que diriez-vous de découvrir pourquoi des gens comme vous craignent des gens comme moi ? Prenez garde !~
@53054 = ~En dépit de nos différents, je suis venu avec un but bien précis et j'ai bien l'intention de parvenir à mes fins. J'ai besoin de votre aide... Et vous allez m'aider, peu importe ce que vous pensez de moi.~ ~En dépit de nos différents, je suis venue avec un but bien précis et j'ai bien l'intention de parvenir à mes fins. J'ai besoin de votre aide... Et vous allez m'aider, peu importe ce que vous pensez de moi.~
@53055 = ~En dépit de nos différents, je suis venu avec un but bien précis et j'ai bien l'intention de parvenir à mes fins. J'ai besoin de votre aide... Et vous allez m'aider, peu importe ce que vous pensez de moi.~ ~En dépit de nos différents, je suis venue avec un but bien précis et j'ai bien l'intention de parvenir à mes fins. J'ai besoin de votre aide... Et vous allez m'aider, peu importe ce que vous pensez de moi.~
@53056 = ~Très bien. Je m'en vais.~
@53057 = ~Je ne connaissais pas alors sa véritable nature et à l'époque, je n'avais guère le choix. Aujourd'hui, je sais qu'elle est mon ennemie. Mais elle est devenue trop puissante pour que je puisse l'éliminer seul.~ ~Je ne connaissais pas alors sa véritable nature et à l'époque, je n'avais guère le choix. Aujourd'hui, je sais qu'elle est mon ennemie. Mais elle est devenue trop puissante pour que je puisse l'éliminer seule.~
@53058 = ~Croyez ce que vous voulez ! Le fait est qu'elle est notre ennemie, la vôtre comme la mienne. J'ai la ferme intention de l'éliminer mais je ne peux agir seul.~ ~Croyez ce que vous voulez ! Le fait est qu'elle est notre ennemie, la vôtre comme la mienne. J'ai la ferme intention de l'éliminer mais je ne peux agir seule.~
@53059 = ~Alors nous vous aiderons à la combattre ainsi que tous les démons qui pourront s'allier à cette vampire. L'Ordre a pour mission de lutter contre les forces du mal, dans toutes conditions.~
@53060 = ~Lorsque vous vous rendrez au cimetière pour affronter cette créature, je vous enverrai un groupe d'hommes mené par William Reirrac qui combattra à vos côtés. Ils vous retrouveront dans les catacombes.~
@53061 = ~Au nom de Torm, je prie pour que nos forces suffisent à vaincre ce mal une bonne fois pour toute. Je vous salue, <CHARNAME>... Je dois m'occuper des derniers préparatifs.~
@53062 = ~Je doute de votre jugement à ce sujet... Mais le temps presse. Nous ne vous abandonnerons pas, <CHARNAME>... L'Ordre doit lutter contre le mal, où qu'il se trouve et quel qu'il soit.~
@53063 = ~Dans ce cas, nous devons l'arrêter elle et les siens. <CHARNAME>, l'Ordre combattra ce mal à vos côtés.~
@53064 = ~Mais vous voyagez avec l'une d'entre eux ! Êtes-vous des collaborateurs ? Nous avez-vous trahis pour ceux des enfers ?~
@53065 = ~Alors, nous vous aiderons, <CHARNAME>. Mais si vous nous mentez, l'Ordre sera sans pitié avec vous pour avoir été complice de cette créature maléfique.~
@53066 = ~Ne prenez pas ce ton avec moi, <CHARNAME>. L'Ordre ne vous est redevable de rien. Nous avons déjà eu affaire à ces vampires sans demander l'aide de personne.~
@53067 = ~Mais autant réunir toutes les chances de notre côté et donc allier nos forces. Toutefois, la moindre traîtrise de votre part et vous connaîtrez notre vengeance, <CHARNAME>.~
@53068 = ~L'Ordre a déjà songé à combattre ces créatures mais nous aurons davantage de chances si nous unissons nos forces. Cela ne signifie pas pour autant que vous êtes digne de notre confiance.~
@53069 = ~Je veux votre parole comme quoi vous allez tout faire pour détruire cette créature... et que vous n'allez pas abandonner un seul de mes hommes. Ai-je votre parole ?~
@53070 = ~Vous ne devriez pas vous trouver dans cette zone ! Êtes-vous des collaborateurs ? Avez-vous trahi notre monde pour celui des ombres ?~
@53071 = ~Oui, vous avez ma parole.~
@53072 = ~Pas si vite ! Je ne donne pas ma parole pour ça !~
@53073 = ~Et qu'est-ce que cela changerait ? Nous avons un ennemi commun... C'est à vous de protéger vos hommes.~
@53074 = ~Alors, l'Ordre se joint à vous dans cette lutte. Prenez garde, cependant... La moindre traîtrise de votre part et vous connaîtrez notre vengeance...~
@53075 = ~Cela ne serait pas la première fois que nous aurions affaire à des traîtres dans nos rangs. Expliquez comment vous êtes venus jusqu'ici, frère elfe, mais choisissez bien vos mots.~ ~Cela ne serait pas la première fois que nous aurions affaire à des traîtres dans nos rangs. Expliquez comment vous êtes venus jusqu'ici, sœur elfe, mais choisissez bien vos mots.~
@53076 = ~Alors, ne comptez pas sur notre aide. Si mes hommes ne peuvent pas attendre un minimum de protection de votre part, vous mènerez vos combats de votre côté, et nous du nôtre. À présent, partez !~
@53077 = ~Vous avez entendu parler d'Irenicus ? Vous allez immédiatement parler avec Elhan. Il déterminera la nature de vos relations avec le monstre !~
@53078 = ~Liche d'ombre~
@53079 = ~C'est une belle déclaration en période de combat. Vos sentiments sont suffisamment vrais mais je ne vous ferais pas confiance si vous côtoyez l'ennemi.~
@53080 = ~Mon commandant décidera de votre valeur. Vous serez menés à lui. Ne résistez pas car je ne perdrai pas de temps alors que les méfaits d'Irenicus sont de plus en plus odieux chaque jour.~
@53081 = ~Je m'appelle <CHARNAME>. J'ai combattu les elfes noirs pour retrouver Irenicus !~
@53082 = ~Je ne suis pas venu d'aussi loin pour être accusé. Attaquez si vous le voulez, je n'attendrais pas pour autant.~ ~Je ne suis pas venue d'aussi loin pour être accusé. Attaquez si vous le voulez, je n'attendrais pas pour autant.~
@53083 = ~Je ne répondrais ni à vous ni à personne d'autre. Je reviens de l'enfer et je suis d'une humeur terrible.~
@53084 = ~Votre conflit avec les elfes noirs ne me concerne pas. Mon objectif est de retrouver Irenicus.~
@53085 = ~Je m'appelle <CHARNAME>. J'ai combattu les elfes noirs pour retrouver Irenicus !~
@53086 = ~Viconia est une elfe noire à part et a combattu autant que moi. Désormais nous recherchons Irenicus.~
@53087 = ~Je ne collabore pas, mais je ne juge pas les alliés juste à la couleur de leur peau.~
@53088 = ~Je ne répondrais ni à vous ni à personne d'autre. Je reviens de l'enfer et je suis d'une humeur terrible.~
@53089 = ~Je m'appelle <CHARNAME>. J'ai combattu les elfes noirs pour retrouver Irenicus !~
@53090 = ~Viconia est une elfe noire à part et a combattu autant que moi. Désormais nous recherchons Irenicus.~
@53091 = ~Je ne collabore pas, mais je ne juge pas les alliés juste à la couleur de leur peau.~
@53092 = ~Je ne répondrais ni à vous ni à personne d'autre. Je reviens de l'enfer et je suis d'une humeur terrible.~
@53093 = ~Dans ce cas, pourquoi n'allez-vous pas demander de l'aide aux Voleurs de l'ombre ? Pourquoi venir nous voir, vous qui avez si peu d'honneur ?~
@53094 = ~J'ai l'intention d'aller voir les Voleurs de l'ombre. Mais j'ai également besoin de votre aide. Bodhi et ses vampires sont nos ennemis à tous.~
@53095 = ~Je suis allé voir les Voleurs de l'ombre. Mais j'ai également besoin de votre aide. Bodhi et ses vampires sont nos ennemis à tous.~ ~Je suis allée voir les Voleurs de l'ombre. Mais j'ai également besoin de votre aide. Bodhi et ses vampires sont nos ennemis à tous.~
@53096 = ~Très bien. Si vous refusez de m'aider, je n'ai plus rien à faire ici.~
@53097 = ~Voici le genre d'affront qui pourrait blesser un vieil homme.~
@53098 = ~Le mensonge serait bien le plus innocent de vos actes commis jusqu'à présent, <CHARNAME>. Quittez ces lieux, vous n'y trouverez aucun soutien.~
@53099 = ~Vous osez ? Chevaliers de l'Ordre, à moi !~
@53100 = ~Pourquoi l'Ordre accepterait de vous aider ? Vous valez tout juste mieux que le plus commun des criminels.~
@53101 = ~Parce que nous avons une ennemie commune. J'ai l'intention de combattre une horde de puissants vampires, ici, dans cette ville... Et j'aimerais solliciter l'aide de l'Ordre.~
@53102 = ~Parce que nous avons une ennemie commune. J'ai l'intention de combattre une horde de puissants vampires, ici, dans cette ville... Et j'aimerais solliciter l'aide de l'Ordre.~
@53103 = ~Parce que mon ennemie n'est autre qu'une puissante vampire, ici, à Athkatla. Et je viens vous offrir le privilège de vous joindre à moi afin de l'éliminer.~
@53104 = ~Parce que mon ennemie n'est autre qu'une puissante vampire, ici, à Athkatla. Et je viens vous offrir le privilège de vous joindre à moi afin de l'éliminer.~
@53105 = ~Non. Vous êtes le mal, <CHARNAME>, et pour cette raison, vous ne recevrez aucune aide de ceux qui sont justes, quelle que soit votre cause. Quittez ces lieux immédiatement !~
@53106 = ~Je ne crois pas en vos intentions, <CHARNAME>. L'Ordre combattra ce mal mais pas à vos côtés. Quittez ces lieux immédiatement !~
@53107 = ~L'Ordre combattra ces vampires à vos côtés, <CHARNAME>. Rendez-vous au cimetière et entrez dans la crypte de cette vampire... Les paladins vous y rejoindront.~
@53108 = ~Je ne connaissais pas alors sa véritable nature et à l'époque, je n'avais guère le choix. Aujourd'hui, je sais qu'elle est mon ennemie. Mais elle est devenue trop puissante pour que je puisse l'éliminer seul.~ ~Je ne connaissais pas alors sa véritable nature et à l'époque, je n'avais guère le choix. Aujourd'hui, je sais qu'elle est mon ennemie. Mais elle est devenue trop puissante pour que je puisse l'éliminer seule.~
@53109 = ~Je vous le répète, l'Ordre ne vous apportera aucune aide. Quittez ces lieux et allez racontez vos mensonges à d'autres !~
@53110 = ~Ah ! <CHARNAME>, vous êtes là. Cela tombe très bien car on m'a chargé de vous trouver et de vous transmettre un message. Bien... c'est beaucoup plus simple comme ça, n'est-ce pas ?~
@53111 = ~En tant que membre des Voleurs de l'ombre, vous êtes attendu aussi vite que possible par le Maître des ombres en personne, Aran Linvail, pour un problème de la plus haute importance.~ ~En tant que membre des Voleurs de l'ombre, vous êtes attendue aussi vite que possible par le Maître des ombres en personne, Aran Linvail, pour un problème de la plus haute importance.~
@53112 = ~Vous avez rendu de grands services à notre guilde par le passé et le Maître des ombres, Aran Linvail, vous ouvre les portes de la guilde... il souhaite s'entretenir avec vous le plus vite possible.~
@53113 = ~Je ne saurais vous dire quelle est la raison de cet entretien, Monsieur, mais il vous attend chez lui, plus bas.~ ~Je ne saurais vous dire quelle est la raison de cet entretien, Madame, mais il vous attend chez lui, plus bas.~
@53114 = ~Très bien. Je m'y rends tout de suite.~
@53115 = ~Et si je refuse ?~
@53116 = ~Pas question. Je n'ai aucune envie de discuter avec Aran Linvail.~
@53117 = ~Pas question. Je n'ai aucune envie de discuter avec Aran Linvail.~
@53118 = ~Parfait. Le Maître des ombres sera content. Je m'en vais lui annoncer votre visite imminente.~
@53119 = ~S'il vous reste un peu de cervelle vous allez coopérer. Vous êtes dans une mauvaise position, à peine sorti de la tanière de l'ennemi.~ ~S'il vous reste un peu de cervelle vous allez coopérer. Vous êtes dans une mauvaise position, à peine sortie de la tanière de l'ennemi.~
@53120 = ~Euh... j'ai été très poli avec vous, et je crois savoir que le Maître des ombres vous estime beaucoup. Personnellement... je ne serais pas si prompt à renier un tel ami.~
@53121 = ~Je m'en vais lui annoncer votre arrivée. Vous pouvez aller lui parler quand vous le désirez.~
@53122 = ~Mais... vous êtes un Voleur de l'ombre ! Comment pouvez-vous refuser ? Je... je sais que le Maître des ombres vous estime beaucoup, mais je ne pense pas qu'il appréciera une telle impertinence. Mais... c'est à vous de voir.~
@53123 = ~Je comprends que le Maître des ombres lui-même vous ait réclamé <CHARNAME>. Je pense que vous devriez le faire sinon je ne peux rien faire pour vous aider.~
@53124 = ~Les Voleurs de l'ombre vont donc vous aider à combattre cette sorcière morte-vivante et son cercle. Je vous garantis que j'envoie mes assassins les plus compétents, <CHARNAME>.~
@53125 = ~Je n'y manquerai pas. Si cet Elhan peut me parler d'Irenicus, j'aimerais beaucoup le rencontrer.~
@53126 = ~Hmm, je ne sais pas ce que vous avez fait pour mettre Aran en colère mais il nous a dit de refuser toute aide pour lutter contre cette sorcière morte-vivante. Désolé <CHARNAME>, je ne peux rien faire.~
@53127 = ~J'ai des raisons pour vouloir agir rapidement. Cette rencontre devra être brève.~
@53128 = ~Liche élémentaire~
@53129 = ~Je surveillerai mes arrières en avançant. Vous le regretterez si c'est un piège.~
@53130 = ~Allez-y dans ce cas. J'ai besoin d'alliés pour la prochaine bataille.~
@53131 = ~J'ai des raisons pour vouloir agir rapidement. Cette rencontre devra être brève.~
@53132 = ~Irenicus ! Je connais bien ce nom. Allez-y et dites-moi ce que vous savez.~
@53133 = ~J'espère pour vous que ce n'est pas un piège. Je ne suis guère d'humeur.~
@53134 = ~Je comprends que la créature morte-vivante Bodhi soit morte. Bien joué, <CHARNAME>. Les Voleurs de l'ombre ne vous oublieront pas avec l'aide que vous nous avez apportée.~
@53135 = ~Oui, oui, je sais qui tu es, <GABBER>. Mais je voudrais parler à <CHARNAME>. Il est avec toi, n'est-ce pas ?~ ~Oui, oui, je sais qui tu es, <GABBER>. Mais je voudrais parler à <CHARNAME>. Elle est avec toi, n'est-ce pas ?~
@53136 = ~Votre destin sera bientôt scellé. Vous resterez sous bonne garde jusqu'à ce qu'Elhan vienne vous voir. Ne bougez pas ; on vous surveillera de très près de toute façon.~
@53137 = ~Ah, tu es tout de même revenu. Et bien plus tôt que je ne l'espérais. Je dois admettre qu'après ton départ sur le bateau d'Havarian, je me suis demandé si tu atteindrais l'île, sans parler de revenir.~ [ARAN23] ~Ah, tu es tout de même revenue. Et bien plus tôt que je ne l'espérais. Je dois admettre qu'après ton départ sur le bateau d'Havarian, je me suis demandé si tu atteindrais l'île, sans parler de revenir.~ [ARAN23]
@53138 = ~Bienvenue.~
@53139 = ~Je me le suis demandé aussi, compte tenu de la trahison de votre capitaine.~
@53140 = ~Vous voulez dire que vous espériez ne plus me revoir. Saemon Havarian m'a trahi... sur votre ordre, me semble-t-il.~ ~Vous voulez dire que vous espériez ne plus me revoir. Saemon Havarian m'a trahie... sur votre ordre, me semble-t-il.~
@53141 = ~Peu importe. Je suis de retour, et j'ai besoin de votre aide.~
@53142 = ~Une trahison ? Ça ne me surprend pas. Oh, ne me regarde pas comme ça, je n'y suis pour rien. Saemon Havarian n'était pas du tout un de mes hommes.~
@53143 = ~Je t'avais dit que peu de navires osent le voyage vers Brynnlaw, et tu as vu le genre de faune qu'on peut y trouver. J'ai bien peur qu'Havarian ait été le moins mauvais choix possible.~
@53144 = ~Si tu le souhaites, je peux faire retrouver et punir le capitaine pour cet... écart. Je lui avais payé un supplément pour te protéger, visiblement un gâchis de bon or.~
@53145 = ~Ne prenez pas cette peine. Havarian est déjà mort.~
@53146 = ~Pas besoin ! Ce bâtard est déjà en train de pourrir !~
@53147 = ~Non, c'est sans importance. Il ne semblait pas vraiment maître de ces actions, et pour ce que j'en sais, il est peut-être déjà mort.~
@53148 = ~Son bateau est par le fond, et il est peut-être mort. Ça me suffit.~
@53149 = ~Oui... s'il vit encore, retrouvez-le. Je refuse de le laisser s'en tirer comme ça.~
@53150 = ~Vraiment ? Quel dommage. L'affaire est donc close.~
@53151 = ~Alors nous le laisserons à son triste sort, c'est assez. Havarian est un peu comme de la mauvaise herbe, je doute d'en avoir fini avec lui.~
@53152 = ~Alors nous ferons en sorte que les Voleurs de l'ombre lui rendent une petite visite. J'ai cependant l'impression qu'il sera difficile à retrouver. Peu importe... nous sommes patients.~
@53153 = ~Tu as besoin de mon aide ? Et moi qui pensais que tu venais seulement en réponse à ma requête, car de mon côté, j'ai aussi besoin de ton aide.~
@53154 = ~C'est à cause de Bodhi que j'ai réclamé ta venue. Tu es parvenu à détruire sa guilde, ce dont je te suis reconnaissant, mais elle-même semble avoir survécu.~ ~C'est à cause de Bodhi que j'ai réclamé ta venue. Tu es parvenue à détruire sa guilde, ce dont je te suis reconnaissant, mais elle-même semble avoir survécu.~
@53155 = ~Je ne sais pas pourquoi elle est revenue à Athkatla, mais je ne peux prendre le risque de la laisser rebâtir son influence et se venger des Voleurs de l'ombre... et de moi, bien sûr.~
@53156 = ~J'aimerais que tu mettes un terme définitif à son existence. Je ne te reprocherai pas d'avoir échoué la dernière fois. Nous avions visiblement tout deux sous-estimé l'étendue de ses pouvoirs.~
@53157 = ~C'est de toute manière ce que je comptais faire. J'étais venu vous demander votre aide pour l'attaquer.~ ~C'est de toute manière ce que je comptais faire. J'étais venue vous demander votre aide pour l'attaquer.~
@53158 = ~C'est de toute manière ce que je comptais faire. J'étais venu vous demander votre aide pour l'attaquer.~ ~C'est de toute manière ce que je comptais faire. J'étais venue vous demander votre aide pour l'attaquer.~
@53159 = ~C'est de toute manière ce que je comptais faire. J'étais venu vous demander votre aide pour l'attaquer.~ ~C'est de toute manière ce que je comptais faire. J'étais venue vous demander votre aide pour l'attaquer.~
@53160 = ~Je le ferai, mais Bodhi est trop puissante pour que je l'attaque sans l'aide des Voleurs de l'ombre.~
@53161 = ~Oui... bienvenue.~
@53162 = ~Sachez que je ne vous fais pas confiance, je n'en ai aucune raison, n'en ressens pas le besoin et c'est sûrement la même chose pour vous.~
@53163 = ~Je le ferai, mais Bodhi est trop puissante pour que je l'attaque sans l'aide des Voleurs de l'ombre.~
@53164 = ~Je le ferai, mais Bodhi est trop puissante pour que je l'attaque sans l'aide des Voleurs de l'ombre.~
@53165 = ~Confiez-moi quelques assassins pour m'épauler et j'y réfléchirai.~
@53166 = ~Confiez-moi quelques assassins pour m'épauler et j'y réfléchirai.~
@53167 = ~Non, ce n'est pas le cas. Je suis simplement venu pour vous voir. Comme vous venez des profondeurs, je voulais voir si on le voyait dans vos yeux.~
@53168 = ~Très bien, tu fais partie des Voleurs de l'ombre et je ne te confierai pas une mission si dangereuse sans te fournir mon aide... en tout cas, pas cette fois.~
@53169 = ~Donc... avec cet aveu un peu original vous allez me dire de quoi il s'agit ?~
@53170 = ~Je veux seulement vous aider, bien que je ne sois pas d'une grande utilité si j'ignore de quoi il est question.~
@53171 = ~Cela m'est égal. Je recherche Jon Irenicus et sa sœur Bodhi.~
@53172 = ~Je ferai en sorte qu'Arkanis, Kachiko, et quelques autres de nos meilleurs assassins te retrouvent à l'entrée des catacombes où Bodhi réside. Je tiens à m'assurer de ne plus jamais l'avoir dans les pattes.~
@53173 = ~Rends-toi aux catacombes quand tu seras prêt. Tes acolytes t'y retrouveront. Hé, au fait... bonne chance.~ [ARAN24] ~Rends-toi aux catacombes quand tu seras prête. Tes acolytes t'y retrouveront. Hé, au fait... bonne chance.~ [ARAN24]
@53174 = ~Alors tu l'auras. Tu as fait tes preuves auprès de la guilde, et ta réputation m'encourage à te confier la vie de mes hommes.~
@53175 = ~Ajouter mes propres hommes à tes forces ? Pourquoi le ferais-je ? Tu les utiliserais comme de la chair à canon et j'aurais perdu mes derniers agents de valeur.~
@53176 = ~Je pense ne pas avoir à te rappeler ce que nous a coûté la guerre contre Bodhi. Il me reste peu de monde, et tu es trop peu digne de confiance pour que je remette leurs vies entre tes mains.~
@53177 = ~Après tout ce que j'ai accepté de faire, vous me jetez seul dans la gueule du loup ?!~ ~Après tout ce que j'ai accepté de faire, vous me jetez seule dans la gueule du loup ?!~
@53178 = ~Alors vous mourrez, car je ne pourrai pas la vaincre seul, et ensuite elle s'en prendra à vous.~ ~Alors vous mourrez, car je ne pourrai pas la vaincre seule, et ensuite elle s'en prendra à vous.~
@53179 = ~Il me faut toute l'aide disponible, Aran. J'ai besoin de chaque homme que vous pouvez envoyer.~
@53180 = ~Il me faut toute l'aide disponible, Aran. J'ai besoin de chaque homme que vous pouvez envoyer.~
@53181 = ~J'en ai plus qu'assez que vous me manipuliez pour ensuite me dire que c'est MOI qui suis indigne de confiance.~
@53182 = ~Liche élémentaire~
@53183 = ~Je n'aime pas le ton que tu emploies. C'est de ton échec qu'il s'agit, pour ne pas l'avoir tuée la première fois. J'ai à peine assez d'hommes de main pour me protéger, sans même parler de t'aider.~
@53184 = ~Kangaxx la liche~
@53185 = ~Kangaxx la liche~
@53186 = ~demi-orque~
@53187 = ~J'en ai plus qu'assez que vous me manipuliez pour ensuite me dire que c'est MOI qui suis indigne de confiance.~
@53188 = ~Kangaxx la demi-liche~
@53189 = ~Kangaxx la demi-liche~
@53190 = ~C'est une question de survie. Je n'ai presque rien à t'offrir. Je pourrais peut-être t'aider plus tard, mais pas maintenant, pas pour ce combat.~
@53191 = ~DEMI-ORQUES : Les demi-orques sont issus de l'union de parents humains et orques. Ils sont aussi grands que les humains, mais un peu plus lourds à cause de leur masse musculaire. Leur peau verdâtre, leur front fuyant, leurs mâchoires saillantes, leurs dents proéminentes et leur pilosité grossière les rendent faciles à reconnaître. Les demi-orques sont tolérés sur la Côte des Épées car, contrairement au nord, les habitants de cette région n'ont pas subi d'attaques orques depuis plusieurs siècles. Les demi-orques sont connus pour leur grande force.

Les demi-orques disposent des traits suivants :
- +1 en Force ; +1 en Constitution ; -2 en Intelligence.
- Infravision.~
@53192 = ~Shangalar~
@53193 = ~Shangalar~
@53194 = ~Revanek~
@53195 = ~Revanek~
@53196 = ~J'ai besoin de votre aide MAINTENANT. Sinon j'échouerai sûrement, et alors Bodhi viendra s'en prendre à vous.~
@53197 = ~J'ai besoin de votre aide MAINTENANT. Sinon j'échouerai sûrement, et alors Bodhi viendra s'en prendre à vous.~
@53198 = ~Vous devez nous trouver une sortie pour quitter cet endroit.~
@53199 = ~Alors vous me demandez de venir, vous exigez que j'essaye de tuer Bodhi, et vous ne m'offrez rien en retour ?~
@53200 = ~Olaf Rassmusen~
@53201 = ~Votre survie pourrait être compromise plus vite que prévu. Je n'apprécie pas qu'on me laisse tomber.~
@53202 = ~Olaf Rassmusen~
@53203 = ~Maferan~
@53204 = ~Maferan~
@53205 = ~J'exige que vous m'aidiez, Aran. Vous me devez bien ça.~
@53206 = ~J'exige que vous m'aidiez, Aran. Vous me devez bien ça.~
@53207 = ~Layene~
@53208 = ~Layene~
@53209 = ~Sion~
@53210 = ~Sion~
@53211 = ~~
@53212 = ~Demi-orque~
@53213 = ~Koshi~
@53214 = ~Elle est donc devenue si forte ? *soupire* Je déteste gaspiller mes ressources, mais je suppose que c'est la seule chance de détruire cette créature.~
@53215 = ~Koshi~
@53216 = ~Stalman~
@53217 = ~Stalman~
@53218 = ~Très bien, <CHARNAME>, tu auras l'aide des Voleurs de l'ombre. Mais au moindre signe de trahison, tu te débrouilleras sans nous.~
@53219 = ~Et pourquoi faudrait-il que je m'en occupe ?~
@53220 = ~Ketta~
@53221 = ~Ketta~
@53222 = ~*soupire* Enfin... je suppose qu'il n'y a pas vraiment de raison de ne pas te confier la vie de mes hommes. Je suis prêt à faire beaucoup pour m'assurer que cette vampire soit enfin détruite.~
@53223 = ~Vaxall~
@53224 = ~Vaxall~
@53225 = ~Shyressa~
@53226 = ~Shyressa~
@53227 = ~Je n'ai pas confiance en toi et je n'aime pas risquer la vie de mes hommes, mais je n'ai pas le choix. Si je t'aide, nous sommes quittes... après la mort de Bodhi, je ne veux plus avoir affaire à toi.~
@53228 = ~Tu as peut-être raison. Ta réputation n'est pas si mauvaise, et tes efforts jusqu'ici méritent justice. Je peux te renvoyer la balle.~
@53229 = ~Tu es plus qu'indigne de confiance, <CHARNAME>, tu es dangereux. Tu penses que les Voleurs de l'ombre ne savent rien de tes actions hors de ces murs ?~ ~Tu es plus qu'indigne de confiance, <CHARNAME>, tu es dangereuse. Tu penses que les Voleurs de l'ombre ne savent rien de tes actions hors de ces murs ?~
@53230 = ~Non, tu ne mérites pas qu'on te confie d'autres vies que la tienne. Pars... tue Bodhi si tu le peux, et nous en aurons terminé. Mais tu ne recevras aucune aide de ma part.~
@53231 = ~Encore ? Tu n'as pas fini le travail la dernière fois, et je ne doute pas que Bodhi ait des comptes à régler avec toi. Va tuer Bodhi si tu le peux, mais tu n'auras rien de moi.~
@53232 = ~Je serais heureux de vous aider pendant ma propre recherche de Jon Irenicus.~ ~Je serais heureuse de vous aider pendant ma propre recherche de Jon Irenicus.~
@53233 = ~Personne d'autre que toi n'est assez stupide pour oser me menacer dans mon propre repaire, <CHARNAME>. N'y pense même pas.~
@53234 = ~Nos difficultés actuelles sont dues à ton échec à la tuer la dernière fois. À toi d'en assumer les conséquences. Va tuer Bodhi si tu le peux, mais tu n'auras rien de moi.~
@53235 = ~Tu n'exigeras rien ici, <CHARNAME>. Je ne te dois rien, et je ne m'abaisserai pas à répondre à de telles prétentions venant de quelqu'un ayant si mauvaise réputation.~
@53236 = ~Va... Va au cimetière et entre dans les catacombes quand tu seras prêt. Mes meilleurs assassins t'y retrouveront, et j'espère qu'ils suffiront. Et maintenant... laisse-moi, je dois faire les préparatifs.~ ~Va... Va au cimetière et entre dans les catacombes quand tu seras prête. Mes meilleurs assassins t'y retrouveront, et j'espère qu'ils suffiront. Et maintenant... laisse-moi, je dois faire les préparatifs.~
@53237 = ~Ma décision est prise, <CHARNAME>. Tue Bodhi, mais fais-le sans mon aide... et nous serons quittes. Et maintenant sors immédiatement.~
@53238 = ~Alors... Bodhi est enfin morte ? Je suis très satisfait. Tous les Voleurs de l'ombre peuvent pousser un soupir de soulagement. C'est du bon travail, <CHARNAME>.~
@53239 = ~Elhan va s'occuper de vous. Il va s'assurer que vous êtes bien installés et que vous révéliez ce qui est nécessaire à votre sujet. Il a de l'expérience et il connaît bien l'ennemi.~
@53240 = ~L'alliance de nos forces a été plus que fructueuse ! Et aujourd'hui, nous avons fait un grand pas en avant dans notre lutte contre le mal... Les vaillants paladins, morts pour cette cause, seront longtemps pleurés. <CHARNAME>, je suis fier de vous ; vous avez fait du bon travail.~
@53241 = ~Vous serez utile si vous répondez à nos questions. Vous amènerez peut-être des précisions, mais peut-être pas. Il est également possible que vous soyez du côté de l'ennemi.~
@53242 = ~Problèmes de l'île : l'histoire de Ginia

J'ai payé 200 pièces d'or à Calahan pour aider Ginia et son frère. Il leur fera quitter l'île si Chremy ne peut pas s'y opposer.~
@53243 = ~Aubemestre, je suis venu demander l'aide de l'église dans une affaire d'importance.~ ~Aubemestre, je suis venue demander l'aide de l'église dans une affaire d'importance.~
@53244 = ~Oh ? Quel est le problème ? Éclairez-moi et je vous dirai si l'église de Lathandre peut vous prêter secours.~
@53245 = ~Je dois affronter une puissante vampire appelée Bodhi... et j'espère que l'église pourra m'aider dans mon combat.~
@53246 = ~Je dois affronter une puissante vampire appelée Bodhi... et j'espère que l'église pourra m'aider dans mon combat.~
@53247 = ~Je dois affronter une puissante vampire appelée Bodhi... et j'espère que l'église pourra m'aider dans mon combat.~
@53248 = ~Ah. Je connais cette créature... c'est celle qui réside dans les cryptes sous le cimetière, c'est ça ? Il est bon de savoir que vous comptez affronter une telle abomination.~
@53249 = ~Si ce n'est déjà fait, allez trouver les paladins du Cœur radieux. Ils sont plus aptes que nous au combat, et vous seront plus utiles. Lathandre vous protège, mon ami.~ ~Si ce n'est déjà fait, allez trouver les paladins du Cœur radieux. Ils sont plus aptes que nous au combat, et vous seront plus utiles. Lathandre vous protège, mon amie.~
@53250 = ~*des morceaux de pierre et de mortier jonchent le sol autour de la statue... cette dernière semble endommagée, un morceau manque... si vous le désirez, vous pouvez regarder de plus près*~
@53251 = ~Allez en paix, mon frère.~ ~Allez en paix, ma sœur.~
@53252 = ~Je vois. Vous évoquez des noms très intéressants, des noms que vous ne pourriez connaître à moins d'être ennemi de nos ennemis... ou plutôt de leurs amis.~ ~Je vois. Vous évoquez des noms très intéressants, des noms que vous ne pourriez connaître à moins d'être ennemie de nos ennemis... ou plutôt de leurs amis.~
@53253 = ~Je connais cette créature, celle dont vous parlez. Elle réside dans les cryptes sous le cimetière et répand son influence maléfique comme une maladie.~
@53254 = ~Je n'offre qu'un conseil, car aucun serviteur de Lathandre ne risquera sa vie pour vous. Il y a d'autres façons de combattre le mal. Cherchez les paladins ; ce sont les champions des batailles sacrées.~
@53255 = ~Je suis venu demander l'aide de l'église pour une grande bataille que je dois livrer, Héraut des Tempêtes.~ ~Je suis venue demander l'aide de l'église pour une grande bataille que je dois livrer, Héraut des Tempêtes.~
@53256 = ~Je suis venu demander l'aide de l'église pour une grande bataille que je dois livrer, Héraut des Tempêtes.~ ~Je suis venue demander l'aide de l'église pour une grande bataille que je dois livrer, Héraut des Tempêtes.~
@53257 = ~Une bataille ? Pourquoi les serviteurs du Seigneur des Tempêtes devraient-ils participer à une bataille sans que Talos en personne l'ait souhaité ? Parlez !~
@53258 = ~Je dois détruire une puissante vampire nommée Bodhi, qui garde...~
@53259 = ~Je dois détruire une puissante vampire nommée Bodhi, qui garde...~
@53260 = ~Je dois détruire une puissante vampire nommée Bodhi, qui garde...~
@53261 = ~La suceuse de sang des cryptes ? Talos n'a rien contre elle et il n'est pas apitoyé par votre faiblesse avouée. Si vous souhaitez le combattre, faites-le.~
@53262 = ~*alors que vous vous approchez de la statue, celle-ci, à votre grande surprise, se met à bouger... la tête de pierre se tourne vers vous, ses lèvres remuent, mais aucun son n'en sort... la statue tend les mains, comme pour demander quelque chose, et une expression de profonde tristesse s'inscrit sur son visage de marbre... après un court instant, la statue reprend sa position initiale et ne bouge plus*~
@53263 = ~Reine-mère~
@53264 = ~Maintenant, hors d'ici. J'ai pris ma décision et elle est irrévocable.~
@53265 = ~Je connais la créature dont vous parlez. Talos la frapperait volontiers... mais certainement pas pour vous. Vos motifs sont suspects et vous ne recevrez donc aucune aide.~
@53266 = ~Reine-mère~
@53267 = ~Reine-mère~
@53268 = ~Je viens demander l'aide de Heaum pour une affaire très importante, Sentinelle Suprême.~
@53269 = ~Je viens demander l'aide de Heaum pour une affaire très importante, Sentinelle Suprême.~
@53270 = ~Dans ceci comme dans toute chose, Heaum fera son devoir. Quelle est cette affaire, <CHARNAME> ? Parlez, je vous dirai comment Heaum peut vous aider.~
@53271 = ~Que Heaum vous protège et vous garde du danger dans vos futures entreprises. Maintenant... excusez-moi, mais j'ai beaucoup à faire.~
@53272 = ~Je viens demander l'aide de Heaum pour une affaire très importante, Sentinelle Suprême.~
@53273 = ~Je dois combattre une puissante vampire qui est dans cette ville, et je ne peux pas l'affronter seul. Je demande l'aide de l'église.~ ~Je dois combattre une puissante vampire qui est dans cette ville, et je ne peux pas l'affronter seule. Je demande l'aide de l'église.~
@53274 = ~Je dois combattre une puissante vampire qui est dans cette ville, et je ne peux pas l'affronter seul. Je demande l'aide de l'église.~ ~Je dois combattre une puissante vampire qui est dans cette ville, et je ne peux pas l'affronter seule. Je demande l'aide de l'église.~
@53275 = ~Je dois combattre une puissante vampire qui est dans cette ville, et je ne peux pas l'affronter seul. Je demande l'aide de l'église.~ ~Je dois combattre une puissante vampire qui est dans cette ville, et je ne peux pas l'affronter seule. Je demande l'aide de l'église.~
@53276 = ~Je connais cette vampire... c'est Bodhi, n'est-ce pas ? Heaum sait qu'elle nous met tous en danger. Nous sommes des gardiens autant que des serviteurs... Si seulement nous pouvions vous aider !~
@53277 = ~Mais nous ne sommes pas en mesure de vous venir en aide. Je vous suggère d'aller voir les paladins de l'Ordre du Cœur radieux si vous ne l'avez pas déjà fait.~
@53278 = ~Aux mains des flagelleurs mentaux !

Je suis de nouveau tombé sur les githyankis. Le fait que j'ai survécu à la cité illithide les a impressionné, mais mon sort ne semble toujours pas les préoccuper outre mesure. Je les ai laissé partir. Il n'y avait rien à gagner d'une confrontation.~ ~Aux mains des flagelleurs mentaux !

Je suis de nouveau tombée sur les githyankis. Le fait que j'ai survécu à la cité illithide les a impressionné, mais mon sort ne semble toujours pas les préoccuper outre mesure. Je les ai laissé partir. Il n'y avait rien à gagner d'une confrontation.~
@53279 = ~Je vous ai donné ma réponse. Maintenant, allez en paix.~
@53280 = ~Lolth soit louée.~ [DRFEM102]
@53281 = ~Je connais cette créature dont vous me parlez... Bodhi ! Heaum la surveille, mais n'a pas encore jugé bon de contrecarrer ses plans. Nous ne vous aiderons pas.~
@53282 = ~Demandez l'aide des paladins de l'Ordre du Cœur radieux, si ce n'est pas déjà fait... Ce sont les guerriers idéaux pour votre bataille contre les créatures du mal.~
@53283 = ~Le destin de l'elfe noir est dans la conquête.~ [DRFEM103]
@53284 = ~Ne projette pas ton ombre sur moi ! J'ai de nombreuses choses à accomplir, et aucunes ne te concernent.~ [DRFEM104]
@53285 = ~Aaah, aaaaahh, aahh, aaah...~ [DRFEM106]
@53286 = ~Aah !~ [DRFEM105]
@53287 = ~Galvena~
@53288 = ~Galvena~
@53289 = ~Toi ! Je te reconnais ! Tu es le cloporte qui m'a dépouillé près de la Porte de Baldur. La fripouille qui m'a attaqué sans aucune raison valable et qui a filé avec mon équipement !~ [DRIZZT02]
@53290 = ~Front~
@53291 = ~Front~
@53292 = ~Que les ténèbres te dévorent !~ [DRFEM107]
@53293 = ~Ne sous-estime pas les Mères Matrones. Ne remets pas en question leurs décisions.~ [DRMEN101]
@53294 = ~Sachez que je suis Drizzt Do'Urden et que j'ai passé ma vie à me battre contre tous les diables qui se sont mis en travers de ma route, y compris les bandits de votre espèce.~
@53295 = ~Il m'a fallu du temps pour retrouver mes cimeterres et vous avoir à ma merci ne s'est pas fait sans difficultés. Mais maintenant, je vous tiens.~
@53296 = ~Allons, Drizzt... s'il s'agit de l'affreux bandit qui vous a assailli lorsque vous combattiez les gnolls, alors abattons-le et retournons aux Dix-Cités où ils ont vraiment besoin de nous.~ ~Allons, Drizzt... s'il s'agit de l'affreux bandit qui vous a assailli lorsque vous combattiez les gnolls, alors abattons-la et retournons aux Dix-Cités où ils ont vraiment besoin de nous.~
@53297 = ~Méfiance, Drizzt... Il m'a l'air bien plus puissant que la dernière fois que tu l'as rencontré. Ne nous lançons pas dans un combat dont nous ne pourrions ne pas sortir vainqueurs.~ ~Méfiance, Drizzt... Elle m'a l'air bien plus puissante que la dernière fois que tu l'as rencontrée. Ne nous lançons pas dans un combat dont nous ne pourrions ne pas sortir vainqueurs.~
@53298 = ~Capitaine des gardes~
@53299 = ~Capitaine des gardes~
@53300 = ~Ne vous inquiétez pas, Cattie-Brie, je ne vous ai pas fait venir ici pour que vous vous joigniez à ma soif de vengeance... même si ce <PRO_RACE> mériterait que je le fasse. Je cherche simplement une réponse.~
@53301 = ~Pourquoi m'avez-vous attaqué, <PRO_RACE> ? N'êtes-vous qu'un simple bandit cupide et rien de plus ? Si tel est le cas, je serais déçu.~
@53302 = ~Vadek~
@53303 = ~Vadek~
@53304 = ~Alors préparez-vous à être déçu parce que je n'ai pas abandonné ces armes superbes de mon plein gré et je suis ravi de les revoir une fois encore !~ ~Alors préparez-vous à être déçu parce que je n'ai pas abandonné ces armes superbes de mon plein gré et je suis ravie de les revoir une fois encore !~
@53305 = ~Je vous ai tué parce que je le voulais, pauvre idiot, et je compte bien le refaire !~
@53306 = ~Arrimeur~
@53307 = ~Arrimeur~
@53308 = ~Claire~
@53309 = ~Claire~
@53310 = ~Golin~
@53311 = ~Golin~
@53312 = ~Je vous ai attaqué parce que vous êtes un elfe noir et je n'avais pas l'attention d'attendre que vous m'attaquiez le premier une fois que vous en auriez eu fini avec les gnolls.~
@53313 = ~Je vous ai tué et je n'ai pas à m'en expliquer davantage. Si vous vous en allez maintenant, vous aurez la vie sauve.~ ~Je vous ai tuée et je n'ai pas à m'en expliquer davantage. Si vous vous en allez maintenant, vous aurez la vie sauve.~
@53314 = ~Clef de Galvena~
@53315 = ~C'était il y a bien longtemps, j'ai changé depuis. Peut-être ai-je eu tort de vous attaquer.~
@53316 = ~Clef de Galvena~
@53317 = ~Vous voyez ?! Je vous l'avais dit, Drizzt... c'est une ordure et rien de plus ! Crevons l'abcès et finissons-en avec lui !~ ~Vous voyez ?! Je vous l'avais dit, Drizzt... c'est une ordure et rien de plus ! Crevons l'abcès et finissons-en avec elle !~
@53318 = ~Médaillon de Galvena~
@53319 = ~Symbole de Galvena~
@53320 = ~Très bien. Je vous ai donné votre chance, qui que vous soyez. Il est évident que vous êtes un être méprisable que seule la mort peut honorer. Qu'il en soit ainsi.~ ~Très bien. Je vous ai donné votre chance, qui que vous soyez. Il est évident que vous êtes une personne méprisable que seule la mort peut honorer. Qu'il en soit ainsi.~
@53321 = ~Je vous ai attaqué parce que vous êtes un elfe noir et je n'avais pas l'attention d'attendre que vous m'attaquiez le premier une fois que vous en auriez eu fini avec les gnolls.~
@53322 = ~Ah ! Vous m'avez attaqué à cause de la réputation de mon peuple ? Pourquoi, dans ce cas, avez-vous une elfe noire dans votre bande ? Elle, vous ne l'avez pas attaquée !~
@53323 = ~Viconia est proscrite mais elle a prouvé qu'elle était digne de confiance. Je reste sur mes gardes, pourtant. Elle serait capable de me tuer si cela l'arrangeait.~
@53324 = ~Viconia est aussi diablesse que n'importe quel autre elfe noir et je ne lui fais pas plus confiance à elle qu'à vous. Elle m'accompagne parce qu'elle m'est utile.~
@53325 = ~Viconia m'accompagne parce que je l'aime. Elle est très différente des gens de son peuple et je lui fais entièrement confiance.~ ~Viconia m'accompagne parce qu'elle m'est précieuse. Elle est très différente des gens de son peuple et je lui fais entièrement confiance.~
@53326 = ~C'est ce que je ressentais, je vous l'ai dit. Mais ce n'est plus le cas maintenant. Je sais, à présent, que les exceptions existent, même chez les elfes noirs.~
@53327 = ~Ah, vous me mettez dans le même panier que les autres elfes noirs, très bien. Cependant, je tiens à vous dire que je ne suis pas comme les autres gens de mon peuple. Vous m'avez attaqué sans raison alors que nous n'avions aucune querelle.~
@53328 = ~Ouais, Drizzt Do'Urden est un valeureux guerrier qui a accompli de grandes choses. C'est aussi notre ami. Ses ennemis sont nos ennemis.~
@53329 = ~Toutes les choses ne sont pas aussi absolues, brave homme. De mon temps j'ai vu suffisamment de bizarreries, assez pour faire tomber les poils des pieds d'une petite-personne !~ ~Toutes les choses ne sont pas aussi absolues, brave femme. De mon temps j'ai vu suffisamment de bizarreries, assez pour faire tomber les poils des pieds d'une petite-personne !~
@53330 = ~Wulfgar et Regis sont de mes amis, et ils veulent le bien. Ils approuvent le fait que je me batte pour ce qui est bon et juste. Pouvez-vous en dire autant, <PRO_RACE> ?~
@53331 = ~Oui. Moi aussi, je me bats pour des causes justes.~
@53332 = ~Oui. Moi aussi, je me bats pour des causes justes.~
@53333 = ~Non, pas vraiment. Je ne pourrais pas me vanter de si nobles actions.~
@53334 = ~Non, pas vraiment. Je ne pourrais pas me vanter de si nobles actions.~
@53335 = ~Pas du tout. Je me bats pour moi-même et pour ce qui m'intéresse. La bonté n'a rien à voir là-dedans.~
@53336 = ~Pas du tout. Je me bats pour moi-même et pour ce qui m'intéresse. La bonté n'a rien à voir là-dedans.~
@53337 = ~Tout ce que je puis vous dire, elfe noir, c'est que votre mort m'apportera un plaisir immense.~
@53338 = ~Eh ? Le <PRO_RACE> nous menacerait-il ? Pensez-vous qu'il soit sérieux ?~ ~Eh ? La <PRO_RACE> nous menacerait-elle ? Pensez-vous qu'elle soit sérieuse ?~
@53339 = ~Il semblerait que ce soit comme cela, Wulfgar mon garçon. Ha ! Nous avons été confronté à de la vermine démoniaque et pire à notre époque... peut-être cette maraude a-t-elle besoin que nous lui donnions ce qu'elle mérite, Drizzt.~
@53340 = ~Cette fois, <PRO_RACE>, je ne suis pas seul et une bataille avec des gnolls ne me préoccupe guère. Voyons quelles sont vos limites dans une bataille livrée honnêtement.~
@53341 = ~Peut-être. Je crois que les gens peuvent changer. Peut-être avez-vous... J'ai fait de nombreuses erreurs dans ma vie mais j'ai toujours essayé de les rattraper.~
@53342 = ~Pour un mâle, seuls les livres des mages ou la chambre à coucher permettent d'accéder aux plus hauts rangs.~ [DRMEN102]
@53343 = ~S'écarter de la maison et de la reine revient à creuser sa propre tombe.~ [DRMEN103]
@53344 = ~Ssssacrifice... votre maudite tête fera l'affaire...~
@53345 = ~À vos ordres !~ [DRMEN104]
@53346 = ~Les elfes noirs règnent en maîtres !~ [DRMEN107]
@53347 = ~Aaaah ! Aaah, oooohh, oohhh...~ [DRMEN105]
@53348 = ~Arrrr !~ [DRMEN106]
@53349 = ~C'est donc une elfe noire mais vous ne la tuez pas. Pourquoi, dans ce cas, mériterais-je la mort ? J'ai abandonné mon peuple... Je suis différent, aussi bien de votre amie que des autres elfes noirs.~
@53350 = ~Une réponse qui en dit long sur l'homme qui m'a attaqué sans aucune raison alors que j'étais vulnérable. Je ne suis pas l'elfe noir que vous imaginez. Je me suis battu suffisamment pour mériter mieux que cela.~ ~Une réponse qui en dit long sur la femme qui m'a attaqué sans aucune raison alors que j'étais vulnérable. Je ne suis pas l'elfe noir que vous imaginez. Je me suis battu suffisamment pour mériter mieux que cela.~
@53351 = ~Vous aimez cette elfe ? C'est intéressant. Peut-être n'êtes-vous plus le même homme que celui que je connaissais. Bon nombre de gens peuvent changer dans un délai très court. Je le sais très bien.~ ~Vous êtes attachée à cette elfe ? C'est intéressant. Peut-être n'êtes-vous plus la même femme que celle que je connaissais. Bon nombre de gens peuvent changer dans un délai très court. Je le sais très bien.~
@53352 = ~Dites-moi alors, <PRO_RACE>, qu'il n'y a aucun différend entre nous, que je peux vous laisser la vie sauve sans que vous me cherchiez à nouveau querelle ou que vous vous en preniez à d'autres innocents.~
@53353 = ~Dites-moi cela, <PRO_RACE>, et je serai satisfait. Alors, que dites-vous ?~
@53354 = ~Je dis qu'il est temps pour vous de mourir, maintenant. Je ne souffrirai pas davantage ce sermon !~
@53355 = ~Je ferai ce que je désire, elfe noir, et je n'ai nullement besoin de vous certifier quoi que soit.~
@53356 = ~Il n'y a aucun différend entre nous, elfe noir. Je regrette ce qui s'est passé la dernière fois. Ne craignez rien, je ne serai plus une menace pour qui que ce soit.~
@53357 = ~C'est bien. Je ne crois pas que vous cherchiez à me duper. Peut-être qu'après tout, cette histoire n'est qu'un malentendu et rien de plus.~
@53358 = ~Louée soit Lolth ! Elle nous a accordé la victoire.~ [DRPRIS01]
@53359 = ~Vous êtes un fieffé menteur. J'ai vu si souvent le mal que je sais le reconnaître lorsque je le vois chez quelqu'un. Le fait que vous pensiez ne pas avoir de torts me trouble plus encore que n'importe quelle autre chose.~ ~Vous êtes une menteuse. J'ai vu si souvent le mal que je sais le reconnaître lorsque je le vois chez quelqu'un. Le fait que vous pensiez ne pas avoir de torts me trouble plus encore que n'importe quelle autre chose.~
@53360 = ~Tu n'as guère le choix, Drizzt. Nous ne pouvons laisser un tel homme en liberté... qui sait ce dont il est capable et quels autres actes horribles il a commis aux dépens d'autres ?~ ~Tu n'as guère le choix, Drizzt. Nous ne pouvons laisser une telle femme en liberté... qui sait ce dont elle est capable et quels autres actes horribles elle a commis aux dépens d'autres ?~
@53361 = ~Peut-être avez-vous raison. Finissons-en maintenant.~
@53362 = ~Mais je ne pense pas que vous soyez foncièrement mauvais. Je ne prétends pas que nous devons tous nous battre pour défendre le bien, simplement, il ne faut pas se battre contre lui. Peut-être n'y a-t-il aucune raison valable pour que je m'inquiète.~ ~Mais je ne pense pas que vous soyez foncièrement mauvaise. Je ne prétends pas que nous devons tous nous battre pour défendre le bien, simplement, il ne faut pas se battre contre lui. Peut-être n'y a-t-il aucune raison valable pour que je m'inquiète.~
@53363 = ~Bien sûr que non, puisque votre cœur est empli de mal, petit homme. Je l'ai vu assez souvent pour le reconnaître lorsque je le vois chez quelqu'un. Et je le vois en vous.~ ~Bien sûr que non, puisque votre cœur est empli de mal, petite femme. Je l'ai vu assez souvent pour le reconnaître lorsque je le vois chez quelqu'un. Et je le vois en vous.~
@53364 = ~Mais je ne suis pas ici pour réclamer vengeance. Cependant, je pense que vous avez besoin d'une bonne leçon. Bien que je n'aie pas encore déterminé de quelle nature elle sera.~
@53365 = ~Laissez <CHARNAME> se mettre à genoux, Drizzt... Faites qu'il s'excuse ! Laissez-lui dire qu'il est désolé !~ ~Laissez <CHARNAME> se mettre à genoux, Drizzt... Faites qu'elle s'excuse ! Laissez-la dire qu'elle est désolée !~
@53366 = ~Ha ! Très bien, Regis. Peut-être avez-vous raison. Si cet homme maléfique peut ravaler sa fierté au point qu'il s'excuse à genoux, alors je serai satisfait.~ ~Ha ! Très bien, Regis. Peut-être avez-vous raison. Si cette femme maléfique peut ravaler sa fierté au point qu'elle s'excuse à genoux, alors je serai satisfait.~
@53367 = ~Soyez vigilants, restez aux aguets et la déesse vous octroiera peut-être une longue et heureuse existence !~ [DRPRIS02]
@53368 = ~Ha ! J'aime, j'adore ! Vous là-bas, <PRO_RACE>... je vous suggère de vous mettre à genoux rapidement et de vous excuser auprès de notre ami, Drizzt. Allez, plus vite... je ne vous laisserai pas beaucoup de temps.~
@53369 = ~*se mettre à genoux* Très bien, s'il en est ainsi. Je vous demande pardon, Drizzt Do'Urden... pour vous avoir attaqué et vous avoir volé votre équipement. Je vous présente mes plus humbles excuses.~
@53370 = ~Je m'excuse auprès de l'elfe noir, et je suis sérieux... mais je ne m'abaissera jamais devant quelqu'un.~ ~Je m'excuse auprès de l'elfe noir, et je suis sérieuse... mais je ne m'abaissera jamais devant quelqu'un.~
@53371 = ~Laissez tomber ! Je préfère vous tuer plutôt que d'être confronté à un tel ridicule !~ ~Laissez tomber ! Je préfère vous tuer plutôt que d'être confrontée à un tel ridicule !~
@53372 = ~« Et je m'excuse d'avoir été une vermine maléfique et je vous promets que je n'attaquerai plus les voyageurs innocents... »~
@53373 = ~Et... je m'excuse d'avoir été une vermine maléfique et je vous promets que je n'attaquerai plus les voyageurs innocents.~
@53374 = ~Oui, oui, ça. Ce que dit le nain.~
@53375 = ~Je ne dirai PAS une telle chose.~
@53376 = ~Si la Reine des Profondeurs Démoniaques tente de te séduire, tu répondras bien vite à ses appels !~ [DRPRIS03]
@53377 = ~Ne soyez pas absurde ! Je préfère vous tuer plutôt que d'être confronté à une telle dérision !~ ~Ne soyez pas absurde ! Je préfère vous tuer plutôt que d'être confrontée à une telle dérision !~
@53378 = ~C'en est assez pour moi. Bruenor, mon ami, vous pouvez vous écarter de lui.~ ~C'en est assez pour moi. Bruenor, mon ami, vous pouvez vous écarter d'elle.~
@53379 = ~Pour la gloire de la mère noire !~ [DRPRIS04]
@53380 = ~Alors, nous nous quittons ici. Continuez vos voyages, <PRO_RACE>. Moi, je retourne aux Dix-Cités. Même si je perds votre trace, nous nous retrouverons un jour.~
@53381 = ~Venez, mes amis. Allons-nous-en.~
@53382 = ~Nul n'échappe à la colère de la mère noire !~ [DRPRIS07]
@53383 = ~Arrr !~ [DRPRIS05]
@53384 = ~Ah bon ? Je suis troublé de voir tant de malveillance étalée au grand jour. Vous n'avez pas d'hostilité à mon égard mais je me demande combien de gens vous avez traité de la même manière que moi.~
@53385 = ~Ce ne sera pas suffisant. Tu as dépouillé un héros des Royaumes sans raison. Tu dois déjà d'estimer heureux qu'il ne t'ait pas sauté dessus dès qu'il t'a vu.~ ~Ce ne sera pas suffisant. Tu as dépouillé un héros des Royaumes sans raison. Tu dois déjà d'estimer heureuse qu'il ne t'ait pas sauté dessus dès qu'il t'a vu.~
@53386 = ~Je ne suis pas ici pour me venger, Cattie-Brie, mais si ce <PRO_RACE> ne peut me donner l'assurance qu'il ne recommencera plus à agir de la sorte, j'avoue ne pas savoir quelle décision prendre.~ ~Je ne suis pas ici pour me venger, Cattie-Brie, mais si ce <PRO_RACE> ne peut me donner l'assurance qu'elle ne recommencera plus à agir de la sorte, j'avoue ne pas savoir quelle décision prendre.~
@53387 = ~Aaaaahhh...~ [DRPRIS06]
@53388 = ~Ma maison est tombée en disgrâce ; et je suis donc à ce titre sans valeur.~ [DRSLV101]
@53389 = ~Pour mon malheur : j'ai provoqué la colère de la mère noire. Si seulement les circonstances étaient différentes...~ [DRSLV102]
@53390 = ~Les choses... pourraient être bien pires. J'aurais pu être transformé en... drider.~ [DRSLV103]
@53391 = ~Très bien. Je suis bien aise de voir qu'il n'y a pas aucune nécessité de recourir à la violence puisque vous ne représentez plus de menace pour le bien-être des gens.~
@53392 = ~Mes amis et moi retournons aux Dix-Cités, à présent. Et je vous souhaite de poursuivre votre voyager sans ennui. Peut-être nous retrouverons-nous un jour.~
@53393 = ~Vous n'espérez quand même pas partir aussi facilement ? Je viens de décider qu'il était temps pour vous et vos amis pharisiens de mourir !~
@53394 = ~Attendez, Drizzt. J'ai une proposition à vous faire si vous êtes vraiment le héros que vous prétendez être.~
@53395 = ~Attendez, Drizzt. J'ai une proposition à vous faire si vous êtes vraiment le héros que vous prétendez être.~
@53396 = ~Très bien. Une autre fois, peut-être.~
@53397 = ~<PRO_RACE>, les propositions que vous pourriez me faire ne m'intéressent pas. Si l'on pouvait se fier à vous, peut-être... Mais ce n'est pas encore le cas.~
@53398 = ~Très bien. À un jour prochain, peut-être.~
@53399 = ~Attendez, Drizzt. J'ai une proposition à vous faire si vous êtes vraiment le héros que vous prétendez être.~
@53400 = ~Attendez, Drizzt. J'ai une proposition à vous faire si vous êtes vraiment le héros que vous prétendez être.~
@53401 = ~Une proposition ? Je vais vous écouter, <PRO_RACE>, mais je suis sur mes gardes. Parlez, si vous le désirez.~
@53402 = ~Je suis <CHARNAME> et il me faut affronter une vampire à Athkatla. Mais sa puissance est telle que je n'en viendrai pas à bout tout seul. M'aiderez-vous à la combattre ?~ ~Je suis <CHARNAME> et il me faut affronter une vampire à Athkatla. Mais sa puissance est telle que je n'en viendrai pas à bout toute seule. M'aiderez-vous à la combattre ?~
@53403 = ~*sur l'estrade se trouve un autel recouvert de sang séché dédié à une répugnante créature à huit pattes... un pouvoir maléfique semble baigner l'endroit*~
@53404 = ~Je suis <CHARNAME> et il me faut affronter une vampire à Athkatla. Mais sa puissance est telle que je n'en viendrai pas à bout tout seul. M'aiderez-vous à la combattre ?~ ~Je suis <CHARNAME> et il me faut affronter une vampire à Athkatla. Mais sa puissance est telle que je n'en viendrai pas à bout toute seule. M'aiderez-vous à la combattre ?~
@53405 = ~J'ai entendu des rumeurs au sujet d'une vampire. On dit que c'est elle qui aurait massacré la guilde des Voleurs de l'ombre. Parle-t-on de la même créature ?~
@53406 = ~J'ai entendu des rumeurs au sujet de cette créature mais j'ai également ouï dire que sa cohorte et elle-même avaient été anéantis. Seriez-vous en train de prétendre que ce n'est pas vrai et qu'elle est encore vivante ?~
@53407 = ~Je voudrais d'abord explorer cette zone. Cet autel a quelque chose d'étrange.~
@53408 = ~Ce n'est pas grave. Je serai en chemin.~
@53409 = ~Je suis prêt à me rendre au jugement.~ ~Je suis prête à me rendre au jugement.~
@53410 = ~Comme il vous plaira. Une autre fois, peut-être.~
@53411 = ~Comme vous voudrez. Je serai ici quand vous serez préparé.~ ~Comme vous voudrez. Je serai ici quand vous serez préparée.~
@53412 = ~Oui. C'est moi qui ai massacré la guilde des Voleurs pour elle mais aujourd'hui, nous sommes ennemis. Sa puissance est telle que je ne peux la vaincre seul.~ ~Oui. C'est moi qui ai massacré la guilde des Voleurs pour elle mais aujourd'hui, nous sommes ennemis. Sa puissance est telle que je ne peux la vaincre seule.~
@53413 = ~C'est vrai. Il a fallu que je massacre la guilde des Voleurs de l'ombre pour elle. Mais à présent, je connais sa vraie nature. Je dois la détruire mais je ne puis le faire seul.~ ~C'est vrai. Il a fallu que je massacre la guilde des Voleurs de l'ombre pour elle. Mais à présent, je connais sa vraie nature. Je dois la détruire mais je ne puis le faire seule.~
@53414 = ~Soyez prêt. Nous y allons.~ ~Soyez prête. Nous y allons.~
@53415 = ~Nous parlons bien de la même créature. Elle est incroyablement puissante et il faut la détruire.~
@53416 = ~C'est moi qui ai détruit sa guilde mais elle s'est enfuie. Elle est de retour, à présent, et elle est encore plus puissante qu'avant.~
@53417 = ~Vous étiez à sa solde, avez-vous dit ? Dans ce cas, je vous aurai à l'œil afin de déceler le moindre signe de traîtrise de votre part. Mais si ce que vous dites est vrai, il faut la détruire.~
@53418 = ~Je me battrai à vos côtés, <CHARNAME>. Mais avant cela, il est indispensable de faire certaines choses. Où réside cette créature à Athkatla ?~
@53419 = ~Dans les cryptes qui se trouvent sous le cimetière.~
@53420 = ~Je crois que je connais l'endroit dont vous parlez. Très bien... nous vous retrouverons là-bas lorsque vous serez prêt à vous aventurer sous la surface. Jusque-là, <CHARNAME>...~
@53421 = ~J'ai déjà eu affaire à ce genre de créature par le passé et je connais bien leur pouvoir. Si ce que vous dites est vrai, nous ne pouvons pas continuer à la laisser vivre.~
@53422 = ~Il me semble que nous sommes déjà passés par ici, Bruenor. Es-tu sûr du chemin que tu nous indiques ? Je n'ai guère l'intention de tourner en rond plus longtemps. Es-tu vraiment certain de savoir où tu l'as laissé ?~ [DRIZZT07]
@53423 = ~Zut, petit, je suis peut-être vieux mais je n'ai pas encore perdu la mémoire ! Et nous n'aurions pas à le chercher si Wulfgar ne me l'avait pas ôté des mains !~
@53424 = ~Je n'ai jamais fait une chose pareille, le nain.~
@53425 = ~Mais si, petit ! Tu ne regardais pas où nous allions dans la bataille et j'étais trop distrait par les trolls pour courir après. Et ensuite j'ai oublié que tu l'avais fait, après.~
@53426 = ~Nous t'aiderons dans la mesure de nos moyens, mais Drizzt se demandait...~
@53427 = ~Il se demande si je n'ai pas perdu la tête, fillette ! Et je te dis que nous trouverons mon marteau de guerre bientôt, je ne laisserai pas les gobelins me le voler.~
@53428 = ~Humm... Qu'il en soit ainsi, Bruenor, Drizzt... nous avons de la visite. Ils vont peut-être trouver votre petit marteau, Bruenor.~
@53429 = ~Une réflexion de plus sur mon marteau, Ventre-à-Pattes, et vous aurez le premier coup quand je le récupérerai !~
@53430 = ~Du calme, mes amis, il n'y a aucune raison de se battre pour cela. Eh, oh ! Voyageurs ! Je suis Drizzt Do'Urden, je viens des Dix-Cités. Êtes-vous amis ou ennemis ?~
@53431 = ~Ennemis ! Sortez vos épées et défendez-vous !~
@53432 = ~Je n'ai aucune raison de me battre avec vous, elfe noir.~
@53433 = ~Je suis un ami, Drizzt. J'ai entendu parler de vous.~ ~Je suis une amie, Drizzt. J'ai entendu parler de vous.~
@53434 = ~Je suis un ami, Drizzt. J'ai entendu parler de vous.~ ~Je suis une amie, Drizzt. J'ai entendu parler de vous.~
@53435 = ~Vous êtes un bandit, n'est-ce pas ? Bien... Ma dernière défaite, je la dois à un félon qui m'a pris par surprise alors que j'étais seul. Mais ce n'est pas maintenant que vous risquez de renouveler cet exploit.~ ~Vous êtes une hors-la-loi, n'est-ce pas ? Bien... Ma dernière défaite, je la dois à un félon qui m'a pris par surprise alors que j'étais seul. Mais ce n'est pas maintenant que vous risquez de renouveler cet exploit.~
@53436 = ~Je garderai cela à l'esprit. Dites-moi, avez-vous vu un... un marteau de guerre rose dans les environs ?~
@53437 = ~Mon ami, dites-moi, avez-vous vu un... un marteau de guerre rose dans les environs ?~ ~Mon amie, dites-moi, avez-vous vu un... un marteau de guerre rose dans les environs ?~
@53438 = ~Je ne peux en dire autant mais puisque vous ne faites montre d'aucune violence, je n'irai pas plus loin. Dites-moi, avez-vous un... un marteau de guerre rose dans les environs ?~
@53439 = ~Zut, Drizzt, mon marteau n'est pas ROSE !~
@53440 = ~Bon il faut reconnaître, Bruenor... depuis que Cirine a envoyé ce sortilège, il s'oriente un peu sur le rose...~
@53441 = ~Il est ROUGE ! ROUGE je vous dis ! Dites qu'il est rose encore une fois, petit-homme, et vous aurez droit à un aller simple pour les Abysses.~
@53442 = ~J'y suis allé. Il n'y a rien de spécial.~
@53443 = ~Rouge, alors. Auriez-vous vu quelque chose de semblable à cela, étranger ?~
@53444 = ~Non.~
@53445 = ~Oui, euh... Mais je ne me rappelle pas où.~
@53446 = ~Par Moradin ! Il doit être quelque part ici !~
@53447 = ~Vous voyez ? Je vous l'avais dit que je n'avais pas perdu la tête ! Il est tout près comme je le disais depuis le début !~
@53448 = ~Nous continuerons donc à le chercher, Bruenor, ne crains rien. On ne nous attend pas à Dix-Cités avant quinze jours.~
@53449 = ~Dites-moi, étranger... nous sommes-nous déjà rencontrés ? Vos traits me semblent familiers mais je ne saurais où et quand cette rencontre a eu lieu. Devrais-je vous connaître ?~ ~Dites-moi, étrangère... nous sommes-nous déjà rencontrés ? Vos traits me semblent familiers mais je ne saurais où et quand cette rencontre a eu lieu. Devrais-je vous connaître ?~
@53450 = ~Je vous ai tué près de la Porte de Baldur la dernière fois que nous nous sommes rencontrés. Et il est bien dommage que vous ne fassiez plus partie du monde des morts. Il est temps de rectifier cela !~
@53451 = ~La dernière fois que nous nous sommes rencontrés, je vous ai attaqué près de la Porte de Baldur.~
@53452 = ~Non, je ne pense pas. Nous ne nous sommes jamais rencontrés.~
@53453 = ~Notre rencontre fut brève. Je vous ai aidé à combattre des gnolls près de la Porte de Baldur.~
@53454 = ~Vous ? La dernière fois que nous nous sommes battus, je m'étais égaré et j'étais seul. Voyons ce que vous valez dans une bataille livrée équitablement, mon ami !~ ~Vous ? La dernière fois que nous nous sommes battus, je m'étais égaré et j'étais seul. Voyons ce que vous valez dans une bataille livrée équitablement, mon amie !~
@53455 = ~C'était vous ? Vous m'avez tendu une embuscade et vous m'avez volé mon équipement, je m'en souviens ! Il m'a fallu longtemps pour retrouver mes épées. Je me demande si c'était vraiment vous.~
@53456 = ~Non ? Peut-être vous ai-je vu près de la Porte de Baldur. Bah ! Cela importe peu. Je vous souhaite un voyage sans ennui. Si vous n'avez plus besoin de rien, mes amis et moi allons continuer notre route.~
@53457 = ~C'était vous ? Veuillez pardonner ma crainte mais il faut être prudent dans les environs, surtout avec les rumeurs qui courent.~
@53458 = ~C'était vous ? Je suis heureux de vous rencontrer à nouveau, mon ami. Il est bon de voir que nous ne sommes pas les seuls honnêtes gens à voyager de par ces routes, surtout avec les bruits qui courent au sujet d'un danger.~ ~C'était vous ? Je suis heureux de vous rencontrer à nouveau. Il est bon de voir que nous ne sommes pas les seuls honnêtes gens à voyager de par ces routes, surtout avec les bruits qui courent au sujet d'un danger.~
@53459 = ~Si vous avez besoin d'aide, je serais heureux de vous l'offrir. Si le besoin ne s'en fait pas sentir, je vous souhaite un bon voyage. Nous allons nous-mêmes continuer notre route vers le Grand Nord.~
@53460 = ~Notre rencontre fut brève. Je vous ai aidé à combattre des gnolls près de la Porte de Baldur.~
@53461 = ~Je n'ai besoin de rien pour le moment. Adieu.~
@53462 = ~Le flagelleur mental ouvre la porte.~
@53463 = ~J'ai une proposition à vous faire, Drizzt, si vous prenez la peine d'attendre un moment.~
@53464 = ~J'ai une proposition à vous faire, Drizzt, si vous prenez la peine d'attendre un moment.~
@53465 = ~Attendez, elfe noir ! Vous ne vous imaginez tout de même pas pouvoir me quitter aussi facilement ? J'ai décidé que l'heure de votre mort avait sonné.~
@53466 = ~Non, je n'ai besoin de rien. Adieu.~
@53467 = ~Bonjour, Sanik ! Dame Galvena t'envoie ses salutations. Elle n'aime pas être contrariée.~
@53468 = ~J'ai une proposition à vous faire, Drizzt, si vous prenez la peine d'attendre un moment.~
@53469 = ~J'ai une proposition à vous faire, Drizzt, si vous prenez la peine d'attendre un moment.~
@53470 = ~J'ai une proposition à vous faire, Drizzt, si vous prenez la peine d'attendre un moment.~
@53471 = ~Attendez, elfe noir ! Vous ne vous imaginez tout de même pas pouvoir me quitter aussi facilement ? J'ai décidé que l'heure de votre mort avait sonné.~
@53472 = ~Peut-être une autre fois, alors. Venez, mes amis. Dix-Cités attend notre retour.~
@53473 = ~Vous ?! La fille est libre et vous n'avez aucun droit sur elle. Laissez-nous en paix !~
@53474 = ~Avez-vous changé à ce point depuis la dernière fois que nous nous sommes rencontrés, ou était-ce un mensonge ? Bah, que ce soit l'un ou l'autre, cela importe peu. Venez, mes amis, cet homme nous prend pour des proies faciles.~ ~Avez-vous changé à ce point depuis la dernière fois que nous nous sommes rencontrés, ou était-ce un mensonge ? Bah, que ce soit l'un ou l'autre, cela importe peu. Venez, mes amis, cette femme nous prend pour des proies faciles.~
@53475 = ~Libre ? J'en doute. La Dame ne tolérera pas le vol de ce qui lui appartient. Tu vas payer pour ton méfait.~
@53476 = ~Une proposition ? Très bien, étranger. Je ne vois pas d'inconvénient à vous écouter. Si je peux vous aider, je le ferai.~
@53477 = ~Je suis <CHARNAME> et il me faut affronter une vampire à Athkatla. Mais sa puissance est telle que je n'en viendrai pas à bout tout seul. M'aiderez-vous à la combattre ?~ ~Je suis <CHARNAME> et il me faut affronter une vampire à Athkatla. Mais sa puissance est telle que je n'en viendrai pas à bout toute seule. M'aiderez-vous à la combattre ?~
@53478 = ~Je suis <CHARNAME> et il me faut affronter une vampire à Athkatla. Mais sa puissance est telle que je n'en viendrai pas à bout tout seul. M'aiderez-vous à la combattre ?~ ~Je suis <CHARNAME> et il me faut affronter une vampire à Athkatla. Mais sa puissance est telle que je n'en viendrai pas à bout toute seule. M'aiderez-vous à la combattre ?~
@53479 = ~Oubliez ce que j'ai dit.~
@53480 = ~*seul un esprit surpuissant ou une force divine pourrait ouvrir cette porte*~
@53481 = ~Je... je ne suis qu'un humble esclave. Je ne vis que pour servir.~ [DRSLV104]
@53482 = ~Je vous interdis de parler de ma Claire comme s'il s'agissait d'un objet ! Elle n'est plus aux ordres de Galvena ! Elle est mon amour et n'a pas à subir votre contact repoussant !~
@53483 = ~Personne ne me contrôle.~ [DPJON148]
@53484 = ~Nous voici, juste à temps. Comme d'habitude, ces cryptes pullulent de morts-vivants. Voilà un combat prometteur. Et il me semble que vous étiez prêt à nous demander de l'aide.~ [DRIZZT08] ~Nous voici, juste à temps. Comme d'habitude, ces cryptes pullulent de morts-vivants. Voilà un combat prometteur. Et il me semble que vous étiez prête à nous demander de l'aide.~ [DRIZZT08]
@53485 = ~Les paladins de l'Ordre du Cœur radieux sont ici pour combattre à vos côtés, <CHARNAME> ! Quelle glorieuse victoire ce sera si nous parvenons à mettre fin à ce terrible fléau !~
@53486 = ~Les assassins sont ici pour soutenir ton combat, <CHARNAME>, comme l'a ordonné le Maître des ombres. Nous ferons ce que nous pourrons.~
@53487 = ~Aaaahhh...~ [DRSLV105]
@53488 = ~Hmmm !~ [DRSLV106]
@53489 = ~Comprenez-le au moment de mourir, misérables fous !~ [DPJON149]
@53490 = ~Qu-quoi ?! Kachiko ! Mais... mais elle vient juste de mourir ! Si les morts peuvent être ranimés aussi rapidement par cette créature, nous devons la vaincre, <CHARNAME>, nous le devons !~
@53491 = ~Elfe~
@53492 = ~Ha ! Un romantique ? Peut-être que ta mort inspirera un barde ?~
@53493 = ~Je viens du temple de l'Aube pour vous aider dans cette bataille, <CHARNAME>. Que les forces du bien et de la vertu soient victorieuses en ce jour !~
@53494 = ~Je viens du temple de la Sentinelle, <CHARNAME>. Nous rendons un grand service aux habitants d'Athkatla en les protégeant de ce terrible cancer qui croît en son sein !~
@53495 = ~Je viens du temple du Seigneur des Tempêtes, idiot ! Nous devons détruire nos ennemis ensemble ! Ils regretteront de nous avoir connu !~ ~Je viens du temple du Seigneur des Tempêtes, idiote ! Nous devons détruire nos ennemis ensemble ! Ils regretteront de nous avoir connu !~
@53496 = ~Bonjour, <CHARNAME>, Drizzt et ses amis sont toujours dans la crypte, je suppose ? Il a fait courir la rumeur qu'ils s'apprêtaient à livrer une grande bataille... mais on dirait que j'arrive trop tard.~
@53497 = ~Combattre une créature aussi diabolique et puissante est courageux de votre part. Si Drizzt et les autres sont tombés au combat, je suppose que ce sera à moi de les ramener à la vie et de rassembler leur équipement.~
@53498 = ~Ah ! Quel étourdi je fais ! Je suis Malchor Harpell, un associé de Drizzt. Quelle manque de courtoisie de ma part que d'oublier la plus élémentaire des politesses !~
@53499 = ~En parlant de courtoisie, je vois que vous avez rassemblé une partie de leur équipement. Puisque je suis là pour les ramener à la vie, je vais prendre ces affaires pour les mettre en sécurité.~
@53500 = ~Bien sûr. Prenez-les.~
@53501 = ~Attendez... comment puis-je savoir que vous n'allez pas les voler ?~
@53502 = ~Inutile. Je garde tout ce que j'ai ramassé.~
@53503 = ~Merci. Je vais y aller et voir ce que je peux faire. Bonne journée à vous, mon cher <PRO_LADYLORD>, et bons voyages.~ ~Merci. Je vais y aller et voir ce que je peux faire. Bonne journée à vous, ma chère <PRO_LADYLORD>, et bons voyages.~
@53504 = ~Et comment sais-je pour ma part que ce n'était pas votre but non plus, hum ? Vous devrez simplement vous fier à ma parole, mon cher <PRO_LADYLORD>.~ ~Et comment sais-je pour ma part que ce n'était pas votre but non plus, hum ? Vous devrez simplement vous fier à ma parole, ma chère <PRO_LADYLORD>.~
@53505 = ~Très bien. Dans ce cas, prenez-les.~
@53506 = ~Non. Je ne les donnerai à personne.~
@53507 = ~*soupire* Bien, puisque vous y tenez... Je n'ai pas de temps à perdre avec une attitude aussi stupide.~
@53508 = ~Bon... Je vais descendre voir ce qui est arrivé à l'elfe et aux autres. Peut-être certains d'entre eux s'en sont-ils tirés ? Allons voir ça.~
@53509 = ~Salutations, camarade. Mon nom est Sanik. Vous devez être nouveau dans notre belle ville de Brynnlaw. À qui ai-je donc l'honneur ?~ ~Salutations, camarade. Mon nom est Sanik. Vous devez être nouvelle dans notre belle ville de Brynnlaw. À qui ai-je donc l'honneur ?~
@53510 = ~Ah ! Bien le bonjour, <CHARNAME>. Je vois que vous avez certains des objets de Drizzt et de sa bande. Bien sûr, c'est donc pour cela que je ne les trouvais pas !~
@53511 = ~Je vous prie de me les remettre et je les rendrai à leurs propriétaires. Si vous en trouvez davantage, laissez-les sur place. Je finirai bien par les trouver.~
@53512 = ~Elfe~
@53513 = ~Très bien... prenez-les.~
@53514 = ~Laissez tomber. Je les garde !~
@53515 = ~Qu-qu'est-il arrivé à la Reine ? Elle a été enlevée, c'est ça ?~
@53516 = ~Merci, mon cher <PRO_LADYLORD>. Mais je vous le répète, ne prenez pas les autres objets que vous trouverez. J'ai un transcurateur qui me conduit directement à eux. Je ne voudrais pas devoir vous poursuivre à nouveau...~ ~Merci, ma chère <PRO_LADYLORD>. Mais je vous le répète, ne prenez pas les autres objets que vous trouverez. J'ai un transcurateur qui me conduit directement à eux. Je ne voudrais pas devoir vous poursuivre à nouveau...~
@53517 = ~Je ne supporterai pas cela longtemps ! Si vous ramassez encore une seule de leurs affaires, vous le regretterez, <PRO_LADYLORD>. Cela a assez duré !~
@53518 = ~C'est... c'est l'Exilé ! L'Exilé est revenu !~
@53519 = ~Bonjour ! Permettez-moi de me présenter ; je suis Malchor Harpell, un ami de Drizzt. Je vois que vous avez quelques-unes de ses affaires... vous les lui rendrez directement.~
@53520 = ~Laissez tomber ! C'est moi qui les ai trouvées et je les garde !~
@53521 = ~Monstres ! Des monstres, partout dans Suldanessalar !~
@53522 = ~Mon nom est <CHARNAME>. J'arrive tout juste d'Athkatla.~
@53523 = ~Très bien... prenez-les.~
@53524 = ~Oh, et puis zut... Si vous cherchez la difficulté, débrouillez-vous... Mais si je vous reprends avec l'un de ces objets, je risque de perdre patience...~
@53525 = ~Cela ne vous regarde pas. Excusez-moi.~
@53526 = ~On m'a assuré que vous étiez susceptible de me fournir certaines informations.~
@53527 = ~Merci. Je ne vous demanderai pas où vous les avez trouvés, mais si je vous reprends avec d'autres de ces objets, je risque de me montrer moins patient. Vous comprenez, n'est-ce pas ? Bien...~
@53528 = ~C'est votre jour de chance ! Ma charge sera bientôt vacante car j'ai l'intention de quitter la ville dès que je le pourrais.~
@53529 = ~Très bien, je vous ai supporté assez longtemps. Il est temps que je vous envoie quelque part où vous ne me gênerez plus afin que je puisse rassembler ce que je cherche sans vous avoir sans arrêt dans les pattes.~
@53530 = ~Nous sommes trahis ! Cet idiot de <CHARNAME> attaque ? Reculez, paladins !~
@53531 = ~Vraiment ? Pourquoi ce départ précipité ?~
@53532 = ~Quoi ?! Cet imbécile nous attaque alors même que nous lui portons secours ?! Abandonnons <CHARNAME> à son destin, alors !~ ~Quoi ?! Cette imbécile nous attaque alors même que nous lui portons secours ?! Abandonnons <CHARNAME> à son destin, alors !~
@53533 = ~Dans ce cas, je vous souhaite bon voyage. Excusez-moi, à présent.~
@53534 = ~Partons ! Fuyons ! <CHARNAME> est contre nous et nous allons être vaincus !~
@53535 = ~Comment ? <CHARNAME> ordonne qu'on nous attaque ? Partons d'ici si c'est la trahison qui règne !~
@53536 = ~On m'a assuré que vous étiez susceptible de me fournir certaines informations.~
@53537 = ~L'imbécile attaque ceux qui combattent à ses côtés ? Nous vous laissons à votre destin dans ce cas !~
@53538 = ~Tu oses t'en prendre à nous, <CHARNAME> ! Tu vas devoir subir la colère des Voleurs de l'ombre, si toutefois tu survis à cet endroit !~
@53539 = ~Rillifane ! Rillifane, je t'en supplie, sauve-nous !~
@53540 = ~~
@53541 = ~~
@53542 = ~Comme vous dites. Bon voyage.~
@53543 = ~~
@53544 = ~Apparition~
@53545 = ~Tout dépend de l'information que vous cherchez. Je ne suis qu'un simple marchand et négociant.~
@53546 = ~Salut, très cher <CHARNAME> ! Je suis vraiment heureux de vous voir ! Vous ne pouviez pas mieux tomber, car je suis dans le plus terrible des besoins !~ ~Salut, très chère <CHARNAME> ! Je suis vraiment heureux de vous voir ! Vous ne pouviez pas mieux tomber, car je suis dans le plus terrible des besoins !~
@53547 = ~Coran ? Que faites-vous ici ?~
@53548 = ~« Très cher » ? Coran, la dernière fois que je vous ai parlé, je crois vous avoir dit de ne pas vous mêler de mes affaires.~ ~« Très chère » ? Coran, la dernière fois que je vous ai parlé, je crois vous avoir dit de ne pas vous mêler de mes affaires.~
@53549 = ~Coran ? Vous ne deviez pas être mort ?~
@53550 = ~Je me souviens vous avoir déjà tué, espèce de voleur... Si ça n'a pas marché la première fois, je vais me faire un plaisir de recommencer.~
@53551 = ~Qui êtes-vous ? On se connaît ?~
@53552 = ~En effet, cela fait bien longtemps. Je m'ennuyais et j'ai essayé de vous retrouver, mais j'ai perdu votre trace après votre victoire à la Porte de Baldur... On aurait dit que vous aviez disparu de la surface de Féérune...~
@53553 = ~Peinture de djinn~
@53554 = ~Je ne vous cherchais pas vraiment intentionnellement, très cher. Je vous ai vu ici et j'ai désespérément besoin d'aide, malgré tout ce qui s'est passé et... toutes nos différences...~ ~Je ne vous cherchais pas vraiment intentionnellement, très chère. Je vous ai vu ici et j'ai désespérément besoin d'aide, malgré tout ce qui s'est passé et... toutes nos différences...~
@53555 = ~Peinture de djinn~
@53556 = ~Peinture de troll~
@53557 = ~Bon, peut-être, mais une ancienne amie voulait que je revienne et a payé pour que je ressuscite. J'étais heureux d'être en vie bien que les voyages en votre compagnie me manquaient.~ ~Bon, peut-être, mais une ancienne amie voulait que je revienne et a payé pour que je ressuscite. J'étais heureuse d'être en vie bien que les voyages en votre compagnie me manquaient.~
@53558 = ~Peinture de troll~
@53559 = ~Une ancienne... hum... amie a payé pour ma résurrection, et je vous pardonne votre accès de colère. De l'eau a coulé sous les ponts, tout ça c'est du passé, pas vrai ? Hé Hé...~
@53560 = ~Peinture de flagelleur mental~
@53561 = ~Avez-vous des contacts avec l'asile ?~
@53562 = ~Peinture de flagelleur mental~
@53563 = ~Peinture d'ombre des roches~
@53564 = ~Je vous connais, vous et vos compétences. Nous sommes peut-être des âmes sœurs et comme j'ai énormément besoin d'aide, je suis plus que disposé à vous appeler « mon ami » !~ ~Je vous connais, vous et vos compétences. Nous sommes peut-être des âmes sœurs et comme j'ai énormément besoin d'aide, je suis plus que disposée à vous appeler « mon amie » !~
@53565 = ~Je désire pénétrer dans l'asile. J'ai des raisons de penser qu'une de mes amies y est enfermée.~
@53566 = ~Mais ce qui est important, c'est que je parcourais la forêt de Téthir en compagnie de ma très chère Safana... si vous vous souvenez d'elle... mais maintenant elle a été enlevée ! C'est affreux !~
@53567 = ~Je ne me suis sans doute pas adressé à la bonne personne. Excusez-moi.~ ~Je ne me suis sans doute pas adressée à la bonne personne. Excusez-moi.~
@53568 = ~Peinture d'ombre des roches~
@53569 = ~« Départ précipité » n'est peut-être pas le terme adéquat. J'ai seulement eu un petit désaccord avec une des Maîtresses de la Guilde. Ma nouvelle épouse et moi-même allons partir en voyage d'affaires prolongé, jusqu'à ce que les choses se tassent.~
@53570 = ~Il y a deux jours, des loups géants nous ont assailli... je crois qu'il s'agissait de muloups. Ils ont tenté de nous emporter tous les deux mais j'ai réussi à m'enfuir. Safana n'a pas eu autant de chance.~
@53571 = ~Quelle est cette félonie ? Qui êtes-vous ?~
@53572 = ~Je les ai suivi jusqu'à un campement près d'ici, mais même un grand guerrier tel que moi ne peut pas les vaincre seul. J'ai espéré que quelqu'un vienne à notre secours... et vous voici !~
@53573 = ~Il nous faut la sauver et porter un coup à ces saletés de bêtes-garous, <CHARNAME> ! Nous serons invincibles à nous deux ! Qu'en dites-vous, mon seigneur ?~ ~Il nous faut la sauver et porter un coup à ces saletés de bêtes-garous, <CHARNAME> ! Nous serons invincibles à nous deux ! Qu'en dites-vous, ma dame ?~
@53574 = ~Spellhold ? Je leur fournis le ravitaillement de base, comme la nourriture et les ingrédients dont ils se servent pour leurs sorts. Ils préparent certainement quelque chose. Les commandes se sont accrues fortement ces derniers temps.~
@53575 = ~Pas de problème, je vais vous aider. Où se trouve le campement ?~
@53576 = ~Je ne peux pas vous aider immédiatement, Coran.~
@53577 = ~Il me faut un moyen d'entrer dans la place. Avez-vous une idée de la façon dont je pourrais m'y prendre ?~
@53578 = ~Je ne vais pas lever le petit doigt pour sauver Safana. Mais que faites-vous donc avec elle au juste ?~
@53579 = ~Que croyez-vous qu'il se trame à l'intérieur ?~
@53580 = ~Pas question. Vous allez devoir vous débrouiller. Je ne veux pas être mêlé à l'un de vos plans quel qu'il soit.~ ~Pas question. Vous allez devoir vous débrouiller. Je ne veux pas être mêlée à l'un de vos plans quel qu'il soit.~
@53581 = ~C'est bien possible. Il se trouve que je dois quitter la ville très prochainement, et ma charge sera vacante.~
@53582 = ~Je dis qu'il est temps pour vous de mourir, espèce d'elfe stupide. Vous auriez dû le savoir avant de vous manifester à nouveau !~
@53583 = ~Que fuyez-vous ?~
@53584 = ~C'est parfait ! Les muloups se trouvent à l'est. J'irai là-bas et je vous y attendrai, <PRO_LADYLORD>. Ne mettez pas trop longtemps, je ne connais pas les plans qu'ils réservent à ma bien-aimée !~
@53585 = ~Je n'en ai pas la moindre idée, et pour être franc avec vous, cela m'est bien égal. Mes affaires avec Spellhold touchent à leur fin car je dois très rapidement quitter la ville.~
@53586 = ~Que fuyez-vous ?~
@53587 = ~Qu'y a-t-il de plus important que de sauver la vie d'une belle damoiselle en détresse ? Ah, faites ce que vous voulez, mon seigneur, mais je dois rejoindre ma bien-aimée.~ ~Qu'y a-t-il de plus important que de sauver la vie d'une belle damoiselle en détresse ? Ah, faites ce que vous voulez, ma dame, mais je dois rejoindre ma bien-aimée.~
@53588 = ~Si vous changez d'avis, le campement se trouve vers l'est. Je vous prie de venir dès que possible... J'ignore combien de temps ma bien-aimée pourra survivre !~
@53589 = ~Seriez-vous capable d'être aussi cruel, mon seigneur ? Safana est une femme douce et bienveillante. Elle ne mérite pas cette mort ! Je dois partir et voir si elle est encore vivante !~ ~Seriez-vous capable d'être aussi cruelle, ma dame ? Safana est une femme douce et bienveillante. Elle ne mérite pas cette mort ! Je dois partir et voir si elle est encore vivante !~
@53590 = ~Vous revenez donc à la charge, mon ami. Faites vite, je vous prie, car je dois quitter la ville incessamment.~ ~Vous revenez donc à la charge, mon amie. Faites vite, je vous prie, car je dois quitter la ville incessamment.~
@53591 = ~Ceci est bien plus important que de la jalousie mesquine, <CHARNAME> ! La vie d'une douce jeune femme est en jeu ! Je dois y aller seul si vous ne voulez pas m'aider et voir si elle est encore en vie !~
@53592 = ~Que fuyez-vous ?~
@53593 = ~On m'a assuré que vous étiez susceptible de me fournir certaines informations.~
@53594 = ~Par les mamelles d'Umberlie ! Cette Galvena se prend pour qui ? Des meurtres au Singe Vulgaire ! Quelle femme arrogante !~
@53595 = ~Aubergiste ! Tu sembles savoir quelque chose. Pourquoi cet homme a-t-il été tué ?~
@53596 = ~Hey, toi ! Tu n'as rien à faire dans mon domaine, <PRO_RACE> !~
@53597 = ~Hein ? Quelle importance ? Tu le vois pour la première fois.~
@53598 = ~Disons simplement que nous étions proches. Qui l'a tué et pourquoi ce meurtre ignoble ?~
@53599 = ~J'ai besoin d'informations que lui seul aurait pu me donner. Dis-moi ce que tu sais !~
@53600 = ~Oui, ne serait-ce que pour apprendre à cette femme à ne pas venir faire ses affaires dans ma taverne, je vais te dire ce que je sais.~
@53601 = ~Non, non ! C'est celui dont je t'ai parlé, Lanfear ! C'est <CHARNAME> ! Tue-le et le magicien te récompensera, toi et les tiens, en te couvrant de richesses au-delà de tes rêves les plus fous !~ ~Non, non ! C'est celle dont je t'ai parlé, Lanfear ! C'est <CHARNAME> ! Tue-la et le magicien te récompensera, toi et les tiens, en te couvrant de richesses au-delà de tes rêves les plus fous !~
@53602 = ~Partie sauvegardée~
@53603 = ~L'assassin a été envoyé par dame Galvena, la maîtresse de la Guilde des Courtisanes locale. Tu imagines bien que dans un port de marins, une telle entreprise peut rendre une femme riche et puissante.~
@53604 = ~Fichier de personnage~
@53605 = ~Sélectionnez le format d'importation (Baldur's Gate I ou II). Attention, les personnages perdront tous leurs étuis à parchemins, sacs de contenance et sacs à gemmes.~
@53606 = ~Ça ? C'est ça la créature dont tu parlais ? Bah ! Tu avais dit que Coran accompagnerait <CHARNAME> ! Tu avais dit que Coran l'amènerait à moi !~
@53607 = ~C'est évident. Quel était son désaccord avec Sanik ?~
@53608 = ~Ça ? Je n'ai que faire du mage et de ses richesses ! Tu avais dit que Coran accompagnerait <CHARNAME> ! Tu avais dit que Coran l'amènerait parce que tu étais prisonnière ! Où est Coran ?~
@53609 = ~Coran est mort, la bête, et tu vas le suivre sans tarder !~
@53610 = ~Tu m'as dit tout ce que je voulais savoir.~
@53611 = ~Quoi ? Cette histoire vient à peine de commencer.~
@53612 = ~Tais-toi, c'est tout ce que je voulais savoir.~
@53613 = ~Safana chérie... Qu'est-ce que tu as fait ?~
@53614 = ~Dans ce cas, continue, je t'en prie.~
@53615 = ~Ne sois pas idiot, Coran. Pourquoi penses-tu que j'ai insisté pour venir ici ? C'était pour trouver <CHARNAME> ! As-tu une simple idée de la récompense placée sur sa tête ?~
@53616 = ~À ta guise.~
@53617 = ~Non... Safana ! Je ne te laisserai pas faire une chose pareille !~
@53618 = ~Cet idiot de Sanik est tombé amoureux d'une des filles de Galvena, Claire, et elle, de lui. Il l'a enlevée de la maison de la guilde et a proclamée qu'elle était sa femme.~
@53619 = ~Hors de mon chemin, vermine ! Lanfear... Tue <CHARNAME>, comme prévu !~
@53620 = ~Je n'ai pas à obéir à tes ordres, sorcière d'humaine ! Je n'ai que faire de cette récompense ! Tout ce que je voulais c'était que Coran me soit enfin ramené !~
@53621 = ~Galvena est une femme sévère. Elle considère que les courtisanes lui appartiennent. Elle a accusé Sanik de vol et il l'a méprisée en public. Toute la ville est au courant.~
@53622 = ~Non ! Tue-le maintenant ! Je te l'ordonne !~ ~Non ! Tue-la maintenant ! Je te l'ordonne !~
@53623 = ~Tu n'as rien à m'ordonner ! Tu sombreras dans le néant de l'oubli, humaine !~
@53624 = ~Ceci était la réponse de Galvena. Je crois que Claire souffre pendant que nous parlons.~
@53625 = ~Une injustice vient d'être commise. Où est cette fille, Claire ?~
@53626 = ~Safana, mon amour ! Non !~
@53627 = ~Sanik était mon contact à Brynnlaw. Qui d'autre pourrait me dire comment entrer dans l'asile ?~
@53628 = ~Ne pleure pas pour cette humaine, Coran... elle t'a trahi et ne t'a jamais aimé. Pas autant que moi.~
@53629 = ~La guilde possède une maison à l'ouest de Brynnlaw. Les clients qui paient peuvent faire leurs « affaires » dans une chambre de la guilde. Je crois que Galvena y a déjà emmené la jeune fille pour la punir.~
@53630 = ~C'est l'œuvre de l'Exilé !~
@53631 = ~L'endroit est-il gardé ? Comment puis-je entrer ?~
@53632 = ~Quelqu'un d'autre peut-il me dire comment entrer dans l'asile de Spellhold ?~
@53633 = ~Vous m'aimez ? Comment se fait-il qu'une bête puisse m'aimer ?~
@53634 = ~Tu ne me reconnais pas, mon amour ? Non... pas sous cette forme. Nous avons déjà couché ensemble, toi et moi, mon amour... et depuis, je ne t'ai jamais oublié.~
@53635 = ~Si tu es sûr que Sanik savait comment, il l'a peut-être dit à sa jeune épouse. Mais je ne vois pas comment tu pourrais le lui demander.~ ~Si tu es sûre que Sanik savait comment, il l'a peut-être dit à sa jeune épouse. Mais je ne vois pas comment tu pourrais le lui demander.~
@53636 = ~Tu as réussi à échapper à mes chiens de chasse... mais j'ai attrapé ta femme et son plan malicieux a servi ma cause bien plus que la sienne ! Viens près de moi, mon Coran... soyons enfin de nouveau ensemble !~
@53637 = ~Où ont-ils pu l'emmener ?~
@53638 = ~Pas question ! Je ne participerais jamais à une telle insanité, bête immonde ! Safana était ma bien-aimée ! <CHARNAME>, faites périr cette meurtrière et toute sa maudite meute !~
@53639 = ~Je te remercie pour ton aide. Je m'en vais.~
@53640 = ~Très bien, Coran... Si tu ne veux pas de moi, PERSONNE d'autre ne t'aura jamais non plus !~
@53641 = ~En fait j'avais de plus en plus d'affection pour <CHARNAME>. Le bon vieux temps et ce genre de choses... Je me souviens l'avoir aimée et... vous savez, depuis que Safana est morte...~
@53642 = ~Non ! Tu la choisirais ELLE plutôt que MOI ?! Maudit sois-tu, homme inconstant ! Que la mort te frappe ! Va rejoindre ta Safana ! Et celle qui porte mon nom te rejoindra bientôt !~
@53643 = ~Tu peux y entrer comme tout le monde. Comme n'importe quel client. Galvena en a pour tous les goûts, des hommes et des femmes prostitués.~ ~Tu peux y entrer comme tout le monde. Comme n'importe quelle cliente. Galvena en a pour tous les goûts, des hommes et des femmes prostitués.~
@53644 = ~Sinon, tu devras tuer plusieurs gardes bien entraînés. Il paraît aussi que Galvena dispose d'un sorcier apprivoisé. Des deux manières, c'est pure folie, à mon avis.~
@53645 = ~Quelqu'un d'autre pourrait-il me dire comment entrer dans l'asile de Spellhold ?~
@53646 = ~Eh bien, voilà un réel « soulagement ». Il commençait à m'ennuyer, vous ne pouvez pas savoir à quel point.~
@53647 = ~Je te remercie pour ton aide. Je m'en vais.~
@53648 = ~Noooon ! Mort ?! Nooon ! Je n'ai que faire de la récompense, sorcière ! Je ne t'ai prise que pour attirer Coran ! Tu vas le rejoindre dans la mort, sorcière, je te maudis... et celui qui l'a tué t'y suivra bientôt !~ ~Noooon ! Mort ?! Nooon ! Je n'ai que faire de la récompense, sorcière ! Je ne t'ai prise que pour attirer Coran ! Tu vas le rejoindre dans la mort, sorcière, je te maudis... et celle qui l'a tué t'y suivra bientôt !~
@53649 = ~Vite ! Allez affronter les créatures et je vous suivrai ! La vie de la pauvre Safana est en jeu !~
@53650 = ~Non ! Ma... Safana est morte ? Je ne peux plus rien pour la sauver ? Ohhh... Je dois... vous laisser, <CHARNAME>. Je ne peux pas montrer ma peine ! Il faut que je sois seul !~
@53651 = ~Je vous remercie pour votre aide, <CHARNAME>. Je suis triste de n'avoir pas vu la vraie nature de Safana et... pardonnez-moi de vous avoir mis en danger avec mon ignorance.~ ~Je vous remercie pour votre aide, <CHARNAME>. Je suis triste de n'avoir pas vu la vraie nature de Safana et... pardonnez-moi de vous avoir mise en danger avec mon ignorance.~
@53652 = ~Maintenant, vous allez périr, espèce d'elfe stupide ! Je n'aurai plus affaire à vous comme ça !~
@53653 = ~Tout va bien, Coran. Au moins, maintenant, vous savez.~
@53654 = ~Coran, si vous ne savez pas où aller pourquoi ne pas venir voyager avec moi ?~
@53655 = ~Très bien. C'est ici que nos chemins se séparent.~
@53656 = ~Oh, comme vous voudrez. Mais cela m'ennuie VRAIMENT.~
@53657 = ~Ah, je devrais peut-être noyer mes problèmes dans le vin en compagnie de quelques jeunes filles plantureuses, eh ? Athkatla n'est pas loin... On dit que c'est très beau là-bas. Adieu, <CHARNAME> !~
@53658 = ~Je suis sûr que de belles batailles vous attendent. Je suis tenté, <PRO_LADYLORD>, vraiment... mais ça ne va pas être possible. Je pense qu'il va falloir que je noie mes problèmes dans l'alcool et les femmes pour un certain temps.~
@53659 = ~Je pense qu'Athkatla n'est pas loin. On dit que c'est un assez bel endroit. Ou peut-être Zazesspur. Quel que soit mon destin... Jusqu'à ce que nous nous rencontrions, <CHARNAME>...~
@53660 = ~Bien, c'est le moment de se séparer. Adieu <CHARNAME> ! Bonne chance !~
@53661 = ~Tellement... tellement sont déjà morts ! Tellement !~
@53662 = ~L'Arbre de Vie ! Il doit être sauvé en priorité, bien avant nous !~
@53663 = ~Rillifane ! Rillifane, je t'en supplie, sauve-nous !~
@53664 = ~~
@53665 = ~~
@53666 = ~Jamais nous ne déposerons les armes ! Nous n'abandonnerons jamais les bois !~ [ELSOL101]
@53667 = ~Nous nous battrons jusqu'à la mort pour la reine Ellésime !~ [ELSOL102]
@53668 = ~Les forces du mal ne nous vaincront jamais. Encore moins ces noirauds.~ [ELSOL103]
@53669 = ~La Seldarine nous protège, la victoire sera nôtre en ce grand jour.~ [ELSOL104]
@53670 = ~~ [ELSOL107]
@53671 = ~Aaah, arrr !~ [ELSOL106]
@53672 = ~Arrr, aaarrhhhh...~ [ELSOL105]
@53673 = ~C'est notre destin et notre volonté : nous régnerons !~ [DRSOL101]
@53674 = ~À tes ordres !~ [DRSOL102]
@53675 = ~Que la Reine Araignée soit victorieuse !~ [DRSOL103]
@53676 = ~Ceux qui vivent à la surface ne méritent que la mort.~ [DRSOL104]
@53677 = ~Au nom de Lolth !~ [DRSOL107]
@53678 = ~Aaarrrr !~ [DRSOL106]
@53679 = ~Oooohhh...~ [DRSOL105]
@53680 = ~Salut la compagnie. Bien le bonjour à vous, mes braves amis !~ [FFBART01]
@53681 = ~Les Cinq Chopes proposent un vaste choix de boissons de toutes sortes. J'ai toutes les saveurs disponibles, pour votre plus grand plaisir ! Oui !~ [FFBART02]
@53682 = ~Il y a un théâtre en bas, si ça vous intéresse... et buvez donc avant une bonne chope de vin épicé !~ [FFBART03]
@53683 = ~Les Cinq Chopes : c'est le palais où on s'occupe des palais !~ [FFBART04]
@53684 = ~Aaaaaah, aah !~ [FFBART06]
@53685 = ~Aaah ! Oh, ohhh...~ [FFBART05]
@53686 = ~Isaéa Roenal~
@53687 = ~J'en ai fini avec vous pour l'instant.~ [ISAEAX01]
@53688 = ~Pour l'honneur de mes ancêtres !~ [ISAEAX03]
@53689 = ~Bouffée de lave~
@53690 = ~*cet horrible bassin est rempli de sang frais humain... vous êtes saisi d'horreur à la pensée de la sauvagerie des vampires*~ ~*cet horrible bassin est rempli de sang frais humain... vous êtes saisie d'horreur à la pensée de la sauvagerie des vampires*~
@53691 = ~*vous versez un des flacons d'eau bénite d'Elhan dans le bassin... le résultat est immédiat... le bassin bouillonne violemment pendant quelques instants, puis se calme... il a été purifié de tout ce qu'il contenait de maléfique*~
@53692 = ~Ah !~ [ISAEAX04]
@53693 = ~Ah ! Ooohhh...~ [ISAEAX05]
@53694 = ~~
@53695 = ~~
@53696 = ~*le bassin a été purifié, et les vampires ne peuvent désormais plus tirer d'énergie de son sang*~
@53697 = ~Eau bénite elfique~
@53698 = ~Eau bénite elfique~
@53699 = ~~
@53700 = ~~
@53701 = ~~
@53702 = ~~
@53703 = ~*la voix de Bodhi résonne dans votre tête :* « Seul le sang de mes enfants pourra vous donner accès. Et seule leur mort à tous nous fera nous rencontrer à nouveau, <CHARNAME>. »~
@53704 = ~~
@53705 = ~~
@53706 = ~~
@53707 = ~~
@53708 = ~~
@53709 = ~~
@53710 = ~Ma maîtresse vous souhaite la bienvenue, <CHARNAME>.~
@53711 = ~Je vous souhaite la bienvenue.~ [MARIAX01]
@53712 = ~Je vous en prie ! Ne faites pas ça ! Je vous en supplie !~ [MARIAX03]
@53713 = ~Ooh !~ [MARIAX04]
@53714 = ~Aaaaaaaaahhhh...~ [MARIAX05]
@53715 = ~~
@53716 = ~~
@53717 = ~~
@53718 = ~~
@53719 = ~Je suis une dame aux goûts raffinés.~
@53720 = ~~
@53721 = ~~
@53722 = ~~
@53723 = ~~
@53724 = ~~
@53725 = ~~
@53726 = ~~
@53727 = ~Seul compte le verbe de Talos. Suivez sa volonté ou mourrez.~ [YARRYL01]
@53728 = ~Que le seigneur des tempêtes vous emporte !~ [YARRYL03]
@53729 = ~Ah !~ [YARRYL04]
@53730 = ~Aaaaah, ahhhhhh...~ [YARRYL05]
@53731 = ~~
@53732 = ~~
@53733 = ~~
@53734 = ~~
@53735 = ~~
@53736 = ~~
@53737 = ~~
@53738 = ~~
@53739 = ~~
@53740 = ~~
@53741 = ~~
@53742 = ~*il s'agit d'un cocon illithid, une sorte de cosse de gestation... une bouteille vide se trouve près de lui, avec laquelle vous pourriez prendre un peu de la substance qui remplit le cocon*~
@53743 = ~~
@53744 = ~Le seigneur de l'aube vous souhaite la bienvenue.~ [SAINXX01]
@53745 = ~*vous créez une potion de saumure*~
@53746 = ~L'aurore vous rejette ! Périssez dans les ténèbres !~ [SAINXX03]
@53747 = ~Humpf !~ [SAINXX04]
@53748 = ~Gnnn ! Eeehhh...~ [SAINXX05]
@53749 = ~~
@53750 = ~Je ne tolérerai pas la présence d'étrangers, peu importe qui ils sont ou ce qu'ils ont l'intention de faire pour notre cause. Le risque est bien trop grand.~
@53751 = ~Faites ce que vous devez mais loin d'ici. Je vous croirai quand tout sera revenu dans l'ordre.~
@53752 = ~Débarrassez-moi de cette elfe noire. Je ne la supporte pas.~
@53753 = ~Ne me dis rien, elfe noire. Tu es en vie uniquement à cause de ceux qui t'accompagnent.~
@53754 = ~Oui, oui. Mais elle n'est pas encore terminée.~
@53755 = ~Espèce de monstre ! Tu acceptes de négocier avec quelqu'un qui fabrique des armures avec de la peau ?~
@53756 = ~C'est la fin ! Tout est perdu !~
@53757 = ~Les peaux étaient superbes, mais il me faut du sang. Tu sais de quoi j'ai besoin. Rapporte-moi le sang d'un dragon. Un dragon d'argent.~
@53758 = ~*une fois l'avatar kobold mort, vous pouvez facilement prendre un morceau du cristal... tout est silencieux, à l'exception d'un gémissement de deuil lointain, à peine perceptible*~
@53759 = ~Tu es un complètement tordu ! Les dragons d'argent sont justes et bons ! En tuer un est une abomination !~
@53760 = ~Mais bien sûr... euh, sais-tu où je peux en trouver un ?~
@53761 = ~C'est comme si c'était fait.~
@53762 = ~J'ai déjà le sang.~
@53763 = ~Maître ! Noooon !~
@53764 = ~Pas du tout. C'est toi l'artisan, débrouille-toi.~
@53765 = ~Bien, je t'attendrai ici. Rapporte-moi le sang et l'armure, et je te fabriquerai une tenue digne du roi le plus noir.~
@53766 = ~Tu es vraiment très entreprenant. C'est impressionnant. Voyons si j'ai bien tout ce qu'il te faut.~ ~Tu es vraiment très entreprenante. C'est impressionnant. Voyons si j'ai bien tout ce qu'il te faut.~
@53767 = ~J'ai le sang et l'armure.~
@53768 = ~J'ai le sang, mais pas l'armure.~
@53769 = ~Le combat fut rude, mais j'ai gagné. Voici le sang et l'armure.~
@53770 = ~Oui, oui, termine cette satanée armure.~
@53771 = ~Je ne sais comment j'ai pu faire une chose pareille. Tu es un monstre de me l'avoir demandé !~
@53772 = ~Certains de mes associés souhaiteraient te voir. Mais pas pour te parler, pour te tuer.~
@53773 = ~Malédiction mortelle~
@53774 = ~Ici, vous pourrez sélectionner de quelle partie vous désirez importer un personnage. Il peut s'agir d'une partie de Baldur's Gate I, II ou de La Légende de l'Île Perdue (Tales of the Sword Coast).~
@53775 = ~Cette liste contient tous les personnages créés. Sélectionnez-en un pour l'importer.~
@53776 = ~Dent de Sekolah~
@53777 = ~Dent de Sekolah~
@53778 = ~*cet étrange appareil prend le contrôle de vos pensées, vous faisant devenir une fois de plus l'Écorcheur... et vous imposant un désir, un besoin... le géancéphale vous appelle*~
@53779 = ~*une puissante force empêche un simple mortel d'ouvrir cette porte*~
@53780 = ~La perte la plus troublante fut celle de Merella. Elle a disparu alors qu'elle recherchait le premier disparu, un paysan.~
@53781 = ~Sa cabane était au sud-ouest, mais je ne sais pas ce que tu y trouveras. Mais cela ne m'intéresse pas vraiment.~
@53782 = ~~
@53783 = ~Cette gemme brillante est d'origine indéterminée ; elle change constamment de couleur, passant du bleu au violet, du noir à des nuances de gris. Elle provient manifestement du pommeau d'une épée magique.

PARAMÈTRES :

Poids : 1~
@53784 = ~Des habitants de la surface ! Essuyez notre colère !~
@53785 = ~Que le dieu requin t'emporte !~
@53786 = ~Je goûterai ton sang !~
@53787 = ~~
@53788 = ~La base du prince se trouve à l'autre bout de la cité, au-delà d'une caverne fermée par deux immenses portes. Sekolah y est apparu autrefois et y a tué un millier d'infidèles.~
@53789 = ~Il décréta alors que plus aucun hérétique n'entrerait dans la cité, et il a scellé les portes. Il mit sa dent contre les portes pour que nous puissions les ouvrir. Plus tard, les elfes noirs sont venus.~
@53790 = ~Ils ont envahis la ville à l'aide de leur puissante magie. Ils étaient dirigés par un très grand mage. Celui-ci prit la dent de Sekolah aux gardiens négligents pour empêcher qu'ils puissent être poursuivis.~
@53791 = ~Le mage construisit un édifice dans la partie sud-ouest de la ville. Il a ensuite été tué, mais son complexe est resté. La dent de Sekolah y est gardée quelque part...~
@53792 = ~Nous n'en avons pas besoin... nous voyageons grâce aux océans. Mais vous, vous en aurez besoin. Trouvez le bâtiment des elfes noirs, trompez les gardiens et récupérez la clef.~
@53793 = ~J'irai dans le quartier des elfes noirs et j'obtiendrai la clef.~
@53794 = ~Excellent. Ça m'amène au point suivant. Vous devez faire quelque chose pour moi.~
@53795 = ~Pouvez-vous m'indiquer comment entrer dans le camp rebelle ?~
@53796 = ~Entrez dans le complexe elfe noir dans le coin sud-ouest de la cité. Suivez les escaliers sud depuis la salle du trône. Munissez-vous de la Dent de Sekolah pour passer les portes. Rappelez-vous notre accord et gardez l'orbe avec vous.~
@53797 = ~*l'inscription sur la porte indique :* « Nul ne passera sans la Dent de Sekolah. »~
@53798 = ~Ce visage est ennuyeux. Maintenant, je...~ [PPDILI08]
@53799 = ~Un petit chien ! Hé hé.~
@53800 = ~Hum... un chaton ! Miaou !~
@53801 = ~Ah... je suis un loup !~
@53802 = ~Oooh, et maintenant, je suis... un ours !~
@53803 = ~Et maintenant, je suis... un poulet !~
@53804 = ~Et maintenant, je suis... vous. Bonjour.~
@53805 = ~P'tit fesseur de singes.~
@53806 = ~Bonjour ! Vous cherchez de l'action ? Ça a l'air d'être votre genre !~
@53807 = ~Je recherche une jeune fille du nom de Claire. Vous devriez la connaître.~
@53808 = ~Tu parlais de prendre du bon temps. Qu'avais-tu en tête ?~
@53809 = ~Je préférerais savoir comment entrer dans votre guilde. Je dois discuter sérieusement avec Dame Galvena.~
@53810 = ~Je ne dois pas parler de ça. Vous voulez me causer des ennuis ?~
@53811 = ~Vous avez une fois encore dérangé Tiax le grand ! Quelle impudence ! Tiax marquera votre front de la honte qui s'abat sur vous, tous connaîtront alors votre traîtrise.~ [PPTIAX11]
@53812 = ~Eh... on dirait que... les sous-vêtements... du grand et... méchant Tiax... ont rétréci de trois tailles.~
@53813 = ~Veuillez excuser... le méchant Tiax... il reprend son souffle... il régnera plus tard.~
@53814 = ~Quand Tiax régnera, les culottes ne remonteront plus aussi étroitement.~
@53815 = ~Mémo : je dirigerais l'asile d'ici ! Prenez note !~ [PPWANE09]
@53816 = ~Cette note crasseuse a été écrite avec autre chose que de l'encre... mieux vaut ne pas savoir quoi exactement. Elle est indéchiffrable. Son auteur était certainement fou.

Qe gypsxxi iwx tpimri hi jsymriw. Mrjsvqid-ir pe vimri, ejmr uy'ippi piw jewwi jymv. Tvsqirsrw-rsyw eyxsyv hy qŷvmiv. G'iwx tevxm, qsr OMOM !~
@53817 = ~Oui, ça devrait rendre les choses plus claires.~
@53818 = ~Cette note crasseuse a été écrite avec autre chose que de l'encre... mieux vaut ne pas savoir quoi exactement. Elle est indéchiffrable. Son auteur était certainement fou.

Xqwu etqagb swg lg uwku hqw, ocku ȩc, e'guv eg sw'knu xgwngpv swg xqwu rgpukgb. Lg eqppcku ngu ugetgvu. Ictfgb ngu ewnqvvgu. Ictfgb vqwlqwtu ngu ewnqvvgu.~
@53819 = ~J'en avais de bien douces, fût un temps. Certaines sont cachées où moi seul peux les voir. Cela vous intéresse ? Vous voulez jeter un coup d'œil ?~ [PPNALJ07]
@53820 = ~Oh, il suffit pour aujourd'hui. Demain peut-être. De belles petites venues de bien loin.~ [PPNALJ08]
@53821 = ~Capitaine kuo-toa~
@53822 = ~Pas d'inquiétude. Tout cela restera entre nous.~
@53823 = ~Je ne dirai rien de tout cela.~
@53824 = ~Bien sûr que non. Mais qu'en est-il de ce « bon temps » ?~
@53825 = ~Je préférerais savoir comment entrer dans votre guilde. Je dois discuter sérieusement avec Dame Galvena.~
@53826 = ~Pour un montant raisonnable, on pourrait se retirer dans ma chambre. Là, on pourrait explorer les contours de notre toute nouvelle amitié...~
@53827 = ~Et combien cela va-t-il me coûter ?~
@53828 = ~Au lieu de cela, pourquoi ne pas juste me dire comment entrer dans la maison de votre guilde, sans avoir à passer à la caisse ? Je dois parler affaires avec Dame Galvena.~
@53829 = ~Cela paraît très intéressant, mais je cherche des informations au sujet d'une jeune femme du nom de Claire. Vous devriez la connaître.~
@53830 = ~Peut-être que quelques pièces pourrait délier cette langue ?~
@53831 = ~Pas d'autre moyen que de prendre la demeure d'assaut. Mais, pour une somme modique, vous pouvez vous payer mes services et nous irons dans ma chambre. C'est déjà un moyen de pénétrer à l'intérieur.~
@53832 = ~Et combien cela va-t-il me coûter ?~
@53833 = ~Cela paraît très intéressant, mais je cherche des informations au sujet d'une jeune femme du nom de Claire. Vous devriez la connaître.~
@53834 = ~Il n'y a pas d'autre moyen d'entrer ?~
@53835 = ~Tu es sûr que tu ne tiens pas à me rejoindre dans l'une des chambres pour t'amuser un peu ? Les femmes disent que j'ai des mains qui leur font oublier leurs soucis.~ ~Tu es sûre que tu ne tiens pas à me rejoindre dans l'une des chambres pour t'amuser un peu ? Les femmes disent que j'ai des mains qui leur font oublier leurs soucis.~
@53836 = ~Vous promettez de ne dire à personne que c'est moi qui vous ai renseigné ?~
@53837 = ~Je le promets.~
@53838 = ~Je suis sûr qu'une jeune fille comme toi saurait quoi faire avec un homme, un vrai. N'est-ce pas ? Pour quelques pièces, j'suis à toi !~
@53839 = ~Je le promets.~
@53840 = ~Très bien. Donnez-moi 200 pièces d'or. Je risque ma vie, je ne peux pas demander moins !~
@53841 = ~Et voici l'or. Qu'est-il arrivé à Claire ?~
@53842 = ~Je n'ai pas assez d'or.~
@53843 = ~C'est difficile d'évaluer une compagnie aussi agréable que la mienne. Disons... 100 pièces d'or.~
@53844 = ~C'est ridicule ! Je ne paierai pas !~
@53845 = ~Très bien. Voici l'or.~
@53846 = ~Allez, viens maintenant mon chou... tu n'voudrais pas que Galvena me fouette parce que je n'ai pas fait mon quota ? Juste une nuit de plaisir pour toi et j'aurais atteins mes objectifs.~
@53847 = ~Passe ton ch'min alors. Y'a des gens qui apprécieraient peut-être de passer un moment avec toi mais c'est pas mon cas.~
@53848 = ~Je crains de ne pas avoir assez sur moi.~
@53849 = ~Je ne peux pas vous aider !~
@53850 = ~Vous n'connaissez pas par hasard une demoiselle potable qui aurait besoin d'un peu de compagnie ? Si c'est le cas, vous me l'envoyez, hein ?~
@53851 = ~Je dois trouver un moyen d'entrer dans votre guilde. Je dois parler à Dame Galvena.~
@53852 = ~Je vous remercie. Adieu !~
@53853 = ~Tous les maîtres portent le symbole de Galvena. Cela leur donne le droit d'aller où ils veulent !~
@53854 = ~Hum. Les gardes se rendraient rapidement compte que je ne travaille pas pour Dame Galvena, même si j'avais ce médaillon.~
@53855 = ~Et jusqu'à combien peut-on payer un tel médaillon ?~
@53856 = ~Bonne journée à vous, gente dame. Aimeriez-vous passer une nuit d'plaisir dans mes bras ? Ça vous coûtera pas grand-chose.~
@53857 = ~En fait, je suis à la recherche d'une fille nommée Claire. Vous la connaissez ?~
@53858 = ~Ça pourrait m'intéresser. Qu'as-tu en tête ?~
@53859 = ~Je préférerais savoir comment entrer dans votre guilde. Je dois discuter sérieusement avec Dame Galvena.~
@53860 = ~Yep, je vois d'qui vous parlez. Mais j'suis pas le genre à ébruiter ce genre de choses. Dame Galvena ne le permettrait pas.~
@53861 = ~Dame Galvena n'est pas là pour t'entendre et je ne lui dirais pas qui m'a aidé.~ ~Dame Galvena n'est pas là pour t'entendre et je ne lui dirais pas qui m'a aidée.~
@53862 = ~Dame Galvena ne saura rien de notre discussion... Tu peux me faire confiance, je suis ton ami.~ ~Dame Galvena ne saura rien de notre discussion... Tu peux me faire confiance, je suis ton amie.~
@53863 = ~Dans ce cas... Tu parlais de prendre du bon temps ? Qu'avais-tu en tête ?~
@53864 = ~Dis-moi comment rentrer dans les locaux de la guilde. Il y a des choses dont j'aimerais discuter avec Dame Galvena.~
@53865 = ~Peut-être qu'un peu d'or t'aiderait à parler ?~
@53866 = ~On pourrait aller à la guilde tous les deux, dans ma chambre, pour que je te montre ces talents qui me rendent si populaire. Pour une somme modique, évidemment.~
@53867 = ~De quel genre de « somme modique » parlons-nous ?~
@53868 = ~Tu pourrais peut-être plutôt me parler d'une jeune fille appelée Claire. La connais-tu ?~
@53869 = ~Il y a-t-il un moyen pour que je rentre dans la guilde par moi-même ? Je dois discuter avec Dame Galvena.~
@53870 = ~Les locaux d'la guilde sont réservés à ses membres. Loue-moi, petite, et je pourrai t'y emmener avec moi. Dans ma chambre. Il n'faudra pas t'balader ailleurs mais au moins tu seras à l'intérieur.~
@53871 = ~Et combien me coûteraient tes services ?~
@53872 = ~En fait, je préférerais discuter avec une fille appelée Claire. Tu la connais peut-être ?~
@53873 = ~Au revoir. Revenez quand vous voulez !~
@53874 = ~Tu es sûr ? Il n'y a pas d'autre moyen pour y entrer ?~
@53875 = ~Tu es sûr ? Il n'y a pas d'autre moyen pour y entrer ?~
@53876 = ~Je n'irai pas jusque là...~
@53877 = ~C'est trop dangereux... ils pourraient me tuer...~
@53878 = ~Eh bien... J'imagine que j'pourrais vous parler de c'te fille, mais je risque ma peau si jamais ça se sait. Donnez-moi 200 pièces d'or, ma jolie, et ça en vaudra le coup.~
@53879 = ~Je dois partir.~
@53880 = ~Très bien...~
@53881 = ~200 pièces d'or ?! C'est une somme énorme !~
@53882 = ~Claire était mariée à Sanik le marchand. Il allait l'emmener avec lui sur le prochain bateau, mais c'était sans compter sur la nature de Dame Galvena. Elle l'a tué et a enlevé Claire sur les quais, où elle attendait.~
@53883 = ~Très bien... Voilà ton or. Dis-moi ce qui est arrivé à Claire.~
@53884 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@53885 = ~Je me demande ce que Galvena a pu faire à Claire...~
@53886 = ~Si tu ne me dis pas vite ce que tu sais, et vite, je pourrais te casser la tête.~
@53887 = ~Eh bien... t'as l'air réglo. Et Sunie sait quel horrible sort Dame Galvena a fait subir à c'te pauvre fille. Bon, je vais t'dire ce qui est arrivé à Claire.~
@53888 = ~Elle a... des cellules... Des cellules bien sombre et bien humides où elle place ceux et celles qui lui déplaisent. Claire y est peut-être, à moins qu'elle ne soit déjà morte. Galvena ne nous permet jamais de partir !~
@53889 = ~Médaillon de Galvena~
@53890 = ~Le p'tit copain de Claire était décidé à l'emmener loin d'ici, tu vois ? Il a été voir Dame Galvena pour lui dire qu'il emmenait Claire et qu'il n'y avait pas à discuter.~
@53891 = ~Je vais devoir entrer dans la guilde. Comment fait-on ?~
@53892 = ~La pov' Claire croyait en lui... elle croyait que Dame Galvena ne ferait rien pour les en empêcher. La p'tite imbécile ! Dame Galvena ne laisse partir personne.~
@53893 = ~Claire attendait dehors le retour de son homme mais Dame Galvena l'a fait assassiner sur-le-champ et elle a enfermé Claire dans la guilde.~
@53894 = ~Je ne prétends pas savoir c'que Dame Galvena a prévu d'faire à Claire mais c'est certainement quelque chose de terrible. Personne ne s'élève contre Dame Galvena sans s'en mordre les doigts.~
@53895 = ~Comment puis-je entrer dans la guilde ? Je dois lui parler.~
@53896 = ~Je compte l'affronter. Je la tuerai si j'en ai l'occasion.~
@53897 = ~Oui ! Si quelqu'un doit vous attendre, il peut le faire dans le salon de Dame Galvena. Allons-y.~
@53898 = ~200 pièces d'or ?! C'est une somme énorme !~
@53899 = ~Dame Galvena engage toujours de nouveaux employés. Si vous aviez un médaillon, peut-être pourriez-vous passer...~
@53900 = ~Eh bien j'suis un homme doté d'nombreux talents si tu vois c'que j'veux dire. Pour 100 pièces d'or je pourrais t'donner du bon temps, ma belle.~
@53901 = ~Parfait. Voici 100 pièces d'or. Allons dans ta chambre de la guilde.~
@53902 = ~100 pièces d'or ?! C'est une somme énorme !~
@53903 = ~100 pièces d'or ? C'est une somme énorme. Il n'y a pas moins de payer moins ?~
@53904 = ~Je crains de ne pas avoir autant d'argent sur moi.~
@53905 = ~Et si au lieu que je te fracasse la tête tu me conduisais dans ta chambre de la guilde ? On fait ça ?~
@53906 = ~Eh bien... Il y a un moyen d'entrer, mais Dame Galvena me tuerait si elle apprenait que j'ai parlé. Donne-moi 200 pièces d'or, et ça en vaudra la peine.~
@53907 = ~200 pièces d'or ?! C'est une grosse somme !~
@53908 = ~Médaillon de Galvena~
@53909 = ~Tiens, voici tes 200 pièces d'or. Dis-moi comment entrer.~
@53910 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@53911 = ~Dis-moi comment entrer ou tu vas le regretter.~
@53912 = ~Bien sûr que non ! Soit tu entres en tant que client soit tu n'entres pas du tout. Dame Galvena nous surveille étroitement. Je ne risque pas ma peau pour rien.~
@53913 = ~Très bien. Combien dois-je débourser pour entrer en tant que client ?~ ~Très bien. Combien dois-je débourser pour entrer en tant que cliente ?~
@53914 = ~Et si nous parlions d'autre chose ? Connais-tu une dénommée Claire ?~
@53915 = ~J'ai vraiment besoin d'y entrer. Est-ce qu'un peu d'or t'aiderait à te décider ?~
@53916 = ~Dis-moi comment entrer ou tu vas le regretter.~
@53917 = ~Laisse tomber. Tu ne m'es pas d'un grand secours.~
@53918 = ~200 pièces d'or ?! C'est une grosse somme !~
@53919 = ~Hmpf. Je pourrais perdre ma langue à parler de ce genre de choses et tu veux marchander ? Ce sera 200 pièces d'or ou rien ma belle. À toi d'voir.~
@53920 = ~Voici tes 200 pièces d'or. Qu'est-il arrivé à Claire ?~
@53921 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@53922 = ~Dis-moi ce que je veux savoir ou tu auras des soucis pires que la simple perte de ta langue.~
@53923 = ~Parle-moi de la guilde dans ce cas. Il y a-t-il un moyen pour que j'y entre ?~
@53924 = ~Oublie ce que j'ai dit. Je vais m'en aller.~
@53925 = ~Nous n'avons rien à nous dire alors, ma belle. Je n'peux pas t'aider. Mieux vaudrait qu'tu passes ton chemin car j'ai une dure journée devant moi.~
@53926 = ~En comparaison de quoi ? En comparaison de ce que Dame Galvena me fera si je parle ? Hmpf. Fais comme tu veux ma belle, je ne dirais rien.~
@53927 = ~Je dois donc trouver l'un de ces médaillons ?~
@53928 = ~Merci pour l'aide !~
@53929 = ~Tous les maîtres en ont. Mais, la plupart du temps, ils ne sortent pas. Mais... Non ! Chremy est sorti depuis quelques jours !~
@53930 = ~Si tu veux pouvoir t'promener dans la guilde, tu as besoin d'un médaillon. Toutes les maîtresses courtisanes de Dame Galvena en portent un. C'est comme ça qu'les gardes les reconnaissent.~
@53931 = ~Attends... ils ne peuvent pas savoir que je ne travaille pas pour Dame Galvena si je porte un médaillon ?~
@53932 = ~Comment pourrais-je me procurer un de ces médaillons ?~
@53933 = ~Qui est Chremy ?~
@53934 = ~En fait, j'ai déjà tué ce Chremy...~
@53935 = ~C'est un des maîtres les plus cruels ! Il est sorti pour garder un œil sur la nouvelle, Ginia. La pauvre ! Elle vient à peine de nous « rejoindre ». Chremy est très dur avec elle !~
@53936 = ~Mais même avec son médaillon, les gardes se douteront que je ne travaille pas pour Galvena, non ?~
@53937 = ~Oui ? Je pourrais décider de t'aider ma belle. Je donnerais beaucoup pour être libéré de Dame Galvena. Je crois que je peux peut-être t'aider à entrer dans la guilde.~
@53938 = ~Nous pouvons aller dans ma chambre mais dès que tu en sortiras, tu devras t'occuper des gardes. Si tu préfères te déplacer discrètement, je peux également t'aider. À toi de voir.~
@53939 = ~Je me moque d'être repéré. J'ai juste besoin d'entrer dans la place.~ ~Je me moque d'être repérée. J'ai juste besoin d'entrer dans la place.~
@53940 = ~Dis-moi comment se déplacer discrètement dans la guilde.~
@53941 = ~Très bien. Suis-moi dans ce cas. Ce n'est pas loin d'ici... tes amis peuvent venir s'ils aiment regarder.~
@53942 = ~C'est le prix mon cœur. Si je te fais payer moins et que Dame Galvena me prend tout, comme fais-je pour m'en sortir ?~
@53943 = ~Très bien. Voici 100 pièces d'or. Allons dans ta chambre.~
@53944 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@53945 = ~Parlons d'autre chose dans ce cas. Connais-tu une dénommée Claire ?~
@53946 = ~Tout ce que je veux, c'est entrer dans la guilde. N'y a-t-il aucun moyen de faire cela ?~
@53947 = ~Laisse tomber.~
@53948 = ~Tout ce que je veux, c'est entrer dans les locaux de la guilde. Il y a-t-il un moyen de faire ça ?~
@53949 = ~Et si nous parlions d'autre chose ? Connais-tu une dénommée Claire ?~
@53950 = ~Très bien, je m'en vais.~
@53951 = ~Allez, pour un beau visage comme le tien, 50 pièces d'or... et je ne peux pas faire mieux. Je dois payer Dame Galvena, tu sais.~
@53952 = ~Très bien. Voici 50 pièces d'or. Allons à ta chambre.~
@53953 = ~Merci pour cette information.~
@53954 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@53955 = ~Parlons d'autre chose dans ce cas. Connais-tu une dénommée Claire ?~
@53956 = ~Tout ce que je veux, c'est entrer dans la guilde. N'y a-t-il aucun moyen de faire cela ?~
@53957 = ~Laisse tomber.~
@53958 = ~Hmpf. Je ne me laisserais pas impressionner ma belle. Tu ferais mieux de changer d'attitude avant de tomber nez à nez avec les hommes de Dame Galvena. Maintenant, barre-toi !~
@53959 = ~Tu crois que j'ai envie de me séparer de ma langue ? Je ne compte pas mettre Dame Galvena en colère ma belle. Si tu veux que je parle, c'est 200 pièces d'or. Point final.~
@53960 = ~Très bien. Voici tes 200 pièces d'or. Dis-moi comment entrer.~
@53961 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@53962 = ~Peut-être pourrais-je entrer avec toi... combien prends-tu ?~
@53963 = ~Parlons d'autre chose dans ce cas. Connais-tu une dénommée Claire ?~
@53964 = ~Dis-moi ce que je veux savoir ou tu perdras plus que la langue.~
@53965 = ~Je suis angoissé à l'idée que Dame Galvena découvre le pot aux roses, ma belle. Promets-tu de ne dire à personne que c'est moi qui ai parlé ?~
@53966 = ~Je le promets.~
@53967 = ~Je ne promets rien.~
@53968 = ~Passe ton chemin dans ce cas.~
@53969 = ~Oh, Dame Galvena engage tout le temps des nouvelles maîtresses. Tu pourrais tromper les gardes en portant leur médaillon.~
@53970 = ~Comment puis-je me procurer un de ces médaillons ?~
@53971 = ~C'est pas facile. Toutes les maîtresses courtisanes en ont un mais elles sortent rarement de la guilde. Ceci dit, Chremy se balade à l'extérieur. Tu pourrais lui prendre le sien.~
@53972 = ~Qui est Chremy ?~
@53973 = ~Ah... lui... Je l'ai déjà tué en fait.~
@53974 = ~Je me souviens de lui. Tu parles d'un médaillon dans ce genre ?~
@53975 = ~Il l'a bien mérité ! Servez-vous de son médaillon !~
@53976 = ~Mais même avec un médaillon, les gardes se douteront que je ne travaille pas pour Galvena, non ?~
@53977 = ~Merci pour cette information.~
@53978 = ~Mon seigneur. Nous y sommes.~
@53979 = ~Très bien. Et maintenant, où puis-je trouver Claire ?~
@53980 = ~Parfait. Comment puis-je me déplacer sans alerter les gardes ?~
@53981 = ~Très bien. Reste ici. Je dois trouver Dame Galvena et, si elle est coopérative, Claire.~
@53982 = ~Elle est vraiment en danger. Si Dame Galvena l'a autorisée à rester en vie, elle doit être dans la prison qui se trouve au fond du vestibule. Cependant, elle bien gardée et verrouillée.~
@53983 = ~C'est l'un des maîtres les plus cruels. On m'a dit qu'il surveillait la nouvelle, Ginia. Pauvre fille. Chremy ne lui fait aucune confiance alors qu'elle n'a rien fait de mal.~
@53984 = ~Je me souviens de lui. Je l'ai déjà tué.~
@53985 = ~Et que dois-je faire des gardes ?~
@53986 = ~Je me souviens de lui. Parles-tu de ce médaillon ?~
@53987 = ~Et que dois-je faire des gardes ?~
@53988 = ~Si je trouve ce Chremy et que je lui prends son médaillon, je pourrais entrer ?~
@53989 = ~Hmpf. Il a eu ce qu'il méritait. Tu as son médaillon alors ?~
@53990 = ~Non, je ne l'ai pas. Si je trouve ce médaillon, il me permettra d'entrer ?~
@53991 = ~Je crois que toi. C'est tout ?~
@53992 = ~Ouais, c'est bien ça.~
@53993 = ~Bien... soit tu utilises ça pour tromper les gardes soit je peux t'emmener dans ma chambre en te faisant passer pour un client. Ainsi tu commenceras de l'intérieur.~ ~Bien... soit tu utilises ça pour tromper les gardes soit je peux t'emmener dans ma chambre en te faisant passer pour une cliente. Ainsi tu commenceras de l'intérieur.~
@53994 = ~Où se trouve cette clef ?~
@53995 = ~Sans médaillon, vous ne passerez pas. Il faudra les tuer !~
@53996 = ~Je crois que je vais me débrouiller seul.~ ~Je crois que je vais me débrouiller seule.~
@53997 = ~Très bien... guide-moi à l'intérieur dans ce cas.~
@53998 = ~Tout ce que tu as à faire à partir de là, c'est d'aller le montrer aux gardes de la guilde. Je crois qu'avec ça ils te laisseront entrer sans problème.~
@53999 = ~Ne t'inquiète pas. Je mettrai cette guilde à genoux et vous libérerai tous !~
@54000 = ~Quelle importance ? J'ai juste besoin d'une information que détient Claire, et c'est tout !~
@54001 = ~Ouais. Trouve-le. Tu peux revenir me voir si tu veux et je dirais si c'est le bon. C'est bien le genre a porter une tonne de verroterie.~
@54002 = ~Vous avez un médaillon de membre. Si vous êtes convaincant, vous pourrez passer sans que les gardes vous attaquent.~
@54003 = ~Mais ils ne vous laisseront pas accéder à la prison ou à la chambre de dame Galvena. À moins que...~
@54004 = ~Parfait. Je vais faire ça... Merci.~
@54005 = ~Attend une seconde... pourquoi n'irions nous pas dans ta chambre ? Ainsi je n'aurais à m'occuper que des gardes de l'intérieur du bâtiment.~
@54006 = ~Très bien. Souviens-toi, ma belle... On ne s'est jamais vu.~
@54007 = ~Aller dans ma chambre ? Ahhh... Je ne veux pas m'impliquer plus que de raison dans cette histoire. Si Dame Galvena découvre ce que j'ai fait, c'est ma mort !~
@54008 = ~Que dirais-tu de 100 pièces d'or ? Ça t'aiderais à changer d'avis ?~
@54009 = ~Je m'occuperai de Dame Galvena... tu n'as plus besoin de t'inquiéter pour ça si c'est ton seul problème.~
@54010 = ~Très bien. J'irais seul à l'intérieur.~ ~Très bien. J'irais seule à l'intérieur.~
@54011 = ~Écoute, emmène-moi là-haut ou je te ferai subir bien pire que Dame Galvena.~
@54012 = ~Tu ferais ça ? Eh... c'est vrai que je suis prêt à prendre de gros risques pour être débarrassé d'elle. Très bien ma belle... Je suis prêt à t'emmener dans ma chambre.~
@54013 = ~Écoute, ma belle... Je suis prêt à t'emmener là-haut si tu veux. Mais seulement si tu utilises toutes tes compétences pour t'occuper définitivement de Dame Galvena. Tu rendras ainsi service à beaucoup de gens.~
@54014 = ~Je peux faire ça. Emmène-moi là-haut et je m'occuperai de Dame Galvena dès que j'aurai fini ce que j'ai à faire.~
@54015 = ~Oublie ça. J'ai des choses plus importantes à faire.~
@54016 = ~Tu devras de débrouiller seule ma belle. Je ne m'impliquerais pas plus. Et souviens-toi... on ne s'est jamais vu.~
@54017 = ~Comme tu veux ma belle. Bonne chance à toi.~
@54018 = ~Potion de sommeil~
@54019 = ~Ah ! As-tu le médaillon ?~
@54020 = ~Je crois... c'est celui là ?~
@54021 = ~Je ne pense pas que ça pourra marcher, mais bon ! J'ai une potion de sommeil... Toutes les courtisanes en ont. Des fois, dame Galvena nous dit de droguer notre client et de le voler... ou pire...~
@54022 = ~Non, pas encore.~
@54023 = ~Bien, j'attendrai jusqu'à ce que tu le trouve. Ne t'inquiètes pas ma belle... je n'ai pas grand-chose d'autre à faire.~
@54024 = ~Je pense à quelque chose ma belle... les gardes ne vont pas te laisser fouiner même avec ton médaillon. Dame Galvena ne laisse pas ses courtisanes faire grand-chose.~
@54025 = ~Potion de sommeil~
@54026 = ~Chope de bière~
@54027 = ~Dame Galvena nous donne un breuvage... une potion... que nous sommes supposés utiliser sur nos clients avec une... bourse trop pleine. Ça les endort, tu comprends ?~
@54028 = ~Chope de bière~
@54029 = ~Si tu n'as pas envie de te battre, tu pourrais apporter cette potion à la cuisinière et la convaincre de la vider dans la nourriture... pour endormir tout le monde.~
@54030 = ~Clef de la guilde~
@54031 = ~Comment suis-je supposé convaincre la cuisinière de faire ça ?~ ~Comment suis-je supposée convaincre la cuisinière de faire ça ?~
@54032 = ~Très bien, donne-moi la potion.~
@54033 = ~Pas la peine, je veux me battre.~
@54034 = ~C'était une idée comme ça, ma belle. Tu veux la potion malgré tout ?~
@54035 = ~Certainement. Je verrai ce que je peux faire.~
@54036 = ~Clef de la guilde~
@54037 = ~Non, pas la peine. Je veux me battre.~
@54038 = ~Comme tu veux, ma belle. Bonne chance à toi... si tu arrive à nous libérer, nous te serons certainement reconnaissants.~
@54039 = ~Pouah...~
@54040 = ~Bonne chance à toi. J'ai mis tous mes espoirs en toi, ma belle.~
@54041 = ~Mais où cela mène-t-il ?~
@54042 = ~Tu... tu nous as libérés de Dame Galvena ? J'osais à peine croire que c'était possible, mon <PRO_LADYLORD> ! Mille mercis.~ ~Tu... tu nous as libérés de Dame Galvena ? J'osais à peine croire que c'était possible, ma <PRO_LADYLORD> ! Mille mercis.~
@54043 = ~Si vous trouvez un moyen de la mettre dans la nourriture ou la boisson des gardes, ça les assommera. Peut-être la cuisinière sera-t-elle d'accord ?~
@54044 = ~Donne-moi ça et je verrai bien.~
@54045 = ~Je ne pense pas que cela fonctionnera. Merci quand même.~
@54046 = ~Voilà. Bonne chance. La cuisine est juste un peu plus loin.~
@54047 = ~Très bien, ma belle. Nous y sommes.~
@54048 = ~Très bien. Et maintenant, où puis-je trouver Claire ?~
@54049 = ~Très bien, je vais aller jeter un œil autour du bâtiment. Reste discret.~
@54050 = ~Très bien. Et maintenant, où puis-je trouver Claire ?~
@54051 = ~Très bien. Et maintenant, où puis-je trouver Claire ?~
@54052 = ~Très bien. Reste ici. Je dois trouver Dame Galvena et, si elle est coopérative, Claire.~
@54053 = ~Claire est certainement dans la cellule au fond du couloir. Les gardes ne te laisseront pas entrer là et je j'ai aucune idée de l'endroit où est la clef. Probablement sur Dame Galvena.~
@54054 = ~Si tu prévois de répandre le sang, j'espère que tu m'excuseras si je me cache sous le lit en priant pour que tu tues Dame Galvena au passage. Bonne chance...~
@54055 = ~Il est trop tard maintenant. Ne te l'avais-je pas dit ? Il va falloir que tu apprennes à me faire confiance tout de même. Tu es arrivé trop tard.~ [DREAM301] ~Il est trop tard maintenant. Ne te l'avais-je pas dit ? Il va falloir que tu apprennes à me faire confiance tout de même. Tu es arrivée trop tard.~ [DREAM301]
@54056 = ~Quoi ?! Tu ne peux pas sortir de ma chambre, ma belle. Un pas hors d'ici et j'appelle les gardes !~
@54057 = ~Vas-y, appelle-les. Tu te joindras à eux si tu fais ça.~
@54058 = ~Fais comme tu veux. J'ai juste besoin d'entrer dans les locaux.~
@54059 = ~Ne t'inquiète pas. Tu es en sûreté ici. Enfin, je vais te montrer ce qui t'habitait. Ne crains rien. Je vais te montrer ce qui comble le vide. Ce qui a été libéré.~ [DREAM302]
@54060 = ~Tiens... que dis-tu de 100 pièces d'or ? Ça te ferait taire ?~
@54061 = ~Je suis là pour trouver et pour parler à Claire. Ça ne devrait pas être long.~
@54062 = ~Claire ? C'est la raison de tout ceci ? Hmpf. Eh bien, je ne sais pas comment tu prévois de tromper les gardes mais je n'ai pas d'objection à te voir essayer d'aider la pauvre fillette.~
@54063 = ~GARDES ! GARDES !~
@54064 = ~Ouais. Pour 100 pièces d'or je vais aller, disons... m'endormir comme qui dirait. Je ne sais pas ce que tu as prévu de faire pour les gardes mais c'est tes affaires après tout, ma belle. Vas-y.~
@54065 = ~Tu n'es pas Imoen. Elle m'a dit qu'elle n'avait pas eu ce genre de rêve.~
@54066 = ~Va-t'en. Je me cache ici et je te remercie d'avance de me laisser en dehors de tes affaires.~
@54067 = ~Je connais le fond de ton esprit, je suis dans chaque fibre de ton être. Je suis la dernière parcelle qu'il te reste lorsque ta raison t'abandonne. Je me cache derrière ton âme.~ [DREAM303]
@54068 = ~J'aimerais parler à la femme qui m'a fait l'amener ici, s'il vous plaît.~
@54069 = ~Ah ! Si tu veux prendre du bon temps, mon pote, faut que tu ailles faire un saut à la salle des fêtes. Cette dame Galvena a un sacré spectacle !~ ~Ah ! Si tu veux prendre du bon temps, ma grande, faut que tu ailles faire un saut à la salle des fêtes. Cette dame Galvena a un sacré spectacle !~
@54070 = ~Les affaires sont bonnes à Brynnlaw... Des tas de vaisseaux déchargent ici, vous savez ? Les gars d'Spellhold ne s'occupent pas du tout de la ville, et c'est très bien comme ça.~
@54071 = ~Je vais te montrer ce que tu peux être, ce que tu peux faire. Prends conscience de ta vraie nature.~ [DREAM304]
@54072 = ~S'il est encore temps, faites gaffe à Desharik et ses potes. Ils aiment bien bousculer les gens, surtout quand ils ont fait le plein de bière.~
@54073 = ~Ahh, j'ai mal au dos... et avec ce foutu temps humide, j'ai déjà lâché deux caisses. Si je recommence, le quartier-maître va me botter le cul quelque chose de sérieux.~
@54074 = ~Je le peux car je suis en toi. Je suis le vide de ton âme. Je suis toi.~ [DREAM305]
@54075 = ~J'suis dans les îles Nélanthères depuis plus de dix ans, maintenant. C'est un chouette coin, si vous ne voulez pas être encombré par les lois et tout ça. Des exilés et des criminels. C'est tout ce qui nous arrive, maintenant, on dirait. Tous ne sont pas méchants.~
@54076 = ~Tu as reçu un don. C'est un des plus précieux, il te faut savoir l'apprécier à sa juste valeur.~ [DREAM406]
@54077 = ~Satanés pirates... notre cité était paisible même au milieu des Nélanthères. Les pirates craignaient Spellhold, savez-vous... jusqu'à ce qu'ils se rendent compte que les mages n'avaient que faire de nous.~
@54078 = ~Le sort de tes compagnons t'inquiète ? Ne t'occupe plus d'eux, abandonne leur image. Ton destin ne dépend pas d'eux. Laisse-les, et deviens ce que tu dois être.~ [DREAM407]
@54079 = ~La petite fille de ma sœur a été emmenée de force pour travailler dans cette maudite salle des fêtes et ils ne veulent même pas la laisser partir ! Comme si elle était une esclave !~
@54080 = ~Tu es seul, personne ne peut te venir en aide. Accepte ta vraie nature... résister ne fera que t'affaiblir.~ [DREAM408] ~Tu es seule, personne ne peut te venir en aide. Accepte ta vraie nature... résister ne fera que t'affaiblir.~ [DREAM408]
@54081 = ~Me croiriez-vous si je vous disais que cet endroit était plutôt paisible autrefois ? Spellhold éloignait tous les pirates... jusqu'à il y a quelques années.~
@54082 = ~*soupire* Des pirates sont venus chez nous il y a deux semaines et ils ont décrété que notre maison serait la cachette idéale pour leur butin. Il nous reste à peine une pièce maintenant.~
@54083 = ~La seule chose positive avec ces marins, c'est que mon magasin se porte bien... quand il n'est pas détruit à cause d'une bagarre ou simplement pillé, cela dit.~
@54084 = ~Tous les soirs, j'implore Umberlie, je prie pour que la Reine Garce de la Mer vienne et coule les bateaux de ces maudits pirates. Pfah !~
@54085 = ~Les mages de Spellhold devraient venir et faire QUELQUE CHOSE à propos de ces maudits pirates. Mais ils en font fi. Ils n'ont que faire de ce qui se passe ici.~
@54086 = ~Vous feriez mieux de faire attention à vous. La journée, la plupart des pirates sont ivres ou endormis mais la nuit, Brynnlaw est une cité dangereuse. Ma famille reste enfermée le plus possible.~
@54087 = ~Un jour, les Amniens viendront débarrasser les Nélanthères de toute cette vermine, vous verrez. Nous aurons un vrai seigneur pour nous gouverner, et tout.~
@54088 = ~Vous feriez mieux de faire attention à vos affaires, ici. Il y a des voleurs presque partout et des pirates qui n'hésiteront pas à vous tuer pour s'emparer de votre butin. La cité a presque brûlé à deux reprises, je vous le jure.~
@54089 = ~Ton héritage est sans pareil. Un pouvoir incommensurable est à portée de tes mains. Prends-le, il est à toi. Utilise-le, et tu approcheras de ce que tu es... de ce que tu peux être.~ [DREAM409]
@54090 = ~Sens-tu ? Utilise les armes mises à ta disposition et deviens autre. Je suis toi, je sais ce qu'il te faut. Utilise ce qui t'es offert. Accepte de prendre part à ce qui te dépasse.~ [DREAM410]
@54091 = ~Tu deviendras toujours plus noir à mesure que tu l'utiliseras. Chaque fois que tu l'utilises, que tu l'acceptes, tu te rapproches un peu plus de ce qui est maléfique en toi.~ [DREAM411] ~Tu deviendras toujours plus noire à mesure que tu l'utiliseras. Chaque fois que tu l'utilises, que tu l'acceptes, tu te rapproches un peu plus de ce qui est maléfique en toi.~ [DREAM411]
@54092 = ~Spellhold ? Es-tu sûr de vouloir y pénétrer ? Ceux qui y rentrent n'en ressortent généralement jamais.~ ~Spellhold ? Es-tu sûre de vouloir y pénétrer ? Ceux qui y rentrent n'en ressortent généralement jamais.~
@54093 = ~Tu sembles déterminé, cependant. Soit ! Je te dirai ce que je sais, mais je ne te serai pas d'un grand secours.~ ~Tu sembles déterminée, cependant. Soit ! Je te dirai ce que je sais, mais je ne te serai pas d'un grand secours.~
@54094 = ~Seuls deux sortes d'êtres peuvent y pénétrer : les Mages cagoulés et les Déviants dotés de dons de l'esprit spéciaux.~
@54095 = ~Parle-moi des Mages cagoulés.~
@54096 = ~Sur quelle base les Déviants magiques y entrent-ils ?~
@54097 = ~À dire vrai, nous n'avons ici qu'un seul Mage cagoulé, et il a depuis bien longtemps cessé d'obéir à leur discipline de fer. Cet endroit ne lui convient pas.~
@54098 = ~Son nom est Perth l'Adepte, et il a toute liberté d'entrer et de sortir de Spellhold. Je crois qu'il se sert pour cela d'une pierre gardienne.~
@54099 = ~Peut-être parviendras-tu... ah... à le « convaincre » de vous la remettre. Ou peut-être acceptera-t-il un pot-de-vin, mais selon toute vraisemblance, votre rencontre tournera à l'affrontement.~
@54100 = ~Parle-moi de ces Déviants. Sur quelle base sont-ils admis à l'asile ?~
@54101 = ~Je te remercie pour ton aide. Je sais à présent ce que je voulais savoir.~
@54102 = ~Il te faudrait pour cela provoquer sur le continent des désordres magiques extrêmes ; si par la suite tu survivais au courroux du Mage cagoulé, il se pourrait que tu sois envoyé là-bas.~ ~Il te faudrait pour cela provoquer sur le continent des désordres magiques extrêmes ; si par la suite tu survivais au courroux du Mage cagoulé, il se pourrait que tu sois envoyée là-bas.~
@54103 = ~Ce n'est pas ainsi que nous procédons sur cette île. La magie ne nous intéresse pas. C'est à d'autres fins que Desharik destine Spellhold. Il y laisse en général pourrir ses ennemis, et parfois aussi ses amis.~
@54104 = ~L'asile n'abrite pas les seuls fauteurs de trouble, on y trouve également des mages et des êtres mentalement instables, dangereux... d'où la nécessité de les séparer du monde.~
@54105 = ~Un trop plein d'eau salée altère l'esprit, et nombreux sont ceux qui perdent tout contact avec la réalité. Desharik est celui qui décide de leur internement.~
@54106 = ~Démontre ton instabilité mentale et peut-être Desharik t'y enverra-t-il. Mais je doute que tu apprécies le voyage. Ses quartiers se trouvent plus à l'ouest, dans une vaste bâtisse à flanc des collines. Dis au garde que tu viens de ma part.~
@54107 = ~Parle-moi des Mages cagoulés de l'île. Comment sont-ils admis à Spellhold ?~
@54108 = ~Je te remercie pour ton aide. Je sais à présent ce que je voulais savoir.~
@54109 = ~Comme tu voudras. Bien que je ne comprenne toujours pas pour quelle raison tu désires t'y rendre. Les hurlements qui s'en échappent y sont encore plus terrifiants qu'à l'accoutumée. Néanmoins, je te remercie pour ton aide.~
@54110 = ~Nous te sommes extrêmement obligés, mon ami. Voir Claire en sécurité était le plus grand souhait de Sanik.~ ~Nous te sommes extrêmement obligés, mon amie. Voir Claire en sécurité était le plus grand souhait de Sanik.~
@54111 = ~Galvena morte, nous n'avons plus grand-chose à craindre. Je te remercie à nouveau. Que souhaitais-tu demander à Sanik ?~
@54112 = ~Il me faut pénétrer dans l'asile. On m'a dit qu'il savait comment procéder.~
@54113 = ~Je n'ai pas besoin d'autres renseignements pour le moment, mais je te remercie.~
@54114 = ~Je te souhaite donc un bon voyage. Claire et moi te remercions encore.~
@54115 = ~Je vois que tu es de retour. Que puis-je faire pour t'aider ? Claire et moi te devons beaucoup.~
@54116 = ~En effet. Je dois pénétrer dans l'asile.~
@54117 = ~Je te remercie, je n'ai besoin de rien pour le moment.~
@54118 = ~Sac à gemmes~
@54119 = ~Salut, chéri. Tu veux venir avec moi pour t'amuser un peu ? On dit que mes mains peuvent faire fondre tous les ennuis !~ ~Salut, chérie. Tu veux venir avec moi pour t'amuser un peu ? On dit que mes mains peuvent faire fondre tous les ennuis !~
@54120 = ~Oh, un homme comme toi doit sûrement aimer la compagnie d'une fille ? Je suis à toi pour quelques pièces d'or !~
@54121 = ~Allez, viens maintenant mon chou... tu n'voudrais pas que Galvena me fouette parce que je n'ai pas fait mon quota ? Juste une nuit de plaisir pour toi et j'aurais atteins mes objectifs.~
@54122 = ~Oh, alors va-t'en. Certaines filles apprécient ta compagnie, mais ce n'est pas mon cas.~
@54123 = ~Tu ne connaîtrais pas un bel homme qui aurait besoin de compagnie, par hasard ?~
@54124 = ~Bien le bonjour ! Aimerais-tu passer une nuit de plaisir dans mes bras ? Ça ne coûte pas cher pour ce que c'est.~
@54125 = ~En fait, je suis à la recherche d'une fille nommée Claire. Vous la connaissez ?~
@54126 = ~Oui, je sais de qui tu parles. Mais je ne veux pas me mêler de ce qui ne me regarde pas. Dame Galvena ne le permettrait pas.~
@54127 = ~Dame Galvena n'est pas là pour t'entendre et je ne lui dirais pas qui m'a aidé.~ ~Dame Galvena n'est pas là pour t'entendre et je ne lui dirais pas qui m'a aidée.~
@54128 = ~Bon... je crois que je peux te parler de la fille, mais je risque ma peau si ça se sait. Paye-moi 200 pièces d'or pour me dédommager.~
@54129 = ~200 pièces d'or ?! C'est une somme énorme !~
@54130 = ~Hmmpff... je pourrais perdre ma langue si j'en parle, et tu veux que je le fasse ? Ce sera 200 pièces d'or ou rien.~
@54131 = ~Voici tes 200 pièces d'or. Qu'est-il arrivé à Claire ?~
@54132 = ~Le p'tit copain de Claire était décidé à l'emmener loin d'ici, tu vois ? Il a été voir Dame Galvena pour lui dire qu'il emmenait Claire et qu'il n'y avait pas à discuter.~
@54133 = ~La pauvre Claire l'a cru, elle aussi... elle croyait que dame Galvena ne ferait rien. Mais Galvena ne laisse jamais une fille partir, tu peux en être sûr.~
@54134 = ~Claire attendait dehors, que son homme revienne, mais Dame Galvena l'a fait assassiner. Elle a ramené Claire dans la guilde, et l'a enfermée à l'intérieur.~
@54135 = ~Je ne prétends pas savoir c'que Dame Galvena a prévu d'faire à Claire mais c'est certainement quelque chose de terrible. Personne ne s'élève contre Dame Galvena sans s'en mordre les doigts.~
@54136 = ~Comment puis-je entrer dans la guilde ? Je dois lui parler.~
@54137 = ~Si tu veux pouvoir t'promener dans la guilde, tu as besoin d'un médaillon. Toutes les maîtresses courtisanes de Dame Galvena en portent un. C'est comme ça qu'les gardes les reconnaissent.~
@54138 = ~Attends... ils ne peuvent pas savoir que je ne travaille pas pour Dame Galvena si je porte un médaillon ?~
@54139 = ~Dame Galvena engage tout le temps de nouveaux maîtres. Tu pourrais tromper les gardes si tu avais un médaillon. Ils ne vérifieront pas.~
@54140 = ~Comment puis-je me procurer un de ces médaillons ?~
@54141 = ~Oui, c'est sûr. Tous les maîtres des courtisanes en ont un, mais ils sortent rarement de la guilde. Ceci dit, je crois que Chremy est dehors, en ce moment. Tu pourrais prendre le sien.~
@54142 = ~Qui est Chremy ?~
@54143 = ~C'est l'un des maîtres les plus cruels. On m'a dit qu'il surveillait la nouvelle, Ginia. Pauvre fille. Chremy ne lui fait aucune confiance alors qu'elle n'a rien fait de mal.~
@54144 = ~Je me souviens de lui. Je l'ai déjà tué.~
@54145 = ~Hmpf. Il a eu ce qu'il méritait. Tu as son médaillon alors ?~
@54146 = ~Non, je ne l'ai pas. Si je trouve ce médaillon, il me permettra d'entrer ?~
@54147 = ~Ouais. Trouve-le. Tu peux revenir me voir si tu veux et je dirais si c'est le bon. C'est bien le genre a porter une tonne de verroterie.~
@54148 = ~Je crois que toi. C'est tout ?~
@54149 = ~Ouais, c'est tout.~
@54150 = ~Maintenant... tu peux l'utiliser pour tromper les gardes ou m'accompagner à ma chambre. Comme cela, tu seras à pied d'œuvre. À toi de choisir.~
@54151 = ~Je crois que je vais me débrouiller seul.~ ~Je crois que je vais me débrouiller seule.~
@54152 = ~À ta guise. Bonne chance.~
@54153 = ~Très bien... guide-moi à l'intérieur dans ce cas.~
@54154 = ~Très bien. Suis-moi dans ce cas. Ce n'est pas loin d'ici... tes amis peuvent venir s'ils aiment regarder.~
@54155 = ~Tout ce que tu as à faire à partir de là, c'est d'aller le montrer aux gardes de la guilde. Je crois qu'avec ça ils te laisseront entrer sans problème.~
@54156 = ~Parfait. Je vais faire ça... Merci.~
@54157 = ~Très bien. Mais n'oublie pas... on ne se connaît pas.~
@54158 = ~Attend une seconde... pourquoi n'irions nous pas dans ta chambre ? Ainsi je n'aurais à m'occuper que des gardes de l'intérieur du bâtiment.~
@54159 = ~Aller dans ma chambre ? Ahhh... Je ne veux pas m'impliquer plus que de raison dans cette histoire. Si Dame Galvena découvre ce que j'ai fait, c'est ma mort !~
@54160 = ~Que dirais-tu de 100 pièces d'or ? Ça t'aiderais à changer d'avis ?~
@54161 = ~Écoute... je veux bien te faire monter, mais seulement si tu t'occupes de dame Galvena. De manière permanente. Tu rendrais service à beaucoup de gens.~
@54162 = ~Je peux faire ça. Emmène-moi là-haut et je m'occuperais de Dame Galvena dès que j'aurais fini ce que j'ai à faire.~
@54163 = ~Oublie ça. J'ai des choses plus importantes à faire.~
@54164 = ~Alors, tu seras seul. Je ne veux pas m'impliquer davantage. Et n'oublie pas... je ne t'ai jamais vu.~ ~Alors, tu seras seule. Je ne veux pas m'impliquer davantage. Et n'oublie pas... je ne t'ai jamais vue.~
@54165 = ~Je m'occuperai de Dame Galvena... tu n'as plus besoin de t'inquiéter pour ça si c'est ton seul problème.~
@54166 = ~Tu le ferais ? Hé... je veux bien prendre des risques pour être libre. Très bien... je vais te faire monter dans ma chambre.~
@54167 = ~Très bien. J'irais seul à l'intérieur.~ ~Très bien. J'irais seule à l'intérieur.~
@54168 = ~Écoute, emmène-moi là-haut ou je te ferai subir bien pire que Dame Galvena.~
@54169 = ~Je me souviens de lui. Parles-tu de ce médaillon ?~
@54170 = ~Si je trouve ce Chremy et que je lui prends son médaillon, je pourrais entrer ?~
@54171 = ~Ah... lui... Je l'ai déjà tué en fait.~
@54172 = ~Je me souviens de lui. Tu parles d'un médaillon dans ce genre ?~
@54173 = ~Comment pourrais-je me procurer un de ces médaillons ?~
@54174 = ~Je compte l'affronter. Je la tuerai si j'en ai l'occasion.~
@54175 = ~Oui ? Je veux bien tenter le coup. Je donnerais beaucoup pour être libre de dame Galvena. Je peux peut-être t'aider à entrer dans la guilde.~
@54176 = ~Tu peux venir dans ma chambre. Mais en sortant, tu auras affaire aux gardes. Si tu veux rester discret, je peux aussi t'aider.~ ~Tu peux venir dans ma chambre. Mais en sortant, tu auras affaire aux gardes. Si tu veux rester discrète, je peux aussi t'aider.~
@54177 = ~Je me moque d'être repéré. J'ai juste besoin d'entrer dans la place.~ ~Je me moque d'être repérée. J'ai juste besoin d'entrer dans la place.~
@54178 = ~Dis-moi comment se déplacer discrètement dans la guilde.~
@54179 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@54180 = ~Alors, nous n'avons rien à nous dire. Je ne peux pas vous aider. Passez votre chemin, car j'ai une longue journée devant moi.~
@54181 = ~Tout ce que je veux, c'est entrer dans les locaux de la guilde. Il y a-t-il un moyen de faire ça ?~
@54182 = ~La guilde est réservée aux membres. Si vous me prenez, je peux vous emmener dans ma chambre. Vous ne pourrez pas vous promener, mais vous serez à l'intérieur.~
@54183 = ~Et combien me coûteraient tes services ?~
@54184 = ~Ben... je ne suis pas une fille très futée, vous voyez ce que je veux dire ? Mais pour 100 pièces d'or, je peux vous donner du bon temps que vous n'oublierez pas de sitôt.~
@54185 = ~Parfait. Voici 100 pièces d'or. Allons dans ta chambre de la guilde.~
@54186 = ~100 pièces d'or ?! C'est une somme énorme !~
@54187 = ~C'est le prix mon cœur. Si je te fais payer moins et que Dame Galvena me prend tout, comme fais-je pour m'en sortir ?~
@54188 = ~Très bien. Voici 100 pièces d'or. Allons dans ta chambre.~
@54189 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@54190 = ~Parlons d'autre chose dans ce cas. Connais-tu une dénommée Claire ?~
@54191 = ~Tout ce que je veux, c'est entrer dans la guilde. N'y a-t-il aucun moyen de faire cela ?~
@54192 = ~Laisse tomber.~
@54193 = ~Passe ton chemin dans ce cas.~
@54194 = ~100 pièces d'or ? C'est une somme énorme. Il n'y a pas moins de payer moins ?~
@54195 = ~Ouais, peut-être, pour une belle gueule comme toi. 50 pièces d'or, alors... mais pas moins. Je dois payer dame Galvena, tu sais.~
@54196 = ~Très bien. Voici 50 pièces d'or. Allons à ta chambre.~
@54197 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@54198 = ~Parlons d'autre chose dans ce cas. Connais-tu une dénommée Claire ?~
@54199 = ~Tout ce que je veux, c'est entrer dans la guilde. N'y a-t-il aucun moyen de faire cela ?~
@54200 = ~Laisse tomber.~
@54201 = ~Je crains de ne pas avoir autant d'argent sur moi.~
@54202 = ~Et si au lieu que je te fracasse la tête tu me conduisais dans ta chambre de la guilde ? On fait ça ?~
@54203 = ~Hmpfff. J'marche pas dans cette combine. Allez causer de ça ailleurs, sauf si vous voulez foncer tête baissée sur les hommes de dame Galvena. Maintenant, filez.~
@54204 = ~En fait, je préférerais discuter avec une fille appelée Claire. Tu la connais peut-être ?~
@54205 = ~Tu es sûr ? Il n'y a pas d'autre moyen pour y entrer ?~
@54206 = ~Bien sûr que non ! Vous êtes des clients, sinon rien. Dame Galvena a toujours l'œil sur nous... j'vais pas me casser le cou pour rien.~
@54207 = ~Très bien. Combien dois-je débourser pour entrer en tant que client ?~ ~Très bien. Combien dois-je débourser pour entrer en tant que cliente ?~
@54208 = ~Et si nous parlions d'autre chose ? Connais-tu une dénommée Claire ?~
@54209 = ~J'ai vraiment besoin d'y entrer. Est-ce qu'un peu d'or t'aiderait à te décider ?~
@54210 = ~Ben... y aurait peut-être moyen, si vous êtes aussi déterminés. Mais dame Galvena me ferait tuer si elle savait. Payez moi 200 pièces d'or et ça vaudra le coup.~
@54211 = ~200 pièces d'or ?! C'est une grosse somme !~
@54212 = ~Tu crois que j'ai envie de me séparer de ma langue ? Je ne compte pas mettre Dame Galvena en colère ma belle. Si tu veux que je parle, c'est 200 pièces d'or. Point final.~
@54213 = ~Très bien. Voici tes 200 pièces d'or. Dis-moi comment entrer.~
@54214 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@54215 = ~Peut-être pourrais-je entrer avec toi... combien prends-tu ?~
@54216 = ~Parlons d'autre chose dans ce cas. Connais-tu une dénommée Claire ?~
@54217 = ~Dis-moi ce que je veux savoir ou tu perdras plus que la langue.~
@54218 = ~Par rapport à quoi ? À ce que dame Galvena me fera pour avoir parlé ? Hmpf. Comme tu voudras, mais je ne veux rien savoir.~
@54219 = ~200 pièces d'or ?! C'est une grosse somme !~
@54220 = ~Ah, ce qui m'inquiète le plus, en fait, c'est que dame Galvena l'apprenne. Tu me promets de ne rien dire à personne ?~
@54221 = ~Je le promets.~
@54222 = ~Je ne promets rien.~
@54223 = ~Tiens, voici tes 200 pièces d'or. Dis-moi comment entrer.~
@54224 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@54225 = ~Dis-moi comment entrer ou tu vas le regretter.~
@54226 = ~Dis-moi comment entrer ou tu vas le regretter.~
@54227 = ~Laisse tomber. Tu ne m'es pas d'un grand secours.~
@54228 = ~Tu es sûr ? Il n'y a pas d'autre moyen pour y entrer ?~
@54229 = ~Et si nous parlions d'autre chose ? Connais-tu une dénommée Claire ?~
@54230 = ~Très bien, je m'en vais.~
@54231 = ~Dis-moi ce que je veux savoir ou tu auras des soucis pires que la simple perte de ta langue.~
@54232 = ~Parle-moi de la guilde dans ce cas. Il y a-t-il un moyen pour que j'y entre ?~
@54233 = ~Oublie ce que j'ai dit. Je vais m'en aller.~
@54234 = ~200 pièces d'or ?! C'est une somme énorme !~
@54235 = ~Eh bien... t'as l'air réglo. Et Sunie sait quel horrible sort Dame Galvena a fait subir à c'te pauvre fille. Bon, je vais t'dire ce qui est arrivé à Claire.~
@54236 = ~Très bien... Voilà ton or. Dis-moi ce qui est arrivé à Claire.~
@54237 = ~J'ai peur de ne pas avoir assez d'argent sur moi.~
@54238 = ~Si tu ne me dis pas vite ce que tu sais, et vite, je pourrais te casser la tête.~
@54239 = ~Dame Galvena ne saura rien de notre discussion... Tu peux me faire confiance, je suis ton ami.~ ~Dame Galvena ne saura rien de notre discussion... Tu peux me faire confiance, je suis ton amie.~
@54240 = ~Dans ce cas... Tu parlais de prendre du bon temps ? Qu'avais-tu en tête ?~
@54241 = ~Je pourrais te faire monter dans ma chambre, et te montrer pourquoi je suis si demandée. Pour une petite somme, bien sûr...~
@54242 = ~De quel genre de « somme modique » parlons-nous ?~
@54243 = ~Tu pourrais peut-être plutôt me parler d'une jeune fille appelée Claire. La connais-tu ?~
@54244 = ~Il y a-t-il un moyen pour que je rentre dans la guilde par moi-même ? Je dois discuter avec Dame Galvena.~
@54245 = ~Dis-moi comment rentrer dans les locaux de la guilde. Il y a des choses dont j'aimerais discuter avec Dame Galvena.~
@54246 = ~Peut-être qu'un peu d'or t'aiderait à parler ?~
@54247 = ~Ça pourrait m'intéresser. Qu'as-tu en tête ?~
@54248 = ~Je préférerais savoir comment entrer dans votre guilde. Je dois discuter sérieusement avec Dame Galvena.~
@54249 = ~Ah ! Alors... as-tu le médaillon ?~
@54250 = ~Je crois... c'est celui là ?~
@54251 = ~Non, pas encore.~
@54252 = ~Bon, alors je vais attendre que tu le trouves, je crois. Ne t'inquiètes pas... j'ai pas grand-chose d'autre à faire.~
@54253 = ~J'pensais à quelque chose, mon beau... les gardes ne te laisseront certainement pas fouiner comme ça, même avec le médaillon. Dame Galvena ne laisse pas beaucoup de liberté à ses maîtres des courtisanes.~
@54254 = ~Dame Galvena nous donne un breuvage... une potion... que nous sommes supposés utiliser sur nos clients avec une... bourse trop pleine. Ça les endort, tu comprends ?~
@54255 = ~Si tu ne veux pas te battre, tu pourrais donner la potion à la cuisinière. Faudra la convaincre de la mettre dans la nourriture... pour endormir tout le monde. Ce sera plus facile.~
@54256 = ~Comment suis-je supposé convaincre la cuisinière de faire ça ?~
@54257 = ~Je n'en ai aucune idée. J'y pensais, c'est tout. Tu veux tout de même la potion ?~
@54258 = ~Certainement. Je verrai ce que je peux faire.~
@54259 = ~À ta guise. Bonne chance... si tu peux me libérer avec les autres, on te sera tous très reconnaissants.~
@54260 = ~Non, pas la peine. Je veux me battre.~
@54261 = ~Très bien, donne-moi la potion.~
@54262 = ~Pas la peine, je veux me battre.~
@54263 = ~Bonne chance. Tous mes espoirs reposent sur toi.~
@54264 = ~Tu... tu nous as libérés de Dame Galvena ? J'osais à peine croire que c'était possible, mon <PRO_LADYLORD> ! Mille mercis.~ ~Tu... tu nous as libérés de Dame Galvena ? J'osais à peine croire que c'était possible, ma <PRO_LADYLORD> ! Mille mercis.~
@54265 = ~Très bien, mon mignon. Nous y sommes.~
@54266 = ~Très bien, je vais aller jeter un œil autour du bâtiment. Reste discret.~
@54267 = ~Quoi ? Tu ne peux pas sortir de ma chambre. Un pas de plus, et j'appelle les gardes !~
@54268 = ~Vas-y, appelle-les. Tu te joindras à eux si tu fais ça.~
@54269 = ~GARDES ! GARDES !~
@54270 = ~Fais comme tu veux. J'ai juste besoin d'entrer dans les locaux.~
@54271 = ~Tiens... que dis-tu de 100 pièces d'or ? Ça te ferait taire ?~
@54272 = ~Oui. Pour 100 pièces d'or, je vais, euh... m'endormir, ou faire semblant. Je ne sais pas ce que tu vas faire avec les gardes, mais ça te regarde. Vas-y.~
@54273 = ~Je suis là pour trouver et pour parler à Claire. Ça ne devrait pas être long.~
@54274 = ~Claire ? C'est la raison de tout ceci ? Hmpf. Eh bien, je ne sais pas comment tu prévois de tromper les gardes mais je n'ai pas d'objection à te voir essayer d'aider la pauvre fillette.~
@54275 = ~Claire doit être dans la cellule au bout du couloir. Les gardes ne te laisseront pas entrer... et je ne sais pas qui peut avoir la clef, en dehors de dame Galvena.~
@54276 = ~Si tu as l'intention de faire couler le sang, je vais me cacher sous le lit en priant pour la mort de dame Galvena. Bonne chance...~
@54277 = ~Très bien. Et maintenant, où puis-je trouver Claire ?~
@54278 = ~Très bien. Et maintenant, où puis-je trouver Claire ?~
@54279 = ~Très bien. Reste ici. Je dois trouver Dame Galvena et, si elle est coopérative, Claire.~
@54280 = ~Va-t'en. Je me cache ici et je te remercie d'avance de me laisser en dehors de tes affaires.~
@54281 = ~Laissez-moi tranquille.~
@54282 = ~Tu te perdras, peut-être, mais tu connaîtras l'ivresse de la vraie puissance. Tu accéderas à une récompense plus grande que tu ne peux l'imaginer.~ [DREAM412]
@54283 = ~Qu'importe une éternité de néant si tu peux détruire tous ceux qui s'opposent à... à ton destin. Et ce en comptant simplement : « un »...~ [DREAM413]
@54284 = ~« Deux. »~ [DREAM414]
@54285 = ~« Trois. »~ [DREAM415]
@54286 = ~« Quatre. »~ [DREAM416]
@54287 = ~« Cinq ! »~ [DREAM417]
@54288 = ~Problèmes de l'île : l'histoire de Ginia

J'ai dit à Ginia que j'avais tué Chremy. J'ai accepté de payer Calahan, le contrebandier, pour qu'il fasse quitter l'île à Ginia et à son frère.~
@54289 = ~Problèmes de l'île : l'histoire de Ginia

J'ai dit à Ginia que j'avais tué Chremy, mais je lui ai aussi annoncé que je ne paierai pas Calahan, le contrebandier, pour qu'il lui fasse quitter l'île ainsi qu'à son frère.~
@54290 = ~Problèmes de l'île : l'histoire de Ginia

J'ai dit à Ginia que j'avais tué Chremy et que j'avais payé Calahan pour qu'il lui fasse quitter l'île ainsi qu'à son frère. Elle était naturellement aux anges.~
@54291 = ~Problèmes de l'île : l'histoire de Ginia

J'ai dit à Ginia que j'avais payé Calahan pour qu'il lui fasse quitter l'île ainsi qu'à son frère. Elle était contente mais je dois encore m'occuper de Chremy pour les libérer.~
@54292 = ~Pour qui vous prenez-vous ? C'est ma cuisine ici ! Salle des fêtes ou pas, je suis fière de mon travail.~
@54293 = ~Rendre son corps à Kangaxx

J'ai rencontré un crâne doré dans le quartier des quais, qui m'a promis des richesses et un pouvoir bien au-delà de mon imagination si je le libérais de sa malédiction et si je lui rendais son corps. Il pense que ses bras, ses jambes et son torse sont disséminés dans les tombes de la ville.~
@54294 = ~Ce récipient est verrouillé.~
@54295 = ~Ce récipient est piégé.~
@54296 = ~Ce récipient est vraisemblablement piégé.~
@54297 = ~Oh, laissez donc en paix ce malheureux, Ellie. Il s'agit sans doute de l'un des nouveaux venus amenés ici par Madame.~ ~Oh, laissez donc en paix cette malheureuse, Ellie. Il s'agit sans doute de l'une des nouvelles venues amenées ici par Madame.~
@54298 = ~Blessures graves~
@54299 = ~Guenhwyvar~
@54300 = ~Blessures critiques~
@54301 = ~Semences de feu créées~
@54302 = ~Ça veut juste dire que ça fera plus de boulot pour moi, petite.~
@54303 = ~Fourvoiement magique~
@54304 = ~Comment êtes-vous entrés ici ? Gardes !~
@54305 = ~AHH ! Aidez-nous !~
@54306 = ~~
@54307 = ~Immunité contre les sorts~
@54308 = ~Madame, je suppose que vous êtes la cuisinière dont tous les gardes chantent les louanges.~
@54309 = ~Vision véritable~
@54310 = ~Personne ne veut de moi ici, je vais m'en aller.~
@54311 = ~Je dois faire attention. J'ai entendu beaucoup de choses sur le mal commis par Dame Galvena et je vais y mettre un terme. M'aiderez-vous en échange de votre liberté ?~
@54312 = ~Hâte améliorée~
@54313 = ~Je dois faire attention. J'ai entendu beaucoup de choses sur le mal commis par Dame Galvena et je vais y mettre un terme. M'aiderez-vous en échange de votre liberté ?~
@54314 = ~Diantre ! Une intrigue !~
@54315 = ~Déclencheur de sorts~
@54316 = ~Taisez-vous ! Rendez-vous utile et épluchez donc quelques pommes de terre !~
@54317 = ~Oui, Ellie.~
@54318 = ~Sourd(e)~
@54319 = ~C'est bien ce que je craignais : la colère de ce fou d'Irenicus s'est abattue sur la ville. Et la magie qu'il a utilisée... je reconnais à présent les forces magiques auxquelles il a eu recours.~ [ELHAN113]
@54320 = ~Une magie fourbe, des illusions d'esprit mauvais, les rakshasas. Ce sont de véritables prédateurs, il semblerait que tous les moyens sont bons pour Irenicus. Oui, il s'agit bien là d'une magie corrompue, des sortilèges employés par les rakshasas. De toute évidence, la noirceur d'Irenicus ne connaît nulle limite.~ [ELHAN114]
@54321 = ~Suldanessalar est assiégée. Mais avec toutes ces créatures sous ses ordres, Irenicus sera très difficile à déloger.~ [ELHAN115]
@54322 = ~Il nous faut faire preuve de la plus extrême prudence. Tout le monde ici n'est pas en mesure de supporter pareil assaut. La sécurité des habitants doit demeurer notre priorité.~
@54323 = ~Que racontez-vous comme bêtises ? Même si vous plaisantez, Galvena prendra des mesures si elle entend ce genre de choses.~
@54324 = ~Elle en entendra parler juste au moment de mourir. Puis-je compter sur votre coopération ?~
@54325 = ~Ne tenez pas compte de ce que j'ai dit.~
@54326 = ~Je suis ici pour trouver une jeune fille prénommée Claire. J'ai l'impression que Galvena la retient prisonnière quelque part. J'ai besoin de votre aide pour la délivrer.~
@54327 = ~C'est très dangereux mais c'est notre seule chance. Toutefois, je ne peux pas vous donner mon accord avant de savoir ce que vous allez faire.~
@54328 = ~Je suis ici pour trouver une jeune fille prénommée Claire. J'ai l'impression que Galvena la retient prisonnière quelque part. J'ai besoin de votre aide pour la délivrer.~
@54329 = ~Ne tenez pas compte de ce que j'ai dit.~
@54330 = ~Très bien. Laissez-moi maintenant.~
@54331 = ~Empêtré(e)~
@54332 = ~Métamorphosé(e)~
@54333 = ~Combat psychique~
@54334 = ~À l'assassin ! Que faire, Ellie ?~ ~À l'assassine ! Que faire, Ellie ?~
@54335 = ~Hémorragie~
@54336 = ~Enragé(e)~
@54337 = ~Malade~
@54338 = ~Ce n'est pas encore terminé, suivez-moi si vous l'osez !~
@54339 = ~Masse de la vestale +2~
@54340 = ~Forgée par les elfes noirs, cette masse d'armes a été spécialement traitée pour résister aux rayons du soleil. Elle a été conçue par la race souterraine en vue d'effectuer des raids à la surface... Son métal noir luit d'un poison sombre qu'elle semble générer elle-même, et cause des dégâts impressionnants en cas d'impact.

Cette masse d'armes semble presque vivante ; elle paraît chaude au toucher et semble vouloir glisser des mains de ceux qu'elle n'aime pas... à savoir, tout autre qu'un drow ou leurs semblables. Dans les mains d'une autre personne, elle n'est guère plus utile qu'un poids mort.

PARAMÈTRES :

Capacités de combat :
- La cible subit 1 point de dégât de poison toutes les 3 secondes pendant 1 tour (jet de sauvegarde contre les poisons pour annuler)

TAC0 : +2
Dégâts : 1d6 +3 (contondant)
Facteur de vitesse : 6
Type de compétence : masse d'armes
Type : arme à une main
Nécessite :
 9 en Force

Poids : 7~
@54341 = ~Cotte de mailles elfe noir +1~
@54342 = ~Croissance végétale~
@54343 = ~Création d'ombres~
@54344 = ~Imoen ne sait pas quand et comment elle a acquis ce ceinturon et, malgré tous ses efforts et sa magie, elle n'a pas pu le retirer.

PARAMÈTRES :

Poids : 0~
@54345 = ~Ceinturon d'Imoen~
@54346 = ~Sorts de soins lancés lors de la phase de repos.~
@54347 = ~Sorts de soins lancés lors de la phase de repos jusqu'à guérison complète.~
@54348 = ~Oooh...~ [CSCOW103]
@54349 = ~Oooh, oohhh...~ [CSCOW502]
@54350 = ~Oui ?~ [JAHEIR23]
@54351 = ~Sorts profanes~
@54352 = ~Sorts divins/druidiques~
@54353 = ~Otyugh majeur~
@54354 = ~Ce genre-là ? J'ai du mal à croire qu'ils diraient des choses pareilles à propos de moi. Ils n'ont du respect pour personne d'autre que pour Dame Galvena, cette redoutable jeune femme.~
@54355 = ~Otyugh majeur~
@54356 = ~Petite araignée~
@54357 = ~Petite araignée~
@54358 = ~Vous ne pouvez pas prendre une arme dans votre seconde main lorsque vous utilisez déjà une arme à distance.~
@54359 = ~Je suppose que vous n'êtes ni folle des gardes ni de Dame Galvena.~
@54360 = ~Désolé mais je dois m'en aller.~ ~Désolée mais je dois m'en aller.~
@54361 = ~Vous ne pouvez pas prendre une arme dans votre seconde main lorsque vous utilisez déjà une arme à distance.~
@54362 = ~J'ai entendu beaucoup de choses sur le mal commis par Dame Galvena et je vais y mettre un terme. M'aiderez-vous en échange de votre liberté ?~
@54363 = ~J'ai entendu beaucoup de choses sur le mal commis par Dame Galvena et je vais y mettre un terme. M'aiderez-vous en échange de votre liberté ?~
@54364 = ~Ce serait une bonne hypothèse mais n'en dites rien à Galvena. Il fallait garder ça pour moi.~
@54365 = ~J'ai entendu beaucoup de choses sur le mal commis par Dame Galvena et je vais y mettre un terme. M'aiderez-vous en échange de votre liberté ?~
@54366 = ~J'ai entendu beaucoup de choses sur le mal commis par Dame Galvena et je vais y mettre un terme. M'aiderez-vous en échange de votre liberté ?~
@54367 = ~Désolé mais je ne dois rien dire.~ ~Désolée mais je ne dois rien dire.~
@54368 = ~Vous ne pouvez pas prendre d'arme à distance si votre seconde main porte déjà une arme.~
@54369 = ~Je recherche une jeune fille prénommée Claire. Vous savez où je peux la trouver ?~
@54370 = ~Vous ne pouvez pas prendre d'arme à distance si votre seconde main porte déjà une arme.~
@54371 = ~Je recherche une jeune fille prénommée Claire. Vous avez où je pourrais la trouver ?~
@54372 = ~Galvena est TRÈS en colère contre cette fille. Elle l'a enfermée dans le donjon, et il ne fait aucun doute qu'elle est châtiée au moment même où nous parlons. Elle est même peut-être déjà morte.~
@54373 = ~Comment entrer dans le donjon ?~
@54374 = ~Merci pour l'information. Je vais voir ce que je peux faire.~
@54375 = ~La jeune fille doit être sauvée. Si vous m'aidez je peux la sauver elle et vous deux aussi, d'accord ?~
@54376 = ~Rendre son corps à Kangaxx

J'ai rendu au crâne doré les morceaux de son corps que j'ai récupérés... pour le voir prendre l'apparence d'une liche ! La créature a immédiatement attaqué avec sa puissante magie. À l'évidence, à l'avenir, il faudra que je fasse attention aux sollicitations des crânes étranges.~
@54377 = ~Gardien Vottnar~
@54378 = ~Tâchez de lui obéir. Si vous attaquez UN SEUL de mes elfes, vous serez tué immédiatement. Nous sommes nombreux, ne l'oubliez pas.~ ~Tâchez de lui obéir. Si vous attaquez UN SEUL de mes elfes, vous serez tuée immédiatement. Nous sommes nombreux, ne l'oubliez pas.~
@54379 = ~Gardien Vottnar~
@54380 = ~Les gardes ne vous laisseront pas passer et de toute façon tout est fermé. Galvena est à l'intérieur pour punir la fille. Elle n'aime pas être dérangée.~
@54381 = ~En pause~
@54382 = ~Qui a la clef ?~
@54383 = ~Relonar~
@54384 = ~Merci pour cette information.~
@54385 = ~Relonar~
@54386 = ~Tout ce qui reste d'une arme magique.~
@54387 = ~Réduction de la résistance au feu~
@54388 = ~~
@54389 = ~~
@54390 = ~Entrée de l'Ombre-Terre~
@54391 = ~Tente d'Elhan~
@54392 = ~Chant de mort~
@54393 = ~*c'est la puissance de Lolth elle-même qui maintient ces portes fermées*~
@54394 = ~Ces baies sont un indice important pour la résolution des meurtres du quartier du pont. Il faut les amener à Rose Bouquet pour voir si elle en reconnaît l'odeur.

PARAMÈTRES :

Poids : 1~
@54395 = ~Carte de la zone~
@54396 = ~Brume empoisonnée~
@54397 = ~Je ne suis qu'une cuisinière. À quoi pourrais-je être utile ?~
@54398 = ~Tu étais prévenu ! N'attaque pas ceux qui pourraient être tes amis !~ ~Tu étais prévenue ! N'attaque pas ceux qui pourraient être tes amis !~
@54399 = ~J'ai obtenu une potion de sommeil de la courtisane qui m'a amené ici. Ne pourriez-vous pas leur en verser discrètement ?~ ~J'ai obtenu une potion de sommeil du courtisan qui m'a amenée ici. Ne pourriez-vous pas leur en verser discrètement ?~
@54400 = ~Brume empoisonnée~
@54401 = ~Vous ne pouvez pas sauvegarder votre partie tant que vous n'avez pas le contrôle de tous les membres de votre groupe.~
@54402 = ~J'ai obtenu une potion de sommeil de la courtisane qui m'a amené ici. Ne pourriez-vous pas leur en verser discrètement ?~ ~J'ai obtenu une potion de sommeil du courtisan qui m'a amenée ici. Ne pourriez-vous pas leur en verser discrètement ?~
@54403 = ~Je n'ai besoin de rien pour l'instant.~
@54404 = ~Vous ne pouvez pas vous reposer tant que vous n'avez pas le contrôle de tous les membres de votre groupe.~
@54405 = ~Exporter fichier :~
@54406 = ~~
@54407 = ~Aaaaaaaaaah !~
@54408 = ~Rerdes, le capitaine de la garde, j'imagine. Soit cela soit une copie se trouvera dans les toilettes pour dames. Je me demande comment vous obtiendrez les clefs.~
@54409 = ~Nouvelles compétences de lancer de sort~
@54410 = ~Aux mains des flagelleurs mentaux !

Je suis tombé dans une enclave illithide, et j'ai de sérieux problèmes. Je dois combattre dans leur arène, pour leur plus grand amusement. J'ignore s'il sera possible de s'échapper de cette place forte remplie de flagelleurs mentaux. Ils sont ici au faîte de leur puissance.~ ~Aux mains des flagelleurs mentaux !

Je suis tombée dans une enclave illithide, et j'ai de sérieux problèmes. Je dois combattre dans leur arène, pour leur plus grand amusement. J'ignore s'il sera possible de s'échapper de cette place forte remplie de flagelleurs mentaux. Ils sont ici au faîte de leur puissance.~
@54411 = ~*l'arbre semble chatoyer légèrement quand on le regarde fixement... une sensation palpable de magie en émane... les fruits semblables à des noix, d'une taille peu courante, sont assez tentants... vous pouvez en prendre si vous voulez*~
@54412 = ~J'ai obtenu une potion de sommeil. Vous pourriez peut-être en verser dans la nourriture ou dans la boisson des gardes.~
@54413 = ~Aux mains des flagelleurs mentaux !

Il semble que je ne sois pas le seul à avoir été capturé et forcé à se battre. Un groupe de githyankis est aussi présent, et ils haïssent les illithids encore plus que moi. Peut-être pourront-ils m'aider, s'ils survivent aux combats.~ ~Aux mains des flagelleurs mentaux !

Il semble que je ne sois pas la seule à avoir été capturée et forcée à se battre. Un groupe de githyankis est aussi présent, et ils haïssent les illithids encore plus que moi. Peut-être pourront-ils m'aider, s'ils survivent aux combats.~
@54414 = ~Général Sovalidaas~
@54415 = ~Oh, oh, merci, cher <PRO_LADYLORD> !~ ~Oh, oh, merci, chère <PRO_LADYLORD> !~
@54416 = ~Oh oui, merci ! Ces horribles créatures ont bien failli tous nous tuer ! Elles... Elles ont massacré toutes les prêtresses...~
@54417 = ~Oui, ils... Ils sont arrivés dans le temple et ils les ont tués ! Tous les enfants de Rillifane !~
@54418 = ~Mais pas Demin ! La grande prêtresse... Elle est toujours en vie ! Je l'ai aperçue tout à l'heure en train de combattre ces créatures ! Vous devez la sauver !~
@54419 = ~Ne vous en faites pas pour Demin, je l'ai déjà sauvée.~
@54420 = ~J'ai bien peur que ce ne soit trop tard, Demin est morte.~
@54421 = ~Où puis-je trouver cette Demin ?~
@54422 = ~Oubliez ça... Elhan se trouve aux portails de la ville pour évacuer tout le monde. Allez-y vous aussi, vous y serez en sécurité.~
@54423 = ~Oh ! Mais c'est merveilleux ! Si... Si seulement quelqu'un pouvait arrêter ces créatures...~
@54424 = ~Elhan est en train d'évacuer tout le monde aux portails de la ville. Vous feriez mieux de vous y rendre maintenant.~
@54425 = ~Oui, bien sûr, nous y allons tout de suite !~
@54426 = ~Demin est... morte ? Par le Grand Chêne, nous sommes donc condamnés ! Condamnés !~
@54427 = ~N'y pensez plus pour le moment. Elhan vous attend au portail pour évacuer tout le monde. Allez-y et vous y serez en sécurité.~
@54428 = ~La... La dernière fois que je l'ai vue, c'était dans le quartier sud-ouest de la ville. Peut-être qu'elle s'est réfugiée dans une maison, je ne sais pas...~
@54429 = ~Je vais faire tout mon possible pour la retrouver. Pendant ce temps, rendez-vous au portail, Elhan s'y trouve déjà pour évacuer tout le monde. Vous y serez en sécurité.~
@54430 = ~J'ai obtenu une potion de sommeil. Vous pourriez peut-être en verser dans la nourriture ou dans la boisson des gardes.~
@54431 = ~Merci... Merci mille fois de m'avoir sauvé la vie. Ces... Ces créatures sont venues avec l'Exilé. Il veut tous nous tuer !~
@54432 = ~Ils ont fait irruption dans le temple et ont tué tous les acolytes ! C'était terrifiant... horrible ! J'ai réussi à m'échapper de justesse mais je crains que personne d'autre...~
@54433 = ~Merci pour le renseignement. Je vais voir ce que je peux faire.~
@54434 = ~Oh ! Demin, la grande prêtresse Demin ! Elle est toujours vivante ! Je l'ai vue dans le quartier sud-ouest de la ville ! Elle y est peut-être encore... Vous devez la sauver !~
@54435 = ~J'ai déjà sauvé Demin. Quant à Elhan, il se trouve aux portails de la ville afin d'évacuer tout le monde. Allez-y vous aussi, vous y serez en sécurité.~
@54436 = ~J'ai bien peur que Demin soit morte. Mais Elhan se trouve aux portails de la ville afin d'évacuer tout le monde. Allez-y vous aussi, vous y serez en sécurité.~
@54437 = ~On verra ça plus tard. Pour le moment, Elhan se trouve aux portails de la ville pour évacuer tout le monde. Allez-y vous aussi, vous y serez en sécurité.~
@54438 = ~Je... j'y vais. Merci encore.~
@54439 = ~Merci... Merci mille fois de m'avoir sauvé la vie. Ces... Ces créatures sont venues avec l'Exilé. Il veut tous nous tuer !~
@54440 = ~Ils ont fait irruption dans le temple et ont tué tous les acolytes ! C'était terrifiant... horrible ! J'ai réussi à m'échapper de justesse mais je crains que personne d'autre...~
@54441 = ~Oh ! Demin, la grande prêtresse Demin ! Elle est toujours vivante ! Je l'ai vue dans le quartier sud-ouest de la ville ! Elle y est peut-être encore... Vous devez la sauver !~
@54442 = ~Je... j'y vais. Merci encore.~
@54443 = ~J'ai déjà sauvé Demin. Quant à Elhan, il se trouve aux portails de la ville afin d'évacuer tout le monde. Allez-y vous aussi, vous y serez en sécurité.~
@54444 = ~J'ai bien peur que Demin soit morte. Mais Elhan se trouve aux portails de la ville afin d'évacuer tout le monde. Allez-y vous aussi, vous y serez en sécurité.~
@54445 = ~On verra ça plus tard. Pour le moment, Elhan se trouve aux portails de la ville pour évacuer tout le monde. Allez-y vous aussi, vous y serez en sécurité.~
@54446 = ~Quoi ? Des étrangers ici ? J'imagine que si l'Exilé peut revenir, tout peut arriver... Veuillez... m'excuser si je pleure... mes frères...~
@54447 = ~Les... Les monstres que commande l'Exilé sont passés par ici tout à l'heure. Ils ont massacré mes... mes amis... comme si ce n'était rien d'autre que des... des bouts de chair... C'était horrible...~
@54448 = ~Ma... ma femme...~
@54449 = ~... Elle... elle s'est jetée devant moi pour me protéger et je suis tombé. Et après... elle a voulu détourner l'attention de la créature et elle est partie en courant. La bête l'a... pourchassée et... l'a... attrapée et...~
@54450 = ~Je l'ai vue, vous m'entendez, j'ai vu cette créature dévorer sa chair... la chair de ma femme... *sanglote* Elle... Elle m'a sauvé la vie, mais...~
@54451 = ~C'est terrible ! Je suis sincèrement navré.~ ~C'est terrible ! Je suis sincèrement navrée.~
@54452 = ~C'était une femme courageuse. Nous honorerons sa mémoire.~
@54453 = ~Gardez vos larmes à présent. La journée n'est pas terminée. Allez aux portails de la ville... Elhan est déjà sur place pour évacuer tout le monde.~
@54454 = ~Oui, vous avez raison. Merci. Il y a encore beaucoup de gens aux prises avec ces horribles créatures. Ne pouvez-vous pas... mettre un terme à tous ces massacres ?~
@54455 = ~Je vais essayer, je vous le promets. Et maintenant, allez aux portails... Elhan est sur place pour évacuer tous les habitants de la ville.~
@54456 = ~Je suis ici pour affronter Irenicus, votre fameux... Exilé et personne d'autre. Allez aux portails de la ville... Elhan est déjà sur place...~
@54457 = ~Je... Euh... Oui, bien sûr.~
@54458 = ~Quoi ? Des étrangers ici ? J'imagine que si l'Exilé est revenu, alors tout peut arriver. Maintenant que les gardiens de l'esprit sont ici, nous avons peut-être une chance d'être sauvés.~
@54459 = ~Sauf... Sauf ma pauvre femme... Ma pauvre chérie et tant d'autres. Je... Veuillez m'excuser... Je dois me recueillir.~
@54460 = ~Laissez-moi seul, s'il vous plaît. Tout ceux que j'aimais sont morts. Il ne me reste plus qu'à les pleurer.~
@54461 = ~Les gardiens de l'esprit sont arrivés ! Que le Grand Chêne soit loué ! Merci à vous, étranger, vous nous avez sauvés !~ ~Les gardiens de l'esprit sont arrivés ! Que le Grand Chêne soit loué ! Merci à vous, étrangère, vous nous avez sauvés !~
@54462 = ~Aahh ! Des monstres ! Des monstres !~
@54463 = ~Non... Non, Vilanas, ce ne sont pas des monstres... Ce sont juste... des étrangers.~
@54464 = ~S'il vous plaît, m'sieur, pouvez-vous... nous aider ? Papa et maman... ils nous ont dit d'attendre à l'intérieur. Ils sont sortis et... et nous avons entendu des bruits horribles...~ ~S'il vous plaît, m'dame, pouvez-vous... nous aider ? Papa et maman... ils nous ont dit d'attendre à l'intérieur. Ils sont sortis et... et nous avons entendu des bruits horribles...~
@54465 = ~Ils sont morts ! *sanglote* Papa et maman sont morts ! *sanglote*~
@54466 = ~Nooon ! *sanglote* Non, Vilanas, ce n'est pas vrai ! Vous... vous les avez vus, pas vrai, m'sieur ? Vous les avez vus, hein ?~ ~Nooon ! *sanglote* Non, Vilanas, ce n'est pas vrai ! Vous... vous les avez vus, pas vrai, m'dame ? Vous les avez vus, hein ?~
@54467 = ~Si... Si vous pouvez sauver ne serait-ce qu'un seul habitant de cette ville, étranger... nous vous serions tellement reconnaissants. J'ai aperçu tout à l'heure la grande prêtresse de Rillifane au sud-ouest d'ici. Peut-être... peut-être pourrait-elle vous aider. Ou peut-être pourriez-vous l'aider...~ ~Si... Si vous pouvez sauver ne serait-ce qu'un seul habitant de cette ville, étrangère... nous vous serions tellement reconnaissants. J'ai aperçu tout à l'heure la grande prêtresse de Rillifane au sud-ouest d'ici. Peut-être... peut-être pourrait-elle vous aider. Ou peut-être pourriez-vous l'aider...~
@54468 = ~Mais je ferais mieux de me diriger vers les portails maintenant. Il doit déjà y avoir de très nombreux blessés... Si je peux aider qui que ce soit...~
@54469 = ~Je pourrais me faire tuer pour une chose pareille. Je pense que je pourrais en mettre dans leur bière mais Galvena les enverra me tuer dès qu'ils se réveilleront. Pourquoi risquer ma vie pour vous ?~
@54470 = ~Galvena est pratiquement une marchande d'esclaves, mais de second ordre. Je dois sauver la jeune Claire et je jure de tuer Galvena par la même occasion. Ainsi, vous serez libres.~
@54471 = ~Non, je ne les ai pas vus mais ça ne signifie pas pour autant qu'ils sont morts, mon enfant. Venez... Il faut aller aux portes de la ville. Vous serez en sécurité là-bas.~
@54472 = ~Oui. Oui, je les ai vus. Ils sont aux portes de la ville... Allez-y tout de suite, les enfants !~
@54473 = ~Non, et il reste très peu d'espoir pour qu'ils soient toujours en vie. Maintenant, il va falloir être très courageux, d'accord ? Vous devez aller jusqu'aux portes de la ville... Vous y serez en sécurité.~
@54474 = ~Vous n'avez peut-être aucune raison de le faire. Je vais m'en aller.~
@54475 = ~Dégagez, marmots pleurnichards ! Il faut aller aux portes de la cité ! MAINTENANT !~
@54476 = ~*sanglote* Ouuuiiin... Ils sont morts ! Morts ! Je le savais !~
@54477 = ~*sanglote* Peut-être... *sanglote* Peut-être pas, Vilanas. Viens... Allez, viens ! *sanglote* Merci, <PRO_SIRMAAM>...~
@54478 = ~Ça ne marcherait pas. Je pourrais leur verser dans leur bière mais ils ne vous feraient pas confiance et ne boiraient pas.~
@54479 = ~Tu... T'as entendu ça, Vilanas ? *sanglote* Ils sont vivants !~
@54480 = ~C'est... C'est vrai ? *sanglote* Papa et maman sont vivants ? *renifle* Allons aux portails ! Je... je veux voir maman !~
@54481 = ~Je pourrais amener cela aux gardes, Ellie !~
@54482 = ~Petite, vous n'allez pas risquer votre vie pour le plan suicidaire de cet homme.~ ~Petite, vous n'allez pas risquer votre vie pour le plan suicidaire de cette femme.~
@54483 = ~*sanglote* Je... *sanglote* Oui, m'sieur. Je... nous allons essayer d'être courageux !~ ~*sanglote* Je... *sanglote* Oui, m'dame. Je... nous allons essayer d'être courageux !~
@54484 = ~J'ai été arrachée à ma famille et forcée à une vie de servitude par Galvena ! J'ignore combien de temps encore je pourrai supporter pareille situation ! Cette personne a déjà fait tant de chemin. Si je fais cela, il se pourrait bien que je recouvre ma liberté. Il FAUT que j'essaye !~
@54485 = ~Aaaahh !~
@54486 = ~AHHHH ! COURS, VILANAS !~
@54487 = ~Je suis vieille et fatiguée. Même si Galvena me tuait, je ne manquerais pas grand-chose. Quant à vous, profitez du fait que l'on s'occupe des gardes. Nous mourrons si vous ne le faites pas.~
@54488 = ~Aahh ! Des monstres ! Des monstres !~
@54489 = ~Non, Vilanas, tout va bien ! Le... Les gardiens de l'esprit sont là... Ils chassent toutes les méchantes créatures !~
@54490 = ~Je suis très déterminé mais j'ai quand même besoin de l'aide de Claire. Allons-y !~ ~Je suis très déterminée mais j'ai quand même besoin de l'aide de Claire. Allons-y !~
@54491 = ~Mais qu'est-ce qui est arrivé à maman et à papa ? Ils nous ont dit d'attendre à l'intérieur... et puis... après... il y a eu ces bruits horribles... *sanglote*~
@54492 = ~Je ne suis pas sûr. Oubliez que j'ai demandé quelque chose.~ ~Je ne suis pas sûre. Oubliez que j'ai demandé quelque chose.~
@54493 = ~Les... Les gardiens sont là maintenant. Peut-être qu'on peut partir et aller les chercher ! Allons-y !~
@54494 = ~Donnez-moi la potion, là ! Nous allons préparer trois choppes, une pour chaque garde. Quand ils seront endormis, la jeune fille entrera dans la chambre de Galvena où Rerdes monte la garde.~
@54495 = ~Tuez Rerdes et prenez la clef de la prison. Galvena est à l'intérieur... elle doit avoir son magicien avec elle, un homme dangereux. Si Claire n'est pas morte, vous la récupérez et nous, nous récupérerons notre liberté.~
@54496 = ~Galvena doit mourir. Souvenez-vous de ça avant tout. Prenez la bière et allez-y.~
@54497 = ~Suivez-moi, <PRO_SIRMAAM>, mais demeurez en arrière, je vous en conjure.~
@54498 = ~Lançons l'assaut immédiatement, voyons ! Qu'ils viennent donc, ses sbires ! J'abattrai toute sa clique !~
@54499 = ~Je m'en voudrais de mutiler la cité. Quelles manœuvres suggérez-vous d'entreprendre ?~
@54500 = ~Si vous avez des idées, c'est le moment de me les soumettre. Je ne le laisserai pas me vaincre de nouveau.~
@54501 = ~Vous devez à tout prix trouver Ellésime. Elle saura quoi faire. Le lien qui l'unit aux divinités n'est guère différent du vôtre, mais son esprit est infiniment plus bienveillant.~
@54502 = ~Mettez-vous en route, <CHARNAME>. Ma garde d'élite et moi veillerons sur ce périmètre. Nous guiderons les gens pour les mener en sécurité, tandis que vous sécuriserez l'intérieur des murs.~
@54503 = ~Je pourrais encourir de graves périls, du seul fait que je m'adresse à vous. Allez plutôt voir Ellie, s'il vous faut quelque chose.~
@54504 = ~Maudits golems ! Que notre Protecteur maudisse l'âme de l'Exilé pour tous les crimes qu'il a commis aujourd'hui !~
@54505 = ~Et maudits soyons-nous également pour avoir envoyé tant de gens combattre les elfes noirs en laissant Suldanessalar sans protection. *soupire* Une question, étrangers. Je croyais que l'Exilé nous avait cachés... Comment êtes-vous donc arrivé là ?~
@54506 = ~Guenhwyvar~
@54507 = ~Malchor Harpell~
@54508 = ~Malchor Harpell~
@54509 = ~Quelle importance ? Je suis venu apporter mon aide.~ ~Quelle importance ? Je suis venue apporter mon aide.~
@54510 = ~Je suis venu affronter Irenicus... votre Exilé. La manière dont je suis arrivé ici n'a aucune importance.~ ~Je suis venue affronter Irenicus... votre Exilé. La manière dont je suis arrivée ici n'a aucune importance.~
@54511 = ~Je suis venu avec Elhan, qui se trouve en ce moment aux portails de la ville pour évacuer les habitants.~ ~Je suis venue avec Elhan, qui se trouve en ce moment aux portails de la ville pour évacuer les habitants.~
@54512 = ~Si c'est le cas, cela n'a aucune importance en effet. Nous avons vu beaucoup trop de victimes aujourd'hui... des enfants... des femmes... Et je suis certain, que d'ici la fin de la journée, des milliers d'autres seront tomber. Rien que d'y penser, j'ai la gorge nouée...~
@54513 = ~Si vous devez faire une seule chose aujourd'hui, je prie pour que vous retrouviez l'Exilé et que vous lui offriez ce qu'il mérite : la mort et les Abysses pour l'éternité.~
@54514 = ~Elhan est aux portails ? C'est donc là que nous devons nous rendre. Merci, étranger... Je prie pour que vous aidiez notre ville dans son heure la plus tragique. J'aimerais pouvoir m'emparer de la vie de l'Exilé en personne !~ ~Elhan est aux portails ? C'est donc là que nous devons nous rendre. Merci, étrangère... Je prie pour que vous aidiez notre ville dans son heure la plus tragique. J'aimerais pouvoir m'emparer de la vie de l'Exilé en personne !~
@54515 = ~Si cela échoue, trouvez Demin, la grande prêtresse. Si quelqu'un a été alerté de la venue d'Irenicus et s'y est préparé, cela ne peut être que l'une de ces deux-là.~
@54516 = ~Maudits golems ! Que notre Protecteur maudisse l'âme de l'Exilé pour tous les crimes qu'il a commis aujourd'hui !~
@54517 = ~Maudits golems ! Que notre Protecteur maudisse l'âme de l'Exilé pour tous les crimes qu'il a commis aujourd'hui !~
@54518 = ~<CHARNAME> ! Le temps nous presse ! Chassez donc toutes ces folies de votre esprit et revenons-en à l'unique solution qui s'offre à nous !~
@54519 = ~Et maudits soyons-nous également pour avoir envoyé tant de gens combattre les elfes noirs en laissant Suldanessalar sans protection. *soupire* Une question, étrangers. Je croyais que l'Exilé nous avait cachés... Comment êtes-vous donc arrivé là ?~
@54520 = ~Et maudits soyons-nous également pour avoir envoyé tant de gens combattre les elfes noirs en laissant Suldanessalar sans protection. *soupire* Une question, étrangers. Je croyais que l'Exilé nous avait cachés... Comment êtes-vous donc arrivé là ?~
@54521 = ~Quelle importance ? Je suis venu apporter mon aide.~ ~Quelle importance ? Je suis venue apporter mon aide.~
@54522 = ~Je ne vous ferai certes pas croire que j'approuve tous vos actes, mais pour l'heure, nous devons à tout prix faire alliance ! Je vais retrouver mes gens, hors les murs. Quant à vous, poursuivez votre traque !~
@54523 = ~Quelle importance ? Je suis venu apporter mon aide.~ ~Quelle importance ? Je suis venue apporter mon aide.~
@54524 = ~Je suis venu affronter Irenicus... votre Exilé. La manière dont je suis arrivé ici n'a aucune importance.~ ~Je suis venue affronter Irenicus... votre Exilé. La manière dont je suis arrivée ici n'a aucune importance.~
@54525 = ~Je suis venu affronter Irenicus... votre Exilé. La manière dont je suis arrivé ici n'a aucune importance.~ ~Je suis venue affronter Irenicus... votre Exilé. La manière dont je suis arrivée ici n'a aucune importance.~
@54526 = ~Je suis venu avec Elhan, qui se trouve en ce moment aux portails de la ville pour évacuer les habitants.~ ~Je suis venue avec Elhan, qui se trouve en ce moment aux portails de la ville pour évacuer les habitants.~
@54527 = ~Je suis venu avec Elhan, qui se trouve en ce moment aux portails de la ville pour évacuer les habitants.~ ~Je suis venue avec Elhan, qui se trouve en ce moment aux portails de la ville pour évacuer les habitants.~
@54528 = ~Si c'est le cas, cela n'a aucune importance en effet. Nous avons vu beaucoup trop de victimes aujourd'hui... des enfants... des femmes... Et je suis certain, que d'ici la fin de la journée, des milliers d'autres seront tomber. Rien que d'y penser, j'ai la gorge nouée...~
@54529 = ~Voilà qui est de mauvaise augure pour l'avenir de la ville. Il faut impérativement arrêter Irenicus. Hâtez-vous de trouver Ellésime ou la grande prêtresse Demin.~ [ELHAN116]
@54530 = ~Si c'est le cas, cela n'a aucune importance en effet. Nous avons vu beaucoup trop de victimes aujourd'hui... des enfants... des femmes... Et je suis certain, que d'ici la fin de la journée, des milliers d'autres seront tomber. Rien que d'y penser, j'ai la gorge nouée...~
@54531 = ~Si vous devez faire une seule chose aujourd'hui, je prie pour que vous retrouviez l'Exilé et que vous lui offriez ce qu'il mérite : la mort et les Abysses pour l'éternité.~
@54532 = ~Si vous devez faire une seule chose aujourd'hui, je prie pour que vous retrouviez l'Exilé et que vous lui offriez ce qu'il mérite : la mort et les Abysses pour l'éternité.~
@54533 = ~Elhan est aux portails ? C'est donc là que nous devons nous rendre. Merci, étranger... Je prie pour que vous aidiez notre ville dans son heure la plus tragique. J'aimerais pouvoir m'emparer de la vie de l'Exilé en personne !~ ~Elhan est aux portails ? C'est donc là que nous devons nous rendre. Merci, étrangère... Je prie pour que vous aidiez notre ville dans son heure la plus tragique. J'aimerais pouvoir m'emparer de la vie de l'Exilé en personne !~
@54534 = ~Elhan est aux portails ? C'est donc là que nous devons nous rendre. Merci, étranger... Je prie pour que vous aidiez notre ville dans son heure la plus tragique. J'aimerais pouvoir m'emparer de la vie de l'Exilé en personne !~ ~Elhan est aux portails ? C'est donc là que nous devons nous rendre. Merci, étrangère... Je prie pour que vous aidiez notre ville dans son heure la plus tragique. J'aimerais pouvoir m'emparer de la vie de l'Exilé en personne !~
@54535 = ~Encore vous ? Que voulez-vous ?~
@54536 = ~Je suppose que vous êtes la cuisinière dont tous les gardes vantent les mérites.~
@54537 = ~Personne ne veut de moi ici, je vais m'en aller.~
@54538 = ~Je dois faire attention. J'ai entendu beaucoup de choses sur le mal commis par Dame Galvena et je vais y mettre un terme. M'aiderez-vous en échange de votre liberté ?~
@54539 = ~Je dois faire attention. J'ai entendu beaucoup de choses sur le mal commis par Dame Galvena et je vais y mettre un terme. M'aiderez-vous en échange de votre liberté ?~
@54540 = ~J'ai suivi vos ordres. Partez et tuez Galvena pendant que vous y êtes.~
@54541 = ~<LADYLORD>, tous mes remerciements ! J'ai bien cru devoir trimer jusqu'à la fin de mes jours pour cette mauvaise femme mais vous avez écarté cette menace. Adieu et bonne chance !~
@54542 = ~Hé ! Qui es-tu pour te promener chez madame comme si tu étais chez toi ?~
@54543 = ~Je suis un nouvel employé d'Athkatla.~ ~Je suis une nouvelle employée d'Athkatla.~
@54544 = ~Je suis un nouvel employé d'Athkatla.~ ~Je suis une nouvelle employée d'Athkatla.~
@54545 = ~Pardon, je m'en vais.~
@54546 = ~Je ne suis qu'une nouvelle recrue. Qu'y a-t-il derrière ces portes ?~
@54547 = ~Je suis un simple client.~ ~Je suis une simple cliente.~
@54548 = ~Tu as un des médaillons de madame ? Oui... il semble authentique. Pourtant, on ne m'a pas parlé d'un nouvel employé.~ ~Tu as un des médaillons de madame ? Oui... il semble authentique. Pourtant, on ne m'a pas parlé d'une nouvelle employée.~
@54549 = ~** L'AVATAR DU GRAND CHÊNE SE TIENT DEVANT VOUS, MORTELS. QUE SE PASSE-T-IL DONC QUI PUISSE MÉRITER L'ATTENTION DU SEIGNEUR DES ARBRES ? **~ [SUAVAT02]
@54550 = ~Moi non plus. Pour plus de sécurité, je crois que nous devrions le tuer.~ ~Moi non plus. Pour plus de sécurité, je crois que nous devrions la tuer.~
@54551 = ~** AH... L'EXILÉ EST DE RETOUR. **~
@54552 = ~** CELUI QUI ÉTAIT AUTREFOIS UN DES ELFES, MAIS NE L'EST PLUS, A SURVÉCU. UNE FOIS ENCORE, IL A PERPÉTRÉ SON SACRILÈGE CONTRE L'ARBRE DE VIE. **~
@54553 = ~Ha ! Imbéciles ! Vous savez aussi bien que moi que madame ne vous dit pas tout. Écartez-vous !~
@54554 = ~Ha ! Imbéciles ! Vous savez aussi bien que moi que madame ne vous dit pas tout. Écartez-vous !~
@54555 = ~Tu ne crois pas que tu en fais un peu trop ?~
@54556 = ~Quelques pièces d'or te feraient peut-être changer d'avis...~
@54557 = ~** L'EXILÉ SE PROTÈGE AVEC UN POUVOIR QUI CORROMPT LA NATURE. JE NE PEUX L'ATTEINDRE. **~
@54558 = ~Alors meurs, ainsi que Galvena !~
@54559 = ~Capitaine Rerdes ! Des intrus !~
@54560 = ~Le sorcier, Jon Irenicus, a...~
@54561 = ~Euh, je... euh... non.~
@54562 = ~Exactement. Maintenant, écarte-toi. Je veux passer par cette porte.~
@54563 = ~Bien. Maintenant, laisse-moi passer, sinon la Dame te punira.~
@54564 = ~** IL RETIENT PRISONNIÈRE DE LA CORRUPTION CELLE QUI EST DE MON SANG. IL SE SERT DE SON LIEN AVEC L'ARBRE DE VIE POUR PUISER DANS SON POUVOIR. **~
@54565 = ~Oui, euh... <SIRMAAM> ?~
@54566 = ~** L'EXILÉ CHERCHE À SE JOINDRE À LA SELDARINE. L'EXILÉ VEUT DEVENIR UN DIEU, COMME IL A DÉJÀ TENTÉ DE LE FAIRE. **~
@54567 = ~Hé ! Employé ou pas, personne n'a le droit d'entrer dans les appartements de Madame ou dans la prison ! Fiche le camp !~
@54568 = ~Pourquoi ? Que va-t-il...~
@54569 = ~** LE PREMIER DE LA SELDARINE NE LE PERMETTRAIT JAMAIS. L'ARBRE DE VIE NE DOIT PAS PÉRIR OU NOS ENFANTS SOUFFRIRONT. **~
@54570 = ~Je cherche une certaine Claire. Sais-tu où elle est ?~
@54571 = ~** LES ESPRITS DE CETTE FORÊT SERONT APPELÉS POUR VAINCRE LE MAL LIBÉRÉ PAR L'EXILÉ EN NOTRE SEIN. **~
@54572 = ~Très bien, je m'en vais.~
@54573 = ~Tant mieux, j'ai mieux à faire que pouponner les bambins.~
@54574 = ~Madame prend soin d'elle dans la prison. Tu ne peux pas entrer. Disparais, nous sommes occupés.~
@54575 = ~** RÉVEILLEZ-VOUS, ESPRITS... MOI, RILLIFANE RALLATHIL DE LA SELDARINE, JE VOUS APPELLE. EN CE JOUR, DÉFENDEZ NOS ENFANTS. **~
@54576 = ~Les créatures qui hantent la cité me semblent diablement puissantes ! Comment parviendrai-je à les vaincre toutes ?~
@54577 = ~Je cours, je vole !~
@54578 = ~Quels pouvoirs possèdent ces créatures, que je ne détiens pas ?~
@54579 = ~On fait notre boulot ! Capitaine Rerdes ! Des intrus !~
@54580 = ~** QUANT À VOUS, MORTEL... **~ ~** QUANT À VOUS, MORTELLE... **~
@54581 = ~** VOUS CHERCHEZ À VAINCRE L'EXILÉ. LIBÉREZ CELLE QUI EST DE MON SANG DE SA CORRUPTION ET ELLE TRANCHERA LE LIEN DONT IL SE SERT. **~
@54582 = ~Tu ne peux pas nous acheter. Madame nous fouetterait jusqu'au sang. Tuons cet idiot et finissons-en. Capitaine Rerdes ! Des intrus !~ ~Tu ne peux pas nous acheter. Madame nous fouetterait jusqu'au sang. Tuons cette idiote et finissons-en. Capitaine Rerdes ! Des intrus !~
@54583 = ~** JE NE PEUX RIEN FAIRE D'AUTRE. **~
@54584 = ~Belle tentative, imbécile. Capitaine Rerdes ! Des intrus !~
@54585 = ~Vous n'y parviendrez pas. Elles sont beaucoup trop nombreuses. Et tandis que nous restons là, à perdre notre temps, Irenicus demeure à l'abri. Faites ce que je vous ai dit : trouvez donc Demin ou Ellésime.~
@54586 = ~Il s'agit d'une cité fort ancienne. Le secret de sa longévité réside dans quelques protections bien spécifiques. Trouvez Demin ou Ellésime : l'une comme l'autre sauront forcément réactiver ces protections.~
@54587 = ~J'ai confiance en vous. Mais le temps nous est compté.~
@54588 = ~Tout se passe bien ? J'ai mis certains de mes frères à l'abri pour l'instant. Mais si personne n'arrête Irenicus, nos efforts seront vains.~ [ELHAN117]
@54589 = ~Mais que diable fais-tu donc ?! Capitaine Rerdes ! Des intrus !~
@54590 = ~Ha ! Un employé de Galvena porterait son symbole. Tuez cet idiot ! Rerdes ! Des intrus !~ ~Ha ! Une employée de Galvena porterait son symbole. Tuez cette idiote ! Rerdes ! Des intrus !~
@54591 = ~Alors retourne dans tes quartiers ! Tu ne peux pas déambuler ainsi sans escorte. Pars !~
@54592 = ~Les appartements de madame et les cellules où sont enfermés les mécontents et les fauteurs de trouble.~
@54593 = ~Je voudrais entrer, s'il te plaît.~
@54594 = ~Je cherche une fille du nom de Claire. Sais-tu où elle est ?~
@54595 = ~Merci, je vais te laisser.~
@54596 = ~Tu ne vois pas que je travaille ? Va-t'en sinon je te flanque une raclée.~
@54597 = ~J'en ai assez de toi. Hors de ma vue !~
@54598 = ~Tiens, regardez qui revoilà ! On veut s'amuser un peu, hein ? Notre tour de garde peut finir quand tu veux.~
@54599 = ~On va se payer un peu de bon temps, hein ?~
@54600 = ~Voilà qui est tentant. Je vous ai apporté un peu de bière. C'est qu'à force de jouer les sentinelles, vous devez avoir soif.~
@54601 = ~Bon, c'est mieux comme ça ! Passe-moi une chopine !~
@54602 = ~Mmmm. C'est bon. J'aime bien l'arrière-goût...~
@54603 = ~Oui... agréable... il fait chaud ici... j'ai besoin de m'asseoir un instant...~
@54604 = ~Moi aussi... je... uhhhhh...~
@54605 = ~Tout a fonctionné à merveille, <LADYLORD>. Le capitaine Rerdes est en ce moment même en la chambre de Dame Galvena. Suivez-moi. Nous pourrons dénicher à l'intérieur la clef des cellules.~
@54606 = ~Que signifie cette intrusion ? Tu sais qu'il est interdit d'entrer dans la chambre de la Dame, fillette.~
@54607 = ~C'est vrai ? Il est grand temps que mes loyaux services soient reconnus. Fort bien, je vais donc prendre ça.~
@54608 = ~C'est la Dame qui m'a demandé de vous apporter ceci. Elle a en outre ajouté que vous méritiez un peu de repos.~
@54609 = ~Et voici, capitaine. Cul sec !~
@54610 = ~Oh... ce sont juste quelques clients, capitaine. N'ayez crainte, je les fais sortir sur l'heure. Je vous en prie, videz donc votre verre.~
@54611 = ~Qui est-ce, derrière toi ? Ils ne devraient pas être ici. Débarrasse-toi d'eux sur-le-champ !~
@54612 = ~Très bien, je suppose que tu veux récupérer la chope.~
@54613 = ~C'est bien, mais je...~
@54614 = ~Je... eh bien c'est...~
@54615 = ~... arrrgh...~
@54616 = ~C'est fini, <SIRMAAM>. Je vous en conjure, trouvez cette clef qui vous permettra de libérer cette malheureuse Claire. Quant à moi, j'ai fait tout ce qui était en mon pouvoir. Je ne puis plus que vous souhaiter bonne chance. Et merci encore pour ce que vous vous apprêtez à faire pour nous.~
@54617 = ~Par les dieux ! Tu as profané la chambre de la Dame par ton intrusion ! Meurs !~
@54618 = ~Galvena ! Nous avons un invité.~ ~Galvena ! Nous avons une invitée.~
@54619 = ~... et la sentence de mort a donc été prononcée contre toi, Claire.~
@54620 = ~Silence ! La punition est sévère et immédiate. Nous devons faire de toi un exemple, comme nous l'avons fait avec ton... « mari », Sanik. Je pense que...~
@54621 = ~J'ai été à votre service pendant des années ! Pourquoi ne me laissez-vous pas m'en aller ? *sanglote*~
@54622 = ~Hmmm, en effet. Qui es-tu, homme ? Où sont ces bons à rien de gardes ?~ ~Hmmm, en effet. Qui es-tu, femme ? Où sont ces bons à rien de gardes ?~
@54623 = ~Ils sont indisposés. Je dois parler à la fille, Claire. Permets-moi de le faire et tu auras la vie sauve.~
@54624 = ~Dame Galvena ! Le temps où tu asservissais ces courtisanes est maintenant révolu. La guilde n'est plus, et tu dois payer pour tes crimes.~
@54625 = ~Je crois que je me suis trompé de pièce. Excuse-moi.~ ~Je crois que je me suis trompée de pièce. Excuse-moi.~
@54626 = ~La fille sera bientôt morte et elle m'appartient. Tu n'as aucun droit sur elle.~
@54627 = ~Je ne m'intéresse pas à tes affaires avec Sanik et Claire. Je veux simplement lui demander des informations. Tu pourras la reprendre quand je saurai si elle sait quelque chose.~
@54628 = ~Quel courage ! Vadek, que penses-tu de ceci ?~
@54629 = ~L'arrogance est un trait commun chez les pires aventuriers.~
@54630 = ~Bien dit ! Je crois que c'est l'heure d'une petite leçon d'humilité. Vadek, tu peux commencer.~
@54631 = ~Ces gens ne sont pas ta propriété. Libère-la ou subis ma colère !~
@54632 = ~Je ne pourrais plus affronter mes employeurs si je laissais les intrus s'échapper sans agir. Vadek, tue cet intrus !~ ~Je ne pourrais plus affronter mes employeurs si je laissais les intrus s'échapper sans agir. Vadek, tue cette intruse !~
@54633 = ~Avec plaisir !~
@54634 = ~Oh, merci infiniment ! Elle allait m'assassiner ! Est-ce que c'est Sanik qui vous envoie ? Je dois absolument le retrouver !~
@54635 = ~Désolé mais c'est Galvena qui a tué Sanik. J'ai tout vu.~ ~Désolée mais c'est Galvena qui a tué Sanik. J'ai tout vu.~
@54636 = ~Je serai bref : Sanik a été tué par l'assassin de Galvena juste avant de me dire comment accéder à l'asile.~ ~Je serai brève : Sanik a été tué par l'assassin de Galvena juste avant de me dire comment accéder à l'asile.~
@54637 = ~D'après l'opinion générale, Galvena avait mérité de mourir. Vous êtes libre de vous en aller mais je me demandais si vous ne pourriez pas m'aider avant.~
@54638 = ~Je vais faire tout ce que je peux mais je dois voir mon époux avant.~
@54639 = ~Désolé mais Sanik a été tué par l'assassin de Galvena. J'ai tout vu.~ ~Désolée mais Sanik a été tué par l'assassin de Galvena. J'ai tout vu.~
@54640 = ~Tué ? Ce n'est pas vrai... *sanglote*~
@54641 = ~Non... pourquoi a-t-elle fait une chose pareille ? *sanglote*~
@54642 = ~Désolée. *sanglote* Je me doutais qu'elle avait pu le tuer mais je ne voulais pas y croire. Il allait m'emmener loin de tout ça, mais maintenant...~
@54643 = ~Je suis vraiment désolé. Vous savez où aller maintenant ?~ ~Je suis vraiment désolée. Vous savez où aller maintenant ?~
@54644 = ~Je serai bref : Sanik a été tué par l'assassin de Galvena juste avant de me dire comment accéder à l'asile.~ ~Je serai brève : Sanik a été tué par l'assassin de Galvena juste avant de me dire comment accéder à l'asile.~
@54645 = ~Sanik approvisionnait Spellhold et connaissait quelques-uns de ses secrets, mais cela me faisait peur. Je ne sais rien sur ces effrayants magiciens, et je ne pense pas vouloir savoir quoi que ce soit.~
@54646 = ~Une amie est prise au piège à l'intérieur et je dois la sauver. Quelqu'un sait comment on entre ?~
@54647 = ~Le capitaine du bateau marchand de Sanik devrait bien le savoir. Il s'appelle Golin, c'est un homme bon et il pourra m'emmener loin d'ici maintenant que Sanik est mort.~
@54648 = ~Allons-y. Vous serez en sécurité et je pourrais sauver mon ami. Où est-il ?~
@54649 = ~Où est Golin ? Je dois absolument lui parler !~
@54650 = ~Il doit être près des quais. Venez, je vais vous y conduire.~
@54651 = ~Golin, le capitaine du bateau de Sanik, est un homme bon. Je serais en sécurité auprès de lui.~
@54652 = ~Le capitaine de Sanik ? Il a peut-être l'information qu'il me faut. Où se trouve-t-il ?~
@54653 = ~Je dois vous escorter et assurer votre sécurité.~
@54654 = ~Vous êtes le capitaine Golin ?~
@54655 = ~Claire ? Depuis la mort de Sanik, nous avons remué ciel et terre pour te retrouver ! Comment te sens-tu ? Et qui sont ces gens qui t'accompagnent ?~
@54656 = ~Je suis en sécurité maintenant. Galvena a tenté de me tuer pour servir d'exemple auprès des autres filles. C'est cette personne qui m'a sauvée.~
@54657 = ~C'est donc à elle que doit s'adresser notre reconnaissance. Je te remercie d'avoir sauvé Claire. Comment nous acquitter de notre dette envers toi ? Si Sanik était toujours parmi nous, c'est sa vie qu'il offrirait.~
@54658 = ~Cette pauvre fille méritait une vie meilleure. Galvena était une femme immensément maléfique. Je souhaiterais simplement savoir comment pénétrer dans l'asile. Sanik allait me le révéler quand il a été tué.~
@54659 = ~Une récompense serait la bienvenue.~
@54660 = ~Mais certainement ! Prends cet or. C'est toute ma fortune, mais je te l'offre avec grand plaisir.~
@54661 = ~Encore une chose. Saurais-tu comment pénétrer dans l'asile ? Une de mes amies y est enfermée et je dois l'en sortir. Sanik allait me le révéler quand il a été assassiné par le sbire de Galvena.~
@54662 = ~Je te remercie. Adieu.~
@54663 = ~Salut ! Merci de m'avoir sauvée des griffes de Galvena. Si seulement Sanik avait pu s'en sortir, lui aussi.~
@54664 = ~J'ai besoin d'en savoir plus sur l'asile. Vous savez comment on peut y entrer ?~
@54665 = ~J'étais heureux d'apporter de l'aide. Adieu.~ ~J'étais heureuse d'apporter de l'aide. Adieu.~
@54666 = ~Je n'en sais absolument rien. Il faudrait demander au capitaine Golin.~
@54667 = ~Bon voyage !~
@54668 = ~J'ai parlé à Demin. Je dois protéger le temple et redonner vie à ses gardiens.~
@54669 = ~Parlez-moi des gardiens du temple.~
@54670 = ~Je vais faire aussi vite que possible. N'ayez crainte, je sauverai votre inestimable cité.~
@54671 = ~Quoi ? Qui... QUI OSE ?!~ [IRENIC59]
@54672 = ~Tu... tu es toujours en vie ? Ton âme n'est que coquille vide et tu persistes à te dresser contre MOI ?!~ [IRENIC60]
@54673 = ~C'est moi ! Tes projets sont ruinés, Irenicus. Tu vas mourir ici même !~
@54674 = ~Tu devais bien te douter que je ne te laisserais pas t'enfuir.~
@54675 = ~Par tout ce qui est juste, je suis ici pour te détruire !~
@54676 = ~Attendez ! Qui va là ? Vous... vous êtes l'enfant de Bhaal, n'est-ce pas ? Celui dont Joneleth... Jon... se vantait d'avoir volé la puissance ? Il prétendait vous avoir occis.~ [ELLESI02] ~Attendez ! Qui va là ? Vous... vous êtes l'enfant de Bhaal, n'est-ce pas ? Celle dont Joneleth... Jon... se vantait d'avoir volé la puissance ? Il prétendait vous avoir occis.~ [ELLESI02]
@54677 = ~Eh bien non, il n'est pas parvenu à m'abattre. Et je reviens aujourd'hui lui faire payer son tribut.~
@54678 = ~Il a bien failli parvenir à ses fins. Je vais donc tâcher de lui rendre la monnaie de sa pièce !~
@54679 = ~Vos soucis ne sont guère que secondaires ! Tout ce qui m'intéresse, c'est Irenicus !~
@54680 = ~Ah ! Personne ne pourra m'arrêter ! D'ailleurs, je ne le permettrai pas !~
@54681 = ~C'est exact, mais vous... qui êtes-vous donc ? Et qu'est-ce qu'Irenicus est en train de comploter ?~
@54682 = ~Je suis Ellésime, Reine de Suldanessalar. Je suis prisonnière du cœur de l'arbre, avec Joneleth, piégée par ses sortilèges maudits. Je ne peux projeter mon image plus avant.~
@54683 = ~J'ignore de quelle espèce de parasites il s'agit, toujours est-il que c'est là la dépravation incarnée ! Ils fournissent à Joneleth la puissance nécessaire et cette cage me retient prisonnière !~
@54684 = ~Pour l'heure, enfant de Bhaal, Irenicus est proprement invincible ! Néanmoins, lorsqu'il se nourrit du pouvoir de l'Arbre, il relâche son attention. Il pourrait alors s'avérer plus vulnérable !~
@54685 = ~Les gardiens ! Voilà bien longtemps que nous n'avons pas eu à invoquer leur secours. Mais cette fois, notre situation est tellement désespérée...~
@54686 = ~La cité elfe a besoin de mon aide

Je dois trouver deux morceaux du Rhynn Lanthorn, des panneaux de verre qui servent à concentrer son énergie. Elhan dit que ses sages ont réuni des indices sur leur localisation probable. Je vais les étudier les uns après les autres.~
@54687 = ~Que vous soyez ici pour sauver mon peuple ou vous venger de celui qui vous a causé du tort, peu me chaut. Une seule chose m'importe : que les parasites qui ont élu domicile sur l'Arbre de Vie soient exterminés !~
@54688 = ~Chargez-vous de cette tâche ! Je pourrai ensuite rompre les liens qui unissent Jon à l'Arbre... Alors seulement, vous serez en mesure de vous débarrasser de lui ! Je... je crois bien qu'il s'est chargé de protéger les parasites... Je ne sais pas. Hâtez-vous !~
@54689 = ~Comment atteindre les parasites ? Je ne vois pas comment me frayer un chemin parmi la ramure !~
@54690 = ~Faites tout votre possible, <CHARNAME>. Quant à moi, je retourne aider mon peuple à échapper au carnage.~
@54691 = ~Les branches s'enchevêtrent, en effet. Servez-vous des noix... celles qu'on trouve dans les jardins du palais ! Elles engendreront à leur tour de nouvelles branches sur lesquelles vous pourrez passer !~
@54692 = ~Ce récipient est plein.~
@54693 = ~Faites vite, enfant de Bhaal ! Si Jon épuise l'Arbre de Vie, Suldanessalar tout entière est condamnée... Et Jon obtiendra le pouvoir auquel il aspire tant ! Je vous en prie, vous DEVEZ l'arrêter dans son entreprise !~
@54694 = ~Les gardiens ! Ce sont les esprits d'anciens guerriers, entrés depuis longtemps dans la légende. Nous n'avons pas fait appel à eux depuis des lustres.~
@54695 = ~À n'en pas douter, la situation présente justifie qu'on les tire de leur sommeil. Faites donc votre devoir, <CHARNAME>. Il s'agit de s'en prendre enfin à Irenicus.~
@54696 = ~Vous ne pouvez pas mettre ce type d'objet dans un récipient.~
@54697 = ~Ne traitez pas à la légère ces terribles circonstances. Si l'on n'arrête pas la progression d'Irenicus, nous sommes tous condamnés, à coup sûr.~
@54698 = ~Mais vous ne pourrez l'atteindre qu'en nous aidant d'abord ! Il nous faut lutter côte à côte, quels que soient les griefs que vous nourrissez contre nous !~
@54699 = ~Oui, parfait ! Il n'en reste qu'un à détruire ! Ces entraves commencent déjà à disparaître !~ [ELLESI15]
@54700 = ~Quel merveilleux spectacle que de pouvoir à nouveau contempler les protecteurs sanctifiés nos rues. Merci pour ce que vous avez fait. Vous avez bien agi.~ [ELHAN118]
@54701 = ~Attendez-vous au pire une fois que j'aurais rompu le lien tissé entre Jon et l'Arbre de Vie. Soyez sur vos gardes. Dès que vous aurez exterminé le dernier parasite, je me mettrai à détruire le lien. Vous devrez alors vous hâter de gagner le cœur de l'arbre où je me tiens avec Irenicus !~ [ELLESI16]
@54702 = ~L'énergie qu'il a volée à l'arbre lui sera arrachée. Je ne sais pas quels en seront les effets... nous pourrions tous être tués. Mais Jon sera affaibli et désorienté. Vous devrez donc l'achever le plus rapidement possible !~ [ELLESI17]
@54703 = ~Finissez-en vite ! L'Arbre de Vie se meurt, je le sens ! Jon est sur le point de l'emporter ! Hâtez-vous d'en finir, vite !~ [ELLESI18]
@54704 = ~Le pouvoir... le pouvoir de l'arbre m'a quitté. Tu dois être fier de toi, petit cancrelat, mais c'est ici que s'achève ta misérable existence !~ [IRENIC61] ~Le pouvoir... le pouvoir de l'arbre m'a quitté. Tu dois être fière de toi, petit cancrelat, mais c'est ici que s'achève ta misérable existence !~ [IRENIC61]
@54705 = ~Ton anéantissement me procurera un certain plaisir, vermine. Et alors, je... renouerai le lien, m'unirai avec l'arbre une fois de plus... je trouverai un moyen, oui, ce pouvoir sera mien.~ [IRENIC62]
@54706 = ~Non, Joneleth. Vous n'en ferez rien.~ [ELLESI07]
@54707 = ~Mais... Ellésime ?~ [IRENIC63]
@54708 = ~Oui, c'est moi, votre reine. Par deux fois, vous avez tenté de commettre ce sacrilège et avez mis nos vies en péril. Vous ne recommencerez pas, Joneleth.~ [ELLESI08]
@54709 = ~Ne prononce pas ce nom ! Il m'est inconnu depuis que la Seldarine m'a dépouillé de mon essence elfique, et tu le sais.~ [IRENIC64]
@54710 = ~Et comment dois-je vous appeler ? « Irenicus » ? « Âme damnée » ? « Le Brisé » ? Oui... c'était un terrible châtiment. Mais vous aviez violé tout ce qui nous est cher. Vous avez failli causer notre perte !~ [ELLESI09]
@54711 = ~Et à quelle fin ? Pour le pouvoir ? Est-ce là tout ce qui compte pour vous à présent, Jon ?~ [ELLESI10]
@54712 = ~C'est... c'est tout ce qui me reste, Ellésime. Rien ne m'importe plus que ma vengeance. Pour ce que tu m'as fait, pour ce que la Seldarine m'a pris !~ [IRENIC65]
@54713 = ~Et votre vengeance a envenimé votre cœur. L'arbre vous a touché, il y a bien longtemps. Ne vous en souvenez-vous donc pas ? N'y a-t-il plus de place pour l'amour dans votre cœur ?~ [ELLESI11]
@54714 = ~N'y a-t-il plus rien en vous qui se rappelle notre amour ? Celui que nous partagions avant que vous ne soyez dévoré par cette obsession.~ [ELLESI12]
@54715 = ~Je...~ [IRENIC66]
@54716 = ~Cet amour n'est plus, Ellésime. J'ai essayé de le faire jaillir de ma mémoire. Mais tout s'est étiolé... tout est mort. Mon cœur est vide.~ [IRENIC67]
@54717 = ~Pendant des lustres, je me suis accroché à ce souvenir. Puis... au souvenir de ce souvenir. Mais la Seldarine ne me l'a même pas laissé ! Plus rien !~ [IRENIC68]
@54718 = ~Je pose mon regard sur toi et ne ressens plus rien, ne me souviens de rien. Si ce n'est que tu t'es détournée de moi, comme tous les autres. Je me souviens seulement que tu m'as abandonné.~ [IRENIC69]
@54719 = ~Ma soif de pouvoir s'est étanchée. Aujourd'hui, je n'ai faim que de vengeance. Et... elle S'ACCOMPLIRA !~ [IRENIC70]
@54720 = ~Alors, je vous plains. Si seulement vous aviez profité de ces années pour mériter votre retour dans ce sanctuaire. Au cours de ces années volées de mortel...~ [ELLESI13]
@54721 = ~J'aurais pu vous aimer à nouveau, comme j'aimais l'homme que vous étiez auparavant. Mais je ne le reconnais plus. Vous êtes Irenicus. Seule la mort vous attend à présent.~ [ELLESI14]
@54722 = ~Qui sait, petite chose mortelle. Qui sait...~ [IRENIC71]
@54723 = ~Et la voilà partie pour alerter Elhan et les autres, alors que je suis encore affaibli. Tant pis, je les écraserai tous s'il le faut. J'ai toujours ton pouvoir en ma possession, <CHARNAME>.~
@54724 = ~Ton âme vit encore en moi. Viens, et essaye de me la reprendre, si tu la désires. J'ai encore assez de pouvoirs pour m'occuper de toi !~
@54725 = ~Je... tu m'as tué...~ [IRENIC72]
@54726 = ~Ce n'est... ce n'est pas...~ [IRENIC73]
@54727 = ~Irenicus s'effondre, ses paroles se perdent sur ses lèvres, tandis qu'une mystérieuse quiétude s'empare des lieux. En vous, le doute s'insinue : avez-vous bel et bien vaincu ? En avez-vous vraiment fini avec cette épouvante ?~
@54728 = ~Protégez les œufs !~
@54729 = ~Rhynn Lanthorn~
@54730 = ~Rhynn Lanthorn~
@54731 = ~Vous pouvez remonter à la surface sans crainte. Bonne chance !~ [SILVER10]
@54732 = ~Lentille 1~
@54733 = ~Lentille 1~
@54734 = ~Lentille 2~
@54735 = ~Lentille 2~
@54736 = ~Lentille 3~
@54737 = ~Lentille 3~
@54738 = ~Aaah... ainsi te voilà, enfant de Bhaal. Tu es venu revendiquer ton héritage, n'est-ce pas ? Quelle patience ! Tss, tss, tss, tss, tss, tss, tss... ça doit être terrible de mourir ainsi...~ [HELFEA06] ~Aaah... ainsi te voilà, enfant de Bhaal. Tu es venue revendiquer ton héritage, n'est-ce pas ? Quelle patience ! Tss, tss, tss, tss, tss, tss, tss... ça doit être terrible de mourir ainsi...~ [HELFEA06]
@54739 = ~Bien que vous ayez triomphé, une question vous hante néanmoins : que va-t-il donc advenir de ce qu'il vous a dérobé ? Qu'en est-il de votre âme ?~
@54740 = ~Revendiquer mon héritage ? De quoi parles-tu ?~
@54741 = ~Je ne suis pas mort ! Irenicus est mort et je ne sais comment je l'ai suivi ici.~ ~Je ne suis pas morte ! Irenicus est mort et je ne sais comment je l'ai suivi ici.~
@54742 = ~Que veux-tu dire ? À quel jeu joues-tu ?~
@54743 = ~Si tu continues à me parler sur ce ton, monstre, tu n'en as plus pour longtemps à vivre...~
@54744 = ~Ton héritage, mon enfant. Ceci est le royaume de Bhaal. Tu n'as pas rejoint l'essence de l'ancien Seigneur du Meurtre, n'est-ce pas ? Non... alors ton sang règne en maître, ici.~
@54745 = ~D'où le fait que ton essence ne se soit pas désintégrée pour rejoindre l'ancien Seigneur du Meurtre. Tu es ici dans le royaume de Bhaal... et ton sang règne en maître dans cette partie des Enfers.~
@54746 = ~Au fond de vous, un petit quelque chose vous tiraille, un petit quelque chose qui semble tout droit venu de l'apparition qu'Irenicus a engendrée. La sensation, d'abord légère, ne tarde pas à se faire plus pressante.~
@54747 = ~Je parle de ton âme, enfant du meurtre. Tu es un morceau faisant partie d'un tout, d'où le fait que ton essence n'ait pas encore rejoint celle de Bhaal, et que par conséquent, votre sang règne en maître, ici.~
@54748 = ~Je m'incline devant toi, bien sûr, car tu es un enfant du meurtre, mais ton essence n'a pas rejoint celle du défunt Bhaal. Dans le royaume de ton père... ton sang règne en maître.~ ~Je m'incline devant toi, bien sûr, car tu es une enfant du meurtre, mais ton essence n'a pas rejoint celle du défunt Bhaal. Dans le royaume de ton père... ton sang règne en maître.~
@54749 = ~Limon~
@54750 = ~LIMON : Un monstre gélatineux sans membre apparent. La nature de son toucher acide peut varier, mais il est toujours mortel pour les aventuriers présomptueux.~
@54751 = ~Dieu elfe~
@54752 = ~Dieu elfe~
@54753 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54754 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54755 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54756 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54757 = ~C'est toi qui détient le pouvoir ici... ou plutôt, c'est le sang de Bhaal en toi qui détient le pouvoir. Et cette partie de toi est partagée entre toi et l'autre, le magicien, n'est-ce pas ?~
@54758 = ~Fée~
@54759 = ~FÉE : Le « peuple féérique » sont des créatures de petite taille qui servent généralement le bien. Elles sont souvent représentées sous la forme de minuscules et malicieuses femmes ailées, mais cette apparence n'en est qu'une parmi toutes celles sous lesquelles on les rencontre.~
@54760 = ~Démoniaque/Déchu~
@54761 = ~Il a volé une grande partie de ton âme divine, mais pas toute. Tu es donc attaché au mage comme il l'est à toi. Aucun de vous deux n'est vraiment mort ni vraiment vivant. C'est tout à fait passionnant...~
@54762 = ~DÉMONIAQUE/DÉCHU : Sous cette dénomination sont regroupés divers fiélons des plans inférieurs. Ils sont tous maléfiques et particulièrement puissants, et vous devrez faire preuve d'une grande prudence pour ne pas tomber entre leurs griffes.~
@54763 = ~Comment puis-je mettre un terme à cela, démon ? Me le diras-tu ?~
@54764 = ~Mais tu le sais déjà ! Tu dois partir à la recherche de ton âme en rassemblant les Larmes de Bhaal... et alors le chemin s'ouvrira devant toi.~
@54765 = ~Les Larmes de Bhaal ?~
@54766 = ~Lycanthrope~
@54767 = ~LYCANTHROPE : Le Loup-garou est le plus connu des lycanthropes ; la lycanthropie est une forme de malédiction ou de maladie héréditaire qui voit celui qui en est affligé se transformer en animal, bien que ce terme désigne également les animaux qui se changent en personnes.~
@54768 = ~La mort fait couler bien des larmes, enfant, et Bhaal en a rassemblé beaucoup au cours de sa vie... Les Larmes ouvriront les yeux... et montreront le chemin à ton âme.~
@54769 = ~L'une des larmes repose non loin d'ici, enfant de Bhaal... juste au-delà de l'une de ces deux pièces devant toi.~ [HELFEA02]
@54770 = ~Tyrannœil~
@54771 = ~Combien de fois as-tu ravalé ta peur au cours de ton existence ? Tu as combattu la terreur qui aurait emporté un être moins fort et tu t'es montré courageux.~ [HELFEA10] ~Combien de fois as-tu ravalé ta peur au cours de ton existence ? Tu as combattu la terreur qui aurait emporté un être moins fort et tu t'es montrée courageuse.~ [HELFEA10]
@54772 = ~TYRANNŒIL : Une grosse sphère flottante avec un œil au milieu, une gueule immense et de nombreux autres yeux plus petits qui émergent de cette chose hideuse. Vraiment hors du commun, il en existe de nombreuses sous-espèces, toutes à éviter d'urgence !~
@54773 = ~Passe par l'une de ces pièces, que ton courage soit mis à l'épreuve, enfant de Bhaal.~ [HELFEA11]
@54774 = ~J'ai néanmoins quelque chose à t'offrir qui devrait te rendre la tâche plus aisée, enfant de Bhaal. À l'instar de ceux qui détiennent le pouvoir, tu n'es pas sans savoir que les objets magiques permettent d'accomplir bien des miracles...~ [HELFEA12]
@54775 = ~Flagelleur mental~
@54776 = ~FLAGELLEUR MENTAL : Également connu sous le nom d'illithid, le flagelleur mental est un dévoreur d'intellect qui peuple l'Ombre-Terre. Maléfique par définition, pour lui, vous n'êtes qu'un esclave ou un peu de nourriture, dans le meilleur des cas.~
@54777 = ~... comme cette cape, par exemple, un délicat assemblage de la peau toute fraîche de charmantes nymphes... Porte-la et son pouvoir magique t'apaisera... plus jamais tu ne seras pris de panique.~ [HELFEA13] ~... comme cette cape, par exemple, un délicat assemblage de la peau toute fraîche de charmantes nymphes... Porte-la et son pouvoir magique t'apaisera... plus jamais tu ne seras prise de panique.~ [HELFEA13]
@54778 = ~Grâce à cette cape, tu pourras aisément t'emparer de la larme de Bhaal et n'auras pas à t'inquiéter pour ton courage. Je m'incline devant le pouvoir de ton âme divine, enfant de Bhaal, et te remets cette cape... si tu souhaites la prendre.~ [HELFEA14]
@54779 = ~Vampire~
@54780 = ~VAMPIRE : Un des morts-vivants les plus puissants, qui se nourrit de l'essence vitale des êtres vivants pour accomplir ses desseins tordus. Rares sont les espèces à l'abri du vampirisme.~
@54781 = ~Une cape faite de peau de nymphes ? Je sens d'ici son essence infernale... Je ne la veux pas, quels que soient ses pouvoirs.~
@54782 = ~Otyugh~
@54783 = ~OTYUGH : Ces gigantesques créatures rongées par la maladie au tempérament ombrageux se nourrissent de déchets et de saletés que les autres bêtes des donjons rejettent ou abandonnent. Ceci concerne également les aventuriers dont vous faîtes partie.~
@54784 = ~Je ne sais pas... laisse-moi d'abord voir ce qu'il y a dans ces pièces, et je te dirai ensuite si je la veux.~
@54785 = ~Une cape magique ? Bien sûr que je la veux !~
@54786 = ~Alors, tu as choisi de ne compter que sur ta force et ton courage. Il en sera fait selon tes désirs, enfant de Bhaal.~ [HELFEA15]
@54787 = ~Bien entendu. Je resterai pour te remettre la cape, si tu la veux. Sauf si tu parviens à t'emparer seul de la larme, bien sûr. Je suis là pour t'offrir... mon aide.~ [HELFEA16] ~Bien entendu. Je resterai pour te remettre la cape, si tu la veux. Sauf si tu parviens à t'emparer seule de la larme, bien sûr. Je suis là pour t'offrir... mon aide.~ [HELFEA16]
@54788 = ~Rakshasa~
@54789 = ~RAKSHASA : Ces esprits maléfiques pourchassent et tourmentent les humains. Ils ne vivent que pour combattre et sont passés maîtres dans l'art de l'illusion, ce qui les rend extrêmement dangereux.~
@54790 = ~Ton courage puisera donc dans le pouvoir de l'objet magique que tu portes. Il en sera fait selon tes désirs, enfant de Bhaal. La voici... la larme se trouve un peu plus loin.~ [HELFEA17]
@54791 = ~Troll~
@54792 = ~Tu es venu jeter un autre coup d'œil, enfant de Bhaal ? C'est une bien belle cape, n'est-ce pas ? Faite de la peau de charmantes nymphes, et si imprégnée de magie qu'elle calme même les cœurs les plus paniqués... La veux-tu ?~ [HELFEA07] ~Tu es venue jeter un autre coup d'œil, enfant de Bhaal ? C'est une bien belle cape, n'est-ce pas ? Faite de la peau de charmantes nymphes, et si imprégnée de magie qu'elle calme même les cœurs les plus paniqués... La veux-tu ?~ [HELFEA07]
@54793 = ~TROLL : De terribles carnivores, connus pour être quasiment impossibles à tuer. Tous les trolls régénèrent et seul le feu ou l'acide semblent pouvoir en venir à bout.~
@54794 = ~Non. Elle est faite de peau de nymphe et je sens qu'elle est envoûtée. Je n'en ai pas besoin.~
@54795 = ~Je ne sais pas ; attends-moi ici pendant que je réfléchis.~
@54796 = ~Ombre des roches~
@54797 = ~Oui, si elle a les pouvoirs que tu lui confères, je la veux.~
@54798 = ~OMBRE DES ROCHES : Ces créatures souterraines sont dotées d'une force peu commune. Elles sont très lentes mais un simple regard de leur part suffit généralement à semer la confusion dans l'esprit de la future victime.~
@54799 = ~Je n'ai pas besoin d'une cape pour me donner du courage. Reprends ton cadeau et va-t'en.~
@54800 = ~Je n'ai pas besoin d'une cape pour me donner du courage, démon. Garde-la et va-t'en.~
@54801 = ~Ta bravoure est souillée par ta stupidité, mais n'en reste pas moins une sorte de courage... Je m'incline devant ta force toute-puissante, enfant de Bhaal, et ne me battrais plus. Je ne t'importunerai pas davantage.~ [HELFEA08]
@54802 = ~Sahuagin~
@54803 = ~SAHUAGIN : Ces hommes-poissons sont de terribles prédateurs, qui hantent généralement les eaux tempérées près des côtes. Ils sont très bien organisés et adorent effectuer des raids sur les villages de pêcheurs, en quête de nourriture et d'amusement.~
@54804 = ~Ombre~
@54805 = ~OMBRE : Les ombres sont de terribles morts-vivants qui absorbent la force de leur victime d'un simple toucher. Un contact prolongé peut éventuellement mener à une transformation en ombre.~
@54806 = ~Kuo-toa~
@54807 = ~KUO-TOA : Une race ancienne d'hommes-poissons vivant sous la surface et qui abhorre les habitants de la surface autant qu'elle craint la lumière du jour. Les dérangements mentaux sont courants parmi cette espèce.~
@54808 = ~Méphite~
@54809 = ~MÉPHITE : Les méphites sont de petits messagers créés par les monstres des plans inférieurs ; ils sont naturellement mauvais et malveillants. Six types de méphites ont été recensés à ce jour : flamboyant, glacé, magmatique, brumeux, vaporeux et aérien.~
@54810 = ~Diablotin~
@54811 = ~DIABLOTIN : Les diablotins sont de petites créatures maléfiques qui servent parfois de familier à des sorciers d'alignement mauvais. Seules les armes magiques ou en argent peuvent les blesser, de plus ils peuvent se régénérer.~
@54812 = ~Golem~
@54813 = ~GOLEM : « Golem » est un terme qui regroupe plusieurs types de créatures artificielles de nature magique. La plupart sont humanoïdes, même si certains peuvent atteindre des tailles impressionnantes. La plupart ne peuvent être détruits que par magie.~
@54814 = ~Élémentaire~
@54815 = ~ÉLÉMENTAIRE : Les élémentaires sont des êtres issus de l'un des quatre éléments du plan matériel : air, terre, feu et eau.~
@54816 = ~Dragon~
@54817 = ~DRAGON : Les dragons sont des créatures ailées très anciennes d'origine reptilienne. Leur taille, leur puissance physique et leurs talents de magicien sont autant de bonnes raisons de les craindre. Les dragons les plus anciens sont sans doute les créatures les plus puissantes de ce monde. Les dragons chromatiques sont généralement d'alignement mauvais, et les dragons métalliques ont plutôt tendance à être d'alignement bon.~
@54818 = ~Génie~
@54819 = ~GÉNIE : Les génies sont originaires du Plan élémentaire, mais peuvent parfois être présents sur le Plan matériel. Ils sont parfois invoqués par de puissants mages ou prêtres requérant un service. Face à cette situation indigne, la réaction du génie varie selon son type...~
@54820 = ~Liche~
@54821 = ~LICHE : La liche est sans doute le plus puissant des morts-vivants ; elles sont d'ailleurs quasiment impossible à détruire. Chaque liche fut autrefois un puissant magicien, et elle conserve son esprit séparément, à l'abri de son corps physique. Il ne sert donc à rien de détruire le corps de la liche tant que l'on n'est pas en possession de son esprit.~
@54822 = ~En quelques secondes, le souffle vous manque, une force irrésistible vous attire vers le lieu où Irenicus est tombé. Car vous demeurez en contact avec l'âme qu'on vous a dérobée, mais désormais, cette âme n'appartient plus à l'univers des vivants.~
@54823 = ~Libérée dans l'au-delà, votre âme ne vous est pas rendue. Au contraire : elle s'éloigne toujours davantage du monde des mortels et vous entraîne dans son sillage.~
@54824 = ~*des têtards infectés nagent dans ce bassin... si vous le souhaitez, vous pouvez en prendre quelques-uns*~
@54825 = ~*vous prenez les têtards infectés*~
@54826 = ~*des têtards sains nagent dans ce bassin... ces têtards sont source de vitalité pour les kuo-toas adultes*~
@54827 = ~*vous pouvez contaminer le bassin en y ajoutant les têtards infectés*~
@54828 = ~*vous y placez les têtards infectés... qui contaminent aussitôt les têtards kuo-toas sains du bassin*~
@54829 = ~*le sacrifice a été accompli*~
@54830 = ~*pour libérer les cinq et recevoir votre récompense, placez un sacrifice devant Démogorgon*~
@54831 = ~Garde elfe~
@54832 = ~Garde elfe~
@54833 = ~Aaah. Alors l'enfant de Bhaal paraît enfin devant moi pour la dernière larme. Tu touches presque au but, oui, en effet.~ [HELFEA09]
@54834 = ~De quoi parles-tu ? Je n'ai fait que traverser une série d'épreuves bizarres !~
@54835 = ~Je suppose que tu vas me dire qu'Irenicus a attendu pendant tout ce temps derrière cette étrange porte ?~
@54836 = ~Ce que tu dis n'a pas de sens. Explique-toi ou meurs, démon.~
@54837 = ~Des épreuves ? En quelque sorte... Rappelle-toi que le mage détient également le pouvoir ici, mais ne veut pas que tu le trouves. Ces épreuves ne sont surgies que de ta propre imagination et de tes propres pouvoirs.~
@54838 = ~Bien sûr que non. Il se déplace rapidement, mais tu t'en approches aussi rapidement. Ces épreuves que tu t'es imposées sont malignes, ô jeune Seigneur du Meurtre. Tes pouvoirs sont immenses.~ ~Bien sûr que non. Il se déplace rapidement, mais tu t'en approches aussi rapidement. Ces épreuves que tu t'es imposées sont malignes, ô jeune Reine du Meurtre. Tes pouvoirs sont immenses.~
@54839 = ~Ta proie se déplace rapidement, mais les épreuves que tu as traversées t'aideront à t'en approcher. Tes pouvoirs sont immenses ici, malgré la résistance du mage.~
@54840 = ~Que veux-tu dire ?~
@54841 = ~Que veux-tu dire ?~
@54842 = ~Que veux-tu dire ?~
@54843 = ~Comment trouve-t-on son âme, enfant de Bhaal ? Crois-tu qu'une âme se gagne facilement ? Non, tu dois d'abord te connaître toi-même, jusqu'au plus profond de tes passions et de tes vices.~
@54844 = ~Tu apprends à connaître tes capacités... et cela ouvrira le chemin de ton âme. C'est toi-même, ton essence, que tu cherches... que tu en sois conscient ou pas.~ ~Tu apprends à connaître tes capacités... et cela ouvrira le chemin de ton âme. C'est toi-même, ton essence, que tu cherches... que tu en sois consciente ou pas.~
@54845 = ~Et parce que c'est cela que tu cherches, tes pouvoirs luttent contre ceux du mage et t'aident à t'approcher de ton but. Tu ouvriras bientôt les yeux sur les Larmes de Bhaal.~
@54846 = ~Et que ferai-je alors ? La porte sera ouverte et Irenicus m'attendra ?~
@54847 = ~Arrière, elfe noir ! Retourne aux profondeurs que tu appelles ton foyer ! Je n'admettrai pas de créatures telles que toi parmi les arbres de Suldanessalar !~
@54848 = ~Nous allons vous refouler, noires créatures ! Nous ne saurons tolérer vos manières d'Ombre-Terre !~
@54849 = ~Le chemin de ton âme te sera révélé, mais tu ne le percevras que sous la forme d'une porte. Quel dommage que les âmes mortelles ne soient pas capables d'appréhender tous les pouvoirs dont elles sont capables...~
@54850 = ~J'espère que tu as été prudent, enfant de Bhaal. Les Neuf Enfers sont un lieu de châtiment. Les Larmes sont à la fois douloureuses et apaisantes.~ ~J'espère que tu as été prudente, enfant de Bhaal. Les Neuf Enfers sont un lieu de châtiment. Les Larmes sont à la fois douloureuses et apaisantes.~
@54851 = ~Pourquoi parles-tu de façon aussi énigmatique ? Que cela signifie-t-il ?~
@54852 = ~~
@54853 = ~Je voile la vérité de mystère parce que mon essence me l'impose, ô Seigneur du Meurtre. Mais je m'incline devant ton autorité et réponds malgré tout à tes questions.~ ~Je voile la vérité de mystère parce que mon essence me l'impose, ô Reine du Meurtre. Mais je m'incline devant ton autorité et réponds malgré tout à tes questions.~
@54854 = ~Vous allez rejoindre les ténèbres, pauvre fou !~ ~Vous allez rejoindre les ténèbres, pauvre folle !~
@54855 = ~Ah ! Tu vas goûter à mon acier, démon ! Hé, <CHARNAME> ! Dépêchons-nous d'en finir !~
@54856 = ~~
@54857 = ~Aaaah... ainssssi te voilà, enfant de Bhaal. Tu es venu revendiquer ton héritage, n'est-cccce pas ? Quelle patiencccce ! Sssssssss, ssssss. Ççççça doit être terrible de mourir ainssssi.~ [HELGRE06] ~Aaaah... ainssssi te voilà, enfant de Bhaal. Tu es venue revendiquer ton héritage, n'est-cccce pas ? Quelle patiencccce ! Sssssssss, ssssss. Ççççça doit être terrible de mourir ainssssi.~ [HELGRE06]
@54858 = ~Revendiquer mon héritage ? De quoi parles-tu ?~
@54859 = ~Ceccccci est le royaume de Bhaal. Ton esssssence n'as pas rejoint ccccelle de l'ancccccien Sssseigneur du Meurtre, n'est-cccce pas ? Non... alors ton sssang règne en maître icccci.~
@54860 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54861 = ~Tu as le pouvoir icccci... ou plutôt, la partie de Bhaal qui est en toi a le pouvoir. Et ccccette partie ressste désssormais partagée en toi et en l'autre, le sssssorcier, n'est-ccce pas ?~
@54862 = ~Il a pris une grande partie de ton âme, mais pas tout. Ssssss. Tu es lié à lui, comme il l'est à toi. Aucun de vous n'est mort, mais aucun n'est vivant. Intéressssant.~ ~Il a pris une grande partie de ton âme, mais pas tout. Ssssss. Tu es liée à lui, comme il l'est à toi. Aucun de vous n'est mort, mais aucun n'est vivant. Intéressssant.~
@54863 = ~Comment puis-je mettre un terme à cela, démon ? Me le diras-tu ?~
@54864 = ~Mais tu le ssssais déjà ! Tu dois trouver ton âme en amassssant les Larmes de Bhaal... alors sssseulement la voie sssss'ouvrira pour toi.~
@54865 = ~Les Larmes de Bhaal ?~
@54866 = ~La mort fait couler moult larmes, enfant, et Bhaal les collectionnait de ssson vivant. Les larmes ouvriront les yeux... et montreront la voie à ton âme. Ssssss.~
@54867 = ~Arkanis ! Cette chose m'a mordu ! Au secours !~
@54868 = ~Vous êtes à moi, voleur. Rejoignez votre maîtresse plus bas, nous avons encore besoin de vous.~
@54869 = ~<CHARNAME>, vous êtes en retard. Nous avons commencé sans vous !~
@54870 = ~J'en attendais plus de la part de vampires. J'ai à peine mouillé ma chemise.~
@54871 = ~Cela m'a mis en appétit, Drizzt. Si nous prenions une collation, après ça ?~
@54872 = ~C'est toujours pareil avec vous, Ventre-à-Pattes !~
@54873 = ~<CHARNAME> et moi nous occuperons du reste. Merci à vous, mes amis. Nous nous retrouverons au cimetière quand j'en aurai fini avec cette tâche.~
@54874 = ~C'est toujours vous qui avez la partie la plus amusante, elfe.~
@54875 = ~*une fois le dernier des vampires de Bodhi mort, la porte de son antre s'ouvre et l'odeur rance de la mort se fait sentir au bas des escaliers*~
@54876 = ~Mes chevaliers, vous pouvez retourner aux quartiers de l'Ordre. <CHARNAME> et moi-même allons nous occuper de Bodhi.~
@54877 = ~Beau travail, chers voleurs ! Vous pouvez disposer. Je continue avec <CHARNAME>, nous nous occuperons de Bodhi.~
@54878 = ~Morceau de lentille~
@54879 = ~Morceau de lentille~
@54880 = ~Je ne suis pas mort ! Irenicus est mort et je ne sais comment je l'ai suivi ici.~ ~Je ne suis pas morte ! Irenicus est mort et je ne sais comment je l'ai suivi ici.~
@54881 = ~Et donc, ton esssssence n'a pas encore rejoint ccccelle du défunt Ssssseigneur du Meurtre. Cecccci est le royaume de Bhaal, et ton ssssang règne en maître dans ccccette partie des Enfers.~
@54882 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54883 = ~Que veux-tu dire ? À quel jeu joues-tu ?~
@54884 = ~Je parle de ton âme, enfant du meurtre. Tu es un morccccceau faissssant partie d'un tout, ton esssssence n'a pas rejoint ccccelle du défunt Bhaal. Par consssséquent, ton ssssang règne en maître iccci.~
@54885 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54886 = ~Si tu continues à me parler sur ce ton, monstre, tu n'en as plus pour longtemps à vivre...~
@54887 = ~Je m'incline devant toi, bien sssssûr. Tu es un enfant du meurtre dont l'essssence n'a pas rejoint ccccelle du défunt Bhaal. Dans le royaume de ton père, ton ssssang règne en maître.~ ~Je m'incline devant toi, bien sssssûr. Tu es une enfant du meurtre dont l'essssence n'a pas rejoint ccccelle du défunt Bhaal. Dans le royaume de ton père, ton ssssang règne en maître.~
@54888 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54889 = ~Muloup~
@54890 = ~Lanfear~
@54891 = ~Lanfear~
@54892 = ~ENTROPISTE : La magie entropique est un nouveau type de magie caractérisé par de puissants et dangereux sursauts de magie imprévisible appelés « hiatus entropiques ». Considérée généralement comme une conséquence malheureuse du Temps des Troubles, la magie entropique attire depuis récemment l'attention de nombreux mages curieux ou érudits.

Les entropistes sont des mages qui se spécialisent dans l'étude de la magie entropique. Ils ont accès à des sorts leur permettant de se protéger de la magie entropique et de la façonner selon leur volonté. La magie entropique est extrêmement imprévisible et doit être utilisée avec prudence.

CAPACITÉS :

- Peut mémoriser un sort profane supplémentaire par niveau d'expérience.
- Peut lancer le sort profane de 1er niveau : « Rupture hasardeuse de Nahal » (déjà retranscrit dans le livre de sorts profanes).
- Peut lancer le sort profane de 2ème niveau : « Bouclier du chaos » (déjà retranscrit dans le livre de sorts profanes).
- Peut lancer le sort profane de 7ème niveau : « Bouclier majeur du chaos » (déjà retranscrit dans le livre de sorts profanes).
- Chaque fois qu'il lance un sort, il y a 5 % de chances d'engendrer un hiatus entropique.

HIATUS ENTROPIQUE : Un hiatus entropique génère un effet complètement aléatoire à la place des effets du sort initialement lancé. Cet effet peut tout aussi bien être préjudiciable que bénéfique à l'entropiste et à ses alliés.

- Lorsque l'entropiste lance un sort, le niveau d'expérience auquel le sort est lancé varie entre +5 et -5 par rapport au véritable niveau d'expérience de l'entropiste.~
@54893 = ~Entropiste~
@54894 = ~Entropiste~
@54895 = ~Problème animalier à Franc-Marché

J'ai accepté d'aller au secours de Franc-Marché, située au sud-est d'Athkatla. La ville subit des attaques d'animaux sauvages, et les druides locaux sont soupçonnés. Le Haut Marchand, le Seigneur Logan Coprith, a peut-être des informations pour moi.~
@54896 = ~Aaah. Ainsssi l'enfant de Bhaal est venu à moi, finalement, pour la dernière des larmes. Tu n'es plus loin de ton but... non, plus très loin. Sssssss.~ [HELGRE07] ~Aaah. Ainsssi l'enfant de Bhaal est venue à moi, finalement, pour la dernière des larmes. Tu n'es plus loin de ton but... non, plus très loin. Sssssss.~ [HELGRE07]
@54897 = ~De quoi parles-tu ? Je n'ai fait que traverser une série d'épreuves bizarres !~
@54898 = ~Des épreuves ? En quelque sssorte. N'oublie pas que le mage a ausssssi des pouvoirs iccccci, et il veut t'empêcher de le trouver. Les épreuves sssssont de toi, car tu as le pouvoir icccci.~
@54899 = ~Que veux-tu dire ?~
@54900 = ~Comment trouve-t-on sssson âme, enfant de Bhaal ? Tu dois bien te connaître, des profondeurs de ta passssssion aux sssssommets de ta dépravation.~
@54901 = ~Tu dois ssssavoir de quoi tu es capable... ainssssi sss'ouvrira la voie pour trouver ton âme. Tu te cherches toi-même, ton essssence... que tu le sssaches ou non.~
@54902 = ~Et à cause de cccce que tu cherches, tes pouvoirs affrontent ccccceux du mage pour que tu puisssses atteindre ton but. Bientôt tu ouvriras les yeux avec les Larmes de Bhaal. Sssss.~
@54903 = ~Et que ferai-je alors ? La porte sera ouverte et Irenicus m'attendra ?~
@54904 = ~Tu dois voir la voie menant à ton âme, mais la porte n'est que dans ta perccccception. Un essssssprit mortel peut atteindre icccci plus de pouvoir qu'il ne peut comprendre. Sss.~
@54905 = ~J'essspère que tu as fait preuve de prudencccce, enfant de Bhaal. Les Neuf Enfers sssssont un lieu de châtiment... les Larmes irritent aussssi facccccilement qu'elles apaisssent.~
@54906 = ~Pourquoi parles-tu de façon aussi énigmatique ? Que cela signifie-t-il ?~
@54907 = ~J'obssscurcis la vérité car ccccela est dans ma nature, ô Sssseigneur du Meurtre. Mais je m'incline iccccci devant ton autorité, et réponds néanmoins à tes quessstions.~ ~J'obssscurcis la vérité car ccccela est dans ma nature, ô Reine du Meurtre. Mais je m'incline iccccci devant ton autorité, et réponds néanmoins à tes quessstions.~
@54908 = ~Je suppose que tu vas me dire qu'Irenicus a attendu pendant tout ce temps derrière cette étrange porte ?~
@54909 = ~Bien ssssûr que non. Il est rapide, mais tu l'es plusss encore. Ccccces épreuves que tu t'infliges sont malignes, jeune Sssseigneur du Meurtre. Ton pouvoir iccccci est grand.~ ~Bien ssssûr que non. Il est rapide, mais tu l'es plusss encore. Ccccces épreuves que tu t'infliges sont malignes, jeune Reine du Meurtre. Ton pouvoir iccccci est grand.~
@54910 = ~Que veux-tu dire ?~
@54911 = ~Ce que tu dis n'a pas de sens. Explique-toi ou meurs, démon.~
@54912 = ~Ta proie est rapide, mais les épreuves que tu as imaginées te rapprochent encore plussss d'elle. Ssss. Ton pouvoir est grand iccccci, malgré la résissstance du mage.~
@54913 = ~Que veux-tu dire ?~
@54914 = ~Aaaah... ainsi te voilà, enfant de Bhaal. Tu es venu revendiquer ton héritage, n'est-ce pas ? Quelle patience ! Tss, tss, tss, tss... Cela doit être terrible de mourir ainsi.~ [HELPRI06] ~Aaaah... ainsi te voilà, enfant de Bhaal. Tu es venue revendiquer ton héritage, n'est-ce pas ? Quelle patience ! Tss, tss, tss, tss... Cela doit être terrible de mourir ainsi.~ [HELPRI06]
@54915 = ~Revendiquer mon héritage ? De quoi parles-tu ?~
@54916 = ~Ton héritage, mon enfant. Ceci est le royaume de Bhaal. Tu n'as pas rejoint l'essence de l'ancien Seigneur du Meurtre, n'est-ce pas ? Non... alors ton sang règne en maître, ici.~
@54917 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54918 = ~Tu as le pouvoir ici... ou plutôt, la partie de Bhaal qui est en toi a le pouvoir. Et cette partie reste désormais en toi et en l'autre, le sorcier ?~
@54919 = ~Il a volé presque toute ton âme divine, mais pas tout, vous êtes donc liés. Aucun n'est vraiment mort, aucun n'est vraiment vivant. Ah, c'est très intéressant, vraiment.~
@54920 = ~Comment puis-je mettre un terme à cela, démon ? Me le diras-tu ?~
@54921 = ~Mais tu le sais déjà ! Tu dois partir à la recherche de ton âme en rassemblant les Larmes de Bhaal... et alors le chemin s'ouvrira devant toi.~
@54922 = ~Les Larmes de Bhaal ?~
@54923 = ~La mort fait couler bien des larmes, enfant, et Bhaal en a rassemblé beaucoup au cours de sa vie... Les Larmes ouvriront les yeux... et montreront le chemin à ton âme.~
@54924 = ~Problème animalier à Franc-Marché : aucun intérêt

Flydian, aux portes de la ville, cherchait de l'aide. La ville de Franc-Marché est assiégée par des animaux et des druides sont soupçonnés. Je lui ai dit que je n'étais pas intéressé pour le moment.~ ~Problème animalier à Franc-Marché : aucun intérêt

Flydian, aux portes de la ville, cherchait de l'aide. La ville de Franc-Marché est assiégée par des animaux et des druides sont soupçonnés. Je lui ai dit que je n'étais pas intéressée pour le moment.~
@54925 = ~Problème animalier à Franc-Marché : rencontre avec la milice

La capitaine de la milice de Franc-Marché est soulagée que j'aie accepté d'essayer de stopper les attaques d'animaux. Elle m'a dirigé vers le Haut Marchand, le Seigneur Logan Coprith. Elle m'a mis en garde : les habitants sont très effrayés, et très suspicieux à l'égard des étrangers, spécialement des druides.~ ~Problème animalier à Franc-Marché : rencontre avec la milice

La capitaine de la milice de Franc-Marché est soulagée que j'aie accepté d'essayer de stopper les attaques d'animaux. Elle m'a dirigé vers le Haut Marchand, le Seigneur Logan Coprith. Elle m'a mise en garde : les habitants sont très effrayés, et très suspicieux à l'égard des étrangers, spécialement des druides.~
@54926 = ~Problème animalier à Franc-Marché : violence inutile

J'ai dû me battre avec la capitaine de la milice de Franc-Marché. Je ne connais rien de la nature des attaques que subit la ville, ni si leurs soupçons à l'égard des druides sont fondés, mais ce combat n'arrangera certainement pas les choses !~
@54927 = ~Problème animalier à Franc-Marché : aucun intérêt

La capitaine de la milice de Franc-Marché dit que la ville subit les assauts répétés d'animaux. Les druides locaux sont soupçonnés. J'ai dit que je n'étais pas intéressé. Elle m'a suggéré de partir.~ ~Problème animalier à Franc-Marché : aucun intérêt

La capitaine de la milice de Franc-Marché dit que la ville subit les assauts répétés d'animaux. Les druides locaux sont soupçonnés. J'ai dit que je n'étais pas intéressée. Elle m'a suggéré de partir.~
@54928 = ~Problèmes à Franc-Marché ?

La capitaine de la milice de Franc-Marché était plutôt agressive. Apparemment, quelque chose a rendu les habitants de la ville très suspicieux envers les étrangers.~
@54929 = ~Problème animalier à Franc-Marché : refus exprimé au Seigneur Logan

Le Haut Marchand, le Seigneur Logan Coprith, dit que Franc-Marché est sous le siège d'animaux sauvages et que la populace soupçonne les druides d'être responsables de l'organisation de ces attaques. Un druide du nom de Cernd a été capturé, mais le Seigneur Logan pense qu'il est innocent. Il m'a demandé de parler à Cernd, ou de l'escorter en dehors de la ville. J'ai refusé.~
@54930 = ~Problème animalier à Franc-Marché : demande d'escorte

Le Haut Marchand, le Seigneur Logan Coprith, dit que Franc-Marché est sous le siège d'animaux sauvages et que la populace soupçonne les druides d'être responsables de l'organisation de ces attaques. Un druide du nom de Cernd a été capturé, mais le Seigneur Logan pense qu'il est innocent. Je dois l'escorter en dehors de la ville ou, au moins, lui parler. Cernd est dans la prison municipale, située au sous-sol de la maison du maire.~
@54931 = ~<CHARNAME> peut désormais devenir l'Écorcheur à volonté.~
@54932 = ~*Bodhi s'écroule devant vous, son corps n'étant plus qu'une coquille vide une fois que l'âme volée en son sein est libérée... une sorte d'apparition faible se manifeste, puis... plus rien... sa mort provoque l'ouverture d'une trappe à l'intérieur de son cercueil... le Rhynn Lanthorn est dedans*~
@54933 = ~L'Écorcheur draine la force du groupe.~
@54934 = ~Terreur de l'Écorcheur~
@54935 = ~Problème animalier à Franc-Marché : victoire sans le savoir

J'ai sauvé Franc-Marché sans le savoir. Depuis la mort de Faldorn, les attaques d'animaux ont cessé. Un druide du nom de Cernd reste prisonnier, mais le Seigneur Logan Coprith m'a demandé de lui dire qu'il était libre. Peut-être se joindra-t-il à mon groupe.~
@54936 = ~Problème animalier à Franc-Marché : victoire sans le savoir

J'ai sauvé Franc-Marché sans le savoir. Depuis la mort de Faldorn, les attaques d'animaux ont cessé. Un druide du nom de Cernd reste prisonnier, mais comme j'ai refusé de lui parler, le Seigneur Logan Coprith a ordonné sa relâche. Cela m'est égal, même si Logan a déclaré que ce Cernd aimait beaucoup voyager...~
@54937 = ~Je ne suis pas mort ! Irenicus est mort et je ne sais comment je l'ai suivi ici.~ ~Je ne suis pas morte ! Irenicus est mort et je ne sais comment je l'ai suivi ici.~
@54938 = ~D'où le fait que ton essence ne se soit pas désintégrée pour rejoindre l'ancien Seigneur du Meurtre. Tu es ici dans le royaume de Bhaal... et ton sang règne en maître dans cette partie des Enfers.~
@54939 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54940 = ~Que veux-tu dire ? À quel jeu joues-tu ?~
@54941 = ~Je parle de ton âme, enfant du meurtre. Tu es un morceau faisant partie d'un tout, et ton essence n'a pas disparu pour rejoindre celle de Bhaal. Par conséquent, ton sang règne en maître, ici.~
@54942 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54943 = ~Si tu continues à me parler sur ce ton, monstre, tu n'en as plus pour longtemps à vivre...~
@54944 = ~Je m'incline devant toi, bien sûr. Tu es un enfant du meurtre dont l'essence n'a pas rejoint celle du défunt Bhaal. Dans le royaume de ton père, ton sang règne en maître.~ ~Je m'incline devant toi, bien sûr. Tu es une enfant du meurtre dont l'essence n'a pas rejoint celle du défunt Bhaal. Dans le royaume de ton père, ton sang règne en maître.~
@54945 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54946 = ~Problème animalier à Franc-Marché : alliance avec Cernd

Cernd s'est joint à moi. Il craint que les attaques sur Franc-Marché soient liées à un cercle de druides qui a cessé toute communication avec le reste de sa hiérarchie. Il a peur que la situation ne dégénère en guerre ouverte entre la ville et les forces de la nature. Nous devons nous rendre au bosquet des druides au sud de Franc-Marché pour enquêter.~
@54947 = ~Problème animalier à Franc-Marché : alliance avec Cernd

Cernd et moi nous sommes alliés pour enquêter sur les étranges événements qui se produisent au bosquet des druides, au sud de Franc-Marché. Il craint que ces druides aient dû faire face à un changement malheureux de commandement, ce qui serait à l'origine des troubles. Il dit qu'il est dans mon intérêt de l'aider, car tout druide doit un jour se rendre au bosquet pour mettre son titre et son statut à l'épreuve.~
@54948 = ~Problème animalier à Franc-Marché : j'ai dit à Cernd que je l'aiderai

Cernd pense que les événements de Franc-Marché peuvent être liés à la perte de contact entre le groupe de druides locaux et leur hiérarchie. Il dit qu'il faudrait que j'enquête, mais je ne veux pas de lui dans mon groupe. Je le retrouverai au bosquet et nous aviserons.~
@54949 = ~Problème animalier à Franc-Marché : enquête dans le bosquet

Cernd m'a envoyé enquêter sur les druides du bosquet au sud de Franc-Marché. Si je veux vraiment l'aider, je dois lui rapporter toutes les informations que je pourrais glaner.~
@54950 = ~Problème animalier à Franc-Marché : trahison de Jaheira

J'ai refusé d'enquêter à la demande de Cernd sur les agissements des druides près de Franc-Marché. Jaheira n'a pas été d'accord avec ma décision et m'a attaqué. Quelle pitié.~ ~Problème animalier à Franc-Marché : trahison de Jaheira

J'ai refusé d'enquêter à la demande de Cernd sur les agissements des druides près de Franc-Marché. Jaheira n'a pas été d'accord avec ma décision et m'a attaquée. Quelle pitié.~
@54951 = ~Problème animalier à Franc-Marché : j'ai refusé, mais il patientera

J'ai refusé d'apporter mon aide à Cernd. Il dit qu'il attendra ici jusqu'à ce que je change d'avis. Il a ajouté que tous les druides doivent un jour ou l'autre aller au bosquet pour défendre ou acquérir leur statut. Cela pourrait concerner Jaheira.~
@54952 = ~Problème animalier à Franc-Marché : alliance pour enquêter

Cernd a rejoint mon groupe pour enquêter sur les druides de Franc-Marché. Il a suggéré que nous les interrogions, car la plupart le reconnaîtront et nous donneront des informations.~
@54953 = ~Aaah. Ainsi, l'enfant de Bhaal est venu à moi, finalement, pour la dernière des larmes. Tu n'es plus loin de ton but... non, plus très loin.~ [HELPRI07] ~Aaah. Ainsi, l'enfant de Bhaal est venue à moi, finalement, pour la dernière des larmes. Tu n'es plus loin de ton but... non, plus très loin.~ [HELPRI07]
@54954 = ~De quoi parles-tu ? Je n'ai fait que traverser une série d'épreuves bizarres !~
@54955 = ~Des épreuves ? En quelque sorte. N'oublie pas que le mage a aussi des pouvoirs ici, et il veut t'empêcher de le trouver. Les épreuves sont ta création, issues de ton propre pouvoir.~
@54956 = ~Que veux-tu dire ?~
@54957 = ~Comment trouve-t-on son âme, enfant de Bhaal ? Crois-tu qu'une âme se gagne facilement ? Non, tu dois d'abord te connaître toi-même, jusqu'au plus profond de tes passions et de tes vices.~
@54958 = ~Tu dois savoir de quoi tu es capable... ainsi s'ouvrira la voie pour trouver ton âme. Tu te cherches toi-même, ton essence... que tu le saches ou non.~
@54959 = ~Et à cause de ce que tu cherches, tes pouvoirs combattent ceux du mage et te rapprochent de ton but. Bientôt tu ouvriras les yeux avec les Larmes de Bhaal.~
@54960 = ~Et que ferai-je alors ? La porte sera ouverte et Irenicus m'attendra ?~
@54961 = ~Le chemin de ton âme te sera révélé, mais tu ne le percevras que sous la forme d'une porte. Quel dommage que les âmes mortelles ne soient pas capables d'appréhender tous les pouvoirs dont elles sont capables...~
@54962 = ~J'espère que tu as été prudent, enfant de Bhaal. Les Neuf Enfers sont un lieu de châtiment. Les Larmes sont à la fois douloureuses et apaisantes.~ ~J'espère que tu as été prudente, enfant de Bhaal. Les Neuf Enfers sont un lieu de châtiment. Les Larmes sont à la fois douloureuses et apaisantes.~
@54963 = ~Pourquoi parles-tu de façon aussi mystérieuse ? Que cela signifie-t-il ?~
@54964 = ~Je voile la vérité de mystère parce que mon essence me l'impose, ô Seigneur du Meurtre. Mais je m'incline devant ton autorité et réponds malgré tout à tes questions.~ ~Je voile la vérité de mystère parce que mon essence me l'impose, ô Reine du Meurtre. Mais je m'incline devant ton autorité et réponds malgré tout à tes questions.~
@54965 = ~Je suppose que tu vas me dire qu'Irenicus a attendu pendant tout ce temps derrière cette étrange porte ?~
@54966 = ~Bien sûr que non. Il est rapide, mais tu t'approches très vite de lui. Tes épreuves sont malices, ô jeune Seigneur du Meurtre. Ton pouvoir est grand ici.~ ~Bien sûr que non. Il est rapide, mais tu t'approches très vite de lui. Tes épreuves sont malices, ô jeune Reine du Meurtre. Ton pouvoir est grand ici.~
@54967 = ~Que veux-tu dire ?~
@54968 = ~Ce que tu dis n'a pas de sens. Explique-toi ou meurs, démon.~
@54969 = ~Ta proie est rapide, mais tes épreuves te rapprochent encore plus près d'elle. Ton pouvoir est grand ici, malgré sa résistance.~
@54970 = ~Que veux-tu dire ?~
@54971 = ~~
@54972 = ~~
@54973 = ~~
@54974 = ~Tu nous as enfin rejoints, pour réclamer ton héritage comme j'ai tenté de le faire. Dommage que tu arrives en morceaux, faible et pathétique. Ma mort fut bien plus définitive que la tienne.~
@54975 = ~Réclamer mon héritage ? De quoi parles-tu ?~
@54976 = ~*renâcle* Tu l'ignores ? Ceci est le royaume de Bhaal, et puisque ton essence n'a pas rejoint celle de notre défunt père, tu es toujours partiellement en vie et ton sang règne en maître ici.~
@54977 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54978 = ~Ton âme est souillée par ton père, imbécile, et c'est cette partie qui règne sur ce royaume. Mais tu partages ton âme avec un autre, n'est-ce pas ?~
@54979 = ~Le mage a volé presque toute ton âme, mais pas tout. Vous êtes liés et il t'a attiré vers lui en l'enfer. Aucun de vous deux n'est vraiment vivant, ni vraiment mort.~
@54980 = ~Irenicus ? Tu sais où il est ?~
@54981 = ~Bah ! N'as-tu pas écouté ? Tu as le POUVOIR ici. Déjà tu cherches, et déjà le mage te barre la route. Les Larmes de Bhaal sont ta seule alternative.~
@54982 = ~Les Larmes de Bhaal ?~
@54983 = ~Une larme pour chaque âme assassinée, chaque tourment infligé par notre père. Il les a toutes gardées. Elles pourront te montrer le chemin qui mène à ton mage... si tu les trouves toutes.~
@54984 = ~Je ne suis pas mort ! Irenicus est mort, et je l'ai suivi ici, mais je ne sais comment.~ ~Je ne suis pas morte ! Irenicus est mort, et je l'ai suivie ici, mais je ne sais comment.~
@54985 = ~Et donc ton essence n'a pas rejoint celle de notre défunt père, imbécile. Une part de toi est vivante... et comme nous sommes au royaume de Bhaal, ton sang règne en maître ici.~
@54986 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54987 = ~Que veux-tu dire par « en morceaux » ?~
@54988 = ~Je parle de ton âme, imbécile. Tu n'es qu'une partie qui est partiellement morte, et ton essence n'a pas rejoint celle de notre défunt père. Nous sommes dans son royaume, et ton sang règne en maître ici.~
@54989 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54990 = ~Et je peux encore te tuer si c'est nécessaire, Sarevok !~
@54991 = ~Nous verrons. Contrairement à moi, ton essence n'a pas rejoint celle de notre défunt père. Tu vis encore, et dans ce royaume, ton sang règne en maître. D'ailleurs, je serais ravi de te priver de ça.~
@54992 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@54993 = ~Tu as amassé les Larmes dans ta quête, et tu as attiré le mage que tu pourchasses sans relâche. Très malin, <CHARNAME>... je n'en attendais pas tant de toi.~
@54994 = ~De quoi parles-tu ? Je n'ai fait que traverser une série d'épreuves bizarres !~
@54995 = ~Hmpf. Tu te mets à l'épreuve, si c'est le cas. Le mage a aussi des pouvoirs ici, imbécile. Il a tout comme toi une influence sur ce lieu, et tu utilises les épreuves pour le trouver.~
@54996 = ~Que veux-tu dire ?~
@54997 = ~C'est ton âme que tu cherches, imbécile. Ce que le mage t'a volé ! Tu pensais la trouver dans une boîte, ou la croiser un jour au bord du chemin ? Ne sois pas aussi stupide !~
@54998 = ~Tu te mets à l'épreuve pour mieux connaître tes capacités et tes faiblesses, pour mieux connaître ton âme. Tu te cherches, <CHARNAME>, que tu le saches ou non.~
@54999 = ~Et le mage se bat contre toi. Il se prépare, mais il sait que l'âme qu'il détient n'est pas la sienne. Tu le trouveras. Bientôt, tous les yeux des portes s'ouvriront.~
@55000 = ~Et que ferai-je alors ? La porte sera ouverte et Irenicus m'attendra ?~
@55001 = ~Bah ! C'est une porte seulement dans ton esprit ! C'est ton pouvoir et ta perception qui font la réalité ici ! Tu ne sais même pas cela ? Pfff ! Et dire que c'est TOI qui m'as tué !~
@55002 = ~Connais-tu seulement la nature des Larmes, ou le prix que tu dois payer ? Les Neuf Enfers sont un lieu de châtiment, et si tu avances en aveugle tu es deux fois stupide !~
@55003 = ~Quelle est leur vraie nature ? De quel prix parles-tu ?~
@55004 = ~Je ne te dirai rien. Je ne suis pas ici pour la révélation mais pour la punition.~
@55005 = ~Je suppose que tu vas me dire qu'Irenicus a attendu pendant tout ce temps derrière cette étrange porte ?~
@55006 = ~Ne sois pas ridicule. Il utilise son pouvoir sur le royaume de Bhaal, comme toi. Si tu te mets à l'épreuve, tu le fais pour le trouver. Et comme je te l'ai dit, tu y es presque.~
@55007 = ~Que veux-tu dire ?~
@55008 = ~Cela n'a aucun sens. Explique-toi ou meurs !~
@55009 = ~Tu ne sais même pas que tu te mets à l'épreuve ? Le mage utilise son pouvoir pour se cacher, et tu utilises les épreuves pour le trouver... tu y es presque.~
@55010 = ~Que veux-tu dire ?~
@55011 = ~Aaah... Ainsi te voilà, enfant de Bhaal. Tu es venu revendiquer ton héritage, n'est-ce pas ? Quelle patience ! Tss, tss, tss... Ça doit être terrible de mourir ainsi.~ [HELSEL06] ~Aaah... Ainsi te voilà, enfant de Bhaal. Tu es venue revendiquer ton héritage, n'est-ce pas ? Quelle patience ! Tss, tss, tss... Ça doit être terrible de mourir ainsi.~ [HELSEL06]
@55012 = ~Revendiquer mon héritage ? De quoi parles-tu ?~
@55013 = ~Ton héritage, mon enfant. Ceci est le royaume de Bhaal. Tu n'as pas rejoint l'essence de l'ancien Seigneur du Meurtre, n'est-ce pas ? Non... alors ton sang règne en maître, ici.~
@55014 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@55015 = ~Tu as le pouvoir ici... ou plutôt la partie de Bhaal qui est en toi a le pouvoir. Et cette partie reste désormais en toi et en l'autre, le sorcier ?~
@55016 = ~Il a volé presque toute ton âme, mais pas tout, vous êtes donc liés. Aucun n'est vraiment mort, aucun n'est vraiment vivant. Ah, c'est très intéressant, vraiment.~
@55017 = ~Comment puis-je mettre un terme à cela, démon ? Me le diras-tu ?~
@55018 = ~Mais tu le sais déjà ! Tu dois partir à la recherche de ton âme en rassemblant les Larmes de Bhaal... et alors le chemin s'ouvrira devant toi.~
@55019 = ~Les Larmes de Bhaal ?~
@55020 = ~La mort fait couler bien des larmes, enfant, et Bhaal en a rassemblé beaucoup au cours de sa vie... Les Larmes ouvriront les yeux... et montreront le chemin à ton âme.~
@55021 = ~Je ne suis pas mort ! Irenicus est mort et je ne sais comment je l'ai suivi ici.~ ~Je ne suis pas morte ! Irenicus est mort et je ne sais comment je l'ai suivi ici.~
@55022 = ~Et donc, ton essence n'a pas rejoint celle de l'ancien Seigneur du Meurtre. Nous sommes dans le royaume de Bhaal... et ton sang règne en maître dans cette partie des Enfers.~
@55023 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@55024 = ~Que veux-tu dire ? À quel jeu joues-tu ?~
@55025 = ~Je parle de ton âme, enfant du meurtre. Tu es un morceau faisant partie d'un tout, et ton essence ne s'est pas dissipée pour rejoindre celle de Bhaal. Par conséquent, ton sang règne en maître ici.~
@55026 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@55027 = ~Si tu continues à me parler sur ce ton, monstre, tu n'en as plus pour longtemps à vivre...~
@55028 = ~Je m'incline devant toi, bien sûr. Tu es un enfant du meurtre dont l'essence n'a pas rejoint celle du défunt Bhaal. Dans le royaume de ton père... ton sang règne en maître.~ ~Je m'incline devant toi, bien sûr. Tu es une enfant du meurtre dont l'essence n'a pas rejoint celle du défunt Bhaal. Dans le royaume de ton père... ton sang règne en maître.~
@55029 = ~Mon sang règne en maître ? De quoi parles-tu ?~
@55030 = ~Aah. Alors l'enfant de Bhaal paraît enfin devant moi pour la dernière larme de Bhaal. Tu touches presque au but, en effet.~ [HELSEL07]
@55031 = ~De quoi parles-tu ? Je n'ai fait que traverser une série d'épreuves bizarres !~
@55032 = ~Des épreuves ? En quelque sorte. N'oublie pas que le mage a le pouvoir, lui aussi, et qu'il veut t'empêcher de la trouver. Les épreuves sont ta création, issues de ton pouvoir.~
@55033 = ~Que veux-tu dire ?~
@55034 = ~Comment trouve-t-on son âme, enfant de Bhaal ? Crois-tu qu'une âme se gagne facilement ? Non, tu dois d'abord te connaître toi-même, jusqu'au plus profond de tes passions et de tes vices.~
@55035 = ~Tu apprends à connaître tes capacités... et cela ouvrira le chemin de ton âme. C'est toi-même, ton essence, que tu cherches... que tu en sois conscient ou pas.~ ~Tu apprends à connaître tes capacités... et cela ouvrira le chemin de ton âme. C'est toi-même, ton essence, que tu cherches... que tu en sois consciente ou pas.~
@55036 = ~Et parce que c'est cela que tu cherches, tes pouvoirs luttent contre ceux du mage et t'aident à t'approcher de ton but. Tu ouvriras bientôt les yeux sur les Larmes de Bhaal.~
@55037 = ~Et que ferai-je alors ? La porte sera ouverte et Irenicus m'attendra ?~
@55038 = ~Le chemin de ton âme te sera révélé, mais tu ne le percevras que sous la forme d'une porte. Quel dommage que les âmes mortelles ne soient pas capables d'appréhender tous les pouvoirs dont elles sont capables...~
@55039 = ~J'espère que tu as été prudent, enfant de Bhaal. Les Neuf Enfers sont un lieu de châtiment. Les Larmes sont à la fois douloureuses et apaisantes.~ ~J'espère que tu as été prudente, enfant de Bhaal. Les Neuf Enfers sont un lieu de châtiment. Les Larmes sont à la fois douloureuses et apaisantes.~
@55040 = ~Pourquoi parles-tu de façon aussi mystérieuse ? Que cela signifie-t-il ?~
@55041 = ~Je voile la vérité de mystère parce que mon essence me l'impose, ô Seigneur du Meurtre. Mais je m'incline devant ton autorité et réponds malgré tout à tes questions.~ ~Je voile la vérité de mystère parce que mon essence me l'impose, ô Reine du Meurtre. Mais je m'incline devant ton autorité et réponds malgré tout à tes questions.~
@55042 = ~Je suppose que tu vas me dire qu'Irenicus a attendu pendant tout ce temps derrière cette étrange porte ?~
@55043 = ~Bien sûr que non. Il est rapide, mais tu t'approches très vite de lui. Tes épreuves sont malignes, ô jeune Seigneur du Meurtre. Ton pouvoir est grand ici.~ ~Bien sûr que non. Il est rapide, mais tu t'approches très vite de lui. Tes épreuves sont malignes, ô jeune Reine du Meurtre. Ton pouvoir est grand ici.~
@55044 = ~Que veux-tu dire ?~
@55045 = ~Ce que tu dis n'a pas de sens. Explique-toi ou meurs, démon.~
@55046 = ~Ta proie est rapide, mais tes épreuves te rapprochent encore plus près d'elle. Ton pouvoir est grand ici, malgré sa résistance.~
@55047 = ~Que veux-tu dire ?~
@55048 = ~Une des larmes repossse près de cccet endroit. Elle est en possessssion d'un autre très puissssant. Il sssera difficcccile à vaincre.~ [HELGRE02]
@55049 = ~Mais toute chossse, même la plus puisssante, peut être vaincue, n'est-cccce pas ? Tu as vaincu ccceux dont la puissssance était insssuffisante. Tu les as renversssssés de leurs trônes.~ [HELGRE08]
@55050 = ~~
@55051 = ~Qu'est-ce que cela a à voir avec la Larme ?~
@55052 = ~Aaaah... toujours tu as ssssu trouver le moyen de vaincre l'adversssssité, n'est-ccce pas ? Je te donne maintenant cccelui de vaincre ccccet ennemi-là.~ [HELGRE09]
@55053 = ~La voilà... regarde cccette épée qu'on appelle « Rasoirnoir ». Elle est puisssssante et tu dois te sssservir de ssson fil et sssa pointe pour vaincre cccelui qui détient la larme.~ [HELGRE10]
@55054 = ~À toi de déccccider, enfant de Bhaal, comment te ssssservir de l'épée noire. Je te laisssssse le choix. Ô jeune ssseigneur de cccces lieux...~ [HELGRE11] ~À toi de déccccider, enfant de Bhaal, comment te ssssservir de l'épée noire. Je te laisssssse le choix. Ô jeune reine de cccces lieux...~ [HELGRE11]
@55055 = ~Je vois que le seigneur de ce petit plan se présente devant moi. Peut-être serais-je enfin libéré de ce tourment éternel. Je ne peux que l'espérer.~ [HELGEN02] ~Je vois que la seigneuresse de ce petit plan se présente devant moi. Peut-être serais-je enfin libéré de ce tourment éternel. Je ne peux que l'espérer.~ [HELGEN02]
@55056 = ~Vous êtes celui qui garde la Larme de Bhaal ?~
@55057 = ~~
@55058 = ~~
@55059 = ~~
@55060 = ~« Dans l'antre du Ver pourpre, une simple babiole dans un trésor considérable, un menteur indique la direction, même si elle ignore ce qu'elle possède ». Je suis désolé, mais mes sages ne peuvent pas parler de façon plus claire.~
@55061 = ~« Un traître parmi les voleurs, il cherche les plaisirs du pouvoir dans une nouvelle guilde, ignorant le pouvoir de ce qu'il possède déjà ». Je suis désolé, mais vous savez, les magiciens...~
@55062 = ~« Geôlier des tieffelins, il ignore ce qu'il possède. La voie du troubadour est celle qui mène au prix déposé sur l'autel ». J'espère que vous voyez ce que ça veut dire.~
@55063 = ~« Dans les serres de la créature d'ombres, dans les ruines de lumière, près de la sorcière et des collines. Pour lui, une curiosité, pour nous, un pouvoir salvateur ». Impossible d'être plus clair que ça !~
@55064 = ~Mes sages me disent que vous êtes bredouille ! Est-ce le cas ? N'oubliez pas, vous devriez demander de l'aide avant de vous attaquer à Bodhi.~
@55065 = ~Un tourment éternel ? Qu'est-ce que vous voulez dire au juste ?~
@55066 = ~Votre tourment éternel prendra fin après votre mort !~
@55067 = ~Note à l'Ordre~
@55068 = ~Je le suis, à mon grand regret. Mon châtiment est de garder la Larme de Bhaal, et elle durera toujours jusqu'à ce que certaines conditions soient remplies. Seulement alors retrouverai-je la liberté.~
@55069 = ~Quelles sont ces conditions ?~
@55070 = ~*soupire* C'est vraiment un châtiment. On m'a amené à ce plan pour y garder la Larme de Bhaal, et je dois y rester éternellement jusqu'à ce que certaines... conditions... soient remplies.~
@55071 = ~Et quelles sont ces conditions ?~
@55072 = ~On vous a donné la clef qui vous autorise à mettre fin à mes jours... et c'est aussi un soulagement. Un événement bienvenu... si vous vous montrez capable.~
@55073 = ~Je... ne peux pas vous le dire directement, <PRO_LADYLORD>. Une des conditions de mon châtiment m'interdit de vous en révéler la nature sans faire d'énigme. Écoutez attentivement :~
@55074 = ~Note à l'Ordre~
@55075 = ~« Vous qui avez la lame rasoir
forgée du fer le plus noir
gorgée de sang et de peur,
vous détenez la clef
de celui qui garde
la Larme sacrée de Bhaal. »~
@55076 = ~Bon... voyons. L'épée Rasoirnoir est donc la clef pour obtenir de vous la Larme de Bhaal ?~
@55077 = ~Je ne peux pas répondre à ça, <PRO_LADYLORD>.~
@55078 = ~Si je vous donnais Rasoirnoir, vous me donneriez la Larme ? Et ceci vous délivrerait de votre punition ?~
@55079 = ~L'épée m'autorise donc à vous tuer, n'est-ce pas ? Et vous seriez délivré de votre punition ?~
@55080 = ~Ça ne fait rien... de toute façon je n'ai pas l'épée en ma possession.~
@55081 = ~Ce sera le cas, <PRO_LADYLORD>.~
@55082 = ~Mais Rasoirnoir me permet également de vous tuer, n'est-ce pas ? Ceci vous libérerait vous aussi.~
@55083 = ~Prenez l'épée dans ce cas. Je n'en ai pas besoin.~
@55084 = ~Je ne suis pas sûr de ce que je veux faire dans ce cas.~ ~Je ne suis pas sûre de ce que je veux faire dans ce cas.~
@55085 = ~Vous n'avez pas besoin de l'épée pour faire cela. Le fait d'avoir Rasoirnoir est suffisant même si vous ne le gardez pas longtemps. Mais ceci, en effet, serait aussi une libération.~
@55086 = ~Mais je pourrais vous donner l'épée, pas vrai ? Vous n'auriez plus à garder la Larme ?~
@55087 = ~Alors je pense que vous devez mourir maintenant !~
@55088 = ~Je ne suis pas sûr de ce que je veux faire.~ ~Je ne suis pas sûre de ce que je veux faire.~
@55089 = ~Vous n'avez pas besoin de la lame pour me tuer. Le fait d'avoir Rasoirnoir est suffisant pour me libérer... si telle est votre décision.~
@55090 = ~Vraiment ? Alors je pense que vous devez mourir maintenant !~
@55091 = ~Mais si je revenais avec la lame et vous la donnais... seriez-vous alors délivré de votre punition ?~
@55092 = ~Je vous suis très reconnaissant de m'avoir libéré. Que les cieux chantent vos louanges pour ce que vous avez fait pour moi. Merci pour ce geste charitable, mon <PRO_LADYLORD>.~ [HELGEN08] ~Je vous suis très reconnaissant de m'avoir libéré. Que les cieux chantent vos louanges pour ce que vous avez fait pour moi. Merci pour ce geste charitable, ma <PRO_LADYLORD>.~ [HELGEN08]
@55093 = ~Vous pourrez toujours revenir vers moi si vous le souhaitez, <PRO_LADYLORD>. Je n'ai pas d'autre endroit où aller.~
@55094 = ~Je serais heureux d'être libéré... si vous en êtes capable.~ [HELGEN07]
@55095 = ~Ce sera le cas, <PRO_LADYLORD>.~
@55096 = ~Je préférerais vous détruire maintenant, en fait.~
@55097 = ~Je devrais peut-être revenir avec l'épée.~
@55098 = ~Je ne suis pas sûr de ce qu'il faut faire.~ ~Je ne suis pas sûre de ce qu'il faut faire.~
@55099 = ~Comme vous voulez, cher <PRO_LADYLORD>.~ ~Comme vous voulez, chère <PRO_LADYLORD>.~
@55100 = ~Vous détenez toujours la clef qui permet de m'affranchir de cette douloureuse agonie qu'est ma prison ? Allez-vous me libérer ? Alors, mon <PRO_LADYLORD> ?~ [HELGEN06] ~Vous détenez toujours la clef qui permet de m'affranchir de cette douloureuse agonie qu'est ma prison ? Allez-vous me libérer ? Alors, ma <PRO_LADYLORD> ?~ [HELGEN06]
@55101 = ~Redites-moi d'abord l'énigme.~
@55102 = ~Si je vous donne Rasoirnoir, vous serez donc libéré ?~
@55103 = ~L'épée m'autorise donc à vous tuer, non ? Et ce serait une libération ?~
@55104 = ~Je ne détiens pas la clef... Je n'ai pas l'épée en ma possession, génie.~
@55105 = ~Sache, enfant de Bhaal, que l'une des Larmes de Bhaal repose non loin d'ici... Deux chemins y mènent. Deux portes, deux chemins, et pourtant tous deux mènent à ton but, comprends-tu ?~ [HELSEL02]
@55106 = ~Au cours du long périple qu'a été ta vie, tu as fait de nombreux choix. Et tu as emprunté divers chemins, qui ont toujours eu un effet sur ceux qui t'entourent... même si cela n'était pas dans tes intentions.~ [HELSEL08]
@55107 = ~Oh oui, je veux voir un autre esclave exploser !~
@55108 = ~Je ne pense pas.~
@55109 = ~Je t'en prie.~
@55110 = ~En avant !~
@55111 = ~Tel est le sort de ceux que le destin a marqués de son sceau... les conséquences de leurs actes se répercutent sur tout ce qui les entoure.~ [HELSEL09]
@55112 = ~Peut-être que le sort des autres t'importe peu. Peut-être qu'il consume ton âme. C'est là un choix de plus... un acte... une ondulation qui ride la surface de l'étang de la réalité.~ [HELSEL10]
@55113 = ~Quel rapport y a-t-il avec la Larme, alors ?~
@55114 = ~Le chemin que tu emprunteras pour atteindre la larme affectera une autre personne aujourd'hui. Une personne qui n'est en rien mêlée à ton entreprise, et qui pourtant s'en voit affectée. Une personne innocente qui en gouttera les conséquences.~ [HELSEL11]
@55115 = ~L'un de tes compagnons de route qui gravite autour de ton destin, et qui pourtant ne subit pas ton influence... une telle personne fera l'affaire.~ [HELSEL12]
@55116 = ~Et souviens-toi, enfant de Bhaal... il faut faire un choix, et tu devras vivre avec ses conséquences. *ricane* Va à ma gauche et sacrifie-toi pour l'innocent. Va à ma droite et sauve-toi toi-même.~ [HELSEL13]
@55117 = ~Un innocent... qui t'est totalement inconnu, provenant des plans primaires, un humain bon et honnête... conviendra parfaitement. *ricane* Va à ma gauche et sacrifie-toi pour l'innocent. Va à ma droite et sauve-toi toi-même.~ [HELSEL14]
@55118 = ~Quoi ? Quel est cet endroit ? Pourquoi suis-je ici ?~
@55119 = ~Calme-toi, humain. Ta présence ici ne devrait pas durer. Implore la miséricorde de l'enfant de Bhaal, si tu le désires. Ton destin demeure, aujourd'hui, entre ses mains, pas les miennes.~
@55120 = ~La conséquence de ton choix est la suivante : ton compagnon est mort, suite à tes actions... si ce n'est tes intentions. Tel est le chemin du destin, forgé par les êtres prééminents.~ [HELSEL15]
@55121 = ~La conséquence de ton choix est la suivante : l'innocent a été assassiné, suite à tes actions... si ce n'est tes intentions. Tel est le chemin du destin, forgé par les êtres prééminents.~ [HELSEL16]
@55122 = ~Un acte désintéressé, de la part de celui qui porte volontairement le fardeau du destin, et les conséquences qu'il entraîne. Votre compagnon vous rejoint, enfant de Bhaal.~ [HELSEL17] ~Un acte désintéressé, de la part de celle qui porte volontairement le fardeau du destin, et les conséquences qu'il entraîne. Votre compagnon vous rejoint, enfant de Bhaal.~ [HELSEL17]
@55123 = ~Retournez à Athkatla et récupérez le Rhynn Lanthorn. C'est notre seule chance de vaincre Irenicus.~
@55124 = ~Un acte désintéressé, de la part de celui qui porte volontairement le fardeau du destin, et les conséquences qu'il entraîne. L'innocent vit... et s'en retourne de là d'où il vient.~ [HELSEL18] ~Un acte désintéressé, de la part de celle qui porte volontairement le fardeau du destin, et les conséquences qu'il entraîne. L'innocent vit... et s'en retourne de là d'où il vient.~ [HELSEL18]
@55125 = ~La larme de Bhaal est tienne, enfant.~ [HELSEL19]
@55126 = ~Vous avez le Rhynn Lanthorn ! Il n'est plus entre les mains de Bodhi, cette créature infernale ! Le cours de la guerre vient de changer !~
@55127 = ~C'est une bonne chose que tu sois venu à moi, enfant de Bhaal. Tu es le seul qui puisse vaincre la terrible créature qui détient ici une des larmes de ton père disparu.~ [HELPRI02] ~C'est une bonne chose que tu sois venue à moi, enfant de Bhaal. Tu es la seule qui puisse vaincre la terrible créature qui détient ici une des larmes de ton père disparu.~ [HELPRI02]
@55128 = ~Problème animalier à Franc-Marché : j'ai informé Cernd de la situation

J'ai dit à Cernd ce que je savais de Faldorn et des druides. Il a déclaré que seul un défi d'un autre druide pourrait la faire quitter son poste, et j'ai suggéré à Jaheira d'essayer.~
@55129 = ~J'ai entendu parler de tes exploits, enfant. Hmm, très... impressionnant, pour un... mortel. De puissantes créatures balayées comme des fétus de paille. Des êtres qui faisaient trembler les mortels, terrassés avec la plus extraordinaire vaillance. N'importe quel autre mortel n'aurait pas su montrer autant de courage que toi !~ [HELPRI08] ~J'ai entendu parler de tes exploits, enfant. Hmm, très... impressionnant, pour une... mortelle. De puissantes créatures balayées comme des fétus de paille. Des êtres qui faisaient trembler les mortels, terrassés avec la plus extraordinaire vaillance. N'importe quel autre mortel n'aurait pas su montrer autant de courage que toi !~ [HELPRI08]
@55130 = ~Tu es une merveille de destruction, enfant de Bhaal. Va, maintenant dans cette caverne, vaincre la créature qui s'y tapit. Écrase-la sous ton talon et parachève ton œuvre ! Réjouis-toi de cette nouvelle victoire !~ [HELPRI09]
@55131 = ~Très bien, je combattrai tout ce qui se trouve à l'intérieur.~
@55132 = ~Si elle garde la Larme de Bhaal, alors, je n'ai guère le choix.~
@55133 = ~De quelle sorte de créature parlez-vous ?~
@55134 = ~Excellent ! Va, sans plus attendre, puissant parmi les puissants ! Va dans cette caverne accomplir ton destin de héros ! Va prendre cette larme à la créature qui la garde !~ [HELPRI10] ~Excellent ! Va, sans plus attendre, puissante parmi les puissants ! Va dans cette caverne accomplir ton destin d'héroïne ! Va prendre cette larme à la créature qui la garde !~ [HELPRI10]
@55135 = ~C'est une puissante créature, enfant de Bhaal. Une de celles que toi seul peut vaincre ! Mais, j'ai toute confiance en ta capacité à anéantir tes ennemis et à récupérer ton bien. La larme qui te revient de droit !~ [HELPRI11] ~C'est une puissante créature, enfant de Bhaal. Une de celles que toi seule peut vaincre ! Mais, j'ai toute confiance en ta capacité à anéantir tes ennemis et à récupérer ton bien. La larme qui te revient de droit !~ [HELPRI11]
@55136 = ~Dans ce cas, cette créature ne sera bientôt plus sur mon passage !~
@55137 = ~Si elle garde la Larme, je la combattrai si je le peux.~
@55138 = ~Elle est puissante, certes... mais quel genre de créature est-ce ?~
@55139 = ~Cette créature mérite la mort, enfant de Bhaal. Mais il devrait être aisé à un guerrier tel que toi de triompher là où tous les autres ont échoué.~ [HELPRI12] ~Cette créature mérite la mort, enfant de Bhaal. Mais il devrait être aisé à une guerrière telle que toi de triompher là où tous les autres ont échoué.~ [HELPRI12]
@55140 = ~Eh bien, si elle mérite la mort, je la lui donnerai.~
@55141 = ~Pourquoi mérite-t-elle la mort ?~
@55142 = ~Parce que... parce qu'elle existe. Et qu'elle se dresse en travers de ta route !~ [HELPRI13]
@55143 = ~Insinueriez-vous qu'elle ne me donnera pas la Larme ?~
@55144 = ~Je ne tue pas des créatures sous prétexte qu'elles se trouvent sur mon chemin.~
@55145 = ~Je vois. Je sais donc ce qu'il me reste à faire.~
@55146 = ~Eh bien... non. Peut-être que si tu demandes poliment... on ne sait jamais. Il se peut qu'elle te la donne.~ [HELPRI14]
@55147 = ~En dépit de tous tes exploits, tu n'as aucune fierté, enfant de Bhaal. Qu'il en soit donc ainsi ! L'humilité sert bien... ceux qui la méritent.~ [HELPRI16]
@55148 = ~Non ? Considères-tu toujours avec attention les raisons de ton courroux, les motifs qui te pousse à porter chacun de tes coups ? Veux-tu dire que tu examines toujours très attentivement l'endroit où tu vas exercer ton pouvoir ?~ [HELPRI15]
@55149 = ~Ainsi nous nous rencontrons à nouveau. Le cadre sied parfaitement à nos retrouvailles, n'est-ce pas ? Ce lieu de châtiment est l'endroit idéal pour un face-à-face.~ [HELSAR02]
@55150 = ~Sarevok ?!~
@55151 = ~C'est moi, ou peut-être un simple écho. Mon essence a finalement rejoint celle de feu notre père, lorsque tu m'as assassiné. Mais au bout du compte, tous les enfants de Bhaal finissent ici.~ [HELSAR06]
@55152 = ~Je détiens l'une des Larmes de Bhaal dont tu as besoin. Mais je ne te la donnerai pas. Tu ne la mérites pas.~ [HELSAR07]
@55153 = ~La mériter ? Qu'entends-tu par là ?~
@55154 = ~Tu es mal placé pour me juger, Sarevok.~
@55155 = ~Ne me fais pas rire ! Je l'arracherai à ton cadavre, si besoin est !~
@55156 = ~Donne-la-moi ou tu mourras, ombre maléfique !~
@55157 = ~Tu n'es qu'une larve, un cafard larmoyant. J'ai trouvé du plaisir à passer Gorion au fil de mon épée. Et s'il y avait une justice, je serais maintenant à ta place, et toi... à la mienne.~ [HELSAR08]
@55158 = ~Tu oses parler de Gorion !~
@55159 = ~Si justice il y avait, et elle t'anéantirait à jamais !~
@55160 = ~Je t'avertis, Sarevok... donne-moi la Larme ou je mettrai un terme à ta vie !~
@55161 = ~C'en est fini ! À mort !~
@55162 = ~Le trône de ce royaume devrait être mien. Et si j'avais pu te passer au fil de mon épée aussi facilement que ton ridicule Gorion, je serais maintenant à ta place, et toi... à la mienne. Alors si, je me trouve dans une position idéale pour te juger.~ [HELSAR09]
@55163 = ~Tu oses parler de Gorion !~
@55164 = ~Mais ce n'est pas le cas, n'est-ce pas ?! Je t'ai, autrefois, éliminé et je peux recommencer !~
@55165 = ~Je t'avertis, Sarevok... donne-moi la Larme ou je mettrai un terme à ta vie !~
@55166 = ~J'en ai assez de toi ! Prépare-toi à mourir une seconde fois.~
@55167 = ~Aaaaah, oui. Entretien ton infernale colère. Je sens la rage bouillir dans les sulfureuses crevasses de ton cœur.~ [HELSAR10]
@55168 = ~Tu la sens, n'est-ce pas ? L'ombre qui enveloppe ton âme tel un serpent, qui la serre, y répandant son venin. Cette ombre, cette colère existe chez tous les enfants de Bhaal... mais peu nombreux sont ceux qui savent en tirer profit.~ [HELSAR11]
@55169 = ~Tu es devenu l'écorcheur, n'est-ce pas ? L'avatar de feu notre père. L'incarnation la plus noire du meurtre... je peux voir au-delà de tes yeux. Fais jaillir ta colère pour moi... si tu le peux. Rassemble ta haine contre moi !~ [HELSAR12] ~Tu es devenue l'écorcheur, n'est-ce pas ? L'avatar de feu notre père. L'incarnation la plus noire du meurtre... je peux voir au-delà de tes yeux. Fais jaillir ta colère pour moi... si tu le peux. Rassemble ta haine contre moi !~ [HELSAR12]
@55170 = ~Non ! Je ne succomberai pas à la souillure !~
@55171 = ~Pourquoi ?! Qu'espères-tu de tout cela ?!~
@55172 = ~Tu veux que je redevienne l'écorcheur ? Ça ne se contrôle pas aussi facilement !~
@55173 = ~Très bien ! Tu veux goutter à ma colère, Sarevok ?! Tiens !~
@55174 = ~C'est toi qui m'as fait venir ici. Ton pouvoir en ces lieux a invoqué mon essence. Et pourquoi penses-tu avoir fait cela ?~ [HELSAR13]
@55175 = ~Je peux t'apprendre à utiliser ta colère. Tu peux contrôler cette ombre, la diriger, l'invoquer quand tu le souhaites ! Tu peux devenir l'écorcheur à tout moment, et te transformer en l'instrument de mort que tu es destiné à être.~ [HELSAR14] ~Je peux t'apprendre à utiliser ta colère. Tu peux contrôler cette ombre, la diriger, l'invoquer quand tu le souhaites ! Tu peux devenir l'écorcheur à tout moment, et te transformer en l'instrument de mort que tu es destinée à être.~ [HELSAR14]
@55176 = ~Alors, pense à moi ! Pense à la façon dont j'ai occis ton cher Gorion ! À la façon dont j'ai massacré les habitants de Château-Suif ! Libère ta colère, ta haine ! Sonde les profondeurs de ton cœur si sombre !~ [HELSAR15]
@55177 = ~Libère ta colère ! Fais-la jaillir, et devient colère ! Car si tu ne le peux pas, tu ne mérites pas ton destin ! Cela aurait dû être moi, tu m'entends ?! ATTAQUE-MOI SI TU L'OSES, PITOYABLE CARICATURE !~ [HELSAR16]
@55178 = ~Non, jamais ! Je n'ai pas besoin de la souillure et je ne l'utiliserai pas !~
@55179 = ~Je ne ressens pas la colère dont tu parles, Sarevok. J'ai pitié de toi et de ce que tu es devenu, c'est tout.~
@55180 = ~Si cela me permet de devenir l'écorcheur quand je le désire, qu'il en soit ainsi ! Je me ferai un plaisir de te détruire à nouveau.~
@55181 = ~OUI ! MEURS ! MEURS À JAMAIS !~
@55182 = ~OUI ! TU ES DIGNE DE TE BATTRE À NOUVEAU ! L'INCARNATION MÊME DE L'ENFANT DE BHAAL !~ [HELSAR17]
@55183 = ~TU N'AS JAMAIS ÉTÉ DIGNE DU SANG DE BHAAL ET JE VAIS T'ANÉANTIR DANS L'INSTANT !~ [HELSAR18]
@55184 = ~Fuis ce lieu si tu ne veux pas mourir ! Remonte à la surface et va voir Elhan, il saura te mettre en sûreté.~
@55185 = ~Alors c'est... c'est enfin terminé. Toutes ces choses qu'il nous a fait subir, et c'est enfin terminé. C'est... c'est sûr ? <CHARNAME>, quelque chose ne va pas...~
@55186 = ~Le mauvais magicien est mort ! Une fois de plus, Bouh et Minsc et <CHARNAME> s'en sortent en héros victorieux ! Place aux réjouissances et à l'allégresse !~
@55187 = ~Vous n'êtes pas des elfes noirs ! Remontez à la surface avant de tomber entre nos mains. Elhan veillera à votre sécurité.~
@55188 = ~Un terrible fin pour un homme terrible. Je pense que nous avons bien fait, mais je ne suis pas sûre que tout soit restauré comme avant. <CHARNAME> ? Tu te sens différent ?~ ~Un terrible fin pour un homme terrible. Je pense que nous avons bien fait, mais je ne suis pas sûre que tout soit restauré comme avant. <CHARNAME> ? Tu te sens différente ?~
@55189 = ~Voilà. C'est fait. Une fois de plus, la magie a généré une dangereuse obsession et a pris davantage que la seule vie de son utilisateur. *soupire* Doit-il toujours en être ainsi ?~
@55190 = ~La douleur s'apaise. C'est alors que se dresse devant vous l'abomination la plus abjecte qui puisse être. Vos sens n'y résistent pas, vous voici la proie d'émotions cauchemardesques. Vous avez plongé au cœur de l'enfer, le doute n'est plus permis.~
@55191 = ~Nous sommes victorieux, ce me semble... mais c'était presque trop facile. Quel est l'objet de tout cela, où est la justice ? Peut-être ai-je cette impression seulement parce c'est une fin ?~ ~Nous sommes victorieuses, ce me semble... mais c'était presque trop facile. Quel est l'objet de tout cela, où est la justice ? Peut-être ai-je cette impression seulement parce c'est une fin ?~
@55192 = ~Ouf ! Pendant un instant, j'ai bien cru que j'étais perdu. Toute ma vie a défilé devant mes yeux et je ne me suis même pas arrêté sur les bons moments. Ah, enfin... quelqu'un veut les bottes du magicien ? Moi, je les veux. Et son chapeau ? Avait-il un chapeau pointu ?~
@55193 = ~Excellent ! Une victoire méritée contre un puissant sorcier ! Maintenant, pillons tous ses secrets ! Il doit avoir des tonnes de pouvoirs magiques sous la main, oh oui !~
@55194 = ~Ce mage était sot de se croire aussi puissant. Maintenant il est mort, comme meurent tous les crétins. Mais... et toi, <CHARNAME> ? As-tu retrouvé ce que tu avais perdu ?~
@55195 = ~Ah, laissons les muses s'envoler à nouveau ! La victoire remportée aujourd'hui sera chantée à travers les temps ! L'entropie accomplit son œuvre même sur ceux qui cherchent à s'élever au-dessus d'elle...~
@55196 = ~Alors... alors c'est fini. Aussi simplement que ça. C'est étrange... je pensais que cela se passerait différemment, que ce ne serait pas si... si facile. Je ne sais pas.~
@55197 = ~Nous avons mis longtemps à en arriver là, <CHARNAME>. Il y a eu beaucoup de pertes, mais le sorcier est enfin mort.~
@55198 = ~Il est mort ! Au nom du ciel, ce n'était qu'un vilain qui attendait de mourir entre les mains d'un vertueux combattant.~
@55199 = ~Har ! Une belle victoire, c'est ce que je me dis ! Maintenant, il ne reste plus qu'à sortir de cette souche et à trouver des donzelles faciles et du bon rhum, voilà !~
@55200 = ~C'est... c'est donc une victoire ? Il me semblait si... si... divin, en quelque sorte. J'avais du mal à croire qu'il pouvait simplement tomber et mourir aussi facilement.~
@55201 = ~Après tout le mal que nous nous sommes donné, voilà notre trophée ? Il est mort, et voilà tout ! Mm... il est mort. Comme un simple mortel. Comme c'est étrange.~
@55202 = ~Le sorcier s'est efforcé de détruire l'équilibre au prix de sa vie. Certains pourraient y voir une victoire mais je ne vois qu'une simple mort dans tout cela. C'est étrange qu'un tel personnage succombe si facilement.~
@55203 = ~Problème animalier à Franc-Marché : Cernd va combattre

Cernd va défier Faldorn pour la direction des druides. Je me suis allié à lui pour présenter un groupe uni devant nos ennemis. Cernd semble plutôt confiant.~ ~Problème animalier à Franc-Marché : Cernd va combattre

Cernd va défier Faldorn pour la direction des druides. Je me suis alliée à lui pour présenter un groupe uni devant nos ennemis. Cernd semble plutôt confiant.~
@55204 = ~De toute évidence, personne ne vous accompagne ; les camarades qui ont combattu Irenicus à vos côtés n'ont pas chuté avec vous. Vous ressentez certes leur affliction, mais tout le groupe est demeuré sur le territoire des vivants.~
@55205 = ~Je me sens bizarre... Je me suis sentie déchirée... mon essence... enfin, je ne sais pas... Et il y avait cette chose... cette force... je savais que c'était toi. Il fallait que je vienne avec toi, c'est tout ce que je savais.~ [IMOEN75]
@55206 = ~Eût-il approché de plus près les affres de la mort, le groupe entier eût succombé aux puissances qui se sont alors déchaînées. Vous voici désormais sans camarades, ignorant pour ainsi dire tout des raisons qui vous amènent jusqu'ici.~
@55207 = ~À moins que ce ne soit parce qu'elle était une vampire, qu'elle n'avait pas d'âme. Elle est simplement... morte, et il ne restait plus que mon âme ? Ou peut-être... peut-être qu'il y a un rapport avec ta mort près de l'Arbre de Vie. Oh, je ne sais pas.~ [IMOEN74]
@55208 = ~Aaah, quelle mort grandiose au combat attend Bouh et Minsc ! Nous étions en chemin pour les territoires et manoirs de Rashéménie, lorsque nous avons senti que vous aviez besoin de nous, et nous voilà !~ [MINSC87]
@55209 = ~Mais peu à peu, vous découvrez que d'autres se tiennent auprès de vous. Il s'agit des camarades dont les blessures infligées au cours de la bataille contre Irenicus s'avèrent si graves que leurs âmes, à leur tour, sont entraînées vers les mêmes profondeurs que la vôtre.~
@55210 = ~Ce... ce n'est pas fini, n'est-ce pas ? C'est la mort... et ton étrange pouvoir m'a attiré ici avec toi. Qu'il en soit donc ainsi. Il est des éons par-delà lesquels même la mort ne peut mourir. Nous attendrons la mort ensemble.~ [JAHEIRD3]
@55211 = ~Quel... quel est cet endroit ?! Je suis mort, j'en suis certain, j'ai... et j'ai senti... j'ai senti quelque chose me tirer jusqu'ici. C'était vous, n'est-ce pas ? Vous m'avez entraîné ici dans votre sillage.~ [VALYGA83]
@55212 = ~Nous sommes morts, en effet. Je... je ne devrais pas être là mais je savais que le combat n'était pas encore terminé. Je vous ai senti me tirer à vous et je n'ai pas résisté. Mazzy Fentan ne recule jamais devant un combat.~ [MAZZY90] ~Nous sommes mortes, en effet. Je... je ne devrais pas être là mais je savais que le combat n'était pas encore terminé. Je vous ai senti me tirer à vous et je n'ai pas résisté. Mazzy Fentan ne recule jamais devant un combat.~ [MAZZY90]
@55213 = ~Ça alors ! Cet endroit ressemble à... euh, cela me rappelle... oh, c'est comme la fois où je... hum... huuum... humm... hum... Non, non, je ne crois pas que quelque chose comme cela me soit déjà arrivé...~ [JANJAN73]
@55214 = ~Hein ? Les Neuf Enfers, c'est cela ? Hmmmm... J'ai senti un pouvoir infernal m'attirer, mais j'allais venir de toute façon. Je sais à quel point je vous suis indispensable. Il serait peut-être profitable pour moi de rester avec vous... nous verrons.~ [EDWIN90]
@55215 = ~Ceci est... assez inhabituel. La mort m'a prise pendant le combat, et les ténèbres ont gagné tous mes sens. J'ai ressenti comme une traction, et l'ai suivie... Mais quel peut bien être cet endroit ?~ [VICONIB7]
@55216 = ~Aah, de retour dans les plans, je vois. Et non sans effort, on dirait. L'aventure à tes côtés est pleine de surprises, mon corbeau.~ [HAERDA88]
@55217 = ~Cet endroit... est horrible ! J'ai senti quelque chose m'attirer quand je suis morte et je savais que c'était vous. Il fallait que je vienne. Je pourrais peut-être vous aider...~ [AERIEB9]
@55218 = ~Cet endroit, le mal y règne après la mort. J'ai répondu à votre appel parce que mon devoir ne s'achève pas avec la fin de ma vie. Faisons notre possible pour en finir ici.~ [KELDOR99]
@55219 = ~Sans nul doute, vos camarades souffrent terriblement de leur état. Vous-même ignorez totalement ce que vous faites en ces lieux.~
@55220 = ~Vos camarades dont les blessures infligées durant le combat avec Irenicus sont les plus sérieuses auraient pu chuter à votre suite, mais il n'en est rien : personne ne se tient à vos côtés. Solitaire, vous comprenez à peine pourquoi vous êtes ici.~
@55221 = ~Marmotte~
@55222 = ~*la boîte est vide, et vous n'en avez plus l'utilité*~
@55223 = ~Je suis mort... et... me retrouve ici ?! Quel genre d'endroit est-ce ? Cette attraction... vous m'avez emmené avec vous, <CHARNAME>. Bon, je vous aiderai si vous en avez besoin... mais j'espère bien trouver une issue aussi !~ [ANOMENC3]
@55224 = ~Hmmmm... J'ai eu l'impression qu'on me tirait par les pieds quand je suis mort... Et j'suis là. C'est croquignolet, comme coin, non ? En fin de compte, c'est bien mieux que c'que j'pourrais espérer après la mort.~ [KORGAN86]
@55225 = ~Mais... quel est cet endroit ? Je suis mort, j'en suis sûr ! Mais... tu nous as amenés ici, <CHARNAME> ? Faut-il encore faire quelque chose pour... pour Irenicus ? Encore ?~
@55226 = ~Quel étrange plan... Oh... Quelle étrange sensation. Nous sommes morts, n'est-ce pas ? Toute cette souffrance puis cette impression d'être attirée vers le bas, d'être prise dans un tourbillon...~ [NALIA85] ~Quel étrange plan... Oh... Quelle étrange sensation. Nous sommes mortes, n'est-ce pas ? Toute cette souffrance puis cette impression d'être attirée vers le bas, d'être prise dans un tourbillon...~ [NALIA85]
@55227 = ~Intéressant. Il semblerait que même la mort ne saurait interférer dans ta quête. Ta présence ici implique manifestement la mienne et puisque nos destins sont liés, sache que je ne faillirai pas.~ [CERND77]
@55228 = ~Il nous sera à présent plus facile d'arriver jusqu'à Irenicus. Mais ce maudit mage reste un adversaire redoutable. Traquez-le, et mettez-le définitivement hors d'état de nuire. Détruisez à tout jamais son ignoble pouvoir.~ [ELHAN119]
@55229 = ~Il était donc écrit que je devais t'humilier une dernière fois. Il n'y a plus d'échappatoires.~ [IRENIC74]
@55230 = ~Pas d'esclaves à mettre en morceaux, aujourd'hui...~
@55231 = ~Mais... mais pourquoi n'ai-je pas suivi Bodhi dans... là où elle est allée lorsqu'elle est morte ?~ [IMOEN73]
@55232 = ~Problème animalier à Franc-Marché : Cernd va combattre

Cernd a accepté de défier Faldorn pour le contrôle du bosquet des druides. Apparemment, elle doit accepter ce genre de défi officiel et pourrait être vulnérable, quels que soient ses sorts de protection. Je ne veux toujours pas de Cernd dans mon groupe, il combattra donc seul.~
@55233 = ~Nous sommes morts, n'est-ce pas ? Si j'étais un enfant de Bhaal, ne devrais-je pas être morte ? Tout comme Sarevok ? Irenicus a dit que j'étais différente, mais... je ne sais pas. De toute façon, je te suivrai quoi qu'il arrive.~ [IMOEN72] ~Nous sommes mortes, n'est-ce pas ? Si j'étais un enfant de Bhaal, ne devrais-je pas être morte ? Tout comme Sarevok ? Irenicus a dit que j'étais différente, mais... je ne sais pas. De toute façon, je te suivrai quoi qu'il arrive.~ [IMOEN72]
@55234 = ~Je vous en conjure ! Je n'ai personne d'autre ! Songez à ma famille ! Songez aux serviteurs et à leurs familles ! Les trolls ont peut-être épargné une partie d'entre eux...~
@55235 = ~Les gardes sont peut-être morts, mais les serviteurs ont dû assister à l'attaque et ils sauront nous dire combien sont nos ennemis. Je vous en prie, restez, vous êtes notre dernière chance.~
@55236 = ~Ah... vous revenez enfin à vous. Je dois avouer que je doutais des prêtresses, lorsqu'elles m'affirmaient que votre corps montrait à nouveau des signes de vie.~ [ELLESI19]
@55237 = ~Nous avons ramené à la vie tous vos compagnons, mais quant à vous, rien ne semblait capable de rappeler vers nous votre esprit. Nous étions près de renoncer, quand vous avez commencé de bouger, ce matin.~
@55238 = ~Comb... Combien de temps ai-je passé... ?~
@55239 = ~Dans l'au-delà ? Quelques jours, guère plus. Vous avez su retrouver le chemin du retour, l'on ne peut que s'en réjouir.~
@55240 = ~En dépit de votre réputation, vous avez rendu aux elfes, ainsi qu'à Suldanessalar, un inestimable service. Vous voir succomber alors aux affres de la mort, après tous ces événements, eût été épouvantable.~
@55241 = ~Je me suis permis d'organiser une modeste cérémonie, afin de récompenser votre bravoure et vous témoigner notre reconnaissance, quelles qu'aient pu être vos intentions.~
@55242 = ~Vous devriez vous reposer, à présent, afin de recouvrer toutes vos forces. Une prêtresse viendra vous éveiller, lorsqu'il sera l'heure.~
@55243 = ~Vous avez rendu à Suldanessalar un inestimable service. Vous avez sauvé l'Arbre de Vie, vous m'avez sauvée et mis un terme à la menace qu'Irenicus faisait peser sur nous. Si la mort avait eu raison de vous, c'eût été une véritable tragédie.~
@55244 = ~Je me suis permis d'organiser une cérémonie afin de récompenser votre bravoure et vous témoigner notre reconnaissance. Pour les elfes, vous êtes à présent un héros... peut-être même êtes-vous en passe de devenir une véritable légende.~ ~Je me suis permis d'organiser une cérémonie afin de récompenser votre bravoure et vous témoigner notre reconnaissance. Pour les elfes, vous êtes à présent une héroïne... peut-être même êtes-vous en passe de devenir une véritable légende.~
@55245 = ~Mais restons-en là pour le moment. Il faut vous reposer, à présent, afin de recouvrer toutes vos forces. Une prêtresse viendra vous éveiller, lorsqu'il sera l'heure.~
@55246 = ~Ceux d'entre vous qui ont survécu au retour de l'Exilé à Suldanessalar me connaissent moi, votre reine... mais peu nombreux sont ceux qui connaissent le héros se tenant à mes côtés, qui a sauvé notre cité et l'Arbre de Vie.~ [ELLESI20] ~Ceux d'entre vous qui ont survécu au retour de l'Exilé à Suldanessalar me connaissent moi, votre reine... mais peu nombreux sont ceux qui connaissent l'héroïne se tenant à mes côtés, qui a sauvé notre cité et l'Arbre de Vie.~ [ELLESI20]
@55247 = ~De sombres forfaits entachent votre nom, mais aujourd'hui, nous vous remercions chaleureusement pour votre aide, plus que précieuse. Du plus profond de nos cœurs, pour l'immense service que vous nous avez rendu : merci.~ [ELLESI21]
@55248 = ~De tels actes désintéressés auraient pu vous coûter la vie, et peut-être bien plus encore.~ [ELLESI22]
@55249 = ~Vous n'avez pas été seul à accomplir ces hauts faits... Suldanessalar remercie également ceux qui ont voyagé et combattu à vos côtés pour sauver notre cité.~ [ELLESI23] ~Vous n'avez pas été seule à accomplir ces hauts faits... Suldanessalar remercie également ceux qui ont voyagé et combattu à vos côtés pour sauver notre cité.~ [ELLESI23]
@55250 = ~Il est impossible de vous récompenser convenablement pour ce que vous avez fait. Acceptez la gratitude éternelle de notre peuple... ainsi qu'une Amulette de la seldarine, pour vous souvenir que vous serez toujours bienvenus parmi nous.~ [ELLESI24]
@55251 = ~Il est difficile de vous récompenser pour l'héroïsme dont vous avez fait montre. Acceptez la reconnaissance de notre peuple, ainsi que ces quelques pièces d'or et une Amulette de la seldarine, symbole de ce que vous avez fait pour nous.~ [ELLESI25]
@55252 = ~Pour ce qui est de l'homme que nous connaissions sous le nom de Joneleth, je ne peux que dire qu'il est mort il y a bien longtemps. Mais il vit toujours dans mon souvenir.~ [ELLESI26]
@55253 = ~Quant à l'homme qu'il est devenu... l'Exilé, Irenicus... celui qui a causé tant de souffrances et commit tant d'atrocités... je ne peux que prier pour que dans la mort : il trouve la paix qu'il n'a pu trouver dans la vie.~ [ELLESI27]
@55254 = ~Je ressens le besoin de m'excuser pour ses crimes... pour ce qu'il vous a fait subir, à vous et à vos amis. À cause de sa folie, nous lui avons retiré son immortalité elfique et l'avons exilé... Créant ainsi... Irenicus.~ [ELLESI28]
@55255 = ~Je ne peux m'empêcher de penser que nous sommes en partie responsables. Il va falloir que j'y réfléchisse.~ [ELLESI29]
@55256 = ~Quant à vous, je gage que vous partirez bientôt. J'imagine que vous avez hâte de reprendre votre périple. Partez avec la bénédiction de Suldanessalar. Tous nos vœux vous accompagnent.~ [ELLESI30]
@55257 = ~Quant à vous, j'imagine que vous avez hâte de reprendre votre périple. Nous vous souhaitons bonne chance. Sachez que vous serez toujours accueilli chaleureusement ici. Tous nos vœux vous accompagnent.~ [ELLESI31] ~Quant à vous, j'imagine que vous avez hâte de reprendre votre périple. Nous vous souhaitons bonne chance. Sachez que vous serez toujours accueillie chaleureusement ici. Tous nos vœux vous accompagnent.~ [ELLESI31]
@55258 = ~Désolé, mais c'est fermé. Faudra revenir plus tard.~
@55259 = ~Salut, mon <PRO_LADYLORD>, et bienvenue au Salon de dame Galvena. En quoi puis-je vous servir ?~ ~Salut, ma <PRO_LADYLORD>, et bienvenue au Salon de dame Galvena. En quoi puis-je vous servir ?~
@55260 = ~Quelle sorte d'établissement est-ce ?~
@55261 = ~Euh... je suis un nouvel employé au service de la Dame. Comment puis-je entrer et la voir ?~ ~Euh... je suis une nouvelle employée au service de la Dame. Comment puis-je entrer et la voir ?~
@55262 = ~Euh... je suis un nouvel employé au service de la Dame. Comment puis-je entrer et la voir ?~ ~Euh... je suis une nouvelle employée au service de la Dame. Comment puis-je entrer et la voir ?~
@55263 = ~C'est le palais des délices romantiques ! Le meilleur de ce côté de la Côte des Épées ! Les courtisanes du Salon ne refusent jamais personne !~
@55264 = ~Épargnez-moi le baratin publicitaire. Je suis un nouvel employé. Comment est-ce que je rentre pour rencontrer Dame Galvena ?~ ~Épargnez-moi le baratin publicitaire. Je suis une nouvelle employée. Comment est-ce que je rentre pour rencontrer Dame Galvena ?~
@55265 = ~Problème animalier à Franc-Marché : je combattrai

J'ai parlé à Cernd de la Druidesse de l'ombre Faldorn. Il a dit que seul un autre druide pouvait la défier pour le contrôle du bosquet. Je me suis porté volontaire, et combattrai seul. Je l'informerai du résultat, si je survis...~ ~Problème animalier à Franc-Marché : je combattrai

J'ai parlé à Cernd de la Druidesse de l'ombre Faldorn. Il a dit que seul un autre druide pouvait la défier pour le contrôle du bosquet. Je me suis portée volontaire, et combattrai seule. Je l'informerai du résultat, si je survis...~
@55266 = ~Je m'incline. Vous avez prouvé votre supériorité aujourd'hui. Je... je vous abandonne la victoire.~
@55267 = ~Épargnez-moi le baratin publicitaire. Je suis un nouvel employé. Comment est-ce que je rentre pour rencontrer Dame Galvena ?~ ~Épargnez-moi le baratin publicitaire. Je suis une nouvelle employée. Comment est-ce que je rentre pour rencontrer Dame Galvena ?~
@55268 = ~C'est tout ce que je voulais. Adieu.~
@55269 = ~C'est le plus gros mensonge que j'ai jamais entendu. Écoutez, si vous voulez entrer, il y a deux courtisanes dehors, et vous aurez à payer pour leurs services, comme tout le monde.~
@55270 = ~Très bien, je m'en vais.~
@55271 = ~J'ai une preuve. Tenez ! Vous voyez ce médaillon ?~
@55272 = ~Voleur ! Je ne sais pas où vous l'avez eu, mais il ne vous servira à rien ! À la garde !~ ~Voleuse ! Je ne sais pas où vous l'avez eu, mais il ne vous servira à rien ! À la garde !~
@55273 = ~Merci d'avoir visité le Salon de dame Galvena.~
@55274 = ~L'idée de savourer ces délices m'intéresse.~
@55275 = ~Bien sûr ! À la porte de notre établissement, vous trouverez des courtisanes soigneusement choisies, telles que le monde n'en a jamais vu. Elles s'occuperont de vous en échange d'une très modique somme.~
@55276 = ~Ah oui, je vois le médaillon. L'un de nos nouveaux maîtres. Permettez-moi de vous ouvrir. Descendez trouver les gardes. Galvena vous recevra quand elle sera prête.~ ~Ah oui, je vois le médaillon. L'une de nos nouvelles maîtresses. Permettez-moi de vous ouvrir. Descendez trouver les gardes. Galvena vous recevra quand elle sera prête.~
@55277 = ~Je n'ai besoin de rien pour l'instant.~
@55278 = ~Gardes ! Des voleurs tentent d'entrer ! Tuez-les !~
@55279 = ~Profitez bien de votre visite à la salle des fêtes de dame Galvena !~
@55280 = ~Êtes-vous absolument sûr que je ne peux pas voir ce qu'il y a dans ce coffre ?~
@55281 = ~Êtes-vous absolument sûr que je ne peux pas voir ce qu'il y a dans le coffre ?~
@55282 = ~Dites, l'elfe vous a invoqué pour garder le coffre, ou son contenu ?~
@55283 = ~Un instant, créature. Dis-moi... ce sorcier d'elfe noir t'a demandé de garder le coffre ou ce qui est dans le coffre ?~
@55284 = ~Un instant. Je suis un peu curieux... Est-ce que cet elfe noir dont tu parles t'a demandé de garder ce coffre ou quoi que ce soit qui se trouve à l'intérieur ?~
@55285 = ~C'est ainsi que tout s'achève. Vous vous êtes montré très habile pour me trouver, bien que je ne me sois pas évertuée à me cacher. Bienvenue.~ [BODHIX39] ~C'est ainsi que tout s'achève. Vous vous êtes montrée très habile pour me trouver, bien que je ne me sois pas évertuée à me cacher. Bienvenue.~ [BODHIX39]
@55286 = ~Puis-je te poser une question maintenant, tyrannœil ? As-tu été invoqué pour garder le coffre ou simplement son contenu ?~
@55287 = ~Je suis persuadée que les raisons qui vous ont conduit ici sont très importantes à vos yeux. Mais épargnez-moi l'ennui de les entendre.~ ~Je suis persuadée que les raisons qui vous ont conduite ici sont très importantes à vos yeux. Mais épargnez-moi l'ennui de les entendre.~
@55288 = ~Hmmmm. Eh bien, si je me souviens bien, il a crié « mon coffre ». À ce moment-là, il s'est pris un épieu dans le buffet, alors ce n'est pas à ça qu'il devait se référer.~
@55289 = ~Je suppose qu'il voulait parler de CE coffre. Et cela veut dire que je ne peux pas vous laisser l'ouvrir... ou y toucher de quelque façon que ce soit... même si je ne garde pas son contenu.~
@55290 = ~Mais cela ne veut pas dire que VOUS ne pouvez pas l'ouvrir, n'est-ce pas ? Ainsi, je pourrais obtenir son contenu sans toucher à quoi que ce soit.~
@55291 = ~Problème animalier à Franc-Marché : nous combattrons ensemble

J'ai parlé à Cernd de la Druidesse de l'ombre Faldorn. Il a dit que seul un autre druide pouvait la défier pour le contrôle du bosquet. Je me suis porté volontaire et Cernd s'est joint à moi, bien que je serai seul pour l'affronter.~ ~Problème animalier à Franc-Marché : nous combattrons ensemble

J'ai parlé à Cernd de la Druidesse de l'ombre Faldorn. Il a dit que seul un autre druide pouvait la défier pour le contrôle du bosquet. Je me suis portée volontaire et Cernd s'est joint à moi, bien que je serai seule pour l'affronter.~
@55292 = ~Hé... tu pourrais ouvrir ce coffre pour nous. Il n'est rien que tu ne puisses accomplir, n'est-ce pas ? Alors, nous pourrions mettre la main sur son contenu ! Je suis génial ! Brillant !~
@55293 = ~Mais... Tu pourrais ouvrir le coffre, n'est-ce pas ? Nous n'aurions pas à le toucher, et nous pourrions néanmoins obtenir ce qu'il renferme.~
@55294 = ~Hé, vous avez probablement raison. Hmmm. En fait, je me demande aussi ce qu'il y a à l'intérieur. Écoutez... je réfléchis une minute et vous jetez un coup d'œil, d'accord ?~
@55295 = ~Do-de-dum-de-doo-de-dum-dum...~
@55296 = ~Hmf. C'est tout ? À entendre crier mon invocateur, on aurait cru que tout l'avenir de la race des elfes noirs en dépendait, ou quelque chose de ce genre...~
@55297 = ~*soupire* Je suppose qu'il va falloir que je me résigne à garder un coffre vide pendant les quarante prochaines années. Quelle joie...~
@55298 = ~Pourquoi ? Quel intérêt ?~
@55299 = ~J'en ai bien peur...~
@55300 = ~Ha ! En tant que sorcier, je peux te dire que l'elfe noir n'aurait jamais voulu cela. À quoi bon garder un coffre vide, tyrannœil ?~
@55301 = ~Vraiment ? À... à quoi bon, maintenant que le coffre est vide ? Qui... qui pourrait vouloir vous faire garder un coffre vide ?~
@55302 = ~Vraiment ? Vous deviez garder un coffre vide ? Pour quelle raison ? À quoi cela peut-il bien servir ? Même un de ces fous d'elfes noirs saurait ça.~
@55303 = ~Tu ne devrais pas avoir à faire ça. À quoi bon continuer de garder un coffre vide ? Ce serait complètement inutile, non ?~
@55304 = ~Huh. Vous savez... vous avez tout à fait raison. Même ce magicien elfe noir ne me demanderait pas de garder un coffre vide. Ce n'est même pas un joli coffre.~
@55305 = ~Ces grosses vessies pleines de vent du conseil des tyrannœils ne pourront pas me considérer comme responsable de ce contrat ! Je... je suis libre ! Libre ! Youpi !~
@55306 = ~Je m'incline. Vous avez prouvé votre supériorité aujourd'hui. Je... je vous abandonne la victoire.~
@55307 = ~Je m'incline. Vous avez prouvé votre supériorité aujourd'hui. Je... je vous abandonne la victoire.~
@55308 = ~Je m'incline. Vous avez prouvé votre supériorité aujourd'hui. Je... je vous abandonne la victoire.~
@55309 = ~Je m'incline. Vous avez prouvé votre supériorité aujourd'hui. Je... je vous abandonne la victoire.~
@55310 = ~Que faire, à présent ? Hmm. Tuer les diablotins... oui. Ces petites saletés méritent de mourir. Mais d'abord, manger quelque chose. Vous n'imaginez pas à quel point je peux être affamé.~
@55311 = ~Que faire, à présent ? Hmm. Ombre-Terre est tout près, n'est-ce pas ? Autrement dit, une jolie femelle tyrannœile ne doit pas être bien loin. Et cela signifie... oh, et puis... n'y pensez plus.~
@55312 = ~Hmm. Peut-être n'y suis-je pas obligé. Même ce mage elfe noir n'aurait pas voulu me forcer à garder un coffre vide, pas vrai ? Personne ne voudrait ! Ce n'est même pas un joli coffre.~
@55313 = ~Je suis venu pour le Rhynn Lanthorn, Bodhi. Vous ne m'échapperez pas cette fois-ci.~ ~Je suis venue pour le Rhynn Lanthorn, Bodhi. Vous ne m'échapperez pas cette fois-ci.~
@55314 = ~J'aurai ma vengeance pour ce que vous nous avez fait à moi et à Imoen. Vous allez payer pour vos crimes.~
@55315 = ~Comme si vos crimes envers moi n'étaient pas suffisants, vous avez mis en danger toute une cité elfe !~
@55316 = ~Eh bien, vous allez regarder dans ce coffre, alors ? Tss. Qu'est-ce qu'il faut, vous prendre par la main ? Ne comptez pas sur moi pour ça, tout ce que je peux faire, c'est un clin d'œil.~
@55317 = ~~
@55318 = ~Je n'ai pas l'intention de m'échapper. Nous voici réunis pour l'ultime bataille <CHARNAME> et j'ai bien l'intention de la savourer. J'ai l'intention de...~
@55319 = ~Cette vieille chanson ? Je suis lasse d'être jugée par ceux qui me sont inférieurs. D'abord Suldanessalar et maintenant vous. Ils... ils ont parlé du vol dans leur temple, n'est-ce pas ?~
@55320 = ~Servir est un grand honneur, et servir Heaum : le plus grand d'entre tous.~ [TELWYN01]
@55321 = ~Vous pouvez essayer, Imoen, mais vous échouerez. Nous avons travaillé longtemps pour accomplir notre vengeance et ce n'est pas vous qui allez nous en priver.~
@55322 = ~Le justicier t'anéantira ! Il saura s'occuper de votre sort !~ [TELWYN03]
@55323 = ~Non ! Non ! Elle est à moi ! Cette vie est à moi !~ [BODHIX41]
@55324 = ~Au plus profond de votre être s'agite un démon familier, s'extirpant des ténèbres. Il vous offre sa puissance... mais ce pouvoir a son prix. Acceptez-vous donc de sacrifier une part de vous-même ?~
@55325 = ~Oui. Malgré les périls que j'encours, j'accepte.~
@55326 = ~Non, ce monstre n'aura pas raison de moi. Jamais je ne renoncerai à la lutte.~
@55327 = ~Je me sens mieux, bien mieux. À nouveau entière.~ [IMOEN69]
@55328 = ~Merci pour ce que tu as fait. Je suis rétablie et... j'espère que nous pourrons bientôt dire la même chose de toi.~ [IMOEN70]
@55329 = ~Je vais adorer te détruire, <CHARNAME>. Mourir ici, c'est cesser d'exister !~
@55330 = ~Je t'ai déjà vaincu une fois, Irenicus. Tu n'as aucune chance.~
@55331 = ~Tu ne mérites pas mieux. Nous sommes ici aujourd'hui à cause de tes machinations.~
@55332 = ~Je suis dans ce lieu horrible à cause de toi. Tu vas le payer !~
@55333 = ~Que se passe-t-il, Irenicus ? Tu supportes mal la chaleur ? On dirait que tu as peur de cet endroit.~
@55334 = ~Je suis prêt à t'affronter. J'ai exploré les profondeurs de mon âme et je n'ai pas peur.~ ~Je suis prête à t'affronter. J'ai exploré les profondeurs de mon âme et je n'ai pas peur.~
@55335 = ~Oui, tu peux peut-être encore te concentrer sur toi, malgré la perte de ton âme. Mais je me connais bien aussi, et moi non plus je n'ai pas peur !~
@55336 = ~J'ai autant de chances que toi, <CHARNAME>. J'ai affronté mes démons dans cet enfer, et j'ai appris qu'il ne sont pas à craindre, j'en ai même engagé quelques-uns !~
@55337 = ~Je ne veux pas en être responsable. Non, pas cela. Mais les choses auraient pu être pires. Il y a des avantages à être ici, et c'est toi que je dois remercier pour cela.~
@55338 = ~Aussi horrible cet endroit soit-il, il n'est que le reflet de l'âme que nous partageons désormais. Rejette cela si tu le souhaites, mais j'ai appris à apprécier ce qu'elle avait à offrir.~
@55339 = ~Maintenant, bats-toi ! L'un de nous n'est pas vraiment mort, et s'il n'en reste qu'un, l'autre pourra être régénéré ! Je pourrai quitter cet endroit avec tout ce que j'en aurai pris !~
@55340 = ~Il n'y a qu'une seule issue possible. C'est ici que tu mourras, Irenicus. Je te le promets.~
@55341 = ~Je me régénérerai, mort ou vivant. Tu ne prendras pas ce qui m'appartient !~ ~Je me régénérerai, morte ou vivante. Tu ne prendras pas ce qui m'appartient !~
@55342 = ~Problème animalier à Franc-Marché : retour à la normale

Faldorn a été vaincue. Elle a été tuée dans un duel druidique, et le bosquet est maintenant libéré de son influence. Verthan a été nommé Maître des défis jusqu'à ce que le bosquet soit entièrement débarrassé de la souillure des Druides de l'ombre. Franc-Marché ne sera plus attaqué.~
@55343 = ~Je me moque de tes théories ! Tu vas mourir à nouveau, que tu sois déjà mort ou non !~
@55344 = ~Fais ce que tu dois faire, je ferai la même chose.~
@55345 = ~Nous verrons, <CHARNAME>. Nous verrons !~
@55346 = ~Ton âme n'a jamais été véritablement la tienne, enfant de Bhaal ! Tu devrais me laisser en faire meilleur usage !~
@55347 = ~Cette situation est étrange, mais je ne doute pas de son issue !~
@55348 = ~Tu seras moins calme quand j'effacerai à jamais ton existence !~
@55349 = ~L'Écorcheur a certes abdiqué, mais sa volonté l'emporte sur la vôtre et vous voici bien près de vous perdre vous-même. Car vous ne résisterez sans doute pas à une nouvelle métamorphose.~
@55350 = ~Ta compagnie me comblerait de joie. Sois le bienvenu !~
@55351 = ~Je serais ravi que tu m'accompagnes.~ ~Je serais ravie que tu m'accompagnes.~
@55352 = ~Ta compagnie me comblerait de joie. Sois le bienvenu !~
@55353 = ~Je suis à la recherche d'une fine lame, en effet.~
@55354 = ~Ma tâche ici est terminée. Mon enfant sera élevé par les druides de ce lieu jusqu'à ce que le temps soit venu pour lui de choisir ce qu'il fera de sa vie... Je pourrai revenir le voir régulièrement d'ici là.~ [CERND81]
@55355 = ~Je suis toujours prêt à voyager avec toi, si tel est ton désir, <CHARNAME>. Reprenons-nous la route ensemble ?~
@55356 = ~Certainement. Joins-toi à nous et partons.~
@55357 = ~Non, je crois que nous voyagerons sans toi pour le moment.~
@55358 = ~Il est parti parce qu'il avait peur ; peur de s'établir ici et d'abandonner sa nature adorée. Galia a accepté leur séparation pour ne pas « avoir à le retenir ».~
@55359 = ~Un bel homme, mais au regard froid. Il l'a mal traitée... et cela ne s'est pas amélioré lorsqu'elle a donné naissance. Cela s'est même dégradé pour être honnête.~
@55360 = ~S'il veut vraiment faire amende honorable, Deril est chez lui. C'est la maison la plus au sud, dans le quartier du gouvernement. Il est trop tard cependant, les dommages ont été faits il y a deux ans déjà.~
@55361 = ~Sanik a été assassiné avant de me dire comment entrer !~
@55362 = ~Bon, il a peut-être révélé ce qu'il savait à quelqu'un. Il y a forcément quelqu'un qui peut nous aider à entrer... trouvez-les ; car je ne connaissais personne, sauf Sanik.~
@55363 = ~Problème animalier à Franc-Marché : j'ai informé Cernd du dénouement

J'ai mis Cernd au courant du fin mot de l'histoire. Il a été très content, mais je ne sais toujours pas si je veux de lui dans mon groupe. Il est parti au bosquet, où je pourrai venir le trouver si le besoin se fait sentir.~
@55364 = ~Problème animalier à Franc-Marché : alliance avec Cernd

J'ai appris à Cernd comment j'avais résolu le problème des druides, et restauré l'équilibre dans la région. Il en a été très content, et m'a proposé de se joindre au groupe, car son travail est désormais terminé. Il sera un formidable atout pour le groupe.~
@55365 = ~Problème animalier à Franc-Marché : retour à l'équilibre

Faldorn a été vaincue selon les règles druidiques. La nature reprendra ses droits avec le temps, tout comme les citoyens de Franc-Marché. Cernd est désormais libéré de sa mission, et je l'ai accueilli avec plaisir dans mon groupe.~
@55366 = ~Problème animalier à Franc-Marché : retour à l'équilibre

Faldorn a été vaincue selon les règles druidiques. La nature reprendra ses droits avec le temps, tout comme les citoyens de Franc-Marché. Cernd est désormais libéré de sa mission, et je n'ai pas vu d'intérêt à sa présence permanente dans le groupe. Il va rester au bosquet, pour aider la nature à réparer les dégâts. Je pourrai l'y trouver, si jamais le besoin s'en fait sentir.~
@55367 = ~Tiax ? Tu ne devrais pas être mort ?~
@55368 = ~Général Sovalidaas~
@55369 = ~La cible ne détient aucun objet qui peut être volé par quelqu'un de votre talent.~
@55370 = ~Lacédon majeur~
@55371 = ~Lacédon majeur~
@55372 = ~Le sort profane de 8ème niveau Déclencheur de sorts est similaire au sort profane de 7ème niveau Séquenceur de sorts car cela permet au lanceur de stocker plusieurs sorts qui peuvent être lancés sur une même créature, ce qui inclut le lanceur. Les sorts stockés s'utilisent comme n'importe quels autres sorts et on peut y accéder grâce au bouton de capacités spéciales. Il est important de savoir que, lorsque vous choisissez les sorts à stocker, ceux-ci disparaissent de la liste de ceux que vous avez mémorisés. Cependant, ils durent jusqu'à ce qu'ils soient utilisés, ainsi le lanceur peut se reposer et mémoriser de nouveau ces sorts. La principale utilisation de ce sort est de permettre de lancer plusieurs sorts très rapidement en combat, sans qu'ils puissent être interrompus.~
@55373 = ~Les sorts de contingence tels que les sorts profanes de 6ème et 9ème niveau Contingence et Chaîne de contingences permettent au lanceur de stocker en lui des sorts. Ces derniers seront libérés en réaction à un événement spécifique. Par exemple, un lanceur peut stocker en lui un sort profane de 4ème niveau Peaux de pierre qui sera automatiquement lancé s'il tombe à moins de 50 % de ses points de vie. Dès que cela arrive, Peaux de pierre se déclenche alors sur le lanceur. Les possibilités d'utilisation de ces sorts ne sont limitées que par l'imagination du lanceur.~
@55374 = ~Séquenceur de sorts mineur~
@55375 = ~Déclencheur de sorts~
@55376 = ~Chaîne de contingences~
@55377 = ~~ [SNAKE01]
@55378 = ~~ [SNAKE02]
@55379 = ~~ [SNAKE03]
@55380 = ~~ [SNAKE04]
@55381 = ~~ [SNAKE06]
@55382 = ~~ [SNAKE07]
@55383 = ~~ [GRNDHG06]
