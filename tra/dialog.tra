@70695 = ~Bûcheron~
@70696 = ~*de la pierre émane une sensation de « bonté » qui se rétracte à votre toucher, envoyant une onde magique se répercuter dans la pièce tout entière*~
@70697 = ~Capitaine Egeissag~
@70698 = ~Capitaine Egeissag~
@70699 = ~Des primaires ! À l'attaque ! Ils feront de bons esclaves !~
@70700 = ~Capitaine de la garde~
@70701 = ~Capitaine de la garde~
