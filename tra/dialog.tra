@19183 = ~Puis-je vous aider ?~ [ALDET10]
@19184 = ~Ah ! C'est de la folie !~ [ALDET11]
@19185 = ~C'est de la folie ! Inutile de nous battre !~ [ALDET12]
@19186 = ~Monstre ! Ce n'est qu'un enfant ! À l'aide !~ [ALDET13]
@19187 = ~Je n'ai plus grand-chose à ajouter.~ [ALDET14]
@19188 = ~Je vous ai déjà tout dit. Rien n'a changé depuis.~ [ALDET15]
