@63318 = ~~
@63319 = ~Du calme, du calme. Je ne suis pas un démon. Regarde-moi bien...~
@63320 = ~Je ne suis pas ici pour te faire du mal. J'ai juste quelques questions à te poser.~
@63321 = ~Écarte-toi de mon chemin, elfe fou, ou je devrai te tuer !~
@63322 = ~*cette torche n'est pas allumée... si vous avez un peu d'huile, un silex et du petit bois, vous pourrez l'allumer... que souhaitez-vous faire ?*~
@63323 = ~*la torche brûle avec une flamme rouge... vous pouvez l'éteindre, si vous le souhaitez... que décidez-vous ?*~
@63324 = ~*la torche brûle avec une flamme bleue... vous pouvez l'éteindre, si vous le souhaitez... que décidez-vous ?*~
@63325 = ~*la torche brûle avec une flamme violette... vous pouvez l'éteindre, si vous le souhaitez... que décidez-vous ?*~
@63326 = ~*vous laissez la torche comme ça pour l'instant*~
@63327 = ~*vous éteignez la torche*~
@63328 = ~Je vais faire un peu plus que te blesser, folle créature.~
