@23862 = ~Avez-vous entendu l'appel ?~
@23863 = ~Au secours Seigneur Aec !~
@23864 = ~Vos âmes seront damnées !~
@23865 = ~Patience n'est que prélude à la puissance... bientôt.~
@23866 = ~~
@23867 = ~~
@23868 = ~Bienvenue à l'Éveil ! Vos âmes nourriront celui qui va apparaître.~
@23869 = ~~
@23870 = ~Pour Aec ! Ici, nous servons ou nous mourrons !~
@23871 = ~Une nouvelle ère commence ! À genoux devant le nouveau seigneur !~
@23872 = ~~
@23873 = ~~
@23874 = ~Avancez, avancez ! N'hésitez pas !~ [IKEEE_01]
@23875 = ~Je paierai le double pour en voir la fin maintenant !~ [IKEEE_02]
@23876 = ~Vous allez voir de quel bois je me chauffe ! C'est le moment de poinçonner le ticket que je vous ai vendu !~ [IKEEE_03]
@23877 = ~Il naît un demeuré à chaque minute, et vous voilà juste à l'heure !~ [IKEEE_04] ~Il naît une demeurée à chaque minute, et vous voilà juste à l'heure !~ [IKEEE_04]
@23878 = ~Aaaaaaah !~ [IKEEE_05]
@23879 = ~Aaaah ! Ahhhh, AAAAAAAHHH...~ [IKEEE_06]
@23880 = ~Vous n'habitez pas ici. Je ne suis pas sûr que vous le pourriez.~
@23881 = ~~
@23882 = ~Vous êtes venu nous tuer !~
@23883 = ~Vous ne salirez pas la réputation du village !~
@23884 = ~~
