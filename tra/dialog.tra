@103429 = ~Sure thing!~ [bdtpehj]
@103430 = ~Can do!~ [bdtpehk]
@103431 = ~No problem!~ [bdtpeh04]
@103432 = ~Consider it done!~ [bdtpeh05]
@103433 = ~Yup, yup, yup!~ [bdtpeh06]
@103434 = ~You betcha!~ [bdtpeh07]
@103435 = ~Hooee!~ [bdtpehl]
@103436 = ~Ooh! Ahhh...~ [bdtpehm]
@103437 = ~I hope there's something good down here.~ [bdtpehp]
@103438 = ~Hmm, what a beautiful morning.~ [bdtpehq]
@103439 = ~*yawn* I'm more of a morning person.~ [bdtpehr]
@103440 = ~This quest isn't keeping you busy enough.~ [bdtpeh15]
@103441 = ~Hey! Stop that!~ [bdtpeh16]
@103442 = ~Yes!~ [bdtpehz]
@103443 = ~Er, whoops!~ [bdtpeh1]
@103444 = ~Time for something else!~ [bdtpeh2]
@103445 = ~I'm out of pockets! Sorry!~ [bdtpeh3]
@103446 = ~I'll take that off your hands.~ [bdtpeh4]
@103447 = ~Like a sneaky little... thing that sneaks.~ [bdtpeh5]
@103448 = ~Gah! Lost the spell!~ [bdtpeh6]
@103449 = ~Trap's down. Er, watch your feet.~ [bdtpeh7]
@103450 = ~I like you. You're fun.~ [bdtpeh10]
@103451 = ~It's harder to do the right thing, but we should at least try.~ [bdtpeh11]
@103452 = ~If this gets much worse, I'm outta here.~ [bdtpeh12]
@103453 = ~That's it! I'm done!~ [bdtpeh13]
@103454 = ~Nope! Nope, nope, nope!~ [bdtpeh14]
@103455 = ~I'll remember you.~ [bdtpehw]
@103456 = ~Aaaaaaaah!~ [bdtpsda]
