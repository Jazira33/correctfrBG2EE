@88890 = ~Aaah !~ [female1l]
@88891 = ~Ahhh, aaaah...~ [female1m]
@88892 = ~D'accord.~ [female1s]
@88893 = ~C'est bien ce que je pensais.~ [female1t]
@88894 = ~N'est-ce pas fantastique ? Ne me demande pas combien de cils j'ai dû m'arracher pour que cela fonctionne.~ [OH88894]
@88895 = ~Facile.~ [female1u]
@88896 = ~Pas de problème.~ [female1v]
@88897 = ~Oui ?~ [female1x]
@88898 = ~Que puis-je faire ?~ [female1y]
@88899 = ~Ahhh, Hahaha !~ [female1z]
@88900 = ~Hahhhahaha, hahahahahahahahahahahaha, hahahahahahahahahahaha !~ [female2a]
@88901 = ~Tout le monde y trouvera son compte.~ [female2b]
@88902 = ~J'ai vraiment besoin de repos, vous savez.~ [female2c]
@88903 = ~Tout cela ne mène nulle part. Il faut... faire quelque chose.~ [female2d]
@88904 = ~Il faudrait panser mes blessures.~ [female2e]
@88905 = ~Hmmm ?~ [female2f]
@88906 = ~J'attends.~ [female2g]
@88907 = ~Oui ?~ [female2h]
@88908 = ~Aucun problème.~ [female2i]
@88909 = ~Très bien.~ [female2j]
@88910 = ~Tout ce que tu voudras.~ [female2k]
@88911 = ~Bien entendu.~ [female2s]
@88912 = ~Bien sûr.~ [female2t]
@88913 = ~Si c'est ce que tu veux...~ [female2u]
@88914 = ~Il en sera fait selon tes désirs.~ [female2v]
@88915 = ~Aaah !~ [female2l]
@88916 = ~Oooohhh, oh...~ [female2m]
@88917 = ~Que puis-je faire ?~ [female2x]
@88918 = ~À qui le dis-tu ?~ [female2y]
@88919 = ~Ah, aïe ! Uh, cela doit faire mal ?!~ [female2z]
@88920 = ~Le Concocteur~
@88921 = ~Arzol~
@88922 = ~Beryl~
@88923 = ~Z'êtes qui, vous ? Oh, c'la n'a aucune importance. Ça vous tente un whiskey ? Bien sûr qu'ça vous tente !~ [OH88923]
@88924 = ~Vous vendez des boissons ?~
@88925 = ~Je n'ai pas besoin d'une boisson pour le moment, mais j'aurais quelques questions à vous poser.~
@88926 = ~Mes excuses, mais je n'ai pas le temps pour le moment.~
@88927 = ~Mon nom à moi, c'est Mironda. Contente d'faire vot' connaissance. J'suis pas douée avec les noms, donc si z'arrivez à retenir l'mien, vous m'avez déjà battue. J'ai oublié l'vôt' dès z'avez prononcé la première syllabe.~ [OH88927]
@88928 = ~Nan, j'essaye juste d'faire garder l'moral au camp gratuitement, j'vends rien. Y a rien à faire dans ces bois à part boire et faire comme les bêtes font, mais y a pas d'bêtes ici, juste des idiots, si vous voyez c'que j'veux dire. Comme ma mère l'disait si bien : « La boisson est mon mari, la boisson est mon seigneur, et la boisson est mon rencard quand j'm'ennuie ».~ [OH88928]
@88929 = ~J'ai quelques questions pour vous si ça ne vous ennuie pas.~
@88930 = ~Je vois. Bien, ce fut bon de vous avoir rencontrée, mais je dois y aller.~
@88931 = ~Ouais, z'êtes ici pour affaires, j'vois bien. On aurait ben b'soin de plus d'gens comme vous ici, c'est moi qui vous l'dit.~ [OH88931]
@88932 = ~Allez-y, j'vous écoute !~ [OH88932]
@88933 = ~Vous êtes une naine ET une entropiste ? Je n'ai jamais entendu parler d'une telle chose.~
@88934 = ~Comment vous êtes-vous retrouvée ici ?~
@88935 = ~Vous buvez pas mal, hein ?~
@88936 = ~En fait, je dois y aller. Au revoir.~
@88937 = ~Ouais, c'est pas commun. Mais z'avez entendu parler des nains qui aiment picoler, j'suis sûre, donc j'ai à moitié bon, hein ?~ [OH88937]
@88938 = ~Je ne voulais pas vous offenser.~
@88939 = ~Ou à moitié tort !~
@88940 = ~Peut-être. Laissez-moi vous demander autre chose.~
@88941 = ~Je n'le suis pas, z'inquiétez pas ! J'plaisantais juste avec vous.~ [OH88941]
@88942 = ~Bon, pour répondre à vot' question, j'sais pas pourquoi, mais depuis qu'j'suis toute jeune, j'ai toujours voulu qu'deux choses plus que tout : faire valser mes adversaires et de la bibine, forte et infinie. Et j'avais du talent, ouaip' ! Un talent rare ! Un talent ENTROPIQUE. J'ai bien perdu mon clan à cause d'ça, mais y a de ces échanges qu'en valent la peine.~ [OH88942]
@88943 = ~C'est tout, où z'avez aut' chose à m'demander ?~ [OH88943]
@88944 = ~J'ai une autre question pour vous, en fait.~
@88945 = ~Non, ce sera tout. Au revoir.~
@88946 = ~Ouh, z'avez d'la répartie ! Une langue bien affilée ! ÇA, c'est c'que j'aime chez quelqu'un !~ [OH88946]
@88947 = ~C't'une sacré histoire. J'vais vous la faire courte. J'étais une des premières qu'Telana et Neera ont sauvée. J'étais d'jà dans les griffes d'l'Ordre lorsqu'ces deux-là ont pris mes gardes d'chaque côté et ont déchaîné la magie la plus folle qu'j'aie jamais vu, un truc à laisser les cieux sans dessus-dessous !~ [OH88947]
@88948 = ~La Rupture hasardeuse de Nahal est un sacré sort, j'vous l'dis, moi ! Enfin bref, j'me suis retrouvée ici assez rapidement après ça.~ [OH88948]
@88949 = ~J'en suis pas à ma première boisson, ça c'est sûr. Ha, j'vois bien c'regard. J'en suis pas à ma PREMIÈRE, mais ça va, j'dépasse pas les limites. Enfin, tout est dans mes limites, pour peu qu'ça contienne plus qu'un dé à coudre. Donc, j'suis comme tous les nains, vraiment. À l'exception p'têt' d'une chose...~ [OH88949]
@88950 = ~P'têt' que c'est l'entropiste en moi qui parle mais j'peux pas supporter d'pas goûter à quelqu'chose d'nouveau d'temps en temps. La plupart des nains s'contentent d'la même bibine de montagne du berceau au tombeau, mais moi, j'suis toujours à la r'cherche des derniers brassages. L'vieux Vyatri à Franc-Marché v'nait tout juste d'recevoir un arrivage de Luiren que j'payerais cher pour goûter. Si jamais vous passiez par chez lui pendant vos aventures, prenez-moi un tonneau et j'vous récompenserai comme y faut.~ [OH88950]
@88951 = ~Z'êtes d'retour à c'que j'vois. Qu'est-ce que j'peux faire pour vous ?~ [OH88951]
@88952 = ~J'espérais pouvoir vous poser quelques questions.~
@88953 = ~J'ai la bière de chez Vyatri que vous m'avez demandée.~
@88954 = ~Rien pour le moment. Au revoir.~
@88955 = ~J'vois ça ! Vous m'avez amené la marchandise ! J'vais prendre ça, merci beaucoup. Hâte de la goûter ! La Providence des petites-gens, qu'ça s'appelle, j'espère qu'ça fait effet sur les nains aussi.~ [OH88955]
@88956 = ~Il n'y a pas de quoi, Mironda.~
@88957 = ~Pas de problème, Mironda, cela ne nous a quasiment rien coûté.~
@88958 = ~J'espérais recevoir quelque chose en retour...~
@88959 = ~J'vous ai pas d'mandé d'me ramener un tonneau jusqu'ici juste pour vous faire faire d'l'exercice ! J'sais pas si j'vous l'ai dit, mais j'ai pas la mémoire des noms. J'suis pas douée pour tous c'qui requiert de la mémoire, à part la magie.~ [OH88959]
@88960 = ~Arrêtez vot' char, j'suis sûre qu'ça vous a coûté quelqu'chose.~ [OH88960]
@88961 = ~Mais bien sûr, bien sûr !~ [OH88961]
@88962 = ~Mais j'ai r'demandé à Telana c'était quoi l'vôt', et elle m'l'a dit. Donc j'me suis dis qu'puisque vous essayez d'm'aider et tout, j'devrais quand même faire un effort pour m'en souv'nir un peu mieux, voyez ? Donc j'ai fait ça, pour qu'on puisse trinquer ensemb' si jamais vous rev'niez avec la bière.~ [OH88962]
@88963 = ~Mais c'est une chope ! Une chope avec mon nom dessus !~
@88964 = ~Ce n'est pas vraiment ce à quoi je m'attendais, mais merci.~
@88965 = ~C'est ça ma récompense ? Je devrais vous asséner un coup sur la tête avec !~
@88966 = ~C'est c'la, c'est c'la !~ [OH88966]
@88967 = ~Ah non ? Eh beh, si y a ben une chose qu'j'ai apprise en tant qu'entropiste, c'est d's'attendre à l'inattendu !~ [OH88967]
@88968 = ~Nan ! Faites pas ça, vous m'tueriez ! Si c'était n'importe quelle aut' chope, p'têt que j'survivrais, après tout, j'en suis pas à ma première bagarre d'bistrot...~ [OH88968]
@88969 = ~Mais celle-ci, c'n'est pas n'importe quelle chope ! Cognor m'a filé un coup d'main pour la faire. Y a d'la magie entropique dedans. Utilisez-la sagement. Ha ha, j'plaisante, bien sûr ! Utilisez-la quand bon vous semblera, parbleu !~ [OH88969]
@88970 = ~Qu'est-ce que vous regardez ? Circulez, et emmenez cette demi-elfe avec vous.~
@88971 = ~Hors de mon chemin, mercenaire. Nous avons affaire avec tes employeurs.~
@88972 = ~Je sais ce qu'est ce lieu. Je veux me procurer de la marchandise.~
@88973 = ~J'ai bien peur de ne pas pouvoir faire cela. Ce n'est pas contre vous, mais aucun serviteur des Sorciers Rouges ne quittera ce lieu vivant.~
@88974 = ~Je suis bien d'accord !~ [OH88974]
@88975 = ~Laisse-nous entrer. Maintenant.~ [OH88975]
@88976 = ~Et quelle est cette affaire, au juste ? S'ils embauchaient des filles dans votre genre pour venir nous rendre visite, je serais au courant.~
@88977 = ~Un mot de plus, et je fais prendre l'air à tes tripes. Vas-y. Juste UN mot.~ [OH88977]
@88978 = ~Écoutez-la. Fuyez maintenant, cet endroit est sur le point de disparaître.~
@88979 = ~Du calme, Neera... Écoutez. Laissez-nous entrer et nous ne vous ferons pas de mal.~
@88980 = ~Laisse-moi gérer ça, Neera. Vous me paraissez être un homme raisonnable. Pour combien nous laisseriez-vous rentrer ?~
@88981 = ~Je m'en occupe, Neera. Je vais le charmer.~
@88982 = ~Il en a déjà trop dit.~
@88983 = ~Vous pensez que vous pouvez simplement...~
@88984 = ~Je l'avais prévenu de ne pas dire un mot de plus.~ [OH88984]
@88985 = ~Comment as-tu fait ça ?~
@88986 = ~Neera ! Qu-qu'est-ce qui t'a pris ?~
@88987 = ~Impressionnant. Continuons.~
@88988 = ~Avec un hiatus entropique, pardi. Entrons donc.~ [OH88988]
@88989 = ~Vu comme ça, je pense que...~
@88990 = ~D'accord, c'est compris.~
@88991 = ~Nous ne sommes pas ouverts pour le moment.~
@88992 = ~Nous n'en avons, comme qui dirait, vraiment RIEN à cirer.~ [OH88992]
@88993 = ~Curell de Tempus~
@88994 = ~Molzahn de Tymora~
@88995 = ~Laris de Garagos~
