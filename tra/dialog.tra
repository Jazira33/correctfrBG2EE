@61723 = ~Monstre ! Sycophante !~ [GPRIF08]
@61724 = ~Je vous accueille à bras ouverts.~ [GPRIM01]
@61725 = ~Je gage que vous venez en toute bonne foi.~ [GPRIM02]
@61726 = ~Que les dieux vous soient favorables.~ [GPRIM03]
@61727 = ~Tous les fidèles sont les bienvenus ici.~ [GPRIM04]
@61728 = ~~
