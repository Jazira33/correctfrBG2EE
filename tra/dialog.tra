@17118 = ~Pause automatique : cible disparue~
@17119 = ~Passage au niveau supérieur~ [GAM_11]
@17120 = ~Échec du camouflage dans l'ombre~
@17121 = ~Ouille... Pardon, meuh !~ [AMB_E42C]
