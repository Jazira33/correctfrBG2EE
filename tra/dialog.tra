@2181  = ~*maintenant que le golem a été activé, cette machine ne sert plus à rien*~
@2182  = ~*le golem est transporté hors de la machine au moment où il commence à s'éveiller*~
@2183  = ~Orbe ancien~
@2184  = ~Rôdeur~
@2185  = ~Rôdeur~
@2186  = ~Llarsh~
@2187  = ~Llarsh~
@2188  = ~Hervo~
