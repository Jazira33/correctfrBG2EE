@103475 = ~Of course.~ [bdtpsd07]
@103476 = ~Oh!~ [bdtpsdl]
@103477 = ~Aaah...~ [bdtpsdm]
@103478 = ~This is a dark place. Tread carefully.~ [bdtpsdp]
@103479 = ~What a beautiful morning.~ [bdtpsdq]
@103480 = ~Light fades, and night is upon us.~ [bdtpsdr]
@103481 = ~Perhaps you should take up a hobby.~ [bdtpsd15]
@103482 = ~Very amusing. I'll remember that one for later.~ [bdtpsd16]
@103483 = ~Take that!~ [bdtpsdz]
@103484 = ~Oops.~ [bdtpsd1]
@103485 = ~My weapon is no use!~ [bdtpsd2]
@103486 = ~I'm sorry, I can't carry any more.~ [bdtpsd3]
@103487 = ~I need this more than you do.~ [bdtpsd4]
@103488 = ~Careful and quiet.~ [bdtpsd5]
@103489 = ~I lost my spell!~ [bdtpsd6]
@103490 = ~The trap is laid.~ [bdtpsd7]
@103491 = ~I am proud to fight at your side.~ [bdtpsd10]
@103492 = ~Heroes should do better.~ [bdtpsd11]
@103493 = ~If you do not change your course, we will have to part ways.~ [bdtpsd12]
@103494 = ~I can no longer stand beside you. Farewell.~ [bdtpsd13]
@103495 = ~Oh no! No, no, no!~ [bdtpsd14]
@103496 = ~Sleep well, my friend.~ [bdtpsdw]
@103497 = ~Take them down!~ [bdtptoa]
@103498 = ~Aaaaaaaaaaaah!~ [bdtpto8]
@103499 = ~Into the fray!~ [bdtpto9]
@103500 = ~For blood and battle!~ [bdtpto00]
@103501 = ~*yawn* I will be sharper once I've rested.~ [bdtptoc]
@103502 = ~Are we to stand around all day? There are better uses of my time.~ [bdtptod]
@103503 = ~I'm bleeding out!~ [bdtptoe]
@103504 = ~Yes?~ [bdtptof]
@103505 = ~What?~ [bdtptog]
@103506 = ~Your command?~ [bdtptoh]
@103507 = ~Speak.~ [bdtpto0]
@103508 = ~Quickly, now.~ [bdtpto02]
@103509 = ~You have my attention.~ [bdtpto03]
@103510 = ~Agreed.~ [bdtptoi]
@103511 = ~Very well.~ [bdtptoj]
@103512 = ~I'll do it.~ [bdtptok]
@103513 = ~A simple task.~ [bdtpto04]
@103514 = ~Easily done.~ [bdtpto05]
@103515 = ~If you insist.~ [bdtpto06]
@103516 = ~I hear you.~ [bdtpto07]
@103517 = ~Ooh!~ [bdtptol]
@103518 = ~Ooh! Aah... ooh... ahhhh...~ [bdtptom]
@103519 = ~I sense many dangers in this place.~ [bdtptop]
@103520 = ~We live to see another dawn.~ [bdtptoq]
@103521 = ~The shadows hide many things. Watch yourself.~ [bdtptor]
@103522 = ~You are like a needy child.~ [bdtpto15]
@103523 = ~They'll find your body in the river.~ [bdtpto16]
@103524 = ~Yeeaahrrgh!~ [bdtptoz]
@103525 = ~Gods damn it!~ [bdtpto1]
@103526 = ~Useless!~ [bdtpto2]
@103527 = ~Huh, where would I put that?~ [bdtpto3]
@103528 = ~I have need of this.~ [bdtpto4]
@103529 = ~I will be as a shadow.~ [bdtpto5]
@103530 = ~Damn! My spell!~ [bdtpto6]
@103531 = ~I've lain a trap.~ [bdtpto7]
@103532 = ~I've traveled with many adventurers. And you are among the finest.~ [bdtpto10]
@103533 = ~We might want to watch our backs.~ [bdtpto11]
@103534 = ~If you continue on this path, it will soon diverge from mine.~ [bdtpto12]
@103535 = ~I have better things to do than waste my time here.~ [bdtpto13]
@103536 = ~There's no victory here! Retreat!~ [bdtpto14]
@103537 = ~We will honor your sacrifice.~ [bdtptow]
@103538 = ~No! No, no, wait—!~ [bdtpam01]
@103539 = ~I think someone more expendable should be the leader.~ [bdtpamb]
@103540 = ~Did you know that the vast majority of vicious, man-eating beasts live outdoors? We should go back inside.~ [bdtpamn]
@103541 = ~Ah, civilization. Good food, comfortable beds, heavily fortified walls...~ [bdtpamo]
@103542 = ~« Bhaalspawn » sounds a bit rude, when you think about it.~ [bdtpam08]
@103543 = ~We really should visit Waterdeep sometime. I have some very influential friends there.~ [bdtpam09]
@103544 = ~I could use a bloodbath!~ [bdtpbe01]
@103545 = ~I am a fair master, as long as my needs are served by being fair.~ [bdtpbeb]
@103546 = ~Fresh air, birdsong, wind whistling through the branches... I despise it all.~ [bdtpben]
@103547 = ~I see the rivvin are still breeding like bunnies.~ [bdtpbeo]
@103548 = ~Exit, pursued by an owlbear.~ [bdtpbe08]
@103549 = ~That treacherous Thayan stole my bit! I should sue!~ [bdtpbe09]
@103550 = ~Face me and despair!~ [bdtpag01]
@103551 = ~The power! THE POWER! Huhahahahahahahahahahaha!~ [bdtpagb]
@103552 = ~Burn it all to the ground.~ [bdtpagn]
@103553 = ~Who's a pretty kitty? Who's a pretty ki— *ahem*~ [bdtpago]
@103554 = ~RICHARD!~ [bdtpag08]
@103555 = ~It's all fun and games until a beholder disintegrates you.~ [bdtpag09]
@103556 = ~Eat it!~ [bdtpdg01]
@103557 = ~Taking the lead. All right.~ [bdtpdgb]
@103558 = ~Squirrels. Can't trust them.~ [bdtpdgn]
@103559 = ~Watch your backs. Oh, and your pockets.~ [bdtpdgo]
@103560 = ~Hey! Watch where you're putting that thing.~ [bdtpdg08]
@103561 = ~Fan... wait for it... tastic.~ [bdtpdg09]
