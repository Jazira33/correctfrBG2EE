@23839 = ~~
@23840 = ~Votre sang agrémentera mon dîner !~
@23841 = ~Donnez-moi juste une excuse pour vous arracher les membres.~
@23842 = ~~
@23843 = ~~
@23844 = ~Je dois vous parler. Écoutez-moi s'il vous plaît.~
@23845 = ~~
@23846 = ~Votre vie n'a plus de valeur ! Vous allez mourir !~
@23847 = ~J'ai attendu pendant longtemps quelqu'un tel que vous.~
