@103245 = ~AoN Baeloth (anglais)~
@103246 = ~AoN Andrew (anglais)~
@103247 = ~AoN Dan (anglais)~
@103248 = ~AoN Elyse (anglais)~
@103249 = ~AoN Sarah (anglais)~
@103250 = ~AoN Trent (anglais)~
@103251 = ~Have at you!~ [bdtpama]
@103252 = ~Advance! I'll stay back here.~ [bdtpam8]
@103253 = ~The best defense is an overwhelming offense!~ [bdtpam9]
@103254 = ~Wuhahahaa!~ [bdtpam00]
@103255 = ~*yawn* Some of us need our beauty sleep, you know.~ [bdtpamc]
@103256 = ~I adore tedium. It's vastly preferable to screaming and running for our lives.~ [bdtpamd]
@103257 = ~Argh! I want to live!~ [bdtpame]
@103258 = ~Yes?~ [bdtpamf]
@103259 = ~At your service.~ [bdtpamg]
@103260 = ~Ah! Hello.~ [bdtpamh]
@103261 = ~Hmm?~ [bdtpam0]
@103262 = ~What is it?~ [bdtpam02]
@103263 = ~You called?~ [bdtpam03]
@103264 = ~Of course.~ [bdtpami]
@103265 = ~If you insist.~ [bdtpamj]
@103266 = ~Indeed.~ [bdtpamk]
@103267 = ~Eh, fine.~ [bdtpam04]
@103268 = ~Ehh... ehm...~ [bdtpam05]
@103269 = ~All right, all right.~ [bdtpam06]
@103270 = ~Very well.~ [bdtpam07]
@103271 = ~Aaaah!~ [bdtpaml]
@103272 = ~Ooh! Oooh... Aooh... ohhh...~ [bdtpamm]
@103273 = ~This place reminds me of my dear departed friend... er... what was his name...~ [bdtpamp]
@103274 = ~As Uncle Marthur used to say, « Any day you live through is a good one. »~ [bdtpamq]
@103275 = ~Another day ended, and we haven't died horribly. I call that a success.~ [bdtpamr]
@103276 = ~You remind me of my cousin Kadina. She's also infuriating.~ [bdtpam15]
@103277 = ~Do you want something? An autograph, perhaps?~ [bdtpam16]
@103278 = ~Aha! Take that!~ [bdtpamz]
@103279 = ~Oh dear.~ [bdtpam1]
@103280 = ~Not working! Not working at all!~ [bdtpam2]
@103281 = ~Stop handing me things. Do I look like I'm made of hands?~ [bdtpam3]
@103282 = ~Possession is nine tenths of the law, you know.~ [bdtpam4]
@103283 = ~Ah, yes. Hiding. My second-favorite tactic.~ [bdtpam5]
@103284 = ~I didn't want to cast that spell anyway.~ [bdtpam6]
@103285 = ~I've laid a very cunning trap. Don't blunder through it.~ [bdtpam7]
@103286 = ~At last, the recognition I deserve.~ [bdtpam10]
@103287 = ~I don't have the best reputation, but I'd prefer not to make it worse.~ [bdtpam11]
@103288 = ~Perhaps I should make the important choices from now on.~ [bdtpam12]
@103289 = ~I just remembered I'm needed elsewhere. Must dash.~ [bdtpam13]
@103290 = ~Fortune favors the prudent!~ [bdtpam14]
@103291 = ~Alas, poor... er... whatever.~ [bdtpamw]
@103292 = ~Batter them into bloody rubbish!~ [bdtpbea]
@103293 = ~Let the battle begin!~ [bdtpbe8]
@103294 = ~Ah, the thrill of the fray!~ [bdtpbe9]
@103295 = ~Nuhu haha haha haaa!~ [bdtpbe00]
@103296 = ~*yawn* If we're not going to make camp any time soon, the least you can do is carry me.~ [bdtpbec]
@103297 = ~This is no fun. Start killing things already!~ [bdtpbed]
@103298 = ~Gah! Minions! Aid your master!~ [bdtpbee]
@103299 = ~Yes?~ [bdtpbef]
@103300 = ~What?~ [bdtpbeg]
@103301 = ~Eh?~ [bdtpbeh]
@103302 = ~Hm?~ [bdtpbe0]
@103303 = ~What now?~ [bdtpbe02]
@103304 = ~Mmmm?~ [bdtpbe03]
@103305 = ~Oh, if you insist.~ [bdtpbei]
@103306 = ~A sound suggestion.~ [bdtpbej]
@103307 = ~Easy enough.~ [bdtpbek]
@103308 = ~Only because you asked nicely.~ [bdtpbe04]
@103309 = ~An intriguing proposal.~ [bdtpbe05]
@103310 = ~Yes, yes, fine.~ [bdtpbe06]
@103311 = ~*sigh*~ [bdtpbe07]
@103312 = ~Aaaah!~ [bdtpbel]
@103313 = ~Ahhrr! Ahhhh...~ [bdtpbem]
@103314 = ~Finally! Someplace livable!~ [bdtpbep]
@103315 = ~Eugh. Sunlight.~ [bdtpbeq]
@103316 = ~The surface is almost tolerable at this hour.~ [bdtpber]
@103317 = ~You are beginning to bother me.~ [bdtpbe15]
@103318 = ~What is it, you preposterously petulant persnicket?~ [bdtpbe16]
@103319 = ~Ooh, that felt good.~ [bdtpbez]
@103320 = ~Arrgh!~ [bdtpbe1]
@103321 = ~Inconceivable! It's immune!~ [bdtpbe2]
@103322 = ~A gift? For me? Someone else can carry it.~ [bdtpbe3]
@103323 = ~Pocket picked.~ [bdtpbe4]
@103324 = ~Subterfuge is my strong suit.~ [bdtpbe5]
@103325 = ~Oh, confound it!~ [bdtpbe6]
@103326 = ~I've set a trap. Off you go, bait.~ [bdtpbe7]
@103327 = ~I picked well when I picked you as my minions.~ [bdtpbe10]
@103328 = ~Er, do you take constructive criticism?~ [bdtpbe11]
@103329 = ~I may have miscalculated in joining this venture.~ [bdtpbe12]
@103330 = ~I've had enough of this pathetic pack of peripatetics!~ [bdtpbe13]
@103331 = ~No, no, no, no, no!~ [bdtpbe14]
@103332 = ~Oh. I suppose we'll need a replacement.~ [bdtpbew]
@103333 = ~Haaargh! Death comes for you!~ [bdtpaga]
@103334 = ~Oaaaah!~ [bdtpag8]
@103335 = ~To arms!~ [bdtpag9]
@103336 = ~Suffer!~ [bdtpag00]
@103337 = ~*sigh* I grow weary. We should make camp.~ [bdtpagc]
@103338 = ~You're boring me. You won't like what I do when I'm bored.~ [bdtpagd]
@103339 = ~I can't stand much more!~ [bdtpage]
@103340 = ~Yes?~ [bdtpagf]
@103341 = ~What is your will?~ [bdtpagg]
@103342 = ~What?~ [bdtpagh]
@103343 = ~Hm?~ [bdtpag0]
@103344 = ~Speak.~ [bdtpag02]
@103345 = ~Give me a task.~ [bdtpag03]
@103346 = ~Fine.~ [bdtpagi]
@103347 = ~It will be done.~ [bdtpagj]
@103348 = ~Very well.~ [bdtpagk]
@103349 = ~Indeed.~ [bdtpag04]
@103350 = ~If you insist.~ [bdtpag05]
@103351 = ~Simple enough.~ [bdtpag06]
@103352 = ~Hrm.~ [bdtpag07]
@103353 = ~Oaah!~ [bdtpagl]
@103354 = ~Ouch! Aahhh...~ [bdtpagm]
@103355 = ~Take comfort; the most frightening thing down here is me.~ [bdtpagp]
@103356 = ~I prefer to work in the dark.~ [bdtpagq]
@103357 = ~The night hides all sorts of things.~ [bdtpagr]
@103358 = ~Time for my afternoon tea.~ [bdtpag15]
@103359 = ~Disappointed!~ [bdtpag16]
@103360 = ~Huhahahahahaha!~ [bdtpagz]
@103361 = ~Urgh! You didn't see that.~ [bdtpag1]
@103362 = ~This weapon is useless!~ [bdtpag2]
@103363 = ~I will carry no more!~ [bdtpag3]
@103364 = ~I have it.~ [bdtpag4]
@103365 = ~They won't see me coming.~ [bdtpag5]
@103366 = ~My magic has failed me!~ [bdtpag6]
@103367 = ~I've lain a trap.~ [bdtpag7]
@103368 = ~It is better to be feared than respected, but respect is also acceptable.~ [bdtpag10]
@103369 = ~The peasants are laughing at you.~ [bdtpag11]
@103370 = ~You are proving yourself unworthy of my allegiance.~ [bdtpag12]
@103371 = ~To the hells with you! I'm leaving!~ [bdtpag13]
@103372 = ~Not like this!~ [bdtpag14]
@103373 = ~A worthy sacrifice.~ [bdtpagw]
@103374 = ~Aaaaaaaah!~ [bdtpdga]
@103375 = ~I guess this is happening!~ [bdtpdg8]
@103376 = ~Here we go!~ [bdtpdg9]
@103377 = ~Take 'em down!~ [bdtpdg00]
@103378 = ~How about a nap? Just a quick one.~ [bdtpdgc]
@103379 = ~So how 'bout that thing we were gonna do?~ [bdtpdgd]
@103380 = ~Oof! That's supposed to be on the inside...~ [bdtpdge]
@103381 = ~Yeah?~ [bdtpdgf]
@103382 = ~What do you want?~ [bdtpdgg]
