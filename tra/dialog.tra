@19146 = ~Ce n'est pas grave. J'y vais.~
@19147 = ~Mineur Corey~
@19148 = ~Mineur Corey~
@19149 = ~Je vois. Vous avez mentionné des terres familiales à l'extérieur de la ville... Pouvez-vous me dire où elles se trouvent ?~
@19150 = ~Mineur Leslie~
