@60240 = ~Ribald Barterman, à votre service.~ [RIBALD01]
@60241 = ~Le Marché de l'Aventurier est le premier commerce de Féérune... large choix, prix bas, et pas de chichi. Voilà ma politique. Les produits, et rien que les produits.~ [RIBALD02]
@60242 = ~Que pouvons-nous faire pour réaliser vos rêves aujourd'hui ?~ [RIBALD03]
@60243 = ~Trafiquants, artisans ou créatures du néant, pour moi, y'a que des clients. Ribald fait des affaires avec tous ; il en fera avec vous.~ [RIBALD04]
@60244 = ~Oooohhhhh...~ [RIBALD06]
@60245 = ~Aaah !~ [RIBALD05]
@60246 = ~Les jours sont tristes et mornes pour ceux qui ne profitent pas de la chaleureuse hospitalité du Pouce. Entrez et soyez les bienvenus à la Bonté Marine.~ [THUMB01]
@60247 = ~Les tavernes sont faites pour boire et chanter, danser et rigoler. Mais pour le reste... allez vous faire pendre ailleurs. À bon entendeur...~ [THUMB02]
@60248 = ~On fait pas pour les palais délicats, chez moi. Ici, c'est grog... ou grog ! Pour le reste, faudra que j'aille y voir à la cave.~ [THUMB03]
@60249 = ~Bienvenue à la Bonté Marine. J'espère que l'odeur du poisson vous dérange pas.~ [THUMB04]
@60250 = ~Ooooh !~ [THUMB06]
@60251 = ~Eeehhh...~ [THUMB05]
@60252 = ~Oui ? As-tu quelque chose à signaler ?~ [ARAN01]
