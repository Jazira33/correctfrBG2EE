@103385 = ~What's up?~ [bdtpdg02]
@103386 = ~Orders?~ [bdtpdg03]
@103387 = ~Yeah, sure.~ [bdtpdgi]
@103388 = ~*sigh* All right.~ [bdtpdgj]
@103389 = ~Uh-huh.~ [bdtpdgk]
@103390 = ~If you say so.~ [bdtpdg04]
@103391 = ~No problem.~ [bdtpdg05]
@103392 = ~Yup.~ [bdtpdg06]
@103393 = ~I can do that.~ [bdtpdg07]
@103394 = ~Ooh!~ [bdtpdgl]
@103395 = ~Ahhhahhh...~ [bdtpdgm]
@103396 = ~This place seems fun.~ [bdtpdgp]
@103397 = ~*sigh* Have we been at this all night?~ [bdtpdgq]
@103398 = ~Now all the real nasty things are gonna come crawling out.~ [bdtpdgr]
@103399 = ~Stop poking me!~ [bdtpdg15]
@103400 = ~What, you want me to take out the trash, too?~ [bdtpdg16]
@103401 = ~Woo!~ [bdtpdgz]
@103402 = ~I meant to do that.~ [bdtpdg1]
@103403 = ~Oh good, it's immune to that.~ [bdtpdg2]
@103404 = ~Where am I supposed to put that, exactly?~ [bdtpdg3]
@103405 = ~Mine now.~ [bdtpdg4]
@103406 = ~I'm the night.~ [bdtpdg5]
@103407 = ~Okay, never mind.~ [bdtpdg6]
@103408 = ~Don't step on that.~ [bdtpdg7]
@103409 = ~You know, this could be going a lot worse.~ [bdtpdg10]
@103410 = ~An old lady glared at me the other day. I think that means we're screwing up.~ [bdtpdg11]
@103411 = ~Not thrilled about the way things are headed.~ [bdtpdg12]
@103412 = ~Yeah, I'm gonna go. Bye.~ [bdtpdg13]
@103413 = ~Can't do it! Run!~ [bdtpdg14]
