@60709 = ~J'attends l'enfant de Bhaal.~ [HELSEL01]
@60710 = ~Essaie seulement, si tu l'oses.~ [HELSEL03]
@60711 = ~Hhhhhhmmmmmmm !~ [HELSEL04]
@60712 = ~Hhhhhhhmmmmmmaaaaahhhhh...~ [HELSEL05]
@60713 = ~Tu ne te fonds vraiment pas dans la masse.~ [SAHPR101]
@60714 = ~Sekolah se régalera ce soir !~ [SAHPR103]
@60715 = ~Ton existence s'achève ici !~ [SAHPR104]
@60716 = ~Aaah !~ [SAHPR105]
@60717 = ~Aaaaaahhhhh...~ [SAHPR106]
@60718 = ~Flétris dans mon étreinte...~ [SHADEL01]
@60719 = ~L'heure est venue de me repaître de ton âme !~ [SHADEL04]
@60720 = ~Immense est ta bêtise d'avoir osé venir !~ [SHADEL05]
@60721 = ~Aah !~ [SHADEL06]
@60722 = ~Non ! Ce n'est pas possible...~ [SHADEL07]
@60723 = ~Lavok a disparu avec la sphère voilà plus de cinq siècles. On ne l'a jamais revu depuis.~
@60724 = ~Je vous vois.~ [SILVER13]
@60725 = ~Que la rage des anciens s'abatte sur vous !~ [SILVER03]
@60726 = ~AAAAAAAAHHHHHH !~ [SILVER04]
@60727 = ~Ooh !~ [SILVER05]
@60728 = ~Ooooooohhhh...~ [SILVER06]
@60729 = ~Mon ancêtre, Lavok le nécromancien, a façonné cette sphère et a disparu avec voilà plus de cinq siècles. On ne l'a jamais revu depuis, jusqu'à sa réapparition.~
