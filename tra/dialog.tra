@17416 = ~Protection contre le froid~
@17417 = ~Résistance au feu / au froid~
@17418 = ~Protection contre l'électricité~
@17419 = ~Protection contre la magie~
@17420 = ~Protection contre les morts-vivants~
@17421 = ~Protection contre les poisons~
@17422 = ~Non détectable~
