@15897 = ~RACE ENNEMIE~
@15898 = ~~
@15899 = ~J'ai eu tort de vous insulter, Arnolinus. S'il vous plaît, veuillez accepter mes plus humbles excuses.~
@15900 = ~Allez, allez. Ne m'en veuillez pas, je plaisantais. J'aimerais vraiment voir vos armures.~
@15901 = ~Très bien, espèce de nain mal embouché. Moi non plus je n'ai pas besoin de faire affaire avec toi.~
@15902 = ~Bah ! Encore ! Tu ne cesses de m'insulter ! Arnolinus va se mettre en colère !~
@15903 = ~Pilier de bar~
@15904 = ~Très bien, je m'en vais.~
@15905 = ~Fiche le camp ! Va-t-en a dit Arnolinus !~
@15906 = ~Non ! Arnolinus pense que tu n'es qu'un sale arrogant ! Arnolinus ne fera pas d'affaires avec toi !~ ~Non ! Arnolinus pense que tu n'es qu'une sale arrogante ! Arnolinus ne fera pas d'affaires avec toi !~
@15907 = ~Humpf. Hum. À contrecœur, Arnolinus accepte tes excuses, <RACE>. Tu peux jeter un œil aux armures d'Arnolius mais pas trop longtemps.~
@15908 = ~Pilier de bar~
@15909 = ~Cadavre de Nathan~
@15910 = ~Cadavre de Nathan~
@15911 = ~Haha ! Maheer est persuadé que vous êtes exactement le genre de client qu'il attendait. Et Maheer est aussi persuadé que l'armement vous intéresse !~ ~Haha ! Maheer est persuadé que vous êtes exactement le genre de cliente qu'il attendait. Et Maheer est aussi persuadé que l'armement vous intéresse !~
@15912 = ~Client de la taverne~
@15913 = ~Dois-je en conclure que vous êtes Maheer ?~
@15914 = ~Client de la taverne~
@15915 = ~J'aimerais acheter des armes, en effet. Qu'avez-vous à me montrer ?~
@15916 = ~Non, ça ne m'intéresse pas. Excusez-moi.~
@15917 = ~IA de groupe désactivée~
@15918 = ~IA de groupe activée~
@15919 = ~Voilà qui n'est pas de chance pour Maheer ! La prochaine fois que vous chercherez du matériel de guerre solide, revenez me voir ! Maheer vous dit au revoir et... à bientôt !~
@15920 = ~Zombie~
@15921 = ~Zombie~
@15922 = ~Golem de chair~
@15923 = ~Golem de chair~
@15924 = ~Arrêt~
