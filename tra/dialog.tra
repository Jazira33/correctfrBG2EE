@63339 = ~*cette torche n'est pas allumée... si vous avez un peu d'huile, un silex et du petit bois, vous pourrez l'allumer... que souhaitez-vous faire ?*~
@63340 = ~*la torche brûle avec une flamme rouge... vous pouvez l'éteindre, si vous le souhaitez... que décidez-vous ?*~
@63341 = ~*la torche brûle avec une flamme bleue... vous pouvez l'éteindre, si vous le souhaitez... que décidez-vous ?*~
@63342 = ~*la torche brûle avec une flamme violette... vous pouvez l'éteindre, si vous le souhaitez... que décidez-vous ?*~
