@23854 = ~~
@23855 = ~~
@23856 = ~Hurgan veut vous parler, alors ouvrez vos oreilles !~
@23857 = ~Aucun intérêt à se sacrifier pour vous !~
@23858 = ~Mon marteau va aplatir votre tête comme un clou !~
@23859 = ~Vous venez pour le boulot, oui ou non ?~
